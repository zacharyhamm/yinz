message MultipaneResponse { string json = 1; }
message PaneTabsResponse { string json = 1; }
message AgentProvidersResponse { string json = 1; }
message GetPluginInfoPayload { optional uint32 plugin_id = 1; }
message GetPluginInfoResponse { string json = 1; }
message PickResponse { string json = 1; }
