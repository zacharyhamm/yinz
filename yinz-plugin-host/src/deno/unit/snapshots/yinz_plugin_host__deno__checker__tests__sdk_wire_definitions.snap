}
message FsReadPayload {
string path = 1;
optional uint64 max_bytes = 2;
optional uint64 offset = 3;
}
message FsListPayload {
string path = 1;
}
message FsMetadataPayload {
string path = 1;
}
message FsWritePayload {
string path = 1;
bytes contents = 2;
bool append = 3;
bool create_dirs = 4;
}
message FsRemovePayload {
string path = 1;
bool recursive = 2;
}
message FsCreateDirPayload {
string path = 1;
bool all = 2;
}
message FsRenamePayload {
string from = 1;
string to = 2;
}
message GrantPluginPermissionsPayload {
string plugin_url = 1;
repeated plugin_permission.PermissionType permissions = 2;
}
message FsReadResponse {
oneof result {
bytes contents = 1;
string error = 2;
}
}
message ReadPluginLogPayload {
string name = 1;
uint64 lines = 2;
}
message ReadPluginLogResponse {
oneof result {
string lines = 1;
string error = 2;
}
}
message FsEntry {
string path = 1;
optional event.FileMetadata metadata = 2;
}
message FsListResponse {
oneof result {
FsEntryList entries = 1;
string error = 2;
}
}
message FsEntryList {
repeated FsEntry entries = 1;
}
message FsMetadataResponse {
oneof result {
event.FileMetadata metadata = 1;
string error = 2;
bool not_found = 3;
}
}
message FsMutateResponse {
oneof result {
bool success = 1;
string error = 2;
}
}
message EnqueueQueueJobPayload {
string queue = 1;
string plugin_url = 2;
repeated ContextItem config = 3;
repeated ContextItem context = 4;
}
message ConfigureQueuePayload {
string queue = 1;
uint32 concurrency = 2;
}
message CancelQueueJobPayload {
uint64 job_id = 1;
}
message QueueStatusPayload {
optional string queue = 1;
}
message FinishQueueJobPayload {
bool success = 1;
optional string payload = 2;
}
message EnqueueQueueJobResponse {
oneof result {
uint64 job_id = 1;
string error = 2;
}
}
message QueueStatusResponse {
repeated event.QueueSnapshot queues = 1;
}
message OpenCommandPaneInGitCheckoutPayload {
command.Command command_to_run = 1;
string source_directory = 2;
oneof checkout {
CurrentGitCheckout current = 3;
NewBranchGitCheckout new_branch = 4;
NewWorktreeGitCheckout new_worktree = 5;
}
}
message CurrentGitCheckout {}
message NewBranchGitCheckout {
string branch = 1;
string base = 2;
}
message NewWorktreeGitCheckout {
string branch = 1;
string base = 2;
string path = 3;
}
message OpenCommandPaneInGitCheckoutResponse {
oneof result {
PaneId pane_id = 1;
string error = 2;
}
}
message AgentSpawnSpec {
optional string kind = 1;
optional string command = 2;
repeated string args = 3;
optional string model = 4;
optional string prompt = 5;
optional string branch = 6;
optional string base = 7;
optional bool worktree = 8;
optional string worktree_dir = 9;
repeated EnvVariable env = 10;
optional string permission_mode = 11;
optional string resume = 12;
optional bool hooks = 13;
optional string firecracker = 14;
optional string firecracker_image = 15;
optional string effort = 16;
optional bool reuse = 17;
optional bool allow_outside_worktree = 18;
optional string reuse_prompt = 19;
bool bubblewrap = 20;
}
message SpawnAgentPayload {
AgentSpawnSpec spec = 1;
optional string source_directory = 2;
optional string cwd = 3;
optional string name = 4;
repeated ContextItem context = 5;
bool start_suppressed = 7;
}
message SpawnAgentResponse {
oneof result {
PaneId pane_id = 1;
string error = 2;
}
optional string branch = 3;
optional string cwd = 4;
}
message NotifyWithPanePayload {
string text = 1;
PaneId pane_id = 2;
optional string click_message = 3;
optional string click_payload = 4;
}
message RevealPaneWithIdPayload {
PaneId pane_id = 1;
optional string label = 2;
}
message SetProjectContextPayload {
repeated string projects = 1;
repeated PaneProject panes = 2;
}
message PaneProject {
PaneId pane_id = 1;
string project = 2;
}
message SetTabProjectsPayload {
repeated TabProject tab_projects = 1;
}
message TabProject {
uint64 tab_id = 1;
string project = 2;
}
message DataDefineEntityPayload {
optional string namespace = 1;
plugin_data.EntityDef def = 2;
bool allow_destructive = 3;
}
message DataApplyPayload {
optional string namespace = 1;
repeated plugin_data.Mutation mutations = 2;
}
message DataFetchPayload {
plugin_data.FetchRequest request = 1;
}
message DataWatchPayload {
plugin_data.FetchRequest request = 1;
plugin_data.WatchMode mode = 2;
}
message DataUnwatchPayload {
uint64 watch_id = 1;
}
message DataCatalogPayload {
optional string namespace = 1;
}
message GetLocalUtcOffsetPayload {
