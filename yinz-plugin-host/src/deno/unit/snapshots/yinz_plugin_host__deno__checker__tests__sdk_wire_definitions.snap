uint32 click_in_pane_y = 8;
bool on_frame = 9;
string pane_title = 10;
optional string pane_command = 11;
bool pane_exited = 12;
optional int32 pane_exit_status = 13;
bool pane_is_held = 14;
bool pane_is_floating = 15;
optional string selected_text = 16;
optional string word_under_cursor = 17;
