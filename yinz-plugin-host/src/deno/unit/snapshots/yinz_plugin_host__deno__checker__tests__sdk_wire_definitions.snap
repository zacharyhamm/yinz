}
message ModeUpdatePayload {
reserved 9, 10, 12, 13, 14, 15;
input_mode.InputMode current_mode = 1;
repeated InputModeKeybinds keybinds = 2;
style.Style style = 3;
bool arrow_fonts_support = 4;
optional string session_name = 5;
optional input_mode.InputMode base_mode = 6;
optional string editor = 7;
optional string shell = 8;
optional bool currently_marking_pane_group = 11;
optional PaneFrameStyle pane_frame_style = 16;
optional bool session_dimmed = 17;
repeated string ancestry = 18;
optional bool host_fullscreen = 19;
repeated string nested_ascend_keys = 20;
optional bool session_ascended = 21;
repeated string nested_descend_keys = 22;
bool kitty_graphics_support = 23;
}
