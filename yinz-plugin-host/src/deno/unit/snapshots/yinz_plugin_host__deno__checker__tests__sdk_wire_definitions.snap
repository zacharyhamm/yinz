ActivePaneScroll = 49;
WebRequestStreamChunk = 50;
PluginDataChanged = 51;
QueueJobStarted = 52;
QueueJobFinished = 53;
QueueChanged = 54;
ContextMenuRequested = 55;
ContextMenuItemSelected = 56;
Hook = 57;
AgentEvent = 58;
ModifiersHeld = 59;
RunCommandOutput = 60;
PaneOutput = 61;
PaneTabsUpdate = 62;
AgentProvidersChanged = 63;
PickResult = 68;
ClientGridReset = 64;
NotificationReceived = 65;
NotificationRequested = 66;
NotificationResolved = 67;
