CommandPaneReRun = 24;
FailedToWriteConfigToDisk = 25;
ListClients = 26;
HostFolderChanged = 27;
FailedToChangeHostFolder = 28;
PastedText = 29;
ConfigWasWrittenToDisk = 30;
BeforeClose = 32;
InterceptedKeyPress = 35;
PaneRenderReport = 36;
UserAction = 37;
