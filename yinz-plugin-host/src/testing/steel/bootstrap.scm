;; Test controls exist only in the disposable installed-test worker.
(define (%test op argument)
  (%test-control (hash "op" op "argument" argument)))
(define %test-cases '())
(define %test-sealed #f)
(define (test name . arguments)
  (when %test-sealed (error "tests must register during module initialization"))
  (unless (and (string? name) (> (string-length (trim name)) 0) (<= (string-length name) 1024))
    (error "test requires a name of 1 to 1024 characters"))
  (unless (or (= (length arguments) 1) (= (length arguments) 2))
    (error "test requires a name, optional options, and a function"))
  (when (>= (length %test-cases) 1000) (error "at most 1000 tests per file"))
  (when (member name (map car %test-cases))
    (error (string-append "duplicate test: " name)))
  (define options (if (= (length arguments) 2) (car arguments) (hash)))
  (define thunk (if (= (length arguments) 2) (cadr arguments) (car arguments)))
  (unless (procedure? thunk) (error "test requires a function"))
  (set! %test-cases
    (append %test-cases (list (list name (hash-union options (hash "grants" '())) thunk)))))
(define (assert value . message)
  (unless value (error (if (null? message) "assertion failed" (car message)))))
(define (assert-equal actual expected . message)
  (unless (equal? actual expected)
    (error (if (null? message)
               (string-append "expected " (to-string expected) ", got " (to-string actual))
               (car message)))))
(define (assert-throws thunk . expected)
  (define caught #f)
  (define failure
    (with-handler (lambda (error) (set! caught #t) (%async-error error)) (thunk)))
  (assert caught "expected function to throw")
  (when (pair? expected)
    (assert (string-contains? failure (car expected))
      (string-append "unexpected error: " failure)))
  failure)
(define (assert-rejects thunk . expected)
  (define result (yinz-deferred))
  (with-handler (lambda (failure) (yinz-reject! result failure))
    (yinz-resolve! result (thunk)))
  (%async-chain result
    (lambda (_) (error "expected deferred to reject"))
    (lambda (failure)
      (when (pair? expected)
        (assert (string-contains? failure (car expected))
          (string-append "unexpected error: " failure)))
      failure)))
(define (yinz-log value) (%test "log" (if (string? value) value (to-string value))))
(define (displayln value) (yinz-log value))
(define (test-location) (%test "location" json-null))
(define (test-resolve relative-path) (%test "resolve" relative-path))
(define (test-copy-plugin source destination)
  (%test "copy-plugin" (hash "source" source "destination" destination)))
(define (test-load-plugin path . options)
  (define configuration (if (null? options) (hash) (car options)))
  (define replies (%async-get configuration "replies" (hash)))
  (define constants (hash))
  (for-each (lambda (name)
    (define reply (hash-ref replies name))
    (if (procedure? reply)
        (test-stub name reply)
        (set! constants (hash-insert constants name reply)))) (hash-keys->list replies))
  (%test "load" (hash "path" path "options" (hash-insert configuration "replies" constants))))
(define (test-stub name reply)
  (if (procedure? reply)
      (%yinz-register-callback name (%yinz-capture-callback reply))
      (%test "stub" (hash name reply))))
(define (test-stub-error name message) (%test "stub-error" (hash "name" name "message" message)))
(define (test-commands) (%test "commands" json-null))
(define (test-pane-declared?) (%test "pane-declared" json-null))
(define (test-logs) (%test "logs" json-null))
(define (test-renders) (%test "renders" json-null))
(define (test-event event) (%test "event" event))
(define (test-pipe message) (%test "pipe" message))
(define (test-palette message client)
  (%test "palette" (hash "message" message "client" client)))
(define (test-step-wall-clock milliseconds) (%test "step-wall-clock" milliseconds))
(define (test-advance milliseconds) (%test "advance" milliseconds))
(define (test-render . dimensions)
  (%test "render" (hash "rows" (if (null? dimensions) 24 (car dimensions))
                        "columns" (if (< (length dimensions) 2) 80 (cadr dimensions)))))
(define (render-text text . dimensions)
  (%test "render-text" (hash "text" text "rows" (if (null? dimensions) 24 (car dimensions))
                             "columns" (if (< (length dimensions) 2) 80 (cadr dimensions)))))
(define (test-session op . argument)
  (%test (string-append "session:" op) (if (null? argument) (hash) (car argument))))
(define (test-wait-for what predicate . timeout)
  (define deadline (+ (%test "clock" json-null) (if (null? timeout) 10000 (car timeout))))
  (define (poll)
    (when (>= (%test "clock" json-null) deadline)
      (error (string-append "timed out waiting for " what "\n"
        (test-session "screen") "\n" (test-session "logs"))))
    (test-session "poll"))
  (%test "pending" what)
  (let wait ()
    (define result (predicate))
    (let settle ()
      (yinz-async-poll)
      (when (yinz-pending? result) (poll) (settle)))
    (when (and (yinz-deferred? result) (equal? (vector-ref result 1) "rejected"))
      (if (vector-ref result 7) (raise-error (vector-ref result 7))
          (error (vector-ref result 2))))
    (unless (if (yinz-deferred? result) (vector-ref result 2) result)
      (poll)
      (wait)))
  (%test "pending" ""))
(define (test-wait-for-text text . timeout)
  (apply test-wait-for (string-append "screen containing " text)
    (lambda () (string-contains? (test-session "screen") text)) timeout)
  (test-session "screen"))
(define (%test-run index expected)
  (set! %test-sealed #t)
  (define (description case) (hash "name" (car case) "options" (cadr case)))
  (if (json-null? index)
      (map description %test-cases)
      (begin
        (assert (< index (length %test-cases)) "test registration changed")
        (define case (list-ref %test-cases index))
        (assert-equal (description case) expected "test registration changed between discovery and execution")
        (define result ((caddr case)))
        (let settle ()
          (yinz-async-poll)
          (when (yinz-pending? result) (settle)))
        (when (and (yinz-deferred? result) (equal? (vector-ref result 1) "rejected"))
          (error (vector-ref result 2)))
        json-null)))
