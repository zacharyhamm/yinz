(define (assert-data value) (unless value (error "data host assertion")))
(define (data-definition name attributes)
  (hash "name" name "version" 1 "attrs"
    (map (lambda (attribute)
      (hash "name" (car attribute) "kind" (cadr attribute) "indexed" #f "full_text" #f
        "unique" #f "required" #f "default" json-null)) attributes)))
(define (data-query entity . filter)
  (hash "entity" entity "filter" (if (null? filter) json-null (car filter))
    "search" json-null "sort" '() "select" '() "limit" 100 "offset" 0 "after_id" json-null))
(define (data-eq key value) (hash "Eq" (list key value)))
(define (data-put entity uid values revision)
  (hash "Put" (hash "entity" entity "uid" uid "values" values "expect_rev" revision)))
(define (data-update entity filter values revision)
  (hash "Update" (hash "entity" entity "filter" filter "values" values "expect_rev" revision)))
(define (data-field rows name)
  (let loop ((columns (hash-ref rows "columns")) (cells (car (hash-ref rows "rows"))))
    (if (equal? (car columns) name) (car cells) (loop (cdr columns) (cdr cells)))))
(define (data-value rows name)
  (define value (data-field rows name))
  (if (hash? value) (hash-ref value (car (hash-keys->list value))) json-null))
