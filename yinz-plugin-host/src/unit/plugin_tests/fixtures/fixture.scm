(define greeting "hello")
(define payload "nil")
(define presses 0)
(define tabs "nil")
(define (load config)
  (when (hash-contains? config "greeting") (set! greeting (hash-ref config "greeting")))
  (when (hash-contains? config "payload") (set! payload (hash-ref config "payload")))
  (yinz-command (hash "Subscribe" (list "Key" "TabUpdate")))
  (yinz-command (hash "SetSelectable" #t)))
(define (update event)
  (cond
    ((hash-contains? event "Key") (set! presses (+ presses 1)) #t)
    ((hash-contains? event "TabUpdate")
     (set! tabs (number->string (length (hash-ref event "TabUpdate")))) #t)
    (else #f)))
(define (render rows cols)
  (string-append greeting " from scheme | " (number->string rows) "x"
    (number->string cols) " | presses " (number->string presses)
    " | tabs " tabs " | payload " payload))
