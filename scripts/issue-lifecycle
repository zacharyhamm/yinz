#!/usr/bin/env python3
"""Drive local Swamp issue workflows from one control checkout."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys

from issue_lifecycle.workspace import agenda_workspace, local_environment
from issue_lifecycle.agent import resolve_agent


METHODS = (
    "start", "status", "triage", "plan", "review-plan", "adjudicate-plan", "approve", "implement",
    "decide-review", "plan-review-fixes", "approve-review-fixes", "review-code", "review-ux", "ready", "merge", "repair", "refresh", "summarize", "agent", "resume-agent", "discard-agent",
    "closeout", "resume-closeout", "rollback", "resume-rollback", "restart-agent", "continue-agent", "drive", "verify",
)


def issue_name(workspace, item):
    name = f"issue-{workspace}-{item}"
    if len(name) <= 64:
        return name
    return f"issue-{hashlib.sha256(workspace.encode()).hexdigest()[:24]}-{item}"


def query_resource(name, resource, tail, control, env):
    """Return the issue's single current record of one resource, or None."""
    query = subprocess.run([
        "swamp", "data", "query", f"modelName == {json.dumps(name)} && name == {json.dumps(resource)}",
        "--select", "content", "--json", *tail,
    ], text=True, cwd=control, env=env, capture_output=True)
    if query.returncode:
        raise ValueError(query.stderr + query.stdout)
    records = json.loads(query.stdout)["results"]
    return records[0] if len(records) == 1 else None


def print_checklist(name, verification):
    print(f"Verification {verification['id']}: {verification['status']} at {verification['commit']}", file=sys.stderr)
    for check in verification["checks"]:
        mark = "x" if check["status"] == "passed" else " "
        code = "(could not start)" if check["exitCode"] is None else check["exitCode"]
        outcome = "not run" if check.get("skipped") else "timed out" if check.get("timedOut") else f"exit {code}"
        if not check.get("skipped") and not check["worktreeUnchanged"]:
            outcome += ", changed the worktree, branch or HEAD"
        detail = check.get("skipped") or (
            f"log: swamp data query 'modelName == {json.dumps(name)} && name == {json.dumps(check['log'])}' --select content")
        print(f"- [{mark}] {check['id']}: {shlex.join(check['command'])} -> {outcome} "
              f"in {check['durationMs'] / 1000:.1f}s; {detail}", file=sys.stderr)


def print_merge_failure(name, state):
    """Point at the failed gate's evidence; a later pass must not hide it."""
    attempt = (state or {}).get("attempt") or {}
    failure = next((entry for entry in (state or {}).get("mergeFailures", [])
                    if entry["attemptId"] == attempt.get("id")), None)
    if failure is None:
        return
    print(f"Merge attempt {failure['attemptId']} failed: {failure['summary']}", file=sys.stderr)
    for phase in failure.get("phases", []):
        print(f"- [{'x' if phase['status'] == 'passed' else ' '}] {phase['name']}", file=sys.stderr)
    if failure.get("failedTests"):
        more = failure.get("failedTestsTruncated")
        print("Failed tests: " + ", ".join(failure["failedTests"]) + (f" (+{more} more)" if more else ""),
              file=sys.stderr)
    if failure.get("log"):
        print(f"Log: {failure['log']}", file=sys.stderr)
    print(f"Output: swamp data query 'modelName == {json.dumps(name)} && name == "
          f"{json.dumps(failure['logResource'])}' --select content", file=sys.stderr)
    print("Investigate the cause, then run repair with it; a flake is a defect.", file=sys.stderr)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--control", type=Path, default=Path(__file__).resolve().parent.parent)
    parser.add_argument("--workspace", help="Assert the workspace matches vault default/AGENDA_WORKSPACE")
    parser.add_argument("--item", required=True, type=int, help="Agenda task ID")
    parser.add_argument("command", choices=METHODS)
    parser.add_argument("--input-file", type=Path, help="JSON method arguments; use - for stdin")
    args = parser.parse_args()
    if (args.workspace is not None and not re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,63}", args.workspace)) or not 0 < args.item <= 2**53 - 1:
        parser.error("invalid Agenda workspace or item ID")
    # Capture the caller's worktree before dispatching Swamp in the control checkout.
    worker_worktree = None
    if args.command == "start":
        origin = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                                capture_output=True, text=True)
        if origin.returncode:
            parser.error("start must be invoked from a Git worktree")
        worker_worktree = str(Path(origin.stdout.strip()).resolve(strict=True))
    control = args.control.resolve(strict=True)
    if not (control / ".swamp.yaml").is_file():
        parser.error("control checkout has no .swamp.yaml; select the initialized Yinz checkout")
    inputs = {}
    if args.input_file:
        inputs = json.loads(sys.stdin.read() if str(args.input_file) == "-" else args.input_file.read_text())
    if not isinstance(inputs, dict):
        parser.error("input file must contain a JSON object")
    if args.command == "start":
        agent = resolve_agent(control, inputs)
        inputs = {"agent": agent} if agent else {}
    if args.command in ("drive", "agent", "restart-agent"):
        session = os.environ.get("YINZ_SESSION_NAME", "").strip()
        pane = os.environ.get("YINZ_PANE_ID", "")
        if session and re.fullmatch(r"[0-9]+", pane):
            inputs["control"] = {"session": session, "paneId": f"terminal_{int(pane)}"}
    workspace = agenda_workspace(control, args.workspace)
    name = issue_name(workspace, args.item)
    # A shell configured for a remote Swamp server must not redirect local Git.
    env = local_environment()
    # The shared coordinator may be occupied by a full CI gate for hours.
    env.setdefault("SWAMP_LOCK_TIMEOUT_MS", "14400000")
    tail = ["--repo-dir", str(control), "--no-telemetry"]
    if args.command == "status":
        if inputs:
            parser.error("status takes no method inputs")
        result = subprocess.run([
            "swamp", "data", "query", f"modelName == {json.dumps(name)} && (name == 'state' || name == 'agent-task' || name == 'recovery' || name == 'driver' || name == 'handoff' || name == 'controller-origin')",
            "--select", "content", "--json", *tail,
        ], cwd=control, env=env, capture_output=True, text=True)
        if result.returncode:
            sys.stderr.write(result.stderr + result.stdout)
            return result.returncode
        sys.stderr.write(result.stderr)
        document = json.loads(result.stdout)
        task = next((record for record in document["results"] if "before" in record and "behaviorName" in record), None)
        if task and task.get("submission"):
            submission = query_resource(task["submission"]["behaviorName"], "submission", tail, control, env)
            if submission is not None:
                document["results"].append(submission)
        print(json.dumps(document))
        return 0
    if args.command in ("start", "merge", "drive", "verify"):
        workflow = "yinz-issue-" + args.command
        validation = subprocess.run(["swamp", "workflow", "validate", workflow, "--json", *tail], cwd=control, env=env, text=True, capture_output=True)
        if validation.returncode:
            sys.stderr.write(validation.stderr + validation.stdout)
            return validation.returncode
        if args.command == "start":
            inputs = {"workspace": workspace, "itemId": args.item, "issueName": name,
                      "workerWorktree": worker_worktree, **inputs}
        elif args.command == "verify":
            if inputs:
                parser.error("verify takes no method inputs")
            inputs = {"issueName": name}
        elif args.command == "merge":
            if set(inputs) - {"skipCiRequest"}:
                parser.error("merge accepts only skipCiRequest")
            inputs = {"issueName": name, **inputs}
        else:
            if set(inputs) - {"agent", "control", "revisionApproval"}:
                parser.error("drive accepts only agent settings, control identity and revisionApproval; omit them to resume")
            inputs = {"issueName": name, "drive": inputs}
        command = ["swamp", "workflow", "run", workflow, "--stdin", *tail]
    else:
        method = {"agent": "run_agent", "resume-agent": "resume_agent"}.get(args.command, args.command.replace("-", "_"))
        command = ["swamp", "behavior", "run", name, method, "--stdin", *tail]
    if args.command == "verify":
        result = subprocess.run(command, input=json.dumps(inputs), text=True, cwd=control, env=env, stdout=sys.stderr)
        if result.returncode:
            return result.returncode
        state = query_resource(name, "state", tail, control, env)
        if state is None:
            raise ValueError("expected exactly one current lifecycle state")
        verification = state.get("verification")
        if not verification:
            raise ValueError("verify recorded no verification; inspect the exact workflow run")
        print_checklist(name, verification)
        print(json.dumps(verification))
        return 0 if verification["status"] == "passed" else 2
    if args.command == "merge":
        code = subprocess.run(command, input=json.dumps(inputs), text=True, cwd=control, env=env).returncode
        if code:
            try:
                print_merge_failure(name, query_resource(name, "state", tail, control, env))
            except (ValueError, KeyError, TypeError) as error:
                print(f"issue-lifecycle: cannot read the merge failure: {error}", file=sys.stderr)
        return code
    if args.command != "drive":
        return subprocess.run(command, input=json.dumps(inputs), text=True, cwd=control, env=env).returncode
    # Keep the controller attached until it has the concrete handoff. Workflow
    # progress belongs on stderr; stdout is exactly the machine-readable result.
    result = subprocess.run(command, input=json.dumps(inputs), text=True, cwd=control, env=env, stdout=sys.stderr)
    if result.returncode:
        return result.returncode
    handoff = query_resource(name, "handoff", tail, control, env)
    if handoff is None or handoff.get("status") != "current":
        raise ValueError("drive did not return a current handoff; inspect the exact workflow run")
    print(handoff["presentation"], file=sys.stderr)
    print(json.dumps(handoff))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError) as error:
        print(f"issue-lifecycle: {error}", file=sys.stderr)
        sys.exit(1)
