(require "./testing/common.scm")
(define (open-command title)
  (s-key "Ctrl Alt p") (s-text title) (test-wait-for-text (string-append "› " title "…")) (s-key "Enter"))
(define (select-fixture)
  (s-text "palette-fixture.scm")
  (test-wait-for "fixture plugin result selected"
    (lambda () (t-any (lambda (line)
          (and (string-contains? line "› [plugin_") (string-contains? line "palette-fixture.scm")))
        (split-many (s-screen) "\n"))))
  (s-key "Enter"))
(test "plugin palette resolves relative files and plugin cwd after the shell changes directory" (lambda ()
    (define home (s-fixture (hash
          "plugin.scm" "(yinz-declare-pane)\n(define (render rows cols) \"WRONG STARTUP SOURCE\")\n"
          "b/plugin.scm" "(yinz-declare-pane)\n(define text \"\")\n(define (load configuration) (set! text (string-append \"CURRENT SOURCE cwd=\" (hash-ref (yinz-command \"GetPluginIds\") \"initial_cwd\"))))\n(define (render rows cols) text)\n") (hash)))
    (s-start (hash "columns" 160 "backgroundPlugins" (list (hash "path" "yinz:plugin-palette" "configuration" (hash "shared" "true")))))
    (test-wait-for-text "yinz-test>")
    (s-text "cd b && printf 'DIRECTORY-%s\\n' CHANGED") (s-key "Enter")
    (test-wait-for-text "DIRECTORY-CHANGED")
    (open-command "Load plugin") (test-wait-for-text "Plugin URL or alias:")
    (s-text "file:./plugin.scm") (s-key "Enter") (s-key "Enter") (s-key "Enter")
    (test-wait-for-text (string-append "CURRENT SOURCE cwd=" home "/b"))))
(test "plugin palette loads, inspects, reloads and closes a plugin in a real session" (lambda ()
    (define home (s-fixture (hash "palette-fixture.scm"
          "(yinz-declare-pane)\n(define text \"PLUGIN READY\")\n(define (load configuration) (yinz-command (hash \"Subscribe\" '(\"Key\"))))\n(define (update event) (set! text \"PLUGIN MODIFIED\") #t)\n(define (render rows cols) text)\n") (hash)))
    (s-start (hash "columns" 160 "backgroundPlugins" (list (hash "path" "yinz:plugin-palette" "configuration" (hash "shared" "true")))))
    (test-wait-for-text "yinz-test>") (open-command "Load plugin") (test-wait-for-text "Plugin URL or alias:")
    (s-text (string-append "file:" home "/palette-fixture.scm")) (s-key "Enter") (s-key "Enter") (s-key "Enter")
    (test-wait-for-text "PLUGIN READY")
    (open-command "Plugins") (select-fixture) (test-wait-for-text "Plugin details…")
    (s-text "details") (test-wait-for-text "› Plugin details…") (s-key "Enter") (test-wait-for-text "Configuration:") (test-wait-for-text "(none)")
    (s-key "Ctrl Alt p") (s-key "x") (test-wait-for-text "PLUGIN MODIFIED")
    (open-command "Reload plugin") (select-fixture) (test-wait-for-text "PLUGIN READY")
    (define fixture (t-find (lambda (pane) (and (hash-ref pane "is_plugin")
            (string-contains? (t-get pane "plugin_url" "") "palette-fixture.scm"))) (s-panes)))
    (assert fixture)
    (open-command "Close plugin") (select-fixture) (test-wait-for-text "Cancel")
    (s-key "Down") (s-key "Enter")
    (test-wait-for "plugin closed" (lambda ()
        (not (t-find (lambda (pane) (and (hash-ref pane "is_plugin") (= (hash-ref pane "id") (hash-ref fixture "id")))) (s-panes)))))))
