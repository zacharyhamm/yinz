(require "./project-store/common.scm" "./project-store/ops.scm" "./project-store/import.scm" "./project-store/arrangement.scm" "./shared/agent-service.scm")
(define host-id "")
(define providers '())
(define watch-id json-null)
(define latest json-null)
(define retry? #f)
(define arranging? #f)
(define service-id #f)
(define service-seq 0)
(define published-tabs json-null)
(define published-context json-null)
(define (message name destination payload)
  (yinz-command (hash "MessageToPlugin" (hash "plugin_url" json-null "destination_plugin_id" destination
        "plugin_config" (hash) "message_name" name "message_payload" payload "message_args" (hash)
        "new_plugin_args" json-null "floating_pane_coordinates" json-null))))
(define (subscribe-agent) (message "agent_subscribe" json-null json-null))
(define (all-panes reply)
  (append (if (json-null? (hash-ref reply "panes")) '() (hash-ref reply "panes")) (hash-ref reply "suppressed_panes")))
(define (publish-context registry reply)
  (define assignments '())
  (unless (json-null? reply)
    (for-each (lambda (pane)
        (define location (ps-model "agents" "PaneCheckoutLocation" pane))
        (unless (json-null? location)
          (define project (ps-model "projects" "RegisteredForCwd" (hash-ref reply "repositories") registry location))
          (unless (json-null? project)
            (set! assignments (cons (list (hash "Terminal" (hash-ref pane "pane_id")) (hash-ref project "name")) assignments))))) (all-panes reply)))
  (set! assignments (sort assignments (lambda (a b)
        (if (= (hash-ref (car a) "Terminal") (hash-ref (car b) "Terminal")) (string<? (cadr a) (cadr b))
          (< (hash-ref (car a) "Terminal") (hash-ref (car b) "Terminal"))))))
  (define names (sort (hash-keys->list registry) string<?))
  (define sources (foldl (lambda (name result)
        (define project (hash-ref registry name))
        (define remote (ps-get project "remote" json-null))
        (hash-insert result name (if (ps-arg project "remote") remote (hash-ref project "root")))) (hash) names))
  (define context (list names assignments sources))
  (unless (equal? context published-context)
    (yinz-command (hash "SetProjectContext" context))
    (set! published-context context)))
(define (publish-tabs registry reply)
  (publish-context registry reply)
  (define owners (hash))
  (for-each (lambda (pane)
      (define location (ps-model "agents" "PaneCheckoutLocation" pane))
      (unless (json-null? location)
        (define label (ps-model "projects" "LabelForCwd" (hash-ref reply "repositories") registry location))
        (unless (json-null? label)
          (set! owners (hash-insert owners (number->string (hash-ref pane "pane_id"))
              (list label (ps-get (ps-get (hash-ref reply "repositories") location (hash)) "branch" json-null))))))) (all-panes reply))
  (define labels (ps-model "agents" "TabProjectLabels" (all-panes reply) owners))
  (define names (filter (lambda (pair) (not (json-null? (cadr pair))))
      (map (lambda (key) (list (string->number key) (ps-model "agents" "TabProjectLabel" (hash-ref labels key))))
        (sort (hash-keys->list labels) (lambda (a b) (< (string->number a) (string->number b)))))))
  (unless (equal? names published-tabs)
    (yinz-command (hash "SetTabProjects" (foldl (lambda (pair result) (hash-insert result (number->string (car pair)) (cadr pair))) (hash) names)))
    (set! published-tabs names)))
(define (discover reply)
  (define repositories '())
  (for-each (lambda (pane)
      (define kind (yinz-agent-model "providers" "WithSnapshot" (list providers "agents" "Classify" (list pane (hash-ref reply "manual_kinds")))))
      (unless (json-null? kind)
        (define location (ps-model "agents" "PaneCheckoutLocation" pane))
        (define repository (ps-get (hash-ref reply "repositories") location json-null))
        (when (and (not (json-null? repository)) (json-null? (ps-get repository "host" json-null)))
          (set! repositories (append repositories (list repository)))))) (hash-ref reply "panes"))
  (define rows (ps-safe (lambda () (ps-fetch (ps-limit (ps-request "project") 1000))) #f))
  (and rows
    (let* ((before (ps-projects rows)) (discovery (ps-model "projects" "Discover" before repositories)) (after (hash-ref discovery "registry")))
      (when (hash-ref discovery "changed")
        (define mutations (ps-model "projects" "DiffMutations" before after))
        (ps-safe (lambda () (ps-apply mutations)) #f)) after)))
(define (retry-snapshot)
  (when (and retry? (not (json-null? latest)) (not (json-null? (hash-ref latest "panes"))))
    (define registry (discover latest))
    (when registry (publish-tabs registry latest) (set! retry? #f))))
(define (request payload)
  (ps-safe (lambda ()
      (define parsed (yinz-json-parse payload))
      (and (hash? parsed) (string? (ps-get parsed "op" #f)) (string? (ps-get parsed "request_id" ""))
        (boolean? (ps-get parsed "structured_reply" #f)) parsed)) #f))
(define (reply source id structured outcome)
  (define value (hash-ref outcome (if (hash-contains? outcome "Ok") "Ok" "Err")))
  (define rendered (if structured
      (yinz-json-string (if (hash-contains? outcome "Ok")
          (hash "ok" #t "data" (ps-safe (lambda () (yinz-json-parse value)) value)) (hash "ok" #f "error" value))) value))
  (cond ((and (hash? source) (hash-contains? source "Cli"))
      (yinz-command (hash "CliPipeOutput" (list (hash-ref source "Cli") (string-append rendered "\n"))))
      (yinz-command (hash "UnblockCliPipeInput" (hash-ref source "Cli"))))
    ((and (hash? source) (hash-contains? source "Plugin") (not (equal? id "")))
      (message "yinz_rpc_reply" (hash-ref source "Plugin") (yinz-json-string (hash "version" 1 "call_id" id
            "result" (ps-safe (lambda () (yinz-json-parse rendered)) rendered)))))))
(define (handle source name payload)
  (define parsed (request payload))
  (define structured (and parsed (ps-get parsed "structured_reply" #f)))
  (define id (if parsed (ps-get parsed "request_id" "") ""))
  (define outcome (with-handler (lambda (failure) (hash "Err" (ps-error failure)))
      (unless parsed (error (if (equal? name "store_query") "could not parse query" "could not parse mutation")))
      (define operation (hash-ref parsed "op"))
      (define args (ps-get parsed "args" json-null))
      (define result
        (if (equal? name "store_mutate") (ps-mutate operation args)
          (begin
            (unless (or (json-null? args) (hash? args)) (error "query args must be an object"))
            (define result (ps-query operation (hash-insert (if (hash? args) args (hash)) "local_host_id" host-id)))
            (if (equal? operation "project_list")
              (yinz-json-string (hash-insert (yinz-json-parse result) "live"
                  (if (json-null? latest) json-null (hash "session" (hash-ref latest "yinz_session_name") "tab_projects" (hash-ref latest "tab_projects")
                      "panes" (hash-ref latest "panes") "suppressed_panes" (hash-ref latest "suppressed_panes") "repositories" (hash-ref latest "repositories"))))) result))))
      (hash "Ok" result)))
  (reply source id structured outcome))
(define (authorized? source)
  (if (and (hash? source) (hash-contains? source "Plugin"))
    (ps-safe (lambda ()
        (define sessions (hash-ref (yinz-command "GetSessionList") "live_sessions"))
        (not (null? (filter (lambda (session)
                (and (hash-ref session "is_current_session") (equal? "yinz:agents"
                    (ps-get (ps-get (hash-ref session "plugins") (number->string (hash-ref source "Plugin")) (hash)) "location" #f)))) sessions)))) #f) #t))
;; Snapshots drive shared project, todo and note writes, so only the session's agent service may send them.
;; A sender other than the cached service id re-resolves it, covering a service that loaded or reloaded later.
;; The plugin map knows the service before its first snapshot; the session list can lag it at startup.
(define (from-service? source)
  (define plugin (and (hash? source) (hash-contains? source "Plugin") (hash-ref source "Plugin")))
  (when (and plugin (not (equal? plugin service-id)))
    (define ids (ps-safe (lambda () (yinz-command (hash "GetPluginIdsForUrl" "yinz:agent-service"))) '()))
    (define id (and (= (length ids) 1) (car ids)))
    (unless (equal? id service-id) (set! service-id id) (set! service-seq 0)))
  (and plugin (equal? plugin service-id)))
(define (load configuration)
  (yinz-command (hash "Subscribe" '("AgentProvidersChanged")))
  (set! providers (ps-safe (lambda () (yinz-command "GetAgentProviders")) '()))
  (set! host-id (hash-ref (yinz-command "GetPluginIds") "host_id"))
  (with-handler (lambda (failure) (yinz-log (string-append "project-store: " (ps-error failure))))
    (yinz-data-define-all ps-namespace (yinz-agent-model "store" "SharedDefs" json-null))
    (yinz-command (hash "Subscribe" '("Timer")))
    (yinz-command (hash "SetTimeout" 5.0))
    (ps-import-legacy (hash-ref (yinz-command "GetPluginIds") "host_id"))
    (with-handler (lambda (failure) (yinz-log (string-append "project-store: could not watch projects: " (ps-error failure))))
      (define watch (yinz-data-watch ps-namespace (ps-limit (ps-request "project") 1000) "Rows"))
      (set! watch-id (hash-ref watch "watch_id"))
      (publish-context (ps-projects (hash-ref watch "rows")) json-null))
    (subscribe-agent)))
(define (update event)
  (define event (if (hash? event) event (hash)))
  (cond ((hash-contains? event "AgentProvidersChanged")
      (set! providers (hash-ref event "AgentProvidersChanged")) (set! retry? #t) (retry-snapshot))
    ((hash-contains? event "Timer") (retry-snapshot) (yinz-command (hash "SetTimeout" 5.0)))
    ((hash-contains? event "PluginDataChanged")
      (define change (hash-ref event "PluginDataChanged"))
      (when (equal? watch-id (hash-ref change "watch_id"))
        (define registry (ps-projects (hash-ref change "rows")))
        (if (and (not (json-null? latest)) (not (json-null? (hash-ref latest "panes")))) (publish-tabs registry latest) (publish-context registry latest))))) #f)
(define (pipe incoming)
  (define name (hash-ref incoming "name"))
  (define source (hash-ref incoming "source"))
  (define payload (hash-ref incoming "payload"))
  (define store? (member name '("store_query" "store_mutate")))
  (unless (or (and store? (hash? source) (hash-contains? source "Cli") (json-null? payload)) (and store? (not (authorized? source))))
    (define text (if (json-null? payload) "" payload))
    (cond ((and (equal? name "arrange_panes_by_project") (not arranging?))
        (set! arranging? #t) (message "arrange_projects_refresh" json-null json-null))
      ((and (equal? name "arrange_projects_snapshot") arranging? (from-service? source))
        (set! arranging? #f)
        (with-handler (lambda (failure) (yinz-command (hash "Notify" (list (string-append "Arrange panes: " (ps-error failure)) json-null json-null))))
          (define snapshot (ps-plan "agents" "PollReplyParse" text))
          (define classified (ps-arrange (ps-projects (ps-fetch (ps-limit (ps-request "project") 1000))) snapshot))
          (when (> (cadr classified) 0) (yinz-command (hash "Notify" (list (string-append "Arrange panes: " (number->string (cadr classified)) " panes have no available project identity") json-null json-null))))
          (yinz-command (hash "ArrangeProjectPanes" (car classified)))))
      ((equal? name "agent_hello") (when (from-service? source) (set! service-seq 0)) (subscribe-agent))
      ((equal? name "agent_snapshot")
        (define seq (agent-service-seq (hash-ref incoming "args")))
        (when (and seq (from-service? source) (> seq service-seq))
          (define snapshot (ps-safe (lambda () (ps-plan "agents" "PollReplyParse" text)) #f))
          (when snapshot (set! service-seq seq))
          (when (and snapshot (not (json-null? (hash-ref snapshot "panes"))))
            (set! latest snapshot) (set! retry? #t) (retry-snapshot))))
      (store? (handle source name text)))) #f)
