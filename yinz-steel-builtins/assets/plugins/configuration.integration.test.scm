(require "./testing/common.scm")

(define (wizard-focused?)
  (t-any (lambda (pane) (and (equal? (t-get pane "plugin_url" #f) "yinz:configuration")
        (hash-ref pane "is_focused"))) (s-panes)))
(for-each (lambda (preset)
    (test (string-append "first-run " preset " preset browses relative folders and opens the selected project")
      (hash "grants" '("RunCommands")) (lambda ()
        (define home (s-fixture (hash "project/marker" "") (hash)))
        (s-start (hash "columns" 160 "rows" 40))
        (test-wait-for-text "yinz-test>")
        (s-load "yinz:configuration" (hash "configuration" (hash "is_setup_wizard" "true")))
        (test-wait-for-text "How would you like to interact with Yinz?")
        (s-key "Ctrl p") (s-key "e")
        (test-wait-for "wizard floats like first launch" (lambda ()
            (t-any (lambda (pane) (and (equal? (t-get pane "plugin_url" #f) "yinz:configuration")
                  (hash-ref pane "is_floating"))) (s-panes))))
        (when (equal? preset "unlock-first") (s-key "Down"))
        (s-key "Enter")
        (test-wait-for-text "Choose your first project")
        ;; Replace the initial absolute cwd with a relative field value.
        (s-key "Enter") (s-key "Ctrl u") (s-text "project")
        (s-key "Ctrl f")
        (test-wait-for-text "Ctrl+Enter: select folder")
        (test-wait-for-text (string-append home "/project"))
        (s-key "Esc")
        (test-wait-for "cancel restores wizard focus" wizard-focused?)
        (test-wait-for "cancel closes the picker" (lambda () (not (string-contains? (s-screen) "Ctrl+Enter: select folder"))))
        ;; Reopening must use the preserved relative draft and the same initial cwd.
        (s-key "Ctrl f")
        (test-wait-for-text "Ctrl+Enter: select folder")
        (test-wait-for-text (string-append home "/project"))
        (s-key "Ctrl Enter")
        (test-wait-for "selection closes the picker" (lambda () (not (string-contains? (s-screen) "Ctrl+Enter: select folder"))))
        (test-wait-for "selection restores wizard focus" wizard-focused?)
        (test-wait-for-text (string-append home "/project"))
        (s-key "Tab") (s-key "Tab") (s-key "Enter")
        (test-wait-for-text "Start working")
        (s-key "Tab") (s-key "Tab") (s-key "Enter")
        (test-wait-for "wizard closes after opening a terminal" (lambda ()
            (not (t-any (lambda (pane) (equal? (t-get pane "plugin_url" #f) "yinz:configuration")) (s-panes)))))
        (test-wait-for-text "yinz-test>")
        (s-text "test -f marker && printf 'PROJECT_%s\\n' READY") (s-key "Enter")
        (test-wait-for-text "PROJECT_READY")))) '("default" "unlock-first"))

(test "first-run creates a Git project and launches an agent in its main checkout"
  (hash "grants" '("RunCommands")) (lambda ()
    (define home (s-fixture (hash "parent 目录/marker" "")
        (hash "codex" "printf 'AGENT_ROOT=%s\\n' \"$PWD\"\nprintf 'AGENT_BRANCH=%s\\n' \"$(git symbolic-ref --short HEAD)\"\nif git rev-parse --verify HEAD >/dev/null 2>&1; then printf 'UNEXPECTED_COMMIT\\n'; else printf 'UNBORN_MAIN\\n'; fi\nIFS= read -r line\nprintf 'AGENT_INPUT=%s\\n' \"$line\"\nexec /bin/sh\n")))
    (s-start (hash "columns" 160 "rows" 40))
    (test-wait-for-text "yinz-test>")
    (s-load "yinz:configuration" (hash "configuration" (hash "is_setup_wizard" "true")))
    (test-wait-for-text "How would you like to interact with Yinz?")
    (s-key "Ctrl p") (s-key "e")
    (test-wait-for "wizard is floating" (lambda ()
        (t-any (lambda (pane) (and (equal? (t-get pane "plugin_url" #f) "yinz:configuration") (hash-ref pane "is_floating"))) (s-panes))))
    (s-key "Enter")
    (test-wait-for-text "Choose your first project")
    (s-key "Shift Tab") (s-key "Enter") (s-key "Down") (s-key "Enter")
    (test-wait-for-text "Parent directory")
    (s-key "Enter") (s-key "Ctrl u") (s-text "~/parent 目录")
    (s-key "Tab") (s-text "new 项目")
    (s-key "Tab") (s-key "Tab") (s-key "Enter")
    (test-wait-for-text "Start working")
    (test-wait-for-text (string-append home "/parent 目录/new 项目"))
    ;; The catalog starts with Codex; use provider defaults and no branch or prompt.
    (s-key "Tab") (s-key "Enter")
    (test-wait-for "wizard closes after successful agent launch" (lambda ()
        (not (t-any (lambda (pane) (equal? (t-get pane "plugin_url" #f) "yinz:configuration")) (s-panes)))))
    (test-wait-for-text (string-append "AGENT_ROOT=" home "/parent 目录/new 项目"))
    (test-wait-for-text "AGENT_BRANCH=main")
    (test-wait-for-text "UNBORN_MAIN")
    (s-text "focused") (s-key "Enter")
    (test-wait-for-text "AGENT_INPUT=focused")))
