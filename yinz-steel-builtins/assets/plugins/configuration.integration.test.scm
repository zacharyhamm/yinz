(require "./testing/common.scm")

;; Keep the real finder script and directory traversal, but make selection independent
;; of an installed fzf and its terminal UI. Its first candidate is the search root.
(define finder-command
  "root=$(tr '\\000' '\\n' | head -n 1)\nprintf 'PICKER_ROOT=%s\\r\\n' \"$root\" > /dev/tty\nIFS= read -r decision < /dev/tty\ncase \"$decision\" in select) printf '%s\\000' \"$root\";; *) exit 130;; esac\n")
(define (wizard-focused?)
  (t-any (lambda (pane) (and (equal? (t-get pane "plugin_url" #f) "yinz:configuration")
        (hash-ref pane "is_focused"))) (s-panes)))
(for-each (lambda (preset)
    (test (string-append "first-run " preset " preset browses relative folders and opens the selected project")
      (hash "grants" '("RunCommands")) (lambda ()
        (define home (s-fixture (hash "project/marker" "") (hash "fzf" finder-command)))
        (s-start (hash "columns" 160 "rows" 40))
        (test-wait-for-text "yinz-test>")
        (s-load "yinz:configuration" (hash "configuration" (hash "is_setup_wizard" "true")))
        (test-wait-for-text "How would you like to interact with Yinz?")
        (s-key "Ctrl p") (s-key "e")
        (test-wait-for "wizard floats like first launch" (lambda ()
            (t-any (lambda (pane) (and (equal? (t-get pane "plugin_url" #f) "yinz:configuration")
                  (hash-ref pane "is_floating"))) (s-panes))))
        (when (equal? preset "unlock-first") (s-key "Down"))
        (s-key "Enter")
        (test-wait-for-text "Choose your first project")
        ;; Replace the initial absolute cwd with a relative field value.
        (s-key "Enter") (s-key "Ctrl u") (s-text "project")
        (s-key "Ctrl f")
        (test-wait-for-text (string-append "PICKER_ROOT=" home "/project"))
        (s-text "cancel") (s-key "Enter")
        (test-wait-for "cancel restores wizard focus" wizard-focused?)
        (test-wait-for "cancel closes the picker" (lambda () (not (string-contains? (s-screen) "PICKER_ROOT="))))
        ;; Reopening must use the preserved relative draft and the same initial cwd.
        (s-key "Ctrl f")
        (test-wait-for-text (string-append "PICKER_ROOT=" home "/project"))
        (s-text "select") (s-key "Enter")
        (test-wait-for "selection closes the picker" (lambda () (not (string-contains? (s-screen) "PICKER_ROOT="))))
        (test-wait-for "selection restores wizard focus" wizard-focused?)
        (test-wait-for-text (string-append home "/project"))
        (s-key "Tab") (s-key "Tab") (s-key "Enter")
        (test-wait-for "wizard closes after project selection" (lambda ()
            (not (t-any (lambda (pane) (equal? (t-get pane "plugin_url" #f) "yinz:configuration")) (s-panes)))))
        (test-wait-for-text "yinz-test>")
        (s-text "test -f marker && printf 'PROJECT_%s\\n' READY") (s-key "Enter")
        (test-wait-for-text "PROJECT_READY")))) '("default" "unlock-first"))
