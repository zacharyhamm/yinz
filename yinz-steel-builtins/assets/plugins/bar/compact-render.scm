(require "./keys.scm")
(require "./style.scm")
(provide compact-render)
(define (parts-width parts) (foldl (lambda (part n) (+ n (hash-ref part "len"))) 0 parts))
(define (colors mi) (hash-ref (hash-ref mi "style") "colors"))
(define (prefix state cols)
  (define mi (hash-ref state "modeInfo"))
  (define p (hash-ref (colors mi) "text_unselected"))
  (define dim (bar-dimmed? mi))
  (define (style text) (bar-paint text (hash-ref p "base") (hash-ref p "background") (if dim "3" "1")))
  (define host (string-append " " (if (equal? (hash-ref state "hostname") "") "Yinz" (hash-ref state "hostname")) " "))
  (define parts (list (bar-line (style host) (yinz-text-width host))))
  (define breadcrumb #f)
  (define name (if (hash-ref (hash-ref mi "style") "hide_session_name") #f (hash-ref mi "session_name")))
  (define ancestors (if (equal? (bar-get mi "host_fullscreen" #f) #t) (hash-ref mi "session_ancestry") '()))
  (when (bar-present? name)
    (if (not (null? ancestors))
      (let ((ancestor (string-append "(" (string-join ancestors " ▸ ") " ▸ ")))
        (when (>= (max 0 (- cols (parts-width parts))) (+ (yinz-text-width ancestor) (yinz-text-width name) 2))
          (set! breadcrumb (list (parts-width parts) (+ (parts-width parts) (yinz-text-width ancestor))))
          (set! parts (append parts (list
                (bar-line (bar-paint ancestor (if dim #f (hash-ref p "base")) (hash-ref p "background") (if dim "2" "3")) (yinz-text-width ancestor))
                (bar-line (bar-paint name (if dim #f (hash-ref p "emphasis_0")) (hash-ref p "background") (if dim "2" "1")) (yinz-text-width name))
                (bar-line (bar-paint ") " (if dim #f (hash-ref p "base")) (hash-ref p "background") (if dim "2" "1")) 2))))))
      (when (>= (max 0 (- cols (parts-width parts))) (+ (yinz-text-width name) 2))
        (set! parts (append parts (list (bar-line (style (string-append "(" name ")")) (+ (yinz-text-width name) 2))))))))
  (define mode (string-append " " (string-upcase (hash-ref mi "mode")) " "))
  (when (>= (max 0 (- cols (parts-width parts))) (yinz-text-width mode))
    (define fg (hash-ref p (cond (dim "base") ((equal? (hash-ref mi "mode") "Locked") "emphasis_3")
          ((equal? (hash-ref mi "mode") "Normal") "emphasis_2") (else "emphasis_0"))))
    (set! parts (append parts (list (bar-line (bar-paint mode fg (hash-ref p "background") (if dim "3" "1")) (yinz-text-width mode))))))
  (hash "parts" parts "breadcrumb" breadcrumb))
;; Legacy tile-utils charges every Unicode scalar at least one column here.
(define (ellipsize text budget)
  (cond ((<= (yinz-text-width text) budget) text) ((= budget 0) "")
    (else (let loop ((characters (string->list text)) (used 0) (result '()))
        (if (or (null? characters) (> (+ used (max 1 (yinz-text-width (string (car characters))))) (- budget 1)))
          (string-append (list->string (reverse result)) "…")
          (loop (cdr characters) (+ used (max 1 (yinz-text-width (string (car characters))))) (cons (car characters) result)))))))
(define (tile mi text fg bg attributes)
  (define outer (hash-ref (hash-ref (colors mi) "text_unselected") "background"))
  (bar-line (string-append (bar-paint (bar-arrow mi) outer bg "") (bar-paint text fg bg attributes) (bar-paint (bar-arrow mi) bg outer ""))
    (+ (yinz-text-width text) (* 2 (yinz-text-width (bar-arrow mi))))))
(define (tab-part mi tab alternate budget)
  (define p (colors mi))
  (define r (hash-ref p (if (hash-ref tab "active") "ribbon_selected" "ribbon_unselected")))
  (define dim (bar-dimmed? mi))
  (define bg (if dim (hash-ref (hash-ref p "ribbon_unselected") "background")
      (hash-ref r (if (and (not (hash-ref tab "active")) alternate (hash-ref (hash-ref mi "capabilities") "arrow_fonts")) "emphasis_1" "background"))))
  (define fg (if dim (hash-ref (hash-ref p "ribbon_unselected") "base") (hash-ref r (if (hash-ref tab "is_flashing_bell") "emphasis_3" "base"))))
  (define suffix (string-append (cond ((hash-ref tab "is_fullscreen_active") " (FULLSCREEN)") ((hash-ref tab "is_sync_panes_active") " (SYNC)") (else ""))
      (if (or (hash-ref tab "has_bell_notification") (hash-ref tab "is_flashing_bell")) " [!]" "")))
  (define name (if (and (hash-ref tab "active") (equal? (hash-ref mi "mode") "RenameTab") (equal? (hash-ref tab "name") "")) "Enter name..." (hash-ref tab "name")))
  (define text (string-append " " (ellipsize name (max 0 (- budget (yinz-text-width suffix)))) suffix " "))
  (define (style text) (bar-paint text fg bg (if dim "3" "1")))
  (define body (style text))
  (define size (+ (yinz-text-width text) (* 2 (yinz-text-width (bar-arrow mi)))))
  (unless (null? (hash-ref tab "other_focused_clients"))
    (define cursors (bar-focused-client-cursors tab (hash-ref p "multiplayer_user_colors")))
    (set! body (string-append body (style "[") (apply string-append cursors) (style "]")))
    (set! size (+ size (length cursors) 2)))
  (define outer (hash-ref (hash-ref p "text_unselected") "background"))
  (hash "part" (string-append (bar-paint (bar-arrow mi) outer bg "") body (bar-paint (bar-arrow mi) bg outer "")) "len" size "tab" (hash-ref tab "position")))
(define (collapsed mi count left tab)
  (if (= count 0) (bar-line "" 0)
    (let ((n (if (< count 10000) (number->string count) "many")) (p (colors mi)))
      (hash-insert (tile mi (if left (string-append " ← +" n " ") (string-append " +" n " → "))
          (hash-ref (hash-ref p "ribbon_unselected") "base") (hash-ref (hash-ref p "text_selected") "emphasis_0") (if (bar-dimmed? mi) "3" "1")) "tab" tab))))
(define (visible-tabs all active cols mi)
  (define index (min active (- (length all) 1)))
  (let loop ((before (reverse (take all index))) (after (drop all (+ index 1))) (middle (list (list-ref all index))) (left-width 0) (right-width 0))
    (define left (collapsed mi (length before) #t (max 0 (- (length before) 1))))
    (define right (collapsed mi (length after) #f (+ (length before) (length middle))))
    (define total (+ (hash-ref left "len") (parts-width middle) (hash-ref right "len")))
    (define left-fits (and (not (null? before)) (<= (- (+ (hash-ref (car before) "len") total) (if (= (length before) 1) (hash-ref left "len") 0)) cols)))
    (define right-fits (and (not (null? after)) (<= (- (+ (hash-ref (car after) "len") total) (if (= (length after) 1) (hash-ref right "len") 0)) cols)))
    (cond ((> total cols) middle)
      ((and (or (<= left-width right-width) (not right-fits)) left-fits)
        (loop (cdr before) after (cons (car before) middle) (+ left-width (hash-ref (car before) "len")) right-width))
      (right-fits (loop before (cdr after) (append middle (list (car after))) left-width (+ right-width (hash-ref (car after) "len"))))
      (else (append (list left) middle (list right))))))
(define (nested-hint mi budget)
  (define ascend (equal? (bar-get mi "session_dimmed" #f) #t))
  (define keys (hash-ref mi (if ascend "nested_ascend_keys" "nested_descend_keys")))
  (define p (hash-ref (colors mi) "text_unselected"))
  (define label (if ascend " Ascend: " " Descend: "))
  (define labels (if (null? keys) '("<unbound>") (map (lambda (key) (string-append "<" (bar-key-label key) ">")) keys)))
  (define size (+ (yinz-text-width label) (apply + (map yinz-text-width labels)) (* (- (length labels) 1) 3)))
  (if (<= size budget)
    (bar-line (string-append (bar-paint label #f (hash-ref p "background") "2;3")
        (string-join (map (lambda (key) (bar-paint key (if (null? keys) #f (hash-ref p "emphasis_0")) (hash-ref p "background") (if (null? keys) "2;3" "1"))) labels)
          (bar-paint " + " (hash-ref p "base") (hash-ref p "background") ""))) size)
    (let ((fallback (if ascend " nested session" " host session")))
      (and (<= (yinz-text-width fallback) budget) (bar-line (bar-paint fallback #f (hash-ref p "background") "2;3") (yinz-text-width fallback))))))
(define (right-elements state active budget)
  (define mi (hash-ref state "modeInfo"))
  (if (bar-dimmed? mi) (let ((hint (nested-hint mi budget))) (if hint (list hint) '()))
    (let ((parts '()) (p (colors mi)))
      (when (hash-ref state "toggleKey")
        (define key (hash-ref state "toggleKey"))
        (set! parts (list (bar-line (string-append (yinz-ui-text (hash "text" key "opaque" #t "levels" (list '() '() '() (range (string-length key))))) " "
                (yinz-ui-ribbon (hash "text" "Tooltip" "selected" (hash-ref state "tooltipActive")))) (+ (string-length key) 13)))))
      (when (and (not (equal? (hash-ref mi "mode") "RenameTab")) (bar-present? (hash-ref active "active_swap_layout_name")))
        (define name (string-append " " (list->string (map (lambda (char) (if (and (char>=? char #\a) (char<=? char #\z)) (integer->char (- (char->integer char) 32)) char))
                (string->list (hash-ref active "active_swap_layout_name")))) " "))
        (define size (+ (length (bytes->list (string->bytes name))) 3))
        (when (<= size budget)
          (define bg (hash-ref (hash-ref p (if (or (equal? (hash-ref mi "mode") "Locked") (hash-ref active "is_swap_layout_dirty")) "ribbon_unselected" "ribbon_selected")) "background"))
          (define part (tile mi name (hash-ref (hash-ref p "text_unselected") "background") bg (if (equal? (hash-ref mi "mode") "Locked") "3" "1")))
          (set! parts (append parts (list (hash-insert part "len" size))))))
      parts)))
(define (compact-render state cols)
  (define mi (hash-ref state "modeInfo"))
  (define result (prefix state cols))
  (define parts (hash-ref result "parts"))
  (define used (parts-width parts))
  (define budget (max 8 (min 40 (- cols used (* 2 (yinz-text-width (bar-arrow mi))) 2))))
  (define index -1)
  (define all (map (lambda (tab) (set! index (+ index 1)) (tab-part mi tab (= (modulo index 2) 1) budget)) (hash-ref state "tabs")))
  (define active (foldl (lambda (tab active) (if (hash-ref tab "active") tab active)) (car (hash-ref state "tabs")) (hash-ref state "tabs")))
  (define active-part (list-ref all (min (hash-ref active "position") (- (length all) 1))))
  (when (<= (+ used (hash-ref active-part "len")) cols)
    (set! parts (append parts (visible-tabs all (hash-ref active "position") (max 0 (- cols used)) mi)))
    (define current (parts-width parts))
    (when (< current cols)
      (define right (right-elements state active (- cols current)))
      (define right-len (parts-width right))
      (when (<= (+ current right-len) cols)
        (define padding (- cols current right-len))
        (define bg (hash-ref (hash-ref (colors mi) "text_unselected") "background"))
        (when (> padding 0) (set! parts (append parts (list (bar-line (apply string-append (map (lambda (n) (bar-paint " " bg bg "")) (range padding))) padding)))))
        (set! parts (append parts right)))))
  (hash-insert result "parts" parts))
