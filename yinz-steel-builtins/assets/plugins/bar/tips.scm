(require "./keys.scm" "./style.scm")
(provide bar-cached-tip bar-tip)

(define tip-names '("quicknav" "floating_panes_mouse" "send_mouse_clicks_to_terminal"
    "move_focus_hjkl_tab_switch" "yinz_setup_check" "use_mouse" "sync_tab"
    "edit_scrollbuffer" "compact_layout" "move_tabs"))
(define cache-path "/tmp/status-bar-tips.cache")
(define (valid-cache? cache)
  (and (hash? cache) (string? (bar-get cache "yinz_version" #f))
    (hash? (bar-get cache "cached_data" #f))
    (foldl (lambda (name valid)
        (define count (hash-ref (hash-ref cache "cached_data") name))
        (and valid (integer? count) (>= count 0) (<= count 9007199254740991)))
      #t (hash-keys->list (hash-ref cache "cached_data")))))
(define (bar-cached-tip)
  (with-handler (lambda (error) "quicknav")
    (define metadata (yinz-command (hash "FsMetadata" (hash "path" cache-path))))
    (define source (if (bar-present? metadata)
        (yinz-decode-utf8 (yinz-command (hash "FsRead"
              (hash "path" cache-path "max_bytes" json-null "offset" json-null)))) ""))
    (define version (yinz-command "GetYinzVersion"))
    (define cache (if (equal? source "") (hash "yinz_version" version "cached_data" (hash))
        (yinz-json-parse source)))
    (if (not (valid-cache? cache)) "quicknav"
      (let ((counts (if (equal? (hash-ref cache "yinz_version") version)
              (hash-ref cache "cached_data") (hash))))
        (when (null? (hash-keys->list counts))
          (set! counts (foldl (lambda (name result) (hash-insert result name 1)) (hash) tip-names)))
        (define names (sort (hash-keys->list counts) string<?))
        (define chosen (if (<= (bar-get counts "quicknav" 0) 20) "quicknav"
            (list-ref names (yinz-random-integer (length names)))))
        (set! counts (hash-insert counts chosen (+ (bar-get counts chosen 0) 1)))
        (define encoded (yinz-json-string (hash "yinz_version" version "cached_data" counts)))
        (yinz-command (hash "FsWrite" (hash "path" cache-path "contents" (bytes->list (string->bytes encoded))
              "append" #f "create_dirs" #f)))
        chosen))))

(define (bar-tip mi name maximum)
  (define palette (hash-ref (hash-ref mi "style") "colors"))
  (define colors (hash-ref palette "text_unselected"))
  (define (emph text . level)
    (bar-paint text (hash-ref colors (if (or (null? level) (= (car level) 0)) "emphasis_0" "emphasis_2")) #f "1"))
  (define unbound (bar-paint "UNBOUND" #f #f "1"))
  (define (keys bindings) (if (null? bindings) unbound (bar-classic-keys bindings palette #f)))
  (define keymap (bar-mode-keymap mi))
  (define (sequence mode action)
    (define bindings (bar-action-keys (bar-mode-keymap mi mode) (list action (bar-switch-mode "Normal"))))
    (if (null? bindings) unbound
      (string-append (bar-classic-keys (bar-action-keys keymap (list (bar-switch-mode mode))) palette #f)
        ", " (bar-classic-keys bindings palette #f))))
  (define (arrow? key)
    (foldl (lambda (character found) (or found (member character '(#\← #\↓ #\↑ #\→))))
      #f (string->list (bar-key-label key))))
  (define (navigation bindings)
    (if (null? bindings) unbound
      (string-join (map (lambda (group) (bar-classic-keys group palette #f))
          (filter (lambda (group) (not (null? group)))
            (list (filter arrow? bindings) (filter (lambda (key) (not (arrow? key))) bindings)))) " or ")))
  (define forms
    (cond
      ((equal? name "floating_panes_mouse")
        (define key (sequence "Pane" "ToggleFloatingPanes"))
        (list (string-append " Tip: Toggle floating panes with " key " and move them with keyboard or mouse")
          (string-append " Tip: Toggle floating panes with " key) (string-append key " => floating panes")))
      ((equal? name "send_mouse_clicks_to_terminal")
        (define key (string-append " Tip: " (emph "Shift") " + <" (emph "mouse-click" 2) ">"))
        (list (string-append key " bypasses Yinz and sends the mouse click directly to the terminal.")
          (string-append key " sends the click directly to the terminal.")
          (string-append key " => sends click to terminal.")))
      ((equal? name "move_focus_hjkl_tab_switch")
        (define key (navigation (bar-action-group (bar-mode-keymap mi "Pane")
              (list (list (bar-direction "MoveFocusOrTab" "Left")) (list (bar-direction "MoveFocusOrTab" "Right"))))))
        (list (string-append " Tip: When changing focus with " key " moving off screen left/right focuses the next tab.")
          (string-append " Tip: Changing focus with " key " off screen focuses the next tab.")
          (string-append key " off screen edge focuses next tab.")))
      ((equal? name "yinz_setup_check")
        (define command (emph "yinz setup --check"))
        (list (string-append " Tip: Having issues with Yinz? Try running " command)
          (string-append " Tip: Run " command " to find issues") (string-append " Run " command " to find issues")))
      ((equal? name "use_mouse")
        (list (string-append " Tip: " (emph "Use the mouse" 2) " to switch pane focus, scroll through the pane scrollbuffer, switch or scroll through the tabs.")
          (string-append " Tip: " (emph "Use the mouse" 2) " to switch pane/tabs or scroll through the pane scrollbuffer.")
          (string-append (emph " Use the mouse" 2) " to switch pane/tabs or scroll.")))
      ((equal? name "sync_tab")
        (define key (sequence "Tab" "ToggleActiveSyncTab"))
        (list (string-append " Tip: Sync a tab and write keyboard input to all its panes with " key)
          (string-append " Tip: Sync input to panes in a tab with " key) (string-append " Sync input in a tab with " key)))
      ((equal? name "edit_scrollbuffer")
        (define key (sequence "Scroll" (hash "EditScrollback" (hash "ansi" #f))))
        (define editor (emph "$EDITOR"))
        (list (string-append " Tip: Search through the scrollbuffer using your default " editor " with " key)
          (string-append " Tip: Search the scrollbuffer using your " editor " with " key)
          (string-append " Search using " editor " with " key)))
      ((equal? name "compact_layout")
        (define key (sequence "Pane" "TogglePaneFrames"))
        (define command (emph "yinz -l compact"))
        (list (string-append " Tip: UI taking up too much space? Start Yinz with " command " or remove pane frames with " key)
          (string-append " Tip: To save screen space, start Yinz with " command " or remove frames with " key)
          (string-append " Save screen space, start with: " command " or remove frames with " key)))
      ((equal? name "move_tabs")
        (define key (string-append (emph "Alt + i" 2) " (left) and " (emph "Alt + o" 2) " (right)"))
        (list (string-append " Tip: Wrong order of tabs? You can move them to left and right with: " key)
          (string-append " Tip: You can move tabs to left and right with: " key) (string-append " Move tabs with: " key)))
      (else
        (define pane (keys (bar-action-keys keymap (list (bar-new-pane json-null)))))
        (define resize (bar-action-group keymap (list (list (bar-resize "Increase" json-null)) (list (bar-resize "Decrease" json-null)))))
        (when (and (member (bar-char-key "=" '("Alt")) resize) (member (bar-char-key "+" '("Alt")) resize))
          (set! resize (filter (lambda (key) (not (bar-equal? key (bar-char-key "=" '("Alt"))))) resize)))
        (define size (keys resize))
        (define focus (navigation (bar-action-group keymap
              (list (list (bar-direction "MoveFocus" "Left")) (list (bar-direction "MoveFocusOrTab" "Left"))
                (list (bar-direction "MoveFocus" "Down")) (list (bar-direction "MoveFocus" "Up"))
                (list (bar-direction "MoveFocus" "Right")) (list (bar-direction "MoveFocusOrTab" "Right"))))))
        (list (string-append " Tip: " pane " => open new pane. " focus " => navigate between panes. " size " => increase/decrease pane size.")
          (string-append " Tip: " pane " => new pane. " focus " => navigate. " size " => resize pane.")
          (string-append " QuickNav: " pane " / " focus " / " size)))))
  (let choose ((forms forms))
    (if (null? forms) (bar-line "" 0)
      (let ((line (bar-byte-line (car forms))))
        (if (<= (hash-ref line "len") maximum) line (choose (cdr forms)))))))
