(require "./keys.scm")
(provide bar-line bar-concat bar-color bar-paint bar-fill bar-arrow bar-dimmed? bar-text-part
  bar-byte-line bar-classic-keys bar-tile-colors bar-prefix-paint bar-prefix-suffix
  bar-modifier-prefix bar-abbreviated-key bar-shortcut bar-focused-client-cursors)
(define (bar-line text len) (hash "part" text "len" len))
(define (bar-concat . parts)
  (bar-line (apply string-append (map (lambda (p) (hash-ref p "part")) parts))
    (foldl (lambda (p n) (+ n (hash-ref p "len"))) 0 parts)))
(define (bar-color color background)
  (string-append (if background "48;" "38;")
    (if (hash-contains? color "Rgb") (string-append "2;" (string-join (map number->string (hash-ref color "Rgb")) ";"))
      (string-append "5;" (number->string (hash-ref color "EightBit"))))))
(define (bar-paint text fg bg attributes)
  (define codes (filter (lambda (code) (not (equal? code "")))
      (list attributes (if fg (bar-color fg #f) "") (if bg (bar-color bg #t) ""))))
  (if (or (equal? text "") (null? codes)) text
    (string-append (string (integer->char 27)) "[" (string-join codes ";") "m" text
      (string (integer->char 27)) "[0m")))
;; A colored cell for each other client focused on `tab`, in its multiplayer color. A host that
;; numbers clients without reuse sends each one's color slot; an older one's ids are the slots.
(define (bar-focused-client-cursors tab players)
  (define slots
    (if (hash-contains? tab "other_focused_client_slots")
      (filter bar-present? (hash-ref tab "other_focused_client_slots"))
      (filter (lambda (id) (and (>= id 1) (<= id 10))) (hash-ref tab "other_focused_clients"))))
  (map (lambda (slot)
      (bar-paint " " (hash "EightBit" 16) (hash-ref players (string-append "player_" (number->string slot))) ""))
    slots))
(define (bar-fill mi)
  (string-append (string (integer->char 27)) "["
    (bar-color (hash-ref (hash-ref (hash-ref (hash-ref mi "style") "colors") "text_unselected") "background") #t)
    "m" (string (integer->char 27)) "[0K"))
(define (bar-arrow mi) (if (hash-ref (hash-ref mi "capabilities") "arrow_fonts") "" ""))
(define (bar-dimmed? mi)
  (or (equal? (bar-get mi "session_ascended" #f) #t) (equal? (bar-get mi "session_dimmed" #f) #t)))
(define (bar-text-part text emphasis dimmed)
  (bar-line (yinz-ui-text (hash "text" text "opaque" #t "disabled" dimmed
        "levels" (if (and emphasis (not dimmed))
          (append (map (lambda (n) '()) (range emphasis)) (list (range (string-length text)))) '())))
    (yinz-text-width text)))
(define (bar-byte-line part)
  (bar-line part (length (bytes->list (string->bytes (yinz-text-sanitize part))))))
(define (bar-classic-keys keys palette background)
  (if (null? keys) ""
    (let* ((common (bar-common-modifiers keys)) (c (hash-ref palette "text_unselected"))
        (labels (map (lambda (key) (bar-key-label (if (null? common) key (bar-strip-modifiers key common)))) keys))
        (separator (bar-paint (bar-key-separator labels) (hash-ref c "base") background "")))
      (string-append
        (bar-paint (string-join common "-") (hash-ref c "emphasis_0") background "1")
        (bar-paint (if (null? common) "<" " + <") (hash-ref c "base") background "")
        (string-join (map (lambda (label) (bar-paint label (hash-ref c "emphasis_2") background "1")) labels) separator)
        (bar-paint ">" (hash-ref c "base") background "")))))
(define (bar-tile-colors mi mode dimmed)
  (define p (hash-ref (hash-ref mi "style") "colors"))
  (define outer (hash-ref (hash-ref p "text_unselected") "background"))
  (define r (hash-ref p (if (and (equal? mode "selected") (not dimmed)) "ribbon_selected" "ribbon_unselected")))
  (define bg (hash-ref r (if (and (equal? mode "alternate") (hash-ref (hash-ref mi "capabilities") "arrow_fonts") (not dimmed)) "base" "background")))
  (define fg (if (and (equal? mode "alternate") (not dimmed)) outer (hash-ref r "base")))
  (define attributes (if dimmed "3" (if (equal? mode "disabled") "2;3" "1")))
  (hash "prefix" (lambda (text) (bar-paint text outer bg ""))
    "key" (lambda (text) (bar-paint text (hash-ref r (if (or (equal? mode "disabled") dimmed) "base" "emphasis_0")) bg attributes))
    "bracket" (lambda (text) (bar-paint text fg bg attributes))
    "text" (lambda (text) (bar-paint text (hash-ref r "base") bg attributes))
    "suffix" (lambda (text) (bar-paint text bg outer (if (or (equal? mode "disabled") dimmed) "" "1")))))
(define (bar-prefix-paint mi text dimmed)
  (define p (hash-ref (hash-ref (hash-ref mi "style") "colors") "text_unselected"))
  (bar-paint text (hash-ref p "base") (hash-ref p "background") (if dimmed "3" "1")))
(define (bar-prefix-suffix mi)
  (define background (hash-ref (hash-ref (hash-ref (hash-ref mi "style") "colors") "text_unselected") "background"))
  (bar-paint (bar-arrow mi) background background ""))
(define (bar-modifier-prefix mi mods)
  (string-append " " (string-join mods "-") " +" (if (hash-ref (hash-ref mi "capabilities") "arrow_fonts") " " "")))
(define (bar-abbreviated-key key common)
  (define stripped (bar-strip-modifiers key common))
  (define labels (hash "Ctrl" "^C" "Alt" "^A" "Super" "^Su" "Shift" "^Sh"))
  (define mods (string-join (map (lambda (m) (hash-ref labels m))
        (filter (lambda (m) (member m (hash-ref stripped "key_modifiers"))) bar-modifiers)) "-"))
  (string-append mods (if (equal? mods "") "" " ") (bar-bare-label (hash-ref stripped "bare_key"))))
(define (component-keys keys emphasis dimmed)
  (define common (bar-common-modifiers keys))
  (define labels (map (lambda (key) (bar-key-label (if (> (length keys) 1) (bar-strip-modifiers key common) key))) keys))
  (define joined (string-join labels (bar-key-separator labels)))
  (define multi (and (not (null? common)) (> (length keys) 1)))
  (define modifier (string-join common "-"))
  (define content (if multi (string-append " " modifier " <" joined "> ") (string-append " " joined " ")))
  (bar-line (yinz-ui-text (hash "text" content "opaque" #t "disabled" dimmed
        "levels" (if (and emphasis (not dimmed))
          (append (map (lambda (n) '()) (range emphasis))
            (list (if multi (append (range (+ (string-length modifier) 1))
                  (range (+ (string-length modifier) 3) (+ (string-length modifier) 3 (string-length joined))))
                (range (string-length content))))) '()))) (yinz-text-width content)))
(define (bar-shortcut mi label keys selected emphasis inline hovered key-only)
  (if (null? keys) (bar-line "" 0)
    (let* ((dimmed (equal? (bar-get mi "session_dimmed" #f) #t))
        (labels (map bar-key-label keys))
        (joined (string-join labels (if key-only "-" (bar-key-separator labels #t))))
        (content (if key-only joined (if inline (string-append "<" joined "> " label) label))))
      (define ribbon
        (if (and hovered (not dimmed))
          (let* ((p (hash-ref (hash-ref mi "style") "colors")) (r (hash-ref p "ribbon_unselected"))
              (bg (hash-ref r "emphasis_1")) (outer (hash-ref (hash-ref p "text_unselected") "background")))
            (string-append (bar-paint (bar-arrow mi) outer bg "")
              (if inline
                (string-append (bar-paint " <" (hash-ref r "base") bg "1")
                  (bar-paint joined (hash-ref r "emphasis_0") bg "1")
                  (bar-paint (string-append "> " label " ") (hash-ref r "base") bg "1"))
                (bar-paint (string-append " " label " ") (hash-ref r "base") bg "1"))
              (bar-paint (bar-arrow mi) bg outer "")))
          (yinz-ui-ribbon (hash "text" content "disabled" dimmed "selected" (and (not dimmed) selected)
              "levels" (if dimmed '() (cond (key-only (list (range (string-length content))))
                  (inline (list (range 1 (+ (string-length joined) 1)))) (else '())))))))
      (define result (bar-line ribbon (+ (yinz-text-width content) (if (hash-ref (hash-ref mi "capabilities") "arrow_fonts") 2 4))))
      (if (or inline key-only) result (bar-concat (component-keys keys emphasis dimmed) result)))))
