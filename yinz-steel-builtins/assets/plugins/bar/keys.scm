(provide bar-get bar-present? bar-equal? bar-tag bar-key bar-char-key bar-key-label bar-bare-label
  bar-key-separator bar-common-modifiers bar-strip-modifiers bar-mode-keymap bar-switch-mode
  bar-new-pane bar-resize bar-direction bar-action-keys bar-action-group bar-shallow-equal?
  bar-tab-groups? bar-compare-keys bar-own-key bar-plugin-keys bar-pipe-keys bar-to-char bar-generic-key? bar-modifiers bar-index)

(define (bar-get object key fallback) (if (hash-contains? object key) (hash-ref object key) fallback))
(define (bar-present? value) (and value (not (json-null? value))))
(define bar-modifiers '("Ctrl" "Alt" "Shift" "Super"))
(define bare-order '("PageDown" "PageUp" "Left" "Down" "Up" "Right" "Home" "End" "Backspace"
    "Delete" "Insert" "F" "Char" "Tab" "Esc" "Enter" "CapsLock" "ScrollLock"
    "NumLock" "PrintScreen" "Pause" "Menu"))
(define (bar-index item items)
  (let loop ((items items) (n 0))
    (cond ((null? items) -1) ((equal? item (car items)) n) (else (loop (cdr items) (+ n 1))))))
(define (bar-tag value) (if (string? value) value (if (hash? value) (car (hash-keys->list value)) "")))
(define (canonical-key value)
  (define bare (bar-get value "bare_key" #f))
  (define mods (bar-get value "key_modifiers" #f))
  (define character (and (hash? bare) (bar-get bare "Char" #f)))
  (if (and character mods (= (string-length character) 1)
      (>= (char->integer (car (string->list character))) 65)
      (<= (char->integer (car (string->list character))) 90))
    (hash-insert (hash-insert value "bare_key" (hash "Char" (string-downcase character)))
      "key_modifiers" (filter (lambda (m) (or (equal? m "Shift") (member m mods))) bar-modifiers))
    value))
(define (bar-equal? left right)
  (cond
    ((equal? left right) #t)
    ((and (hash? left) (hash? right))
      (define a (canonical-key left))
      (define b (canonical-key right))
      (and (= (length (hash-keys->list a)) (length (hash-keys->list b)))
        (foldl (lambda (key same) (and same (hash-contains? b key) (bar-equal? (hash-ref a key) (hash-ref b key)))) #t (hash-keys->list a))))
    ((and (list? left) (list? right))
      (and (= (length left) (length right))
        (or (null? left) (and (bar-equal? (car left) (car right)) (bar-equal? (cdr left) (cdr right))))))
    (else #f)))
(define (bar-shallow-equal? action pattern)
  (if (member (bar-tag action) '("NewTab" "LaunchPlugin" "LaunchOrFocusPlugin" "OverrideLayout"))
    (equal? (bar-tag action) (bar-tag pattern)) (bar-equal? action pattern)))
(define (bar-key bare mods) (hash "bare_key" bare "key_modifiers" mods))
(define (bar-char-key char mods) (bar-key (hash "Char" char) mods))
(define (bar-switch-mode mode) (hash "SwitchToMode" (hash "input_mode" mode)))
(define (bar-new-pane direction) (hash "NewPane" (hash "direction" direction "pane_name" 'json-null "start_suppressed" #f)))
(define (bar-resize size direction) (hash "Resize" (hash "resize" size "direction" direction)))
(define (bar-direction name direction) (hash name (hash "direction" direction)))
(define (bar-tab-groups? mi) (not (equal? (bar-get mi "tab_groups" 'json-null) #f)))
(define group-actions '("NewTabGroup" "NewNamedTabGroup" "SwitchTabGroup" "GoToTabGroupName"
    "GoToPreviousTabGroup" "GoToNextTabGroup" "RenameTabGroup" "RenameCurrentTabGroup"
    "CloseTabGroup" "CloseCurrentTabGroup" "MovePaneToPreviousTabGroup" "MovePaneToNextTabGroup"))
(define (bar-mode-keymap mi . modes)
  (define mode (if (null? modes) (hash-ref mi "mode") (car modes)))
  (let loop ((maps (hash-ref mi "keybinds")))
    (cond ((null? maps) '()) ((equal? mode (caar maps))
        (if (bar-tab-groups? mi) (cadr (car maps))
          (filter (lambda (entry) (not (foldl (lambda (action found) (or found (member (bar-tag action) group-actions))) #f (cadr entry)))) (cadr (car maps))))) (else (loop (cdr maps))))))
(define (actions-match? actual expected)
  (and (= (length actual) (length expected))
    (or (null? actual) (and (bar-shallow-equal? (car actual) (car expected))
        (actions-match? (cdr actual) (cdr expected))))))
(define (bar-action-keys keymap actions)
  (map car (filter (lambda (entry) (actions-match? (cadr entry) actions)) keymap)))
(define (bar-action-group keymap groups)
  (apply append (map (lambda (actions) (bar-action-keys keymap actions)) groups)))
(define (bar-common-modifiers keys)
  (if (null? keys) '()
    (filter (lambda (modifier)
        (foldl (lambda (key matches) (and matches (member modifier (hash-ref key "key_modifiers")))) #t keys)) bar-modifiers)))
(define (bar-strip-modifiers key common)
  (hash-insert key "key_modifiers" (filter (lambda (m) (not (member m common))) (hash-ref key "key_modifiers"))))
(define (bar-bare-label bare)
  (if (hash? bare)
    (if (hash-contains? bare "Char")
      (if (equal? (hash-ref bare "Char") " ") "SPACE" (hash-ref bare "Char"))
      (string-append "F" (number->string (hash-ref bare "F"))))
    (bar-get (hash "PageDown" "PgDn" "PageUp" "PgUp" "Left" "←" "Down" "↓" "Up" "↑" "Right" "→"
        "Delete" "DEL" "Insert" "INS" "CapsLock" "CAPSlOCK" "ScrollLock" "SCROLLlOCK") bare (string-upcase bare))))
(define (bar-key-label key)
  (string-join (append (filter (lambda (m) (member m (hash-ref key "key_modifiers"))) bar-modifiers)
      (list (bar-bare-label (hash-ref key "bare_key")))) " "))
(define (bar-to-char keys)
  (define preferred (filter (lambda (key) (not (bar-generic-key? key))) keys))
  (if (null? preferred) (if (null? keys) #f (car keys)) (car preferred)))
(define (bar-generic-key? key)
  (if (member (bar-bare-label (hash-ref key "bare_key")) '("ENTER" "ESC" "SPACE")) #t #f))
(define (key-value key)
  (define bare (hash-ref key "bare_key"))
  (cond ((string? bare) 0) ((hash-contains? bare "F") (hash-ref bare "F"))
    (else (char->integer (car (string->list (hash-ref bare "Char")))))))
(define (bar-compare-keys a b)
  (define rank (- (bar-index (bar-tag (hash-ref a "bare_key")) bare-order)
      (bar-index (bar-tag (hash-ref b "bare_key")) bare-order)))
  (define difference (if (= rank 0) (- (key-value a) (key-value b)) rank))
  (if (not (= difference 0)) difference
    (let loop ((am (filter (lambda (m) (member m (hash-ref a "key_modifiers"))) bar-modifiers))
        (bm (filter (lambda (m) (member m (hash-ref b "key_modifiers"))) bar-modifiers)))
      (cond ((or (null? am) (null? bm)) (- (length am) (length bm)))
        ((equal? (car am) (car bm)) (loop (cdr am) (cdr bm)))
        (else (- (bar-index (car am) bar-modifiers) (bar-index (car bm) bar-modifiers)))))))
(define (bar-own-key keys)
  (if (null? keys) '()
    (list (car (sort keys (lambda (a b)
            (define difference (- (length (hash-ref a "key_modifiers")) (length (hash-ref b "key_modifiers"))))
            (< (if (= difference 0) (bar-compare-keys a b) difference) 0)))))))
(define (bar-plugin-keys keymap alias)
  (bar-own-key (map car (filter (lambda (entry)
          (foldl (lambda (action found)
              (or found (and (hash? action)
                  (let ((launch (bar-get action "LaunchPlugin" (bar-get action "LaunchOrFocusPlugin" #f))))
                    (and launch
                      (let ((plugin (hash-ref launch "plugin")))
                        (if (hash-contains? plugin "Alias") (equal? (hash-ref (hash-ref plugin "Alias") "name") alias)
                          (let ((location (hash-ref (hash-ref plugin "RunPlugin") "location")))
                            (and (not (hash-contains? location "Git"))
                              (equal? (if (hash-contains? location "Yinz")
                                  (string-append "yinz:" (hash-ref location "Yinz"))
                                  (string-append "file:" (hash-ref location "File"))) alias)))))))))) #f (cadr entry))) keymap))))
(define (bar-pipe-keys keymap name)
  (bar-own-key (map car (filter (lambda (entry)
          (foldl (lambda (action found)
              (or found (and (hash? action) (hash-contains? action "KeybindPipe")
                  (let ((actual (hash-ref (hash-ref action "KeybindPipe") "name")))
                    (or (json-null? actual) (equal? name actual)))))) #f (cadr entry))) keymap))))
(define (bar-key-separator labels . inline)
  (if (member (string-join labels "")
      (append '("HJKL" "hjkl" "←↓↑→" "←→" "↓↑" "[]") (if (and (not (null? inline)) (car inline)) '("+-") '()))) "" "|"))
