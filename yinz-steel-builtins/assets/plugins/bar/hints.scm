(require "./keys.scm" "./style.scm")
(provide bar-hints-for-mode bar-render-hints)

(define (hint long short keys) (list long short keys))
(define (search-input byte) (hash "SearchInput" (hash "input" (list byte))))
(define (bar-hints-for-mode mi)
  (define original (bar-mode-keymap mi))
  (define base (hash-ref mi "base_mode"))
  (define exits (bar-action-keys original (list (bar-switch-mode (if (json-null? base) "Normal" base)))))
  (define (back preferred)
    (define key (bar-key preferred '()))
    (if (foldl (lambda (exit found) (or found (bar-equal? exit key))) #f exits)
      (list key) (take exits (min 1 (length exits)))))
  (define to-base (back "Enter"))
  (define escape (back "Esc"))
  (define (starts-action? entry action)
    (and (not (null? (cadr entry))) (bar-shallow-equal? (car (cadr entry)) action)))
  (define copy (bar-own-key (map car (filter (lambda (entry) (starts-action? entry "Copy")) original))))
  (define (preferring action preferred)
    (define keys (map car (filter (lambda (entry) (starts-action? entry action)) original)))
    (define key (bar-key preferred '()))
    (if (foldl (lambda (candidate found) (or found (bar-equal? candidate key))) #f keys)
      (list key) (bar-own-key keys)))
  (define known '())
  (define km (filter (lambda (entry)
        (if (foldl (lambda (actions found) (or found (bar-equal? actions (cadr entry)))) #f known) #f
          (begin (set! known (cons (cadr entry) known)) #t)))
      (sort original (lambda (a b) (< (bar-compare-keys (car a) (car b)) 0)))))
  (define (doing action) (bar-own-key (map car (filter (lambda (entry) (starts-action? entry action)) km))))
  (define (each actions) (apply append (map doing actions)))
  (define (exact . actions) (bar-action-keys km actions))
  (define (group . actions) (bar-action-group km (map list actions)))
  (define (plugin alias) (bar-plugin-keys km alias))
  (define focus (map (lambda (d) (bar-direction "MoveFocus" d)) '("Left" "Down" "Up" "Right")))
  (define select (hint "Select pane" "Select" to-base))
  (define mode (hash-ref mi "mode"))
  (cond
    ((equal? mode "Pane")
      (list (hint "New" "New" (doing (bar-new-pane 'json-null)))
        (hint "Change Focus" "Move" (each focus))
        (hint "Close" "Close" (doing "CloseFocus"))
        (hint "Rename" "Rename" (doing (bar-switch-mode "RenamePane")))
        (hint "Toggle Fullscreen" "Fullscreen" (doing "ToggleFocusFullscreen"))
        (hint "Toggle Floating" "Floating" (doing "ToggleFloatingPanes"))
        (hint "Toggle Embed" "Embed" (doing "TogglePaneEmbedOrFloating"))
        (hint "Split Right" "Right" (doing (bar-new-pane "Right")))
        (hint "Split Down" "Down" (doing (bar-new-pane "Down")))
        (hint "Stack" "Stack" (doing (hash "NewStackedPane" (hash "command" 'json-null "pane_name" 'json-null "near_current_pane" #f "no_focus" #f "tab_id" 'json-null))))
        (hint "Select text" "Text" (doing (bar-switch-mode "Select"))) select))
    ((equal? mode "Tab")
      (list (hint "New" "New" (doing (hash "NewTab" (hash))))
        (hint "Change focus" "Move" (append (preferring "GoToPreviousTab" "Left") (preferring "GoToNextTab" "Right")))
        (hint "Close" "Close" (doing "CloseTab"))
        (hint "Rename" "Rename" (doing (bar-switch-mode "RenameTab")))
        (hint "Sync" "Sync" (doing "ToggleActiveSyncTab"))
        (hint "Break pane to new tab" "Break out" (doing "BreakPane"))
        (hint "Break pane left/right" "Break" (each '("BreakPaneLeft" "BreakPaneRight")))
        (hint "Toggle" "Toggle" (doing "ToggleTab")) select))
    ((equal? mode "Resize")
      (list (hint "Increase/Decrease size" "Increase/Decrease" (group (bar-resize "Increase" 'json-null) (bar-resize "Decrease" 'json-null)))
        (hint "Increase to" "Increase" (apply group (map (lambda (d) (bar-resize "Increase" d)) '("Left" "Down" "Up" "Right"))))
        (hint "Decrease from" "Decrease" (apply group (map (lambda (d) (bar-resize "Decrease" d)) '("Left" "Down" "Up" "Right")))) select))
    ((equal? mode "Move")
      (list (hint "Switch Location" "Move" (apply group (map (lambda (d) (bar-direction "MovePane" d)) '("Left" "Down" "Up" "Right"))))
        (hint "When done" "Back" to-base)))
    ((equal? mode "Scroll")
      (list (hint "Enter search term" "Search" (exact (bar-switch-mode "EnterSearch") (search-input 0)))
        (hint "Scroll" "Scroll" (group "ScrollDown" "ScrollUp" "PageScrollDown" "PageScrollUp" "HalfPageScrollDown" "HalfPageScrollUp"))
        (hint "Edit scrollback in default editor" "Edit" (doing (hash "EditScrollback" (hash "ansi" #f)))) select
        (hint "Scroll commands" "Commands" (group "ScrollToPreviousPrompt" "ScrollToNextPrompt"))))
    ((equal? mode "Select")
      (list (hint "Move selection" "Move" (apply group (map (lambda (d) (bar-direction "MoveTextSelection" d)) '("Left" "Down" "Up" "Right"))))
        (hint "Swap ends" "Swap" (doing "SwapTextSelectionEnds"))
        (hint "Copy and exit" "Copy" (if (null? copy) to-base copy))))
    ((equal? mode "EnterSearch")
      (list (hint "When done" "Done" (exact (bar-switch-mode "Search")))
        (hint "Cancel" "Cancel" (exact (search-input 27) (bar-switch-mode "Scroll")))))
    ((equal? mode "Search")
      (list (hint "Enter Search term" "Search" (exact (bar-switch-mode "EnterSearch") (search-input 0)))
        (hint "Scroll" "Scroll" (group "ScrollDown" "ScrollUp"))
        (hint "Scroll page" "Scroll" (group "PageScrollDown" "PageScrollUp"))
        (hint "Scroll half page" "Scroll" (group "HalfPageScrollDown" "HalfPageScrollUp"))
        (hint "Search down" "Down" (exact (bar-direction "Search" "Down")))
        (hint "Search up" "Up" (exact (bar-direction "Search" "Up")))
        (hint "Case sensitive" "Case" (exact (hash "SearchToggleOption" (hash "option" "CaseSensitivity"))))
        (hint "Wrap" "Wrap" (exact (hash "SearchToggleOption" (hash "option" "Wrap"))))
        (hint "Whole words" "Whole" (exact (hash "SearchToggleOption" (hash "option" "WholeWord"))))))
    ((equal? mode "Session")
      (list (hint "Detach" "Detach" (exact "Detach"))
        (hint "Session Manager" "Manager" (plugin "session-manager"))
        (hint "Configure" "Config" (plugin "configuration"))
        (hint "Layout Manager" "Layouts" (plugin "yinz:layout-manager"))
        (hint "Plugin Manager" "Plugins" (plugin "plugin-manager"))
        (hint "Notifications" "Notif" (exact (bar-switch-mode "Notifications"))) select))
    ((equal? mode "Notifications")
      (list (hint "Select" "Select" (group (bar-direction "MoveNotificationSelection" "Down") (bar-direction "MoveNotificationSelection" "Up")))
        (hint "Open" "Open" (doing "ActivateNotification"))
        (hint "Full text" "Full" (doing "ToggleNotificationDetail"))
        (hint "Exit" "Exit" escape)))
    ((equal? mode "Agent")
      (list (hint "New agent" "New" (plugin "new-agent"))
        (hint "Duplicate agent" "Duplicate" (plugin "duplicate-agent"))
        (hint "Fork agent" "Fork" (plugin "fork-agent"))
        (hint "Agents" "Agents" (plugin "agents"))
        (hint "Move panel" "Move" (bar-pipe-keys km "agent_strip_reposition")) select))
    ((equal? mode "Tmux")
      (list (hint "Move focus" "Move" (each focus))
        (hint "Split down" "Down" (doing (bar-new-pane "Down")))
        (hint "Split right" "Right" (doing (bar-new-pane "Right")))
        (hint "Fullscreen" "Fullscreen" (doing "ToggleFocusFullscreen"))
        (hint "New tab" "New" (doing (hash "NewTab" (hash))))
        (hint "Rename tab" "Rename" (doing (bar-switch-mode "RenameTab")))
        (hint "Previous Tab" "Previous" (doing "GoToPreviousTab"))
        (hint "Next Tab" "Next" (doing "GoToNextTab")) select))
    ((member mode '("RenamePane" "RenameTab"))
      (list (hint "When done" "Done" to-base) (hint "Select pane" "Select" (each focus))))
    ((member mode '("Normal" "Locked" "Prompt")) '())
    (else (error (string-append "Unknown input mode: " mode)))))

(define (bar-render-hints mi maximum renderer)
  (define hints (bar-hints-for-mode mi))
  (define (complete index)
    (foldl (lambda (hint result)
        (bar-concat result (renderer (= (hash-ref result "len") 0) (list-ref hint index) (caddr hint))))
      (bar-line "" 0) hints))
  (define long (complete 0))
  (if (<= (hash-ref long "len") maximum) long
    (let ((short (complete 1)))
      (if (<= (hash-ref short "len") maximum) short
        (let loop ((remaining hints) (result (bar-line "" 0)))
          (if (null? remaining) result
            (let ((next (renderer (= (hash-ref result "len") 0) (cadr (car remaining)) (caddr (car remaining)))))
              (if (> (+ (hash-ref result "len") (hash-ref next "len") 5) maximum)
                (if (<= (+ (hash-ref result "len") 5) maximum) (bar-concat result (bar-line " ... " 5)) result)
                (loop (cdr remaining) (bar-concat result next))))))))))
