(require "./keys.scm" "./style.scm" "./hints.scm" "./tips.scm")
(provide bar-status-render)

(define labels (hash "Lock" '("LOCK" "Lo") "Unlock" '("UNLOCK" "Un") "Pane" '("PANE" "Pa")
    "Tab" '("TAB" "Ta") "Resize" '("SIZE" "Re") "Search" '("SEARCH" "Se") "Quit" '("QUIT" "Qu")
    "Session" '("SESS" "Se") "Move" '("MOVE" "Mo") "Tmux" '("TMUX" "Tm") "Agent" '("AGENT" "Ag") "Notifications" '("NOTIFY" "No")))
(define mode-tiles '(("Locked" "Lock") ("Agent" "Agent") ("Pane" "Pane") ("Tab" "Tab") ("Resize" "Resize")
    ("Move" "Move") ("Scroll" "Search") ("Session" "Session") ("Quit" "Quit")))
(define selected-action (hash "Locked" "Lock" "Pane" "Pane" "RenamePane" "Pane" "Select" "Pane" "Tab" "Tab"
    "RenameTab" "Tab" "Resize" "Resize" "Move" "Move" "Scroll" "Search" "Search" "Search" "EnterSearch" "Search" "Session" "Session" "Agent" "Agent"))
(define (colors mi) (hash-ref (hash-ref mi "style") "colors"))
(define (enabled? object key) (equal? (bar-get object key #f) #t))
(define (line text) (bar-line text (string-length (yinz-text-sanitize text))))
(define (empty) (bar-line "" 0))
(define (no-ranges line) (hash "line" line "newPane" #f "floating" #f))
(define (shift range n) (and range (list (+ (car range) n) (+ (cadr range) n))))
(define (bound mi mode target)
  (bar-to-char (bar-action-keys (bar-mode-keymap mi mode) (list (if (equal? target "Quit") "Quit" (bar-switch-mode target))))))
(define (tile mode action key) (hash "mode" mode "action" action "key" key))
(define (classic-tile mi tile common first form)
  (define key (hash-ref tile "key"))
  (define mode (hash-ref tile "mode"))
  (if (and (not key) (not (equal? mode "disabled"))) (empty)
    (let* ((label (if key (if (= form 1) (bar-abbreviated-key key common) (bar-key-label (bar-strip-modifiers key common))) ""))
        (name (car (hash-ref labels (hash-ref tile "action")))) (c (bar-tile-colors mi mode #f)))
      (define (paint kind text) ((hash-ref c kind) text))
      (line (string-append (paint "prefix" (if (and (null? common) first) "" (bar-arrow mi)))
          (if (= form 2) (paint "key" (string-append " " label " "))
            (string-append (paint "bracket" " <") (paint "key" label) (paint "bracket" "> ") (paint "text" (string-append name " "))))
          (paint "suffix" (bar-arrow mi)))))))
(define (first-line mi tab max-cols)
  (define maximum (min max-cols 10000))
  (define mode (hash-ref mi "mode"))
  (define index -1)
  (define tiles (map (lambda (entry)
        (set! index (+ index 1))
        (define selected (equal? (cadr entry) (bar-get selected-action mode #f)))
        (tile (if selected "selected" (if (and (equal? mode "Locked") (> index 0)) "disabled" (if (= (modulo index 2) 1) "alternate" "unselected")))
          (cadr entry) (bound mi mode (if selected "Normal" (car entry))))) mode-tiles))
  (when (member mode '("Tmux" "Notifications"))
    (set! tiles (append tiles (list (tile "selected" mode (bound mi mode "Normal"))))))
  (define switch-keys (map car (filter (lambda (entry)
          (and (not (bar-generic-key? (car entry))) (not (null? (cadr entry)))
            (let ((action (car (cadr entry))))
              (or (equal? action "Quit")
                (and (hash? action) (hash-contains? action "SwitchToMode")
                  (member (hash-ref (hash-ref action "SwitchToMode") "input_mode")
                    '("Normal" "Locked" "Pane" "Tab" "Resize" "Move" "Scroll" "Session" "Agent"))))))) (bar-mode-keymap mi))))
  (define common (bar-common-modifiers switch-keys))
  (define prefix (if (null? common) (empty)
      (line (string-append (bar-prefix-paint mi (bar-modifier-prefix mi common) #f) (bar-prefix-suffix mi)))))
  (define result (let loop ((form 0))
      (if (= form 3) (empty)
        (let ((candidate (foldl (lambda (tile result)
                  (bar-concat result (classic-tile mi tile common (= (hash-ref result "len") 0) form))) prefix tiles)))
          (if (< (hash-ref candidate "len") maximum) candidate (loop (+ form 1)))))))
  (when (and (< (hash-ref result "len") maximum) tab (bar-present? (hash-ref tab "active_swap_layout_name")))
    (define name (string-append " " (list->string (map (lambda (c)
              (if (and (>= (char->integer c) 97) (<= (char->integer c) 122)) (integer->char (- (char->integer c) 32)) c))
            (string->list (hash-ref tab "active_swap_layout_name")))) " "))
    (define c (bar-tile-colors mi (if (equal? mode "Locked") "disabled" (if (hash-ref tab "is_swap_layout_dirty") "unselected" "selected")) #f))
    (define indicator (line (string-append ((hash-ref c "prefix") (bar-arrow mi)) ((hash-ref c "text") name) ((hash-ref c "suffix") (bar-arrow mi)))))
    (define keys (bar-byte-line (bar-classic-keys (bar-action-group (bar-mode-keymap mi) '(("PreviousSwapLayout") ("NextSwapLayout")))
          (colors mi) (hash-ref (hash-ref (colors mi) "text_unselected") "background"))))
    (define space (line (bar-prefix-paint mi " " #f)))
    (define full (if (equal? mode "Locked") indicator (bar-concat keys space indicator space)))
    (define available (- maximum (hash-ref result "len")))
    (define fitted (cond ((<= (hash-ref full "len") available) full)
        ((and (not (equal? mode "Locked")) (<= (hash-ref indicator "len") available)) indicator) (else #f)))
    (when fitted (set! result (bar-concat result (line (bar-prefix-paint mi (make-string (- available (hash-ref fitted "len")) #\space) #f)) fitted))))
  result)
(define (mode-indicators mi maximum)
  (define locked (equal? (hash-ref mi "base_mode") "Locked"))
  (define all (hash
      "Locked" (list (tile (if locked "unselected" "selected") (if locked "Unlock" "Lock") (bound mi "Locked" "Normal")))
      "Normal" (map (lambda (entry)
          (tile (cond ((and (equal? (car entry) "Locked") locked) "selected")
              ((member (car entry) '("Agent" "Pane" "Resize" "Scroll")) "alternate") (else "unselected"))
            (if (and (equal? (car entry) "Locked") locked) "Unlock" (cadr entry)) (bound mi "Normal" (car entry)))) mode-tiles)))
  (for-each (lambda (entry)
      (define mode (car entry))
      (set! all (hash-insert all mode (append
            (if (or locked (equal? mode "Notifications")) (list (tile "selected" "Unlock" (bound mi mode "Locked"))) '())
            (list (tile "selected" (cadr entry) (bound mi mode "Normal")))))))
    '(("Agent" "Agent") ("Pane" "Pane") ("Notifications" "Notifications") ("Select" "Pane") ("Tab" "Tab")
      ("Resize" "Resize") ("Move" "Move") ("Scroll" "Search") ("Session" "Session")))
  (define common (bar-common-modifiers (filter (lambda (key) (and key (not (bar-generic-key? key))))
        (apply append (map (lambda (mode) (map (lambda (tile) (hash-ref tile "key")) (hash-ref all mode))) (hash-keys->list all))))))
  (define tiles (bar-get all (hash-ref mi "mode") #f))
  (define result (empty))
  (when tiles
    (unless (null? common)
      (set! result (bar-concat (bar-text-part (bar-modifier-prefix mi common) #f (enabled? mi "session_dimmed")) (line (bar-prefix-suffix mi)))))
    (define candidate (let loop ((forms '(#f #t)))
        (if (null? forms) #f
          (let ((candidate (apply bar-concat (map (lambda (t)
                      (define key (hash-ref t "key"))
                      (bar-shortcut mi (list-ref (hash-ref labels (hash-ref t "action")) (if (car forms) 1 0))
                        (if key (list (if (null? common) key (bar-strip-modifiers key common))) '())
                        (equal? (hash-ref t "mode") "selected") 3 (not (null? common)) #f (and (not (null? common)) (car forms)))) tiles))))
            (if (<= (+ (hash-ref result "len") (hash-ref candidate "len")) maximum) candidate (loop (cdr forms)))))))
    (when candidate (set! result (bar-concat result candidate))))
  (and (<= (hash-ref result "len") maximum) result))
(define (group-separator mi maximum)
  (define name (bar-get (hash "RenamePane" "RENAMING PANE" "RenameTab" "RENAMING TAB" "EnterSearch" "ENTERING SEARCH TERM" "Search" "SEARCHING") (hash-ref mi "mode") #f))
  (define p (colors mi))
  (define sep (if (equal? (bar-arrow mi) "") " " (bar-arrow mi)))
  (define c (hash-ref (hash-ref p "text_unselected") "emphasis_0"))
  (define bg (hash-ref (hash-ref p "ribbon_selected") "base"))
  (define result (line (string-append (if name (bar-paint (string-append " " name " ") c bg "1") "")
        (bar-paint sep bg c "1") (bar-paint " " c c "1") (bar-paint sep c bg "1"))))
  (and (<= (hash-ref result "len") maximum) result))
(define (choose keys predicate . fallback)
  (define matches (filter predicate keys))
  (define chosen (if (null? matches) (if (null? fallback) (if (null? keys) #f (car keys)) (car fallback)) (car matches)))
  (if chosen (list chosen) '()))
(define (secondary-hints mi tab maximum state)
  (define km (bar-mode-keymap mi))
  (define pane (choose (bar-action-keys km (list (bar-new-pane 'json-null))) (lambda (key) (bar-equal? key (bar-char-key "n" '("Alt"))))))
  (define increase (bar-action-keys km (list (bar-resize "Increase" 'json-null))))
  (define sizes (append (choose increase (lambda (key) (equal? (hash-ref key "bare_key") (hash "Char" "+"))))
      (choose (bar-action-keys km (list (bar-resize "Decrease" 'json-null))) (lambda (key) (equal? (hash-ref key "bare_key") (hash "Char" "-")))
        (if (null? increase) #f (car increase)))))
  (define focus (apply append (map (lambda (direction)
          (choose (bar-action-keys km (list (bar-direction (if (member direction '("Left" "Right")) "MoveFocusOrTab" "MoveFocus") direction)))
            (lambda (key) (equal? (hash-ref key "bare_key") direction)))) '("Left" "Down" "Up" "Right"))))
  (define group-ids (foldl (lambda (tab ids)
        (define group (bar-get tab "group" #f))
        (define id (if (hash? group) (hash-ref group "id") 0))
        (if (member id ids) ids (cons id ids))) '() (hash-ref state "tabs")))
  (define groups (if (and (not (null? focus)) (> (length group-ids) 1))
      (apply append (map (lambda (action) (bar-own-key (bar-action-keys km (list action))))
          '("GoToPreviousTabGroup" "GoToNextTabGroup"))) '()))
  (define floating (choose (bar-action-keys km '("ToggleFloatingPanes")) (lambda (key) (bar-equal? key (bar-char-key "f" '("Alt"))))))
  (define common (bar-common-modifiers (append pane focus sizes groups floating)))
  (define multi (and tab (> (hash-ref tab (if (hash-ref tab "are_floating_panes_visible") "selectable_floating_panes_count" "selectable_tiled_panes_count")) 1)))
  (let loop ((forms '(#f #t)))
    (if (null? forms) #f
      (let ((short (car forms)))
        (define result (if (null? common) (empty) (bar-text-part (string-append (string-join common "-") " + ") 0 (enabled? mi "session_dimmed"))))
        (define (add label keys selected hovered)
          (define start (hash-ref result "len"))
          (set! result (bar-concat result (bar-shortcut mi label (if (null? common) keys (map (lambda (key) (bar-strip-modifiers key common)) keys))
                selected 0 (not (null? common)) hovered #f)))
          (and (> (hash-ref result "len") start) (list start (hash-ref result "len"))))
        (define pane-range (add (if short "New" "New Pane") pane #f (hash-ref state "newPaneHovered")))
        (when multi (add (if short "Focus" "Change Focus") focus #f #f) (add "Resize" sizes #f #f))
        (add (if short "Groups" "Switch group") groups #f #f)
        (define floating-range (add "Floating" floating (and tab (hash-ref tab "are_floating_panes_visible")) (hash-ref state "floatingHovered")))
        (if (<= (hash-ref result "len") maximum)
          (and (> (hash-ref result "len") 0) (hash "line" result "newPane" pane-range "floating" floating-range))
          (loop (cdr forms)))))))
(define (status-block mi counts clock maximum)
  (define simple (hash-ref (hash-ref mi "capabilities") "arrow_fonts"))
  (define p (colors mi))
  (define palette (hash-ref p "text_unselected"))
  (define foregrounds (hash "dim" (hash-ref palette "base") "busy" (hash-ref palette "emphasis_2")
      "clock" (hash-ref palette "emphasis_1") "alert" (hash-ref (hash-ref p "exit_code_error") "base")))
  (define (mark glyph count) (if simple (string-append (number->string count) glyph) (string-append glyph (number->string count))))
  (let loop ((forms '((#t #t) (#t #f) (#f #f))))
    (if (null? forms) (empty)
      (let ((form (car forms)))
        (define segments '())
        (define (add text style)
          (unless (null? segments) (set! segments (append segments '((" " "dim")))))
          (set! segments (append segments (list (list text style)))))
        (when (> (hash-ref counts "waiting") 0)
          (add (mark (if simple "w" "◆") (hash-ref counts "waiting")) "alert"))
        (when (> (hash-ref counts "busy") 0)
          (add (mark (if simple "b" "●") (hash-ref counts "busy")) "busy"))
        (when (> (hash-ref counts "idle") 0) (add (mark (if simple "i" "·") (hash-ref counts "idle")) "dim"))
        (when (car form)
          (unless (null? segments) (set! segments (append segments '(("   " "dim")))))
          (set! segments (append segments (list (list (hash-ref clock "time") "clock"))))
          (when (cadr form) (set! segments (append segments (list '("  " "dim") (list (hash-ref clock "date") "dim"))))))
        (define len (foldl (lambda (segment n) (+ n (yinz-text-width (car segment)))) 0 segments))
        (if (<= len maximum)
          (bar-line (string-append (string (integer->char 27)) "[0m"
              (apply string-append (map (lambda (segment)
                    (bar-paint (car segment) (if (enabled? mi "session_dimmed") (hash-ref palette "base") (hash-ref foregrounds (cadr segment)))
                      (hash-ref palette "background") (if (enabled? mi "session_dimmed") "3" (if (equal? (cadr segment) "dim") "2" "1")))) segments))) len)
          (loop (cdr forms)))))))
(define (message state maximum)
  (define mi (hash-ref state "modeInfo"))
  (define p (colors mi))
  (cond
    ((bar-dimmed? mi)
      (define kk (hash-ref mi (if (enabled? mi "session_dimmed") "nested_ascend_keys" "nested_descend_keys")))
      (define keys (if (null? kk) (bar-paint "<unbound>" #f #f "2;3")
          (string-join (map (lambda (key) (bar-classic-keys (list key) p #f)) kk) (bar-paint " + " (hash-ref (hash-ref p "text_unselected") "base") #f ""))))
      (define full (line (string-append (bar-paint (if (enabled? mi "session_dimmed") " Ascend: " " Descend: ") #f #f "2;3") keys)))
      (cond ((<= (hash-ref full "len") maximum) full) ((<= (hash-ref (line keys) "len") maximum) (line keys)) (else (empty))))
    ((hash-ref state "copied")
      (bar-text-part (cond ((equal? (hash-ref state "copied") "Command") "Text piped to external command")
          ((equal? (hash-ref state "copied") "Primary") "Text copied to system primary selection")
          (else "Text copied to system clipboard")) 2 #f))
    ((hash-ref state "clipboardFailure")
      (line (bar-paint " Error using the system clipboard." (hash-ref (hash-ref p "text_unselected") "emphasis_3") #f "1")))
    (else #f)))
(define (second-line state tab maximum)
  (define mi (hash-ref state "modeInfo"))
  (define c (hash-ref (colors mi) "text_unselected"))
  (define notification (message state maximum))
  (define mode (hash-ref mi "mode"))
  (define (base text) (bar-paint text (hash-ref c "base") #f "1"))
  (define (orange text) (bar-paint text (hash-ref c "emphasis_0") #f "1"))
  (define (green text) (bar-paint text (hash-ref c "emphasis_2") #f "1"))
  (define locked (if (equal? mode "Locked") (base " -- INTERFACE LOCKED -- ") ""))
  (cond
    (notification notification)
    ((not tab) (empty))
    ((member mode '("Locked" "Normal"))
      (cond
        ((hash-ref tab "is_fullscreen_active")
          (line (string-append locked (base " (") (orange "FULLSCREEN") (base "): + ") (green (number->string (hash-ref tab "panes_to_hide"))) (base " hidden panes"))))
        ((hash-ref tab "are_floating_panes_visible")
          (define prefix (string-append locked (base " (") (orange "FLOATING PANES VISIBLE")))
          (if (equal? mode "Locked") (line (string-append prefix (base ")")))
            (let* ((pane-keys (bar-action-keys (bar-mode-keymap mi) (list (bar-switch-mode "Pane"))))
                (toggle-keys (bar-action-keys (bar-mode-keymap mi "Pane") (list "ToggleFloatingPanes" (bar-switch-mode "Normal"))))
                (pane-key (if (null? pane-keys) (bar-char-key "?" '()) (car pane-keys)))
                (toggle (if (null? toggle-keys) (bar-char-key "?" '()) (car toggle-keys))))
              (line (string-append prefix (base "): Press ") (green (bar-key-label pane-key)) (base ", <") (green (bar-key-label toggle)) (base "> to hide."))))))
        ((equal? mode "Normal") (bar-tip mi (hash-ref state "tipName") maximum))
        (else (if (<= (string-length " -- INTERFACE LOCKED -- ") maximum) (line locked) (empty)))))
    (else (bar-render-hints mi maximum #t (lambda (first label keys)
          (if (null? keys) (empty)
            (line (string-append (bar-paint (if first " " " / ") (hash-ref c "base") #f "")
                (bar-classic-keys keys (colors mi) #f) (base (string-append " " label))))))))))
(define (bar-status-render state rows cols)
  (define mi (hash-ref state "modeInfo"))
  (define active (filter (lambda (tab) (hash-ref tab "active")) (hash-ref state "tabs")))
  (define tab (if (null? active) #f (car active)))
  (define mode (hash-ref mi "mode"))
  (if (or (not (= rows 1)) (hash-ref state "classic"))
    (let ((first (first-line mi tab cols)) (second (second-line state tab cols)) (esc (string (integer->char 27))))
      (no-ranges (line (cond ((> rows 1) (string-append (hash-ref first "part") (bar-fill mi) "\n" esc "[m" (hash-ref second "part") esc "[0K"))
            ((or (bar-dimmed? mi) (not (equal? mode "Normal"))) (string-append esc "[m" (hash-ref second "part") esc "[0K"))
            (else (string-append (hash-ref first "part") (bar-fill mi)))))))
    (let ((notification (message state cols)))
      (if notification (no-ranges (line (string-append (hash-ref notification "part") (bar-fill mi))))
        (let ((left (mode-indicators mi cols)) (result (no-ranges (empty))))
          (when left
            (set! result (hash-insert result "line" left))
            (define remaining (max 0 (- cols (hash-ref left "len"))))
            (if (member mode '("Normal" "Locked"))
              (let* ((secondary (or (and (hash-ref state "hintRevealed") (secondary-hints mi tab remaining state))
                      (no-ranges (status-block mi (hash-ref state "counts") (hash-ref state "clock") remaining))))
                  (padding (max 0 (- remaining (hash-ref (hash-ref secondary "line") "len") 1))))
                (set! result (hash "line" (bar-concat left (line (bar-prefix-paint mi (make-string padding #\space) (enabled? mi "session_dimmed"))) (hash-ref secondary "line"))
                    "newPane" (shift (hash-ref secondary "newPane") (+ (hash-ref left "len") padding))
                    "floating" (shift (hash-ref secondary "floating") (+ (hash-ref left "len") padding)))))
              (let ((separator (group-separator mi remaining)))
                (when separator
                  (set! result (hash-insert result "line" (bar-concat left separator
                        (bar-render-hints mi (- remaining (hash-ref separator "len")) #f
                          (lambda (first label keys) (bar-shortcut mi label keys #f 2 #f #f #f))))))))))
          (hash-insert result "line" (hash-insert (hash-ref result "line") "part"
              (string-append (hash-ref (hash-ref result "line") "part") (bar-fill mi)))))))))
