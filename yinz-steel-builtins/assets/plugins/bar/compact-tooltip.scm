(require "./keys.scm")
(provide compact-dimensions compact-tooltip compact-actions compact-grouped-keys)
(define directions '("Left" "Down" "Up" "Right"))
(define (matches pattern)
  (lambda (action)
    (if (string? pattern) (equal? (bar-tag action) pattern)
      (and (hash? action) (equal? (bar-tag action) (bar-tag pattern))
        (let ((target (hash-ref pattern (bar-tag pattern))) (value (hash-ref action (bar-tag action))))
          (and (hash? target) (hash? value)
            (foldl (lambda (key same) (and same (hash-contains? value key)
                  (bar-equal? (hash-ref value key) (hash-ref target key)))) #t (hash-keys->list target))))))))
(define (launches alias)
  (lambda (action) (not (null? (bar-plugin-keys (list (list (bar-key "Enter" '()) (list action))) alias)))))
(define (switches modes) (map (lambda (mode) (matches (bar-switch-mode mode))) modes))
(define (named names) (map matches names))
;; The legacy tooltip groups by the action fields retained at its wire boundary.
(define (new-pane direction) (hash "NewPane" (hash "direction" direction "pane_name" 'json-null)))
(define (directed name) (map (lambda (direction) (matches (bar-direction name direction))) directions))
(define (predicates mode)
  (cond
    ((equal? mode "Locked") (switches '("Normal")))
    ((equal? mode "Normal") (append (switches '("Locked" "Pane" "Tab" "Resize" "Move" "Scroll" "Session" "Agent")) (named '("Quit"))))
    ((equal? mode "Pane") (append (list (matches (new-pane 'json-null))) (directed "MoveFocus")
        (named '("CloseFocus")) (switches '("RenamePane"))
        (named '("ToggleFocusFullscreen" "ToggleFloatingPanes" "TogglePaneEmbedOrFloating" "NewStackedPane"))
        (map (lambda (direction) (matches (new-pane direction))) '("Right" "Down"))))
    ((equal? mode "Tab") (append (named '("GoToPreviousTab" "GoToNextTab"))
        (list (matches (hash "NewTab" (hash "layout_source" 'json-null "tiled_layout" 'json-null
                "swap_tiled_layouts" 'json-null "swap_floating_layouts" 'json-null "tab_name" 'json-null
                "should_change_focus_to_new_tab" #t "cwd" 'json-null)))) (named '("CloseTab"))
        (switches '("RenameTab")) (named '("TabNameInput" "ToggleActiveSyncTab" "BreakPane" "BreakPaneLeft" "BreakPaneRight" "MovePaneToPreviousTabGroup" "MovePaneToNextTabGroup" "ToggleTab"))))
    ((equal? mode "Resize") (append (map (lambda (size) (matches (bar-resize size 'json-null))) '("Increase" "Decrease"))
        (apply append (map (lambda (size) (map (lambda (direction) (matches (bar-resize size direction))) directions)) '("Increase" "Decrease")))))
    ((equal? mode "Move") (directed "MovePane"))
    ((equal? mode "Scroll") (append (named '("ScrollDown" "ScrollUp" "HalfPageScrollDown" "HalfPageScrollUp" "PageScrollDown" "PageScrollUp"))
        (switches '("EnterSearch")) (named '("EditScrollback"))))
    ((equal? mode "Search") (append (switches '("EnterSearch"))
        (named '("SearchInput" "ScrollDown" "ScrollUp" "PageScrollDown" "PageScrollUp" "HalfPageScrollDown" "HalfPageScrollUp"))
        (map (lambda (direction) (matches (bar-direction "Search" direction))) '("Down" "Up"))
        (map (lambda (option) (matches (hash "SearchToggleOption" (hash "option" option)))) '("CaseSensitivity" "Wrap" "WholeWord"))))
    ((equal? mode "Select") (append (directed "MoveTextSelection") (named '("SwapTextSelectionEnds"))))
    ((equal? mode "Session") (append (named '("Detach" "CommandPalette")) (map launches '("session-manager" "plugin-manager" "configuration"))))
    ((equal? mode "Notifications") (append (map (lambda (direction) (matches (bar-direction "MoveNotificationSelection" direction))) '("Down" "Up"))
        (named '("ActivateNotification" "ToggleNotificationDetail"))))
    ((equal? mode "Agent") (map launches '("new-agent" "agents")))
    (else '())))
(define descriptions (hash "MoveFocus" "Move focus" "MovePaneWithDirection" "Move pane" "MovePaneWithoutDirection" "Move pane"
    "ResizeIncrease" "Increase size in direction" "ResizeDecrease" "Decrease size in direction" "ResizeAny" "Increase or decrease size"
    "Search" "Search" "NewPaneWithDirection" "Split right/down" "NewPaneWithoutDirection" "New pane"
    "MovePaneToTabGroup" "Move pane to adjacent group" "BreakPaneLeftOrRight" "Break pane to adjacent tab" "GoToAdjacentTab" "Move tab focus" "Scroll" "Scroll"
    "PageScroll" "Scroll page" "HalfPageScroll" "Scroll half Page" "SessionManager" "Session manager"
    "PluginManager" "Plugin manager" "Configuration" "Configuration" "CommandPalette" "Command palette" "TogglePaneEmbedOrFloating" "Float or embed"
    "NewStackedPane" "New stacked pane" "ToggleFocusFullscreen" "Toggle fullscreen" "ToggleFloatingPanes" "Show/hide floating panes"
    "CloseFocus" "Close pane" "CloseTab" "Close tab" "ToggleActiveSyncTab" "Sync panes in tab" "ToggleTab" "Circle tab focus"
    "BreakPane" "Break pane to new tab" "EditScrollback" "Open pane scrollback in editor" "NewTab" "New tab" "Detach" "Detach" "Quit" "Quit"))
(define grouped-types '(("MovePaneToTabGroup" "MovePaneToPreviousTabGroup" "MovePaneToNextTabGroup") ("BreakPaneLeftOrRight" "BreakPaneLeft" "BreakPaneRight") ("GoToAdjacentTab" "GoToPreviousTab" "GoToNextTab")
    ("Scroll" "ScrollUp" "ScrollDown") ("PageScroll" "PageScrollUp" "PageScrollDown") ("HalfPageScroll" "HalfPageScrollUp" "HalfPageScrollDown")))
(define (action-type action)
  (define name (bar-tag action))
  (define group (filter (lambda (entry) (member name (cdr entry))) grouped-types))
  (define launch (and (hash? action) (bar-get action "LaunchPlugin" (bar-get action "LaunchOrFocusPlugin" #f))))
  (define known-plugin (filter (lambda (entry) ((launches (car entry)) action))
      '(("session-manager" "SessionManager") ("configuration" "Configuration") ("plugin-manager" "PluginManager"))))
  (cond
    ((equal? name "SwitchToMode") (string-append "Mode:" (hash-ref (hash-ref action name) "input_mode")))
    ((equal? name "MovePane") (if (json-null? (hash-ref (hash-ref action name) "direction")) "MovePaneWithoutDirection" "MovePaneWithDirection"))
    ((equal? name "Resize") (if (json-null? (hash-ref (hash-ref action name) "direction")) "ResizeAny"
        (string-append "Resize" (hash-ref (hash-ref action name) "resize"))))
    ((equal? name "NewPane") (if (json-null? (hash-ref (hash-ref action name) "direction")) "NewPaneWithoutDirection" "NewPaneWithDirection"))
    ((not (null? group)) (caar group))
    ((hash-contains? descriptions name) name)
    ((not (null? known-plugin)) (cadr (car known-plugin)))
    ((and launch (hash-contains? (hash-ref launch "plugin") "Alias"))
      (define alias (hash-ref (hash-ref launch "plugin") "Alias"))
      (hash "OtherLaunch" (hash "name" name "plugin" (hash "name" (hash-ref alias "name") "configuration" (hash-ref alias "configuration"))
          "should_float" (hash-ref launch "should_float") "should_open_in_place" (hash-ref launch "should_open_in_place")
          "skip_cache" (hash-ref launch "skip_cache") "move_to_focused_tab" (bar-get launch "move_to_focused_tab" 'json-null))))
    (else (hash "Other" action))))
(define (description type)
  (cond ((not (string? type)) "Other action")
    ((starts-with? type "Mode:") (define mode (substring type 5))
      (bar-get (hash "RenamePane" "Rename pane" "RenameTab" "Rename tab" "EnterSearch" "Search" "Locked" "Lock" "Normal" "Unlock") mode mode))
    (else (bar-get descriptions type "Other action"))))
(define (compact-grouped-keys keys brackets locked)
  (define non-escape (filter (lambda (key) (not (member key '("ESC" "ENTER")))) keys))
  (define filtered (if (and locked (not (null? non-escape))) non-escape keys))
  (define (wrap text) (if brackets (string-append "<" text ">") text))
  (define orders '(("h" "j" "k" "l") ("H" "J" "K" "L") ("←" "↓" "↑" "→") ("[" "]") ("+" "-" "=") ("PgUp" "PgDn")))
  (if (= (length filtered) 1) (wrap (car filtered))
    (let ((groups '()) (index 0))
      (for-each (lambda (order)
          (define group (sort (filter (lambda (key) (member key order)) filtered) (lambda (a b) (< (bar-index a order) (bar-index b order)))))
          (when (= index 2) (set! group (filter (lambda (key) (member key group)) order)))
          (when (and (= index 4) (member "+" group)) (set! group (filter (lambda (key) (not (equal? key "="))) group)))
          (unless (null? group) (set! groups (append groups (list (wrap (string-join group (if (= index 5) "|" "")))))))
          (set! index (+ index 1))) orders)
      (define other (map wrap (filter (lambda (key) (not (member key (apply append orders)))) filtered)))
      (string-join (append groups (if (null? other) '() (list (string-join other "/")))) "/"))))
(define (compact-actions mi)
  (define keymap (filter (lambda (entry) (not (null? (cadr entry)))) (bar-mode-keymap mi)))
  (define (entry-action entry)
    (define base (hash-ref mi "base_mode"))
    (if (bar-equal? (cadr entry) (list (bar-switch-mode (if (json-null? base) "Normal" base)) "ToggleCommandPalette"))
      "CommandPalette" (car (cadr entry))))
  (define processed '())
  (define result '())
  (for-each (lambda (predicate)
      (define found (filter (lambda (entry) (predicate (entry-action entry))) keymap))
      (unless (null? found)
        (define type (action-type (entry-action (car found))))
        (unless (member type processed)
          (define keys (map (lambda (entry) (bar-key-label (car entry)))
              (filter (lambda (entry) (bar-equal? (action-type (entry-action entry)) type)) keymap)))
          (set! result (append result (list (list (compact-grouped-keys keys (not (equal? (hash-ref mi "mode") "Normal")) (equal? type "Mode:Locked")) (description type)))))
          (set! processed (cons type processed))))) (predicates (hash-ref mi "mode")))
  result)
(define (contents mi)
  (define entries (compact-actions mi))
  (cond ((equal? (hash-ref mi "mode") "Normal")
      (list entries 1 (max 0 (- (foldl (lambda (entry size) (+ size (string-length (car entry)) (string-length (cadr entry)) 6)) 0 entries) 1))))
    ((null? entries)
      (define mode (hash-ref mi "mode"))
      (define fallback (bar-get (hash "EnterSearch" "Entering search term..." "RenameTab" "Renaming tab..." "RenamePane" "Renaming pane...") mode mode))
      (list (list (list fallback "")) 2 (string-length fallback)))
    (else (list entries (+ 1 (length entries)) (+ 3 (foldl max 0 (map (lambda (entry) (string-length (car entry))) entries))
          (foldl max 0 (map (lambda (entry) (string-length (cadr entry))) entries)))))))
(define (compact-dimensions mi)
  (define content (contents mi))
  (list (+ (cadr content) (if (equal? (hash-ref mi "mode") "Normal") 0 1)) (caddr content)))
(define (styled text level opaque)
  (hash "text" text "opaque" opaque "levels" (append (map (lambda (n) '()) (range level)) (list (range (string-length text))))))
;; The tooltip's wire uses unbounded widget dimensions, unlike viewport-based forms.
(define (at component x y width)
  (define fields (split-many component ";"))
  (string-append (car fields) ";" (number->string x) "/" (number->string y) "/" (if width (number->string width) "") "/;" (string-join (cdr fields) ";")))
(define (compact-tooltip mi rows cols)
  (define content (contents mi))
  (define entries (car content))
  (define x (quotient (max 0 (- cols (caddr content))) 2))
  (define y (quotient (max 0 (- rows (cadr content))) 2))
  (define esc-end (string-append (string (integer->char 27)) "\\"))
  (if (not (equal? (hash-ref mi "mode") "Normal"))
    (let ((table
          (if (and (= (length entries) 1) (equal? (cadr (car entries)) ""))
            (let* ((header (string-replace (yinz-ui-table '((" " " "))) "table;2;1;" "table;2;2;"))
                (cell (yinz-ui-text (styled (caar entries) 0 #f))))
              (string-append (substring header 0 (- (string-length header) 2)) ";" (string-join (cdr (split-many cell ";")) ";")))
            (yinz-ui-table (cons '(" " " ") (map (lambda (entry) (list (styled (car entry) 3 #f) (string-append "- " (cadr entry)))) entries))))))
      (string-append (at table x y #f) esc-end))
    (let loop ((entries entries) (index 0) (offset 0) (output ""))
      (if (null? entries) output
        (let* ((entry (car entries)) (text (string-append (if (= index 0) "" " ") (car entry) " ")))
          (if (> (+ x offset (string-length text) (string-length (cadr entry)) 5) cols)
            (string-append output (at (yinz-ui-text (hash "text" "..." "opaque" #t)) (+ x offset) y (max 0 (- cols x offset))))
            (loop (cdr entries) (+ index 1) (+ offset (string-length (car entry)) (string-length (cadr entry)) 5 (if (= index 0) 0 1))
              (string-append output (at (yinz-ui-text (styled text 3 #t)) (+ x offset) y #f)
                (at (yinz-ui-ribbon (cadr entry)) (+ x offset (string-length text)) y #f)))))))))
