(require "./testing/common.scm" "./testing/palette.scm")
(define default-layout (hash "tabs" '() "creation_time" "" "update_time" ""))
(define (live name . current) (hash "name" name "is_current_session" (and (pair? current) (car current)) "connected_clients" 1 "creation_time" (hash "secs" 12 "nanos" 0)
    "tabs" (list (hash "tab_id" 7 "position" 0 "name" "shell")) "panes" (hash "panes" (hash "0" (list (hash "id" 4 "is_plugin" #f "is_selectable" #t "is_suppressed" #f "title" "shell" "exited" #f "exit_status" json-null))))
    "available_layouts" (list (hash "BuiltIn" "default") (hash "File" (list "custom" default-layout)))))
(define default-inventory (hash "live_sessions" (list (live "current" #t) (live "other")) "resurrectable_sessions" (list (list "saved" (hash "secs" 20 "nanos" 0)))))
(define (inventory sessions) (hash "live_sessions" sessions "resurrectable_sessions" '()))
(define (combined-inventory state)
  (hash "current_machine" "Local" "entries"
    (append (map (lambda (session) (hash "destination" "CurrentServer" "name" (hash-ref session "name")
            "current" (hash-ref session "is_current_session") "saved" #f
            "status" (if (hash-ref session "is_current_session") "Current session" "Running")))
        (hash-ref state "live_sessions"))
      (map (lambda (saved) (hash "destination" "CurrentServer" "name" (car saved) "current" #f "saved" #t "status" "Saved"))
        (hash-ref state "resurrectable_sessions")))))
(define (harness . inventories)
  (p-init "./session-palette.scm" (hash "GetPluginIds" (hash "plugin_id" 9 "client_id" 1 "yinz_pid" 1 "initial_cwd" "/tmp" "hostname" "test" "host_id" "test" "max_session_name_bytes" 80)
      "GetSessionInventory" (combined-inventory (if (null? inventories) default-inventory (car inventories)))
      "SwitchSessionDestination" "Ready"
      "GetSessionList" (if (null? inventories) default-inventory (car inventories)) "SaveSession" #t "KillSessionsAndReply" #t "DeleteDeadSessionAndReply" #t "SwitchSession" json-null "RenameSession" json-null
      "GetDisconnectTargets" '(2) "DisconnectOtherClients" json-null "CurrentSessionLastSavedTime" 1000 "ListNotifications" '())
    (hash "clientId" 1 "paneId" (hash "Terminal" 4) "tabId" 7 "currentProject" json-null)))
(define (handle view) (hash-ref view "handle"))
(define (choices view . query) (apply p-discover (hash-ref view "source") query))
(define (field view n) (list-ref (hash-ref view "fields") n))
(define (many-sessions) (inventory (map (lambda (i)
        (define value (number->string i)) (live (string-append "session-" (t-repeat "0" (- 3 (string-length value))) value) (= i 0))) (range 0 205))))
(test "session palette registers every root command and separates running from saved" (lambda ()
    (harness) (assert-equal (length (p-roots)) 14) (define actions (choices (p-open "switch-session")))
    (assert-equal (map (lambda (a) (list (hash-ref a "label") (hash-ref a "description"))) actions)
      (map (lambda (row) (map yinz-markdown-escape row))
        '(("Local / current" "Current session") ("Local / other" "Running") ("Local / saved" "Saved"))))
    (p-execute (handle (list-ref actions 2))) (assert-equal (hash-ref (hash-ref (hash-ref (hash-ref (car (t-named "SwitchSessionDestination")) "SwitchSessionDestination") "Prepare") "target") "name") "saved")))
(test "session searches do not match counts or saved ages" (lambda ()
    (harness (hash "live_sessions" (list (live "test-0" #t) (live "test-1"))
        "resurrectable_sessions" (list (list "saved-0" (hash "secs" 1 "nanos" 0)))))
    (define view (p-open "switch-session")) (define actions (choices view "test-1"))
    (assert-equal (map (lambda (a) (hash-ref a "label")) actions) (list (yinz-markdown-escape "Local / test-1")))
    (p-execute (handle (car actions))) (assert-equal (hash-ref (hash-ref (hash-ref (hash-ref (car (t-named "SwitchSessionDestination")) "SwitchSessionDestination") "Prepare") "target") "name") "test-1")
    (assert-equal (length (choices view "Running")) 2)
    (assert-equal (map (lambda (a) (hash-ref a "label")) (choices view "Saved")) (list (yinz-markdown-escape "Local / saved-0")))
    (assert-equal (choices view "saved-1") '())))
(test "session pagination searches the full inventory and preserves duplicate destination context" (lambda ()
    (harness (many-sessions)) (define view (p-open "find-pane")) (define page (choices view))
    (assert-equal (length page) 99) (assert-equal (length (t-unique (map (lambda (a) (hash-ref a "id")) page))) 99)
    (define next (p-view (p-execute (handle (t-last page))))) (define second (choices next (hash-ref next "initialQuery")))
    (assert (string-contains? (hash-ref (car second) "description") (yinz-markdown-escape "session-098")))
    (define found (choices view "session-204")) (assert-equal (length found) 1) (p-execute (handle (car found)))
    (define command (hash-ref (t-last (t-named "SwitchSession")) "SwitchSession"))
    (assert-equal (hash-ref command "name") "session-204") (assert-equal (hash-ref command "tab_position") 0) (assert-equal (hash-ref command "pane_id") '(4 #f))))
(test "new session supports automatic names, collisions, secondary configuration and validation" (lambda ()
    (harness) (define form (p-open "new-session"))
    (define collision (p-view (p-execute (handle form) (hash "name" "saved")))) (assert-equal (hash-ref (car (hash-ref collision "actions")) "label") "Resurrect this session")
    (define running (p-view (p-execute (handle form) (hash "name" "other")))) (assert-equal (hash-ref (car (hash-ref running "actions")) "label") "Switch to this session")
    (assert-throws (lambda () (p-execute (handle form) (hash "name" "bad/name"))))
    (define configured (p-view (p-execute (handle (car (hash-ref form "actions"))) (hash "name" "chosen"))))
    (assert-equal (hash-ref (field configured 0) "initialValue") "chosen")
    (assert-equal (hash-ref (field configured 1) "type") "choice") (assert-equal (hash-ref (field configured 1) "options") '("Default" "custom (custom)" "default (built-in)"))
    (p-execute (handle configured) (hash "name" "chosen" "layout" "custom (custom)" "directory" ""))
    (assert-equal (hash-ref (hash-ref (t-last (t-named "SwitchSession")) "SwitchSession") "layout") (hash "File" (list "custom" default-layout)))
    (p-execute (handle form) (hash "name" "")) (assert (json-null? (hash-ref (hash-ref (t-last (t-named "SwitchSession")) "SwitchSession") "name")))))
(test "destructive operations capture targets and require revised confirmation" (lambda ()
    (harness) (define form (p-open "kill-others")) (assert (hash-ref form "confirmation"))
    (assert (and (string-contains? (hash-ref form "title") "other") (not (string-contains? (hash-ref form "title") "current"))))
    (test-stub "GetSessionList" (inventory (list (live "current" #t) (live "new"))))
    (define revised (p-view (p-execute (handle form) (hash)))) (assert (string-contains? (hash-ref revised "title") "confirm again"))
    (assert-equal (t-named "KillSessionsAndReply") '()) (p-execute (handle revised) (hash)) (assert (member (hash "KillSessionsAndReply" '("new")) (test-commands)))))
(test "deleted destinations report errors without switching or creating" (lambda ()
    (harness) (define view (p-open "find-tab")) (define actions (choices view "other"))
    (test-stub "GetSessionList" (inventory (list (live "current" #t))))
    (assert-throws (lambda () (p-execute (handle (car actions)))) "no longer exists") (assert-equal (t-named "SwitchSession") '())))
(test "save host errors stay inline and notifications are newest first with full searchable details" (lambda ()
    (harness) (test-stub "SaveSession" #f) (assert-throws (lambda () (p-execute (handle (p-action (p-roots) "save")))))
    (test-stub "ListNotifications" (list (hash "id" 1 "received_at_unix_ms" 1 "message" "old") (hash "id" 2 "received_at_unix_ms" 2 "message" "new\nfull message")))
    (define view (p-open "notifications")) (define actions (choices view)) (assert-equal (map (lambda (a) (hash-ref a "id")) actions) '("2" "1"))
    (assert-equal (hash-ref (p-view (p-execute (handle (car actions)))) "text") (yinz-markdown-escape "new\nfull message")) (assert-equal (length (choices view "full message")) 1)
    (define message (string-append (t-repeat "🔔 long notification " 220) "searchable ending"))
    (test-stub "ListNotifications" (map (lambda (id) (hash "id" id "received_at_unix_ms" id "message" message)) (range 0 205)))
    (define large (choices view "searchable ending")) (assert-equal (length large) 99) (assert (< (string-length (yinz-json-string large)) 100000))
    (assert-equal (hash-ref (p-view (p-execute (handle (car large)))) "text") (yinz-markdown-escape message))))
(test "notifications preserve received age, source and suppression details" (lambda ()
    (harness) (test-advance 120000)
    (test-stub "ListNotifications" (list (hash "id" 1 "received_at_unix_ms" 0 "message" "finished"
          "outcome" (hash "original" (hash "id" 1 "received_at_unix_ms" 0 "source" "Osc99" "pane_id" json-null "plugin_id" json-null
              "title" "" "body" "finished" "delivery" "Toast")
            "title" "" "body" "finished" "delivery" "Toast" "suppressed" #t "fallback_reason" json-null))))
    (define view (p-open "notifications")) (define actions (choices view "suppressed"))
    (assert-equal (length actions) 1)
    (assert-equal (hash-ref (car actions) "description") (yinz-markdown-escape "Received 2m ago · [Osc99, suppressed] finished"))
    (define detail (p-view (p-execute (handle (car actions)))))
    (assert-equal (hash-ref detail "title") "Notification · received 2m ago")
    (assert-equal (hash-ref detail "text") (yinz-markdown-escape "[Osc99, suppressed] finished"))
    (test-stub "ListNotifications" (list (hash "id" 2 "received_at_unix_ms" 120000 "message" "new arrival" "outcome" json-null)))
    (assert-equal (hash-ref (car (choices view)) "description") "Received just now · new arrival")))
(test "rename, resurrection, deletion and details use typed host commands" (lambda ()
    (harness) (p-execute (handle (p-open "rename")) (hash "name" "renamed")) (assert (member (hash "RenameSession" "renamed") (test-commands)))
    (assert-equal (map (lambda (a) (hash-ref a "label")) (choices (p-open "resurrect"))) '("saved"))
    (define detail (p-view (p-execute (handle (car (choices (p-open "details") "current")))))) (assert (string-contains? (hash-ref detail "text") (yinz-markdown-escape "Last save: 1s ago")))
    (define deletion (p-open "delete-all")) (assert (hash-ref deletion "confirmation")) (p-execute (handle deletion) (hash))
    (assert (member (hash "DeleteDeadSessionAndReply" "saved") (test-commands)))
    (assert-equal (length (choices (p-open "delete"))) 1) (assert-equal (length (choices (p-open "kill"))) 2)))
(test "directory browsing returns or cancels without discarding current form values" (lambda ()
    (harness) (define first (p-open "new-session"))
    (define form (p-view (p-execute (handle (car (hash-ref first "actions"))) (hash "name" "kept"))))
    (define browse (p-action (hash-ref form "actions") "browse:directory"))
    (for-each (lambda (selected)
        (p-raw (handle browse) (hash "name" "edited" "layout" "custom (custom)" "directory" "/original"))
        (define pick (hash-ref (hash-ref (t-last (t-named "Pick")) "Pick") "Start"))
        (assert-equal (hash-ref pick "options") (hash "kind" "directory" "roots" '("/original")))
        (test-event (hash "PickResult" (hash "request_id" (hash-ref pick "request_id") "result" (hash "Ok" selected))))
        (define reply (p-reply)) (assert-equal (hash-ref reply "type") "fields")
        (assert-equal (hash-ref reply "values") (hash "name" "edited" "layout" "custom (custom)" "directory" (if (json-null? selected) "/original" selected)))
        (define transitions (filter (lambda (c) (equal? (hash-ref c "type") "suspend")) (p-commands)))
        (assert-equal (reverse (map (lambda (c) (hash-ref c "suspended")) (take (reverse transitions) 2))) '(#t #f))) (list "/chosen" json-null))))
(define (with-panes session panes) (hash-insert session "panes" (hash "panes" (hash "0" panes))))
(define (first-pane session) (car (hash-ref (hash-ref (hash-ref session "panes") "panes") "0")))
(test "session and tab counts omit hidden panes while pane searches expose exit status" (lambda ()
    (define session (live "current" #t)) (define pane (first-pane session))
    (harness (inventory (list (with-panes session
            (list (t-merge pane (hash "exited" #t "exit_status" 17))
              (t-merge pane (hash "id" 5 "is_suppressed" #t)) (t-merge pane (hash "id" 6 "is_selectable" #f)))))))
    (assert-equal (hash-ref (car (choices (p-open "switch-session"))) "description") "Current session")
    (assert-equal (hash-ref (car (choices (p-open "find-tab"))) "description") (yinz-markdown-escape "Panes: 1"))
    (define actions (choices (p-open "find-pane") "Exited (17)")) (assert-equal (length actions) 1)
    (assert (string-contains? (hash-ref (car actions) "description") (yinz-markdown-escape "Exited (17)")))))
(test "canonical pane IDs remain searchable before normal and long titles" (lambda ()
    (define session (live "current" #t)) (define pane (hash-insert (first-pane session) "id" 42)) (harness (inventory (list session))) (define view (p-open "find-pane"))
    (for-each (lambda (title)
        (test-stub "GetSessionList" (inventory (list (with-panes session (list (hash-insert pane "title" title) (t-merge pane (hash "title" title "is_plugin" #t)))))))
        (for-each (lambda (plugin?) (define id (string-append (if plugin? "plugin" "terminal") "_42")) (define actions (choices view id))
            (assert-equal (length actions) 1) (assert-equal (hash-ref (car actions) "id") (yinz-json-string (list "current" plugin? 42)))
            (assert (starts-with? (hash-ref (car actions) "label") (yinz-markdown-escape (string-append "[" id "] "))))) '(#f #t))) (list "shell" (t-repeat "long title " 100)))))
(test "pane identifiers distinguish plugins from terminals and missing panes fail" (lambda ()
    (define session (live "other")) (set! session (with-panes session (list (first-pane session) (hash-insert (first-pane session) "is_plugin" #t))))
    (harness (inventory (list (live "current" #t) session))) (define actions (choices (p-open "find-pane") "other"))
    (assert-equal (length actions) 2) (assert (not (equal? (hash-ref (car actions) "id") (hash-ref (cadr actions) "id"))))
    (p-execute (handle (cadr actions))) (assert-equal (hash-ref (hash-ref (t-last (t-named "SwitchSession")) "SwitchSession") "pane_id") '(4 #t))
    (test-stub "GetSessionList" (inventory (list (with-panes session '())))) (assert-throws (lambda () (p-execute (handle (car actions)))) "Pane no longer exists")))
(test "disconnect confirmation rechecks exact server targets" (lambda ()
    (harness) (define form (p-open "disconnect")) (assert (hash-ref form "confirmation")) (assert (string-contains? (hash-ref form "title") "clients 2?"))
    (test-stub "GetDisconnectTargets" '(3 2)) (set! form (p-view (p-execute (handle form) (hash))))
    (assert (and (string-contains? (hash-ref form "title") "Clients changed") (string-contains? (hash-ref form "title") "clients 2, 3?"))) (assert-equal (t-named "DisconnectOtherClients") '())
    (assert-equal (hash-ref (p-execute (handle form) (hash)) "type") "complete") (assert (member "DisconnectOtherClients" (test-commands)))))
(test "disconnect query failure and empty inventory never disconnect" (lambda ()
    (harness) (define form (p-open "disconnect"))
    (for-each (lambda (reply) (test-stub "GetDisconnectTargets" reply) (assert-throws (lambda () (p-execute (handle form) (hash)))) (assert-equal (t-named "DisconnectOtherClients") '())) (list '() (hash "error" "query failed")))))
(define (release form) (test-palette (hash "type" "release" "handles" (cons (handle form) (map handle (hash-ref form "actions")))) 1))
(test "disconnect cancellation and reopening uses fresh targets" (lambda ()
    (harness) (define form (p-open "disconnect")) (release form) (test-stub "GetDisconnectTargets" '(4))
    (define reopened (p-open "disconnect")) (assert (string-contains? (hash-ref reopened "title") "clients 4?"))
    (assert-throws (lambda () (p-execute (handle form) (hash)))) (assert-equal (t-named "DisconnectOtherClients") '())))
(test "session names enforce UTF-8 byte limits and released form callbacks cannot run" (lambda ()
    (harness) (define form (p-open "new-session")) (test-stub "GetPluginIds" (hash "max_session_name_bytes" 4))
    (for-each (lambda (name) (assert-throws (lambda () (p-execute (handle form) (hash "name" name))))) '("雪雪" "." ".." "pty-broker-v1.sock" "line\nname" " "))
    (release form) (assert-throws (lambda () (p-execute (handle (car (hash-ref form "actions"))) (hash "name" "ok"))) "no longer available")))
(test "pagination preloads the search and clearing it searches the entire collection" (lambda ()
    (harness (many-sessions)) (define actions (choices (p-open "switch-session") "session-1"))
    (define next (p-view (p-execute (handle (t-last actions))))) (assert-equal (hash-ref next "initialQuery") "session-1")
    (assert-equal (hash-ref (car (choices next "")) "label") (yinz-markdown-escape "Local / session-000"))))
