(require "./testing/common.scm" "./testing/palette.scm")
(define (node name . children) (hash "name" name "arguments" '() "properties" (hash) "children" (if (null? children) '() (car children))))
(define mouse-node (hash-insert (node "mouse_mode") "arguments" '(#t)))
(define snapshot (hash "action_properties" (hash) "action_children" (hash) "section_timing" (hash) "sections" '() "templates" (hash) "revision" "revision-one" "notice" "Applied to this session" "overrides" '() "actions" '()
    "catalog" (list (hash "name" "mouse_mode" "label" "mouse mode" "kind" "boolean" "choices" '("Enabled" "Disabled") "minimum" json-null "maximum" json-null "help" "Mouse" "timing" "Applies to this session"))
    "saved" (list mouse-node) "clients" (hash "1" (list mouse-node))))
(define configuration-source json-null)
(define configuration-roots '())
(define (search query)
  (set! configuration-roots (p-discover configuration-source query))
  (for-each (lambda (action) (assert (not (starts-with? (hash-ref action "label") "Configure ")))) configuration-roots)
  configuration-roots)
(define (harness . options)
  (define query (if (null? options) "mouse_mode" (car options)))
  (define inspected (if (< (length options) 2) snapshot (cadr options)))
  (define id (if (< (length options) 3) query (caddr options)))
  (p-init "./configuration-palette.scm" (hash "InspectConfiguration" inspected "EditConfiguration" snapshot)
    (hash "clientId" 1 "paneId" (hash "Terminal" 1) "tabId" 1 "currentProject" json-null) #t)
  (assert-equal (map (lambda (action) (hash-ref action "label")) (p-roots)) '("Configuration…"))
  (define submenu (p-view (p-execute (hash-ref (car (p-roots)) "handle"))))
  (assert-equal (hash-ref submenu "type") "actions")
  (set! configuration-source (hash-ref submenu "source"))
  (search query)
  (and id (p-action configuration-roots id)))
(define (inspect root section) (t-merge snapshot (hash "sections" (list section) "saved" (list root) "clients" (hash "1" (list root)))))
(define (no-write) (assert-equal (t-named "EditConfiguration") '()))
(define (written) (define writes (t-named "EditConfiguration")) (assert-equal (length writes) 1) (car writes))
(test "configuration entries search literal display text" (lambda ()
    (define inspected (inspect (node "env" (list (node "PATH"))) "env"))
    (define action (harness "env: PATH" inspected "env:0:PATH"))
    (assert-equal (hash-ref action "label") (yinz-markdown-escape "env: PATH…"))
    (assert-equal (length configuration-roots) 1)))
(for-each (lambda (destination)
    (test (string-append "scalar editor submits value and destination together: " destination) (lambda ()
        (define action (harness)) (define form (p-execute (hash-ref action "handle")))
        (assert-equal (hash-ref (p-view form) "type") "form") (assert-equal (hash-ref (p-view form) "title") "mouse mode")
        (assert-equal (hash-ref (p-view form) "description") "Mouse")
        (assert-equal (hash-ref action "description") "")
        (assert-equal (hash-ref (p-view form) "submitLabel") "Apply change")
        (assert-equal (map (lambda (field) (hash-ref field "initialValue")) (hash-ref (p-view form) "fields")) '("Enabled" "Apply to session"))
        (no-write)
        (assert-equal (hash-ref (p-submit form (hash "value" "Disabled" "destination" destination)) "type") "complete")
        (assert-equal (written) (hash "EditConfiguration" (hash "revision" "revision-one"
              "destination" (if (equal? destination "Save permanently") "permanent" "session")
              "patches" (list (hash "path" '("mouse_mode") "node" (hash-insert mouse-node "arguments" '(#f)))) "reset" '()))))))
  '("Apply to session" "Save permanently"))
(test "opening an editor and cancelling does not write configuration" (lambda ()
    (define action (harness)) (p-execute (hash-ref action "handle"))
    (test-palette (hash "type" "dismiss" "opening" 1) 1) (no-write)))
(test "ordered actions stay in a draft and save in the selected order" (lambda ()
    (define binding (hash-insert (node "bind" (list (node "Copy") (node "Quit"))) "arguments" '("Ctrl x")))
    (define root (node "keybinds" (list (node "normal" (list binding)))))
    (define action (harness "keybinds" (inspect root "keybinds"))) (define reply (p-execute (hash-ref action "handle")))
    (for-each (lambda (id) (set! reply (p-choose reply id))) '("entry:0" "children" "entry:0" "children" "entry:0" "down"))
    (no-write) (set! reply (p-choose reply "save")) (p-submit reply (hash "destination" "Apply to session"))
    (define encoded (yinz-json-string (written))) (assert (< (t-index encoded "\"name\":\"Quit\"") (t-index encoded "\"name\":\"Copy\"")))))
(for-each (lambda (id)
    (test (string-append "discovery selects repeated entry " id " by position") (lambda ()
        (define groups (map (lambda (mode) (hash-insert (node "shared_among" (list (hash-insert (node "bind" (list (node (if (equal? mode "normal") "Quit" "Copy")))) "arguments" '("Ctrl a")))) "arguments" (list mode))) '("normal" "locked")))
        (define action (harness "shared_among" (inspect (node "keybinds" groups) "keybinds") id))
        (assert-equal (length (t-unique (map (lambda (a) (hash-ref a "id")) configuration-roots))) (length configuration-roots))
        (define opened (p-execute (hash-ref action "handle")))
        (define fields (p-choose opened (if (string-contains? id "bind:") "children" "edit")))
        (if (string-contains? id "bind:") (assert (t-any (lambda (a) (string-contains? (hash-ref a "label") "Copy")) (hash-ref (p-view fields) "actions")))
          (assert (t-any (lambda (field) (equal? (hash-ref field "initialValue") "locked")) (hash-ref (p-view fields) "fields"))))))) '("keybinds:1:shared_among" "keybinds:1:shared_among:0:bind:[\"Ctrl a\"]"))
(test "discovery selects the second separator and rejects stale selections" (lambda ()
    (define root (node "context_menu" (list (node "separator") (node "item") (node "separator"))))
    (define inspected (inspect root "context_menu")) (define action (harness "separator" inspected "context_menu:2:separator"))
    (assert-equal (length (t-unique (map (lambda (a) (hash-ref a "id")) configuration-roots))) 2)
    (define reply (p-choose (p-execute (hash-ref action "handle")) "remove"))
    (set! reply (p-submit reply)) (set! reply (p-choose reply "save")) (p-submit reply (hash "destination" "Apply to session"))
    (assert-equal (written) (hash "EditConfiguration" (hash "revision" "revision-one" "destination" "session" "patches" (list (hash "path" '("context_menu") "node" (node "context_menu" (list (node "separator") (node "item"))))) "reset" '())))
    (test-stub "InspectConfiguration" (hash-insert inspected "revision" "revision-two"))
    (assert-throws (lambda () (p-execute (hash-ref action "handle"))) "Configuration changed")))
(for-each (lambda (destination)
    (test (string-append "unchanged session overrides: " destination " after reload") (lambda ()
        (define effective (hash-insert (node "mouse_mode") "arguments" '(#f))) (define unrelated (hash-insert (node "pane_frames") "arguments" '(#f)))
        (define inspected (t-merge snapshot (hash "clients" (hash "1" (list effective unrelated)) "saved" (append (hash-ref snapshot "saved") (list (hash-insert unrelated "arguments" '(#t)))))))
        (define action (harness "mouse_mode" inspected)) (define reply (p-execute (hash-ref action "handle")))
        (define reload (p-action (hash-ref (p-view reply) "actions") "reload"))
        (test-stub "InspectConfiguration" (hash-insert snapshot "revision" "revision-two"))
        (set! reply (p-execute (hash-ref reload "handle") (hash "value" "Disabled" "destination" destination)))
        (assert (hash-ref (p-view reply) "confirmation")) (no-write)
        (set! reply (p-submit reply)) (no-write) (p-submit reply (hash "destination" destination))
        (assert-equal (written) (hash "EditConfiguration" (hash "revision" "revision-two" "destination" (if (equal? destination "Save permanently") "permanent" "session") "patches" (if (equal? destination "Save permanently") (list (hash "path" '("mouse_mode") "node" effective)) '()) "reset" '())))))) '("Apply to session" "Save permanently"))
(for-each (lambda (add?)
    (test (string-append "permanent binding " (if add? "replacement" "edit") " preserves unrelated overrides") (lambda ()
        (define (binding chords action) (hash-insert (node "bind" (list (node action))) "arguments" chords))
        (define occupied (binding (if add? '("Ctrl b" "Ctrl c") '("Ctrl b")) "Quit"))
        (define (keybinds first) (node "keybinds" (list (node "normal" (list first occupied)))))
        (define inspected (t-merge snapshot (hash "sections" '("keybinds") "templates" (hash "keybinds/*" (list (binding '("Ctrl b") "Copy"))) "saved" (list (keybinds (binding '("Ctrl a") "Quit"))) "clients" (hash "1" (list (keybinds (binding '("Ctrl a") "Copy")))))))
        (define action (harness "keybinds" inspected)) (define reply (p-execute (hash-ref action "handle")))
        (for-each (lambda (id) (set! reply (p-choose reply id))) '("entry:0" "children"))
        (if add? (begin (set! reply (p-choose (p-choose reply "add") "template:0")) (set! reply (p-submit reply (hash "name" "bind" "arg:0" "Ctrl b"))) (set! reply (p-submit reply)))
          (begin (for-each (lambda (id) (set! reply (p-choose reply id))) '("entry:1" "children" "entry:0" "edit")) (set! reply (p-submit reply (hash "name" "Copy")))))
        (set! reply (p-choose reply "save")) (p-submit reply (hash "destination" "Save permanently"))
        (assert-equal (written) (hash "EditConfiguration" (hash "revision" "revision-one" "destination" "permanent" "reset" '() "patches"
              (append (if add? (list (hash "path" '("keybinds" "normal" "bind:[\"Ctrl b\",\"Ctrl c\"]") "node" json-null) (hash "path" '("keybinds" "normal" "bind:[\"Ctrl c\"]") "node" (binding '("Ctrl c") "Quit"))) '())
                (list (hash "path" '("keybinds" "normal" "bind:[\"Ctrl b\"]") "node" (binding '("Ctrl b") "Copy")))))))))) '(#f #t))
(for-each (lambda (saved)
    (test (string-append "permanent scalar save reconciles saved=" (if saved "true" "false") " and effective=" (if saved "false" "true")) (lambda ()
        (define inspected (t-merge snapshot (hash "saved" (list (hash-insert mouse-node "arguments" (list saved))) "clients" (hash "1" (list (hash-insert mouse-node "arguments" (list (not saved))))))))
        (define action (harness "mouse_mode" inspected))
        (p-submit (p-execute (hash-ref action "handle")) (hash "value" "Enabled" "destination" "Save permanently"))
        (assert-equal (written) (hash "EditConfiguration" (hash "revision" "revision-one" "destination" "permanent" "patches" (list (hash "path" '("mouse_mode") "node" mouse-node)) "reset" '())))))) '(#t #f))
(test "configuration discovery excludes theme settings and descendants" (lambda ()
    (define theme-settings '("theme" "theme_dark" "theme_light" "theme_dir" "explicit_theme_hue" "agent_theme_mapping"))
    (define themes (node "themes" (list (node "custom-palette" (list (node "accent"))))))
    (define inspected (t-merge snapshot
        (hash "catalog" (append (hash-ref snapshot "catalog")
            (map (lambda (name) (t-merge (car (hash-ref snapshot "catalog")) (hash "name" name "label" name))) theme-settings))
          "sections" '("themes" "keybinds") "saved" (append (hash-ref snapshot "saved") (list themes))
          "clients" (hash "1" (append (hash-ref (hash-ref snapshot "clients") "1") (list themes))))))
    (harness "" inspected #f)
    (assert-equal (map (lambda (action) (hash-ref action "id")) configuration-roots) '("mouse_mode" "keybinds"))
    (for-each (lambda (query) (assert-equal (search query) '()))
      (append '("theme") theme-settings '("themes" "custom-palette" "accent")))))
(for-each (lambda (timing)
    (test (string-append timing " scalar offers only permanent saving") (lambda ()
        (define setting (hash-insert (car (hash-ref snapshot "catalog")) "timing" timing))
        (define action (harness "mouse_mode" (hash-insert snapshot "catalog" (list setting))))
        (define reply (p-execute (hash-ref action "handle")))
        (define destination (t-find (lambda (field) (equal? (hash-ref field "id") "destination")) (hash-ref (p-view reply) "fields")))
        (assert-equal (hash-ref destination "type") "choice")
        (assert-equal (hash-ref destination "options") '("Save permanently"))
        (assert-equal (hash-ref destination "initialValue") "Save permanently")
        (p-submit reply (hash "value" "Disabled" "destination" (hash-ref destination "initialValue")))
        (assert-equal (hash-ref (hash-ref (written) "EditConfiguration") "destination") "permanent"))))
  '("On next session start" "On next client start"))
(test "scalar submission retains the revision from opening the editor" (lambda ()
    (define action (harness)) (define reply (p-execute (hash-ref action "handle")))
    (test-stub "InspectConfiguration" (hash-insert snapshot "revision" "revision-two"))
    (p-submit reply (hash "value" "Disabled" "destination" "Apply to session"))
    (assert-equal (hash-ref (hash-ref (written) "EditConfiguration") "revision") "revision-one")))
(for-each (lambda (operation)
    (test (string-append "scalar " operation " keeps its confirmation and destination workflow") (lambda ()
        (define action (harness)) (define reply (p-execute (hash-ref action "handle")))
        (set! reply (p-choose reply operation))
        (when (equal? operation "unset")
          (assert (hash-ref (p-view reply) "confirmation")) (no-write) (set! reply (p-submit reply)))
        (assert-equal (map (lambda (field) (hash-ref field "id")) (hash-ref (p-view reply) "fields")) '("destination"))
        (no-write) (p-submit reply (hash "destination" "Apply to session"))
        (assert-equal (written) (hash "EditConfiguration" (hash "revision" "revision-one" "destination" "session"
              "patches" (if (equal? operation "unset") (list (hash "path" '("mouse_mode") "node" json-null)) '())
              "reset" (if (equal? operation "reset") '(("mouse_mode")) '()))))))) '("unset" "reset"))
(test "configuration submenu preserves clipboard and keybinding search aliases" (lambda ()
    (define inspected (t-merge snapshot (hash "catalog"
          (list (t-merge (car (hash-ref snapshot "catalog")) (hash "name" "copy_command" "label" "copy command")))
          "sections" '("keybinds"))))
    (harness "" inspected #f)
    (for-each (lambda (entry)
        (assert-equal (map (lambda (action) (hash-ref action "id")) (search (car entry))) (list (cadr entry))))
      '(("clipboard" "copy_command") ("keybindings" "keybinds")))))
