(require "./agents/state.scm")
(require "./agents/overlay.scm")
(require "./agents/service.scm")
(require "./agents/history.scm")
(require "./agents/search.scm")
(require "./agents/input.scm")
(require "./agents/render.scm")
(require "./agents/history-worker.scm")
(yinz-register-workers (hash "history" a-history-worker))
(define (unload) (a-end-visit!))
(define (load configuration)
  (a-reset!) (a-set! "configuration" configuration)
  (yinz-command (hash "Subscribe" '("AgentProvidersChanged")))
  (a-set! "providers" (or (a-some (a-call "GetAgentProviders" #f)) '()))
  (yinz-command (hash "Subscribe" '("CustomMessage" "Key" "Mouse" "PastedText" "PaneTabsUpdate" "Timer" "Visible" "PaneUpdate" "SessionUpdate" "TabUpdate" "PluginConfigurationChanged")))
  (yinz-command (hash "SetTimeout" 2.0)) (yinz-command (hash "SetSelectable" #t))
  (yinz-command (hash "SetSelfMouseSelectionSupport" #t))
  (define ids (yinz-command "GetPluginIds"))
  (a-set! "own_plugin_id" (hash-ref ids "plugin_id")) (a-set! "own_client_id" (hash-ref ids "client_id"))
  (a-set! "initial_cwd" (hash-ref ids "initial_cwd"))
  (yinz-command (hash "RenamePluginPane" (list (a-get "own_plugin_id") "Agents")))
  (unless (hash-contains? configuration "view") (a-set! "mount_pending" #t) (a-mount!))
  (a-load-history!) (a-broadcast! "agent_subscribe" #f) (a-load-more!))
(define (update event)
  (define tag (if (hash? event) (car (hash-keys->list event)) event))
  (define value (if (hash? event) (hash-ref event tag) 'json-null))
  (when (member tag '("Key" "Mouse" "PastedText"))
    (a-set! "own_client_id" (hash-ref (yinz-command "GetPluginIds") "client_id"))
    (a-set! "tabs_focused" (if (member (a-get "own_client_id") (a-get "bar_focused")) #t #f)))
  (define had-bar (a-get "tabs_focused")) (define selection (a-selection-key)) (define revision (a-selected-revision))
  (define changed
    (cond ((equal? tag "PluginConfigurationChanged") (a-set! "configuration" value) (a-place-panel! #f) #t)
      ((equal? tag "TabUpdate") (a-set! "own_client_id" (hash-ref (yinz-command "GetPluginIds") "client_id")) (a-panel-tabs! value) #f)
      ((equal? tag "SessionUpdate") (a-discover-service! (car value)) #f)
      ((equal? tag "CustomMessage") (a-receive-history! (car value) (cadr value)))
      ((equal? tag "Visible")
        (if value (begin (a-set! "history_hidden" #f) (a-load-history!)) (a-end-visit!)) #t)
      ((equal? tag "PaneTabsUpdate")
        (define tabs (a-find (lambda (tabs) (a-find (lambda (slot) (equal? (hash-ref slot "plugin_id") (a-get "own_plugin_id"))) (hash-ref tabs "tabs"))) value))
        (define was-focused (member (a-get "own_client_id") (a-get "bar_focused")))
        (a-set! "pane_tabs" (a-field tabs "id" #f)) (a-set! "bar_focused" (a-field tabs "bar_focused" '()))
        (a-set! "tabs_focused" (if (member (a-get "own_client_id") (a-get "bar_focused")) #t #f))
        ; Reverse Tab has already removed this client's bar focus and chosen its content region.
        (when (and was-focused (not (a-get "tabs_focused"))) (a-set! "focus" "list")) #t)
      ((equal? tag "PaneUpdate")
        (a-panel-panes! value)
        (define pane (a-panel-pane value)) (define own (a-own-pane value))
        (define keys (and pane (a-own-pane-changed! (not (hash-ref pane "is_suppressed")) (and own (hash-ref own "is_focused")))))
        (when (and pane (not (hash-ref pane "is_suppressed")) (a-get "history_hidden"))
          (a-set! "history_hidden" #f) (a-load-history!))
        (a-set! "pane_tabs" (or (a-field (a-field own "pane_tabs" #f) "id" #f) (a-get "pane_tabs")))
        (when (and (a-get "mount_pending") own)
          (if (a-get "pane_tabs") (a-set! "mount_pending" #f) (a-mount!))) (if keys #t #f))
      ((equal? tag "Key") (a-on-key! value)) ((equal? tag "Mouse") (a-on-mouse! value))
      ((equal? tag "PastedText") (a-paste! value))
      ((equal? tag "Timer")
        (yinz-command (hash "SetTimeout" 2.0))
        (define now (yinz-wall-clock-ms)) (define search-expired (a-expire-search! now))
        (define history-expired (a-expire-history! (yinz-now-ms)))
        (define summary-expired (a-expire-summary! now)) (define minute (quotient now 60000))
        (define changed (not (= minute (a-get "age_minute")))) (a-set! "age_minute" minute)
        (or history-expired search-expired summary-expired (and changed (a-shows-age?))))
      ((equal? tag "AgentProvidersChanged") (a-set! "providers" value) #f)
      (else #f)))
  (define moved (a-follow-selection! selection))
  (unless (or moved (equal? revision (a-selected-revision)))
    (a-leave-row!) (a-set! "pending_history_revision" (a-selected-revision)))
  (a-load-history!)
  (when (and (equal? tag "Key") (a-get "tabs_focused") (not had-bar) (a-get "pane_tabs"))
    (a-call (hash "PaneTabs" (hash "Focus" (hash "id" (a-get "pane_tabs") "bar" #t))) #f))
  (when (equal? tag "Key")
    (a-set! "bar_focused" (filter (lambda (client) (not (= client (a-get "own_client_id")))) (a-get "bar_focused")))
    (when (a-get "tabs_focused") (a-set! "bar_focused" (append (a-get "bar_focused") (list (a-get "own_client_id"))))))
  changed)
(define (pipe message)
  (define name (hash-ref message "name"))
  (cond ((equal? name "agent_hello")
      (when (and (a-get "service_id") (equal? (hash-ref message "source") (hash "Plugin" (a-get "service_id"))))
        (a-set! "service_seq" 0) (a-broadcast! "agent_subscribe" #f)) #f)
    ((equal? name "agent_snapshot") (a-receive-snapshot! message))
    ((equal? name "agent_strip_reposition") (a-reposition!) #f)
    ((equal? name "agent_strip_yield") (a-take-ring! "tabs"))
    (else
      (a-set! "own_client_id" (hash-ref (yinz-command "GetPluginIds") "client_id"))
      (if (equal? name "agent_strip_take") (a-take-ring! (a-field (hash-ref message "args") "stop" #f)) #f))))
(define (render rows cols) (a-draw! rows cols) (void))
