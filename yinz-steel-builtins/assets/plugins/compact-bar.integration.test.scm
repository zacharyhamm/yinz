(require "./testing/common.scm")
(test "embedded compact bar receives tabs and opens an unselectable tooltip" (lambda ()
    (s-start (hash "columns" 240)) (test-wait-for-text "yinz-test>")
    (s-action "SwitchToMode \"Tab\";") (s-key "r") (s-text "scheme-compact") (s-action "SwitchToMode \"Normal\";")
    (s-load "yinz:compact-bar" (hash "configuration" (hash "tooltip" "Ctrl y")))
    (define (bars) (filter (lambda (pane) (equal? (t-get pane "plugin_url" #f) "yinz:compact-bar")) (s-panes)))
    (test-wait-for-text "scheme-compact")
    (test-wait-for "compact bar is unselectable" (lambda () (t-any (lambda (pane) (not (hash-ref pane "is_selectable"))) (bars))))
    (s-action "SwitchToMode \"Pane\";")
    (test-wait-for "floating tooltip is unselectable" (lambda () (t-any (lambda (pane) (and (hash-ref pane "is_floating") (not (hash-ref pane "is_selectable")))) (bars))))
    (s-action "SwitchToMode \"Normal\";")
    (test-wait-for "transient tooltip closed" (lambda () (= 1 (length (bars)))))))
