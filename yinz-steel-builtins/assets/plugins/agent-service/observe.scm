(require "./state.scm")
(define (remove-id field id) (as-set! field (filter (lambda (other) (not (= id other))) (as-get field))))
(define (title-owned? id)
  (define pane (as-find (lambda (pane) (= id (hash-ref pane "pane_id"))) (as-panes)))
  (or (as-map-get "manual" id #f) (and pane (or (as-present? (hash-ref pane "agent"))
        (as-present? (hash-ref pane "detected")) (as-present? (as-kind (hash-ref pane "command")))))))
(define (toast-kind id)
  (define pane (as-pane id)) (define kind (and pane (as-classify pane)))
  (if (as-present? kind) (as-model "KindCell" (car kind) json-null (hash-contains? (as-get "hooks") (number->string id))) json-null))
(define (kept-prompt prompt)
  (define question (trim (as-model "EnvelopeQuestion" prompt)))
  (if (equal? question "") #f (substring question 0 (min 600 (string-length question)))))
(define (on-hook id kind event)
  (as-call "record-event" id kind event (yinz-wall-clock-ms))
  (unless (as-field event "archive_only" #f)
    (if (equal? (hash-ref event "hook_event_name") "SessionEnd")
      (begin
        (as-map-remove! "prompts" id) (remove-id "event-fed" id)
        (when (as-map-get "hooks" id #f) (as-map-remove! "hooks" id) (as-publish! #f)))
      (let* ((phase (as-model "HookPhase" kind event))
          (pane (as-find (lambda (pane) (= id (hash-ref pane "pane_id"))) (as-panes))))
        (when (and (as-present? phase) pane (as-present? (as-classify pane)))
          (as-map-set! "latched" id kind) (remove-id "pending-release" id)
          (define previous-cwd (as-map-get "cwds" id #f))
          (when (as-present? (hash-ref event "cwd")) (as-record-cwd! id (hash-ref event "cwd")))
          (define moved (not (equal? previous-cwd (as-map-get "cwds" id #f))))
          (define previous (as-map-get "hooks" id #f))
          (when (and previous (not (equal? (hash-ref previous "session_id") "")) (not (equal? (hash-ref previous "session_id") (hash-ref event "session_id"))))
            (for-each (lambda (name) (as-map-remove! name id)) '("summaries" "summary-requests" "prompts")))
          (when (equal? (hash-ref event "hook_event_name") "UserPromptSubmit")
            (define prompt (and (as-present? (hash-ref event "prompt")) (trim (as-model "SubmittedPrompt" (hash-ref event "prompt")))))
            (define kept (and prompt (not (equal? prompt "")) (kept-prompt prompt)))
            (if kept (as-map-set! "prompts" id kept) (as-map-remove! "prompts" id))
            (when (and prompt (not (equal? prompt "")))
              (define title (as-model "PromptTitle" prompt))
              (when (and (as-present? title) (title-owned? id)) (as-send (hash "RenameTerminalPane" (list id title))))))
          (define previous-wait (and previous (equal? (hash-ref previous "phase") "Waiting") (hash-ref previous "waiting_on")))
          (define waiting (if (equal? phase "Waiting")
              (if (and (as-present? previous-wait) (equal? (hash-ref event "hook_event_name") "Notification")) previous-wait (as-model "WaitingDetail" event)) json-null))
          (define feed (hash "phase" phase "detail" (as-model "HookDetail" kind event) "waiting_on" waiting
              "session_id" (hash-ref event "session_id") "cwd" (hash-ref event "cwd")))
          (as-set! "event-fed" (as-unique (cons id (as-get "event-fed"))))
          (define changed (not (equal? previous feed)))
          (when changed (as-map-set! "hooks" id feed))
          (as-settle-latches!)
          (when moved (as-rejoin! "cwds" "cwd") (as-call "resolve-repositories"))
          (when (and (equal? phase "Waiting") (or (not previous) (not (equal? (hash-ref previous "phase") "Waiting")))
              (not (equal? (as-get "focused") id)))
            (as-send (hash "Notify" (list (as-model "WaitingToast" id (toast-kind id) feed) (hash "Terminal" id) json-null))))
          (when changed (as-publish! #f))))))
  (as-call "drain") (as-call "persist"))
(define (on-command id args foreground)
  (define command (if (null? args) json-null (string-join args " ")))
  (if (as-present? command) (as-map-set! "commands" id command) (as-map-remove! "commands" id))
  (when (and (not foreground) (not (as-present? (as-kind command))) (as-map-get "latched" id #f))
    (as-set! "pending-release" (as-unique (cons id (as-get "pending-release")))))
  (as-update-pane! id (lambda (pane) (hash-insert pane "command" command)))
  (as-settle-latches!) (as-call "resolve-repositories"))
(define (running-ids)
  (map (lambda (pane) (hash-ref pane "pane_id")) (filter (lambda (pane) (equal? (hash-ref pane "status") "Running")) (as-panes))))
(define (repair-commands)
  (define running (running-ids))
  (unless (null? running)
    (define cursor (modulo (as-get "command-cursor") (length running)))
    (define due (as-take (as-unique (append
            (filter (lambda (id) (member id (as-get "pending-release"))) running)
            (filter (lambda (id) (not (as-map-get "commands" id #f))) running)
            (list-tail running cursor) (take running cursor))) 4))
    (as-set! "command-cursor" (modulo (+ (as-get "command-cursor") (length due)) (length running)))
    (define changed #f)
    (for-each (lambda (id)
        (define args (as-safe (lambda () (as-send (hash "GetPaneRunningCommand" (hash "pane_id" (hash "Terminal" id))))) '()))
        (when (pair? args)
          (define command (string-join args " "))
          (define release (member id (as-get "pending-release")))
          (remove-id "pending-release" id)
          (when (and release (not (as-present? (as-kind command))))
            (as-map-remove! "latched" id) (as-call "finish-run" id "Closed" (yinz-wall-clock-ms)) (as-forget! id) (set! changed #t))
          (unless (equal? command (as-map-get "commands" id #f)) (as-map-set! "commands" id command) (set! changed #t)))) due)
    (when changed (as-rejoin! "commands" "command") (as-settle-latches!) (as-call "resolve-repositories"))))
(define (repair-cwds)
  (define due (as-take (filter (lambda (pane) (and (json-null? (hash-ref pane "cwd")) (equal? (hash-ref pane "status") "Running"))) (as-all-panes)) 4))
  (define changed #f)
  (for-each (lambda (pane)
      (define id (hash-ref pane "pane_id"))
      (define cwd (as-safe (lambda () (as-send (hash "GetPaneCwd" (hash "pane_id" (hash "Terminal" id))))) json-null))
      (when (as-present? cwd) (as-record-cwd! id cwd) (set! changed #t))) due)
  (when changed (as-rejoin! "cwds" "cwd") (as-call "resolve-repositories")))
(define (read-pane id)
  (define contents (as-safe (lambda () (as-send (hash "GetPaneScrollback" (hash "pane_id" (hash "Terminal" id) "get_full_scrollback" #f)))) #f))
  (if contents
    (let* ((all (append (hash-ref contents "lines_above_viewport") (hash-ref contents "viewport") (hash-ref contents "lines_below_viewport")))
        (lines (reverse (let loop ((lines (reverse all)))
              (if (and (pair? lines) (equal? (trim (car lines)) "")) (loop (cdr lines)) lines)))))
      (hash-insert contents "text" (if (null? lines) "(pane is empty)" (string-join lines "\n")))) #f))
(define (observe)
  (define known (map (lambda (pane) (hash-ref pane "pane_id")) (filter (lambda (pane) (as-present? (as-classify pane))) (as-panes))))
  (define running (sort (filter (lambda (id) (member id known)) (running-ids)) <))
  (as-map-prune! "activity" (lambda (id value) (member (string->number id) running)))
  (for-each (lambda (name) (as-map-prune! name (lambda (id value) (member (string->number id) known)))) '("summaries" "prompts"))
  (for-each (lambda (name)
      (for-each (lambda (id) (as-map-set! name id (hash-insert (as-map-get name id #f) "ticks" (+ 1 (hash-ref (as-map-get name id #f) "ticks"))))) (as-keys (as-get name)))
      (as-map-prune! name (lambda (id value) (and (<= (hash-ref value "ticks") 12) (or (equal? name "run-summary-requests") (member (string->number id) running)))))) '("summary-requests" "run-summary-requests"))
  (for-each (lambda (id)
      (define reading (read-pane id))
      (define old (as-map-get "activity" id #f))
      (define output-ago (and reading (hash-ref reading "last_output_ms_ago")))
      (define text (and reading (hash-ref reading "text")))
      (define moved (and old text (not (= (car old) (as-model "Fingerprint" text)))))
      (define usable (and reading (not (hash-ref reading "is_scrolled"))
          (or (not moved) (and (as-present? output-ago) (<= output-ago (as-get "poll-window"))))))
      (as-set! "activity" (as-model "Observe" (as-get "activity") id (if usable text json-null)))) running))
(as-register! "hook" on-hook)
(as-register! "command" on-command)
(as-register! "observe" observe)
(as-register! "read-pane" read-pane)
(as-register! "repair-commands" repair-commands)
(as-register! "repair-cwds" repair-cwds)
(as-register! "title-owned" title-owned?)
(as-register! "toast-kind" toast-kind)
(as-register! "kept-prompt" kept-prompt)
