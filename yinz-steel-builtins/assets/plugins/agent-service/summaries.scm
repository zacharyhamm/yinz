(require "./state.scm")
(define (read-configuration) (as-send (hash "GetPluginAliasConfiguration" "agent-service")))
(define (run-delta run)
  (define text (string-join (map (lambda (entry)
          (string-append (hash-ref entry "kind") ": " (if (equal? (hash-ref entry "kind") "prompt") (as-model "EnvelopeQuestion" (hash-ref entry "text")) (hash-ref entry "text"))))
        (filter (lambda (entry) (member (hash-ref entry "kind") '("plan" "question" "result" "message" "prompt"))) (hash-ref run "entries"))) "\n"))
  (and (not (equal? text "")) (as-model "SummaryTail" text)))
(define (latest-message run)
  (and run (as-find (lambda (entry) (member (hash-ref entry "kind") '("result" "message"))) (reverse (hash-ref run "entries")))))
(define (pane-hash id) (define value (as-map-get "activity" id #f)) (if value (car value) 0))
(define (pane-kind id) (define pane (as-find (lambda (pane) (= id (hash-ref pane "pane_id"))) (as-panes))) (define kind (and pane (as-classify pane))) (and (as-present? kind) (car kind)))
(define (branch id)
  (define location (as-location id)) (define repository (and (as-present? location) (as-map-get "repositories" location #f)))
  (if repository (hash-ref repository "branch") json-null))
(define (send-request endpoint body context)
  (as-send (hash "WebRequest" (list (hash-ref endpoint "url") "Post" (hash-ref endpoint "headers") body context json-null json-null))))
(define (next-request table key fingerprint)
  (as-set! "summary-seq" (+ 1 (as-get "summary-seq")))
  (define id (as-get "summary-seq"))
  (as-map-set! table key (hash "id" id "hash" fingerprint "ticks" 0)) id)
(define (with-summary run summary)
  (define updated (as-model "PushSummaryEntry" run (hash-ref summary "text") (yinz-wall-clock-ms)))
  (hash-insert (hash-insert updated "summary" summary) "summarized_revision" (hash-ref updated "revision")))
(define (attach-run-summary pane-id summary)
  (define run (as-map-get "runs" pane-id #f))
  (when run
    (define updated (with-summary run summary))
    (as-map-set! "runs" pane-id updated) (as-map-set! "dirty-runs" (hash-ref updated "id") updated)))
(define (attach-stored-summary run summary)
  (define stamped (as-model "StampSummary" summary (hash-ref run "summary") (yinz-wall-clock-ms)))
  (define updated (with-summary run stamped))
  (as-map-set! "dirty-runs" (hash-ref updated "id") updated)
  (as-publish! #f))
(define (accept-pane-summary id summary local)
  (define feed (as-map-get "hooks" id #f))
  (define fixed (if feed (hash-insert summary "awaiting" (equal? (hash-ref feed "phase") "Waiting")) summary))
  (define stamped (as-model "StampSummary" fixed (as-map-get "summaries" id json-null) (yinz-wall-clock-ms)))
  (unless local
    (define title (as-model "RenameTitle" stamped))
    (when (and (as-present? title) (as-call "title-owned" id)) (as-send (hash "RenameTerminalPane" (list id title)))))
  (when (and (or local (not (hash-ref stamped "awaiting"))) (not (equal? (as-get "focused") id)))
    (as-send (hash "Notify" (list (as-model "SummaryToast" id (as-call "toast-kind" id) stamped) (hash "Terminal" id) json-null))))
  (attach-run-summary id stamped)
  (as-map-set! "summaries" id stamped)
  (as-publish! #f))
(define (local-pane-summary id message)
  (define summary (as-model "LocalSummary" message (pane-hash id)))
  (when (as-present? summary) (as-map-remove! "summary-requests" id) (accept-pane-summary id summary #t)))
(define (summarize-pane id)
  (define config (read-configuration))
  (define endpoint (as-model "Endpoint" config (as-get "env") #f))
  (define kind (pane-kind id))
  (when (and (as-model "SummariesEnabled" config) (not (as-map-get "summary-requests" id #f)) kind (not (member id (as-get "pending-release"))))
    (define pane (as-pane id))
    (if (as-map-get "hooks" id #f)
      (let* ((run (as-map-get "runs" id #f)) (message (latest-message run)))
        (if (json-null? endpoint)
          (when message (local-pane-summary id (hash-ref message "text")))
          (let ((text (and run (run-delta run))))
            (when text
              (define body (as-model "RunSummaryRequestBody" (hash-ref endpoint "model") kind (hash-ref pane "cwd") (branch id) (as-map-get "prompts" id json-null) text))
              (define request (next-request "summary-requests" id 0))
              (send-request endpoint body (hash "summary_pane" (number->string id) "summary_id" (number->string request)))))))
      (unless (json-null? endpoint)
        (define reading (as-call "read-pane" id))
        (define old (as-map-get "activity" id #f))
        (define ago (and reading (hash-ref reading "last_output_ms_ago")))
        (define text (and reading (hash-ref reading "text")))
        (define moved (and old text (not (= (car old) (as-model "Fingerprint" text)))))
        (when (and reading (not (hash-ref reading "is_scrolled"))
            (or (not moved) (and (as-present? ago) (<= ago (as-get "poll-window")))) old (as-model "WorthSummarizing" text))
          (define body (as-model "SummaryRequestBody" (hash-ref endpoint "model") kind (hash-ref pane "cwd") (branch id) (as-model "SummaryTail" text)))
          (define request (next-request "summary-requests" id (car old)))
          (send-request endpoint body (hash "summary_pane" (number->string id) "summary_id" (number->string request))))))))
(define (summarize-run id)
  (define config (read-configuration))
  (define endpoint (as-model "Endpoint" config (as-get "env") #f))
  (when (and (as-model "SummariesEnabled" config) (not (as-map-get "run-summary-requests" id #f)))
    (define run (as-call "load-run" id))
    (when run
      (if (json-null? endpoint)
        (let ((message (latest-message run)))
          (when message (define summary (as-model "LocalSummary" (hash-ref message "text") 0))
            (when (as-present? summary) (attach-stored-summary run summary))))
        (let* ((text (run-delta run))
            (prompt (as-find (lambda (entry) (equal? (hash-ref entry "kind") "prompt")) (reverse (hash-ref run "entries"))))
            (asked (and prompt (as-call "kept-prompt" (hash-ref prompt "text")))))
          (when text
            (define body (as-model "RunSummaryRequestBody" (hash-ref endpoint "model") (hash-ref run "kind") (hash-ref run "cwd") json-null (if asked asked json-null) text))
            (define request (next-request "run-summary-requests" id 0))
            (send-request endpoint body (hash "summary_run" id "summary_id" (number->string request)))))))))
(define (finish-summary status body context)
  (define run-id (as-field context "summary_run" #f))
  (define id (and (as-field context "summary_id" #f) (string->number (hash-ref context "summary_id"))))
  (if run-id
    (let ((pending (as-map-get "run-summary-requests" run-id #f)))
      (when (and pending id (= id (hash-ref pending "id")))
        (as-map-remove! "run-summary-requests" run-id)
        (when (and (>= status 200) (< status 300))
          (define summary (as-model "ParseSummary" body 0))
          (when (as-present? summary) (define run (as-call "load-run" run-id)) (when run (attach-stored-summary run summary))))))
    (let* ((pane-id (and (as-field context "summary_pane" #f) (string->number (hash-ref context "summary_pane"))))
        (pending (and pane-id (as-map-get "summary-requests" pane-id #f))))
      (when (and pending id (= id (hash-ref pending "id")))
        (as-map-remove! "summary-requests" pane-id)
        (when (and (pane-kind pane-id) (not (member pane-id (as-get "pending-release"))) (>= status 200) (< status 300))
          (define summary (as-model "ParseSummary" body (hash-ref pending "hash")))
          (when (as-present? summary) (accept-pane-summary pane-id summary #f)))))))
(as-register! "summarize-run" summarize-run)
(as-register! "summarize-pane" summarize-pane)
(as-register! "finish-summary" finish-summary)
