(require "./state.scm")
(define (answer source reply)
  (define output (as-model "CompletionReplyString" reply))
  (when (> (length (bytes->list (string->bytes output))) 67108864)
    (set! output (as-model "CompletionReplyString" (as-model "CompletionError" (hash-ref reply "request_id") "completion reply exceeds the 67108864-byte transport limit"))))
  (cond ((and (hash? source) (hash-contains? source "Plugin")) (as-message "llm_complete_result" (hash-ref source "Plugin") output (hash)))
    ((and (hash? source) (hash-contains? source "Cli"))
      (as-send (hash "CliPipeOutput" (list (hash-ref source "Cli") (string-append output "\n"))))
      (as-send (hash "UnblockCliPipeInput" (hash-ref source "Cli"))))))
(define (complete message)
  ;; Configuration is read before caller/payload validation, matching the service command boundary.
  (define configuration (as-send (hash "GetPluginAliasConfiguration" "agent-service")))
  (define allowed (as-model "CompletionsEnabled" configuration))
  (define pinned (as-model "PinnedCompletionModel" configuration))
  (define endpoint (as-model "Endpoint" configuration (as-get "env") #t))
  (define source (hash-ref message "source"))
  (define payload (hash-ref message "payload"))
  (unless (and (hash? source) (hash-contains? source "Cli") (json-null? payload))
    (when (and (hash? source) (hash-contains? source "Cli")) (as-send (hash "BlockCliPipeInput" (hash-ref source "Cli"))))
    (define text (if (json-null? payload) "" payload))
    (define within (as-model "CompletionSize" text))
    (define parsed (and (hash-contains? within "Ok") (as-model "CompletionRequest" text)))
    (define request (and parsed (as-field parsed "Ok" #f)))
    (define request-id (if request (hash-ref request "request_id")
        (as-safe (lambda () (define value (yinz-json-parse text)) (define id (as-field value "request_id" "")) (if (string? id) id "")) "")))
    (define validation (and request (as-model "CompletionValidate" request)))
    (define mine (length (filter (lambda (pending) (equal? (hash-ref pending "source") source)) (as-map-values "completions"))))
    (define refusal (cond
        ((hash-contains? within "Err") (hash-ref within "Err"))
        ((not request) (string-append "that is not a completion request: " (hash-ref parsed "Err")))
        ((hash-contains? validation "Err") (hash-ref validation "Err"))
        ((not allowed) "agent-service is configured with plugin_completions \"false\"; no completion was made")
        ((>= (length (as-keys (as-get "completions"))) 8) "agent-service already has 8 completions in flight; try again when one finishes")
        ((>= mine 2) "one caller may have 2 completions in flight at a time")
        ((json-null? endpoint) "agent-service has no API key configured; set OPENAI_API_KEY or point api_key_env at the variable that holds one")
        (else #f)))
    (if refusal (answer source (as-model "CompletionError" request-id refusal))
      (begin
        (define model (if (as-present? pinned) pinned (if (as-present? (hash-ref request "model")) (hash-ref request "model") (hash-ref endpoint "model"))))
        (as-set! "completion-seq" (+ 1 (as-get "completion-seq")))
        (define id (as-get "completion-seq"))
        (as-map-set! "completions" id (hash "source" source "request_id" request-id "ticks" 0))
        (as-send (hash "WebRequest" (list (hash-ref endpoint "url") "Post" (hash-ref endpoint "headers")
              (as-model "CompletionBody" request model) (hash "complete_id" (number->string id)) json-null json-null)))))))
(define (finish status body context)
  (define id (and (as-field context "complete_id" #f) (string->number (hash-ref context "complete_id"))))
  (define pending (and id (as-map-get "completions" id #f)))
  (when pending
    (as-map-remove! "completions" id)
    (answer (hash-ref pending "source") (as-model "CompletionParse" status body (hash-ref pending "request_id")))))
(define (age)
  (for-each (lambda (id)
      (define pending (as-map-get "completions" id #f))
      (define ticks (+ 1 (hash-ref pending "ticks")))
      (if (> ticks 24)
        (begin (as-map-remove! "completions" id) (answer (hash-ref pending "source") (as-model "CompletionError" (hash-ref pending "request_id") "no answer from the model in time")))
        (as-map-set! "completions" id (hash-insert pending "ticks" ticks)))) (as-sorted-ids (as-get "completions"))))
(as-register! "complete" complete)
(as-register! "finish-completion" finish)
(as-register! "age-completions" age)
