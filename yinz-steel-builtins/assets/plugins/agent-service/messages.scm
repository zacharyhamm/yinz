(require "./state.scm")
(provide message-capture message-flush stop-event-id stop-duplicates? append-entry)
(define (bytes text) (length (bytes->list (string->bytes text))))
(define (identity turn source) (string-append "message:" (yinz-json-string (list turn source))))
(define (fallback turn text) (and (as-present? turn) (not (equal? turn "")) (string-append "stop:" (yinz-json-string (list turn (trim text))))))
(define (stop-event-id event text)
  (and (equal? (hash-ref event "hook_event_name") "Stop") (not (as-present? (hash-ref event "agent_id"))) (fallback (as-field event "turn_id" json-null) text)))
(define (entry-exists? run id) (as-find (lambda (entry) (equal? (as-field entry "event_id" json-null) id)) (hash-ref run "entries")))
(define (append-entry run kind text id tool now)
  (define revision (+ 1 (hash-ref run "revision")))
  (define entry (hash "revision" revision "event_id" (if id id json-null) "kind" kind "text" text "created_at_ms" now))
  (hash-insert (hash-insert run "revision" revision) "entries" (append (hash-ref run "entries")
      (list (if (as-present? tool) (hash-insert entry "tool" tool) entry)))))
(define (push run id text turn incomplete now)
  (define clean (as-model "TextSanitize" text))
  (define fallback-id (and (not incomplete) (fallback turn clean)))
  (cond ((entry-exists? run id) run)
    ((and fallback-id (as-find (lambda (entry) (and (equal? (hash-ref entry "kind") "result") (equal? (as-field entry "event_id" json-null) fallback-id))) (hash-ref run "entries"))) run)
    (else
      (define output (if incomplete (string-append clean "\n[incomplete message: missing or truncated content]") clean))
      (if (equal? (trim output) "") run (append-entry run "message" output id json-null now)))))
(define (flush-assembly run key assembly now force)
  (define values (yinz-json-parse key))
  (define batches (hash-ref assembly "batches"))
  (push run (identity (cadr values) (caddr values))
    (apply string-append (map (lambda (index) (hash-ref batches (number->string index))) (as-sorted-ids batches)))
    (if force json-null (hash-ref assembly "turn"))
    (or force (hash-ref assembly "incomplete")) now))
(define (message-flush pane-id run now)
  (define pending (as-map-get "pending-messages" pane-id (hash)))
  (as-map-remove! "pending-messages" pane-id)
  (foldl (lambda (key run) (flush-assembly run key (hash-ref pending key) now #t)) run (as-keys pending)))
(define (message-capture pane-id original event now)
  (define run original)
  (when (as-field event "messages_omitted" #f)
    (set! run (push run (string-append "omitted:" (yinz-json-string (list (hash-ref event "session_id") (as-field event "turn_id" json-null))))
        "[earlier assistant content omitted from bounded hook payload]" json-null #f now)))
  (for-each (lambda (message)
      (set! run (push run (identity (hash-ref message "turn_id") (hash-ref message "source_id")) (hash-ref message "text")
          (if (json-null? (hash-ref event "agent_id")) (hash-ref message "turn_id") json-null) (hash-ref message "incomplete") now))) (as-field event "assistant_messages" '()))
  (when (and (equal? (hash-ref event "hook_event_name") "SubagentStop")
      (not (equal? (as-field event "agent_type" json-null) "")) (as-present? (hash-ref event "last_assistant_message")))
    (define agent (if (as-present? (hash-ref event "agent_id")) (hash-ref event "agent_id") "unknown"))
    (define turn (if (as-present? (as-field event "turn_id" json-null)) (as-field event "turn_id" json-null) ""))
    (set! run (push run (string-append "subagent:" (yinz-json-string (list (hash-ref event "session_id") turn agent)))
        (string-append "Subagent " agent ":\n" (hash-ref event "last_assistant_message")) json-null #f now)))
  (when (equal? (hash-ref event "hook_event_name") "MessageDisplay")
    (define turn (as-field event "turn_id" json-null)) (define message (as-field event "message_id" json-null))
    (define index (as-field event "index" json-null)) (define final (as-field event "final" json-null)) (define delta (as-field event "delta" json-null))
    (when (and (as-present? turn) (as-present? message) (as-present? index) (not (json-null? final)) (as-present? delta)
        (not (equal? turn "")) (not (equal? message "")) (not (equal? (hash-ref event "session_id") "")))
      (define source (string-append (hash-ref event "session_id") ":" message))
      (define key (yinz-json-string (list (hash-ref event "session_id") turn source)))
      (unless (entry-exists? run (identity turn source))
        (define pending (as-map-get "pending-messages" pane-id (hash)))
        (define assembly (as-field pending key (hash "batches" (hash) "final" json-null "bytes" 0 "incomplete" #f "turn" (if (json-null? (hash-ref event "agent_id")) turn json-null))))
        (when final
          (when (and (as-present? (hash-ref assembly "final")) (not (= index (hash-ref assembly "final")))) (set! assembly (hash-insert assembly "incomplete" #t)))
          (set! assembly (hash-insert assembly "final" index)))
        (when (as-field event "message_incomplete" #f) (set! assembly (hash-insert assembly "incomplete" #t)))
        (define batches (hash-ref assembly "batches"))
        (define overflow #f)
        (unless (hash-contains? batches (number->string index))
          (define kept (as-model "TruncateBytes" delta (max 0 (- 1048576 (hash-ref assembly "bytes")))))
          (set! overflow (or (< (bytes kept) (bytes delta)) (>= (length (as-keys batches)) 16384)))
          (when overflow (set! assembly (hash-insert assembly "incomplete" #t)))
          (when (< (length (as-keys batches)) 16384)
            (set! batches (hash-insert batches (number->string index) kept))
            (set! assembly (hash-insert (hash-insert assembly "batches" batches) "bytes" (+ (hash-ref assembly "bytes") (bytes kept))))))
        (define last (hash-ref assembly "final"))
        (define complete (and (as-present? last) (= (+ last 1) (length (as-keys batches))) (equal? (as-sorted-ids batches) (range 0 (+ last 1)))))
        (if (or complete overflow)
          (begin
            (set! run (flush-assembly run key (if complete assembly (hash-insert assembly "incomplete" #t)) now #f))
            (as-map-set! "pending-messages" pane-id (hash-remove pending key)))
          (as-map-set! "pending-messages" pane-id (hash-insert pending key assembly))))))
  run)
(define (stop-duplicates? run event text)
  (and (equal? (hash-ref event "hook_event_name") "Stop") (json-null? (hash-ref event "agent_id"))
    (let loop ((entries (reverse (hash-ref run "entries"))))
      (cond ((null? entries) #f)
        ((member (hash-ref (car entries) "kind") '("prompt" "result")) #f)
        (else
          (define entry (car entries)) (define id (as-field entry "event_id" json-null))
          (define identity (and (string? id) (starts-with? id "message:")
              (as-safe (lambda () (yinz-json-parse (substring id 8 (string-length id)))) #f)))
          (if identity
            (and (as-present? (as-field event "turn_id" json-null)) (not (equal? (as-field event "turn_id" json-null) ""))
              (equal? (as-field event "turn_id" json-null) (car identity)) (equal? (trim (hash-ref entry "text")) text))
            (loop (cdr entries))))))))
