(require "./state.scm")
(require "./messages.scm")

(define (dirty run) (as-map-set! "dirty-runs" (hash-ref run "id") run) run)
(define (publish-id pane-id id) (as-send (hash "SetPaneAgentRun" (hash "pane_id" (hash "Terminal" pane-id) "run_id" id))))
(define (hydrate runs)
  (if (null? runs) runs
    (as-safe (lambda ()
        (define rows (yinz-data-fetch-all "shared:yinz" (as-model "EntriesRequest" (map (lambda (run) (hash-ref run "id")) runs))))
        (define grouped (as-model "EntriesFromRows" rows))
        (map (lambda (run)
            (define id (hash-ref run "id"))
            (define entries (as-field grouped id #f))
            (if entries
              (begin (when (pair? entries) (as-map-set! "persisted" id (hash-ref (car (reverse entries)) "revision")))
                (hash-insert run "entries" entries)) run)) runs)) runs)))
(define (stored-run id)
  (as-safe (lambda ()
      (define runs (hydrate (as-model "RunsFromRows" (as-fetch (as-model "RunByIdRequest" id)))))
      (and (pair? runs) (car runs))) #f))
(define (load-run id)
  (or (as-map-get "dirty-runs" id #f)
    (as-find (lambda (run) (equal? (hash-ref run "id") id)) (as-map-values "runs"))
    (stored-run id)))
(define (restore-runs)
  (as-safe (lambda ()
      (define rows (as-fetch (hash-insert (as-model "ActiveRunsRequest" (as-owner)) "limit" 1000)))
      (define runs (hydrate (as-model "ClaimRuns" (as-model "RunsFromRows" rows) (as-owner))))
      (for-each (lambda (run)
          (define pane-id (hash-ref run "pane_id"))
          (unless (as-map-get "runs" pane-id #f)
            (as-map-set! "runs" pane-id run)
            (publish-id pane-id (hash-ref run "id"))
            (as-set! "run-lookups" (as-unique (cons pane-id (as-get "run-lookups")))))) runs)) #f))
(define (adopt-run id run)
  (as-map-remove! "predecessors" id)
  (as-set! "observed-runs" (filter (lambda (other) (not (= id other))) (as-get "observed-runs")))
  (as-map-remove! "released-runs" (hash-ref run "id"))
  (dirty run) (publish-id id (hash-ref run "id"))
  (when (as-present? (hash-ref run "summary")) (as-map-set! "summaries" id (hash-ref run "summary")))
  (as-map-set! "runs" id run))
(define (adopt-stored id kind session)
  (when (and (not (equal? (trim session) "")) (not (equal? (as-get "session") "")))
    (as-set! "run-lookups" (as-unique (cons id (as-get "run-lookups"))))
    (define run (load-run (string-append kind ":" (trim session))))
    (when run (adopt-run id (as-model "AdoptRun" run id (as-owner))))))
(define (adopt-arrived)
  (unless (equal? (as-get "session") "")
    (for-each (lambda (pane)
        (define id (hash-ref pane "pane_id"))
        (define agent (hash-ref pane "agent"))
        (when (and (not (as-map-get "runs" id #f)) (not (member id (as-get "run-lookups")))
            (as-present? agent))
          (define run-id (as-model "StoredRunId" agent))
          (when (as-present? run-id)
            (as-set! "run-lookups" (as-unique (cons id (as-get "run-lookups"))))
            (define run (stored-run run-id))
            (when run (adopt-run id (as-model "AdoptRun" run id (as-owner))))))) (as-panes))))
(define (relocated run id)
  (hash-insert (hash-insert run "host" (as-map-get "hosts" id json-null)) "bubblewrap" (as-map-get "bubblewrap" id json-null)))
(define (relocate-run id)
  (define old (as-map-get "runs" id #f))
  (when old (define run (relocated old id)) (unless (equal? run old) (as-map-set! "runs" id (dirty run)))))
(define (finish-run id outcome now)
  (define old (as-map-get "runs" id #f))
  (when old
    (as-map-remove! "runs" id)
    (define released (equal? outcome "Released"))
    (define run (if released old (message-flush id old now)))
    (as-map-remove! "pending-messages" id)
    (when (and (member id (as-get "observed-runs")) (not released))
      (as-map-set! "predecessors" id (list (hash "host_id" (hash-ref run "host_id") "yinz_session_name" (hash-ref run "yinz_session_name")) (as-model "RunHeader" run))))
    (as-set! "observed-runs" (filter (lambda (other) (not (= id other))) (as-get "observed-runs")))
    (set! run (hash-insert (hash-insert run "outcome" (if released "closed" (string-downcase outcome))) "ended_at_ms" now))
    (if released (as-map-set! "released-runs" (hash-ref run "id") #t)
      (as-set! "finished-runs" (append (as-get "finished-runs") (list (hash-ref run "id")))))
    (dirty run) (publish-id id json-null)))
(define (persist)
  (unless (or (equal? (as-get "session") "") (null? (as-keys (as-get "dirty-runs"))))
    (define mutations '()) (define written (hash))
    (for-each (lambda (run)
        (define id (hash-ref run "id"))
        (set! mutations (append mutations (list (if (as-map-get "released-runs" id #f) (as-model "RunOwnedMutation" run (as-owner)) (as-model "RunMutation" run)))))
        (define previous (as-map-get "persisted" id 0))
        (for-each (lambda (entry)
            (when (> (hash-ref entry "revision") previous)
              (set! mutations (append mutations (list (as-model "EntryMutation" id (hash-ref run "host_id") entry)))))) (hash-ref run "entries"))
        (when (pair? (hash-ref run "entries"))
          (set! written (hash-insert written id (max previous (hash-ref (car (reverse (hash-ref run "entries"))) "revision")))))) (as-map-values "dirty-runs"))
    (when (as-safe (lambda () (yinz-data-apply "shared:yinz" mutations) #t) #f)
      (for-each (lambda (id) (as-map-set! "persisted" id (hash-ref written id))) (as-keys written))
      (define live (map (lambda (run) (hash-ref run "id")) (as-map-values "runs")))
      (as-map-prune! "persisted" (lambda (id value) (member id live)))
      (as-set! "dirty-runs" (hash)) (as-set! "released-runs" (hash)))))
(define (drain)
  (define finished (as-get "finished-runs")) (as-set! "finished-runs" '())
  (for-each (lambda (id) (as-call "summarize-run" id)) finished))
(define (same-owner run)
  (and (equal? (hash-ref run "host_id") (as-get "host")) (equal? (hash-ref run "yinz_session_name") (as-get "session"))))
(define (new-run id kind event now)
  (hash "id" (as-model "RunId" kind id (hash-ref event "session_id") now (as-get "host")) "pane_id" id
    "yinz_session_name" (as-get "session") "host_id" (as-get "host") "origin_run_id" json-null "previous_run_id" json-null
    "session_id" (hash-ref event "session_id") "kind" kind "cwd" (hash-ref event "cwd") "host" (as-map-get "hosts" id json-null)
    "bubblewrap" (as-map-get "bubblewrap" id json-null) "started_at_ms" now "ended_at_ms" json-null "outcome" "active"
    "revision" 0 "summarized_revision" 0 "summary" json-null "entries" '()))
(define (record-event id kind event now)
  (define name (hash-ref event "hook_event_name"))
  (define session (hash-ref event "session_id"))
  (define old (as-map-get "runs" id #f))
  (define changed-session (and old (or (not (equal? kind (hash-ref old "kind")))
        (and (not (equal? session "")) (not (equal? (hash-ref old "session_id") "")) (not (equal? session (hash-ref old "session_id")))))))
  (cond
    ((and changed-session (equal? name "SessionEnd"))
      (unless (equal? session "")
        (define run (load-run (string-append kind ":" (trim session))))
        (when (and run (same-owner run))
          ;; A stale end can contribute captured prose, but cannot close the replacement.
          (define before (as-map-get "pending-messages" id #f))
          (as-map-remove! "pending-messages" id)
          (define captured (message-capture id run event now))
          (if before (as-map-set! "pending-messages" id before) (as-map-remove! "pending-messages" id))
          (unless (equal? captured run) (dirty captured) (as-set! "finished-runs" (append (as-get "finished-runs") (list (hash-ref run "id"))))))))
    (else
      (when changed-session (finish-run id "Replaced" now))
      (when (and (equal? name "SessionStart") (not (equal? (hash-ref event "source") "clear"))) (as-map-remove! "predecessors" id))
      (define forbidden #f)
      (when (and (equal? name "SessionEnd") (not (as-map-get "runs" id #f)) (not (equal? session "")))
        (define run (load-run (string-append kind ":" (trim session))))
        (when run (if (same-owner run) (as-map-set! "runs" id run) (set! forbidden #t))))
      (unless (or forbidden (equal? name "SessionEnd") (as-map-get "runs" id #f)) (adopt-stored id kind session))
      (unless (or forbidden (and (equal? name "SessionEnd") (not (as-map-get "runs" id #f)) (null? (as-field event "assistant_messages" '()))))
        (define old (as-map-get "runs" id #f))
        (define new? (not old))
        (define run (or old (new-run id kind event now)))
        (define already-ended (not (equal? (hash-ref run "outcome") "active")))
        (define predecessor (as-map-get "predecessors" id #f))
        (when (and (equal? name "SessionStart") (equal? (hash-ref event "source") "clear")
            (json-null? (as-field run "origin_run_id" json-null)) (json-null? (as-field run "previous_run_id" json-null)) predecessor
            (not (equal? (as-get "session") "")) (equal? (car predecessor) (as-owner)))
          (define previous (cadr predecessor))
          (when (and (equal? kind (hash-ref previous "kind")) (not (equal? session ""))
              (not (equal? (hash-ref previous "session_id") "")) (not (equal? (hash-ref previous "id") (hash-ref run "id")))
              (not (equal? (as-field previous "origin_run_id" json-null) (hash-ref run "id"))))
            (set! run (hash-insert (hash-insert run "previous_run_id" (hash-ref previous "id")) "origin_run_id"
                (if (as-present? (as-field previous "origin_run_id" json-null)) (as-field previous "origin_run_id" json-null) (hash-ref previous "id"))))))
        (unless (equal? name "SessionEnd") (as-set! "observed-runs" (as-unique (cons id (as-get "observed-runs")))))
        (when (and (not (equal? session "")) (equal? (hash-ref run "session_id") "")) (set! run (hash-insert run "session_id" session)))
        (when (and (as-present? (hash-ref event "cwd")) (not (equal? (hash-ref event "cwd") ""))) (set! run (hash-insert run "cwd" (hash-ref event "cwd"))))
        (set! run (message-capture id (relocated run id) event now))
        (define tool (as-field event "tool_capture" json-null))
        (when (as-present? tool)
          (define entry (as-model "ToolEntry" tool))
          (unless (and (as-present? (car entry)) (as-find (lambda (old) (equal? (as-field old "event_id" json-null) (car entry))) (hash-ref run "entries")))
            (set! run (append-entry run (caddr entry) (cadr entry) (car entry) tool now))))
        (define prose event)
        (when (as-present? tool)
          (when (or (hash-ref tool "metadata_redacted") (hash-ref tool "metadata_truncated")) (set! prose (hash-insert prose "tool_use_id" (hash-ref tool "identity"))))
          (define arguments (as-field tool "arguments" json-null))
          (when (as-present? arguments)
            (define text (hash-ref arguments "text"))
            (set! prose (hash-insert prose "tool_input" (as-safe (lambda () (yinz-json-parse text)) (hash "plan" text "questions" (list (hash "question" text))))))))
        (define entry (as-model "RunEntry" prose))
        (when (as-present? entry)
          (define entry-kind (car entry)) (define text (cadr entry))
          (define event-id (or (stop-event-id event text) (as-model "RunEventId" prose text)))
          (define duplicate (or (stop-duplicates? run event text)
              (if (as-present? event-id)
                (as-find (lambda (old) (equal? (as-model "EntryEventId" old) event-id)) (hash-ref run "entries"))
                (and (pair? (hash-ref run "entries"))
                  (let ((last (car (reverse (hash-ref run "entries"))))) (and (equal? (hash-ref last "kind") entry-kind) (equal? (hash-ref last "text") text)))))))
          (unless duplicate (set! run (append-entry run entry-kind text event-id json-null now))))
        (as-map-set! "runs" id run)
        (define changed (or new? (not (equal? run old))))
        (when changed (dirty run) (when new? (publish-id id (hash-ref run "id"))))
        (when (equal? name "SessionEnd")
          (if (and already-ended (not changed)) (begin (as-map-remove! "runs" id) (as-map-remove! "pending-messages" id))
            (finish-run id "Completed" now)))))))
(as-register! "load-run" load-run)
(as-register! "restore-runs" restore-runs)
(as-register! "adopt-arrived-runs" adopt-arrived)
(as-register! "relocate-run" relocate-run)
(as-register! "finish-run" finish-run)
(as-register! "persist" persist)
(as-register! "drain" drain)
(as-register! "record-event" record-event)
