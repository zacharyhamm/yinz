(require "./state.scm")
(define (projects-model op . args) (yinz-agent-model "projects" op args))
(define (text args name)
  (define value (as-field args name #f))
  (unless (string? value) (error (string-append name " is required"))) value)
(define (number args name maximum)
  (define value (as-field args name #f))
  (unless (and (integer? value) (>= value 0) (<= value maximum)) (error (string-append name " is required"))) value)
(define (parse-pane value label)
  (define parsed (as-model "PaneId" value))
  (if (hash-contains? parsed "Ok") (hash-ref parsed "Ok") (error (string-append label (hash-ref parsed "Err")))))
(define (pane-id info) (hash (if (hash-ref info "is_plugin") "Plugin" "Terminal") (hash-ref info "id")))
(define (all-infos) (apply append (map (lambda (tab) (hash-ref (hash-ref (as-get "manifest") "panes") tab)) (as-keys (hash-ref (as-get "manifest") "panes")))))
(define (find-info id) (as-find (lambda (info) (equal? (pane-id info) id)) (all-infos)))
(define (prune-assignments tabs)
  (define closed (map (lambda (tab) (hash-ref tab "tab_id")) (filter (lambda (old)
          (not (as-find (lambda (tab) (= (hash-ref tab "tab_id") (hash-ref old "tab_id"))) tabs))) (as-get "tabs"))))
  (unless (null? closed)
    (yinz-data-apply "shared:yinz" (list (hash "Delete" (hash "entity" "agent_assignment" "filter"
            (hash "And" (list (hash "Eq" (list "host_id" (hash "Text" (as-get "host"))))
                (hash "Eq" (list "yinz_session_name" (hash "Text" (as-get "session"))))
                (hash "In" (list "tab_id" (map (lambda (id) (hash "Int" id)) closed)))))))))
    (for-each (lambda (id) (as-map-remove! "assignments" id)) closed)))
(define (operation op args caller)
  (define snapshot (as-send "GetSessionList"))
  (define session (as-find (lambda (session) (hash-ref session "is_current_session")) (hash-ref snapshot "live_sessions")))
  (unless session (error "current session is unavailable"))
  (unless (as-get "bootstrapped") (as-bootstrap!))
  (define project-rows (as-fetch (as-entity-request "project")))
  (when (hash-ref project-rows "truncated") (error "project registry is incomplete"))
  (define registry (projects-model "FromRows" project-rows))
  (define panes (as-all-panes))
  (define explicit (as-field args "pane_id" #f))
  (define selected (cond ((and (integer? explicit) (>= explicit 0) (<= explicit 4294967295)) explicit)
      ((and (equal? op "context") (hash? caller) (hash-contains? caller "Terminal")) (hash-ref caller "Terminal")) (else #f)))
  (when selected
    (define info (as-send (hash "GetPaneInfo" (hash "Terminal" selected))))
    (unless (as-present? info) (error "terminal pane is unavailable"))
    (define previous (as-find (lambda (pane) (= selected (hash-ref pane "pane_id"))) panes))
    (define live (hash-insert (as-model "AgentPane" info (if previous (hash-ref previous "tab") json-null)) "detected" (as-map-get "latched" selected json-null)))
    (set! panes (if previous (map (lambda (pane) (if (= selected (hash-ref pane "pane_id")) live pane)) panes) (append panes (list live)))))
  (define owners (foldl (lambda (pane result)
        (define tab (hash-ref pane "tab"))
        (define assigned (and (as-present? tab) (as-map-get "assignments" (car tab) #f)))
        (define location (as-model "PaneCheckoutLocation" pane))
        (define project (or assigned (and (as-present? location) (projects-model "LabelForCwd" (as-get "repositories") registry location))))
        (if (as-present? project) (hash-insert result (number->string (hash-ref pane "pane_id")) project) result)) (hash) panes))
  (cond
    ((equal? op "context")
      (define pane (and selected (as-find (lambda (pane) (= selected (hash-ref pane "pane_id"))) panes)))
      (when (and selected (not pane)) (error "selected caller pane does not exist"))
      (define tab (and pane (hash-ref pane "tab")))
      (define tab-id (if (as-present? tab) (car tab) json-null))
      (define project (or (and (as-present? tab-id) (as-map-get "assignments" tab-id #f))
          (and pane (as-field owners (number->string (hash-ref pane "pane_id")) #f))))
      (define services (foldl (lambda (name result) (hash-insert result name
              (filter (lambda (id) (equal? (hash-ref (hash-ref (hash-ref session "plugins") (number->string id)) "location") (string-append "yinz:" name)))
                (as-sorted-ids (hash-ref session "plugins"))))) (hash) '("agent-service" "project-store")))
      (define missing (append (if pane '() '("caller_pane")) (if (as-present? project) '() '("project"))
          (filter (lambda (name) (null? (hash-ref services name))) (as-keys services))))
      (hash "host_id" (as-get "host") "session" (hash-ref session "name") "pane" (if pane (as-model "DisplayedPane" pane) json-null)
        "tab_id" tab-id "project" (if (as-present? project) project json-null)
        "root" (if (and (as-present? project) (hash-contains? registry project)) (hash-ref (hash-ref registry project) "root") json-null)
        "services" services "missing" missing "ambiguous" (filter (lambda (name) (> (length (hash-ref services name)) 1)) (as-keys services))
        "pane_candidates" (map (lambda (pane) (as-model "DisplayedPane" pane)) panes)
        "projects" (map (lambda (name) (hash-ref registry name)) (as-keys registry))))
    ((equal? op "agent_register")
      (define id (number args "pane_id" 4294967295)) (define kind (text args "kind"))
      (unless (as-model "ValidKind" kind) (error "kind must be 1 to 32 characters of a-z, 0-9, _ or -"))
      (define pane (as-find (lambda (pane) (= id (hash-ref pane "pane_id"))) panes))
      (unless pane (error "terminal pane is unavailable"))
      (yinz-data-apply "shared:yinz" (list (as-model "LatchMutation" (as-owner) id kind)))
      (as-map-set! "manual" id kind)
      (as-send (hash "SetPaneAgent" (hash "pane_id" (hash "Terminal" id) "agent" (as-model "RegisteredAgent" kind (hash-ref pane "cwd")))))
      (as-publish! #t) (hash "pane_id" id "kind" kind))
    ((member op '("project_assign" "project_open"))
      (define name (text args "project")) (define project (as-field registry name #f))
      (unless project (error "unknown project; use project-remember first"))
      (define tab (if (equal? op "project_open")
          (let ((tab (as-send (hash "NewTab" (hash "name" (as-field args "tab_name" name) "cwd" (hash-ref project "root"))))))
            (unless (as-present? tab) (error "could not open project tab")) tab)
          (let ((tab (number args "tab_id" 4294967295)))
            (unless (as-find (lambda (value) (= tab (hash-ref value "tab_id"))) (as-get "tabs")) (error "tab is unavailable")) tab)))
      (define ids (projects-model "RowIds" project-rows))
      (define project-id (as-field ids name #f)) (unless project-id (error "project disappeared"))
      (yinz-data-apply "shared:yinz" (list (hash "Put" (hash "entity" "agent_assignment"
              "uid" (yinz-json-string (list (as-get "host") (hash-ref session "name") tab)) "expect_rev" json-null
              "values" (list (list "host_id" (hash "Text" (as-get "host"))) (list "yinz_session_name" (hash "Text" (hash-ref session "name")))
                (list "tab_id" (hash "Int" tab)) (list "project" (hash "Text" name)) (list "project_id" (hash "Int" project-id)))))))
      (as-map-set! "assignments" tab name) (as-publish! #t) (hash "tab_id" tab "project" name))
    ((member op '("project_config_read" "project_config_write"))
      (define project (as-field registry (text args "project") #f))
      (unless project (error "unknown project; use project-list"))
      (if (equal? op "project_config_read") (as-send (hash "ProjectConfigRead" (hash "directory" (hash-ref project "root"))))
        (begin
          (unless (hash-contains? args "expected") (error "expected source is required (null for an absent file)"))
          (define expected (hash-ref args "expected"))
          (unless (or (json-null? expected) (string? expected)) (error "expected must be a string or null"))
          (as-send (hash "ProjectConfigWrite" (hash "directory" (hash-ref project "root") "source" (text args "source") "expected" expected))))))
    ((equal? op "plugin_reload")
      (define url (text args "url")) (define running (as-send (hash "GetPluginIdsForUrl" url)))
      (if (null? running) (as-send (hash "LoadNewPlugin" (hash "url" url "config" (hash) "load_in_background" #t "skip_plugin_cache" #t)))
        (for-each (lambda (id) (as-send (hash "ReloadPlugin" id))) running))
      (hash "url" url "reloaded" running "dispatched" #t))
    ((equal? op "pane_rerun")
      (define id (number args "pane_id" 4294967295))
      (define info (as-send (hash "GetPaneInfo" (hash "Terminal" id))))
      (unless (as-present? info) (error "terminal pane is unavailable"))
      (unless (hash-ref info "is_held") (error "pane is not a held command"))
      (when (as-present? (hash-ref info "restart_error")) (error (hash-ref info "restart_error")))
      (as-send (hash "RerunCommandPane" id)) (hash "pane_id" id "dispatched" #t))
    ((equal? op "pane_move_to_tab")
      (define pane (parse-pane (text args "pane_id") "invalid pane: "))
      (unless (find-info pane) (error "pane is unavailable"))
      (define tab (number args "tab_id" 18446744073709551615))
      (unless (as-find (lambda (value) (= tab (hash-ref value "tab_id"))) (as-get "tabs")) (error "tab is unavailable"))
      (define result (as-send (hash "BreakPanesToTabWithId" (list (list pane) tab #f))))
      (unless (as-present? result) (error "could not move pane to tab")) (hash "pane_id" pane "tab_id" result))
    ((equal? op "pane_swap")
      (define first (parse-pane (text args "first") "invalid first pane: ")) (define second (parse-pane (text args "second") "invalid second pane: "))
      (define positions (apply append (map (lambda (tab)
              (map (lambda (pane) (hash "id" (pane-id pane) "tab_position" (hash-ref tab "position")
                    "x" (hash-ref pane "pane_x") "y" (hash-ref pane "pane_y") "columns" (hash-ref pane "pane_columns") "rows" (hash-ref pane "pane_rows")
                    "visible" (not (hash-ref pane "is_suppressed")) "selectable" (hash-ref pane "is_selectable") "floating" (hash-ref pane "is_floating")
                    "fullscreen" (hash-ref tab "is_fullscreen_active") "floating_layer_visible" (hash-ref tab "are_floating_panes_visible")))
                (as-field (hash-ref (as-get "manifest") "panes") (number->string (hash-ref tab "position")) '()))) (as-get "tabs"))))
      (define direction (as-result (as-model "PlanSwap" positions first second)))
      (as-send (hash "MovePaneWithPaneIdInDirection" (list first direction)))
      (hash "first" first "second" second "dispatched" #t))
    ((member op '("pane_pin" "pane_unpin"))
      (define pane (parse-pane (text args "pane_id") "invalid pane ID: ")) (define info (find-info pane))
      (unless info (error "pane is unavailable")) (unless (hash-ref info "is_floating") (error "only floating panes can be pinned"))
      (as-send (hash "SetFloatingPanePinned" (list pane (equal? op "pane_pin")))) (hash "pane_id" pane "dispatched" #t))
    (else (error (string-append "unknown agent operation " op)))))
(as-register! "operation" operation)
(as-register! "prune-assignments" prune-assignments)
