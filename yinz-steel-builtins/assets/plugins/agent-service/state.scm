(provide as-get as-set! as-field as-present? as-find as-model as-register! as-call
  as-map-get as-map-set! as-map-remove! as-map-prune! as-map-values as-keys as-unique
  as-all-panes as-panes as-pane as-owner as-entity-request as-owned-request as-fetch
  as-safe as-log-safe as-send as-message as-result as-record-cwd! as-rejoin! as-update-pane!
  as-settle-latches! as-forget! as-reset! as-row-value as-restore-metadata!
  as-set-session! as-bootstrap! as-rebuild! as-publish! as-classify as-kind
  as-location as-locations as-agent-locations as-sorted-ids as-take)

;; Every mutable service fact belongs to this interpreter. Other modules register guest functions.
(define state (vector (hash)))
(define handlers (vector (hash)))
(define (as-field value key fallback)
  (if (and (hash? value) (hash-contains? value key)) (hash-ref value key) fallback))
(define (as-present? value) (and value (not (json-null? value))))
(define (as-get key) (hash-ref (vector-ref state 0) key))
(define (as-set! key value) (vector-set! state 0 (hash-insert (vector-ref state 0) key value)))
(define (as-register! name procedure) (vector-set! handlers 0 (hash-insert (vector-ref handlers 0) name procedure)))
(define (as-call name . args) (apply (hash-ref (vector-ref handlers 0) name) args))
(define (as-find predicate values)
  (cond ((null? values) #f) ((predicate (car values)) (car values)) (else (as-find predicate (cdr values)))))
(define (as-take values count) (take values (min count (length values))))
(define (as-unique values)
  (define seen (hash))
  (reverse (foldl (lambda (value result)
        (if (hash-contains? seen value) result
          (begin (set! seen (hash-insert seen value #t)) (cons value result)))) '() values)))
(define (as-keys value) (sort (hash-keys->list value) string<?))
(define (as-sorted-ids value) (sort (map string->number (hash-keys->list value)) <))
(define (as-map-get name key fallback) (as-field (as-get name) (if (number? key) (number->string key) key) fallback))
(define (as-map-set! name key value) (as-set! name (hash-insert (as-get name) (if (number? key) (number->string key) key) value)))
(define (as-map-remove! name key) (as-set! name (hash-remove (as-get name) (if (number? key) (number->string key) key))))
(define (as-map-prune! name predicate)
  (as-set! name (foldl (lambda (key result) (if (predicate key (hash-ref (as-get name) key))
          result (hash-remove result key))) (as-get name) (as-keys (as-get name)))))
(define (as-map-values name) (map (lambda (key) (hash-ref (as-get name) key)) (as-keys (as-get name))))
(define (as-model name . args)
  (yinz-agent-model "providers" "WithSnapshot" (list (as-get "providers") "agents" name args)))
(define (as-panes) (if (json-null? (as-get "panes")) '() (as-get "panes")))
(define (as-all-panes) (append (as-panes) (as-get "suppressed")))
(define (as-pane id) (as-find (lambda (pane) (= (hash-ref pane "pane_id") id)) (as-all-panes)))
(define (as-classify pane) (as-model "Classify" pane (as-get "manual")))
(define (as-kind command) (if (as-present? command) (as-model "KindFromCommand" command) json-null))
(define (as-owner) (hash "host_id" (as-get "host") "yinz_session_name" (as-get "session")))
(define (as-entity-request entity)
  (hash-insert (yinz-agent-model "store" "EntityRequest" entity) "limit" (yinz-agent-model "store" "FetchLimit" json-null)))
(define (as-owned-request entity)
  (hash-insert (yinz-agent-model "store" "OwnedRowsRequest" (hash-insert (as-owner) "entity" entity)) "limit" (yinz-agent-model "store" "FetchLimit" json-null)))
(define (as-fetch request) (yinz-data-fetch "shared:yinz" request))
(define (as-safe thunk fallback) (with-handler (lambda (error) fallback) (thunk)))
(define (as-log-safe label thunk fallback)
  (with-handler (lambda (failure) (yinz-log (string-append "agent-service: could not " label ": " (trim (error-object-message failure)))) fallback) (thunk)))
(define (as-send command) (yinz-command command))
(define (as-result value) (if (hash-contains? value "Ok") (hash-ref value "Ok") (error (hash-ref value "Err"))))
(define (as-message name destination payload args)
  (as-send (hash "MessageToPlugin" (hash "plugin_url" json-null "destination_plugin_id" destination
        "plugin_config" (hash) "message_name" name "message_payload" payload "message_args" args
        "new_plugin_args" json-null "floating_pane_coordinates" json-null))))
(define (as-reset!)
  (vector-set! state 0 (hash "providers" '() "host" "" "session" "" "env" (hash)
      "manifest" (hash "panes" (hash)) "tabs" '() "panes" json-null "suppressed" '() "focused" json-null
      "bootstrapped" #f "watches" '() "subscribers" '() "seq" 0 "published" #f "run-headers" (hash)
      "manual" (hash) "assignments" (hash) "commands" (hash) "cwds" (hash) "hosts" (hash) "bubblewrap" (hash)
      "latched" (hash) "pending-release" '() "activity" (hash) "hooks" (hash) "event-fed" '() "prompts" (hash)
      "runs" (hash) "dirty-runs" (hash) "released-runs" (hash) "finished-runs" '() "observed-runs" '()
      "predecessors" (hash) "pending-messages" (hash) "persisted" (hash) "run-lookups" '()
      "summaries" (hash) "summary-requests" (hash) "run-summary-requests" (hash) "summary-seq" 0
      "completions" (hash) "completion-seq" 0 "project-providers" '() "published-locations" #f "repositories" (hash) "git-probes" (hash) "probe-backoff" (hash)
      "git-seq" 0 "git-elapsed" 0 "remote-cursor" 0 "command-cursor" 0 "poll-window" 7500
      "prefixes" (hash) "related" #f "arrangement-subscribers" '() "arrangement-pending" '()
      "arrangement-failed" '() "arrangement-token" json-null "arrangement-start" json-null)))
(as-reset!)
(define (as-record-cwd! id cwd)
  (define normalized (as-model "NormalizePath" cwd))
  (as-map-set! "cwds" id (as-field normalized "Ok" cwd)))
(define (as-update-pane! id transform)
  (define (update values) (map (lambda (pane) (if (= (hash-ref pane "pane_id") id) (transform pane) pane)) values))
  (unless (json-null? (as-get "panes")) (as-set! "panes" (update (as-panes))))
  (as-set! "suppressed" (update (as-get "suppressed"))))
(define (as-rejoin! name field)
  (define (join pane)
    (define value (as-map-get name (hash-ref pane "pane_id") #f))
    (if value (hash-insert pane field value) pane))
  (unless (json-null? (as-get "panes")) (as-set! "panes" (map join (as-panes))))
  (as-set! "suppressed" (map join (as-get "suppressed"))))
(define (as-settle-latches!)
  (for-each (lambda (pane)
      (define id (hash-ref pane "pane_id"))
      (define kind (as-kind (hash-ref pane "command")))
      (when (as-present? kind)
        (as-map-set! "latched" id kind)
        (as-set! "pending-release" (filter (lambda (other) (not (= other id))) (as-get "pending-release"))))) (as-panes))
  (as-set! "panes" (map (lambda (pane) (hash-insert pane "detected" (as-map-get "latched" (hash-ref pane "pane_id") json-null))) (as-panes))))
(define (as-forget! id)
  (for-each (lambda (name) (as-map-remove! name id)) '("activity" "summaries" "summary-requests" "hooks" "prompts" "predecessors"))
  (as-set! "observed-runs" (filter (lambda (other) (not (= id other))) (as-get "observed-runs")))
  (as-set! "event-fed" (filter (lambda (other) (not (= id other))) (as-get "event-fed"))))
(define (as-row-value rows row name)
  (let loop ((columns (hash-ref rows "columns")) (values row))
    (cond ((or (null? columns) (null? values)) json-null)
      ((equal? (car columns) name) (let ((value (car values))) (if (hash? value) (hash-ref value (car (hash-keys->list value))) json-null)))
      (else (loop (cdr columns) (cdr values))))))
(define (as-restore-metadata!)
  (as-log-safe "restore metadata" (lambda ()
      (define latches (as-fetch (as-owned-request "agent_latch")))
      (define assignments (as-fetch (as-owned-request "agent_assignment")))
      (define projects (as-fetch (as-entity-request "project")))
      (when (or (hash-ref latches "truncated") (hash-ref assignments "truncated") (hash-ref projects "truncated"))
        (error "metadata is incomplete; refusing to replace the current snapshot"))
      (define registry (yinz-agent-model "projects" "FromRows" (list projects)))
      (define ids (yinz-agent-model "projects" "RowIds" (list projects)))
      (define tabs (foldl (lambda (row result)
            (define tab (as-row-value assignments row "tab_id"))
            (define id (as-row-value assignments row "project_id"))
            (define matches (filter (lambda (name)
                  (or (equal? (as-field ids name json-null) id) (member id (as-field (hash-ref registry name) "replaced_ids" '())))) (as-keys registry)))
            (if (and (integer? tab) (>= tab 0) (= (length matches) 1)) (hash-insert result (number->string tab) (car matches)) result)) (hash) (hash-ref assignments "rows")))
      (as-set! "manual" (as-model "LatchesFromRows" latches))
      (as-set! "assignments" tabs)) #f))
(define (as-set-session! session)
  (unless (equal? session (as-get "session"))
    (as-set! "session" session)
    (for-each (lambda (id)
        (define run (hash-insert (hash-insert (as-map-get "runs" id #f) "host_id" (as-get "host")) "yinz_session_name" session))
        (as-map-set! "runs" id run) (as-map-set! "dirty-runs" (hash-ref run "id") run)) (as-sorted-ids (as-get "runs")))
    (for-each (lambda (id) (as-map-set! "dirty-runs" id (hash-insert (hash-insert (as-map-get "dirty-runs" id #f) "host_id" (as-get "host")) "yinz_session_name" session))) (as-keys (as-get "dirty-runs")))))
(define (as-bootstrap!)
  (define snapshot (as-safe (lambda () (as-send "GetSessionList")) #f))
  (define session (and snapshot (as-find (lambda (session) (hash-ref session "is_current_session")) (hash-ref snapshot "live_sessions"))))
  (when session
    (define manifest (hash-ref session "panes"))
    (define gathered (foldl (lambda (position result)
          (hash-insert result position (map (lambda (pane)
                (if (hash-ref pane "is_plugin") pane
                  (let* ((id (hash-ref pane "id"))
                      (command (as-safe (lambda () (as-send (hash "GetPaneRunningCommand" (hash "pane_id" (hash "Terminal" id))))) '()))
                      (cwd (as-safe (lambda () (as-send (hash "GetPaneCwd" (hash "pane_id" (hash "Terminal" id))))) json-null))
                      (pane (if (pair? command) (hash-insert pane "terminal_command" (string-join command " ")) pane)))
                    (if (as-present? cwd) (hash-insert pane "cwd" cwd) pane)))) (hash-ref (hash-ref manifest "panes") position)))) (hash) (as-keys (hash-ref manifest "panes"))))
    (as-set-session! (hash-ref session "name"))
    (as-restore-metadata!)
    (as-call "restore-runs")
    (as-set! "bootstrapped" #t)
    (for-each (lambda (panes) (for-each (lambda (pane)
            (unless (hash-ref pane "is_plugin")
              (define id (hash-ref pane "id"))
              (when (as-present? (hash-ref pane "terminal_command")) (as-map-set! "commands" id (hash-ref pane "terminal_command")))
              (when (as-present? (hash-ref pane "cwd")) (as-record-cwd! id (hash-ref pane "cwd"))))) panes)) (map (lambda (key) (hash-ref gathered key)) (as-keys gathered)))
    (when (json-null? (as-get "panes"))
      (as-set! "manifest" (hash-insert manifest "panes" gathered)) (as-set! "tabs" (hash-ref session "tabs")))
    (as-rebuild!)))
(define (as-location id)
  (define pane (as-pane id))
  (define agent (and pane (as-field pane "agent" json-null)))
  (define cwd (and (as-present? agent) (as-field agent "cwd" json-null)))
  (as-model "CheckoutLocation" (as-map-get "hosts" id json-null)
    (if (and (as-present? cwd) (not (equal? cwd ""))) cwd (as-map-get "cwds" id json-null))))
(define (as-locations)
  (filter as-present? (map as-location (sort (as-unique (append (as-sorted-ids (as-get "cwds")) (map (lambda (pane) (hash-ref pane "pane_id")) (as-all-panes)))) <))))
(define (as-agent-locations)
  (sort (as-unique (filter as-present? (map (lambda (pane) (and (as-present? (as-classify pane)) (as-location (hash-ref pane "pane_id")))) (as-panes)))) string<?))
(define (as-rebuild!)
  (define previous (foldl (lambda (pane result)
        (define id (hash-ref pane "pane_id"))
        (if (hash-contains? result id) result (hash-insert result id pane))) (hash) (as-panes)))
  (define previous-all (as-all-panes))
  (as-set! "focused" (as-model "FocusedPane" (as-get "manifest") (as-get "tabs")))
  (as-set! "panes" (as-model "TerminalPanes" (as-get "manifest") (as-get "tabs")))
  (as-set! "suppressed" (as-model "SuppressedPanes" (as-get "manifest") (as-get "tabs")))
  ;; The validated visible and suppressed views together contain every terminal pane.
  (define live (foldl (lambda (pane result) (hash-insert result (hash-ref pane "pane_id") #t)) (hash) (as-all-panes)))
  (for-each (lambda (pane)
      (define id (hash-ref pane "pane_id"))
      (for-each (lambda (pair)
          (define value (as-field pane (cadr pair) json-null))
          (if (as-present? value) (as-map-set! (car pair) id value) (as-map-remove! (car pair) id)))
        '(("hosts" "host") ("bubblewrap" "bubblewrap")))) (as-all-panes))
  (as-rejoin! "commands" "command")
  (for-each (lambda (id) (unless (hash-contains? live id) (as-call "finish-run" id "Released" (yinz-wall-clock-ms)))) (as-sorted-ids (as-get "runs")))
  (for-each (lambda (name) (as-map-prune! name (lambda (id value) (hash-contains? live (string->number id))))) '("commands" "cwds" "hosts" "bubblewrap"))
  (for-each (lambda (id) (as-call "relocate-run" id)) (as-sorted-ids (as-get "runs")))
  (define gone (filter (lambda (id) (and (as-map-get "manual" id #f) (not (hash-contains? live id)))) (map (lambda (pane) (hash-ref pane "pane_id")) previous-all)))
  (when (pair? gone)
    (as-log-safe "remove closed registrations" (lambda () (yinz-data-apply "shared:yinz" (list (as-model "LatchDeleteMutation" (as-owner) gone)))) #f)
    (for-each (lambda (id) (as-map-remove! "manual" id)) gone))
  (for-each (lambda (name) (as-map-prune! name (lambda (id value) (hash-contains? live (string->number id))))) '("latched" "hooks" "predecessors"))
  (for-each (lambda (name) (as-set! name (filter (lambda (id) (hash-contains? live id)) (as-get name)))) '("pending-release" "event-fed" "run-lookups" "observed-runs"))
  (for-each (lambda (pane)
      (define id (hash-ref pane "pane_id"))
      (define old (as-field previous id #f))
      (unless (equal? (hash-ref pane "status") "Running")
        (as-set! "observed-runs" (filter (lambda (other) (not (= id other))) (as-get "observed-runs")))
        (as-map-remove! "predecessors" id))
      (when (and (equal? (hash-ref pane "status") "Running") old (not (equal? (hash-ref old "status") "Running")))
        (as-map-remove! "latched" id)
        (as-set! "pending-release" (filter (lambda (other) (not (= id other))) (as-get "pending-release")))
        (as-call "finish-run" id "Replaced" (yinz-wall-clock-ms)) (as-forget! id))
      (define agent (hash-ref pane "agent"))
      (when (as-present? agent)
        (cond ((equal? (hash-ref agent "state") "Exited")
            (as-call "finish-run" id "Closed" (yinz-wall-clock-ms))
            (as-map-remove! "hooks" id)
            (as-set! "event-fed" (filter (lambda (other) (not (= id other))) (as-get "event-fed"))))
          ((not (member id (as-get "event-fed")))
            (define feed (as-model "HookFeed" agent))
            (when (as-present? feed) (as-map-set! "hooks" id feed)))))) (as-panes))
  (as-call "adopt-arrived-runs")
  (for-each (lambda (pane)
      (define id (hash-ref pane "pane_id"))
      (define cwd (hash-ref pane "cwd"))
      (when (as-present? cwd) (as-record-cwd! id cwd))
      (define agent (hash-ref pane "agent"))
      (define run (as-map-get "runs" id #f))
      (when (and (not (member id (as-get "observed-runs"))) run (as-present? agent) (equal? (hash-ref pane "status") "Running")
          (not (equal? (hash-ref agent "state") "Exited")) (not (equal? (hash-ref run "session_id") ""))
          (equal? (hash-ref run "kind") (hash-ref agent "kind")) (equal? (hash-ref run "session_id") (hash-ref agent "session_id")))
        (as-set! "observed-runs" (cons id (as-get "observed-runs"))))) (as-all-panes))
  (as-rejoin! "cwds" "cwd")
  (as-settle-latches!)
  (as-call "resolve-repositories"))
(define (as-refresh-prefixes!)
  (define wanted (foldl (lambda (pane result)
        (define id (hash-ref pane "pane_id"))
        (define location (as-location id))
        (define repository (and (as-present? location) (as-map-get "repositories" location #f)))
        (define label (and repository (as-model "CheckoutLabel" repository)))
        (if (as-present? label) (hash-insert result (number->string id) label) result)) (hash) (as-all-panes)))
  (define live (map (lambda (pane) (hash-ref pane "pane_id")) (as-all-panes)))
  (for-each (lambda (id)
      (unless (hash-contains? wanted (number->string id))
        (when (member id live) (as-send (hash "SetPaneTitlePrefix" (hash "pane_id" (hash "Terminal" id) "prefix" json-null)))))) (as-sorted-ids (as-get "prefixes")))
  (for-each (lambda (id)
      (define label (hash-ref wanted (number->string id)))
      (unless (equal? label (as-map-get "prefixes" id #f))
        (as-send (hash "SetPaneTitlePrefix" (hash "pane_id" (hash "Terminal" id) "prefix" label))))) (as-sorted-ids wanted))
  (as-set! "prefixes" wanted))
(define (as-checkout-key pane)
  (define location (as-location (hash-ref pane "pane_id")))
  (define repository (and (as-present? location) (as-map-get "repositories" location #f)))
  (cond ((and repository (as-present? (as-field repository "provider_identity" json-null)))
      (list "provider" (hash-ref repository "provider_identity") (as-field repository "branch" json-null)))
    ((and repository (as-present? (as-field repository "common_dir" json-null)))
      (list (as-field repository "host" json-null) (as-field repository "common_dir" json-null) (as-field repository "branch" json-null)))
    (else #f)))
(define (as-refresh-related!)
  (define focused (and (as-present? (as-get "focused")) (as-pane (as-get "focused"))))
  (define key (and focused (as-present? (as-classify focused)) (as-present? (hash-ref focused "tab")) (as-checkout-key focused)))
  (define wanted (if key (sort (map (lambda (pane) (hash-ref pane "pane_id"))
          (filter (lambda (pane) (and (not (= (hash-ref pane "pane_id") (as-get "focused")))
                (as-present? (hash-ref pane "tab")) (= (car (hash-ref pane "tab")) (car (hash-ref focused "tab")))
                (as-present? (as-classify pane)) (equal? key (as-checkout-key pane)))) (as-panes))) <) '()))
  (unless (equal? wanted (as-get "related"))
    (as-send (hash "SetRelatedPanes" (map (lambda (id) (hash "Terminal" id)) wanted)))
    (as-set! "related" wanted)))
(define (as-publish! force)
  (define locations-published
    (or (equal? (as-get "repositories") (as-get "published-locations"))
      (as-log-safe "publish project locations" (lambda ()
          (as-send (hash "PublishProjectLocations" (hash "providers" (as-get "project-providers") "locations" (as-get "repositories"))))
          (as-set! "published-locations" (as-get "repositories")) #t) #f)))
  (when locations-published
    (as-refresh-prefixes!)
    (as-refresh-related!)
    (define headers (hash))
    (define (header run)
      (define id (hash-ref run "id"))
      (define old (as-map-get "run-headers" id #f))
      (define cached (if (and old (equal? run (car old))) old (list run (as-model "RunHeader" run))))
      (set! headers (hash-insert headers id cached))
      (cadr cached))
    (define reply (hash "panes" (as-get "panes") "suppressed_panes" (as-get "suppressed")
        "activity" (as-get "activity") "manual_kinds" (as-get "manual") "yinz_session_name" (as-get "session")
        "repositories" (as-get "repositories") "tab_projects" (as-get "assignments") "focused" (as-get "focused")
        "summaries" (as-get "summaries") "hooks" (as-get "hooks")
        "runs" (map header
          (append (map (lambda (id) (as-map-get "runs" id #f)) (as-sorted-ids (as-get "runs")))
            (filter (lambda (run) (as-present? (hash-ref run "ended_at_ms"))) (as-map-values "dirty-runs"))))))
    (as-set! "run-headers" headers)
    (define payload (as-model "PollReplyString" reply))
    (as-call "publish-arrangement" reply)
    (unless (and (not force) (equal? payload (as-get "published")))
      (as-set! "seq" (+ 1 (as-get "seq")))
      (for-each (lambda (id) (as-message "agent_snapshot" id payload (hash "seq" (number->string (as-get "seq"))))) (as-get "subscribers"))
      (as-set! "published" payload))))
