(require "./state.scm")

(define (parts location) (as-model "LocationParts" location))
(define (remote-ids) (map (lambda (pane) (hash-ref pane "pane_id")) (filter (lambda (pane) (as-present? (hash-ref pane "host"))) (as-all-panes))))
(define (start-git location id)
  (define (context kind) (hash "git_probe" kind "git_probe_id" (number->string id) "cwd" location))
  (define cwd (cadr (parts location)))
  (for-each (lambda (request)
      (as-send (hash "RunCommand" (list (cdr request) (hash) cwd (context (car request)) json-null json-null))))
    '(("metadata" "git" "rev-parse" "--path-format=absolute" "--show-toplevel" "--git-dir" "--git-common-dir" "--abbrev-ref" "HEAD")
      ("config" "git" "config" "--null" "--get-regexp" "^(remote\\..*\\.url|remote\\.pushdefault|branch\\..*\\.remote)$"))))
(define (current-probe? location id providers)
  (define pending (as-map-get "git-probes" location #f))
  (and pending (= id (hash-ref pending "id")) (member location (as-locations))
    (equal? providers (as-get "project-providers"))))
(define (identify-location location id providers remaining deadline)
  (when (current-probe? location id providers)
    (define left (- deadline (yinz-wall-clock-ms)))
    (if (or (null? remaining) (<= left 0))
      (begin
        (when (and (pair? remaining) (<= left 0)) (yinz-log "agent-service: project provider chain timed out; falling back to Git"))
        (start-git location id))
      (let ((provider (car remaining)))
        (define (next) (identify-location location id providers (cdr remaining) deadline))
        (yinz-catch
          (yinz-then
            (yinz-rpc-call (hash "pluginId" (hash-ref provider "plugin_id") "name" (string-append "project-identify:" (hash-ref provider "id"))
                "payload" (cadr (parts location)) "timeoutMs" left))
            (lambda (result)
              (when (current-probe? location id providers)
                (cond ((or (json-null? result) (equal? result #f)) (next))
                  (else
                    (define repository (as-send (hash "ValidateProjectMatch"
                          (hash "provider" (hash-ref provider "id") "generation" (hash-ref provider "generation")
                            "cwd" (cadr (parts location)) "result" result))))
                    (when (current-probe? location id providers)
                      (if (>= (yinz-wall-clock-ms) deadline) (next)
                        (begin (as-map-remove! "git-probes" location)
                          (as-map-set! "repositories" location repository)
                          (as-publish! #f)))))))))
          (lambda (failure)
            (yinz-log (string-append "agent-service: project provider " (hash-ref provider "id") ": " (%async-error failure)))
            (next)))))))
(define (start-probes locations)
  (for-each (lambda (location)
      (as-set! "git-seq" (+ 1 (as-get "git-seq")))
      (define id (as-get "git-seq"))
      (as-map-set! "git-probes" location (hash "id" id "metadata" #f "config" #f))
      (identify-location location id (as-get "project-providers") (as-get "project-providers") (+ (yinz-wall-clock-ms) 5000))) locations))
(define (project-providers-changed providers)
  (begin
    (as-set! "published-locations" #f)
    (as-set! "project-providers" providers)
    (for-each (lambda (name)
        (as-map-prune! name (lambda (location value) (not (json-null? (car (parts location)))))))
      '("repositories" "git-probes" "probe-backoff"))
    (resolve-repositories) (as-publish! #t)))
(define (due-locations refresh)
  (as-take (filter (lambda (location)
        (and (json-null? (car (parts location)))
          (or refresh (not (as-map-get "repositories" location #f)))
          (not (as-map-get "git-probes" location #f)) (not (as-map-get "probe-backoff" location #f))))
      (as-unique (append (as-agent-locations) (as-locations)))) 8))
(define (resolve-repositories)
  (define live (as-locations))
  (for-each (lambda (name) (as-map-prune! name (lambda (location value) (member location live)))) '("repositories" "git-probes" "probe-backoff"))
  (start-probes (due-locations #f)))
(define (record-probe location outcome)
  (define host (car (parts location)))
  (define repository
    (cond ((hash? outcome) (as-model "RepositoryOnHost" (hash-ref outcome "Checkout") host))
      ((equal? outcome "NotARepository") (as-model "RepositoryFolder" (cadr (parts location)) host))
      (else (when (json-null? host) (as-map-set! "probe-backoff" location 30)) #f)))
  (if (and repository (not (equal? repository (as-map-get "repositories" location #f))))
    (begin (as-map-set! "repositories" location repository) #t) #f))
(define (finish-probe result)
  (define code (car result)) (define stdout (cadr result)) (define context (list-ref result 3))
  (define location (as-field context "cwd" #f))
  (define kind (as-field context "git_probe" #f))
  (define id (and (as-field context "git_probe_id" #f) (string->number (hash-ref context "git_probe_id"))))
  (define old (and location id (as-map-get "git-probes" location #f)))
  (when (and old (= id (hash-ref old "id")) (member kind '("metadata" "config")))
    (define probe (hash-insert old kind (if (equal? kind "metadata") (list code stdout) (if (equal? code 0) stdout '()))))
    (as-map-set! "git-probes" location probe)
    (when (and (hash-ref probe "metadata") (hash-ref probe "config"))
      (as-map-remove! "git-probes" location)
      (record-probe location (as-model "GitProbe" (car (hash-ref probe "metadata")) (cadr (hash-ref probe "metadata")) (hash-ref probe "config")))
      (as-publish! #f))))
(define (refresh-remote)
  (define remote (remote-ids))
  (as-set! "arrangement-pending" (filter (lambda (id) (member id remote)) (as-get "arrangement-pending")))
  (if (null? remote)
    (unless (null? (as-get "arrangement-subscribers")) (as-publish! #f))
    (let* ((cursor (if (>= (as-get "remote-cursor") (length remote)) 0 (as-get "remote-cursor")))
        (rotation (append (list-tail remote cursor) (as-take remote cursor)))
        (pending (as-get "arrangement-pending"))
        (unknown (lambda (id) (define location (as-location id)) (or (not (as-present? location)) (not (as-map-get "repositories" location #f)))))
        (due (as-take (append (filter (lambda (id) (member id pending)) rotation)
              (filter (lambda (id) (and (not (member id pending)) (unknown id))) rotation)
              (filter (lambda (id) (and (not (member id pending)) (not (unknown id)))) rotation)) 4))
        (changed #f))
      (as-set! "remote-cursor" (modulo (+ cursor (length due)) (length remote)))
      (for-each (lambda (id)
          (define requested (as-location id))
          (define refreshing (member id (as-get "arrangement-pending")))
          (define (finished) (as-set! "arrangement-pending" (filter (lambda (other) (not (= id other))) (as-get "arrangement-pending"))))
          (cond ((or (not (as-present? requested)) (equal? (cadr (parts requested)) "")) (finished))
            (else
              (define probe (as-safe (lambda () (as-send (hash "GetPaneGitProbe" (hash "pane_id" (hash "Terminal" id)
                          "cwd" (cadr (parts requested)) "refresh_token" (if refreshing (as-get "arrangement-token") json-null))))) #f))
              (cond ((not probe)
                  (when refreshing (as-set! "arrangement-failed" (as-unique (cons id (as-get "arrangement-failed"))))) (finished))
                ((json-null? probe) #f)
                (else
                  (define location (as-model "CheckoutLocation" (hash-ref probe "host") (hash-ref probe "cwd")))
                  (define outcome (as-model "GitProbe" (hash-ref probe "exit_code") (hash-ref probe "metadata") (hash-ref probe "config")))
                  (when (equal? location requested) (finished))
                  (when (and refreshing (equal? outcome "Failed")) (as-set! "arrangement-failed" (as-unique (cons id (as-get "arrangement-failed")))))
                  (when (record-probe location outcome) (set! changed #t))))))) due)
      (when (or changed (pair? (as-get "arrangement-subscribers"))) (as-publish! #f)))))
(define (refresh-repositories) (start-probes (due-locations #t)) (refresh-remote))
(define (retry-repositories elapsed)
  (for-each (lambda (location) (as-map-set! "probe-backoff" location (- (as-map-get "probe-backoff" location 0) elapsed))) (as-keys (as-get "probe-backoff")))
  (as-map-prune! "probe-backoff" (lambda (location left) (> left 0)))
  (resolve-repositories))
(define (arrangement-request id)
  (unless (member id (as-get "arrangement-subscribers"))
    (as-set! "arrangement-subscribers" (append (as-get "arrangement-subscribers") (list id)))
    (when (json-null? (as-get "arrangement-start")) (as-set! "arrangement-start" (yinz-wall-clock-ms))))
  (when (json-null? (as-get "arrangement-token"))
    ;; Retain the original service's opaque token spelling for runtime replay.
    (define now (yinz-wall-clock-ms))
    (as-set! "arrangement-token" (string-append "SystemTime { tv_sec: " (number->string (quotient now 1000))
        ", tv_nsec: " (number->string (* (modulo now 1000) 1000000)) " }"))
    (as-set! "arrangement-failed" '()) (as-set! "arrangement-pending" (as-unique (append (as-get "arrangement-pending") (remote-ids)))))
  (define locations (sort (as-unique (filter (lambda (location) (and (json-null? (car (parts location))) (not (as-map-get "git-probes" location #f)))) (as-locations))) string<?))
  (for-each (lambda (location) (as-map-remove! "repositories" location)) locations)
  (start-probes locations) (refresh-remote) (as-publish! #t))
(define (publish-arrangement reply)
  (when (and (pair? (as-get "arrangement-subscribers"))
      (or (and (null? (as-keys (as-get "git-probes"))) (null? (as-get "arrangement-pending")))
        (and (as-present? (as-get "arrangement-start")) (>= (- (yinz-wall-clock-ms) (as-get "arrangement-start")) 15000))))
    (define unavailable (as-unique (append (as-get "arrangement-failed") (as-get "arrangement-pending"))))
    (unless (null? unavailable)
      (as-send (hash "Notify" (list (string-append "Arrange panes: " (number->string (length unavailable)) " remote panes left untouched because fresh repository metadata is unavailable") json-null json-null))))
    (define positions (hash))
    (for-each (lambda (tab)
        (let loop ((panes (hash-ref (hash-ref (as-get "manifest") "panes") tab)) (index 0))
          (unless (null? panes)
            (unless (hash-ref (car panes) "is_plugin") (set! positions (hash-insert positions (number->string (hash-ref (car panes) "id")) (list (string->number tab) index))))
            (loop (cdr panes) (+ index 1))))) (as-keys (hash-ref (as-get "manifest") "panes")))
    (define (before a b)
      (define aid (hash-ref a "pane_id")) (define bid (hash-ref b "pane_id"))
      (define ap (as-field positions (number->string aid) '(-1 -1))) (define bp (as-field positions (number->string bid) '(-1 -1)))
      (or (< (car ap) (car bp)) (and (= (car ap) (car bp)) (or (< (cadr ap) (cadr bp)) (and (= (cadr ap) (cadr bp)) (< aid bid))))))
    (define ordered (if (json-null? (hash-ref reply "panes")) reply
        (hash-insert reply "panes" (sort (filter (lambda (pane) (not (member (hash-ref pane "pane_id") unavailable))) (hash-ref reply "panes")) before))))
    (define payload (as-model "PollReplyString" ordered))
    (define subscribers (as-get "arrangement-subscribers"))
    (for-each (lambda (name) (as-set! name '())) '("arrangement-failed" "arrangement-pending" "arrangement-subscribers"))
    (as-set! "arrangement-start" json-null) (as-set! "arrangement-token" json-null)
    (for-each (lambda (id) (as-message "arrange_projects_snapshot" id payload (hash))) subscribers)))
(as-register! "resolve-repositories" resolve-repositories)
(as-register! "refresh-repositories" refresh-repositories)
(as-register! "retry-repositories" retry-repositories)
(as-register! "refresh-remote" refresh-remote)
(as-register! "finish-probe" finish-probe)
(as-register! "arrangement-request" arrangement-request)
(as-register! "publish-arrangement" publish-arrangement)

(as-register! "project-providers-changed" project-providers-changed)
