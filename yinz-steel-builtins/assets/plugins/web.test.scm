(test "query validation is strict and never reaches AgentView" (lambda ()
    (w-load)
    (define control (string #\a (integer->char 1)))
    (define cases (list
        (list "/api/agents" (list "x" "1"))
        (list "/api/prompts" (list "tz" "UTC"))
        (list "/api/usage")
        (list "/api/usage" (list "agent" "   "))
        (list "/api/history")
        (list "/api/history" (list "run" "R") (list "run" "R"))
        (list "/api/history" (list "run" "R") (list "unknown" "1"))
        (list "/api/history" (list "run" control))
        (list "/api/history" (list "run" (make-string 513 #\r)))
        (list "/api/history" (list "run" (apply string-append (map (lambda (_) "é") (range 0 257)))))
        (list "/api/history" (list "run" "R") (list "tz" (make-string 65 #\z)))
        (list "/api/history" (list "run" "R") (list "query" (make-string 1025 #\q)))
        (list "/api/history" (list "run" "R") (list "from" "-1"))
        (list "/api/history" (list "run" "R") (list "from" "+1"))
        (list "/api/history" (list "run" "R") (list "from" "1.0"))
        (list "/api/history" (list "run" "R") (list "from" " 1"))
        (list "/api/history" (list "run" "R") (list "from" "9223372036854775807"))
        (list "/api/history" (list "run" "R") (list "from" "00000000000000000001"))
        (list "/api/history" (list "run" "R") (list "from" "1") (list "worker" "w"))
        (list "/api/history" (list "run" "R") (list "from" "1") (list "after_revision" "2"))
        (list "/api/history" (list "run" "R") (list "after_revision" "2") (list "before" "{\"created_at_ms\":1,\"revision\":1}"))
        (list "/api/history" (list "run" "R") (list "query" "q") (list "worker" "w"))
        (list "/api/history" (list "run" "R") (list "before" "{\"created_at_ms\":1}"))
        (list "/api/history" (list "run" "R") (list "before" "{\"created_at_ms\":1,\"revision\":1,\"x\":1}"))
        (list "/api/history" (list "run" "R") (list "before" "{\"created_at_ms\":253402300800000,\"revision\":1}"))
        (list "/api/history" (list "run" "R") (list "before" "{\"created_at_ms\":1,\"revision\":0}"))
        (list "/api/history" (list "run" "R") (list "before" "{\"created_at_ms\":1.5,\"revision\":1}"))
        (list "/api/history" (list "run" "R") (list "before" "{\"created_at_ms\":1,\"revision\":9223372036854775807}"))
        (list "/api/history" (list "run" "R") (list "before" "{\"created_at_ms\":1,\"revision\":1"))
        (list "/api/history" (list "run" "R") (list "before" "[]"))
        (list "/api/hit" (list "run" "R"))
        (list "/api/hit" (list "run" "R") (list "revision" "0"))
        (list "/api/event" (list "run" "R") (list "revision" "12345678901234567890"))
        (list "/api/event" (list "run" "R") (list "revision" "7") (list "agent" "a"))
        (list "/api/tools" (list "run" "R"))
        (list "/api/tools" (list "run" "R") (list "revisions" "1") (list "range" (yinz-json-string span)))
        (list "/api/tools" (list "run" "R") (list "revisions" "1") (list "before" "{\"created_at_ms\":1,\"revision\":1}"))
        (list "/api/tools" (list "run" "R") (list "revisions" "1,,2"))
        (list "/api/tools" (list "run" "R") (list "revisions" "0"))
        (list "/api/tools" (list "run" "R") (list "revisions" (string-join (map number->string (range 1 32)) ",")))
        (list "/api/tools" (list "run" "R") (list "range" "{\"start\":null,\"end\":null}"))
        (list "/api/tools" (list "run" "R") (list "range" "{\"start\":null,\"end\":null,\"worker\":\" \"}"))
        (list "/api/tools" (list "run" "R") (list "range" "{\"start\":{\"revision\":1},\"end\":null,\"worker\":null}"))))
    (for-each (lambda (item)
        (define id (apply w-get item))
        (w-invalid id)
        (define message (w-message id))
        (assert (not (w-contains? message "é")))
        (assert (not (w-contains? message "rrrr")))) cases)
    (assert-equal (w-views) '())
    (w-get "/api/tools" (list "run" "R") (list "revisions" (string-join (map number->string (range 1 31)) ",")))
    (assert-equal (length (hash-ref (w-view) "revisions")) 30)
    (w-get "/api/history" (list "run" (apply string-append (map (lambda (_) "é") (range 0 256)))) (list "query" ""))
    (assert-equal (hash-ref (w-view) "query") "")))

(test "post bodies are strict, bounded and defaulted" (lambda ()
    (w-load)
    (define (body . pairs)
      (yinz-json-string (let loop ((rest pairs) (value (hash)))
          (if (null? rest) value (loop (cddr rest) (hash-insert value (car rest) (cadr rest)))))))
    (define (text bytes) (apply string-append (map (lambda (_) "é") (range 0 (quotient bytes 2)))))
    (define bad-json (w-post "/api/agent/focus" "{"))
    (assert-equal (w-status bad-json) 400)
    (assert-equal (w-code bad-json) "bad_json")
    (define wrong-type (w-post "/api/agent/focus" (body "agent" agent) "text/plain"))
    (assert-equal (w-code wrong-type) "bad_json")
    (define invalid (list
        (list "/api/agent/focus" "[]")
        (list "/api/agent/focus" "null")
        (list "/api/agent/focus" (body))
        (list "/api/agent/focus" (body "agent" agent "extra" 1))
        (list "/api/agent/focus" "{\"agent\":{\"id\":\"a\",\"kind\":\"k\",\"session_id\":\"s\"},\"agent\":{\"id\":\"a\",\"kind\":\"k\",\"session_id\":\"s\"}}")
        (list "/api/agent/focus" "{\"agent\":{\"id\":\"a\",\"id\":\"b\",\"kind\":\"k\",\"session_id\":\"s\"}}")
        (list "/api/agent/focus" (body "agent" (hash "id" "a" "kind" "k")))
        (list "/api/agent/focus" (body "agent" (hash-insert agent "extra" "x")))
        (list "/api/agent/focus" (body "agent" (hash-insert agent "id" " ")))
        (list "/api/agent/focus" (body "agent" (hash-insert agent "kind" (string #\k (integer->char 127)))))
        (list "/api/agent/focus" (body "agent" (hash-insert agent "session_id" 7)))
        (list "/api/agent/prompt" (body "agent" agent "text" "hi"))
        (list "/api/agent/prompt" (body "agent" agent "submission_id" "has space" "text" "hi"))
        (list "/api/agent/prompt" (body "agent" agent "submission_id" (make-string 65 #\a) "text" "hi"))
        (list "/api/agent/prompt" (body "agent" agent "submission_id" "" "text" "hi"))
        (list "/api/agent/prompt" (body "agent" agent "submission_id" "s" "text" " \n\t "))
        (list "/api/agent/prompt" (body "agent" agent "submission_id" "s" "text" (string #\a (integer->char 7))))
        (list "/api/agent/prompt" (body "agent" agent "submission_id" "s" "text" (string-append (text 32768) "x")))
        (list "/api/agent/screen" (body "agent" agent "lines" 0))
        (list "/api/agent/screen" (body "agent" agent "lines" 201))
        (list "/api/agent/screen" (body "agent" agent "lines" 1.5))
        (list "/api/agent/screen" (body "agent" agent "lines" "80"))
        (list "/api/agent/screen" (body "lines" 80))
        (list "/api/agent/keys" (body "agent" agent "keys" '()))
        (list "/api/agent/keys" (body "agent" agent "keys" (list "f")))
        (list "/api/agent/keys" (body "agent" agent "keys" "enter"))
        (list "/api/agent/keys" (body "agent" agent "keys" (map (lambda (_) "y") (range 0 9))))))
    (for-each (lambda (item) (w-invalid (apply w-post item))) invalid)
    (assert-equal (w-views) '())
    (w-post "/api/agent/prompt" (body "agent" agent "submission_id" "Az09._-" "text" (string-append "line\n\t" (text 32760))))
    (assert-equal (hash-ref (w-view) "submission_id") "Az09._-")
    (assert-equal (utf8-length (hash-ref (w-view) "text")) 32766)
    (w-post "/api/agent/screen" (body "agent" agent))
    (assert-equal (w-view) (hash "op" "screen" "agent" agent "lines" 80))
    (w-post "/api/agent/screen" (body "agent" agent "lines" 200))
    (assert-equal (hash-ref (w-view) "lines") 200)
    (w-post "/api/agent/keys" (body "agent" agent "keys" (list "esc" "enter" "tab" "up" "down" "backspace" "y" "9")))
    (assert-equal (length (hash-ref (w-view) "keys")) 8)))

(test "actions preserve native payloads including non-success outcomes" (lambda ()
    (w-load)
    (define prompt (w-post "/api/agent/prompt" (yinz-json-string (hash "agent" agent "submission_id" "s-1.a_b" "text" "go"))))
    (assert-equal (w-view) (hash "op" "prompt" "agent" agent "submission_id" "s-1.a_b" "text" "go"))
    (w-ok (hash "response" response))
    (assert-equal (w-status prompt) 200)
    (assert-equal (w-body prompt) (hash "response" response))
    (define keys (w-post "/api/agent/keys" (yinz-json-string (hash "agent" agent "keys" (list "1")))))
    (w-ok (hash "response" (hash-insert response "outcome" "target_changed")))
    (assert-equal (hash-ref (hash-ref (w-body keys) "response") "outcome") "target_changed")
    (define focus (w-post "/api/agent/focus" (yinz-json-string (hash "agent" agent))))
    (assert-equal (w-view) (hash "op" "focus" "agent" agent))
    (w-ok #t)
    (assert-equal (w-body focus) (hash "ok" #t))
    (define screen (w-post "/api/agent/screen" (yinz-json-string (hash "agent" agent "lines" 3))))
    (define output (hash-insert (hash-insert response "outcome" "ok") "output" "$ <b>&\n"))
    (w-ok (hash "response" output))
    (assert-equal (hash-ref (w-body screen) "response") output)
    (assert-equal (hash-ref (w-body screen) "html") "<pre class=\"screen\">$ &lt;b&gt;&amp;\n</pre>")
    (define empty (w-post "/api/agent/screen" (yinz-json-string (hash "agent" agent))))
    (w-ok (hash "response" response))
    (assert-equal (hash-ref (w-body empty) "html") "<pre class=\"screen\"></pre>")))

(test "decoded native errors map to typed statuses with native messages" (lambda ()
    (w-load)
    (for-each (lambda (item)
        (define id (w-get "/api/usage" (list "agent" "a")))
        (w-fail (car item) "native <detail>")
        (assert-equal (w-status id) (cadr item) (car item))
        (assert-equal (w-body id) (hash "error" (hash "code" (car item) "message" "native <detail>")))
        (assert-equal (w-header id "retry-after") (caddr item) (car item)))
      (list (list "invalid" 400 #f) (list "not_found" 404 #f) (list "target_changed" 409 #f)
        (list "paused" 503 "5") (list "unavailable" 503 "5") (list "failed" 502 #f) (list "unexpected" 502 #f)))
    (define focus (w-post "/api/agent/focus" (yinz-json-string (hash "agent" agent))))
    (w-fail "unavailable" "No terminal attached")
    (assert-equal (w-status focus) 409)
    (assert-equal (w-message focus) "No terminal attached")
    (assert-equal (w-header focus "retry-after") #f)))

(test "SDK timeouts and failures differ from native focus unavailability" (lambda ()
    (w-load)
    (define list-id (w-get "/api/agents"))
    (test-advance 40000)
    (assert-equal (w-status list-id) 503)
    (assert-equal (w-body list-id) (hash "error" (hash "code" "unavailable" "message" "Agent view timed out")))
    (assert-equal (w-header list-id "retry-after") "5")
    (define focus (w-post "/api/agent/focus" (yinz-json-string (hash "agent" agent))))
    (test-advance 40000)
    (assert-equal (w-status focus) 503)
    (define malformed (w-get "/api/prompts"))
    (w-reply (hash "unexpected" #t))
    (assert-equal (w-status malformed) 502)
    (assert-equal (w-body malformed) (hash "error" (hash "code" "failed" "message" "Agent view failed")))
    (test-stub-error "AgentView" "private dispatch failure")
    (define dispatch (w-get "/api/prompts"))
    (assert-equal (w-status dispatch) 502)
    (assert (not (w-contains? (hash-ref (w-response dispatch) "body") "private")))))

(test "known paths reject other methods and unknown API paths are not found" (lambda ()
    (w-load)
    (for-each (lambda (item)
        (define id (w-request (car item) (cadr item)))
        (assert-equal (w-status id) 405)
        (assert-equal (w-body id) (hash "error" (hash "code" "method_not_allowed")))
        (assert-equal (sort (hash-keys->list (hash-ref (w-response id) "headers")) string<?) (list "cache-control" "content-type") (cadr item)))
      (list (list "POST" "/api/agents") (list "POST" "/api/history") (list "POST" "/api/tools") (list "POST" "/api/prompts")
        (list "GET" "/api/agent/prompt") (list "HEAD" "/api/agent/focus") (list "GET" "/api/agent/screen")
        (list "HEAD" "/api/agent/keys")))
    (for-each (lambda (path)
        (define id (w-get path))
        (assert-equal (w-status id) 404)
        (assert-equal (w-body id) (hash "error" (hash "code" "not_found"))))
      (list "/api" "/api/unknown" "/api/agents/extra" "/api/agent" "/api/login-ish"))
    (define head (w-request "HEAD" "/api/hit" (hash "query_pairs" (list (list "run" "R") (list "revision" "1")))))
    (assert-equal (w-view) (hash "op" "hit" "run" "R" "revision" 1))
    (w-ok page)
    (assert-equal (w-status head) 200)
    (assert-equal (w-views) (list (t-last (w-views))))))

(test "short wrappers customize defaults and repeated installation stays stable" (lambda ()
    (w-load (hash "title" "Phone") "./testing-fixtures/web-custom.scm")
    (assert-equal (length (t-named "HttpAssets")) 1)
    ;; Two pages at installation, then each of four wrappers republishes both.
