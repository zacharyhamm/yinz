(test "raising hooks and handlers produce one sanitized internal error" (lambda ()
    (w-load (hash) "./testing-fixtures/web-custom.scm")
    (define screen (w-post "/api/agent/screen" (yinz-json-string (hash "agent" agent))))
    (define view (t-last (w-views)))
    (w-ok (hash "response" (hash-insert response "output" "explode")))
    (assert-equal (w-status screen) 500)
    (assert-equal (hash-ref (w-response screen) "body") "{\"error\":{\"code\":\"internal\"}}")
    (test-event (hash "CustomMessage" (list "agent-view-response"
          (yinz-json-string (hash "id" (hash-ref view "id") "reply" (hash "ok" (hash "response" response)))))))
    (assert-equal (length (w-responses screen)) 1)
    (define sync (w-get "/api/explode"))
    (assert-equal (hash-ref (w-response sync) "body") "{\"error\":{\"code\":\"internal\"}}")
    (define healthy (w-get "/api/prompts"))
    (w-ok (hash "prompts" '()))
    (assert-equal (w-status healthy) 200)))
