(require "./testing/common.scm")
;; Every host operation is stubbed explicitly; AgentView replies are correlated CustomMessages.
(define (w-load . arguments)
  (test-load-plugin (if (> (length arguments) 1) (cadr arguments) "./web.scm")
    (hash "grants" '("RunCommands") "configuration" (if (null? arguments) (hash) (car arguments))
      "replies" (hash "HttpAssets" json-null "HttpPublish" json-null)))
  (test-stub "HttpRespond" json-null)
  (test-stub "AgentView" json-null)
  (test-stub "Subscribe" json-null)
  (test-stub "SetTimeout" json-null))
(define w-id 0)
(define (w-request method path . options)
  (set! w-id (+ w-id 1))
  (test-web (t-merge
      (hash "id" w-id "client" 1 "method" method "path" path
        "segments" (filter (lambda (s) (not (equal? s ""))) (split-many path "/"))
        "query" (hash) "query_pairs" '() "headers" (hash) "body" json-null
        "auth" (hash "session" "s" "label" "phone") "attached" #t
        "server" (hash "session" "main") "deadline_ms" 9000000000000)
      (if (null? options) (hash) (car options))))
  w-id)
(define (w-get path . pairs) (w-request "GET" path (hash "query_pairs" pairs)))
(define (w-post path body . type)
  (w-request "POST" path (hash "body" body
      "headers" (hash "content-type" (if (null? type) "application/json; charset=utf-8" (car type))))))
(define (w-responses id)
  (filter (lambda (reply) (equal? (hash-ref reply "request_id") id))
    (map (lambda (command) (hash-ref command "HttpRespond")) (t-named "HttpRespond"))))
(define (w-response id)
  (define replies (w-responses id))
  (assert-equal (length replies) 1 "expected exactly one response")
  (yinz-json-parse (hash-ref (car replies) "response")))
(define (w-status id) (hash-ref (w-response id) "status"))
(define (w-body id) (yinz-json-parse (hash-ref (w-response id) "body")))
(define (w-header id name) (t-get (hash-ref (w-response id) "headers") name #f))
(define (w-code id) (hash-ref (hash-ref (w-body id) "error") "code"))
(define (w-message id) (t-get (hash-ref (w-body id) "error") "message" #f))
(define (w-views) (map (lambda (command) (hash-ref command "AgentView")) (t-named "AgentView")))
(define (w-view) (yinz-json-parse (hash-ref (t-last (w-views)) "request")))
(define (w-reply reply)
  (test-event (hash "CustomMessage" (list "agent-view-response"
        (yinz-json-string (hash "id" (hash-ref (t-last (w-views)) "id") "reply" reply))))))
(define (w-ok payload) (w-reply (hash "ok" payload)))
(define (w-fail code message) (w-reply (hash "error" (hash "code" code "message" message))))
(define (w-contains? text part) (if (t-index text part) #t #f))
(define (w-page path)
  (hash-ref (hash-ref (t-last (filter (lambda (c) (equal? (hash-ref (hash-ref c "HttpPublish") "path") path))
          (t-named "HttpPublish"))) "HttpPublish") "body"))
(define (w-invalid id)
  (assert-equal (w-status id) 400)
  (assert-equal (w-code id) "invalid")
  (assert (string? (w-message id)) "invalid responses carry a fixed message"))

(define hostile "</script><script>alert(1)</script>")
(define agent (hash "id" "live:main:7" "kind" "claude" "session_id" "conversation-1"))
(define row (hash "id" "live:main:7" "ref" agent "session" "main" "current_session" #t "pane_id" "terminal_7"
    "pane" "7" "provider" "claude" "state" "waiting" "glyph" "?" "status" "Waiting" "host" json-null
    "title" hostile "activity" "" "project" "yinz" "branch" "main" "last_reply" (hash "text" "<b>hi</b>" "truncated" #f)
    "last_hook_at_ms" 5 "focused" #f "selectable" #t "suppressed" #f "directory" "/w" "run" "R" "wait_needs_a_person" #t
    "source" json-null "can_prompt" #t "prompt_unavailable" json-null "usage_unavailable" json-null))
(define listing (hash "session" "main" "now_ms" 99 "counts" (hash "waiting" 1 "busy" 0 "idle" 0) "agents" (list row)))
(define header (hash "name" "<agent>" "status" "Waiting" "location" "/w" "started" "now" "task" "<task>"
    "project" "yinz" "branch" "main" "session_id" "conversation-1" "details" "<details>"))
(define span (hash "start" (hash "created_at_ms" 1 "revision" 2) "end" json-null "worker" json-null))
(define (event revision kind markdown span)
  (hash "revision" revision "revisions" (if (json-null? span) (list revision) '()) "range" span "kind" kind
    "created_at_ms" 10 "time" "10:00" "truncated" #f "tool_calls" 0 "markdown" markdown
    "request" (hash "op" "event" "run" "R" "revision" revision)))
(define page (hash "run" "R" "retargeted" #f "agent_gone" #f "live" row "header" header
    "events" (list (event 1 "assistant" "**bold** <img src=x onerror=alert(1)>" json-null)
      (event 2 "tool_call" "<script>tool</script>" json-null)
      (event 3 "tool_result" "grouped <b>" span))
    "earlier" #t "next_from" json-null "previous_run" json-null "origin_run" json-null "resumable" #f
    "activity_ranges" (list span) "status" "ok"
    "navigation" (hash "earlier" (hash "op" "history" "run" "R" "agent" "live:main:7" "worker" json-null
        "before" (hash "created_at_ms" 1 "revision" 1) "after_revision" json-null))))
(define response (hash "outcome" "needs_input" "prompt_delivery" "started" "submission_id" "s-1.a_b"
    "message" "Agent is waiting" "state" "waiting" "output" json-null))

(test "installation publishes frozen escaped pages and assets with a whitelisted bootstrap" (lambda ()
    (w-load (hash "title" "</title><script>x</script>" "secret" "do-not-publish"))
    (assert-equal (t-named "HttpAssets") (list (hash "HttpAssets" (hash "prefix" "/static/" "directory" "builtin:web/static"))))
    (assert-equal (map (lambda (c) (hash-ref (hash-ref c "HttpPublish") "path")) (t-named "HttpPublish")) '("/" "/login"))
    (for-each (lambda (path)
        (define body (w-page path))
        (assert (string? body))
        (for-each (lambda (part) (assert (w-contains? body part) part))
          (list "<!doctype html>" "<meta charset=\"utf-8\">" "width=device-width, initial-scale=1, viewport-fit=cover"
            "name=\"theme-color\"" "content=\"light dark\"" "href=\"/static/manifest.webmanifest\"" "href=\"/static/icon.svg\""
            "href=\"/static/app.css\" rel=\"stylesheet\"" "<title>&lt;/title&gt;&lt;script&gt;x&lt;/script&gt;</title>"
            "<noscript>" "id=\"yinz-config\"" "\\u003c/title\\u003e\\u003cscript\\u003ex\\u003c/script\\u003e"
            "\"list_ms\":3000" "\"tail_ms\":2000" "\"usage_ms\":60000" "\"screen_ms\":2000"
            "\"quick_keys\":[\"1\",\"2\",\"3\",\"enter\",\"esc\",\"up\",\"down\"]" "\"get_ms\":10000" "\"post_ms\":45000"))
        (assert (not (w-contains? body "<script>x")))
        (assert (not (w-contains? body "do-not-publish")))) '("/" "/login"))
    (assert (w-contains? (w-page "/") "<div id=\"app\"></div>"))
    (assert (w-contains? (w-page "/") "<script src=\"/static/app.js\" type=\"module\"></script>"))
    (for-each (lambda (part) (assert (w-contains? (w-page "/login") part) part))
      (list "<main class=\"login\">" "action=\"/api/login\"" "method=\"post\"" "id=\"login-form\""
        "autocomplete=\"current-password\"" "id=\"password\"" "required" "id=\"label\"" "maxlength=\"128\""
        "id=\"remember\"" "type=\"checkbox\"" "Remember this device" "id=\"login-submit\"" "Sign in"
        "id=\"login-status\"" "aria-live=\"polite\"" "role=\"status\"" "<script src=\"/static/login.js\" type=\"module\"></script>"))))

(test "an invalid title keeps the default bootstrap" (lambda ()
    (w-load (hash "title" (make-string 65 #\x)))
    (assert (w-contains? (w-page "/") "<title>yinz</title>"))
    (assert (w-contains? (w-page "/") "\"title\":\"yinz\""))))

(test "agents are decorated before rows render and native fields are preserved" (lambda ()
    (w-load)
    (define id (w-get "/api/agents"))
    (assert-equal (w-view) (hash "op" "list"))
    (assert-equal (w-responses id) '())
    (w-ok listing)
    (assert-equal (w-status id) 200)
    (assert-equal (w-header id "cache-control") "no-store")
    (define body (w-body id))
    (define enriched (car (hash-ref body "agents")))
    (define html (hash-ref enriched "html"))
    (assert-equal (hash-remove body "agents") (hash-remove listing "agents"))
    (assert-equal (hash-remove enriched "html") row)
    (assert (w-contains? html "&lt;/script&gt;&lt;script&gt;alert(1)&lt;/script&gt;"))
    (assert (w-contains? html "&lt;b&gt;hi&lt;/b&gt;"))
    (assert (w-contains? html "data-state=\"waiting\""))
    (assert (not (w-contains? html "<script")))
    (define head (w-request "HEAD" "/api/agents"))
    (w-ok listing)
    (assert-equal (w-status head) 200)))

(test "history and hit pages gain header, details and event html" (lambda ()
    (w-load)
    (define id (w-get "/api/history" (list "run" "R") (list "agent" "live:main:7") (list "after_revision" "0") (list "tz" "UTC")))
    (assert-equal (w-view) (hash "op" "history" "run" "R" "agent" "live:main:7" "after_revision" 0 "tz" "UTC"))
    (w-ok page)
    (define body (w-body id))
    (for-each (lambda (key) (assert-equal (hash-ref body key) (hash-ref page key) key))
      '("run" "retargeted" "agent_gone" "live" "header" "earlier" "next_from" "activity_ranges" "navigation" "status"))
    (define events (hash-ref body "events"))
    (assert-equal (map (lambda (e) (hash-remove e "html")) events) (hash-ref page "events"))
    (assert (w-contains? (hash-ref (car events) "html") "<strong>bold</strong>"))
    (assert (not (w-contains? (hash-ref (car events) "html") "<img")))
    (assert-equal (hash-ref (cadr events) "html") "<pre class=\"event-tool\">&lt;script&gt;tool&lt;/script&gt;</pre>")
    (assert-equal (hash-ref (caddr events) "html") "<pre class=\"event-tool\">grouped &lt;b&gt;</pre>")
    (assert (w-contains? (hash-ref body "header_html") "<h2>&lt;agent&gt;</h2>"))
    (assert (w-contains? (hash-ref body "header_html") "&lt;task&gt;"))
    (assert-equal (hash-ref body "details_html") "<pre class=\"details\">&lt;details&gt;</pre>")
    (define search (w-get "/api/history" (list "run" "R") (list "query" "needle") (list "from" "4")))
    (assert-equal (w-view) (hash "op" "history" "run" "R" "query" "needle" "from" 4))
    (w-ok page)
    (assert-equal (w-status search) 200)
    (define before (w-get "/api/history" (list "run" "R") (list "worker" "w1")
        (list "before" "{\"created_at_ms\":null,\"revision\":9223372036854775806}")))
    (assert-equal (hash-ref (w-view) "before") (hash "created_at_ms" json-null "revision" 9223372036854775806))
    (w-ok page)
    (assert-equal (w-status before) 200)
    (define hit (w-get "/api/hit" (list "run" "R") (list "revision" "9223372036854775806")))
    (assert-equal (w-view) (hash "op" "hit" "run" "R" "revision" 9223372036854775806))
    (w-ok page)
    (assert-equal (length (hash-ref (w-body hit) "events")) 3)))

(test "event and tools readers gain escaped reader html and keep the native page" (lambda ()
    (w-load)
    (define reader (hash "header" "<Tool>" "markdown" "# Title" "tool" "{\"cmd\":\"<rm>\"}"))
    (define id (w-get "/api/event" (list "run" "R") (list "revision" "7") (list "tz" "Europe/Paris")))
    (assert-equal (w-view) (hash "op" "event" "run" "R" "revision" 7 "tz" "Europe/Paris"))
    (w-ok reader)
    (define body (w-body id))
    (assert-equal (hash-remove body "html") reader)
    (assert (w-contains? (hash-ref body "html") "<h2>&lt;Tool&gt;</h2>"))
    (assert (w-contains? (hash-ref body "html") "<h1>Title</h1>"))
    (assert (w-contains? (hash-ref body "html") "<pre class=\"reader-tool\">{&quot;cmd&quot;:&quot;&lt;rm&gt;&quot;}</pre>"))
    (define tools (w-get "/api/tools" (list "run" "R") (list "revisions" "1,2,3")))
    (assert-equal (w-view) (hash "op" "tools" "run" "R" "revisions" '(1 2 3)))
    (w-ok reader)
    (assert-equal (w-status tools) 200)
    (define ranged (w-get "/api/tools" (list "run" "R") (list "range" (yinz-json-string span))
        (list "before" "{\"created_at_ms\":-377705116800000,\"revision\":1}")))
    (assert-equal (w-view) (hash "op" "tools" "run" "R" "range" span
        "before" (hash "created_at_ms" -377705116800000 "revision" 1)))
    (w-ok (hash-insert reader "page" page))
    (assert-equal (hash-ref (w-body ranged) "page") page)))

