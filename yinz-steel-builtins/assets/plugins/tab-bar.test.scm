(require "./testing/common.scm")
(test "tab bar starts empty and handles hint replacement, clearing, and full frames" (lambda ()
    (t-load "./tab-bar.scm" (hash "GetPluginIds" (hash "hostname" "host")))
    (assert-equal (trim (test-render 1 80)) "")
    (test-event (hash "TabUpdate" (list (t-tab))))
    (define hint (hash "8" (hash "text" "hint-one" "indices" '((0 1000) () () () (2)))))
    (test-event (hash "HintText" hint))
    (assert (string-contains? (test-render 1 80) "hint-one"))
    (test-event (hash "HintText" (hash "8" (hash "text" "hint-two" "indices" '()))))
    (test-advance 5000) (assert (string-contains? (test-render 1 80) "hint-two"))
    (test-advance 1000) (assert (not (string-contains? (test-render 1 80) "hint-two")))
    (test-event (hash "HintText" hint))
    (test-event (hash "ModeUpdate" (t-mode (hash "pane_frame_style" "full"))))
    (assert (not (string-contains? (test-render 1 80) "hint-one")))
    (test-event (hash "ModeUpdate" (t-mode (hash "pane_frame_style" "titles"))))
    (assert (string-contains? (test-render 1 80) "hint-one"))
    (test-event "InputReceived") (assert (not (string-contains? (test-render 1 80) "hint-one")))))
