(require "./testing/common.scm")
(test "tab bar starts empty and handles hint replacement, clearing, and full frames" (lambda ()
    (t-load "./tab-bar.scm" (hash "GetPluginIds" (hash "hostname" "host")))
    (assert-equal (trim (test-render 1 80)) "")
    (test-event (hash "TabUpdate" (list (t-tab))))
    (define hint (hash "8" (hash "text" "hint-one" "indices" '((0 1000) () () () (2)))))
    (test-event (hash "HintText" hint))
    (assert (string-contains? (test-render 1 80) "hint-one"))
    (test-event (hash "HintText" (hash "8" (hash "text" "hint-two" "indices" '()))))
    (test-advance 5000) (assert (string-contains? (test-render 1 80) "hint-two"))
    (test-advance 1000) (assert (not (string-contains? (test-render 1 80) "hint-two")))
    (test-event (hash "HintText" hint))
    (test-event (hash "ModeUpdate" (t-mode (hash "pane_frame_style" "full"))))
    (assert (not (string-contains? (test-render 1 80) "hint-one")))
    (test-event (hash "ModeUpdate" (t-mode (hash "pane_frame_style" "titles"))))
    (assert (string-contains? (test-render 1 80) "hint-one"))
    (test-event "InputReceived") (assert (not (string-contains? (test-render 1 80) "hint-one")))))

(test "project row owns session details, indicators, and breadcrumb clicks" (lambda ()
    (t-load "./tab-bar.scm" (hash "GetPluginIds" (hash "hostname" "host")))
    (test-stub "FocusHostSession" json-null)
    (test-stub "RunAction" json-null)
    (test-stub "NewTab" json-null)
    (test-event (hash "ModeUpdate" (t-mode (hash "session_name" "session" "host_fullscreen" #t "session_ancestry" '("parent")))))
    (test-event (hash "TabUpdate" (list
          (t-tab (hash "group" (hash "id" 0 "name" "Project")))
          (t-tab (hash "position" 1 "active" #f "group" (hash "id" 1 "name" "Other"))))))
    (test-event (hash "HintText" (hash "4" (hash "text" "HINT" "indices" '()))))
    (define rows (split-many (test-render 2 100) "\n"))
    (assert (string-contains? (car rows) "host"))
    (assert (string-contains? (car rows) "parent ▸ session"))
    (assert (string-contains? (car rows) "Project"))
    (assert-equal (trim (substring (car rows) 95 99)) "HINT")
    (assert (string-contains? (cadr rows) "main"))
    (assert (string-contains? (cadr rows) "+"))
    (assert (not (string-contains? (cadr rows) "host")))
    (assert (not (string-contains? (cadr rows) "HINT")))
    (test-event (hash "Mouse" (hash "LeftClick" '(0 7))))
    (assert-equal (length (t-named "FocusHostSession")) 1)
    (test-event (hash "Mouse" (hash "LeftClick" '(1 7))))
    (assert-equal (length (t-named "FocusHostSession")) 1)
    (test-event (hash "Mouse" (hash "LeftClick" (list 0 (t-index (car rows) "Other")))))
    (assert-equal (t-last (t-named "RunAction"))
      (hash "RunAction" (list (hash "SwitchTabGroup" (hash "id" 1)) (hash))))
    (test-event "InputReceived")
    (test-event (hash "ActivePaneScroll" '(3 10)))
    (set! rows (split-many (test-render 2 100) "\n"))
    (assert (string-contains? (car rows) "[ SCROLL 3/10 ]"))
    (assert (not (string-contains? (cadr rows) "SCROLL")))
    (test-event (hash "TabUpdate" (list (t-tab (hash "active_swap_layout_name" "BASE")))))
    (assert (string-contains? (test-render 1 100) "[ SCROLL 3/10 ]"))
    (test-event (hash "ActivePaneScroll" '(0 10)))
    (assert (string-contains? (test-render 1 100) "[ SCROLL 0/10 ]"))
    (test-event (hash "TabUpdate" (list (t-tab (hash "active_swap_layout_name" "stack")))))
    (set! rows (split-many (test-render 2 100) "\n"))
    (assert (string-contains? (car rows) "STACK"))
    (assert-equal (length rows) 1)
    (for-each (lambda (width) (test-render 2 width)) '(1 10 25 40))
    (assert (string-contains? (test-render 1 100) "host"))
    (assert (string-contains? (test-render 1 100) "main"))
    (assert (string-contains? (test-render 1 100) "STACK"))))

(test "project overflow clicks account for the host prefix" (lambda ()
    (t-load "./tab-bar.scm" (hash "GetPluginIds" (hash "hostname" "host")))
    (test-stub "RunAction" json-null)
    (test-event (hash "TabUpdate"
        (map (lambda (id) (t-tab (hash "position" id "active" (= id 5)
                "group" (hash "id" id "name" (string-append "Project" (number->string id))))))
          '(0 1 2 3 4 5))))
    (define row (car (split-many (test-render 2 30) "\n")))
    (assert (string-contains? row "host"))
    (assert (string-contains? row "Project5"))
    (assert (string-contains? row "+5"))
    (test-event (hash "Mouse" (hash "LeftClick" (list 0 (t-index row "+5")))))
    (assert-equal (t-last (t-named "RunAction"))
      (hash "RunAction" (list (hash "SwitchTabGroup" (hash "id" 4)) (hash))))
    (test-event (hash "Mouse" (hash "LeftClick" '(0 1))))
    (assert-equal (length (t-named "RunAction")) 1)))

(test "group and tab plus buttons have separate actions and hover state" (lambda ()
    (t-load "./tab-bar.scm" (hash "GetPluginIds" (hash "hostname" "host")))
    (test-stub "RunAction" json-null) (test-stub "NewTab" json-null)
    (test-event (hash "ModeUpdate" (t-mode (hash "capabilities" (hash "arrow_fonts" #f "kitty_graphics" #f)))))
    (test-event (hash "TabUpdate" (list
          (t-tab (hash "group" (hash "id" 0 "name" "Default")))
          (t-tab (hash "position" 1 "active" #f "group" (hash "id" 1 "name" "Other"))))))
    (define rows (split-many (test-render 2 80) "\n"))
    (define group-button (t-index (car rows) " + "))
    (define tab-button (t-index (cadr rows) " + "))
    (assert group-button) (assert tab-button)
    (define (hover row col) (test-event (hash "Mouse" (hash "Hover" (list row col)))))
    (assert (hover 0 group-button))
    (assert (not (hover 0 group-button)))
    (assert (hover 1 tab-button))
    (assert (not (hover 1 tab-button)))
    (assert (hover 0 group-button))
    (assert (hover 1 79))
    (assert (not (hover 1 79)))
    (hover 0 (t-index (car rows) "Default"))
    (assert-equal (split-many (test-render 2 80) "\n") rows)
    (define group-col (t-index (car rows) "Other"))
    (assert (hover 0 group-col))
    (assert (hover 0 group-button))
    (assert (hover 0 group-col))
    (test-event (hash "Mouse" (hash "LeftClick" (list 0 group-button))))
    (assert-equal (t-last (t-named "RunAction")) (hash "RunAction" (list "NewTabGroup" (hash))))
    (test-event (hash "Mouse" (hash "LeftClick" (list 1 tab-button))))
    (assert-equal (length (t-named "RunAction")) 1)
    (assert-equal (t-last (t-named "NewTab")) (hash "NewTab" (hash "name" json-null "cwd" json-null)))
    (assert (hover 0 group-button))
    (test-render 1 80)
    (assert (not (hover 0 79)))
    (test-event (hash "Mouse" (hash "LeftClick" (list 0 group-button))))
    (assert-equal (length (t-named "RunAction")) 1)
    (assert (string-contains? (test-render 2 80) " + "))
    (assert (hover 0 group-button))))

(test "group plus hit range follows width status and arrow font changes" (lambda ()
    (t-load "./tab-bar.scm" (hash "GetPluginIds" (hash "hostname" "host")))
    (test-stub "RunAction" json-null)
    (for-each (lambda (arrow-fonts)
        (define before (length (t-named "RunAction")))
        (test-event (hash "ModeUpdate" (t-mode (hash "capabilities" (hash "arrow_fonts" arrow-fonts "kitty_graphics" #f)))))
        (test-event (hash "TabUpdate" (list
              (t-tab (hash "group" (hash "id" 0 "name" "Default")))
              (t-tab (hash "position" 1 "active" #f "group" (hash "id" 1 "name" "Other"))))))
        (define wide (car (split-many (test-render 2 80) "\n")))
        (define button (t-index wide "+"))
        (assert button wide)
        (test-event (hash "Mouse" (hash "Hover" (list 0 button))))
        (assert (not (test-event (hash "Mouse" (hash "Hover" (list 0 button))))))
        (for-each (lambda (width)
            (define row (car (split-many (test-render 2 width) "\n")))
            (assert (not (string-contains? row "+")) "narrow row hides the group plus")
            (test-event (hash "Mouse" (hash "LeftClick" (list 0 button))))) '(1 10 16))
        (assert-equal (length (t-named "RunAction")) before)
        (test-event (hash "HintText" (hash "62" (hash "text" (make-string 62 #\h) "indices" '()))))
        (define status-row (car (split-many (test-render 2 80) "\n")))
        (assert (not (string-contains? status-row "+")) status-row)
        (test-event (hash "Mouse" (hash "LeftClick" (list 0 button))))
        (assert-equal (length (t-named "RunAction")) before)
        (test-event "InputReceived")
        (define restored (car (split-many (test-render 2 80) "\n")))
        (assert (string-contains? restored "+"))
        (test-event (hash "Mouse" (hash "LeftClick" (list 0 (t-index restored "+")))))
        (assert-equal (t-last (t-named "RunAction")) (hash "RunAction" (list "NewTabGroup" (hash))))) '(#f #t))))
