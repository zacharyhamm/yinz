(require "./testing/common.scm")
(test "agent-policy logs session hooks without notifying" (lambda ()
    (test-load-plugin "./agent-policy.scm")
    (test-event (hash "Hook" (hash "point" "session_start" "payload" (hash "session_name" "test" "client_id" 1))))
    (assert (t-any (lambda (line) (string-contains? line "session_start")) (test-logs)))
    (assert-equal (test-commands) (list (hash "Subscribe" '("Hook"))))))
(test "agent-policy waiting notification targets the agent pane" (lambda ()
    (t-load "./agent-policy.scm" (hash "Notify" json-null))
    (test-event (hash "Hook" (hash "point" "agent_waiting" "payload" (hash "pane_id" 7 "agent" (hash "kind" "codex" "detail" "needs an answer")))))
    (assert (t-any (lambda (line) (string-contains? line "agent_waiting")) (test-logs)))
    (assert-equal (t-last (test-commands)) (hash "Notify" (list "codex in pane 7: needs an answer" (hash "Terminal" 7) json-null)))))
