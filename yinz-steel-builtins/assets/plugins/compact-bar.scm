(require "./bar/keys.scm")
(require "./bar/style.scm")
(require "./bar/default-mode.scm")
(require "./bar/compact-render.scm")
(require "./bar/compact-tooltip.scm")
(define state (hash "hostname" "" "modeInfo" (bar-default-mode) "tabs" '() "toggleKey" #f "tooltipActive" #f))
(define active-tab 0)
(define display-rows 0)
(define own-client-id 0)
(define own-plugin-id 0)
(define own-tab #f)
(define configuration (hash))
(define first-run #f)
(define is-tooltip #f)
(define persist #f)
(define clipboard-failed #f)
(define copied #f)
(define cached-keybinds '())
(define breadcrumb #f)
(define parts '())
(define (mi) (hash-ref state "modeInfo"))
(define (state! key value) (set! state (hash-insert state key value)))
(define (restricted? mode) (member mode '("Locked" "EnterSearch" "RenameTab" "RenamePane" "Prompt" "Tmux" "Select")))
(define (coordinates)
  (define dimensions (compact-dimensions (mi)))
  (hash "x" (hash "Fixed" 2) "y" (hash "Fixed" (max 0 (- display-rows (car dimensions) 4)))
    "width" (hash "Fixed" (+ (cadr dimensions) 4)) "height" (hash "Fixed" (+ (car dimensions) 2)) "pinned" #t "borderless" #f))
(define (launch persisted)
  (yinz-command (hash "MessageToPlugin" (hash "plugin_url" "yinz:OWN_URL" "destination_plugin_id" 'json-null
        "plugin_config" (hash-insert configuration "is_tooltip" "true")
        "message_name" (if persisted "toggle_persisted_tooltip" "launch_tooltip_if_not_launched") "message_payload" 'json-null
        "message_args" (if persisted (hash "persist" "") (hash))
        "new_plugin_args" (hash "should_float" 'json-null "pane_id_to_replace" 'json-null "pane_title" (hash-ref (mi) "mode") "cwd" 'json-null "skip_cache" #f "should_focus" 'json-null)
        "floating_pane_coordinates" (coordinates)))))
(define (mode-update info)
  (define mode info)
  (if (null? (hash-ref mode "keybinds"))
    (unless (null? cached-keybinds) (set! mode (hash-insert mode "keybinds" cached-keybinds)))
    (set! cached-keybinds (hash-ref mode "keybinds")))
  (define changed (not (bar-equal? (mi) mode)))
  (define previous (hash-ref (mi) "mode"))
  (define base (if (bar-present? (hash-ref mode "base_mode")) (hash-ref mode "base_mode") "Normal"))
  (state! "modeInfo" mode)
  (if is-tooltip
    (if (and (not persist) (or (equal? (hash-ref mode "mode") base) (restricted? (hash-ref mode "mode"))))
      (yinz-command "CloseSelf")
      (when (or (not (equal? (hash-ref mode "mode") previous)) persist)
        (yinz-command (hash "ChangeFloatingPanesCoordinates" (list (list (hash "Plugin" own-plugin-id) (coordinates)))))
        (yinz-command (hash "RenamePluginPane" (list own-plugin-id (hash-ref mode "mode"))))))
    (when (and (hash-ref state "toggleKey") (not (equal? (hash-ref mode "mode") base)) (not (restricted? (hash-ref mode "mode")))) (launch #f)))
  changed)
(define (pane-update manifest)
  (if (not (hash-ref state "toggleKey")) #f
    (let ((previous (hash-ref state "tooltipActive")) (panes (hash-ref manifest "panes")))
      (state! "tooltipActive" (foldl (lambda (pane active) (or active (and (equal? (hash-ref pane "plugin_url") "yinz:compact-bar")
                (not (= (hash-ref pane "pane_x") (hash-ref pane "pane_content_x")))))) #f (apply append (hash-values->list panes))))
      (set! own-tab #f)
      (for-each (lambda (tab)
          (when (and (not own-tab) (not (null? (filter (lambda (pane) (and (hash-ref pane "is_plugin") (= (hash-ref pane "id") own-plugin-id))) (hash-ref panes tab)))))
            (set! own-tab (string->number tab)))) (sort (hash-keys->list panes) (lambda (a b) (< (string->number a) (string->number b)))))
      (not (equal? previous (hash-ref state "tooltipActive"))))))
(define (tab-at col)
  (let loop ((parts parts) (start 0))
    (if (null? parts) #f
      (if (and (>= col start) (< col (+ start (hash-ref (car parts) "len"))))
        (and (hash-contains? (car parts) "tab") (+ (hash-ref (car parts) "tab") 1))
        (loop (cdr parts) (+ start (hash-ref (car parts) "len")))))))
(define (mouse event)
  (unless is-tooltip
    (cond ((hash-contains? event "LeftClick")
        (define col (cadr (hash-ref event "LeftClick")))
        (if (and breadcrumb (>= col (car breadcrumb)) (< col (cadr breadcrumb))) (yinz-command "FocusHostSession")
          (let ((tab (tab-at col))) (when (and tab (not (= tab active-tab)) (<= tab 4294967295)) (yinz-command (hash "SwitchTabTo" tab))))))
      ((hash-contains? event "ScrollUp") (define next (min (+ active-tab 1) (length (hash-ref state "tabs"))))
        (when (<= next 4294967295) (yinz-command (hash "SwitchTabTo" next))))
      ((hash-contains? event "ScrollDown") (yinz-command (hash "SwitchTabTo" (max (- active-tab 1) 1)))))))
(define (update event)
  (set! first-run #f)
  (cond
    ((equal? event "SystemClipboardFailure") (if is-tooltip #f (begin (set! clipboard-failed #t) #t)))
    ((equal? event "InputReceived") (if is-tooltip #f (let ((changed (or copied clipboard-failed))) (set! copied #f) (set! clipboard-failed #f) (if changed #t #f))))
    ((not (hash? event)) #f)
    ((hash-contains? event "InitialKeybinds") (set! cached-keybinds (hash-ref event "InitialKeybinds"))
      (unless (null? cached-keybinds) (state! "modeInfo" (hash-insert (mi) "keybinds" cached-keybinds))) #t)
    ((hash-contains? event "ModeUpdate") (mode-update (hash-ref event "ModeUpdate")))
    ((hash-contains? event "TabUpdate")
      (define tabs (hash-ref event "TabUpdate"))
      (define next (let loop ((tabs tabs) (index 1)) (cond ((null? tabs) 0) ((hash-ref (car tabs) "active") index) (else (loop (cdr tabs) (+ index 1))))))
      (if (or (= next 0) (> next 4294967295)) #f
        (let ((changed (or (not (= active-tab next)) (not (bar-equal? (hash-ref state "tabs") tabs)))))
          (set! display-rows (hash-ref (list-ref tabs (- next 1)) "display_area_rows"))
          (when (and is-tooltip (not (= active-tab next)))
            (yinz-command (hash "BreakPanesToTabWithIndex" (list (list (hash "Plugin" own-plugin-id)) (- next 1) #f))))
          (set! active-tab next) (state! "tabs" tabs) changed)))
    ((hash-contains? event "PaneUpdate") (pane-update (hash-ref event "PaneUpdate")))
    ((hash-contains? event "Mouse") (mouse (hash-ref event "Mouse")) #f)
    ((and (hash-contains? event "CopyToClipboard") (not is-tooltip))
      (define next (hash-ref event "CopyToClipboard")) (define changed (not (equal? copied next))) (set! copied next) changed)
    (else #f)))
(define (pipe message)
  (cond ((and is-tooltip (hash-ref message "is_private"))
      (when (equal? (hash-ref message "name") "toggle_persisted_tooltip")
        (if first-run (set! persist #t) (yinz-command "CloseSelf"))))
    ((and (equal? (hash-ref message "name") "toggle_tooltip") (hash-ref message "is_private") (hash-ref state "toggleKey")
        (equal? own-tab (max 0 (- active-tab 1))) (equal? (hash-ref message "payload") (number->string own-client-id))) (launch #t)))
  #f)
(define (load config)
  (define ids (yinz-command "GetPluginIds"))
  (set! own-plugin-id (hash-ref ids "plugin_id")) (set! own-client-id (hash-ref ids "client_id"))
  (state! "hostname" (hash-ref ids "hostname")) (set! configuration config)
  (set! is-tooltip (equal? (bar-get config "is_tooltip" #f) "true"))
  (unless is-tooltip (state! "toggleKey" (bar-get config "tooltip" #f)))
  (set! first-run is-tooltip)
  (yinz-command (hash "SetSelectable" #f))
  (yinz-command (hash "Subscribe" (if is-tooltip '("ModeUpdate" "TabUpdate" "InitialKeybinds")
        '("TabUpdate" "PaneUpdate" "ModeUpdate" "Mouse" "CopyToClipboard" "InputReceived" "SystemClipboardFailure" "InitialKeybinds"))))
  (when (hash-ref state "toggleKey")
    (define key (hash-ref state "toggleKey"))
    (yinz-command (hash "Reconfigure" (list (string-append "\n        keybinds {\n            shared {\n                bind \"" key "\" {\n                  MessagePlugin \"compact-bar\" {\n                      name \"toggle_tooltip\"\n                      tooltip \"" key "\"\n                      payload \"" (number->string own-client-id) "\"\n                  }\n                }\n            }\n        }\n    ") #f)))))
(define (render rows cols)
  (cond (is-tooltip (compact-tooltip (mi) rows cols))
    ((or copied clipboard-failed)
      (define hint (cond ((equal? copied "Command") "Text piped to external command") ((equal? copied "Primary") "Text copied to system primary selection")
          ((equal? copied "System") "Text copied to system clipboard") (else " Error using the system clipboard.")))
      (string-append (yinz-ui-text (hash "text" hint "opaque" #t "levels" (list '() '() (range (string-length hint))))) (bar-fill (mi))))
    ((null? (hash-ref state "tabs")) "")
    (else (define output (compact-render state cols))
      (set! parts (hash-ref output "parts")) (set! breadcrumb (hash-ref output "breadcrumb"))
      (string-append (apply string-append (map (lambda (part) (hash-ref part "part")) parts)) (bar-fill (mi))))))
