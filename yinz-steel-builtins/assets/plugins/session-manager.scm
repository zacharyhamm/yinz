(require "./session-manager/state.scm")
(require "./session-manager/notifications.scm")
(require "./session-manager/render.scm")

(define (arm-refresh)
  (unless (sm-get "timer") (yinz-command (hash "SetTimeout" 1.0)) (sm-set! "timer" #t)))
(define (refresh-sessions)
  (define snapshot (sm-call "GetSessionList" #f))
  (and snapshot (begin (sm-apply-sessions! (hash-ref snapshot "live_sessions") (hash-ref snapshot "resurrectable_sessions")) #t)))
(define (load configuration)
  (sm-reset!)
  (sm-set! "welcome" (equal? (sm-field configuration "welcome_screen" "false") "true"))
  (sm-set! "multi" (equal? (sm-field configuration "multi_screen" "false") "true"))
  (sm-set! "screen" (if (sm-get "multi") (if (sm-get "welcome") "new" "attach") "single"))
  (yinz-command (hash "Subscribe" '("ModeUpdate" "SessionUpdate" "Key" "Timer" "Visible")))
  (define ids (yinz-command "GetPluginIds"))
  (define max-bytes (sm-field ids "max_session_name_bytes" 'json-null))
  (unless (json-null? max-bytes) (sm-set! "max-name-bytes" max-bytes))
  (yinz-command (hash "RenamePluginPane" (list (hash-ref ids "plugin_id") "Session Manager")))
  (refresh-sessions)
  (unless (sm-get "welcome") (arm-refresh)))
(define (pipe message)
  (if (equal? (sm-field message "name" "") "filepicker_result")
    (begin
      (define id (sm-field (sm-field message "args" (hash)) "request_id" #f))
      (define payload (sm-field message "payload" 'json-null))
      (when (and id (not (json-null? payload)) (member id (sm-get "request-ids")))
        (sm-set! "request-ids" (filter (lambda (request) (not (equal? id request))) (sm-get "request-ids")))
        (unless (sm-get "multi") (sm-set! "folder" payload))
        (sm-set! "new-folder" payload)) #t) #f))
(define (update event)
  (cond
    ((hash-contains? event "Timer")
      (sm-set! "timer" #f)
      (if (not (sm-get "visible")) #f
        (let* ((saved (sm-call "CurrentSessionLastSavedTime" 'json-null))
            (changed (not (equal? saved (sm-get "saved-time")))))
          (sm-set! "saved-time" saved)
          (define refreshed (refresh-sessions))
          (define notifications (and (equal? (sm-get "screen") "notifications") (sm-notifications-refresh!)))
          (arm-refresh) (or changed refreshed notifications))))
    ((hash-contains? event "Visible")
      (define visible (hash-ref event "Visible"))
      (define previous (sm-get "visible"))
      (sm-set! "visible" visible)
      (if (and visible (not previous)) (let ((changed (refresh-sessions))) (arm-refresh) changed) #f))
    ((hash-contains? event "ModeUpdate")
      (sm-set! "colors" (hash-ref (hash-ref (hash-ref event "ModeUpdate") "style") "colors")) #t)
    ((hash-contains? event "SessionUpdate")
      (define snapshot (hash-ref event "SessionUpdate"))
      (sm-apply-sessions! (car snapshot) (cadr snapshot)) #t)
    ((hash-contains? event "PermissionRequestResult") #t)
    ((hash-contains? event "Key")
      (if (sm-get "error") (begin (sm-set! "error" #f) #t) (handle-key (hash-ref event "Key"))))
    (else #f)))
(define (render rows columns) (sm-render rows columns))

(define (name-error name)
  (cond ((> (sm-bytes name) (sm-get "max-name-bytes"))
      (string-append "Session name must be at most " (number->string (sm-get "max-name-bytes")) " bytes"))
    ((string-contains? name "/") "Session name cannot contain '/'") (else #f)))
(define (switch-session name tab pane layout cwd)
  (yinz-command (hash "SwitchSession" (hash "name" (or name 'json-null)
        "tab_position" (or tab 'json-null) "pane_id"
        (if pane (if (hash-contains? pane "Plugin") (list (hash-ref pane "Plugin") #t) (list (hash-ref pane "Terminal") #f)) 'json-null)
        "layout" (or layout 'json-null) "cwd" (or cwd 'json-null)))))
(define (finish-selection switched)
  (yinz-command (if (sm-get "welcome") "QuitYinz" (if switched "CloseSelf" "HideSelf"))))
(define (rename-selection)
  (define name (sm-get "rename"))
  (sm-set! "rename" #f)
  (define error (cond ((equal? name "") "New name must not be empty.")
      ((equal? name (sm-get "name")) #f)
      ((sm-name-exists? name "sessions") "A session by this name already exists.")
      ((sm-name-exists? name "dead") "A resurrectable session by this name already exists.")
      (else (name-error name))))
  (cond (error (sm-set! "error" error))
    ((not (equal? name (sm-get "name")))
      (sm-set! "sessions" (map (lambda (session)
            (if (equal? (hash-ref session "name") (sm-get "name")) (hash-insert session "name" name) session)) (sm-get "sessions")))
      (sm-set! "name" name) (yinz-command (hash "RenameSession" name)))))
(define (select-new single)
  (define name (sm-get (if single "search" "new-name")))
  (define error (name-error name))
  (define mode-key (if single "single-mode" "new-mode"))
  (cond (error (sm-set! "error" error))
    ((equal? (sm-get mode-key) "name") (sm-set! mode-key "layout"))
    (else
      (define target (and (not (equal? name "")) name))
      (define switched (not (equal? target (sm-get "name"))))
      (define layout (sm-layout-selected (if single "layout" "new-layout")))
      (when switched (switch-session target #f #f layout (and layout (sm-get (if single "folder" "new-folder")))))
      (sm-set! (if single "search" "new-name") "")
      (sm-set! (if single "layout-selected" "new-layout-selected") 0)
      (when single (sm-set! "single-mode" "search") (sm-set! "layout-search" ""))
      ;; The multi-screen creator keeps its layout step after the pane is hidden.
      (if (and (not single) (not switched)) (yinz-command "HideSelf") (finish-selection switched)))))
(define (select-single)
  (define row (sm-unified-selected))
  (cond ((sm-get "rename") (rename-selection))
    ((equal? (sm-get "single-mode") "layout") (select-new #t))
    (row
      (define switched (not (hash-ref row "current")))
      (if switched (switch-session (hash-ref row "name") #f #f #f #f) (sm-set! "error" "Already attached..."))
      (sm-set! "search" "") (sm-set! "selected" #f) (finish-selection switched))
    (else
      (define name (sm-get "search"))
      (define error (name-error name))
      (cond (error (sm-set! "error" error))
        ((sm-name-exists? name "sessions")
          (if (equal? name (sm-get "name")) (sm-set! "error" "Already attached...")
            (begin (switch-session name #f #f #f #f) (finish-selection #t))))
        ((sm-name-exists? name "dead") (switch-session name #f #f #f #f) (finish-selection #t))
        (else (sm-set! "single-mode" "layout"))))))
(define (select-tree)
  (if (sm-get "rename") (rename-selection)
    (begin
      (define row (sm-tree-selected))
      (define session (sm-field row "session" #f))
      (define current (sm-field session "is_current_session" #f))
      (define tab (sm-field row "tab" #f))
      (define pane-info (sm-field row "pane" #f))
      (define pane (and pane-info (hash (if (sm-field pane-info "is_plugin" #f) "Plugin" "Terminal") (hash-ref pane-info "id"))))
      (when row
        (if current
          (cond (pane (yinz-command (hash (if (hash-contains? pane "Plugin") "FocusPluginPane" "FocusTerminalPane")
                  (list (hash-ref pane (if (hash-contains? pane "Plugin") "Plugin" "Terminal")) #t #f))))
            (tab (yinz-command (hash "GoToTab" (hash-ref tab "position"))))
            (else (sm-set! "error" "Already attached...")))
          (switch-session (hash-ref session "name") (sm-field tab "position" #f) pane #f #f)))
      (sm-tree-reset!) (sm-set! "tree-search" "") (sm-tree-search!)
      (finish-selection (and row (not current))))))
(define (select-dead)
  (define row (sm-at (sm-dead-results) (sm-dead-selection)))
  (when row (switch-session (hash-ref row "name") #f #f #f #f) (finish-selection #t)))
(define (selection)
  (cond ((equal? (sm-get "screen") "single") (select-single))
    ((equal? (sm-get "screen") "new") (select-new #f))
    ((equal? (sm-get "screen") "attach") (select-tree))
    ((equal? (sm-get "screen") "dead") (select-dead))))

(define (toggle-screen)
  (define next (hash "new" "attach" "attach" "dead" "dead" "notifications" "notifications" "new" "single" "single"))
  (sm-set! "screen" (hash-ref next (sm-get "screen")))
  (when (equal? (sm-get "screen") "notifications") (sm-notifications-refresh!)))
(define (enter-notifications)
  (sm-set! "previous-screen" (sm-get "screen")) (sm-set! "screen" "notifications") (sm-notifications-refresh!))
(define (leave-notifications)
  (cond ((sm-get "previous-screen") (sm-set! "screen" (sm-get "previous-screen")) (sm-set! "previous-screen" #f))
    ((not (sm-get "welcome")) (yinz-command "CloseSelf"))))
(define (pick-folder)
  (define hex "0123456789abcdef")
  (define (digit) (string-ref hex (yinz-random-integer 16)))
  (define id (list->string (map (lambda (i)
          (cond ((member i '(8 13 18 23)) #\-) ((= i 14) #\4)
            ((= i 19) (string-ref "89ab" (yinz-random-integer 4))) (else (digit)))) (range 36))))
  (sm-set! "request-ids" (append (sm-get "request-ids") (list id)))
  (yinz-command (hash "MessageToPlugin" (hash "plugin_url" "filepicker" "destination_plugin_id" 'json-null
        "plugin_config" (hash "request_id" id) "message_name" "filepicker" "message_payload" 'json-null
        "message_args" (hash "request_id" id) "floating_pane_coordinates" 'json-null
        "new_plugin_args" (hash "should_float" 'json-null "pane_id_to_replace" 'json-null
          "pane_title" "Select folder for the new session..." "cwd" 'json-null "skip_cache" #f "should_focus" #t)))))
(define (command-or-error command prefix)
  (with-handler (lambda (error) (sm-set! "error" (string-append prefix (error-object-message error))) #f)
    (yinz-command command) #t))
(define (delete-live names single prefix)
  (define old (sm-get (if single "selected" "session-selected")))
  (define search-old (sm-get "tree-search-selected"))
  (when (command-or-error (hash "KillSessionsAndReply" names) prefix)
    (sm-set! "sessions" (filter (lambda (session) (not (member (hash-ref session "name") names))) (sm-get "sessions")))
    (if single
      (begin (sm-unified!) (unless (sm-get "selected") (sm-set! "selected" (sm-clamp old (length (sm-get "unified"))))))
      (begin (sm-tree-search!)
        (if (equal? (sm-get "tree-search") "")
          (begin (sm-tree-reset!) (sm-set! "session-selected" (sm-clamp old (length (sm-get "sessions")))))
          (sm-set! "tree-search-selected" (sm-clamp search-old (length (sm-get "tree-results")))))))))
(define (delete-selected single)
  (define row (if single (sm-unified-selected) (sm-tree-selected)))
  (cond ((not row) (unless single (sm-set! "error" "Must select session before killing it.")))
    ((or (not single) (equal? (hash-ref row "kind") "live"))
      (delete-live (list (if single (hash-ref row "name") (hash-ref (hash-ref row "session") "name"))) single
        (if single "Failed to delete session: " "Failed to kill session: ")))
    (else
      (define old (sm-get "selected"))
      (when (command-or-error (hash "DeleteDeadSessionAndReply" (hash-ref row "name")) "Failed to delete session: ")
        (sm-set! "dead" (filter (lambda (dead) (not (equal? (hash-ref dead "name") (hash-ref row "name")))) (sm-get "dead")))
        (sm-unified!) (unless (sm-get "selected") (sm-set! "selected" (sm-clamp old (length (sm-get "unified")))))))))
(define (kill-warning key single)
  (cond ((sm-key? key (hash "Char" "y") '())
      (delete-live (sm-other-sessions) single "Failed to kill sessions: ") (sm-set! "kill-warning" #f) #t)
    ((or (sm-key? key (hash "Char" "n") '()) (sm-key? key "Esc" '()) (sm-key? key (hash "Char" "c") '("Ctrl")))
      (sm-set! "kill-warning" #f) #t) (else #f)))
(define (request-kill-all)
  (if (null? (sm-other-sessions)) (sm-set! "error" "No other sessions to kill. Quit to kill the current one.")
    (sm-set! "kill-warning" #t)))
(define (edit-string! field key)
  (sm-set! field (if (sm-key? key "Backspace" '()) (sm-pop (sm-get field)) (string-append (sm-get field) (sm-char key)))))
(define (enter-key? key) (or (sm-key? key "Enter" '()) (sm-key? key (hash "Char" "\n") '())))
(define (edit-key? key) (or (sm-key? key "Backspace" '()) (and (null? (sm-field key "key_modifiers" '())) (sm-char key))))
(define (rename-key key)
  (cond ((enter-key? key) (selection) #t)
    ((and (sm-key? key "Backspace" '()) (equal? (sm-get "rename") "")) (sm-set! "rename" #f) #t)
    ((edit-key? key) (edit-string! "rename" key) #t)
    ((sm-key? key "Esc" '()) (sm-set! "rename" #f) #t) (else #f)))
(define (layout-key key single)
  (define prefix (if single "layout" "new-layout"))
  (cond ((sm-key? key "Down" '()) (sm-layout-move! prefix 1) #t)
    ((sm-key? key "Up" '()) (sm-layout-move! prefix -1) #t)
    ((enter-key? key) (selection) #t)
    ((edit-key? key) (edit-string! (string-append prefix "-search") key) (sm-layout-filter! prefix) #t)
    ((sm-key? key (hash "Char" "f") '("Ctrl")) (pick-folder) #t)
    ((sm-key? key (hash "Char" "c") '("Ctrl")) (sm-set! (if single "folder" "new-folder") #f) #t)
    ((sm-key? key "Esc" '())
      (sm-set! (if single "single-mode" "new-mode") (if single "search" "name"))
      (sm-set! (string-append prefix "-search") "") (sm-layout-filter! prefix) #t)
    ((and (not single) (sm-key? key "Tab" '())) (toggle-screen) #t)
    ((and (not single) (sm-key? key (hash "Char" "w") '("Ctrl"))) (sm-set! "screen" "new") #t)
    (else #f)))
(define (new-key key)
  (if (equal? (sm-get "new-mode") "layout") (layout-key key #f)
    (cond ((enter-key? key) (selection) #t)
      ((edit-key? key) (edit-string! "new-name" key) #t)
      ((sm-key? key "Down" '()) (sm-layout-move! "new-layout" 1) #t)
      ((sm-key? key "Up" '()) (sm-layout-move! "new-layout" -1) #t)
      ((sm-key? key "Esc" '()) (sm-set! "new-name" "") #t)
      ((sm-key? key "Tab" '()) (toggle-screen) #t)
      ((sm-key? key (hash "Char" "w") '("Ctrl")) (sm-set! "screen" "new") #t)
      ((sm-key? key (hash "Char" "f") '("Ctrl")) (pick-folder) #t)
      ((sm-key? key (hash "Char" "c") '("Ctrl")) (sm-set! "new-folder" #f) #t) (else #f))))
(define (search-key key single)
  (define search (if single "search" "tree-search"))
  (define (refilter) (if single (sm-unified!) (sm-tree-search!)))
  (cond ((sm-get "kill-warning") (kill-warning key single))
    ((and single (sm-get "rename")) (rename-key key))
    ((enter-key? key) (selection) #t)
    ((sm-key? key "Down" '()) (if single (sm-unified-move! 1) (sm-tree-move! 1)) #t)
    ((sm-key? key "Up" '()) (if single (sm-unified-move! -1) (sm-tree-move! -1)) #t)
    ((and (not single) (sm-key? key "Right" '())) (sm-tree-expand!) #t)
    ((and (not single) (sm-key? key "Left" '())) (sm-tree-shrink!) #t)
    ((edit-key? key)
      (if (and (not single) (sm-get "rename")) (rename-key key) (begin (edit-string! search key) (refilter))) #t)
    ((sm-key? key "Tab" '())
      (if single
        (let ((first (sm-find (lambda (row) (not (hash-ref row "current"))) (sm-get "unified"))))
          (when first (sm-set! "search" (hash-ref first "name")) (sm-unified!))) (toggle-screen)) #t)
    ((sm-key? key (hash "Char" "r") '("Ctrl")) (sm-set! "rename" "") #t)
    ((sm-key? key (hash "Char" "v") '("Ctrl")) (enter-notifications) #t)
    ((sm-key? key "Delete" '()) (delete-selected single) #t)
    ((sm-key? key (hash "Char" "d") '("Ctrl")) (request-kill-all) #t)
    ((sm-key? key (hash "Char" "x") '("Ctrl")) (yinz-command "DisconnectOtherClients") #f)
    ((sm-key? key (hash "Char" "a") '("Ctrl"))
      (unless (sm-get "welcome") (command-or-error "SaveSession" "Couldn't save session: ")) #f)
    ((and (not single) (sm-key? key (hash "Char" "w") '("Ctrl"))) (sm-set! "screen" "new") #t)
    ((sm-key? key (hash "Char" "c") '("Ctrl"))
      (cond ((not (equal? (sm-get search) "")) (sm-set! search "") (refilter) (unless single (sm-tree-reset!)))
        ((not (sm-get "welcome")) (unless single (sm-tree-reset!)) (yinz-command "CloseSelf"))) #t)
    ((sm-key? key "Esc" '())
      (cond ((and (not single) (sm-get "rename")) (sm-set! "rename" #f) #t)
        ((and single (sm-get "selected")) (sm-set! "selected" #f) #t)
        (else (unless (sm-get "welcome") (yinz-command "CloseSelf")) #f))) (else #f)))
(define (dead-key key)
  (cond ((sm-key? key "Down" '()) (sm-dead-move! 1) #t)
    ((sm-key? key "Up" '()) (sm-dead-move! -1) #t)
    ((enter-key? key) (select-dead) #t)
    ((edit-key? key)
      (cond ((and (sm-get "dead-warning") (equal? (sm-char key) "y"))
          (sm-set! "dead" '()) (sm-set! "dead-warning" #f) (sm-call "DeleteAllDeadSessionsAndReply" #f))
        ((and (sm-get "dead-warning") (equal? (sm-char key) "n")) (sm-set! "dead-warning" #f))
        (else (edit-string! "dead-search" key) (sm-dead-search!))) #t)
    ((sm-key? key (hash "Char" "w") '("Ctrl")) (sm-set! "screen" "new") #t)
    ((sm-key? key "Tab" '()) (toggle-screen) #t)
    ((sm-key? key (hash "Char" "d") '("Ctrl")) (sm-set! "dead-warning" #t) #t)
    ((sm-key? key "Delete" '())
      (define row (sm-at (sm-dead-results) (sm-dead-selection)))
      (when row
        (when (equal? (sm-get "dead-search") "")
          (define old (sm-get "dead-selected"))
          (cond ((= old 0) (sm-set! "dead-selected" #f))
            ((= old (- (length (sm-get "dead")) 1)) (sm-set! "dead-selected" (- old 1))))
          (sm-set! "dead" (filter (lambda (dead) (not (equal? (hash-ref dead "name") (hash-ref row "name")))) (sm-get "dead"))))
        (sm-call (hash "DeleteDeadSessionAndReply" (hash-ref row "name")) #f)) #t)
    ((and (sm-key? key "Esc" '()) (not (sm-get "welcome"))) (yinz-command "CloseSelf") #f) (else #f)))
(define (handle-key key)
  (cond ((equal? (sm-get "screen") "new") (new-key key))
    ((equal? (sm-get "screen") "attach") (search-key key #f))
    ((equal? (sm-get "screen") "dead") (dead-key key))
    ((equal? (sm-get "screen") "notifications")
      (cond ((and (sm-key? key "Tab" '()) (not (sm-get "previous-screen"))) (toggle-screen) #t)
        ((or (sm-key? key "Esc" '()) (sm-key? key (hash "Char" "c") '("Ctrl")))
          (if (sm-get "notification-scroll") (sm-set! "notification-scroll" #f) (leave-notifications)) #t)
        (else (sm-notifications-key! key))))
    ((equal? (sm-get "single-mode") "layout") (layout-key key #t))
    (else (search-key key #t))))
