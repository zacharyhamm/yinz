(require "./common.scm" "./detail.scm")
(provide lm-screen-render)
(define help "<Tab/Arrows> Move, <Enter> Activate, <Esc> Back")
(define (form-render form x y width) (yinz-ui-render form (yinz-ui-coordinates x y width (+ (yinz-ui-height form) 4))))
(define (rename-render screen rows cols)
  (define form (hash-ref screen "form")) (define width (max 1 (lm-sat cols 4)))
  (define height (+ (yinz-ui-height form) 4))
  (define y (quotient (lm-sat rows height) 2)) (define x (quotient (lm-sat cols width) 2))
  (string-append (form-render form x (+ y 2) width)
    (lm-draw (lm-all-color "Rename Layout" 2) x y width)
    (if (>= rows height) (lm-draw (lm-controls-text help '("<Enter>" "<Esc>")) x (+ y height -1)) "")))
(define (new-render screen rows cols)
  (define description-width (string-length "Save it to recreate the session later or share it with others."))
  (define width (min description-width cols))
  (define layout (lm-layout (hash "File" (list "current" (hash-ref screen "metadata")))))
  (define detail-width (lm-sat width 2)) (define detail-height (lm-detail-height layout detail-width))
  (define height (+ 12 detail-height)) (define y (quotient (lm-sat rows height) 2)) (define x (quotient (lm-sat cols width) 2))
  (define form (hash-ref screen "form"))
  (define output (form-render form x (+ y 5) width))
  (define overlay (yinz-ui-op form "OverlayRect"))
  (define details-y (max (+ y 9) (if (lm-present? overlay) (+ (hash-ref overlay "y") (hash-ref overlay "rows")) 0)))
  (define details-height (if (< rows height) (lm-sat rows (+ details-y 2)) detail-height))
  (define full (>= width description-width))
  (define description (if full '("This layout was created from the current session." "Save it to recreate the session later or share it with others.") '("Layout from current session." "Save it to recreate or share the later.")))
  (string-append output (lm-draw (lm-all-color "Save Layout of Current Session" 2) x y width)
    (lm-draw (car description) x (+ y 2)) (lm-draw (cadr description) x (+ y 3))
    (lm-detail-render layout (+ x 2) details-y details-height detail-width)
    (lm-draw (lm-controls-text help '("<Tab>" "<Enter>" "<Esc>")) x (+ details-y details-height 1))))
(define (import-save-line screen width)
  (define form (hash-ref screen "input")) (define value (yinz-ui-value form "name"))
  (define editing (hash-ref screen "editing"))
  (define name (if (and (equal? value "") (not editing)) "RANDOM" value))
  (define suffix (if editing "" " (<r> Rename)"))
  (define uncut (string-append "Save as: " name suffix))
  (define clipped (if (and width (> (yinz-text-width uncut) width)) (lm-truncate-start name (lm-sat width (+ 9 (yinz-text-width suffix)))) name))
  (define cursor (min (string-length clipped) (yinz-ui-input-op form "name" "CursorPosition")))
  (list (string-append "Save as: " clipped suffix) (+ 9 (yinz-text-width (substring clipped 0 cursor)))))
(define (raw-lines text x y width)
  (define output "")
  (lm-indexed (lambda (i line)
      (set! output (string-append output "\u{1b}[" (number->string (+ y i 1)) ";" (number->string (+ x 1)) "H" (if width (lm-truncate line width) line)))) (split-many (trim-end text) "\n")) output)
(define (import-render screen rows cols)
  (define metadata (lm-get screen "metadata" #f)) (define failure (lm-get screen "parse-error" #f))
  (cond [metadata
      (define layout (lm-layout (hash "File" (list "imported" metadata))))
      (define width (min cols (max (string-length "<Enter> - Save, <Esc> - Back") (string-length (car (import-save-line screen #f))))))
      (define detail-width (lm-sat width 2)) (define detail-height (lm-detail-height layout detail-width))
      (define height (+ 6 detail-height)) (define y (quotient (lm-sat rows height) 2)) (define x (quotient (lm-sat cols width) 2))
      (define line (import-save-line screen width))
      (lm-cursor (if (hash-ref screen "editing") (list (+ x (cadr line)) (+ y 2)) json-null))
      (define detail-y (+ y 4)) (define detail-rows (if (< rows height) (lm-sat rows (+ detail-y 2)) detail-height))
      (string-append (lm-draw (lm-all-color "Import Layout" 2) x y width)
        (lm-draw (lm-subcolor (car line) 3 "<r>") x (+ y 2))
        (lm-detail-render layout (+ x 2) detail-y detail-rows detail-width)
        (lm-draw (lm-controls-text "<Enter> - Save, <Esc> - Back" '("<Enter>" "<Esc>")) x (+ detail-y detail-rows 1)))]
    [failure (string-append (lm-draw (lm-all-color "Import Layout" 2) 0 0) (raw-lines failure 0 2 #f)
        (lm-draw (lm-subcolor "<Esc> - Cancel" 3 "<Esc>") 0 (lm-sat rows 2)))]
    [else (define width (min cols (string-length "<Enter> - Save, <Esc> - Back"))) (define y (quotient (lm-sat rows (min 6 rows)) 2)) (define x (quotient (lm-sat cols width) 2))
      (string-append (lm-draw (lm-all-color "Import Layout" 2) x y)
        (lm-draw "Paste your layout here." x (+ y 2))
        (lm-draw (lm-subcolor "<Esc> - Cancel" 3 "<Esc>") x (+ y 4)))]))
(define (error-render screen rows cols)
  (define message (hash-ref screen "message")) (define long (> (yinz-text-width message) (lm-sat cols 4)))
  (define lines (if long (lm-wrap message (lm-sat cols 4)) (list message)))
  (define visible (if long (lm-take lines (lm-sat rows 4)) lines))
  (define x (if long 2 (quotient (lm-sat cols (yinz-text-width message)) 2)))
  (define y (quotient (lm-sat rows (if long (+ 4 (length lines)) 5)) 2))
  (define output (lm-draw (lm-all-color "Error" 6) x y))
  (lm-indexed (lambda (i line) (set! output (string-append output (lm-draw (lm-all-color line 6) x (+ y i 2))))) visible)
  (string-append output (lm-draw "Press any key to continue" x (+ y (if long (+ 4 (length visible)) 4)))))
(define (detail-error-render screen rows cols)
  (define lines (split-many (trim-end (hash-ref screen "message")) "\n"))
  (define available (lm-sat rows 2)) (define width (lm-sat cols 2))
  (define output (lm-draw (lm-all-color (string-append "Error in layout: " (hash-ref screen "name")) 6) 1 0))
  (define (line text row) (string-append "\u{1b}[" (number->string (+ row 3)) ";2H" (yinz-ui-truncate-ansi text width)))
  (if (<= (length lines) available)
    (lm-indexed (lambda (i text) (set! output (string-append output (line text i)))) lines)
    (let* ([content (lm-sat available 1)] [beginning (quotient (+ (* content 6) 9) 10)] [ending (- content beginning)]
        [omitted (- (length lines) beginning ending)] [label (string-append "... " (number->string omitted) " lines omitted ...")])
      (lm-indexed (lambda (i text) (set! output (string-append output (line text i)))) (lm-take lines beginning))
      (set! output (string-append output (lm-draw (lm-all-color label 0) (quotient (lm-sat cols (string-length label)) 2) (+ 2 beginning))))
      (lm-indexed (lambda (i text) (set! output (string-append output (line text (+ beginning i 1))))) (lm-drop lines (- (length lines) ending))))) output)
(define (lm-screen-render screen rows cols)
  (define kind (hash-ref screen "kind"))
  (cond [(equal? kind "rename") (rename-render screen rows cols)] [(equal? kind "new") (new-render screen rows cols)]
    [(equal? kind "import") (import-render screen rows cols)] [(equal? kind "error") (error-render screen rows cols)]
    [else (detail-error-render screen rows cols)]))
