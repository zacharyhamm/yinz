(require "./common.scm" "./controls.scm" "./detail.scm")
(provide lm-list-geometry lm-list-render lm-searching?)
(define (lm-searching? screen) (or (hash-ref screen "typing") (and (hash-ref screen "active") (not (null? (hash-ref screen "results"))))))
(define (lm-list-geometry screen layouts rows cols)
  (define controls-height (if (hash-ref screen "more") 5 3))
  (define searching (if (lm-searching? screen) 1 0))
  (define desired-content (max (+ (length layouts) 1) 5))
  (define content (if (>= (+ desired-content controls-height 1 searching searching) rows)
      (lm-sat rows (+ controls-height 1 searching searching)) desired-content))
  (define controls-width (lm-controls-width screen cols))
  (define content-width (min (lm-sat (quotient cols 2) 2)
      (+ (lm-max (map (lambda (layout) (string-length (hash-ref layout "name"))) layouts))
        (lm-max (map (lambda (layout) (string-length (lm-modified layout))) layouts)) 2)))
  (define table-width (max content-width (quotient (lm-sat controls-width 2) 2)))
  (define total-width (max (+ table-width table-width 2) controls-width))
  (define total-height (+ searching searching content 1 controls-height))
  (hash "x" (quotient (lm-sat cols total-width) 2) "y" (quotient (lm-sat rows total-height) 2)
    "content" content "controls-y" (+ content 1 searching) "width" table-width "detail-x" (+ table-width 2)))
(define (window entries selected rows)
  (cond [(or (null? entries) (= rows 0) (>= selected (length entries))) (list '() 0 0 0)]
    [(<= (length entries) rows) (list entries selected 0 0)]
    [else
      (let loop ([before selected] [after selected] [up #t])
        (if (= (+ (- after before) 1) rows)
          (list (lm-take (lm-drop entries before) rows) (- selected before) before (- (length entries) after 1))
          (cond [(and up (> before 0)) (loop (- before 1) after #f)]
            [(and (not up) (< (+ after 1) (length entries))) (loop before (+ after 1) #t)]
            [(> before 0) (loop (- before 1) after (not up))]
            [else (loop before (+ after 1) (not up))])))]))
(define (lm-list-render screen layouts rows cols)
  (define geo (lm-list-geometry screen layouts rows cols))
  (define x (hash-ref geo "x")) (define searching (lm-searching? screen))
  (define y (+ (hash-ref geo "y") (if (or (hash-ref screen "typing") (hash-ref screen "active")) 1 0)))
  (define table-y (+ y (if searching 1 0)))
  (define content (hash-ref geo "content")) (define width (hash-ref geo "width"))
  (define selected (hash-ref screen "selected"))
  (define visible (window (if searching (map (lambda (result) (list-ref layouts (hash-ref result "index"))) (hash-ref screen "results")) layouts)
      (if searching (hash-ref screen "search-index") selected) (lm-sat content 1)))
  (define entries (car visible)) (define highlighted (cadr visible)) (define above (caddr visible)) (define below (cadddr visible))
  (define (overflow n) (lm-all-color (string-append "[+" (number->string n) "]") 2))
  (define table (list (list " " (if (> above 0) (overflow above) " "))))
  (define modified-width (if (null? entries) 1 (lm-max (map (lambda (entry) (length (bytes->list (string->bytes (lm-modified entry))))) entries))))
  (define name-width (if (> width (+ modified-width 2)) (- width modified-width 2) (quotient width 2)))
  (lm-indexed (lambda (i entry)
      (define name (lm-all-color (lm-truncate (hash-ref entry "name") name-width) (if (lm-get entry "error" #f) 6 1)))
      (when (and (hash-ref screen "active") (not (null? (hash-ref screen "results"))))
        (define indices (hash-ref (list-ref (hash-ref screen "results") (+ above i)) "indices"))
        (set! name (lm-color name 3 (filter (lambda (index) (< index (string-length (hash-ref name "text")))) indices))))
      (define modified (lm-style (lm-modified entry)))
      (when (hash-ref entry "builtin") (set! modified (lm-all-color modified 0)))
      (when (= i highlighted) (set! name (hash-insert name "selected" #t)) (set! modified (hash-insert modified "selected" #t)))
      (set! table (append table (list (list name modified))))) entries)
  (when (> below 0) (set! table (append table (list (list " " (overflow below))))))
  (define filter-text (yinz-ui-value (hash-ref screen "filter") "name"))
  (define filter-line (lm-subcolor (string-append "Layout: " filter-text (if (hash-ref screen "typing") "" " (<Esc> - clear)")) 2 "Layout:"))
  (if (hash-ref screen "typing")
    (unless (equal? filter-text "") (set! filter-line (lm-color filter-line 3 (lm-range 8 (+ 8 (string-length filter-text))))))
    (set! filter-line (lm-subcolor filter-line 3 "<Esc>")))
  (string-append (if searching (lm-draw filter-line x y) "")
    (yinz-ui-table table (yinz-ui-coordinates x table-y width json-null))
    (if (null? entries) ""
      (let ([entry (lm-at layouts selected)])
        (if entry (lm-detail-render entry (+ x (hash-ref geo "detail-x")) (+ table-y 1) (lm-sat content 1) width)
          (lm-draw (lm-all-color "No layout selected" 2) (+ x (hash-ref geo "detail-x")) table-y))))
    (lm-controls-render screen x (+ y (hash-ref geo "controls-y")) cols)))
