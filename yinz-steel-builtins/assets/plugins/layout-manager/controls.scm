(require "./common.scm")
(provide lm-controls-width lm-controls-render)
(define (choose width long short minimum)
  (cond [(>= width (string-length long)) long] [(>= width (string-length short)) short] [else minimum]))
(define (basic width active)
  (if active
    (list (choose width "- <Enter> Open, <↓↑> Nav, <e> Edit, <r> Rename, <Del> Delete" "<Enter>/<↓↑>/<e>/<r>/<Del> Open/Nav/Edit/Rename/Del" "<Enter>/<↓↑>/<e>/<r>/<Del> ...") '("<Enter>" "<↓↑>" "<e>" "<r>" "<Del>"))
    (list (choose width "- <Enter> Open, <↓↑> Nav, </> Search, <e> Edit, <r> Rename, <Del> Del" "<Enter>/<↓↑>/</>/<e>/<r>/<Del> Open/Nav/Search/Edit/Rename/Del" "<Enter>/<↓↑>/</>/<e>/<r>/<Del> ...") '("<Enter>" "<↓↑>" "</>" "<e>" "<r>" "<Del>"))))
(define (override width more)
  (define word (if more "less" "more"))
  (list (choose width (string-append "- <Alt+w> Override Session Layout, <?> " word " options")
      (string-append "<Alt+w> Override, <?> " word " options") "<Alt+w>/<?> ...") '("<Alt+w>" "<?>")))
(define (new-layout width)
  (list (choose width "- New Layout: <n> from current session, <i> import" "New: <n> current, <i> import" "New: <n>/<N>/<i> ...") '("<n>" "<i>")))
(define (retain screen width)
  (define t (hash-ref screen "retain-terminal")) (define p (hash-ref screen "retain-plugin"))
  (define i (cond [(and t p) 2] [t 0] [p 1] [else 3]))
  (define options (cond
      [(>= width (string-length "  <t> Retain:  Terminals  |  Plugins  |  Both  |  None "))
        '(("  <t> Retain: [Terminals] |  Plugins  |  Both  |  None" "[Terminals]")
          ("  <t> Retain:  Terminals  | [Plugins] |  Both  |  None" "[Plugins]")
          ("  <t> Retain:  Terminals  |  Plugins  | [Both] |  None" "[Both]")
          ("  <t> Retain:  Terminals  |  Plugins  |  Both  | [None]" "[None]"))]
      [(>= width (string-length "  <t> Retain:  Term | Pl | Both | None "))
        '(("  <t> Retain: [Term]| Pl | Both | None" "[Term]") ("  <t> Retain:  Term |[Pl]| Both | None" "[Pl]")
          ("  <t> Retain:  Term | Pl |[Both]| None" "[Both]") ("  <t> Retain:  Term | Pl | Both |[None]" "[None]"))]
      [else '(("  <t> R: [T] | P | B | N ..." "[T]") ("  <t> R:  T  |[P]| B | N ..." "[P]")
          ("  <t> R:  T  | P |[B]| N ..." "[B]") ("  <t> R:  T  | P | B |[N]..." "[N]"))]))
  (list-ref options i))
(define (target screen width)
  (if (hash-ref screen "active-tab")
    (if (>= width (string-length "  <a> Target:  All Tabs   | [Current]")) '("  <a> Target:  All Tabs   | [Current]" "[Current]") '("  <a> Target:  All |[Current]" "[Current]"))
    (if (>= width (string-length "  <a> Target: [All Tabs]  |  Current ")) '("  <a> Target: [All Tabs]  |  Current " "[All Tabs]") '("  <a> Target: [All]| Current " "[All]"))))
(define (lm-controls-width screen width)
  (lm-max (map (lambda (line) (string-length (car line)))
      (append (list (basic width #f) (override width (hash-ref screen "more")) (new-layout width))
        (if (hash-ref screen "more") (list (retain screen width) (target screen width)) '())))))
(define (lm-controls-render screen x y width)
  (define (draw line row) (lm-draw (lm-controls-text (car line) (cadr line)) x row))
  (if (hash-ref screen "typing")
    (draw (list (choose width "- <↑↓> Navigate, <Tab> Complete, <Enter> Open, <Alt+w> Apply, <Esc> Manage & New"
          "<↑↓>/<Tab>/<Enter>/<Alt+w>/<Esc> Nav/Complete/Open/Apply/Manage" "<↑↓>/<Tab>/<Enter>/<Alt+w> ...")
        '("<↑↓>" "<Tab>" "<Enter>" "<Alt+w>" "<Esc>")) y)
    (string-append
      (draw (basic width (hash-ref screen "active")) y)
      (draw (override width (hash-ref screen "more")) (+ y 1))
      (lm-draw (lm-subcolor (lm-controls-text (car (new-layout width)) (cadr (new-layout width))) 2 "New Layout:") x (+ y (if (hash-ref screen "more") 4 2)))
      (if (hash-ref screen "more")
        (string-append
          (lm-draw (lm-subcolor (lm-controls-text (car (retain screen width)) '("<t>")) 0 (cadr (retain screen width))) x (+ y 2))
          (lm-draw (lm-subcolor (lm-controls-text (car (target screen width)) '("<a>")) 2 (cadr (target screen width))) x (+ y 3))) ""))))
