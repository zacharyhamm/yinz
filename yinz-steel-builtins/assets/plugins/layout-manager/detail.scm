(require "./common.scm")
(provide lm-detail-render lm-detail-height)
(define (panes metadata width)
  (define named '()) (define count 0)
  (for-each (lambda (tab)
      (for-each (lambda (pane)
          (unless (hash-ref pane "is_builtin_plugin")
            (define name (hash-ref pane "name"))
            (if (lm-present? name) (set! named (append named (list name))) (set! count (+ count 1))))) (hash-ref tab "panes"))) (hash-ref metadata "tabs"))
  (if (and (null? named) (= count 0)) '()
    (append (list (lm-truncate "Panes:" width))
      (map (lambda (name) (string-append "  - " (lm-truncate name (lm-sat width 4)))) named)
      (if (> count 0) (list (lm-truncate (string-append (if (null? named) "  " "  +") (number->string count) " Terminals") width)) '()))))
(define (tabs metadata width)
  (define lines (list (lm-truncate "Tabs:" width)))
  (lm-indexed (lambda (i tab)
      (define name (hash-ref tab "name"))
      (set! lines (append lines (list (string-append "  - " (lm-truncate (if (lm-present? name) name (string-append "Tab " (number->string (+ i 1)))) (lm-sat width 4))))))) (hash-ref metadata "tabs"))
  lines)
(define (detail-lines metadata width)
  (if (> (length (hash-ref metadata "tabs")) 1)
    (let* ([left (quotient (lm-sat width 1) 2)] [right (lm-sat width (+ left 1))])
      (list (panes metadata right) (tabs metadata left) (+ left 1)))
    (list (panes metadata width) '() 0)))
(define (lm-detail-height layout width)
  (define metadata (lm-get layout "metadata" #f))
  (cond [(lm-get layout "error" #f) 3]
    [metadata (define lines (detail-lines metadata width)) (max (length (car lines)) (length (cadr lines)))] [else 1]))
(define (draw-lines lines x y rows title)
  (define output "")
  (lm-indexed (lambda (i line) (set! output (string-append output (lm-draw (if (and title (= i 0)) (lm-all-color line 2) line) x (+ y i))))) (lm-take lines rows))
  (if (> (length lines) rows) (string-append output (lm-draw (lm-all-color "  [...]" 1) x (+ y rows))) output))
(define (lm-detail-render layout x y rows width)
  (define metadata (lm-get layout "metadata" #f))
  (cond [(lm-get layout "error" #f)
      (if (= rows 0) ""
        (let ([lines (lm-take (lm-wrap (hash-ref layout "error_message") width) (lm-sat rows 3))] [output ""])
          (lm-indexed (lambda (i line) (set! output (string-append output (lm-draw (lm-all-color line 6) x (+ y i 1))))) lines)
          (string-append output (lm-draw (lm-subcolor "<m> - Show detailed error" 3 "<m>") x (+ y (length lines) 2)))))]
    [metadata (define lines (detail-lines metadata width))
      (string-append (draw-lines (car lines) x y rows #t)
        (if (> (caddr lines) 0) (draw-lines (cadr lines) (+ x (caddr lines)) y rows #t) ""))]
    [(lm-get layout "builtin" #f)
      (define name (hash-ref layout "name")) (define output "")
      (lm-indexed (lambda (i line) (set! output (string-append output (lm-draw (lm-subcolor line 1 name) x (+ y i)))))
        (lm-take (lm-wrap (string-append name " is a built-in layout. Create your own layouts to automate or share workspace setup.") width) rows)) output]
    [else (lm-draw (lm-all-color "No metadata available" 1) x (+ y 1))]))
