(define agent-provider (hash "kind" "fixture-agent" "executable" "fixture-agent" "aliases" '("fixture-agent-alias")
    "launch" (hash "model_args" '("--model" "{value}"))
    "input" (hash "submit_key" "Ctrl j" "submit_delay_ms" 175 "paste_prefix" "Read: " "command_prefixes" '(":") "newline" "\r")))
(define (load configuration)
  (yinz-then (yinz-wait-for-permissions '("RunCommands")) (lambda (_)
      (yinz-command (hash "Subscribe" '("AgentProvidersChanged"))) (yinz-command (hash "RegisterAgentProvider" agent-provider))
      (yinz-log "fixture agent provider ready"))))
(define (update event)
  (when (and (hash? event) (hash-contains? event "AgentProvidersChanged"))
    (for-each (lambda (provider) (yinz-log (string-append "fixture observed provider " (hash-ref provider "kind")))) (hash-ref event "AgentProvidersChanged"))) #f)
