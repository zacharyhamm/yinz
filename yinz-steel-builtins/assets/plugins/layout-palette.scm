(define (get object key fallback)
  (if (and (hash? object) (hash-contains? object key)) (hash-ref object key) fallback))
(define (present? value) (and value (not (json-null? value))))
(define (command name value) (yinz-command (hash name value)))
(define (clean value)
  (list->string (map (lambda (c) (if (or (equal? c #\newline) (equal? c #\tab)) #\space c))
      (string->list (yinz-text-sanitize value)))))
(define (detail-text value)
  (define text (yinz-text-sanitize value))
  (yinz-markdown-escape (if (> (string-length text) 16384)
      (string-append (list->string (take (string->list text) 16384))
        "\n\n[Details truncated; saved and imported layout contents are unchanged.]") text)))
(define (find predicate items)
  (cond ((null? items) #f) ((predicate (car items)) (car items)) (else (find predicate (cdr items)))))
(define (defer thunk) (lambda (values context) (thunk)))
(define (action id label run) (hash "id" id "label" (yinz-markdown-escape (clean label)) "run" run))
(define (complete message) (hash "type" "complete" "notification" message "view" json-null))
(define (require-success result) (unless (equal? result #t) (error "Host did not complete the operation")))
(define layouts #f)

(define (entry info)
  (define file (get info "File" #f))
  (define builtin (get info "BuiltIn" #f))
  (hash "info" info "id" (yinz-json-string (list (and builtin #t) (if file (car file) builtin)))
    "name" (if file (car (reverse (split-many (car file) "/"))) (or builtin "Inline layout"))
    "file" (and file (car file)) "metadata" (and file (cadr file)) "builtin" (and builtin #t)))
(define (invalid-entry failure)
  (define name (hash-ref failure "layout_name"))
  (hash "id" (yinz-json-string (list #f name)) "name" name "file" name "builtin" #f
    "error" (yinz-format-layout-error (hash-ref failure "error"))))
(define (display-name layout)
  (define name (clean (hash-ref layout "name")))
  (if (equal? (trim name) "")
    (string-append "Unnamed layout " (yinz-json-string (hash-ref layout "name"))) name))
(define (inventory)
  (or layouts
    (let ((session (find (lambda (session) (hash-ref session "is_current_session"))
            (hash-ref (yinz-command "GetSessionList") "live_sessions"))))
      (unless session (error "Current session is no longer available"))
      (map entry (hash-ref session "available_layouts")))))
(define (current id)
  (or (find (lambda (layout) (equal? (hash-ref layout "id") id)) (inventory))
    (error "Layout no longer exists")))
(define (valid id)
  (define layout (current id))
  (when (get layout "error" #f) (error "Fix this layout's errors before opening or applying it"))
  layout)
(define (single-tab? layout)
  (or (hash-ref layout "builtin") (= (length (get (get layout "metadata" #f) "tabs" '())) 1)))
(define (forget id)
  (set! layouts (filter (lambda (layout) (not (equal? (hash-ref layout "id") id))) (inventory))))
(define (remember layout)
  (forget (hash-ref layout "id"))
  (set! layouts (cons layout layouts)))

(define (metadata-text metadata)
  (define lines '())
  (for-each (lambda (key)
      (define value (get metadata key ""))
      (unless (equal? value "")
        (set! lines (append lines (list (string-append (if (equal? key "creation_time") "Created: " "Updated: ") value))))))
    '("creation_time" "update_time"))
  (for-each (lambda (tab)
      (define name (get tab "name" json-null))
      (set! lines (append lines (list (string-append "Tab: " (if (present? name) name "Unnamed")))))
      (for-each (lambda (pane)
          (define name (get pane "name" json-null))
          (set! lines (append lines (list (string-append "  " (if (present? name) name "Terminal")
                  (if (get pane "is_builtin_plugin" #f) " (built-in plugin)" ""))))))
        (hash-ref tab "panes")))
    (get metadata "tabs" '()))
  (detail-text (string-join lines "  \n")))
(define (details layout)
  (cond ((get layout "error" #f) (detail-text (hash-ref layout "error")))
    ((hash-ref layout "builtin") "Built-in layout. Save your session as a custom layout to edit or share it.")
    (else (metadata-text (get layout "metadata" #f)))))
(define (matches? query value)
  (let loop ((wanted (string->list (string-downcase query))) (remaining (string->list (string-downcase value))))
    (cond ((null? wanted) #t) ((null? remaining) #f)
      ((equal? (car wanted) (car remaining)) (loop (cdr wanted) (cdr remaining)))
      (else (loop wanted (cdr remaining))))))
(define (layout-list page previous-query)
  (hash "type" "actions" "title" "Layouts" "initialQuery" previous-query
    "source" (lambda (query context)
      (define all (sort (filter (lambda (layout) (matches? query (display-name layout))) (inventory))
          (lambda (a b) (string<? (hash-ref a "name") (hash-ref b "name")))))
      (define offset (if (equal? query previous-query)
          (min (* page 98) (* (max 0 (- (quotient (+ (length all) 97) 98) 1)) 98)) 0))
      (append
        (map (lambda (layout)
            (hash-insert (action (hash-ref layout "id") (display-name layout)
                (defer (lambda () (layout-actions (hash-ref layout "id")))))
              "description" (cond ((get layout "error" #f) "Invalid layout — view diagnostics or edit")
                ((hash-ref layout "builtin") "Built-in")
                (else (string-append "Custom · " (number->string (length (get (get layout "metadata" #f) "tabs" '()))) " tabs")))))
          (take (list-tail all offset) (min 98 (- (length all) offset))))
        (if (> offset 0) (list (action "page:previous" "Previous layouts…"
              (defer (lambda () (layout-list (- (quotient offset 98) 1) query))))) '())
        (if (< (+ offset 98) (length all)) (list (action "page:next" "More layouts…"
              (defer (lambda () (layout-list (+ (quotient offset 98) 1) query))))) '())))))

(define (open-layout id)
  (define layout (valid id))
  (define tabs (command "NewTabsWithLayoutInfo" (hash-ref layout "info")))
  (when (and (single-tab? layout) (pair? tabs))
    (command "RenameTabWithId" (list (car tabs) (hash-ref layout "name"))))
  (complete "Layout opened"))
(define (apply-layout id)
  (define layout (valid id))
  (hash "type" "form" "title" (string-append "Apply layout: " (yinz-markdown-escape (display-name layout)))
    "description" "Replaces the selected tabs' layout. Panes you do not retain will close, stopping their processes."
    "confirmation" #t "submitLabel" "Apply layout"
    "fields" (list (hash "type" "choice" "id" "retain" "label" "Retain existing panes"
        "options" '("None" "Terminals" "Plugins" "Both") "initialValue" "None")
      (hash "type" "choice" "id" "target" "label" "Target" "options" '("Current tab" "All tabs")
        "initialValue" (if (single-tab? layout) "Current tab" "All tabs")))
    "onSubmit" (lambda (values context)
      (define retain (get values "retain" "None"))
      (command "OverrideLayout" (list (hash-ref (valid id) "info")
          (and (member retain '("Terminals" "Both")) #t) (and (member retain '("Plugins" "Both")) #t)
          (equal? (get values "target" "All tabs") "Current tab") (hash)))
      (complete "Layout application requested"))))
(define (rename-layout id)
  (define layout (current id))
  (hash "type" "form" "title" "Rename layout" "submitLabel" "Rename"
    "fields" (list (hash "type" "text" "id" "name" "label" "Name" "initialValue" (hash-ref layout "file")))
    "onSubmit" (lambda (values context)
      (define old (current id))
      (define name (get values "name" ""))
      (when (equal? (trim name) "") (error "Layout name cannot be empty"))
      (require-success (command "RenameLayout" (hash "old_layout_name" (hash-ref old "file") "new_layout_name" name)))
      (forget id)
      (remember (if (get old "error" #f)
          (hash-insert (hash-insert (hash-insert old "name" name) "file" name) "id" (yinz-json-string (list #f name)))
          (entry (hash "File" (list name (hash-ref old "metadata"))))))
      (complete "Layout renamed"))))
(define (delete-layout id)
  (define layout (current id))
  (hash "type" "form" "title" (string-append "Delete layout: " (yinz-markdown-escape (display-name layout)))
    "description" "Permanently removes this saved layout file. Running tabs and panes keep running."
    "fields" '() "confirmation" #t "submitLabel" "Delete layout"
    "onSubmit" (lambda (values context)
      (require-success (command "DeleteLayout" (hash "layout_name" (hash-ref (current id) "file"))))
      (forget id) (complete "Layout deleted"))))
(define (layout-actions id)
  (define layout (current id))
  (hash "type" "actions" "title" (yinz-markdown-escape (display-name layout)) "description" (details layout)
    "actions" (append
      (if (get layout "error" #f) '()
        (list (action "open" "Open layout in new tabs" (defer (lambda () (open-layout id))))
          (action "apply" "Apply layout…" (defer (lambda () (apply-layout id))))))
      (list (action "details" (if (get layout "error" #f) "Layout diagnostics…" "Layout details…")
          (defer (lambda () (hash "type" "text" "title" "Layout details" "text" (details (current id)))))))
      (if (hash-ref layout "file")
        (list (action "edit" "Edit layout in editor" (defer (lambda ()
                (require-success (command "EditLayout" (hash "layout_name" (hash-ref (current id) "file") "context" (hash))))
                (complete "Layout editor opened"))))
          (action "rename" "Rename layout…" (defer (lambda () (rename-layout id))))
          (action "delete" "Delete layout…" (defer (lambda () (delete-layout id))))) '()))))

(define (save name source metadata)
  (when (equal? name "") (set! name (yinz-command "GenerateRandomName")))
  (when (equal? (trim name) "") (error "Layout name cannot be only whitespace"))
  (require-success (command "SaveLayout" (hash "layout_name" name "layout_kdl" source "overwrite" #f)))
  (remember (entry (hash "File" (list name metadata))))
  (complete "Layout saved"))
(define (dump values context)
  (define tab (if (equal? (get values "target" "All tabs") "Current tab") (get context "tabId" json-null) json-null))
  (when (and (equal? (get values "target" "All tabs") "Current tab") (not (present? tab)))
    (error "Current tab is no longer available"))
  (define result (command "DumpSessionLayout" (hash "tab_index" tab)))
  (unless (present? (get result "metadata" #f)) (error "Failed to retrieve session layout metadata"))
  result)
(define (save-session values context)
  (define preview (dump values context))
  (hash "type" "form" "title" "Save session as layout" "submitLabel" "Save layout"
    "description" (string-append "Save captures the selected tabs' current state.  \nPreview:  \n" (metadata-text (hash-ref preview "metadata")))
    "fields" (list (hash "type" "text" "id" "name" "label" "Name (optional)" "initialValue" (get values "name" ""))
      (hash "type" "choice" "id" "target" "label" "Save" "options" '("All tabs" "Current tab")
        "initialValue" (get values "target" "All tabs")))
    "onSubmit" (lambda (values context)
      (define captured (dump values context))
      (save (get values "name" "") (hash-ref captured "layout") (hash-ref captured "metadata")))
    "actions" (list (action "refresh" "Refresh layout preview" save-session))))
(define (import-layout values context)
  (hash "type" "form" "title" "Import layout" "submitLabel" "Preview layout"
    "fields" (list (hash "type" "text" "id" "name" "label" "Name (optional)" "initialValue" (get values "name" ""))
      (hash "type" "multiline" "id" "layout" "label" "Layout KDL" "initialValue" (get values "layout" "")
        "help" "Paste a layout. Shift+Enter inserts a newline."))
    "onSubmit" (lambda (values context)
      (define source (get values "layout" ""))
      (when (equal? (trim source) "") (error "Please paste a layout first"))
      (with-handler (lambda (failure)
          (hash "type" "text" "title" "Invalid layout"
            "text" (detail-text
              (string-append (trim (error-object-message failure)) "\n" (yinz-format-layout-error source)))))
        (define metadata (command "ParseLayout" source))
        (unless (present? metadata) (error "Cannot save layout without metadata"))
        (hash "type" "form" "title" "Save imported layout" "submitLabel" "Save layout" "description" (metadata-text metadata)
          "fields" (list (hash "type" "text" "id" "name" "label" "Name (optional)" "initialValue" (get values "name" "")))
          "onSubmit" (lambda (values context) (save (get values "name" "") source metadata))
          "actions" (list (action "edit" "Edit layout KDL…"
              (lambda (values context) (import-layout (hash-insert values "layout" source) context)))))))))
(define (load configuration)
  (command "Subscribe" '("AvailableLayoutInfo"))
  (yinz-palette-register "layouts" "Layouts"
    (list (hash-insert (action "layouts" "Layouts…" (defer (lambda () (layout-list 0 ""))))
        "aliases" '("layout manager" "open layout" "apply layout" "edit layout" "rename layout" "delete layout"))
      (action "save-layout" "Save session as layout…" save-session)
      (action "import-layout" "Import layout…" import-layout))))
(define (update event)
  (when (and (hash? event) (hash-contains? event "AvailableLayoutInfo"))
    (define payload (hash-ref event "AvailableLayoutInfo"))
    (set! layouts (append (map entry (car payload)) (map invalid-entry (cadr payload)))))
  #f)
