(define (get object key fallback)
  (if (and (hash? object) (hash-contains? object key)) (hash-ref object key) fallback))
(define (present? value) (and value (not (equal? value 'json-null))))
(define (command name value) (yinz-command (hash name value)))
(define (clean value)
  (list->string (map (lambda (c) (if (or (equal? c #\newline) (equal? c #\tab)) #\space c))
      (string->list (yinz-text-sanitize value)))))
(define (clip value count) (list->string (take (string->list value) (min count (length (string->list value))))))
(define (find predicate items)
  (cond ((null? items) #f) ((predicate (car items)) (car items)) (else (find predicate (cdr items)))))
(define (sorted items key less?) (sort items (lambda (a b) (less? (key a) (key b)))))
(define (by-name items) (sorted items (lambda (item) (hash-ref item "name")) string<?))
(define (by-position items) (sorted items (lambda (item) (hash-ref item "position")) <))
(define (flat-map f items) (apply append (map f items)))
(define (complete message) (hash "type" "complete" "notification" message "view" 'json-null))
(define (defer thunk) (lambda (values context) (thunk)))
(define (action id label run) (hash "id" id "label" (yinz-markdown-escape label) "search" label "run" run))
(define (display-description item description) (hash-insert item "description" (yinz-markdown-escape (clip description 256))))
(define (describe item description) (hash-insert (display-description item description) "search" (string-append (get item "search" "") " " description)))

(define (load configuration)
  (yinz-palette-register "sessions" "Sessions" root-actions))

(define (snapshot) (yinz-command "GetSessionList"))
(define (current state)
  (or (find (lambda (session) (hash-ref session "is_current_session")) (hash-ref state "live_sessions"))
    (error "Current session is no longer available")))
(define (session-named state name)
  (find (lambda (session) (equal? (hash-ref session "name") name)) (hash-ref state "live_sessions")))
(define (saved state)
  (sort (map car (filter (lambda (entry) (not (session-named state (car entry))))
        (hash-ref state "resurrectable_sessions"))) string<?))
(define (matches? query value)
  (let loop ((wanted (string->list (string-downcase query))) (remaining (string->list (string-downcase value))))
    (cond ((null? wanted) #t) ((null? remaining) #f)
      ((equal? (car wanted) (car remaining)) (loop (cdr wanted) (cdr remaining)))
      (else (loop wanted (cdr remaining))))))

(define (list-results title collect page previous-query)
  (hash "type" "actions" "title" (yinz-markdown-escape title) "initialQuery" previous-query
    "source"
    (lambda (query context)
      (define all (filter (lambda (item)
            (matches? query (get item "search" (hash-ref item "label"))))
          (collect)))
      (define offset (if (equal? query previous-query)
          (min (* page 98) (* (max 0 (- (quotient (+ (length all) 97) 98) 1)) 98)) 0))
      (define items
        (take (list-tail all offset) (min 98 (- (length all) offset))))
      (append items
        (if (> offset 0)
          (list (action "page:previous" "Previous results…"
              (defer (lambda () (list-results title collect (- (quotient offset 98) 1) query))))) '())
        (if (< (+ offset 98) (length all))
          (list (action "page:next" "More results…"
              (defer (lambda () (list-results title collect (+ (quotient offset 98) 1) query))))) '())))))

(define (validate-name name optional?)
  (unless (and optional? (equal? name ""))
    (when (or (equal? (trim name) "") (member name '("." ".."))
        (string-contains? name "/") (not (equal? (clean name) name))
        (and (starts-with? name "pty-broker-v") (ends-with? name ".sock")))
      (error "Enter a valid session name without slashes or controls"))
    (define maximum (get (yinz-command "GetPluginIds") "max_session_name_bytes" 'json-null))
    (when (and (present? maximum) (> (utf8-length name) maximum))
      (error (string-append "Session name must be at most " (number->string maximum) " bytes")))))

(define (panes-in session tab)
  (get (hash-ref (hash-ref session "panes") "panes") (number->string (hash-ref tab "position")) '()))
(define (available-pane? pane)
  (and (not (hash-ref pane "is_suppressed")) (hash-ref pane "is_selectable")))
(define (switch-to name tab-id pane)
  (define state (snapshot))
  (define live (session-named state name))
  (unless (or live (member name (saved state))) (error "Session no longer exists"))
  (define tab (and live tab-id (find (lambda (tab) (= (hash-ref tab "tab_id") tab-id)) (hash-ref live "tabs"))))
  (when (and tab-id (not tab)) (error "Tab no longer exists"))
  (when (and pane
      (not (and live
          (find (lambda (candidate)
              (and (= (hash-ref candidate "id") (car pane))
                (equal? (hash-ref candidate "is_plugin") (cadr pane))
                (available-pane? candidate)))
            (flat-map (lambda (tab) (panes-in live tab)) (hash-ref live "tabs"))))))
    (error "Pane no longer exists"))
  (if (and live (hash-ref live "is_current_session"))
    (begin
      (cond (pane (command (if (cadr pane) "FocusPluginPane" "FocusTerminalPane") (list (car pane) #t #f)))
        (tab (command "GoToTabWithId" (hash-ref tab "tab_id"))))
      (complete "Focus requested"))
    (begin
      (command "SwitchSession" (hash "name" name "tab_position" (if tab (hash-ref tab "position") 'json-null)
          "pane_id" (if pane pane 'json-null) "layout" 'json-null "cwd" 'json-null))
      (complete "Session switch requested"))))

(define (collision name state)
  (define running (session-named state name))
  (and (or running (member name (saved state)))
    (hash "type" "actions" "title" (string-append "Session " (yinz-markdown-escape (clean name)) " already exists")
      "actions" (list (action "existing" (if running "Switch to this session" "Resurrect this session")
          (defer (lambda () (switch-to name #f #f))))))))
(define (layout-label layout)
  (cond ((hash-contains? layout "BuiltIn") (string-append (hash-ref layout "BuiltIn") " (built-in)"))
    ((hash-contains? layout "File") (string-append (car (hash-ref layout "File")) " (custom)"))
    (else "Inline layout")))

(define (create-session values context)
  (define name (get values "name" ""))
  (validate-name name #t)
  (define state (snapshot))
  (or (collision name state)
    (let* ((directory (get values "directory" "")) (selected (get values "layout" "Default"))
        (layout (if (equal? selected "Default") 'json-null
            (find (lambda (layout) (equal? (layout-label layout) selected))
              (hash-ref (current state) "available_layouts")))))
      (unless layout (error "Layout no longer exists"))
      (command "SwitchSession" (hash "name" (if (equal? name "") 'json-null name)
          "tab_position" 'json-null "pane_id" 'json-null "layout" layout
          "cwd" (if (equal? directory "") 'json-null directory)))
      (complete "Session creation requested"))))

(define (configure-session values context)
  (define layouts (sort (map layout-label (hash-ref (current (snapshot)) "available_layouts")) string<?))
  (hash "type" "form" "title" "Configure new session" "submitLabel" "Create and switch"
    "fields" (list (hash "type" "text" "id" "name" "label" "Name (optional)" "initialValue" (get values "name" ""))
      (hash "type" "choice" "id" "layout" "label" "Layout (type to search)"
        "options" (cons "Default" layouts) "initialValue" "Default")
      (hash "type" "directory" "id" "directory" "label" "Directory" "initialValue" (get values "directory" "")))
    "onSubmit" create-session))
(define (new-session)
  (hash "type" "form" "title" "New session" "submitLabel" "Create and switch"
    "fields" (list (hash "type" "text" "id" "name" "label" "Name (optional)" "initialValue" ""))
    "onSubmit" create-session
    "actions" (list (action "configure" "Configure…" configure-session))))

(define (pane-before? a b)
  (if (equal? (hash-ref a "is_plugin") (hash-ref b "is_plugin"))
    (< (hash-ref a "id") (hash-ref b "id")) (not (hash-ref a "is_plugin"))))
(define (pane-count session tab)
  (length (filter available-pane? (panes-in session tab))))
(define (session-summary session)
  (define tabs (hash-ref session "tabs"))
  (string-append (if (hash-ref session "is_current_session") "Current session" "Running")
    " · Tabs: " (number->string (length tabs)) " · Panes: "
    (number->string (apply + (cons 0 (map (lambda (tab) (pane-count session tab)) tabs)))) " · Clients: "
    (number->string (hash-ref session "connected_clients"))))
(define (pane-status pane)
  (define status (get pane "exit_status" 'json-null))
  (if (hash-ref pane "exited")
    (string-append "Exited (" (if (present? status) (number-text status) "unknown status") ")")
    "Running"))
(define (saved-summary state name)
  (define entry (find (lambda (entry) (equal? (car entry) name)) (hash-ref state "resurrectable_sessions")))
  (string-append "Saved · Created " (number->string (hash-ref (cadr entry) "secs")) "s ago"))
(define (session-destinations session kind)
  (define name (hash-ref session "name"))
  (flat-map
    (lambda (tab)
      (define tab-id (hash-ref tab "tab_id"))
      (define context (string-append (clean name) " · " (clean (hash-ref tab "name"))
          " (tab " (number->string (+ (hash-ref tab "position") 1)) ")"))
      (if (equal? kind "tab")
        (list (display-description (action (yinz-json-string (list name tab-id)) context (defer (lambda () (switch-to name tab-id #f))))
            (string-append "Panes: " (number->string (pane-count session tab)))))
        (map (lambda (pane)
            (define id (hash-ref pane "id"))
            (define plugin? (hash-ref pane "is_plugin"))
            (define display-title (get pane "display_title" 'json-null))
            (define title (clean (if (present? display-title) display-title (hash-ref pane "title"))))
            (describe
              (action (yinz-json-string (list name plugin? id))
                (string-append "[" (if plugin? "plugin" "terminal") "_" (number->string id) "] "
                  (if (equal? title "") "Untitled pane" title))
                (defer (lambda () (switch-to name tab-id (list id plugin?)))))
              (string-append context " · " (pane-status pane))))
          (filter available-pane? (sort (panes-in session tab) pane-before?)))))
    (by-position (hash-ref session "tabs"))))

(define (destinations kind)
  (list-results
    (cond ((equal? kind "tab") "Find tab") ((equal? kind "pane") "Find pane")
      ((equal? kind "saved") "Resurrect session") (else "Switch session"))
    (lambda ()
      (define state (snapshot))
      (append
        (if (equal? kind "saved") '()
          (flat-map (lambda (session)
              (define name (hash-ref session "name"))
              (if (equal? kind "session")
                (list (display-description (describe (action (yinz-json-string (list name)) (clean name)
                        (defer (lambda () (switch-to name #f #f)))) "Running") (session-summary session)))
                (session-destinations session kind)))
            (by-name (hash-ref state "live_sessions"))))
        (if (member kind '("session" "saved"))
          (map (lambda (name)
              (display-description (describe (action (yinz-json-string (list name)) (clean name)
                    (defer (lambda () (switch-to name #f #f)))) "Saved") (saved-summary state name)))
            (saved state)) '()))) 0 ""))

(define (confirm title consequences targets read mutate)
  (when (null? targets) (error "No matching targets remain"))
  (define captured (sort targets string<?))
  (hash "type" "form" "title" (string-append title ": " (string-join (map (lambda (name) (yinz-markdown-escape (clean name))) captured) ", ") " — " consequences)
    "fields" '() "confirmation" #t "submitLabel" title
    "onSubmit" (lambda (values context)
      (define now (sort (read) string<?))
      (if (equal? now captured) (begin (mutate captured) #f)
        (confirm "Targets changed — confirm again" consequences now read mutate)))))
(define (require-success result)
  (unless (equal? result #t) (error "Host did not complete the operation")))
(define (kill-sessions names)
  (define (read)
    (map (lambda (session) (hash-ref session "name"))
      (filter (lambda (session) (if names (member (hash-ref session "name") names)
            (not (hash-ref session "is_current_session"))))
        (hash-ref (snapshot) "live_sessions"))))
  (confirm "Kill sessions" "Stops their processes and disconnects their clients" (read) read
    (lambda (targets) (require-success (command "KillSessionsAndReply" targets)))))
(define (delete-saved names)
  (define (read) (filter (lambda (name) (or (not names) (member name names))) (saved (snapshot))))
  (confirm "Delete saved sessions" "Permanently removes saved state; these sessions cannot be resurrected"
    (read) read (lambda (targets) (for-each (lambda (name) (require-success (command "DeleteDeadSessionAndReply" name))) targets))))

(define (number-text value) (if (string? value) value (number->string value)))
(define (as-number value) (if (string? value) (string->number value) value))
(define (details session)
  (define last-save (and (hash-ref session "is_current_session") (yinz-command "CurrentSessionLastSavedTime")))
  (define lines
    (append
      (list (string-append "Age: " (number->string (hash-ref (hash-ref session "creation_time") "secs")) "s")
        (string-append "Connected clients: " (number->string (hash-ref session "connected_clients"))))
      (if last-save (list (string-append "Last save: " (if (present? last-save)
              (string-append (number->string (quotient (as-number last-save) 1000)) "s ago")
              "Never"))) '())
      (flat-map (lambda (tab)
          (cons (string-append "\nTab " (number->string (+ (hash-ref tab "position") 1)) ": " (hash-ref tab "name"))
            (map (lambda (pane)
                (string-append "  " (if (hash-ref pane "is_plugin") "Plugin" "Terminal") " "
                  (number->string (hash-ref pane "id")) ": " (hash-ref pane "title") " — "
                  (pane-status pane)))
              (panes-in session tab))))
        (by-position (hash-ref session "tabs")))))
  (hash "type" "text" "title" (string-append "Session details: " (yinz-markdown-escape (clean (hash-ref session "name"))))
    "text" (string-join (map (lambda (line) (yinz-markdown-escape (yinz-text-sanitize line))) lines) "  \n")))

(define (disconnect-targets) (sort (map number-text (yinz-command "GetDisconnectTargets")) string<?))
(define (disconnect changed? targets)
  (when (null? targets) (error "No other clients are connected"))
  (hash "type" "form" "title"
    (string-append (if changed? "Clients changed — confirm again. " "") "Disconnect clients "
      (string-join targets ", ") "? Their sessions and processes keep running.")
    "fields" '() "confirmation" #t "submitLabel" "Disconnect other clients"
    "onSubmit" (lambda (values context)
      (define now (disconnect-targets))
      (if (equal? now targets)
        (begin
          ;; shortcut: clients can change after revalidation; use guarded disconnection if atomic confirmation is needed.
          (yinz-command "DisconnectOtherClients") (complete "Client disconnection requested"))
        (disconnect #t now)))))

(define (rename-current)
  (hash "type" "form" "title" "Rename current session" "submitLabel" "Rename"
    "fields" (list (hash "type" "text" "id" "name" "label" "Name" "initialValue" (hash-ref (current (snapshot)) "name")))
    "onSubmit" (lambda (values context)
      (define name (get values "name" ""))
      (validate-name name #f)
      (define state (snapshot))
      (and (not (equal? name (hash-ref (current state) "name")))
        (or (collision name state)
          (begin (command "RenameSession" name) (complete "Session rename requested")))))))

(define (notification-message notification)
  (define outcome (get notification "outcome" 'json-null))
  (string-append (if (present? outcome)
      (string-append "[" (hash-ref (hash-ref outcome "original") "source")
        (if (hash-ref outcome "suppressed") ", suppressed" "") "] ") "")
    (hash-ref notification "message")))
(define (notification-age notification)
  (define seconds (quotient (max 0 (- (yinz-wall-clock-ms) (as-number (hash-ref notification "received_at_unix_ms")))) 1000))
  (cond ((< seconds 60) "just now") ((< seconds 3600) (string-append (number->string (quotient seconds 60)) "m ago"))
    ((< seconds 86400) (string-append (number->string (quotient seconds 3600)) "h ago"))
    (else (string-append (number->string (quotient seconds 86400)) "d ago"))))
(define (notifications)
  (list-results "Notifications"
    (lambda ()
      (map (lambda (notification)
          (define message (notification-message notification))
          (define label (clip (clean (hash-ref notification "message")) 160))
          (describe (action (number-text (hash-ref notification "id")) (if (equal? label "") "Notification" label)
              (defer (lambda () (hash "type" "text" "title" (string-append "Notification · received " (notification-age notification))
                    "text" (yinz-markdown-escape (yinz-text-sanitize message))))))
            (string-append "Received " (notification-age notification) " · " (clean message))))
        (sort (yinz-command "ListNotifications")
          (lambda (a b)
            (define ta (as-number (hash-ref a "received_at_unix_ms")))
            (define tb (as-number (hash-ref b "received_at_unix_ms")))
            (if (= ta tb) (> (as-number (hash-ref a "id")) (as-number (hash-ref b "id"))) (> ta tb)))))) 0 ""))

(define root-actions
  (list
    (action "switch-session" "Switch session…" (defer (lambda () (destinations "session"))))
    (hash-insert (action "find-tab" "Find tab…" (defer (lambda () (destinations "tab")))) "aliases" '("switch tab"))
    (hash-insert (action "find-pane" "Find pane…" (defer (lambda () (destinations "pane")))) "aliases" '("focus pane"))
    (action "new-session" "New session…" (defer new-session))
    (action "resurrect" "Resurrect session…" (defer (lambda () (destinations "saved"))))
    (action "rename" "Rename current session…" (defer rename-current))
    (action "save" "Save current session" (defer (lambda () (require-success (yinz-command "SaveSession")) (complete "Session saved"))))
    (action "kill" "Kill session…"
      (defer (lambda ()
          (list-results "Kill session"
            (lambda () (map (lambda (session)
                  (define name (hash-ref session "name"))
                  (action (yinz-json-string (list name)) (clean name) (defer (lambda () (kill-sessions (list name))))))
                (by-name (hash-ref (snapshot) "live_sessions")))) 0 ""))))
    (action "kill-others" "Kill all other sessions…" (defer (lambda () (kill-sessions #f))))
    (action "delete" "Delete saved session…"
      (defer (lambda ()
          (list-results "Delete saved session"
            (lambda () (map (lambda (name) (action (yinz-json-string (list name)) (clean name)
                    (defer (lambda () (delete-saved (list name))))))
                (saved (snapshot)))) 0 ""))))
    (action "delete-all" "Delete all saved sessions…" (defer (lambda () (delete-saved #f))))
    (action "disconnect" "Disconnect other clients" (defer (lambda () (disconnect #f (disconnect-targets)))))
    (action "details" "Session details…"
      (defer (lambda ()
          (list-results "Session details"
            (lambda () (map (lambda (session)
                  (define name (hash-ref session "name"))
                  (action (yinz-json-string (list name)) (clean name)
                    (defer (lambda ()
                        (define now (session-named (snapshot) name))
                        (unless now (error "Session no longer exists"))
                        (details now)))))
                (by-name (hash-ref (snapshot) "live_sessions")))) 0 ""))))
    (action "notifications" "Notifications…" (defer notifications))))
