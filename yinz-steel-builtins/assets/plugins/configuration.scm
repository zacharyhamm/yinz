(require "./configuration/presets.scm" "./configuration/rebind.scm" "./configuration/render.scm" "./bar/keys.scm")

(define setup? #f)
(define screen "rebind")
(define mode-info #f)
(define notification #f)
(define screen-notification #f)
(define primary '("Ctrl"))
(define secondary '("Alt"))
(define main-leader #f)
(define dirty? #f)
(define focus #f)
(define modifier-index 0)
(define preset-selected #f)
(define possible-modifiers '("Ctrl" "Alt" "Super" "Shift"))
(define (get object key fallback)
  (if (and (hash? object) (hash-contains? object key)) (hash-ref object key) fallback))
(define (locked?) (and mode-info (equal? (get mode-info "base_mode" #f) "Locked")))
(define (read-leaders)
  (when mode-info
    (define leaders (configuration-infer-leaders mode-info))
    (when (hash-ref leaders "primary") (set! primary (hash-ref leaders "primary")))
    (when (hash-ref leaders "secondary") (set! secondary (hash-ref leaders "secondary")))
    (set! main-leader (hash-ref leaders "main"))))
(define (reset-rebind)
  (set! focus #f) (set! modifier-index 0) (set! dirty? #f)
  (set! primary '("Ctrl")) (set! secondary '("Alt")) (set! main-leader #f)
  (read-leaders))
(define (switch-screen)
  (set! screen-notification #f)
  (if (equal? screen "rebind")
    (begin (set! screen "presets") (set! preset-selected #f) (set! primary '("Ctrl")) (set! secondary '("Alt")))
    (begin (set! screen "rebind") (reset-rebind))))
(define (select-focus target) (set! focus target) (set! modifier-index 0))
(define (move-selection key)
  (if (locked?)
    (cond ((equal? focus "secondary")
        (cond ((member key '("Left" "Right")) (select-focus "unlock"))
          ((equal? key "Up") (if (= modifier-index 0) (select-focus "unlock") (set! modifier-index (- modifier-index 1))))
          ((equal? key "Down") (if (= modifier-index 3) (select-focus "unlock") (set! modifier-index (+ modifier-index 1))))))
      ((equal? focus "unlock") (select-focus "secondary"))
      (else (select-focus "unlock")))
    (cond ((not (member focus '("primary" "secondary"))) (select-focus "primary"))
      ((member key '("Left" "Right")) (set! focus (if (equal? focus "primary") "secondary" "primary")))
      ((equal? key "Down") (set! modifier-index (min 3 (+ modifier-index 1))))
      ((equal? key "Up") (set! modifier-index (max 0 (- modifier-index 1)))))))
(define (toggle-modifier)
  (define modifier (list-ref possible-modifiers modifier-index))
  (define old (if (equal? focus "primary") primary secondary))
  (define new (filter (lambda (candidate) (if (equal? modifier candidate) (not (member candidate old)) (member candidate old))) bar-modifiers))
  (if (equal? focus "primary") (set! primary new) (set! secondary new))
  (set! dirty? #t))
(define (apply-rebind save?)
  (yinz-command (hash "RebindKeys" (configuration-rebind-plan mode-info primary secondary main-leader (locked?) save?)))
  (set! screen-notification (if save? "Configuration applied and saved to disk." "Configuration applied to current session."))
  (reset-rebind))
(define (plain? key) (null? (get key "key_modifiers" '())))
(define (ctrl? key character)
  (and (equal? (get key "key_modifiers" '()) '("Ctrl")) (equal? (get key "bare_key" #f) (hash "Char" character))))
(define (rebind-key key)
  (define bare (get key "bare_key" #f))
  (cond ((ctrl? key "a") (apply-rebind #t))
    ((and (plain? key) (equal? bare "Enter")) (apply-rebind #f))
    ((ctrl? key "c") (reset-rebind))
    ((and (plain? key) (equal? bare "Esc"))
      (if (equal? focus "capture") (set! focus #f) (yinz-command "CloseSelf")))
    ((and (plain? key) (equal? bare (hash "Char" " ")))
      (cond ((equal? focus "unlock") (select-focus "capture"))
        ((member focus '("primary" "secondary")) (toggle-modifier))))
    ((and (plain? key) (member bare '("Left" "Right" "Up" "Down"))) (move-selection bare))
    ((equal? focus "capture") (set! main-leader key) (set! focus #f) (set! dirty? #t)))
  #t)
(define (apply-preset save?)
  (define locked (= preset-selected 1))
  (define source ((if locked configuration-unlock-first-keybinds configuration-default-keybinds)
      (string-join primary " ") (string-join secondary " ")))
  (set! preset-selected #f)
  ;; The server processes both commands in order, so the mode sees the new bindings.
  (yinz-command (hash "Reconfigure" (list source save?)))
  (yinz-command (hash "SwitchToMode" (if locked "Locked" "Normal")))
  (if setup? (yinz-command "CloseSelf")
    (set! screen-notification (if save? "Configuration applied and saved to disk." "Configuration applied to current session."))))
(define (preset-key key)
  (define bare (get key "bare_key" #f))
  (cond
    ((and (plain? key) (equal? bare "Down"))
      (set! preset-selected (cond ((not preset-selected) 0) ((= preset-selected 0) 1) (else #f))) #t)
    ((and (plain? key) (equal? bare "Up"))
      (set! preset-selected (cond ((not preset-selected) 1) ((= preset-selected 1) 0) (else #f))) #t)
    ((and (plain? key) (equal? bare "Enter"))
      (if preset-selected (begin (apply-preset setup?) (not setup?)) (begin (set! preset-selected 0) #t)))
    ((and (not setup?) (ctrl? key "a") preset-selected) (apply-preset #t) #t)
    ((or (and (plain? key) (equal? bare "Esc")) (ctrl? key "c")) (yinz-command "CloseSelf") #t)
    (else #f)))
(define (load configuration)
  (set! setup? (equal? (get configuration "is_setup_wizard" "false") "true"))
  (yinz-command (hash "Subscribe" '("Key" "FailedToWriteConfigToDisk" "ModeUpdate")))
  (let ((id (hash-ref (yinz-command "GetPluginIds") "plugin_id")))
    (if setup?
      (begin
        (set! screen "presets") (set! preset-selected 0)
        (yinz-command (hash "RenamePluginPane" (list id "First Run Setup Wizard (Step 1/1)")))
        (for-each (lambda (ignored) (yinz-command (hash "Resize" "Increase"))) '(1 2 3)))
      (yinz-command (hash "RenamePluginPane" (list id "Configuration"))))))
(define (update event)
  (cond
    ((get event "ModeUpdate" #f)
      (define next (hash-ref event "ModeUpdate"))
      (define changed-base (not (equal? (get mode-info "base_mode" #f) (get next "base_mode" #f))))
      (set! mode-info next)
      (cond ((equal? screen "rebind") (if changed-base (reset-rebind) (unless dirty? (read-leaders))))
        ((and changed-base (not setup?)) (set! preset-selected #f))) #t)
    ((get event "FailedToWriteConfigToDisk" #f)
      (define failure (hash-ref event "FailedToWriteConfigToDisk"))
      (define file (get failure "file_path" json-null))
      (define reason (get failure "reason" json-null))
      (set! notification (string-append
          (if (json-null? file) "Failed to write configuration file." (string-append "Failed to write configuration file: " file))
          (if (json-null? reason) "" (string-append " " reason)))) #t)
    ((get event "Key" #f)
      (define key (hash-ref event "Key"))
      (cond (notification (set! notification #f) #t)
        ((and (not setup?) (plain? key) (equal? (hash-ref key "bare_key") "Tab")) (switch-screen) #t)
        (screen-notification (set! screen-notification #f) #t)
        ((equal? screen "rebind") (rebind-key key))
        (else (preset-key key))))
    (else #f)))
(define (render rows cols)
  (configuration-render
    (hash "mode" mode-info "setup" setup? "screen" screen "locked" (locked?) "primary" primary "secondary" secondary
      "main" main-leader "focus" focus "index" modifier-index "preset" preset-selected
      "notification" (or notification screen-notification)) rows cols))
