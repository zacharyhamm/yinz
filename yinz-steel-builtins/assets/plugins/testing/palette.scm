(require "./common.scm")
(provide p-init p-commands p-reply p-scope p-context p-roots p-discover p-execute p-open p-action p-view p-choose p-submit p-raw)
(define state (vector (hash) (hash) '() #f))
(define (p-commands) (map (lambda (command) (hash-ref command "CommandPalette")) (t-named "CommandPalette")))
(define (p-scope) (vector-ref state 0))
(define (p-context) (vector-ref state 1))
(define (p-roots) (vector-ref state 2))
(define (p-reply)
  (define command (t-last (p-commands))) (assert-equal (hash-ref command "type") "reply")
  (define result (hash-ref command "result"))
  (when (hash-contains? result "Err") (error (hash-ref result "Err"))) (hash-ref result "Ok"))
(define (p-init path replies context . options)
  (t-load path (t-merge (hash "RequestPluginPermissions" json-null "CommandPalette" json-null) replies))
  (test-event (hash "PermissionRequestResult" "Granted"))
  (define registration (t-find (lambda (command) (equal? (hash-ref command "type") "register")) (p-commands))) (assert registration)
  (vector-set! state 0 (hash "registration" (hash-ref registration "registration") "opening" 1 "view" 0 "revision" 1))
  (vector-set! state 1 context)
  (vector-set! state 3 (and (pair? options) (car options)))
  (vector-set! state 2 (p-discover json-null (if (> (length options) 1) (cadr options) ""))))
(define (p-raw handle values)
  (vector-set! state 0 (hash-insert (p-scope) "revision" (+ 1 (hash-ref (p-scope) "revision"))))
  (test-palette (hash "type" "execute" "scope" (p-scope) "context" (p-context) "handle" handle "values" values) (hash-ref (p-context) "clientId")))
(define (p-discover . arguments)
  (vector-set! state 0 (hash-insert (p-scope) "revision" (+ 1 (hash-ref (p-scope) "revision"))))
  (test-palette (hash "type" "discover" "scope" (p-scope) "context" (p-context) "source" (if (null? arguments) json-null (car arguments)) "query" (if (< (length arguments) 2) "" (cadr arguments))) (hash-ref (p-context) "clientId"))
  (define result (p-reply)) (assert-equal (hash-ref result "type") "actions") (hash-ref result "actions"))
(define (p-execute handle . values)
  (p-raw handle (if (null? values) json-null (car values)))
  (define result (p-reply))
  (when (equal? (hash-ref result "type") "view")
    (vector-set! state 0 (hash-insert (p-scope) "view" (+ 1 (hash-ref (p-scope) "view"))))
    (define view (hash-ref result "view"))
    (when (and (vector-ref state 3) (equal? (hash-ref view "type") "actions") (not (json-null? (t-get view "source" json-null))))
      (set! result (hash-insert result "view" (hash-insert view "actions" (p-discover (hash-ref view "source")))))))
  result)
(define (p-action actions id) (define result (t-find (lambda (action) (equal? (hash-ref action "id") id)) actions)) (assert result (string-append "missing action " id)) result)
(define (p-view reply) (assert-equal (hash-ref reply "type") "view") (hash-ref reply "view"))
(define (p-open id) (p-view (p-execute (hash-ref (p-action (p-roots) id) "handle"))))
(define (p-choose reply id) (p-execute (hash-ref (p-action (hash-ref (p-view reply) "actions") id) "handle")))
(define (p-submit reply . values) (apply p-execute (hash-ref (p-view reply) "handle") values))
