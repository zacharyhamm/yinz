(require "./common.scm")
(provide s-agent s-agent-start s-agent-poll s-agent-wait)
(define (s-agent-start request) (test-session "agent" request))
(define (s-agent-poll id)
  (define result (test-session "agent-poll" id))
  (when (and (hash? result) (hash-contains? result "Err")) (error (hash-ref result "Err")))
  (if (json-null? result) result (hash-ref result "Ok")))
(define (s-agent-wait id)
  (define result (vector json-null))
  (test-wait-for "agent request completion" (lambda () (vector-set! result 0 (s-agent-poll id)) (not (json-null? (vector-ref result 0)))) 15000)
  (vector-ref result 0))
(define (s-agent request) (s-agent-wait (s-agent-start request)))
