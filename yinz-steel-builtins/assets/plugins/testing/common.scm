(require "../bar/default-mode.scm")
(provide t-get t-merge t-last t-find t-any t-named t-index t-load t-tab t-mode t-key t-utf8
  s-screen s-panes s-key s-text s-action s-load s-pipe s-start s-fixture s-report s-terminal?)
(define (t-get value key fallback) (if (and (hash? value) (hash-contains? value key)) (hash-ref value key) fallback))
(define (t-merge base extra) (foldl (lambda (key result) (hash-insert result key (hash-ref extra key))) base (hash-keys->list extra)))
(define (t-last values) (and (pair? values) (car (reverse values))))
(define (t-find predicate values) (cond [(null? values) #f] [(predicate (car values)) (car values)] [else (t-find predicate (cdr values))]))
(define (t-any predicate values) (if (t-find predicate values) #t #f))
(define (t-named name) (filter (lambda (command) (or (equal? command name) (and (hash? command) (hash-contains? command name)))) (test-commands)))
(define (t-index text part) (let loop ([at 0]) (cond [(> (+ at (string-length part)) (string-length text)) #f] [(equal? (substring text at (+ at (string-length part))) part) at] [else (loop (+ at 1))])))
(define (t-load path replies . config) (test-load-plugin path (hash "replies" replies "configuration" (if (null? config) (hash) (car config)))))
(define (t-tab . changes) (t-merge (hash "position" 0 "name" "main" "active" #t "panes_to_hide" 0 "is_fullscreen_active" #f "is_sync_panes_active" #f "are_floating_panes_visible" #f "other_focused_clients" '() "active_swap_layout_name" json-null "is_swap_layout_dirty" #f "viewport_rows" 24 "viewport_columns" 80 "display_area_rows" 24 "display_area_columns" 80 "selectable_tiled_panes_count" 1 "selectable_floating_panes_count" 0 "tab_id" 0 "has_bell_notification" #f "is_flashing_bell" #f) (if (null? changes) (hash) (car changes))))
(define (t-mode . changes) (t-merge (bar-default-mode) (if (null? changes) (hash) (car changes))))
(define (t-key bare . modifiers) (hash "bare_key" bare "key_modifiers" modifiers))
(define (t-utf8 text) (bytes->list (string->bytes text)))
(define (s-screen) (test-session "screen"))
(define (s-panes) (test-session "panes"))
(define (s-key key) (test-session "key" key))
(define (s-text text) (test-session "text" text))
(define (s-action action) (test-session "action" action))
(define (s-start . options) (test-session "start" (if (null? options) (hash) (car options))))
(define (s-load path . options) (test-session "load" (t-merge (hash "path" path) (if (null? options) (hash) (car options)))))
(define (s-pipe name payload . options) (test-session "pipe" (t-merge (hash "name" name "payload" payload) (if (null? options) (hash) (car options)))))
(define (s-fixture files commands) (test-session "fixture" (hash "files" files "commands" commands)))
(define (s-report pane kind hook) (test-session "report" (hash "pane" pane "kind" kind "hook" hook)))
(define (s-terminal? pane) (not (hash-ref pane "is_plugin")))
(provide t-unique t-repeat t-replace)
(define (t-unique values) (reverse (foldl (lambda (value found) (if (member value found) found (cons value found))) '() values)))
(define (t-repeat text count) (apply string-append (map (lambda (_) text) (range 0 count))))
(define (t-replace text before after)
  (let loop ([text text]) (define index (t-index text before))
    (if index (string-append (substring text 0 index) after (loop (substring text (+ index (string-length before))))) text)))
