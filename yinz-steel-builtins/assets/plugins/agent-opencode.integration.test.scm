(require "./testing/common.scm" "./testing/agent.scm" "./testing/fixtures.scm")
(define observer (hash "path" "./testing-fixtures/agent-provider.scm" "configuration" (hash "shared" "true")))
(test "Scheme provider registers, launches, detects, and controls a real terminal" (hash "grants" '("RunCommands")) (lambda ()
    (define cwd (s-fixture (hash) (hash "fixture-agent" terminal-agent)))
    (s-start (hash "columns" 180 "rows" 30 "backgroundPlugins" (list observer)))
    (test-wait-for "Scheme provider registration" (lambda () (string-contains? (test-session "logs") "fixture agent provider ready")))
    (define spawned (s-agent (hash "Spawn" (hash "spec" (hash "kind" "fixture-agent-alias" "model" "small model" "allow_outside_worktree" #t) "cwd" cwd))))
    (assert-equal (hash-ref spawned "outcome") "ok") (assert (not (json-null? (hash-ref spawned "spawned"))))
    (define pane (hash-ref (hash-ref spawned "spawned") "pane_id"))
    (test-wait-for-text "agent-args:<--model><small model>") (test-wait-for-text "fixture-agent-ready")
    (define listed (s-agent (hash "List" (hash)))) (assert (t-any (lambda (status) (equal? (hash-ref (hash-ref status "agent") "kind") "fixture-agent")) (hash-ref listed "agents")))
    (define (report event extra) (s-report pane "fixture-agent" (t-merge (hash "hook_event_name" event "session_id" "fixture-conversation") extra)))
    (report "SessionStart" (hash "source" "startup")) (define status-request (hash "Status" (hash "pane_id" pane)))
    (test-wait-for "reported agent ready for input" (lambda () (hash-ref (car (hash-ref (s-agent status-request) "agents")) "ready")))
    (assert-equal (hash-ref (s-agent (hash "Prompt" (hash "pane_id" pane "prompt" ":reset" "wait" #t "timeout_ms" 5000))) "outcome") "rejected")
    (define pending (s-agent-start (hash "Prompt" (hash "pane_id" pane "expected_session_id" "fixture-conversation" "prompt" "review\ncode" "wait" #t "timeout_ms" 10000))))
    (test-wait-for-text "composer-cleared") (test-wait-for-text "received:526561643a201b5b3230307e7265766965770d636f64651b5b3230317e")
    (assert (json-null? (s-agent-poll pending)))
    (report "UserPromptSubmit" (hash "turn_id" "current" "prompt" "Read: review\rcode")) (report "Stop" (hash "turn_id" "stale"))
    (define during (s-agent status-request)) (assert (json-null? (s-agent-poll pending)) "a stale completion cannot finish the submitted prompt")
    (assert (not (hash-ref (car (hash-ref during "agents")) "ready")))
    (report "Stop" (hash "turn_id" "current" "last_assistant_message" "fixture complete"))
    (define completed (s-agent-wait pending))
    (assert-equal (hash-ref completed "outcome") "completed") (assert-equal (hash-ref completed "turn_id") "current")
    (assert-equal (hash-ref completed "message") "fixture complete") (assert (hash-ref completed "acknowledged"))
    (assert-equal (hash-ref (s-agent (hash "Wait" (hash "pane_id" pane "until" "Idle" "timeout_ms" 5000))) "outcome") "ok")))
(test "OpenCode support is registered by its Scheme plugin and remains status-only" (hash "grants" '("RunCommands")) (lambda ()
    (define cwd (s-fixture (hash) (hash "opencode" terminal-agent)))
    (s-start (hash "columns" 180 "rows" 30 "backgroundPlugins" (list observer "yinz:agent-opencode")))
    (test-wait-for "provider observer ready" (lambda () (string-contains? (test-session "logs") "fixture agent provider ready")))
    (test-wait-for "OpenCode provider registration" (lambda () (string-contains? (test-session "logs") "fixture observed provider opencode")))
    (define spawned (s-agent (hash "Spawn" (hash "spec" (hash "kind" "opencode" "model" "fixture/model" "allow_outside_worktree" #t) "cwd" cwd))))
    (assert-equal (hash-ref spawned "outcome") "ok") (assert (not (json-null? (hash-ref spawned "spawned"))))
    (test-wait-for-text "agent-args:<--model><fixture/model>") (test-wait-for-text "fixture-agent-ready")
    (define pane (hash-ref (hash-ref spawned "spawned") "pane_id"))
    (s-report pane "opencode" (hash "hook_event_name" "SessionStart" "session_id" "opencode-session" "source" "startup"))
    (define status (car (hash-ref (s-agent (hash "Status" (hash "pane_id" pane))) "agents")))
    (assert-equal (hash-ref (hash-ref status "agent") "kind") "opencode") (assert (hash-ref status "status_available")) (assert (not (hash-ref status "prompt_supported")))
    (assert-equal (hash-ref (s-agent (hash "Prompt" (hash "pane_id" pane "prompt" "review" "wait" #t "timeout_ms" 5000))) "outcome") "status_unavailable")
    (assert-equal (hash-ref (s-agent (hash "Wait" (hash "pane_id" pane "until" "Idle" "timeout_ms" 5000))) "outcome") "ok")))
