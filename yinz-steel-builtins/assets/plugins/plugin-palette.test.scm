(require "./testing/common.scm" "./testing/palette.scm")
(define (info location configuration) (hash "location" location "configuration" configuration))
(define (inventory plugins)
  (hash "live_sessions" (list (hash "is_current_session" #t "plugins" plugins
        "tabs" (list (hash "position" 0 "name" "work"))
        "panes" (hash "panes" (hash "0" (list (hash "id" 3 "is_plugin" #t)))))) "resurrectable_sessions" '()))
(define default-plugins (hash "3" (info "file:/plugins/example.scm" (hash "theme" "dark")) "20" (info "yinz:status-bar" (hash))))
(define (harness . plugins)
  (p-init "./plugin-palette.scm"
    (hash "GetPluginIds" (hash "plugin_id" 9 "client_id" 1)
      "GetPaneCwd" "/current/雪"
      "GetSessionList" (inventory (if (null? plugins) default-plugins (car plugins)))
      "FocusPluginPane" json-null "ReloadPlugin" json-null "ClosePluginPane" json-null "LoadNewPlugin" json-null)
    (hash "clientId" 1 "paneId" (hash "Terminal" 4) "tabId" 7 "currentProject" json-null)))
(define (handle item) (hash-ref item "handle"))
(define (choices view . query) (apply p-discover (hash-ref view "source") query))
(define (choose view id . values)
  (apply p-execute (handle (p-action (hash-ref view "actions") id)) values))
(test "plugin palette inventories tabs and background plugins with full configuration details" (lambda ()
    (harness) (assert-equal (length (p-roots)) 5)
    (define items (choices (p-open "plugins")))
    (assert-equal (map (lambda (item) (hash-ref item "id")) items) '("3" "20"))
    (assert-equal (map (lambda (item) (hash-ref item "description")) items) (map yinz-markdown-escape '("Tab: work" "Background / no tab")))
    (define actions (p-view (p-execute (handle (car items)))))
    (assert-equal (map (lambda (item) (hash-ref item "id")) (hash-ref actions "actions")) '("focus" "reload" "close" "details"))
    (define details (p-view (choose actions "details")))
    (assert (string-contains? (hash-ref details "text") (yinz-markdown-escape "theme: dark")))
    (choose actions "focus") (choose actions "reload")
    (assert (member (hash "FocusPluginPane" '(3 #t #f)) (test-commands)))
    (assert (member (hash "ReloadPlugin" 3) (test-commands)))))
(test "plugin actions offer focus only for plugins with a pane" (lambda ()
    (harness) (define items (choices (p-open "plugins")))
    (define headless (p-view (p-execute (handle (cadr items)))))
    (assert-equal (map (lambda (item) (hash-ref item "id")) (hash-ref headless "actions")) '("reload" "close" "details"))
    ;; The root "Focus plugin…" lists only plugins with a pane, and refuses one that lost its pane.
    (define focusable (choices (p-open "focus")))
    (assert-equal (map (lambda (item) (hash-ref item "id")) focusable) '("3"))
    (assert-equal (map (lambda (item) (hash-ref item "id")) (choices (p-open "reload"))) '("3" "20"))
    (test-stub "GetSessionList" (hash "live_sessions" (list (hash "is_current_session" #t "plugins" default-plugins
            "tabs" (list (hash "position" 0 "name" "work")) "panes" (hash "panes" (hash "0" '()))))
        "resurrectable_sessions" '()))
    (assert-throws (lambda () (p-execute (handle (car focusable)))) "runs headless")
    (assert-equal (t-named "FocusPluginPane") '())
    (assert-equal (hash-ref (p-open "load") "description") "Foreground opens a pane only for plugins that declare one.")))
(test "large plugin details stay within the display budget without truncating loaded configuration" (lambda ()
    (define value (t-repeat "🔔 [value]\\\n" 30000))
    (harness (hash "3" (info "file:/plugins/example.scm" (hash "description" value))))
    (define actions (p-view (p-execute (handle (car (choices (p-open "plugins")))))))
    (define reply (choose actions "details")) (define text (hash-ref (p-view reply) "text"))
    (assert (string-contains? text (yinz-markdown-escape "description: 🔔 [value]")))
    (assert (string-contains? text "Details truncated"))
    (assert (< (utf8-length (yinz-json-string reply)) 262144))
    (define form (p-open "load")) (define config (p-view (choose form "configuration")))
    (define add (p-view (p-execute (handle (p-action (choices config) "add")))))
    (p-execute (handle add) (hash "key" "description" "value" value))
    (p-execute (handle form) (hash "location" "example"))
    (assert-equal (hash-ref (hash-ref (t-last (t-named "LoadNewPlugin")) "LoadNewPlugin") "config") (hash "description" value))))
(test "plugin actions revalidate inventory and close requires confirmation" (lambda ()
    (harness) (define selection (car (choices (p-open "close"))))
    (define confirmation (p-view (p-execute (handle selection))))
    (assert (hash-ref confirmation "confirmation")) (assert-equal (t-named "ClosePluginPane") '())
    (test-stub "GetSessionList" (inventory (hash-insert default-plugins "3" (info "file:/changed.scm" (hash)))))
    (assert-throws (lambda () (p-execute (handle confirmation) (hash))) "Plugin changed")
    (assert-equal (t-named "ClosePluginPane") '())
    (test-stub "GetSessionList" (inventory default-plugins)) (p-execute (handle confirmation) (hash))
    (assert (member (hash "ClosePluginPane" 3) (test-commands)))
    (define focus (car (choices (p-open "focus"))))
    (test-stub "GetSessionList" (inventory (hash)))
    (assert-throws (lambda () (p-execute (handle focus))) "no longer exists")))
(test "plugin inventory searches every page and refreshes added and removed plugins" (lambda ()
    (define plugins (foldl (lambda (id result) (hash-insert result (number->string id)
            (info (string-append "file:/plugin-" (number->string id) ".scm") (hash)))) (hash) (range 0 205)))
    (harness plugins) (define view (p-open "reload")) (define first (choices view))
    (assert-equal (length first) 99)
    (define second (p-view (p-execute (handle (t-last first)))))
    (assert-equal (hash-ref (car (choices second)) "id") "98")
    (define found (choices view "plugin_204")) (assert-equal (length found) 1)
    (p-execute (handle (car found))) (assert (member (hash "ReloadPlugin" 204) (test-commands)))
    (test-stub "GetSessionList" (inventory default-plugins))
    (assert-equal (length (choices view)) 2)))
(test "plugin loading edits, renames and removes configuration without losing the load draft" (lambda ()
    (harness) (define form (p-open "load"))
    (define config (p-view (choose form "configuration" (hash "location" "example" "placement" "Background"))))
    (define add (p-view (p-execute (handle (p-action (choices config) "add")))))
    (define configured (p-view (p-execute (handle add) (hash "key" "theme" "value" "dark\nmode"))))
    (define edit (p-view (p-execute (handle (p-action (choices configured) "[\"theme\"]")))))
    (p-execute (handle edit) (hash "key" "renamed" "value" "light"))
    (assert-throws (lambda () (p-execute (handle add) (hash "key" "renamed" "value" "overwrite"))) "already exists")
    (p-execute (handle form) (hash "location" "example" "placement" "Background"))
    (assert (member (hash "LoadNewPlugin" (hash "url" "example" "config" (hash "renamed" "light") "load_in_background" #t "skip_plugin_cache" #t "cwd" "/current/雪")) (test-commands)))
    (define removal (p-view (p-execute (handle (p-action (choices configured) "[\"renamed\"]")))))
    (choose removal "remove")
    (p-execute (handle form) (hash "location" "file:/plugin.scm" "placement" "Foreground"))
    (define loaded (hash-ref (t-last (t-named "LoadNewPlugin")) "LoadNewPlugin"))
    (assert-equal (hash-ref loaded "config") (hash)) (assert-equal (hash-ref loaded "load_in_background") #f)
    (assert-throws (lambda () (p-execute (handle form) (hash "location" " "))) "Enter a plugin location")))
(test "plugin file picker preserves form values on selection and cancellation" (lambda ()
    (harness) (define initial (p-open "load"))
    (define file (p-view (choose initial "file" (hash "location" "example" "placement" "Background"))))
    (assert-equal (hash-ref (cadr (hash-ref file "fields")) "initialValue") "Background")
    (define browse (p-action (hash-ref file "actions") "browse:location"))
    (for-each (lambda (selected)
        (p-raw (handle browse) (hash "location" "/tmp/original.scm" "placement" "Background"))
        (define pick (hash-ref (hash-ref (t-last (t-named "Pick")) "Pick") "Start"))
        (assert-equal (hash-ref pick "options") (hash "kind" "file" "roots" '("/tmp/")))
        (test-event (hash "PickResult" (hash "request_id" (hash-ref pick "request_id") "result" (hash "Ok" selected))))
        (define reply (p-reply)) (assert-equal (hash-ref reply "type") "fields")
        (assert-equal (hash-ref reply "values") (hash "location" (if (json-null? selected) "/tmp/original.scm" selected) "placement" "Background")))
      (list "/tmp/plugin#?%.scm" json-null))
    (p-execute (handle file) (hash "location" "/tmp/plugin#?%.scm" "placement" "Background"))
    (assert-equal (hash-ref (hash-ref (t-last (t-named "LoadNewPlugin")) "LoadNewPlugin") "url") "file:/tmp/plugin%23%3F%25.scm")
    (for-each (lambda (path)
        (p-execute (handle file) (hash "location" path))
        (assert-equal (hash-ref (hash-ref (t-last (t-named "LoadNewPlugin")) "LoadNewPlugin") "url") (string-append "file:" path)))
      '("relative#?%.scm" "~/plugin#?%.scm"))))
(test "new load forms have separate configuration drafts and dismissed callbacks cannot load" (lambda ()
    (harness) (define form (p-open "load"))
    (define config (p-view (choose form "configuration")))
    (define add (p-view (p-execute (handle (p-action (choices config) "add")))))
    (p-execute (handle add) (hash "key" "private" "value" "draft"))
    (define other (p-open "load")) (p-execute (handle other) (hash "location" "other"))
    (assert-equal (hash-ref (hash-ref (t-last (t-named "LoadNewPlugin")) "LoadNewPlugin") "config") (hash))
    (test-palette (hash "type" "dismiss" "opening" 1) 1)
    (assert-throws (lambda () (p-execute (handle form) (hash "location" "unexpected"))) "no longer available")))

(test "plugin loading uses the captured terminal directory and refuses failed lookups" (lambda ()
    (harness) (define form (p-open "load"))
    (define file (p-view (choose form "file" (hash))))
    (for-each (lambda (view)
        (test-stub-error "GetPaneCwd" "pane directory unavailable")
        (assert-throws (lambda () (p-execute (handle view) (hash "location" "./plugin.scm"))) "pane directory unavailable")
        (assert-equal (t-named "LoadNewPlugin") '())) (list form file))
    (test-stub "GetPaneCwd" "/changed/雪")
    (for-each (lambda (view)
        (p-execute (handle view) (hash "location" "./plugin.scm"))
        (assert-equal (t-last (t-named "GetPaneCwd")) (hash "GetPaneCwd" (hash "pane_id" (hash "Terminal" 4))))
        (assert-equal (hash-ref (hash-ref (t-last (t-named "LoadNewPlugin")) "LoadNewPlugin") "cwd") "/changed/雪"))
      (list form file))))
