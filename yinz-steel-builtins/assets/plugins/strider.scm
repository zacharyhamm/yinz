;; Host-folder navigation stays behind the normal permission-aware command bridge.
(yinz-declare-pane)
(define initial-cwd "")
(define current-path "")
(define path-is-dir #t)
(define hide-hidden #t)
(define close-on-selection #f)
(define files '())
(define matches '())
(define selected json-null)
(define search-selected 0)
(define search-term "")
(define current-rows 0)
(define rendered-window #f)
(define picker #f)

(define (get object key fallback)
  (if (and (hash? object) (hash-contains? object key)) (hash-ref object key) fallback))
(define (parts path) (filter (lambda (part) (not (equal? part ""))) (split-many path "/")))
(define (basename path) (let ((segments (parts path))) (if (null? segments) "" (car (reverse segments)))))
(define (parent path)
  (define segments (parts path))
  (define prefix (if (starts-with? path "/") "/" ""))
  (if (null? segments) ""
    (string-append prefix (string-join (reverse (cdr (reverse segments))) "/"))))
(define (join-path root name)
  (if (starts-with? name "/") name
    (if (equal? root "") name (string-append root (if (ends-with? root "/") "" "/") name))))
(define (entry-path path)
  (cond ((equal? path "/host") current-path)
    ((starts-with? path "/host/") (join-path current-path (substring path 6)))
    (else (join-path current-path path))))
(define (entry-before? a b)
  (if (equal? (get a "dir" #f) (get b "dir" #f))
    (string<? (hash-ref a "path") (hash-ref b "path")) (hash-ref a "dir")))
(define (refilter)
  (set! rendered-window #f)
  (set! search-selected 0)
  (set! matches
    (if (equal? search-term "") '()
      (let ((entries (list->vector files)))
        (map (lambda (match)
            (hash-insert match "entry" (vector-ref entries (hash-ref match "index"))))
          (yinz-ui-fuzzy-filter (map (lambda (entry) (hash-ref entry "name")) files) search-term))))))
(define (clear-search) (set! search-term "") (refilter))
(define (change-directory path)
  (set! current-path path)
  (set! path-is-dir #t)
  (set! files '())
  (set! selected json-null)
  (clear-search)
  (yinz-command (hash "ChangeHostFolder" current-path)))
(define (back) (change-directory (parent current-path)))
(define (update-files paths)
  (set! files
    (sort
      (filter (lambda (entry) (and entry (or (not hide-hidden) (not (starts-with? (hash-ref entry "name") ".")))))
        (map (lambda (pair)
            (define metadata (cadr pair))
            (define path (entry-path (car pair)))
            (and (not (get metadata "is_symlink" #f))
              (hash "path" path "name" (basename path) "dir" (get metadata "is_dir" #f) "size" (get metadata "len" 0)))) paths))
      entry-before?))
  ;; Existing search results remain until the next search edit, like the original plugin.
  (void))
(define (searching?) (not (equal? search-term "")))
(define (visible-entries) (if (searching?) (map (lambda (m) (hash-ref m "entry")) matches) files))
(define (selection) (if (searching?) search-selected selected))
(define (select! index) (if (searching?) (set! search-selected index) (set! selected index)))
(define (move-selection direction)
  (define index (selection))
  (define count (length (visible-entries)))
  (cond ((json-null? index) (when (> direction 0) (select! 0)))
    (else (select! (max 0 (min (max 0 (- count 1)) (+ index direction)))))))
(define (pick-result)
  (define source (hash-ref picker "source"))
  (cond
    ((get source "Plugin" #f)
      (yinz-command (hash "MessageToPlugin"
          (hash "destination_plugin_id" (hash-ref source "Plugin") "message_name" "filepicker_result"
            "message_payload" current-path "message_args" (get picker "args" (hash)))))
      (yinz-command "CloseSelf"))
    ((get source "Cli" #f)
      (define id (hash-ref source "Cli"))
      (yinz-command (hash "CliPipeOutput" (list id current-path)))
      (yinz-command (hash "UnblockCliPipeInput" id))
      (yinz-command "CloseSelf"))))
(define (open-path)
  (define file (hash "path" current-path))
  (cond
    (picker (pick-result))
    (path-is-dir
      (yinz-command (if close-on-selection
          (hash "OpenTerminalInPlaceOfPlugin" (list file #t)) (hash "OpenTerminal" file))))
    (else
      (define with-cwd (hash-insert file "cwd" (parent current-path)))
      (yinz-command (if close-on-selection
          (hash "OpenFileInPlaceOfPlugin" (list with-cwd #t (hash)))
          (hash "OpenFile" (list with-cwd (hash))))))))
(define (traverse)
  (define index (selection))
  (define entries (visible-entries))
  (define entry (and (not (json-null? index)) (< index (length entries)) (list-ref entries index)))
  (cond
    ((and entry (hash-ref entry "dir")) (change-directory (hash-ref entry "path")))
    (else
      (when entry
        (set! current-path (hash-ref entry "path"))
        (set! path-is-dir #f)
        (set! files '())
        (set! selected json-null))
      (clear-search)
      (open-path))))
(define (search-character character)
  (set! search-term (string-append search-term character))
  (cond ((equal? search-term "..") (back))
    ((equal? search-term "/") (change-directory initial-cwd))
    (else (refilter))))
(define (handle-key key)
  (define bare (get key "bare_key" ""))
  (define modifiers (get key "key_modifiers" '()))
  (cond
    ((equal? modifiers '("Ctrl"))
      (cond ((equal? bare (hash "Char" "c")) (if (searching?) (clear-search) (back)) #f)
        ((equal? bare (hash "Char" "e"))
          (set! hide-hidden (not hide-hidden))
          (yinz-command (hash "ChangeHostFolder" current-path)) #t)
        (else #f)))
    ((not (null? modifiers)) #f)
    ((get bare "Char" #f) (search-character (hash-ref bare "Char")) #t)
    ((equal? bare "Backspace")
      (if (searching?) (begin (set! search-term (substring search-term 0 (- (string-length search-term) 1))) (refilter)) (back)) #t)
    ((equal? bare "Esc") (if (searching?) (clear-search) (set! selected json-null)) #t)
    ((equal? bare "Up") (move-selection -1) #t)
    ((equal? bare "Down") (move-selection 1) #t)
    ((member bare '("Right" "Tab" "Enter")) (traverse) #t)
    ((equal? bare "Left") (back) #t)
    (else #f)))
(define (list-rows) (max 0 (- current-rows 7)))
(define (window)
  (yinz-ui-list-window (length (visible-entries)) (list-rows) (selection)))
(define (mouse-select line click?)
  (define bounds (yinz-ui-list-window (length (visible-entries)) (max 0 (- current-rows 5)) (selection)))
  (define index (+ (- line 4) (car bounds)))
  (if (and (>= line 4) (< line (+ 4 (list-rows))) (< index (caddr bounds)))
    (let ((previous (selection)))
      (select! index)
      (when (and click? (equal? previous index)) (traverse)) #t)
    #f))
(define (handle-mouse mouse)
  (cond ((get mouse "ScrollDown" #f) (move-selection 1) #t)
    ((get mouse "ScrollUp" #f) (move-selection -1) #t)
    ((get mouse "LeftClick" #f) (mouse-select (car (hash-ref mouse "LeftClick")) #t))
    ((get mouse "Hover" #f) (mouse-select (car (hash-ref mouse "Hover")) #f))
    (else #f)))
(define (load configuration)
  (set! initial-cwd (get (yinz-command "GetPluginIds") "initial_cwd" ""))
  (set! hide-hidden (not (equal? (get configuration "show_hidden_files" "false") "true")))
  (set! close-on-selection (equal? (get configuration "close_on_selection" "false") "true"))
  (set! current-path (get configuration "caller_cwd" initial-cwd))
  (yinz-command (hash "Subscribe" '("Key" "Mouse" "CustomMessage" "Timer" "FileSystemUpdate" "HostFolderChanged" "PermissionRequestResult")))
  (yinz-command (if (equal? initial-cwd current-path) (hash "ScanHostFolder" "/host") (hash "ChangeHostFolder" current-path))))
(define (update event)
  (cond ((get event "FileSystemUpdate" #f) (update-files (hash-ref event "FileSystemUpdate")) #t)
    ((get event "HostFolderChanged" #f) (yinz-command (hash "ScanHostFolder" "/host")) #t)
    ((get event "Key" #f) (handle-key (hash-ref event "Key")))
    ((get event "Mouse" #f) (handle-mouse (hash-ref event "Mouse")))
    (else #f)))
(define (pipe message)
  (if (and (get message "is_private" #f) (equal? (get message "name" "") "filepicker"))
    (begin
      (if (equal? (get (get message "args" (hash)) "open_directly" "false") "true")
        (begin (set! picker #f) (set! close-on-selection #t))
        (begin
          (set! picker message)
          (when (get (get message "source" #f) "Cli" #f)
            (yinz-command (hash "BlockCliPipeInput" (hash-ref (hash-ref message "source") "Cli"))))))
      #t)
    #f))

(define (pretty-size bytes)
  (let loop ((scale 1) (units '("B" "kB" "MB" "GB" "TB" "PB" "EB" "ZB" "YB")))
    (if (and (>= bytes (* scale 1000)) (not (null? (cdr units))))
      (loop (* scale 1000) (cdr units))
      (let* ((hundredths (quotient (+ (* bytes 100) (quotient scale 2)) scale))
          (whole (quotient hundredths 100)) (fraction (remainder hundredths 100)))
        (string-append (number->string whole)
          (cond ((= fraction 0) "")
            ((= (remainder fraction 10) 0) (string-append "." (number->string (quotient fraction 10))))
            (else (string-append "." (if (< fraction 10) "0" "") (number->string fraction))))
          " " (car units))))))
(define (style text selected? directory? highlights)
  (hash "text" text "selected" selected? "levels"
    (list (if directory? (range 0 (string-length text)) '()) '() '() highlights)))
(define (text-at text levels row cols rows)
  (if (and (<= row rows) (> cols 0))
    (yinz-ui-text (hash "text" text "levels" levels) (yinz-ui-coordinates 0 row cols json-null)) ""))
(define (short-path maximum)
  (define components (parts current-path))
  (define root (if (starts-with? current-path "/") "/" ""))
  (let loop ((rest components) (remove (- (yinz-text-width current-path) maximum)) (output root))
    (if (null? rest) output
      (let* ((part (car rest)) (shorten (and (> remove 0) (> (string-length part) 0)))
          (piece (if shorten (substring part 0 1) part)))
        (loop (cdr rest) (- remove (- (yinz-text-width part) (yinz-text-width piece)))
          (string-append output piece (if (null? (cdr rest)) "" "/")))))))
(define (display-name name) (string-replace (yinz-text-sanitize name) "\n" " "))
(define (render-path rows cols)
  (define tip (cond (picker "Select") (path-is-dir "Open terminal here") (else "Open in editor")))
  (define full? (> cols (+ 6 (yinz-text-width current-path) (yinz-text-width tip) 13)))
  (define path (display-name (if full? current-path (short-path (max 0 (- cols 20))))))
  (define path-end (+ 6 (string-length path)))
  (define text (string-append "PATH: " path (if full? (string-append " (<ENTER> - " tip ")") " <ENTER>")))
  (string-append (yinz-ui-text (hash "text" text "levels" (list (range 6 path-end) '() (range 0 6)
          (range (+ path-end (if full? 2 1)) (+ path-end (if full? 9 8)))))) "\n\n"))
(define (render-help rows cols)
  (cond ((> cols 78) (text-at "Help: go back with <Ctrl c>, go to root with /, <Ctrl e> - toggle hidden files"
        (list '() '() '() (append (range 19 27) '(45) (range 48 56))) rows cols rows))
    ((> cols 56) (text-at "Help: <Ctrl c> - back, / - root, <Ctrl e> - hidden files"
        (list '() '() '() (append (range 6 14) '(23) (range 33 41))) rows cols rows))
    ((> cols 25) (text-at "<Ctrl c> - back, / - root"
        (list '() '() '() (append (range 0 8) '(17))) rows cols rows))
    (else "")))
(define (render rows cols)
  (set! current-rows rows)
  (if (or (= rows 0) (= cols 0)) ""
    (let* ((find (string-append "FIND: " search-term "_"))
        (bounds (window)) (entries (list->vector (visible-entries)))
        (searches (list->vector matches)))
      (set! rendered-window bounds)
      (string-append
        (yinz-ui-text (hash "text" find "levels" (list '() '() (range 0 6) (range 6 (string-length find))))) "\n"
        (render-path rows cols)
        (text-at "(<↓↑> - Navigate, <TAB> - Select)" (list '() '() '() (append (range 1 5) (range 18 23))) 3 cols rows)
        (string-join
          (map (lambda (index)
              (define entry (vector-ref entries index))
              (define directory? (hash-ref entry "dir"))
              (define name (string-append (display-name (hash-ref entry "name")) (if directory? "/" "")))
              (define size (if directory? "" (pretty-size (hash-ref entry "size"))))
              (define text (if (< (+ (yinz-text-width name) (yinz-text-width size)) cols)
                  (string-append name (make-string (- cols (yinz-text-width name) (yinz-text-width size)) #\space) size)
                  (string-append name (make-string (max 0 (- cols (yinz-text-width name))) #\space))))
              (define highlights (if (searching?) (filter (lambda (i) (< i (string-length text)))
                    (hash-ref (vector-ref searches index) "indices")) '()))
              (yinz-ui-text (style text (equal? index (selection)) directory? highlights)
                (yinz-ui-coordinates 0 (+ 4 (- index (car bounds))) cols json-null)))
            (range (car bounds) (caddr bounds))) "")
        (render-help rows cols)))))
