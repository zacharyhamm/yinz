;; The shared dialog keeps Cancel as the default and handles keyboard, pointer, and viewport state.
(define dialog #f)
(define (get object key fallback)
  (if (hash-contains? object key) (hash-ref object key) fallback))
(define (emphasis text level)
  (hash "text" text "levels" (append (map (lambda (n) '()) (range level)) (list (range (string-length text))))))
(define (load configuration)
  (define notice (get configuration "notice" #f))
  (define message (if (equal? (get configuration "reason" #f) "last_pane")
      "That was the last pane. Quit Yinz?" "Are you sure you want to quit?"))
  (set! dialog (yinz-ui-dialog (emphasis "Quit Yinz?" 2)
      (list (yinz-ui-button "cancel" "Cancel") (yinz-ui-button "quit" "Quit"))
      (hash "message" message "help" "<Tab/Arrows> select  <Enter> confirm  <Esc> cancel")))
  (when notice (yinz-ui-set-status! dialog (emphasis notice 3)))
  (yinz-command (hash "Subscribe" '("Key" "Mouse")))
  (yinz-command (hash "SetSelectable" #t))
  (define plugin-id (hash-ref (yinz-command "GetPluginIds") "plugin_id"))
  (yinz-command (hash "RenamePluginPane" (list plugin-id "quit confirmation")))
  (yinz-command (hash "ChangeOverlayCoordinates"
      (hash "placements" (list (list (hash "Plugin" plugin-id)
            (hash "x" (hash "Percent" 30) "y" (hash "Percent" 30) "width" (hash "Percent" 40)
              "height" (hash "Fixed" (yinz-ui-op dialog "Height")) "pinned" 'json-null "borderless" 'json-null)))
        "override_user_placement" #f))))
(define (update event)
  (define action (cond
      ((and (hash? event) (hash-contains? event "Key")) (yinz-ui-handle-key dialog (hash-ref event "Key")))
      ((and (hash? event) (hash-contains? event "Mouse")) (yinz-ui-handle-mouse dialog (hash-ref event "Mouse")))
      (else #f)))
  (cond ((not action) #f)
    ((or (equal? (hash-ref action "kind") "cancel")
        (and (equal? (hash-ref action "kind") "buttonPressed") (member (hash-ref action "id") '("cancel" "quit"))))
      (yinz-command "CloseSelf")
      (when (equal? (get action "id" #f) "quit") (yinz-command "QuitYinz")) #f)
    (else (hash-ref action "shouldRender"))))
(define (render rows cols)
  (yinz-ui-render dialog (yinz-ui-coordinates 0 0 cols rows)))
