(require "./bar/default-mode.scm" "./bar/keys.scm" "./bar/tips.scm" "./bar/status-render.scm")
(yinz-declare-pane)

(define state (hash "modeInfo" (bar-default-mode) "tabs" '() "classic" #f "tipName" "quicknav"
    "copied" #f "clipboardFailure" #f "counts" (hash "busy" 0 "waiting" 0 "idle" 0)
    "clock" (hash "time" "" "date" "") "hintRevealed" #f "newPaneHovered" #f "floatingHovered" #f))
(define cached-keybinds '())
(define alt-until 0)
(define hover-until 0)
(define offset-valid-until 0)
(define utc-offset 0)
(define last-cols 0)
(define last-rows 0)
(define pending-ticks '())
(define floating-range #f)
(define new-pane-range #f)
(define (set-state! key value) (set! state (hash-insert state key value)))
(define (hint-until) (max alt-until hover-until))
(define (revealed?) (< (yinz-wall-clock-ms) (hint-until)))
(define (animation-interval)
  (and (not (hash-ref state "classic")) (= last-rows 1)
    (cond ((> (hash-ref (hash-ref state "counts") "busy") 0) 125)
      ((> (hash-ref (hash-ref state "counts") "waiting") 0) 500) (else #f))))
(define (in-range range col) (and range (>= col (car range)) (< col (cadr range))))
(define (arm-tick now)
  (define interval (or (animation-interval) 60000))
  (define boundary (* (+ (quotient now interval) 1) interval))
  (define at (if (> (hint-until) now) (min boundary (hint-until)) boundary))
  (define delay (max (- at now) 1))
  (define deadline (+ (yinz-now-ms) delay))
  (when (or (null? pending-ticks) (< deadline (car pending-ticks)))
    (yinz-command (hash "SetTimeout" (/ delay 1000.0)))
    (set! pending-ticks (cons deadline pending-ticks))))
(define (refresh-clock now)
  (define (two value) (string-append (if (< value 10) "0" "") (number->string value)))
  (when (>= now offset-valid-until)
    (set! utc-offset (with-handler (lambda (error) 0)
        (yinz-command (hash "GetLocalUtcOffset" (hash "epoch_ms" now)))))
    (set! offset-valid-until (* (+ (quotient now 3600000) 1) 3600000)))
  (let* ((date (yinz-utc-date (+ now (* utc-offset 1000))))
      (clock (hash "time" (string-append (two (hash-ref date "hour")) ":" (two (hash-ref date "minute")))
          "date" (string-append (list-ref '("Sun" "Mon" "Tue" "Wed" "Thu" "Fri" "Sat") (hash-ref date "weekday")) " "
            (number->string (hash-ref date "day")) " " (list-ref '("Jan" "Feb" "Mar" "Apr" "May" "Jun" "Jul" "Aug" "Sep" "Oct" "Nov" "Dec") (- (hash-ref date "month") 1)))))
      (changed (not (bar-equal? clock (hash-ref state "clock")))))
    (set-state! "clock" clock)
    changed))
(define (note-pointer col)
  (define now (yinz-wall-clock-ms))
  (define was-revealed (revealed?))
  (set! hover-until (if (and (not (= last-cols 0)) (>= col last-cols)) 0 (+ now 30000)))
  (arm-tick now)
  (not (equal? (revealed?) was-revealed)))
(define (load configuration)
  (set-state! "tipName" (bar-cached-tip))
  (set-state! "classic" (equal? (bar-get configuration "classic" #f) "true"))
  (yinz-command (hash "SetSelectable" #f))
  (define now (yinz-wall-clock-ms))
  (refresh-clock now)
  (arm-tick now)
  (yinz-command (hash "Subscribe" '("Timer" "ModifiersHeld" "ModeUpdate" "TabUpdate" "PaneUpdate"
        "CopyToClipboard" "InputReceived" "SystemClipboardFailure" "InitialKeybinds" "Mouse"))))
(define (update event)
  (cond
    ((equal? event "SystemClipboardFailure") (set-state! "clipboardFailure" #t) #t)
    ((equal? event "InputReceived")
      (define changed (or (if (hash-ref state "copied") #t #f) (hash-ref state "clipboardFailure")))
      (set-state! "copied" #f) (set-state! "clipboardFailure" #f) changed)
    ((not (hash? event)) #f)
    ((hash-contains? event "InitialKeybinds")
      (set! cached-keybinds (hash-ref event "InitialKeybinds"))
      (unless (null? cached-keybinds) (set-state! "modeInfo" (hash-insert (hash-ref state "modeInfo") "keybinds" cached-keybinds))) #t)
    ((hash-contains? event "ModeUpdate")
      (define mi (hash-ref event "ModeUpdate"))
      (if (null? (hash-ref mi "keybinds"))
        (unless (null? cached-keybinds) (set! mi (hash-insert mi "keybinds" cached-keybinds)))
        (set! cached-keybinds (hash-ref mi "keybinds")))
      (define changed (not (bar-equal? mi (hash-ref state "modeInfo"))))
      (set-state! "modeInfo" mi) changed)
    ((hash-contains? event "TabUpdate")
      (define changed (not (bar-equal? (hash-ref state "tabs") (hash-ref event "TabUpdate"))))
      (set-state! "tabs" (hash-ref event "TabUpdate")) changed)
    ((hash-contains? event "PaneUpdate")
      (define counts (hash "busy" 0 "waiting" 0 "idle" 0))
      (define panes (hash-ref (hash-ref event "PaneUpdate") "panes"))
      (for-each (lambda (tab)
          (for-each (lambda (pane)
              (define agent (hash-ref pane "agent"))
              (when (and (bar-present? agent) (not (equal? (hash-ref agent "state") "Exited")))
                (define kind (cond ((equal? (hash-ref agent "state") "Idle") "idle")
                    ((and (equal? (hash-ref agent "state") "Waiting") (hash-ref agent "wait_needs_a_person")) "waiting")
                    (else "busy")))
                (set! counts (hash-insert counts kind (+ (hash-ref counts kind) 1))))) (hash-ref panes tab))) (hash-keys->list panes))
      (if (bar-equal? counts (hash-ref state "counts")) #f
        (begin (set-state! "counts" counts) (arm-tick (yinz-wall-clock-ms)) #t)))
    ((hash-contains? event "ModifiersHeld")
      (define now (yinz-wall-clock-ms))
      (define was-revealed (revealed?))
      (define held (hash-ref event "ModifiersHeld"))
      (if (member "Alt" (hash-ref held "modifiers"))
        (set! alt-until (if (hash-ref held "is_live") (+ now 30000) (max alt-until (+ now 3000))))
        (when (hash-ref held "is_live") (set! alt-until 0)))
      (define changed (not (equal? (revealed?) was-revealed)))
      (when changed (arm-tick now)) changed)
    ((hash-contains? event "Timer")
      (define now (yinz-wall-clock-ms))
      ;; Each host timeout delivers one event, even if the wall clock moved backward.
      (unless (null? pending-ticks) (set! pending-ticks (cdr pending-ticks)))
      (define changed (refresh-clock now))
      (define expired (and (not (= (hint-until) 0)) (>= now (hint-until))))
      (when expired (set! alt-until 0) (set! hover-until 0))
      (arm-tick now)
      (if (or changed expired (animation-interval)) #t #f))
    ((hash-contains? event "CopyToClipboard")
      (define changed (not (equal? (hash-ref state "copied") (hash-ref event "CopyToClipboard"))))
      (set-state! "copied" (hash-ref event "CopyToClipboard")) changed)
    ((hash-contains? event "Mouse")
      (define mouse (hash-ref event "Mouse"))
      (cond
        ((hash-contains? mouse "LeftClick")
          (define col (cadr (hash-ref mouse "LeftClick")))
          (define changed (note-pointer col))
          (cond ((in-range new-pane-range col) (yinz-command "NewPane"))
            ((in-range floating-range col) (yinz-command (hash "ToggleFloatingPanes" (hash "tab_id" 'json-null))))) changed)
        ((hash-contains? mouse "Hover")
          (define col (cadr (hash-ref mouse "Hover")))
          (define changed (note-pointer col))
          (define pane (in-range new-pane-range col))
          (define floating (and (not pane) (in-range floating-range col)))
          (define hover-changed (or (not (equal? pane (hash-ref state "newPaneHovered"))) (not (equal? floating (hash-ref state "floatingHovered")))))
          (set-state! "newPaneHovered" pane) (set-state! "floatingHovered" floating)
          (or changed hover-changed))
        (else #f)))
    (else #f)))
(define (render rows cols)
  (set! last-cols cols)
  (unless (= last-rows rows) (set! last-rows rows) (arm-tick (yinz-wall-clock-ms)))
  (set-state! "hintRevealed" (revealed?))
  (define output (bar-status-render state rows cols (yinz-wall-clock-ms)))
  (set! new-pane-range (hash-ref output "newPane"))
  (set! floating-range (hash-ref output "floating"))
  (hash-ref (hash-ref output "line") "part"))
