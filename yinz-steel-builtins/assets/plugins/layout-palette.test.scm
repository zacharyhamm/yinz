(require "./testing/common.scm" "./testing/palette.scm")
(define tab (hash "name" "Work" "panes" (list (hash "name" "Editor" "is_plugin" #f "is_builtin_plugin" #f) (hash "name" json-null "is_plugin" #f "is_builtin_plugin" #f))))
(define metadata (hash "tabs" (list tab) "creation_time" "12" "update_time" "34"))
(define available (list (hash "BuiltIn" "compact") (hash "File" (list "work" metadata))))
(define broken (list (hash "layout_name" "broken" "error" "SyntaxError")))
(define (harness)
  (p-init "./layout-palette.scm"
    (hash "GetSessionList" (hash "live_sessions" (list (hash "is_current_session" #t "available_layouts" available)))
      "NewTabsWithLayoutInfo" '(8) "RenameTabWithId" json-null "OverrideLayout" json-null
      "SaveLayout" #t "RenameLayout" #t "DeleteLayout" #t "EditLayout" #t "GenerateRandomName" "generated"
      "DumpSessionLayout" (hash "layout" "layout { pane; }" "metadata" metadata) "ParseLayout" metadata)
    (hash "clientId" 1 "paneId" (hash "Terminal" 4) "tabId" 7 "currentProject" json-null))
  (test-event (hash "AvailableLayoutInfo" (list available broken))))
(define (handle view) (hash-ref view "handle"))
(define (choices view . query) (apply p-discover (hash-ref view "source") query))
(define (layout name)
  (define found (choices (p-open "layouts") name))
  (assert-equal (length found) 1)
  (p-view (p-execute (handle (car found)))))
(define (choose view id . values)
  (apply p-execute (handle (p-action (hash-ref view "actions") id)) values))
(define (issued name) (hash-ref (t-last (t-named name)) name))
(test "layout palette lists valid and broken layouts with metadata and safe management actions" (lambda ()
    (harness) (assert-equal (length (p-roots)) 3)
    (assert-equal (map (lambda (a) (hash-ref a "label")) (choices (p-open "layouts"))) '("broken" "compact" "work"))
    (define view (layout "work")) (assert (string-contains? (hash-ref view "description") "Work")) (assert (string-contains? (hash-ref view "description") "Editor"))
    (assert-equal (map (lambda (a) (hash-ref a "id")) (hash-ref view "actions")) '("open" "apply" "details" "edit" "rename" "delete"))
    (assert (string-contains? (hash-ref (p-view (choose view "details")) "text") "Terminal"))
    (define bad (layout "broken")) (assert-equal (map (lambda (a) (hash-ref a "id")) (hash-ref bad "actions")) '("details" "edit" "rename" "delete"))
    (assert (string-contains? (hash-ref (p-view (choose bad "details")) "text") "KDL"))
    (assert-equal (map (lambda (a) (hash-ref a "id")) (hash-ref (layout "compact") "actions")) '("open" "apply" "details"))))
(test "blank external layout names have visible labels and retain their file identity" (lambda ()
    (harness)
    (define names '("   " "\t\n" "\u{1b}"))
    (test-event (hash "AvailableLayoutInfo" (list
          (map (lambda (name) (hash "File" (list name metadata))) names)
          (list (hash "layout_name" "\r" "error" "SyntaxError")))))
    (define items (choices (p-open "layouts") "Unnamed layout")) (assert-equal (length items) 4)
    (for-each (lambda (name)
        (define item (p-action items (yinz-json-string (list #f name))))
        (assert (string-contains? (hash-ref item "label") "Unnamed layout"))
        (define view (p-view (p-execute (handle item))))
        (assert-equal (hash-ref view "title") (hash-ref item "label"))
        (choose view "edit") (assert-equal (hash-ref (issued "EditLayout") "layout_name") name)
        (define deletion (p-view (choose view "delete")))
        (assert (string-contains? (hash-ref deletion "title") (hash-ref item "label")))
        (unless (equal? name "\r")
          (assert (string-contains? (hash-ref (p-view (choose view "apply")) "title") (hash-ref item "label")))))
      (append names '("\r")))))
(test "large layout previews and diagnostics fit the palette without changing saved source" (lambda ()
    (harness)
    (define value (t-repeat "🔔 [value]\\\n" 30000))
    (define large (hash-insert metadata "tabs" (list (hash-insert tab "name" value))))
    (define source (string-append "layout { pane; }\n// " (t-repeat "🔔 [value]\\ " 3000)))
    (define (bounded view key)
      (assert (string-contains? (hash-ref view key) "Details truncated"))
      (assert (< (utf8-length (yinz-json-string view)) 262144)))
    (test-event (hash "AvailableLayoutInfo" (list (list (hash "File" (list "large" large))) '())))
    (define view (layout "large")) (bounded view "description")
    (bounded (p-view (choose view "details")) "text")
    (test-stub "DumpSessionLayout" (hash "layout" source "metadata" large))
    (define save (p-open "save-layout")) (bounded save "description")
    (p-execute (handle save) (hash "name" "session-copy"))
    (assert-equal (hash-ref (issued "SaveLayout") "layout_kdl") source)
    (test-stub "ParseLayout" large)
    (define import (p-open "import-layout"))
    (define preview (p-view (p-execute (handle import) (hash "layout" source)))) (bounded preview "description")
    (p-execute (handle preview) (hash "name" "import-copy"))
    (assert-equal (hash-ref (issued "SaveLayout") "layout_kdl") source)
    (test-stub-error "ParseLayout" value)
    (bounded (p-view (p-execute (handle import) (hash "layout" "layout { pane size=oops; }"))) "text")))
(test "opening layouts names single tabs but preserves multi-tab names" (lambda ()
    (harness) (choose (layout "work") "open")
    (assert-equal (issued "NewTabsWithLayoutInfo") (hash "File" (list "work" metadata)))
    (assert-equal (issued "RenameTabWithId") '(8 "work"))
    (test-event (hash "AvailableLayoutInfo" (list (list (hash "File" (list "multi" (hash-insert metadata "tabs" (list tab tab))))) '())))
    (choose (layout "multi") "open") (assert-equal (length (t-named "RenameTabWithId")) 1)))
(test "apply layout exposes all retained pane and tab scope combinations" (lambda ()
    (harness)
    (for-each (lambda (options)
        (define form (p-view (choose (layout "work") "apply"))) (assert (hash-ref form "confirmation"))
        (p-execute (handle form) (hash "retain" (car options) "target" (cadr options)))
        (assert-equal (cdr (issued "OverrideLayout")) (append (cddr options) (list (hash)))))
      '(("None" "All tabs" #f #f #f) ("Terminals" "Current tab" #t #f #t) ("Plugins" "All tabs" #f #t #f) ("Both" "Current tab" #t #t #t)))))
(test "edit rename and confirmed delete use host acknowledgements and preserve errors" (lambda ()
    (harness) (define view (layout "work")) (choose view "edit") (assert-equal (issued "EditLayout") (hash "layout_name" "work" "context" (hash)))
    (define rename (p-view (choose view "rename")))
    (assert-throws (lambda () (p-execute (handle rename) (hash "name" " "))) "cannot be empty")
    (test-stub-error "RenameLayout" "name already exists")
    (assert-throws (lambda () (p-execute (handle rename) (hash "name" "taken"))) "already exists")
    (assert-equal (length (choices (p-open "layouts") "work")) 1)
    (test-stub "RenameLayout" #t) (p-execute (handle rename) (hash "name" "renamed"))
    (assert-equal (issued "RenameLayout") (hash "old_layout_name" "work" "new_layout_name" "renamed"))
    (define deletion (p-view (choose (layout "renamed") "delete"))) (assert (hash-ref deletion "confirmation"))
    (assert-equal (t-named "DeleteLayout") '()) (test-stub-error "DeleteLayout" "read-only file system")
    (assert-throws (lambda () (p-execute (handle deletion) (hash))) "read-only")
    (assert-equal (length (choices (p-open "layouts") "renamed")) 1)
    (test-stub "DeleteLayout" #t) (p-execute (handle deletion) (hash))
    (assert-equal (issued "DeleteLayout") (hash "layout_name" "renamed"))
    (assert-equal (choices (p-open "layouts") "renamed") '())
    (assert-throws (lambda () (choose view "open")) "no longer exists")))
(test "save refreshes previews and captures the selected tab scope without overwriting files" (lambda ()
    (harness) (define form (p-open "save-layout")) (assert (json-null? (hash-ref (issued "DumpSessionLayout") "tab_index")))
    (set! form (p-view (choose form "refresh" (hash "name" "kept" "target" "Current tab"))))
    (assert-equal (issued "DumpSessionLayout") (hash "tab_index" 7))
    (assert-equal (hash-ref (car (hash-ref form "fields")) "initialValue") "kept")
    (test-stub "DumpSessionLayout" (hash "layout" "layout { pane; pane; }" "metadata" metadata))
    (p-execute (handle form) (hash "name" "" "target" "Current tab"))
    (assert-equal (issued "SaveLayout") (hash "layout_name" "generated" "layout_kdl" "layout { pane; pane; }" "overwrite" #f))
    (assert-equal (length (choices (p-open "layouts") "generated")) 1)
    (test-stub "SaveLayout" #f) (assert-throws (lambda () (p-execute (handle form) (hash "name" "failed" "target" "All tabs"))))
    (assert-equal (choices (p-open "layouts") "failed") '())
    (test-stub "DumpSessionLayout" (hash "layout" "layout {}" "metadata" json-null))
    (assert-throws (lambda () (p-open "save-layout")) "metadata")))
(test "save and import reject whitespace-only names without generating or saving a layout" (lambda ()
    (harness)
    (define forms (list (p-open "save-layout")
        (p-view (p-execute (handle (p-open "import-layout")) (hash "layout" "layout { pane; }")))))
    (for-each (lambda (form)
        (for-each (lambda (name)
            (assert-throws (lambda () (p-execute (handle form) (hash "name" name))) "only whitespace"))
          '("   " "\t\n"))) forms)
    (assert-equal (t-named "SaveLayout") '())
    (assert-equal (t-named "GenerateRandomName") '())))
(test "import previews KDL metadata accepts generated names and blocks invalid layouts" (lambda ()
    (harness) (define form (p-open "import-layout"))
    (assert-throws (lambda () (p-execute (handle form) (hash "layout" ""))) "paste a layout")
    (test-stub-error "ParseLayout" "invalid KDL")
    (define diagnostic (p-view (p-execute (handle form) (hash "layout" "layout { pane size=oops; }"))))
    (assert-equal (hash-ref diagnostic "title") "Invalid layout") (assert-equal (t-named "SaveLayout") '())
    (assert (string-contains? (hash-ref diagnostic "text") "invalid KDL"))
    (test-stub "ParseLayout" metadata)
    (define preview (p-view (p-execute (handle form) (hash "layout" "layout { pane; }" "name" "chosen"))))
    (assert (string-contains? (hash-ref preview "description") "Editor"))
    (define edited (p-view (choose preview "edit" (hash "name" "kept"))))
    (assert-equal (hash-ref (car (hash-ref edited "fields")) "initialValue") "kept")
    (assert-equal (hash-ref (cadr (hash-ref edited "fields")) "initialValue") "layout { pane; }")
    (p-execute (handle preview) (hash "name" "")) (assert-equal (issued "SaveLayout") (hash "layout_name" "generated" "layout_kdl" "layout { pane; }" "overwrite" #f))))
(test "layout pagination searches the entire collection and stale actions cannot open removed layouts" (lambda ()
    (harness)
    (test-event (hash "AvailableLayoutInfo" (list (map (lambda (i)
              (hash "File" (list (string-append "layout-" (number->string (+ 100 i))) metadata))) (range 0 205)) '())))
    (define view (p-open "layouts")) (define first (choices view)) (assert-equal (length first) 99)
    (define next (p-view (p-execute (handle (t-last first))))) (assert-equal (length (choices next)) 100)
    (define found (choices view "304")) (assert-equal (length found) 1)
    (define selected (p-view (p-execute (handle (car found)))))
    (test-event (hash "AvailableLayoutInfo" (list '() '())))
    (assert-throws (lambda () (choose selected "open")) "no longer exists")
    (assert-equal (t-named "NewTabsWithLayoutInfo") '())
    (test-event "BeforeClose")))
