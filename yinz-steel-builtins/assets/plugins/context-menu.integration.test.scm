(require "./testing/common.scm")
(define (right-click line column) (test-session "mouse" (hash "event_type" "Press" "right" #t "left" #f "middle" #f "wheel_up" #f "wheel_down" #f "shift" #f "alt" #f "ctrl" #f "position" (hash "line" line "column" column))))
(for-each (lambda (action)
    (test (string-append "context-menu " action " launches from a hook-reported agent") (hash "grants" '("RunCommands")) (lambda ()
        (s-fixture (hash) (hash "bwrap" "exit 1\n" "claude" "printf 'DUPLICATED AGENT READY\\r\\n'\nwhile IFS= read -r line; do :; done\n" "codex" "printf 'FORKED AGENT READY\\r\\n'\nwhile IFS= read -r line; do :; done\n"))
        (s-start (hash "columns" 180 "rows" 36 "hooks" (hash "context_menu" "yinz:context-menu") "backgroundPlugins" (list (hash "path" "yinz:agent-service" "configuration" (hash "shared" "true")))))
        (test-wait-for-text "yinz-test>") (s-pipe "ready" "" (hash "plugin" "yinz:context-menu"))
        (define source (t-find (lambda (pane) (and (s-terminal? pane) (hash-ref pane "is_focused"))) (s-panes))) (assert source)
        (s-report (hash "Terminal" (hash-ref source "id")) "claude" (hash "hook_event_name" "SessionStart" "session_id" "context-menu-source" "source" "startup"))
        (test-wait-for "source has an agent record" (lambda () (t-any (lambda (pane) (and (= (hash-ref pane "id") (hash-ref source "id")) (equal? (t-get (t-get pane "agent" #f) "kind" #f) "claude"))) (s-panes))))
        (right-click (+ 1 (hash-ref source "pane_content_y")) (+ 1 (hash-ref source "pane_content_x")))
        (test-wait-for-text "Duplicate agent") (test-wait-for-text "Fork agent") (s-key "Down")
        (when (equal? action "Fork") (s-key "Down")) (s-key "Enter")
        (when (equal? action "Fork") (test-wait-for-text "forking claude") (s-key "Tab") (s-key "Enter"))
        (test-wait-for-text (if (equal? action "Fork") "FORKED AGENT READY" "DUPLICATED AGENT READY"))
        (assert (t-any (lambda (pane) (and (= (hash-ref pane "id") (hash-ref source "id")) (s-terminal? pane))) (s-panes)))))) '("Duplicate" "Fork"))
(test "context-menu opens through real mouse routing" (lambda ()
    (s-start (hash "hooks" (hash "context_menu" "yinz:context-menu"))) (test-wait-for-text "yinz-test>") (s-pipe "ready" "" (hash "plugin" "yinz:context-menu"))
    (right-click 5 10) (test-wait-for-text "Close") (assert (not (string-contains? (s-screen) "Copy")))
    (s-key "Down") (s-key "Enter") (test-wait-for "menu splits the terminal" (lambda () (= 2 (length (filter s-terminal? (s-panes))))))
    (s-key "Esc") (test-wait-for "menu dismissed" (lambda () (not (string-contains? (s-screen) "Close"))))))
