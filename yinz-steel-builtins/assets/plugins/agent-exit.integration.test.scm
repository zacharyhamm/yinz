(require "./testing/common.scm")
(require "./testing/fixtures.scm")
(define grants (hash "grants" '("ReadFiles" "RunCommands")))
(define (start-exit files commands suffix)
  (define root (s-fixture files commands))
  (s-start)
  (s-load "yinz:agent-exit" (hash "configuration" (hash "agent_cwd" (string-append root suffix) "agent_target" "local"))))
(define (closed)
  (test-wait-for "exit view closes" (lambda () (not (t-any (lambda (pane) (equal? (t-get pane "plugin_url" #f) "yinz:agent-exit")) (s-panes))))))
(define (verify command text)
  (test-wait-for-text "yinz-test>") (s-text command) (s-key "Enter") (test-wait-for-text text))
(define removed "test ! -d \"$HOME/topic\" && ! /usr/bin/git -C \"$HOME/repo\" show-ref --verify --quiet refs/heads/topic && printf \"VERIFIED_%s\\n\" OK")
(define preserved "test -d \"$HOME/topic\" && /usr/bin/git -C \"$HOME/repo\" show-ref --verify --quiet refs/heads/topic && printf \"VERIFIED_%s\\n\" OK")
(define (collapse-space text)
  (list->string (reverse (foldl (lambda (ch result)
          (if (char-whitespace? ch) (if (and (pair? result) (equal? (car result) #\space)) result (cons #\space result)) (cons ch result))) '() (string->list text)))))
(test "agent-exit visible fallback handles keys, resize and reload" (lambda ()
    (s-start) (s-load "yinz:agent-exit") (test-wait-for-text "restart agent")
    (test-session "resize" (hash "rows" 30 "columns" 100)) (test-wait-for-text "restart agent")
    (test-session "reload" (hash "path" "yinz:agent-exit")) (test-wait-for-text "restart agent")
    (s-key "Esc") (closed)
    (test-wait-for "fallback pane closing render" (lambda () (not (string-contains? (s-screen) "restart agent"))))))
(test "agent-exit does not offer deletion for a primary checkout" grants (lambda ()
    (start-exit (hash) (hash "git" git-fixture) "/repo") (test-wait-for-text "Agent exited.")
    (assert (not (string-contains? (s-screen) "Delete worktree")))))
(test "agent-exit does not offer deletion outside a Git checkout" grants (lambda ()
    (start-exit (hash) (hash "git" "#!/bin/sh\nexit 128\n") "") (test-wait-for-text "No usable Git worktree")
    (assert (not (string-contains? (s-screen) "Delete worktree")))))
(test "agent-exit shows malformed project configuration while inspecting the checkout" grants (lambda ()
    (start-exit (hash "repo/.yinz/agent-exit.kdl" "broken {}") (hash "git" git-fixture) "/topic")
    (test-wait-for-text "must contain only one agent_exit block") (test-wait-for-text "Delete worktree & branch and close pane")))
(test "agent-exit removes a clean secondary worktree merged into its base" grants (lambda ()
    (start-exit (hash) (hash "git" git-fixture) "/topic") (test-wait-for-text "Delete: Delete worktree & branch and close pane")
    (s-key "Delete") (test-wait-for-text "Delete again")
    (test-session "resize" (hash "rows" 8 "columns" 24)) (test-wait-for-text "Deletion disabled") (s-key "Delete")
    (test-session "resize" (hash "rows" 30 "columns" 100)) (test-wait-for-text "Delete again")
    (test-wait-for-text "commits merged into the local base branch") (s-key "Delete") (closed)
    (assert (not (string-contains? (s-screen) "Deletion failed"))) (verify removed "VERIFIED_OK")))
(for-each (lambda (scenario)
    (test (string-append "agent-exit fetch cleanup: " (car scenario)) grants (lambda ()
        (start-exit (foldl (lambda (marker files) (hash-insert files marker "")) (hash "remote" "") (cadr scenario)) (hash "git" git-fixture) "/topic")
        (test-wait-for-text "Delete: Delete worktree & branch and close pane") (s-key "Delete") (test-wait-for-text "Delete again") (s-key "Delete")
        (unless (caddr scenario) (test-wait-for-text "Deletion failed") (s-key "Esc"))
        (closed) (verify (if (caddr scenario) removed preserved) "VERIFIED_OK"))))
  '(("remote ahead of local" ("unmerged" "remote-merged") #t)
    ("local ahead of remote" () #t)
    ("neither merged" ("unmerged") #f)
    ("failed fetch with local proof" ("fetch-fails") #t)
    ("failed fetch with stale remote proof" ("unmerged" "fetch-fails") #f)
    ("missing local branch" ("unmerged" "remote-merged" "missing-local") #t)
    ("configured trunk" ("unmerged" "remote-merged" "trunk") #t)
    ("changes during fetch" ("remote-merged" "change-during-fetch") #f)))
(for-each (lambda (scenario)
    (test (string-append "agent-exit preserves worktree and branch with " (car scenario)) grants (lambda ()
        (start-exit (hash (car scenario) "") (hash "git" git-fixture) "/topic")
        (test-wait-for-text "Delete: Delete worktree & branch and close pane") (s-key "Delete") (test-wait-for-text "Delete again") (s-key "Delete")
        (test-wait-for-text (cadr scenario)) (assert (string-contains? (collapse-space (s-screen)) "worktree and branch preserved"))
        (s-key "Esc") (closed) (verify preserved "VERIFIED_OK"))))
  '(("unmerged" "merged into local main") ("dirty-tracked" "uncommitted changes") ("dirty-untracked" "uncommitted changes") ("dirty-staged" "uncommitted changes")))
