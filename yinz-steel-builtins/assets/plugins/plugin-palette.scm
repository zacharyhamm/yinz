(define (get object key fallback)
  (if (and (hash? object) (hash-contains? object key)) (hash-ref object key) fallback))
(define (clean value)
  (list->string (map (lambda (c) (if (member c '(#\newline #\tab)) #\space c))
      (string->list (yinz-text-sanitize value)))))
(define (clip value count) (list->string (take (string->list value) (min count (length (string->list value))))))
(define (detail-text value)
  (define text (yinz-text-sanitize value))
  (yinz-markdown-escape (if (> (string-length text) 16384)
      (string-append (clip text 16384) "\n\n[Details truncated; plugin configuration is unchanged.]") text)))
(define (find predicate items)
  (cond ((null? items) #f) ((predicate (car items)) (car items)) (else (find predicate (cdr items)))))
(define (command name value) (yinz-command (hash name value)))
(define (complete message) (hash "type" "complete" "notification" message "view" json-null))
(define (defer thunk) (lambda (values context) (thunk)))
(define (action id label run)
  (hash "id" id "label" (yinz-markdown-escape (clip (clean label) 180)) "search" label "run" run))
(define (describe item description)
  (hash-insert (hash-insert item "description" (yinz-markdown-escape (clip (clean description) 256)))
    "search" (string-append (get item "search" "") " " description)))
(define (matches? query value)
  (let loop ((wanted (string->list (string-downcase query))) (remaining (string->list (string-downcase value))))
    (cond ((null? wanted) #t) ((null? remaining) #f)
      ((equal? (car wanted) (car remaining)) (loop (cdr wanted) (cdr remaining)))
      (else (loop wanted (cdr remaining))))))
(define (list-results title collect page previous-query)
  (hash "type" "actions" "title" title "initialQuery" previous-query
    "source" (lambda (query context)
      (define all (filter (lambda (item) (matches? query (get item "search" (hash-ref item "label")))) (collect)))
      (define offset (if (equal? query previous-query)
          (min (* page 98) (* (max 0 (- (quotient (+ (length all) 97) 98) 1)) 98)) 0))
      (append (take (list-tail all offset) (min 98 (- (length all) offset)))
        (if (> offset 0) (list (action "page:previous" "Previous results…"
              (defer (lambda () (list-results title collect (- (quotient offset 98) 1) query))))) '())
        (if (< (+ offset 98) (length all)) (list (action "page:next" "More results…"
              (defer (lambda () (list-results title collect (+ (quotient offset 98) 1) query))))) '())))))

(define (current-session)
  (or (find (lambda (session) (hash-ref session "is_current_session"))
      (hash-ref (yinz-command "GetSessionList") "live_sessions"))
    (error "Current session is no longer available")))
(define (plugin session id)
  (or (get (hash-ref session "plugins") id #f) (error "Plugin no longer exists")))
(define (plugin-label id info) (string-append "[plugin_" id "] " (hash-ref info "location")))
(define (plugin-pane-in? session id position)
  (find (lambda (pane) (and (hash-ref pane "is_plugin") (= (hash-ref pane "id") (string->number id))))
    (get (hash-ref (hash-ref session "panes") "panes") position '())))
;; A plugin that declares no pane runs headless and has nothing to focus.
(define (plugin-pane? session id)
  (and (find (lambda (position) (plugin-pane-in? session id position))
      (hash-keys->list (hash-ref (hash-ref session "panes") "panes"))) #t))
(define (plugin-tab session id)
  (define tab (find (lambda (tab) (plugin-pane-in? session id (number->string (hash-ref tab "position"))))
      (hash-ref session "tabs")))
  (if tab (string-append "Tab: " (hash-ref tab "name")) "Background / no tab"))
(define (plugin-details id)
  (define session (current-session)) (define info (plugin session id))
  (define config (hash-ref info "configuration"))
  (hash "type" "text" "title" (string-append "Plugin " id)
    "text" (detail-text (string-join
        (append (list (hash-ref info "location") (plugin-tab session id) "" "Configuration:")
          (if (null? (hash-keys->list config)) '("(none)")
            (map (lambda (key) (string-append key ": " (hash-ref config key))) (sort (hash-keys->list config) string<?)))) "  \n"))))
(define (operate id kind)
  (define session (current-session))
  (define info (plugin session id))
  (when (and (equal? kind "focus") (not (plugin-pane? session id)))
    (error "This plugin runs headless: it has no pane to focus"))
  (cond
    ((equal? kind "details") (plugin-details id))
    ((equal? kind "close")
      (hash "type" "form" "title" (string-append "Close plugin " id "?")
        "description" (yinz-markdown-escape (clean (hash-ref info "location")))
        "fields" '() "confirmation" #t "submitLabel" "Close plugin"
        "onSubmit" (lambda (values context)
          (unless (equal? info (plugin (current-session) id)) (error "Plugin changed; select it again"))
          (command "ClosePluginPane" (string->number id)) (complete "Plugin close requested"))))
    (else
      (command (if (equal? kind "focus") "FocusPluginPane" "ReloadPlugin")
        (if (equal? kind "focus") (list (string->number id) #t #f) (string->number id)))
      (complete (if (equal? kind "focus") "Plugin focus requested" "Plugin reload requested")))))
(define (plugin-actions id)
  (define session (current-session)) (define info (plugin session id))
  (hash "type" "actions" "title" (yinz-markdown-escape (clip (clean (plugin-label id info)) 180))
    "actions" (map (lambda (pair) (action (car pair) (cadr pair) (defer (lambda () (operate id (car pair))))))
      (append (if (plugin-pane? session id) '(("focus" "Focus plugin")) '())
        '(("reload" "Reload plugin") ("close" "Close plugin…") ("details" "Plugin details…"))))))
(define (inventory kind title)
  (list-results title
    (lambda ()
      (define session (current-session)) (define plugins (hash-ref session "plugins"))
      ;; Only a plugin with a pane can be focused; most running plugins are headless.
      (define listed (if (equal? kind "focus")
          (filter (lambda (id) (plugin-pane? session id)) (hash-keys->list plugins))
          (hash-keys->list plugins)))
      (map (lambda (id)
          (describe (action id (plugin-label id (hash-ref plugins id))
              (defer (lambda () (if (equal? kind "plugins") (plugin-actions id) (operate id kind)))))
            (plugin-tab session id)))
        (sort listed (lambda (a b) (< (string->number a) (string->number b)))))) 0 ""))

(define (config-form draft old-key)
  (define config (vector-ref draft 0))
  (hash "type" "form" "title" (if old-key "Edit plugin configuration" "Add plugin configuration")
    "submitLabel" "Save entry"
    "fields" (list (hash "type" "text" "id" "key" "label" "Key" "initialValue" (or old-key ""))
      (hash "type" "multiline" "id" "value" "label" "Value" "initialValue" (if old-key (get config old-key "") "")
        "help" "Shift+Enter inserts a newline."))
    "onSubmit" (lambda (values context)
      (define key (get values "key" "")) (define config (vector-ref draft 0))
      (when (and (hash-contains? config key) (not (equal? key old-key))) (error "This configuration key already exists"))
      (vector-set! draft 0 (hash-insert (if old-key (hash-remove config old-key) config) key (get values "value" "")))
      (config-list draft))
    "actions" (if old-key (list (action "remove" "Remove entry"
          (defer (lambda () (vector-set! draft 0 (hash-remove (vector-ref draft 0) old-key)) (config-list draft))))) '())))
(define (config-list draft)
  (hash-insert (list-results "Plugin configuration"
      (lambda ()
        (define config (vector-ref draft 0))
        (cons (action "add" "Add entry…" (defer (lambda () (config-form draft #f))))
          (map (lambda (key)
              (define label (clip (clean key) 180))
              (describe (action (yinz-json-string (list key))
                  (cond ((equal? key "") "(empty key)") ((equal? (trim label) "") "(blank key)") (else key))
                  (defer (lambda () (config-form draft key)))) (hash-ref config key)))
            (sort (hash-keys->list config) string<?)))) 0 "")
    "description" "Changes apply when you load the plugin. Esc returns to the load form."))
(define (file-url path)
  (string-append "file:"
    (if (not (starts-with? path "/")) path
      (apply string-append (map (lambda (character)
            (cond ((equal? character #\%) "%25") ((equal? character #\#) "%23")
              ((equal? character #\?) "%3F") (else (string character)))) (string->list path))))))
(define (load-form from-file? initial draft)
  (hash "type" "form" "title" (if from-file? "Load plugin from file" "Load plugin") "submitLabel" "Load plugin"
    ;; Choice fields carry no help line, so the placement note is the form's description.
    "description" "Foreground opens a pane only for plugins that declare one."
    "fields" (list (hash "type" (if from-file? "file" "text") "id" "location"
        "label" (if from-file? "Plugin file" "Plugin URL or alias") "initialValue" (get initial "location" ""))
      (hash "type" "choice" "id" "placement" "label" "Placement" "options" '("Foreground" "Background")
        "initialValue" (get initial "placement" "Foreground")))
    "onSubmit" (lambda (values context)
      (define location (get values "location" ""))
      (when (equal? (trim location) "") (error "Enter a plugin location"))
      (define pane (get context "paneId" json-null))
      (define cwd (if (and (hash? pane) (hash-contains? pane "Terminal"))
          (command "GetPaneCwd" (hash "pane_id" pane)) json-null))
      (command "LoadNewPlugin" (hash "url" (if from-file? (file-url location) location)
          "config" (vector-ref draft 0) "load_in_background" (equal? (get values "placement" "Foreground") "Background")
          "skip_plugin_cache" #t "cwd" cwd))
      (complete "Plugin load requested"))
    "actions" (append (list (action "configuration" "Edit configuration…" (defer (lambda () (config-list draft)))))
      (if from-file? '()
        (list (action "file" "Load from file…" (lambda (values context)
              (load-form #t (hash-insert values "location" "") draft))))))))

(define (load configuration)
  (yinz-palette-register "plugins" "Plugins"
    (append (map (lambda (pair) (action (car pair) (cadr pair) (defer (lambda () (inventory (car pair) (cadr pair))))))
        '(("plugins" "Plugins…") ("focus" "Focus plugin…") ("reload" "Reload plugin…") ("close" "Close plugin…")))
      (list (action "load" "Load plugin…" (defer (lambda () (load-form #f (hash) (vector (hash))))))))))
