(provide agent-row-status agent-row-counts)
(define (status-field value key fallback)
  (if (and (hash? value) (hash-contains? value key)) (hash-ref value key) fallback))
(define (agent-row-status row)
  (define text (status-field (status-field row "Agent" #f) "text" ""))
  (define symbol (substring text (max 0 (- (string-length text) 1)) (string-length text)))
  (cond ((equal? symbol "■") "held") ((equal? symbol "×") "exited")
    ((status-field (status-field row "Agent" #f) "waiting" #f) "needs input")
    (else (status-field (hash "●" "working" "!" "needs input" "○" "idle") symbol "unknown"))))
(define (agent-row-counts rows)
  (define counts (hash "total" 0 "busy" 0 "waiting" 0 "idle" 0 "held" 0 "exited" 0 "unknown" 0))
  (for-each (lambda (row)
      (when (status-field row "Agent" #f)
        (define status (agent-row-status row))
        (define key (cond ((equal? status "working") "busy") ((equal? status "needs input") "waiting") (else status)))
        (set! counts (hash-insert counts "total" (+ 1 (hash-ref counts "total"))))
        (set! counts (hash-insert counts key (+ 1 (hash-ref counts key)))))) rows)
  counts)
