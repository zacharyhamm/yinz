(require "../project-store/common.scm")
(provide archive-list-runs archive-run-header archive-predecessors archive-entry-page archive-search-detail
  archive-search archive-search-runs)

(define (a-model operation . arguments) (yinz-agent-model "archive" operation arguments))
(define (a-size rows) (length (hash-ref rows "rows")))
(define (a-sort request order) (hash-insert request "sort" order))
(define (a-select request columns) (hash-insert request "select" columns))
(define (a-offset request offset) (hash-insert request "offset" (modulo offset 4294967296)))
(define (a-clamp value upper) (max 1 (min upper value)))
(define (a-bound operation column value) (hash operation (list column (ps-value value))))
(define (a-i64 value) (if (> value 9223372036854775807) (- value 18446744073709551616) value))
(define (a-scoped request scope) (if (json-null? scope) request (ps-filter request scope)))
(define (a-entry-request id) (ps-filter (ps-request "agent_run_entry") (ps-eq "run_id" id)))
(define (a-empty cut) (hash "hits" '() "runs" (hash) "truncated" cut))

(define (archive-list-runs filter limit offset)
  (define rows (ps-fetch (a-model "ListRunsRequest" filter limit offset)))
  (a-model "ListRunsPage" filter limit rows))

(define (archive-run-header id)
  (define runs (ps-model "agents" "RunsFromRows" (ps-fetch (ps-model "agents" "RunByIdRequest" id))))
  (if (null? runs) json-null (ps-model "agents" "RunHeader" (car runs))))
(define (archive-predecessors anchor)
  (let loop ((next (ps-get anchor "previous_run_id" json-null)) (seen (list (hash-ref anchor "id"))) (headers '()))
    (define (finish diagnostic) (hash "headers" (reverse headers) "diagnostic" diagnostic))
    (cond ((json-null? next) (finish ""))
      ((member next seen) (finish (string-append "Incomplete chain: repeated run " next)))
      (else
        (define result (with-handler (lambda (failure) (hash "error" (ps-error failure))) (hash "header" (archive-run-header next))))
        (cond ((hash-contains? result "error") (finish (string-append "Incomplete chain: could not read " next ": " (hash-ref result "error"))))
          ((json-null? (hash-ref result "header")) (finish (string-append "Incomplete chain: missing run " next)))
          (else (define header (hash-ref result "header"))
            (loop (ps-get header "previous_run_id" json-null) (cons next seen) (cons header headers))))))))

(define (archive-entry-page id from limit)
  (define limit (a-clamp limit 100))
  (define forward (not (json-null? from)))
  (define total (ps-count (a-entry-request id)))
  (define request (ps-limit (a-entry-request id) limit))
  (define rows (ps-fetch (if forward
        (a-sort (ps-filter request (a-bound "Gte" "revision" (a-i64 from))) '(("revision" "Asc")))
        (a-sort request '(("revision" "Desc"))))))
  (define budget (a-model "Budget" (ps-get (ps-model "agents" "EntriesFromRows" rows) id '()) (not forward) (and forward (= limit 1))))
  (define entries (hash-ref budget "entries"))
  (define next json-null)
  (when (and forward (not (null? entries)))
    (define last-revision (hash-ref (car (reverse entries)) "revision"))
    (when (> (ps-count (ps-filter (a-entry-request id) (a-bound "Gt" "revision" (a-i64 last-revision)))) 0)
      (set! next (min 18446744073709551615 (+ last-revision 1)))))
  (define boundary (if (null? entries) from (hash-ref (car entries) "revision")))
  (define earlier (and (not (json-null? boundary)) (> (ps-count (ps-filter (a-entry-request id) (a-bound "Lt" "revision" (a-i64 boundary)))) 0)))
  (hash-insert (hash-insert (hash-insert budget "total" total) "next_revision" next) "earlier" earlier))
(define (archive-search-detail id revision)
  (define page (archive-entry-page id (max 1 (- revision 2)) 100))
  (define full (archive-entry-page id revision 1))
  (define exact (filter (lambda (entry) (= (hash-ref entry "revision") revision)) (hash-ref full "entries")))
  (if (or (null? exact) (not (member revision (map (lambda (entry) (hash-ref entry "revision")) (hash-ref page "entries"))))) page
    (hash-insert (hash-insert page "entries" (map (lambda (entry) (if (= (hash-ref entry "revision") revision) (car exact) entry)) (hash-ref page "entries")))
      "truncated_revisions" (filter (lambda (value) (not (= value revision))) (hash-ref page "truncated_revisions")))))
(define (a-headers ids)
  (foldl (lambda (chunk found)
      (define rows (ps-fetch (ps-limit (a-select (ps-filter (ps-request "agent_run") (ps-in "uid" chunk)) '("payload")) (length chunk))))
      (foldl (lambda (run found) (hash-insert found (hash-ref run "id") (ps-model "agents" "RunHeader" run))) found
        (ps-model "agents" "RunsFromRows" rows))) (hash) (ps-chunks (sort (ps-unique ids) string<?))))
(define (a-scope filter)
  (let loop ((offset 0) (ids '()))
    (define page (archive-list-runs filter 50 offset))
    (define ids (append ids (map (lambda (header) (hash-ref header "id")) (hash-ref page "headers"))))
    (cond ((>= (length ids) 400) (list (take ids 400) #t))
      ((or (not (hash-ref page "more")) (= (hash-ref page "scanned") 0)) (list ids #f))
      ((>= (+ offset (hash-ref page "scanned")) 4000) (list ids #t))
      (else (loop (+ offset (hash-ref page "scanned")) ids)))))
(define (a-hits-for query scope limit)
  (define want (+ limit 1))
  (define columns '("run_id" "revision" "kind" "text" "created_at_ms" "host_id"))
  (define rows (ps-fetch (a-scoped (ps-limit (a-select (hash-insert (ps-request "agent_run_entry") "search" query) columns) want) scope)))
  (when (= (a-size rows) 0)
    (set! rows (ps-fetch (a-scoped (ps-limit (a-select (a-sort (ps-filter (ps-request "agent_run_entry") (hash "Contains" (list "text" query)))
                '(("created_at_ms" "Desc"))) columns) want) scope))))
  (define request (a-scoped (a-sort (ps-filter (ps-request "agent_run_entry") (hash "NotNull" "tool"))
        '(("created_at_ms" "Desc") ("uid" "Asc"))) scope))
  (let loop ((scanned 0) (matches 0) (hits (a-model "HitsFromRows" rows query #f)))
    (define page (ps-fetch (ps-limit (a-offset request scanned) (min 100 (- 4000 scanned)))))
    (define fresh (a-model "HitsFromRows" page query #t))
    (define matches (+ matches (length fresh)))
    (define scanned (+ scanned (a-size page)))
    (define hits (foldl (lambda (hit hits)
          (if (not (null? (filter (lambda (old) (and (equal? (hash-ref old "run_id") (hash-ref hit "run_id")) (= (hash-ref old "revision") (hash-ref hit "revision")))) hits)))
            hits (append hits (list hit)))) hits fresh))
    (define cut (and (hash-ref page "truncated") (or (= (a-size page) 0) (= scanned 4000) (>= matches want))))
    (if (or (not (hash-ref page "truncated")) cut)
      (list (a-model "SortHits" hits) (or (hash-ref rows "truncated") cut))
      (loop scanned matches hits))))

(define (a-regex-hits pattern scope limit)
  (define request (a-scoped (ps-limit (a-sort (a-select (ps-request "agent_run_entry")
            '("id" "run_id" "revision" "kind" "created_at_ms" "text")) '(("id" "Desc"))) 100) scope))
  (define (finish hits cut) (list (a-model "SortHits" (take hits (min limit (length hits)))) cut))
  (let page-loop ((last-id json-null) (scanned 0) (bytes 0) (hits '()))
    (define page (ps-fetch (if (json-null? last-id) request (ps-filter request (a-bound "Lt" "id" last-id)))))
    (let row-loop ((rows (ps-rows page)) (last-id last-id) (scanned scanned) (bytes bytes) (hits hits))
      (cond ((null? rows)
          (cond ((not (hash-ref page "truncated")) (finish hits #f))
            ((or (= (a-size page) 0) (= scanned 4000) (= bytes 8388608)) (finish hits #t))
            (else (page-loop last-id scanned bytes hits))))
        ((= scanned 4000) (finish hits #t))
        (else
          (define row (car rows))
          (define id (ps-get row "id" #f))
          (unless (and (integer? id) (exact? id)) (error "history entry has no database id"))
          (define text (ps-get row "text" #f))
          (cond ((not (string? text)) (row-loop (cdr rows) id (+ scanned 1) bytes hits))
            ((> (utf8-length text) (- 8388608 bytes)) (finish hits #t))
            (else
              (define snippet (yinz-archive-match pattern text))
              (define run (ps-get row "run_id" #f))
              (define revision (ps-get row "revision" #f))
              (define label (ps-get row "kind" #f))
              (define kind (if (string? label) (a-model "KindFromLabel" label) json-null))
              (define hit (and (not (json-null? snippet)) (string? run) (integer? revision) (>= revision 0) (not (json-null? kind))
                  (hash "run_id" run "revision" revision "kind" kind "created_at_ms" (ps-get row "created_at_ms" json-null) "snippet" snippet)))
              (define hits (if hit (append hits (list hit)) hits))
              (if (> (length hits) limit) (finish hits #t)
                (row-loop (cdr rows) id (+ scanned 1) (+ bytes (utf8-length text)) hits)))))))))

(define (archive-search query filter run-id regex limit)
  (define pattern (and regex (yinz-archive-pattern query)))
  (define query (if regex query (trim query)))
  (if (equal? query "") (a-empty #f)
    (let* ((limit (a-clamp limit 50))
        (scope (cond ((not (json-null? run-id)) (list (list run-id) #f))
            ((hash-ref (a-model "Filter" filter) "empty") (list json-null #f)) (else (a-scope filter))))
        (ids (car scope)) (partial (cadr scope)))
      (if (and (list? ids) (null? ids)) (a-empty partial)
        (let* ((pages (if regex (list (a-regex-hits pattern (if (json-null? ids) json-null (ps-in "run_id" ids)) limit))
                (if (json-null? ids) (list (a-hits-for query json-null limit))
                  (map (lambda (chunk) (a-hits-for query (ps-in "run_id" chunk) limit)) (ps-chunks ids)))))
            (all (apply append (map car pages))) (hits (take all (min limit (length all)))))
          (hash "hits" hits "runs" (a-headers (map (lambda (hit) (hash-ref hit "run_id")) hits))
            "truncated" (or (> (length all) limit) partial (foldl (lambda (page cut) (or cut (cadr page))) #f pages))))))))

(define (archive-search-runs raw-query prompts-only)
  (define query (trim raw-query))
  (define (entries)
    (define request (ps-request "agent_run_entry"))
    (if prompts-only (ps-filter request (ps-eq "kind" "prompt")) request))
  (if (equal? query "") (a-empty #f)
    (let* ((request (ps-limit (hash-insert (entries) "search" query) 100)) (page (ps-fetch request)))
      (when (= (a-size page) 0)
        (set! request (ps-limit (a-sort (ps-filter (entries) (hash "Contains" (list "text" query)))
              '(("created_at_ms" "Desc") ("uid" "Asc"))) 100))
        (set! page (ps-fetch request)))
      (let loop ((request request) (page page) (offset 0) (scanned 0) (tools #f) (seen '()) (hits '()) (runs (hash)))
        (define scanned (+ scanned (a-size page)))
        (define fresh (a-model "HitsFromRows" page query tools))
        (define headers (a-headers (map (lambda (hit) (hash-ref hit "run_id"))
              (filter (lambda (hit) (not (member (hash-ref hit "run_id") seen))) fresh))))
        (define overflow #f)
        (for-each (lambda (hit)
            (define id (hash-ref hit "run_id"))
            (unless (or overflow (member id seen))
              (set! seen (cons id seen))
              (when (hash-contains? headers id)
                (if (= (length hits) 50) (set! overflow #t)
                  (begin (set! hits (append hits (list hit))) (set! runs (hash-insert runs id (hash-ref headers id)))))))) fresh)
        (define exhausted (or (= (a-size page) 0) (not (hash-ref page "truncated"))))
        (cond (overflow (hash "hits" hits "runs" runs "truncated" #t))
          ((and exhausted (or tools prompts-only)) (hash "hits" hits "runs" runs "truncated" #f))
          ((>= scanned 4000) (hash "hits" hits "runs" runs "truncated" #t))
          (else
            (define request (if exhausted (ps-limit (a-sort (ps-filter (ps-request "agent_run_entry") (hash "NotNull" "tool"))
                    '(("created_at_ms" "Desc") ("uid" "Asc"))) 100) request))
            (define offset (if exhausted 0 (+ offset (a-size page))))
            (loop request (ps-fetch (ps-limit (a-offset request offset) (min 100 (- 4000 scanned)))) offset scanned
              (or tools exhausted) seen hits runs)))))))
