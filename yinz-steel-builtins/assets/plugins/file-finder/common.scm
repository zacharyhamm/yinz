(provide ff-all ff-any ff-get ff-present? ff-safe ff-absolute? ff-join ff-parent ff-leaf ff-host-path
  ff-quote ff-nonblank ff-strings ff-fields ff-read ff-metadata ff-remove
  ff-file-url ff-plugin-destination ff-geometry ff-project-label)

(define (ff-all predicate values)
  (or (null? values) (and (predicate (car values)) (ff-all predicate (cdr values)))))
(define (ff-any predicate values)
  (and (not (null? values)) (or (predicate (car values)) (ff-any predicate (cdr values)))))
(define (ff-get object key fallback)
  (if (and (hash? object) (hash-contains? object key)) (hash-ref object key) fallback))
(define (ff-present? value) (and value (not (json-null? value))))
(define (ff-safe thunk fallback) (with-handler (lambda (failure) fallback) (thunk)))
(define (ff-absolute? path) (starts-with? path "/"))
(define (ff-join parent child)
  (if (ff-absolute? child) child
    (string-append (if (ends-with? parent "/") parent (string-append parent "/")) child)))
(define (ff-components path) (filter (lambda (part) (not (equal? part ""))) (split-many path "/")))
(define (ff-leaf path)
  (define parts (ff-components path))
  (if (null? parts) #f (car (reverse parts))))
(define (ff-parent path)
  (define parts (reverse (ff-components path)))
  (if (null? parts) "/"
    (string-append (if (ff-absolute? path) "/" "") (string-join (reverse (cdr parts)) "/"))))
(define (ff-host-path path)
  (if (ff-absolute? path) (string-append "/host" path) (ff-join "/host" path)))
(define (ff-quote value) (string-append "'" (string-replace value "'" "'\\''") "'"))
(define (ff-nonblank value label)
  (unless (and (string? value) (not (equal? (trim value) "")) (not (string-contains? value "\u{0}")))
    (error (string-append label " must be nonblank and contain no NUL"))) value)
(define (ff-strings values label)
  (unless (and (list? values) (ff-all string? values)) (error (string-append label " must contain strings"))) values)
(define (ff-fields object allowed)
  (unless (and (hash? object) (ff-all (lambda (key) (member key allowed)) (hash-keys->list object)))
    (error "unexpected fields")))
(define (ff-read path)
  (define bytes (yinz-command (hash "FsRead" (hash "path" path "max_bytes" 4194304 "offset" json-null))))
  (with-handler (lambda (failure) (error "stream did not contain valid UTF-8"))
    (bytes->string/utf8 (if (bytevector? bytes) bytes (list->bytes bytes)))))
(define (ff-metadata path)
  (ff-safe (lambda () (yinz-command (hash "FsMetadata" (hash "path" path "follow_symlinks" #t)))) json-null))
(define (ff-remove path)
  (ff-safe (lambda () (yinz-command (hash "FsRemove" (hash "path" path "recursive" #f)))) json-null))
(define (ff-file-url path)
  (define hex "0123456789ABCDEF")
  (string-append "file://"
    (apply string-append
      (map (lambda (byte)
          (if (or (<= byte 32) (>= byte 127) (member byte '(34 35 37 60 62 63 92 96 123 125)))
            (string-append "%" (substring hex (quotient byte 16) (+ (quotient byte 16) 1))
              (substring hex (modulo byte 16) (+ (modulo byte 16) 1)))
            (string (integer->char byte))))
        (bytes->list (string->bytes path))))))
(define (ff-plugin-destination value)
  (ff-nonblank value "plugin destination")
  (cond
    [(ff-absolute? value) (ff-file-url value)]
    [(not (string-contains? value ":"))
      (when (or (string-contains? value "/") (string-contains? value "\\") (starts-with? value "."))
        (error "plugin destination must be an alias or an absolute path")) value]
    [(or (string-contains? value "?") (string-contains? value "#"))
      (error "escape literal # and ? in plugin URL paths")]
    [(and (starts-with? value "yinz:") (> (string-length value) 5) (not (starts-with? value "yinz://"))) value]
    [(and (starts-with? value "file:/")
        (or (not (starts-with? value "file://")) (starts-with? value "file:///") (starts-with? value "file://localhost/"))) value]
    [else (error "expected an alias, yinz: URL, absolute path, or absolute local file: URL")]))
(define (ff-geometry config)
  (define (dimension name fallback positive)
    (define raw (trim (ff-get config name fallback)))
    (define value (if (equal? raw "") fallback raw))
    (define percent (ends-with? value "%"))
    (define number (string->number (if percent (substring value 0 (- (string-length value) 1)) value)))
    (if (and number (integer? number) (>= number (if positive 1 0)) (or (not percent) (<= number 100)))
      (hash (if percent "Percent" "Fixed") number) json-null))
  (define coordinates (hash "x" (dimension "x" "" #f) "y" (dimension "y" "15%" #f)
      "width" (dimension "width" "120" #t) "height" (dimension "height" "70%" #t)
      "pinned" json-null "borderless" json-null))
  (if (ff-all (lambda (key) (json-null? (hash-ref coordinates key))) '("x" "y" "width" "height"))
    json-null coordinates))
(define (ff-project-label cwd)
  (and (ff-absolute? cwd)
    (let walk ([path cwd])
      (define dot-git (ff-join path ".git"))
      (define metadata (ff-metadata (ff-host-path dot-git)))
      (cond
        [(ff-present? metadata)
          (define name (ff-leaf path))
          (define branch
            (ff-safe (lambda ()
                (define git-dir
                  (if (ff-get metadata "is_dir" #f) dot-git
                    (let ([pointer (ff-read (ff-host-path dot-git))])
                      (unless (starts-with? pointer "gitdir:") (error "invalid gitdir pointer"))
                      (define target (trim (substring pointer 7 (string-length pointer))))
                      (ff-nonblank target "gitdir")
                      (ff-join path target))))
                (define head (trim (ff-read (ff-host-path (ff-join git-dir "HEAD")))))
                (unless (starts-with? head "ref:") (error "detached HEAD"))
                (define reference (trim (substring head 4 (string-length head))))
                (unless (and (starts-with? reference "refs/heads/") (> (string-length reference) 11)) (error "not a branch"))
                (substring reference 11 (string-length reference))) #f))
          (and name (if branch (string-append name " (" branch ")") name))]
        [(equal? path "/") (ff-leaf cwd)]
        [else (walk (ff-parent path))]))))
