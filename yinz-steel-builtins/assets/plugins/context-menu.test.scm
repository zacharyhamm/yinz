(require "./testing/common.scm")
(define source (hash "request_id" 10 "pane_id" (hash "Terminal" 7) "items" (list (hash "id" 1 "label" "Custom action")) "selected_text" json-null "link" json-null))
(test "context-menu adds agent actions only for terminal agent records" (lambda ()
    (t-load "./context-menu.scm" (hash "RunCommand" json-null "SetContextMenu" json-null "GetPaneInfo" json-null))
    (for-each (lambda (pane)
        (test-stub "GetPaneInfo" pane)
        (for-each (lambda (id)
            (test-event (hash "ContextMenuRequested" (hash-insert source "pane_id" id)))
            (define agent (and (hash-contains? id "Terminal") (not (json-null? (t-get pane "agent" json-null)))))
            (assert-equal (t-last (test-commands)) (hash "SetContextMenu" (hash "request_id" 10 "items"
                  (append (if agent (list (hash "label" "Duplicate agent" "context" (hash "action" "duplicate_agent")) (hash "label" "Fork agent" "context" (hash "action" "fork_agent")) (hash "separator" #t)) '()) (hash-ref source "items"))))))
          (list (hash "Terminal" 7) (hash "Plugin" 7))))
      (list json-null (hash "agent" json-null) (hash "agent" (hash "kind" "codex" "source" "Reported"))))))
(test "context-menu agent selection retains clicked source and rechecks its record" (lambda ()
    (t-load "./context-menu.scm" (hash "RunCommand" json-null "SetContextMenu" json-null "RunAction" json-null))
    (for-each (lambda (action)
        (test-stub "GetPaneInfo" (hash "agent" (hash "kind" "codex")))
        (test-event (hash "ContextMenuRequested" source))
        (test-stub "GetFocusedPaneInfo" (hash "pane_id" (hash "Terminal" 99) "tab_id" 1))
        (define selected (hash "ContextMenuItemSelected" (hash "label" "" "item_context" (hash "action" action) "context" source)))
        (test-event selected)
        (assert-equal (take (reverse (test-commands)) 2) (reverse (list (hash "GetPaneInfo" (hash "Terminal" 7))
              (hash "RunAction" (list (hash "LaunchPlugin" (hash "plugin" (hash "RunPlugin" (hash "location" (hash "Yinz" "new-agent")
                          "configuration" (hash "caller_terminal_pane_id" "7" (if (equal? action "fork_agent") "fork_focused" "duplicate_focused") "true" "overlay" "true" "modal" "true") "initial_cwd" json-null))
                      "should_float" #t "should_open_in_place" #f "close_replaced_pane" #f "skip_cache" #f "cwd" json-null "no_focus" #f "tab_id" json-null)) (hash))))))
        (for-each (lambda (missing) (test-stub "GetPaneInfo" missing) (test-event selected)
            (assert-equal (t-last (test-commands)) (hash "GetPaneInfo" (hash "Terminal" 7)))) (list json-null (hash "agent" json-null)))) '("duplicate_agent" "fork_agent"))))
(test "context-menu removes unavailable Copy and redundant separators" (lambda ()
    (t-load "./context-menu.scm" (hash "RunCommand" json-null "SetContextMenu" json-null "GetPaneInfo" json-null))
    (test-event (hash "ContextMenuRequested" (t-merge source (hash "request_id" 9 "items" (list (hash "separator" #t) (hash "id" 1 "label" "Copy") (hash "separator" #t) (hash "id" 2 "label" "Close") (hash "separator" #t))))))
    (assert-equal (t-last (test-commands)) (hash "SetContextMenu" (hash "request_id" 9 "items" (list (hash "id" 2 "label" "Close")))))))
(test "context-menu selection dispatches its chosen link opener" (lambda ()
    (t-load "./context-menu.scm" (hash "RunCommand" json-null))
    (test-event (hash "RunCommandResult" (list 0 '() '() (hash "probe" "xdg-open"))))
    (test-event (hash "ContextMenuItemSelected" (hash "item_context" (hash "action" "open_link" "url" "https://example.test"))))
    (assert-equal (t-last (test-commands)) (hash "RunCommand" (list '("xdg-open" "https://example.test") (hash) "" (hash) 64 json-null)))))
