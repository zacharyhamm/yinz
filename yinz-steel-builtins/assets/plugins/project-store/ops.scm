(require "./common.scm" "./notes.scm" "./archive.scm")
(provide ps-mutate ps-query)

(define (project-rows) (ps-fetch (ps-limit (ps-request "project") 1000)))
(define (project-values registry) (map (lambda (name) (hash-ref registry name)) (sort (hash-keys->list registry) string<?)))
(define (load-view operation arguments)
  (define rows (project-rows))
  (define registry (ps-projects rows))
  (define root (and (member operation '("todo_add" "todo_done" "todo_edit" "todo_list" "todo_delete" "todo_move"))
      (ps-safe (lambda () (ps-todo-root registry arguments)) #f)))
  (hash "rows" rows "projects" registry "list" (if root (ps-todo-list (car root)) (hash "items" '() "next_id" 0))))
(define (required arguments key)
  (define text (ps-arg arguments key))
  (unless text (error (string-append key " is required"))) text)
(define (required-id arguments)
  (define id (ps-id arguments "id"))
  (unless id (error "id is required")) id)
(define (plan view operation arguments)
  (define registry (hash-ref view "projects"))
  (define items (hash-ref view "list"))
  (cond
    ((equal? operation "project_remember")
      (define name (required arguments "name"))
      (define worktree-dir (ps-get arguments "worktree_dir" json-null))
      (define planned (ps-plan "projects" "PlanRemember" (hash-ref view "rows") name
          (ps-nullable (ps-arg arguments "root")) (if (string? worktree-dir) worktree-dir json-null)))
      (define project (car planned))
      (define old (filter (lambda (old) (and (hash-ref old "discovered")
              (not (equal? (hash-ref old "name") (hash-ref project "name")))
              (equal? (hash-ref old "root") (hash-ref project "root")))) (project-values registry)))
      (list (cadr planned) (string-append "remembered " (hash-ref project "name")
          (if (null? old) "" (string-append ", replacing discovered " (hash-ref (car old) "name"))))))
    ((equal? operation "project_forget")
      (define name (required arguments "name"))
      (define project (ps-get registry name #f))
      (unless project (error (string-append "unknown project " name "; call project_list")))
      (list (list (ps-plan "projects" "AssertProjects" (hash-ref view "rows") "name" (list name))
          (ps-model "projects" "DeleteMutation" name)) (ps-model "projects" "Forgotten" project)))
    ((equal? operation "todo_add")
      (define text (required arguments "text"))
      (define root (ps-todo-root registry arguments))
      (define planned (ps-plan "todos" "PlanAdd" items (car root) text (ps-nullable (ps-id arguments "parent_id"))))
      (list (car planned) (hash "project" (cadr root) "text" (cadr planned))))
    ((equal? operation "todo_done")
      (define id (required-id arguments))
      (define root (ps-todo-root registry arguments))
      (define planned (ps-plan "todos" "PlanDone" items (car root) id (not (ps-flag arguments "undo"))))
      (list (car planned) (yinz-json-string (hash-insert (cadr planned) "project" (cadr root)))))
    ((equal? operation "todo_delete")
      (define id (required-id arguments))
      (define root (ps-todo-root registry arguments))
      (define planned (ps-plan "todos" "PlanDelete" items (car root) id (ps-flag arguments "recursive")))
      (list (car planned) (yinz-json-string (hash "project" (cadr root) "id" id "deleted" #t "deleted_ids" (cadr planned)))))
    ((equal? operation "todo_move")
      (define id (required-id arguments))
      (define root (ps-todo-root registry arguments))
      (define parent (ps-nullable (ps-id arguments "parent_id")))
      (define planned (ps-plan "todos" "PlanMove" items (car root) id parent (ps-revision arguments)))
      (list (car planned) (yinz-json-string (hash "project" (cadr root) "id" id "parent_id" parent "reopened" (cadr planned)))))
    ((equal? operation "todo_edit")
      (define id (ps-id arguments "id"))
      (define text (ps-arg arguments "text"))
      (unless (and id text) (error "id and text are required"))
      (define root (ps-todo-root registry arguments))
      (define planned (ps-plan "todos" "PlanEdit" items id text (ps-revision arguments)))
      (list (car planned) (yinz-json-string (hash "project" (cadr root) "id" id "text" (cadr planned)))))
    (else (error (string-append "unknown op " operation)))))
(define (edit-conflict view arguments)
  (define id (ps-id arguments "id"))
  (if (not id) "the row was written by somebody else first; read it again and decide"
    (let ((item (ps-safe (lambda ()
              (ps-model "todos" "Item" (ps-todo-list (car (ps-todo-root (hash-ref view "projects") arguments))) id)) json-null)))
      (string-append "todo item " (number->string id)
        (if (json-null? item) " was edited or removed by somebody else"
          (string-append " was edited by somebody else and now reads " (ps-debug (hash-ref item "text"))
            " at rev " (number->string (ps-get item "rev" 0)) "; retry with that expect_rev if the change is still wanted"))))))
(define (ps-mutate operation arguments)
  (cond
    ((member operation '("project_rename" "project_merge"))
      (define rows (project-rows))
      (define (text key)
        (define result (ps-get arguments key #f))
        (unless (string? result) (error (string-append key " is required"))) result)
      (define change (if (equal? operation "project_rename")
          (ps-plan "projects" "PlanRename" rows (text "name") (text "new_name"))
          (ps-plan "projects" "PlanMerge" rows (text "source") (text "target"))))
      (ps-apply (hash-ref change "mutations"))
      (yinz-json-string (hash "project" (hash-ref change "project") "replaced" (hash-ref change "replaced"))))
    ((starts-with? operation "note_") (ps-note-mutate operation arguments))
    (else
      (define view (load-view operation arguments))
      (define planned (plan view operation arguments))
      (define report (with-handler (lambda (failure)
            (define message (ps-error failure))
            (error (if (ps-conflict? message)
                (if (member operation '("todo_add" "todo_done" "todo_move" "todo_delete"))
                  "the todo list changed; reload and retry" (edit-conflict view arguments)) message)))
          (ps-apply (car planned))))
      (if (hash? (cadr planned))
        (yinz-json-string (hash-insert (cadr planned) "id" (if (null? (hash-ref report "ids")) 0 (car (hash-ref report "ids")))))
        (cadr planned)))))
(define (query-view view operation arguments)
  (define registry (hash-ref view "projects"))
  (cond
    ((equal? operation "project_list")
      (hash "projects" (map (lambda (project)
            (foldl (lambda (key result) (hash-insert result key (ps-get project key json-null))) (hash)
              '("name" "root" "remote" "worktree_status" "discovered"))) (project-values registry))))
    ((equal? operation "todo_list")
      (define root (ps-todo-root registry arguments))
      (hash-insert (ps-model "todos" "ListJson" (hash (car root) (hash-ref view "list")) (car root)
          (ps-flag arguments "include_done")) "project" (cadr root)))
    (else (error (string-append "unknown op " operation)))))
(define (search-todos arguments)
  (define query (required arguments "query"))
  (define registry (ps-projects (project-rows)))
  (define selector (ps-arg arguments "project"))
  (define scope (and selector (car (ps-plan "todos" "Resolve" registry selector))))
  (define (scoped request) (if scope (ps-filter request (ps-eq "root" scope)) request))
  (define hits (ps-fetch (scoped (ps-limit (hash-insert (ps-request "todo") "search" query) 50))))
  (when (null? (hash-ref hits "rows"))
    (set! hits (ps-fetch (scoped (ps-limit (ps-filter (ps-request "todo") (hash "Contains" (list "text" query))) 50)))))
  (define found (ps-model "todos" "ItemsFromRows" hits))
  (define lists (hash))
  (for-each (lambda (entry)
      (unless (hash-contains? lists (car entry)) (set! lists (hash-insert lists (car entry) (ps-todo-list (car entry)))))) found)
  (hash "matches" (map (lambda (entry)
        (define root (car entry))
        (define item (cadr entry))
        (define projects (filter (lambda (project)
              (equal? (ps-safe (lambda () (ps-plan "todos" "NormalizeRoot" (hash-ref project "root"))) #f) root)) (project-values registry)))
        (hash "project" (if (null? projects) json-null (hash-ref (car projects) "name"))
          "id" (hash-ref item "id") "text" (hash-ref item "text") "done" (ps-get item "done" #f)
          "trail" (ps-model "todos" "Trail" (hash-ref lists root) (hash-ref item "id")))) found)))
(define (ps-query operation arguments)
  (cond
    ((starts-with? operation "agent_") (ps-archive-query operation arguments))
    ((starts-with? operation "note_") (ps-note-query operation arguments))
    ((equal? operation "todo_search") (yinz-json-string (search-todos arguments)))
    (else
      (define answer (query-view (load-view operation arguments) operation arguments))
      (yinz-json-string (if (equal? operation "todo_list") (ps-annotate-todos answer) answer)))))
