(require "./common.scm")
(provide ps-note-mutate ps-note-query ps-annotate-todos)

(define (n-projects) (ps-projects (ps-fetch (ps-limit (ps-request "project") 1000))))
(define (n-scope registry args writing)
  (cond
    ((ps-flag args "global") (hash "root" json-null "label" "global" "filter" (hash "IsNull" "root")))
    ((ps-arg args "project")
      (define root (ps-plan "todos" "Resolve" registry (ps-arg args "project")))
      (hash "root" (car root) "label" (if (json-null? (cadr root)) (car root) (cadr root)) "filter" (ps-eq "root" (car root))))
    (writing (error "project is required for a note, or global: true for one tied to no project; call project_list"))
    (else (hash "root" json-null "label" "all" "filter" json-null))))
(define (n-scoped request scope)
  (if (json-null? (hash-ref scope "filter")) request (ps-filter request (hash-ref scope "filter"))))
(define (n-strings args key)
  (define raw (ps-get args key json-null))
  (cond ((json-null? raw) json-null) ((string? raw) (list raw))
    ((and (list? raw) (foldl (lambda (value valid) (and valid (string? value))) #t raw)) raw)
    (else (error (string-append key " must be a list of strings")))))
(define (n-ids args key)
  (define raw (ps-get args key json-null))
  (cond ((json-null? raw) '())
    ((ps-id (hash "id" raw) "id") (list raw))
    ((and (list? raw) (foldl (lambda (value valid) (and valid (ps-id (hash "id" value) "id"))) #t raw)) raw)
    (else (error (string-append key " must be a list of todo item ids")))))
(define (n-id args)
  (define id (ps-id args "id"))
  (unless id (error "id is required")) id)
(define (n-side entity key ids)
  (apply append (map (lambda (chunk) (ps-rows (ps-fetch-all (ps-filter (ps-request entity) (ps-in key chunk))))) (ps-chunks ids))))
(define (n-attach notes)
  (if (null? notes) notes
    (let* ((ids (map (lambda (note) (hash-ref note "id")) notes))
        (tags (n-side "note_tag" "note_id" ids)) (links (n-side "note_link" "note_id" ids)))
      (map (lambda (note)
          (define (own row) (= (hash-ref row "note_id") (hash-ref note "id")))
          (hash-insert (hash-insert note "tags" (sort (map (lambda (tag) (hash-ref tag "tag")) (filter own tags)) string<?))
            "todo_ids" (sort (map (lambda (link) (hash-ref link "todo_id")) (filter own links)) <))) notes))))
(define (n-existing id)
  (define notes (n-attach (ps-model "notes" "FromRows"
        (ps-fetch (ps-limit (ps-filter (ps-request "note") (ps-eq "id" id)) 1)))))
  (when (null? notes) (error (string-append "no note " (number->string id) "; call note_list")))
  (car notes))
(define (n-reply registry note now)
  (hash-insert (ps-model "notes" "NoteJson" note now) "project"
    (ps-model "notes" "ProjectName" registry (hash-ref note "root"))))
(define (n-require-todos ids)
  (define found '())
  (define assertions (map (lambda (chunk)
        (define predicate (ps-in "id" chunk))
        (define rows (ps-rows (ps-fetch-all (ps-filter (hash-insert (ps-request "todo") "select" '("id" "rev")) predicate))))
        (set! found (append found (map (lambda (row) (hash-ref row "id")) rows)))
        (hash "AssertRows" (hash "entity" "todo" "filter" predicate "rows"
            (map (lambda (row) (list (hash-ref row "id") (hash-ref row "rev"))) rows)))) (ps-chunks ids)))
  (for-each (lambda (id)
      (unless (member id found) (error (string-append "no todo item " (number->string id) "; call todo_list")))) ids)
  assertions)
(define (n-tag-mutation id tag)
  (ps-put "note_tag" (ps-model "notes" "TagUid" id tag) (list (list "note_id" id) (list "tag" tag))))
(define (n-link-mutation note todo)
  (ps-put "note_link" (ps-model "notes" "LinkUid" note todo) (list (list "note_id" note) (list "todo_id" todo))))
(define (ps-note-mutate operation args)
  (define registry (n-projects))
  (define now (yinz-wall-clock-ms))
  (yinz-json-string
    (cond
      ((equal? operation "note_add")
        (define title (ps-arg args "title"))
        (define body (ps-arg args "body"))
        (unless (and title body) (error "title and body are required"))
        (define scope (n-scope registry args #t))
        (define tags (n-strings args "tags"))
        (define ids (n-ids args "todo_ids"))
        (n-require-todos ids)
        (define count (ps-count (n-scoped (ps-request "note") scope)))
        (define planned (ps-plan "notes" "PlanAdd" count (hash-ref scope "root") title body
            (or (ps-arg args "author") "user") (if (json-null? tags) '() tags) ids))
        (define report (ps-apply (car planned)))
        (define id (if (null? (hash-ref report "ids")) 0 (car (hash-ref report "ids"))))
        (define draft (cadr planned))
        (define attach-error (with-handler ps-error
            (define mutations (append (n-require-todos (hash-ref draft "todo_ids"))
                (map (lambda (tag) (n-tag-mutation id tag)) (hash-ref draft "tags"))
                (map (lambda (todo) (n-link-mutation id todo)) (hash-ref draft "todo_ids"))))
            (unless (null? mutations) (ps-apply-topology mutations)) #f))
        (define reply (n-reply registry (n-existing id) now))
        (if attach-error (hash-insert reply "warning"
            (string-append "the note was written but its tags and links were not: " attach-error)) reply))
      ((equal? operation "note_edit")
        (define id (n-id args))
        (define note (n-existing id))
        (define title (ps-arg args "title"))
        (define body (ps-arg args "body"))
        (define tags (n-strings args "tags"))
        (define mutations (append
            (if (or title body) (car (ps-plan "notes" "PlanEdit" note (ps-nullable title) (ps-nullable body) (ps-revision args))) '())
            (if (json-null? tags) '() (car (ps-plan "notes" "PlanSetTags" note tags (ps-revision args) (not (or title body)))))))
        (when (null? mutations) (error "give a title, a body, tags, or some of each"))
        (with-handler (lambda (failure)
            (define message (ps-error failure))
            (unless (ps-conflict? message) (error message))
            (define latest (ps-safe (lambda () (n-existing id)) #f))
            (error (string-append "note " (number->string id)
                (if latest (string-append " was edited by somebody else and now reads " (ps-debug (hash-ref latest "title"))
                    " at rev " (number->string (hash-ref latest "rev")) "; read it again and retry with that expect_rev if the change is still wanted")
                  " was removed by somebody else"))))
          (ps-apply mutations))
        (n-reply registry (n-existing id) now))
      ((equal? operation "note_archive")
        (define id (n-id args)) (n-existing id)
        (define archived (not (ps-flag args "undo")))
        (ps-apply (ps-model "notes" "PlanArchive" id archived))
        (hash "id" id "archived" archived))
      ((equal? operation "note_delete")
        (define id (n-id args)) (define note (n-existing id))
        (ps-apply (ps-model "notes" "PlanDelete" id))
        (hash "id" id "title" (hash-ref note "title") "deleted" #t))
      ((equal? operation "note_link")
        (define note (ps-id args "note_id")) (define todo (ps-id args "todo_id"))
        (unless (and note todo) (error "note_id and todo_id are required"))
        (n-existing note)
        (define unlink (ps-flag args "unlink"))
        (if unlink (ps-apply (ps-model "notes" "PlanUnlink" note todo))
          (ps-apply-topology (append (n-require-todos (list todo)) (list (n-link-mutation note todo)))))
        (hash "note_id" note "todo_id" todo "linked" (not unlink)))
      (else (error (string-append "unknown op " operation))))))
(define (n-list scope args)
  (define ids #f)
  (define (selected entity key value)
    (sort (ps-unique (map (lambda (row) (hash-ref row "note_id"))
          (ps-rows (ps-fetch-all (ps-filter (ps-request entity) (ps-eq key value)))))) <))
  (define tag (ps-arg args "tag"))
  (when tag (set! ids (selected "note_tag" "tag" (ps-plan "notes" "NormalizeTag" tag))))
  (define todo (ps-id args "todo_id"))
  (when todo
    (define linked (selected "note_link" "todo_id" todo))
    (set! ids (if ids (filter (lambda (id) (member id linked)) ids) linked)))
  (if (and ids (null? ids)) '()
    (begin
      (define request (ps-limit (hash-insert (hash-insert (ps-request "note") "select" (ps-model "notes" "ListColumns"))
            "sort" '(("updated_at" "Desc") ("id" "Desc"))) 1000))
      (set! request (n-scoped request scope))
      (unless (ps-flag args "include_archived") (set! request (ps-filter request (ps-eq "archived" #f))))
      (define notes (if ids
          (apply append (map (lambda (chunk) (ps-model "notes" "FromRows" (ps-fetch (ps-filter request (ps-in "id" chunk))))) (ps-chunks ids)))
          (ps-model "notes" "FromRows" (ps-fetch request))))
      (when ids
        (set! notes (sort notes (lambda (a b)
              (if (= (hash-ref a "updated_at") (hash-ref b "updated_at")) (> (hash-ref a "id") (hash-ref b "id"))
                (> (hash-ref a "updated_at") (hash-ref b "updated_at"))))))
        (set! notes (take notes (min 1000 (length notes)))))
      (n-attach notes))))
(define (n-search scope query)
  (define hits (ps-fetch (n-scoped (ps-limit (hash-insert (ps-request "note") "search" query) 50) scope)))
  (when (null? (hash-ref hits "rows"))
    (set! hits (ps-fetch (n-scoped (ps-limit (hash-insert (ps-filter (ps-request "note")
                (hash "Or" (list (hash "Contains" (list "title" query)) (hash "Contains" (list "body" query)))))
              "sort" '(("updated_at" "Desc"))) 50) scope))))
  (define notes (n-attach (ps-model "notes" "FromRows" hits)))
  (hash "notes" notes "truncated" (or (hash-ref hits "truncated") (>= (length notes) 50))))
(define (ps-note-query operation args)
  (define registry (n-projects))
  (define now (yinz-wall-clock-ms))
  (yinz-json-string
    (cond
      ((equal? operation "note_get") (n-reply registry (n-existing (n-id args)) now))
      ((equal? operation "note_list")
        (define scope (n-scope registry args #f))
        (define notes (map (lambda (note) (n-reply registry note now)) (n-list scope args)))
        (hash "scope" (hash-ref scope "label") "count" (length notes) "notes" notes))
      ((equal? operation "note_search")
        (define query (ps-arg args "query")) (unless query (error "query is required"))
        (define scope (n-scope registry args #f))
        (define found (n-search scope query))
        (hash "query" query "scope" (hash-ref scope "label") "truncated" (hash-ref found "truncated")
          "matches" (map (lambda (note) (hash-remove (hash-insert (n-reply registry note now) "snippet"
                  (ps-model "notes" "Snippet" (hash-ref note "body"))) "body")) (hash-ref found "notes"))))
      (else (error (string-append "unknown op " operation))))))
(define (ps-annotate-todos listing)
  (define ids (ps-model "notes" "TodoIdsIn" listing))
  (define links (hash))
  (for-each (lambda (row)
      (define id (number->string (hash-ref row "todo_id")))
      (set! links (hash-insert links id (cons (hash-ref row "note_id") (ps-get links id '())))))
    (n-side "note_link" "todo_id" ids))
  (for-each (lambda (id) (set! links (hash-insert links id (sort (ps-unique (hash-ref links id)) <)))) (hash-keys->list links))
  (ps-model "notes" "AnnotateTodoList" listing links))
