(require "./common.scm")
(provide ps-arrange)
(define (less? a b)
  (cond ((equal? a b) #f) ((json-null? a) #t) ((json-null? b) #f)
    ((number? a) (< a b)) (else (string<? a b))))
(define (ordered? a b)
  (cond ((null? a) #f) ((equal? (car a) (car b)) (ordered? (cdr a) (cdr b))) (else (less? (car a) (car b)))))
(define (ps-arrange registry reply)
  (define groups (hash))
  (define skipped 0)
  (define position 0)
  (for-each (lambda (pane)
      (define location (ps-model "agents" "PaneCheckoutLocation" pane))
      (define repo (ps-get (hash-ref reply "repositories") location json-null))
      (define details (if (json-null? repo) (hash "is_checkout" #f) (ps-model "projects" "RepositoryDetails" repo)))
      (define registered (if (json-null? location) json-null
          (ps-model "projects" "RegisteredForCwd" (hash-ref reply "repositories") registry location)))
      (define identity json-null)
      (define name json-null)
      (define root json-null)
      (cond ((not (json-null? registered))
          (set! identity (string-append "project:" (hash-ref registered "root")))
          (set! name (hash-ref registered "name"))
          (set! root (ps-model "projects" "ConfigurationRoot" (ps-get registered "common_dir" json-null) (hash-ref registered "root"))))
        ((hash-ref details "is_checkout")
          (set! identity (ps-model "projects" "RepositoryIdentity" repo))
          (set! name (hash-ref details "checkout_name"))
          (when (json-null? (ps-get repo "host" json-null))
            (set! root (ps-model "projects" "ConfigurationRoot" (ps-get repo "common_dir" json-null) (hash-ref repo "root"))))))
      (if (or (json-null? location) (json-null? identity) (json-null? name)) (set! skipped (+ skipped 1))
        (let* ((parts (ps-model "agents" "LocationParts" location))
            (group (ps-get groups identity (hash "identity" identity "name" name "configuration_root" root "order" '())))
            (ordering (list (ps-get repo "branch" json-null) (car parts) (ps-get repo "root" (cadr parts)) position (hash-ref pane "pane_id"))))
          (when (json-null? (hash-ref group "configuration_root")) (set! group (hash-insert group "configuration_root" root)))
          (set! groups (hash-insert groups identity (hash-insert group "order" (cons ordering (hash-ref group "order")))))))
      (set! position (+ position 1))) (if (json-null? (hash-ref reply "panes")) '() (hash-ref reply "panes")))
  (list (map (lambda (key)
        (define group (hash-ref groups key))
        (hash "identity" key "name" (hash-ref group "name") "configuration_root" (hash-ref group "configuration_root")
          "pane_ids" (map (lambda (order) (list-ref order 4)) (sort (hash-ref group "order") ordered?)))) (sort (hash-keys->list groups) string<?)) skipped))
