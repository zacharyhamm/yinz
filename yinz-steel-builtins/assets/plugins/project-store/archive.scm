(require "./common.scm" "../shared/archive.scm")
(provide ps-archive-query)
(define (ps-archive-query operation args)
  (define (number key fallback) (min 4294967295 (or (ps-id args key) fallback)))
  (define limit (number "limit" (if (equal? operation "agent_history_search") 25 20)))
  (define rows (ps-fetch (ps-limit (ps-request "project") 1000)))
  (when (hash-ref rows "truncated") (error "project registry is incomplete"))
  (define registry (ps-projects rows))
  (define root json-null)
  (define project (ps-arg args "project"))
  (when project
    (unless (hash-contains? registry project) (error (string-append "unknown project " project "; use project-list")))
    (define host (ps-arg args "local_host_id"))
    (unless host (error "project history requires the current host identity"))
    (set! root (hash "root" (hash-ref (hash-ref registry project) "root") "host_id" host)))
  (define since (ps-get args "since_ms" json-null))
  (define filter (hash "yinz_session_name" (ps-nullable (ps-arg args "run_session"))
      "host_id" (ps-nullable (ps-arg args "host_id")) "root" root "kind" (ps-nullable (ps-arg args "kind"))
      "since_ms" (if (and (integer? since) (exact? since) (<= -9223372036854775808 since) (<= since 9223372036854775807)) since json-null)
      "active" (if (boolean? (ps-get args "active" json-null)) (hash-ref args "active") json-null)))
  (define now (yinz-wall-clock-ms))
  (define (header-reply header) (ps-model "archive" "HeaderReply" header registry now))
  (define scope (string-append (if (ps-arg args "run_session") (string-append "session " (ps-arg args "run_session")) "all sessions")
      (if (ps-arg args "host_id") (string-append " · host " (ps-arg args "host_id")) "")
      (if project (string-append " · " project) "")))
  (yinz-json-string
    (cond ((equal? operation "agent_runs")
        (define offset (number "offset" 0))
        (define page (archive-list-runs filter limit offset))
        (define runs (map header-reply (hash-ref page "headers")))
        (hash "runs" runs "scope" scope "count" (length runs) "offset" offset "more" (hash-ref page "more")
          "next_offset" (if (hash-ref page "more") (min 4294967295 (+ offset (hash-ref page "scanned"))) json-null)))
      ((member operation '("agent_run" "agent_predecessors"))
        (define id (ps-arg args "run_id"))
        (unless id (error "run_id is required"))
        (define header (archive-run-header id))
        (when (json-null? header) (error (string-append "no such run " id)))
        (if (equal? operation "agent_predecessors")
          (let ((chain (archive-predecessors header)))
            (hash "anchor" header "runs" (hash-ref chain "headers") "diagnostic" (hash-ref chain "diagnostic")))
          (let* ((from (or (ps-id args "from_revision") (and (ps-id args "revision") (max 1 (- (ps-id args "revision") 2)))))
              (page (archive-entry-page id (ps-nullable from) limit))
              (entries (map (lambda (entry) (ps-model "archive" "EntryReply" entry now)) (hash-ref page "entries"))))
            (foldl (lambda (pair reply) (hash-insert reply (car pair) (cadr pair))) (header-reply header)
              (list (list "shown" (length entries)) (list "entries" entries) (list "entry_count" (hash-ref page "total"))
                (list "earlier" (hash-ref page "earlier")) (list "next_revision" (hash-ref page "next_revision"))
                (list "more" (not (json-null? (hash-ref page "next_revision")))))))))
      ((equal? operation "agent_history_search")
        (define regex (ps-get args "regex" #f))
        (unless (boolean? regex) (error "regex must be a boolean"))
        (define query (ps-get args "query" #f))
        (unless (string? query) (error "query is required"))
        (define query (if regex query (trim query)))
        (when (equal? query "") (error "query is required"))
        (define found (archive-search query filter (ps-nullable (ps-arg args "run_id")) regex limit))
        (define hits (map (lambda (hit)
              (define run (ps-get (hash-ref found "runs") (hash-ref hit "run_id") (hash)))
              (define created (hash-ref hit "created_at_ms"))
              (hash "run_id" (hash-ref hit "run_id") "revision" (hash-ref hit "revision") "kind" (ps-model "archive" "KindLabel" (hash-ref hit "kind"))
                "created_at_ms" created "age" (if (json-null? created) json-null (ps-model "archive" "ShortAge" now created))
                "snippet" (hash-ref hit "snippet") "run_title" (ps-get run "title" json-null) "agent" (ps-get run "kind" json-null))) (hash-ref found "hits")))
        (hash "query" query "scope" scope "count" (length hits) "matches" hits "truncated" (hash-ref found "truncated")))
      (else (error (string-append "unknown archive operation " operation))))))
