(require "./common.scm")
(provide ps-import-legacy)
(define (marker host what) (yinz-agent-model "store" "ImportMarkerMutation" (hash "host_id" host "what" what)))
(define (imported? host what)
  (ps-safe (lambda ()
      (define rows (ps-rows (ps-fetch (ps-filter (ps-request "import_marker")
              (hash "And" (list (hash "Or" (list (ps-eq "host_id" host) (ps-eq "host_id" ""))) (ps-eq "what" what)))))))
      (if (null? rows) #f
        (begin
          (unless (or (equal? host "") (not (null? (filter (lambda (row) (equal? (hash-ref row "host_id") host)) rows))))
            (ps-safe (lambda () (ps-apply (list (marker host what)))) #f)) #t))) #t))
(define (legacy-bytes path)
  (ps-safe (lambda ()
      (let loop ((offset 0) (chunks '()))
        (define bytes (yinz-command (hash "FsRead" (hash "path" path "max_bytes" 4194304 "offset" offset))))
        (if (< (bytes-length bytes) 4194304) (apply bytes-append (reverse (cons bytes chunks)))
          (loop (+ offset (bytes-length bytes)) (cons bytes chunks))))) (bytes)))
(define (ps-import-legacy host)
  (unless (imported? host "projects")
    (define registry (ps-model "projects" "ParseLegacy" (legacy-bytes "/cache/projects.json")))
    (ps-safe (lambda () (ps-apply (append (map (lambda (name) (ps-model "projects" "ToMutation" (hash-ref registry name)))
              (sort (hash-keys->list registry) string<?)) (list (marker host "projects"))))) #f))
  (define lists (ps-model "todos" "ParseLegacy" (ps-safe (lambda () (bytes->string/utf8 (legacy-bytes "/cache/todos.json"))) "")))
  (with-handler (lambda (failure) (yinz-log (string-append "project-store: legacy todo import incomplete: " (ps-error failure))))
    (unless (imported? host "todos")
      (for-each (lambda (root)
          (let loop ((levels (ps-model "todos" "LevelsForImport" (hash-ref lists root))) (depth 0))
            (unless (null? levels)
              (define checkpoint (string-append "todos:" (yinz-json-string (list root depth))))
              (define completed (ps-fetch (ps-filter (ps-request "import_marker") (hash "And" (list (ps-eq "host_id" host) (ps-eq "what" checkpoint))))))
              (when (null? (hash-ref completed "rows"))
                (define rows (ps-fetch-all (ps-filter (ps-request "todo") (ps-eq "root" root))))
                (define by-uid (foldl (lambda (row ids) (hash-insert ids (hash-ref row "uid") (hash-ref row "id"))) (hash) (ps-rows rows)))
                (define parents (foldl (lambda (pending parents)
                      (define old (hash-ref pending "old_parent"))
                      (if (json-null? old) parents
                        (let ((uid (ps-model "todos" "ImportUid" host root old)))
                          (unless (hash-contains? by-uid uid) (error "the imported todo parent is missing or moved; import remains incomplete"))
                          (hash-insert parents (number->string old) (hash-ref by-uid uid))))) (hash) (car levels)))
                (define current (ps-get (ps-model "todos" "FromRows" rows) root (hash "items" '() "next_id" 0)))
                (define mutations (ps-plan "todos" "ImportMutations" current root (car levels) parents host))
                (define completion (marker host checkpoint))
                (ps-apply (append mutations (list (hash "Put" (hash-insert (hash-ref completion "Put") "expect_rev" 0))))))
              (loop (cdr levels) (+ depth 1))))) (sort (hash-keys->list lists) string<?))
      (ps-apply (list (marker host "todos"))))))
