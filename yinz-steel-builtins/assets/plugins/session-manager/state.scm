(provide sm-get sm-set! sm-reset! sm-field sm-at sm-index sm-find sm-pop sm-bytes sm-duration
  sm-search sm-layout-name sm-layouts sm-layout-filter! sm-layout-move! sm-layout-selected
  sm-apply-sessions! sm-unified! sm-unified-move! sm-unified-selected sm-tree-search!
  sm-tree-selected sm-tree-move! sm-tree-expand! sm-tree-shrink! sm-tree-reset!
  sm-dead-search! sm-dead-results sm-dead-selection sm-dead-select! sm-dead-move!
  sm-other-sessions sm-name-exists? sm-clamp sm-window sm-key? sm-char sm-call)

;; State is shared by the lifecycle and render modules; absent selections use #f.
;; Session/tab/pane rows retain native event fields, adding "panes" to each tab.
;; Search rows add name, kind, indices, score and session/tab/pane references.
(define state (hash))
(define (sm-get key) (hash-ref state key))
(define (sm-set! key value) (set! state (hash-insert state key value)))
(define (sm-field object key fallback)
  (if (and (hash? object) (hash-contains? object key)) (hash-ref object key) fallback))
(define (sm-at items index)
  (and index (>= index 0) (< index (length items)) (list-ref items index)))
(define (sm-index pred items)
  (let loop ((rest items) (i 0))
    (cond ((null? rest) #f) ((pred (car rest)) i) (else (loop (cdr rest) (+ i 1))))))
(define (sm-find pred items) (sm-at items (sm-index pred items)))
(define (sm-pop text) (if (equal? text "") "" (substring text 0 (- (string-length text) 1))))
(define (sm-bytes text) (length (bytes->list (string->bytes text))))
(define (sm-duration duration)
  (+ (sm-field duration "secs" 0) (/ (sm-field duration "nanos" 0) 1000000000)))
(define (sm-clamp index count) (and (> count 0) (min (or index 0) (- count 1))))
(define (sm-window rows count selected)
  (if (<= rows count)
    (let* ((room (max 0 (- rows 1))) (start (max 0 (- (or selected 0) (quotient room 2)))))
      (list start (min count (+ start room)))) (list 0 count)))
(define (sm-call command fallback)
  (with-handler (lambda (error) fallback) (yinz-command command)))
(define (sm-key? key bare modifiers)
  (and (equal? (sm-field key "bare_key" #f) bare)
    (equal? (sm-field key "key_modifiers" '()) modifiers)))
(define (sm-char key) (sm-field (sm-field key "bare_key" #f) "Char" #f))
(define (sm-reset!)
  (set! state (hash
      "screen" "single" "previous-screen" #f "welcome" #f "multi" #f
      "visible" #t "timer" #f "name" #f "max-name-bytes" 107 "saved-time" 'json-null
      "sessions" '() "dead" '() "layouts" '() "colors" #f "error" #f "rename" #f
      "kill-warning" #f "request-ids" '()
      "search" "" "unified" '() "selected" #f "single-mode" "search" "folder" #f
      "layout-search" "" "layout-results" '() "layout-selected" 0
      "new-name" "" "new-mode" "name" "new-folder" #f
      "new-layout-search" "" "new-layout-results" '() "new-layout-selected" 0
      "tree-search" "" "tree-results" '() "tree-search-selected" #f
      "session-selected" #f "tab-selected" #f "pane-selected" #f
      "dead-search" "" "dead-results" '() "dead-selected" #f "dead-search-selected" #f
      "dead-warning" #f "notifications" '() "notification-selected" #f
      "notification-scroll" #f "notification-page-size" 0)))
(sm-reset!)

(define (sm-search rows query)
  (if (equal? query "")
    (map (lambda (row) (hash-insert (hash-insert row "score" 0) "indices" '())) rows)
    (let ((entries (list->vector rows)))
      (map (lambda (match)
          (hash-insert (hash-insert (vector-ref entries (hash-ref match "index"))
              "score" (hash-ref match "score")) "indices" (hash-ref match "indices")))
        (yinz-ui-fuzzy-filter (map (lambda (row) (hash-ref row "name")) rows) query)))))
(define (sm-layout-name layout)
  (cond ((hash-contains? layout "BuiltIn") (hash-ref layout "BuiltIn"))
    ((hash-contains? layout "File") (car (hash-ref layout "File")))
    (else (sm-field layout "Stringified" ""))))
(define (sm-layouts prefix)
  (if (equal? (sm-get (string-append prefix "-search")) "")
    (map (lambda (layout) (hash "name" (sm-layout-name layout) "layout" layout "indices" '() "score" 0)) (sm-get "layouts"))
    (sm-get (string-append prefix "-results"))))
(define (sm-layout-filter! prefix)
  (sm-set! (string-append prefix "-results")
    (sm-search (map (lambda (layout) (hash "name" (sm-layout-name layout) "layout" layout)) (sm-get "layouts"))
      (sm-get (string-append prefix "-search"))))
  (sm-set! (string-append prefix "-selected") 0))
(define (sm-layout-move! prefix direction)
  (define key (string-append prefix "-selected"))
  (define last (max 0 (- (length (sm-layouts prefix)) 1)))
  (define old (sm-get key))
  (sm-set! key (if (> direction 0) (if (< old last) (+ old 1) 0) (if (> old 0) (- old 1) last))))
(define (sm-layout-selected prefix)
  (sm-field (sm-at (sm-layouts prefix) (sm-get (string-append prefix "-selected"))) "layout" #f))

(define (sm-normalize-session session)
  (define manifest (sm-field (sm-field session "panes" (hash)) "panes" (hash)))
  (hash-insert session "tabs"
    (map (lambda (tab)
        (hash-insert tab "panes"
          (filter (lambda (pane) (and (sm-field pane "is_selectable" #f) (not (sm-field pane "is_suppressed" #f))))
            (sm-field manifest (number->string (hash-ref tab "position")) '()))))
      (sm-field session "tabs" '()))))
(define (sm-apply-sessions! sessions dead)
  (define current (sm-find (lambda (session) (sm-field session "is_current_session" #f)) sessions))
  (when current
    (sm-set! "name" (hash-ref current "name"))
    (define layouts (sm-field current "available_layouts" '()))
    (when (not (= (length layouts) (length (sm-get "layouts")))) (sm-set! "new-layout-selected" 0))
    (sm-set! "layouts" layouts))
  (sm-set! "sessions"
    (sort (map sm-normalize-session
        (filter (lambda (session) (not (and (sm-get "welcome") (sm-field session "is_current_session" #f)))) sessions))
      (lambda (a b)
        (cond ((sm-field a "is_current_session" #f) #t)
          ((sm-field b "is_current_session" #f) #f)
          (else (string<? (hash-ref a "name") (hash-ref b "name")))))))
  (sm-set! "dead" (sort (map (lambda (pair) (hash "name" (car pair) "duration" (sm-duration (cadr pair)))) dead)
      (lambda (a b) (if (= (hash-ref a "duration") (hash-ref b "duration"))
          (string<? (hash-ref a "name") (hash-ref b "name")) (< (hash-ref a "duration") (hash-ref b "duration"))))))
  (unless (equal? (sm-get "dead-search") "") (sm-dead-search!))
  (unless (sm-get "multi")
    (sm-unified!)
    (define selection (sm-get "layout-selected"))
    (sm-layout-filter! "layout")
    (sm-set! "layout-selected" (min selection (max 0 (- (length (sm-layouts "layout")) 1))))))
(define (sm-unified-selected) (sm-at (sm-get "unified") (sm-get "selected")))
(define (sm-unified!)
  (define selected-name (sm-field (sm-unified-selected) "name" #f))
  (define rows
    (append (map (lambda (session) (hash "name" (hash-ref session "name") "kind" "live"
            "session" session "current" (sm-field session "is_current_session" #f)
            "duration" (sm-duration (sm-field session "creation_time" (hash))))) (sm-get "sessions"))
      (map (lambda (dead) (hash-insert (hash-insert dead "kind" "dead") "current" #f)) (sm-get "dead"))))
  (define (before a b)
    (cond ((not (= (hash-ref a "score") (hash-ref b "score"))) (> (hash-ref a "score") (hash-ref b "score")))
      ((not (equal? (hash-ref a "kind") (hash-ref b "kind"))) (equal? (hash-ref a "kind") "live"))
      (else (< (hash-ref a "duration") (hash-ref b "duration")))))
  (sm-set! "unified" (sort (sm-search rows (sm-get "search")) before))
  (sm-set! "selected" (and selected-name (sm-index (lambda (row) (equal? selected-name (hash-ref row "name"))) (sm-get "unified")))))
(define (sm-unified-move! direction)
  (define rows (sm-get "unified"))
  (define count (length rows))
  (when (> count 0)
    (define old (or (sm-get "selected") (if (> direction 0) (- count 1) 0)))
    (sm-set! "selected"
      (let loop ((offset 1))
        (and (<= offset count)
          (let ((index (modulo (+ old (* direction offset)) count)))
            (if (hash-ref (list-ref rows index) "current") (loop (+ offset 1)) index)))))))
(define (sm-other-sessions)
  (map (lambda (session) (hash-ref session "name"))
    (filter (lambda (session) (not (sm-field session "is_current_session" #f))) (sm-get "sessions"))))
(define (sm-name-exists? name key)
  (and (sm-find (lambda (session) (equal? name (hash-ref session "name"))) (sm-get key)) #t))

(define (sm-tree-row session tab pane)
  (hash "name" (if pane (hash-ref pane "title") (if tab (hash-ref tab "name") (hash-ref session "name")))
    "kind" (if pane "pane" (if tab "tab" "session"))
    "session" session "tab" tab "pane" pane))
(define (sm-tree-search!)
  (sm-set! "tree-results"
    (sm-search (apply append (map (lambda (session)
            (cons (sm-tree-row session #f #f)
              (apply append (map (lambda (tab)
                    (cons (sm-tree-row session tab #f)
                      (map (lambda (pane) (sm-tree-row session tab pane)) (hash-ref tab "panes")))) (hash-ref session "tabs"))))) (sm-get "sessions")))
      (sm-get "tree-search")))
  (sm-set! "tree-search-selected" 0))
(define (sm-tree-selected)
  (if (not (equal? (sm-get "tree-search") "")) (sm-at (sm-get "tree-results") (sm-get "tree-search-selected"))
    (let* ((session (sm-at (sm-get "sessions") (sm-get "session-selected")))
        (tab (and session (sm-at (hash-ref session "tabs") (sm-get "tab-selected"))))
        (pane (and tab (sm-at (hash-ref tab "panes") (sm-get "pane-selected")))))
      (and session (sm-tree-row session tab pane)))))
(define (sm-tree-reset!)
  (sm-set! "session-selected" #f) (sm-set! "tab-selected" #f) (sm-set! "pane-selected" #f))
(define (sm-tree-move! direction)
  (cond ((not (equal? (sm-get "tree-search") ""))
      (define old (sm-get "tree-search-selected"))
      (sm-set! "tree-search-selected" (if old (max 0 (+ old direction)) (and (not (null? (sm-get "tree-results"))) 0))))
    (else
      (define row (sm-tree-selected))
      (define key (cond ((sm-get "pane-selected") "pane-selected") ((sm-get "tab-selected") "tab-selected") (else "session-selected")))
      (define count (cond ((equal? key "pane-selected") (length (sm-field (sm-field row "tab" #f) "panes" '())))
          ((equal? key "tab-selected") (length (sm-field (sm-field row "session" #f) "tabs" '())))
          (else (length (sm-get "sessions")))))
      (define old (sm-get key))
      (sm-set! key
        (if (equal? key "session-selected")
          (if old (let ((next (+ old direction))) (and (>= next 0) (< next count) next))
            (and (> count 0) (if (> direction 0) 0 (- count 1))))
          (if (> count 0) (modulo (+ (or old 0) direction) count) 0))))))
(define (sm-tree-expand!)
  (define session (sm-at (sm-get "sessions") (sm-get "session-selected")))
  (when session
    (define tab (sm-at (hash-ref session "tabs") (sm-get "tab-selected")))
    (cond ((not (sm-get "tab-selected")) (unless (null? (hash-ref session "tabs")) (sm-set! "tab-selected" 0)))
      ((and (not (sm-get "pane-selected")) tab (not (null? (hash-ref tab "panes")))) (sm-set! "pane-selected" 0)))))
(define (sm-tree-shrink!)
  (cond ((sm-get "pane-selected") (sm-set! "pane-selected" #f))
    ((sm-get "tab-selected") (sm-set! "tab-selected" #f))
    (else (sm-set! "session-selected" #f))))
(define (sm-dead-search!)
  (sm-set! "dead-results" (sm-search (sm-get "dead") (sm-get "dead-search")))
  (define old (sm-get "dead-search-selected"))
  (sm-set! "dead-search-selected" (if old (sm-clamp old (length (sm-get "dead-results"))) 0)))
(define (sm-dead-results) (if (equal? (sm-get "dead-search") "") (sm-get "dead") (sm-get "dead-results")))
(define (sm-dead-selection) (sm-get (if (equal? (sm-get "dead-search") "") "dead-selected" "dead-search-selected")))
(define (sm-dead-select! value) (sm-set! (if (equal? (sm-get "dead-search") "") "dead-selected" "dead-search-selected") value))
(define (sm-dead-move! direction)
  (define old (sm-dead-selection))
  (define count (length (sm-dead-results)))
  (sm-dead-select! (if old (if (> count 0) (modulo (+ old direction) count) 0)
      (if (> direction 0) 0 (max 0 (- count 1))))))
