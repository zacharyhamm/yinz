(require "./state.scm")
(require "./style.scm")
(provide sm-unified-render)
(define (details row short)
  (if (equal? (hash-ref row "kind") "live")
    (let* ((session (hash-ref row "session")) (tabs (hash-ref session "tabs"))
        (tab (number->string (length tabs)))
        (pane (number->string (foldl (lambda (tab total) (+ total (length (hash-ref tab "panes")))) 0 tabs)))
        (clients (sm-field session "connected_clients" 0)) (client (number->string clients))
        (p-offset (+ (string-length tab) (if short 3 7)))
        (c-offset (+ p-offset (string-length pane) (if short 3 8)))
        (text (if short (string-append tab "t, " pane "p, " client "c")
            (string-append tab " tabs, " pane " panes, " client (if (= clients 1) " client" " clients")))))
      (sm-text text (list (sm-range 1 0 (string-length tab))
          (sm-range 2 p-offset (+ p-offset (string-length pane))) (sm-range 2 c-offset (+ c-offset (string-length client)))) #f))
    (let* ((time (sm-time-text (hash-ref row "duration") "<1m"))
        (prefix (if short "" "Created ")))
      (sm-text (string-append prefix time " ago") (list (sm-range 2 (string-length prefix) (+ (string-length prefix) (string-length time)))) #f))))
(define (hidden-summary rows short)
  (define active (length (filter (lambda (row) (equal? (hash-ref row "kind") "live")) rows)))
  (define exited (- (length rows) active))
  (define a (string-append "+" (number->string active)))
  (define b (string-append "+" (number->string exited)))
  (define first (string-append "[" a (if short "" " Active") "] ["))
  (sm-text (string-append first b (if short "" " Exited") "]")
    (list (sm-range 2 1 (+ 1 (string-length a))) (sm-range 2 (string-length first) (+ (string-length first) (string-length b)))) #f))
(define (max-width rows extract)
  (foldl max 0 (map (lambda (row) (yinz-text-width (extract row))) rows)))
(define (sm-unified-render rows columns x y)
  (define all (sm-get "unified"))
  (define selected-row (sm-unified-selected))
  (define entries (filter (lambda (row) (not (hash-ref row "current"))) all))
  (if (null? entries) ""
    (let* ((selected (and selected-row (sm-index (lambda (row) (equal? (hash-ref row "name") (hash-ref selected-row "name"))) entries)))
        (count (length entries)) (room (max 0 (- rows 1)))
        (start (if (>= room count) 0 (min (max 0 (- (or selected 0) (quotient room 2))) (max 0 (- count room)))))
        (end (min count (+ start room))) (above (take entries start)) (below (drop entries end))
        (hidden (or (not (null? above)) (not (null? below))))
        (full-fourth (max 14 (if hidden (max (yinz-text-width (hash-ref (hidden-summary above #f) "text")) (yinz-text-width (hash-ref (hidden-summary below #f) "text"))) 1)))
        (short-fourth (max 5 (if hidden (max (yinz-text-width (hash-ref (hidden-summary above #t) "text")) (yinz-text-width (hash-ref (hidden-summary below #t) "text"))) 1)))
        (name-width (max-width entries (lambda (row) (hash-ref row "name"))))
        (full-details (max-width entries (lambda (row) (hash-ref (details row #f) "text"))))
        (short-details (max-width entries (lambda (row) (hash-ref (details row #t) "text"))))
        (full-tags (if (sm-find (lambda (row) (equal? (hash-ref row "kind") "dead")) entries) 11 8))
        (tier (cond ((<= (+ name-width full-details full-tags full-fourth 4) columns) 0)
            ((<= (+ name-width short-details full-tags full-fourth 4) columns) 1)
            ((<= (+ name-width short-details 3 full-fourth 4) columns) 2)
            ((<= (+ name-width short-details 3 short-fourth 4) columns) 3) (else 4)))
        (max-name (if (= tier 4) (max 0 (- columns (+ short-details 3 short-fourth 4))) name-width)))
      (yinz-ui-table (cons '(" " " " " " " ")
          (map (lambda (i)
              (define row (list-ref entries i))
              (define name (sm-truncate (hash-ref row "name") max-name))
              (define live (equal? (hash-ref row "kind") "live"))
              (define tag (if (>= tier 2) (if live "[A]" "[R]") (if live "[ATTACH]" "[RESURRECT]")))
              (define name-cell (sm-text name (cons (sm-range 1 0 (string-length name))
                    (map (lambda (index) (sm-range 3 index (+ index 1))) (hash-ref row "indices"))) (equal? selected i)))
              (define fourth
                (cond ((and (= i start) (not (null? above))) (hidden-summary above (>= tier 3)))
                  ((and (= i start) (not (sm-get "selected")))
                    (sm-text (if (>= tier 3) "<TAB>" "<TAB> Complete") (list (sm-range 3 0 5)) #f))
                  ((and (= i (- end 1)) (not (null? below))) (hidden-summary below (>= tier 3)))
                  (else " ")))
              (list name-cell (hash-insert (details row (>= tier 1)) "selected" (equal? selected i))
                (sm-text tag (list (sm-range 0 0 (string-length tag))) (equal? selected i)) fourth)) (range start end)))
        (hash "x" x "y" y "width" columns "height" rows)))))
