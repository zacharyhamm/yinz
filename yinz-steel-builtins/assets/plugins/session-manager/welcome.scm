(define (center-column size width) (and (<= size (max 0 (- width 1))) (+ 1 (quotient (- (max 0 (- width 1)) size) 2))))
(define (sm-banner left rows width)
  (define art (sm-find (lambda (lines) (center-column (foldl max 0 (map yinz-text-width lines)) width)) banners))
  (cond ((and (>= rows 8) art)
      (define column (+ left (center-column (foldl max 0 (map yinz-text-width art)) width)))
      (string-append "\u{1b}[" (number->string (quotient (- rows 8) 2)) "H\n"
        (apply string-append (map (lambda (line) (string-append "\u{1b}[" (number->string column) "C" line "\n")) art))))
    ((and (> rows 2) (center-column 13 width))
      (string-append (sm-pos (+ left (center-column 13 width) 1) (+ (quotient rows 2) 1)) "\u{1b}[1mHi from Yinz!\n"))
    (else "")))
(define (sm-boundaries rows columns)
  (define width (min columns 101))
  (define left (quotient (- columns width) 2))
  (define start (quotient (max 0 (- rows 15)) 2))
  (apply string-append (map (lambda (i)
        (define ends (cond ((= i start) '("┌" "┐")) ((= i (max 0 (- rows 1))) '("└" "┘")) (else '("│" "│"))))
        (string-append (sm-pos (+ left 1) (+ i 1)) (car ends) "\u{1b}[m"
          (sm-pos (+ left width 1) (+ i 1)) (cadr ends) "\u{1b}[K")) (range start rows))))
