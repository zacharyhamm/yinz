(require "./state.scm")
(require "./style.scm")
(require "./unified.scm")
(require "./tree.scm")
(require "./welcome.scm")
(require "./notifications.scm")
(provide sm-render)
(define (shortcut text) (sm-colored text "text_unselected" "emphasis_3"))
(define (prompt text) (sm-colored text "exit_code_success" "base"))
(define (entry text) (sm-colored text "text_unselected" "emphasis_0"))
(define (at text x y) (yinz-ui-text text (hash "x" x "y" y)))
(define (all-level text level) (sm-text text (list (sm-range level 0 (string-length text))) #f))
(define (ansi-line x y text) (string-append "\u{1b}[m" (sm-pos (+ x 1) (+ y 1)) text))
(define (screen-toggle x y columns)
  (define labels (sm-find (lambda (labels) (<= (+ 6 (foldl (lambda (label n) (+ n 4 (yinz-text-width label))) 0 labels)) columns))
      '(("New Session" "Attach to Session" "Resurrect Session" "Notifications") ("New" "Attach" "Resurrect" "Notif"))))
  (if (not labels) ""
    (let ((cursor (+ x 6)) (screens '("new" "attach" "dead" "notifications")))
      (string-append
        (at (hash-insert (all-level "<TAB>" 3) "opaque" #t) x y)
        (sm-pos cursor (+ y 1)) (sm-background "text_unselected") "\u{1b}[0K\n"
        (apply string-append (map (lambda (i)
              (define label (list-ref labels i))
              (define rendered (yinz-ui-ribbon (hash "text" label "selected" (equal? (sm-get "screen") (list-ref screens i))) (hash "x" cursor "y" y)))
              (set! cursor (+ cursor (yinz-text-width label) 4)) rendered) (range 4)))))))
(define (warning dead rows columns x y)
  (if (or (= rows 0) (= columns 0)) ""
    (let* ((count (number->string (length (if dead (sm-get "dead") (sm-other-sessions)))))
        (text (string-append "This will " (if dead "delete " "kill ") count (if dead " resurrectable sessions" " active sessions")))
        (center (+ y (quotient rows 2))))
      (string-append
        (at (sm-text text (list (sm-range 0 (if dead 17 15) (+ (if dead 18 16) (string-length count)))) #f)
          (+ x (quotient (max 0 (- columns (string-length text))) 2)) (+ y (max 0 (- (quotient rows 2) 1))))
        (at (sm-text "Are you sure? (y/n)" (list (sm-range 2 15 16) (sm-range 2 17 18)) #f)
          (+ x (quotient (max 0 (- columns 19)) 2)) (+ center 1))))))
(define (renaming rows columns x y)
  (if (or (= rows 0) (= columns 0)) ""
    (let ((name (sm-get "rename")))
      (string-append
        (at (sm-text (string-append "New name for current session: " name "_ (<ENTER> when done)")
            (list (sm-range 2 0 29) (sm-range 3 (+ 33 (yinz-text-width name)) (+ 40 (yinz-text-width name)))) #f) x y)
        (if (string-contains? name "/") (at (all-level "Error: session name cannot contain '/'" 3) x (+ y 2)) "")))))
(define (dead-render rows columns x y)
  (if (sm-get "dead-warning") (warning #t rows columns x y)
    (let* ((items (sm-dead-results)) (selection (sm-dead-selection)) (room (max 0 (- rows 5)))
        (window (sm-window room (length items) selection)) (start (car window)) (end (cadr window)))
      (string-append
        (at (sm-text (string-append "Search: " (sm-get "dead-search") "_") (list (sm-range 2 0 7)) #f) (max 0 (- x 1)) (+ y 2))
        (yinz-ui-table (cons '(" " " " " ")
            (map (lambda (i)
                (define row (list-ref items i)) (define name (hash-ref row "name"))
                (define selected (equal? i selection))
                (define time (sm-time-text (hash-ref row "duration") "<1m"))
                (define more (cond (selected (sm-text "<ENTER> - Resurrect Session" (list (sm-range 3 0 7)) #f))
                    ((and (= i start) (> i 0)) (all-level (string-append "+ " (number->string start) " more") 1))
                    ((and (= i (max 0 (- end 1))) (< end (length items))) (all-level (string-append "+ " (number->string (- (length items) end)) " more") 1)) (else (hash "text" " "))))
                (list (sm-text name (cons (sm-range 0 0 (string-length name))
                      (map (lambda (index) (sm-range 1 index (+ index 1))) (sm-field row "indices" '()))) selected)
                  (sm-text (string-append "Created " time " ago") (list (sm-range 2 8 (+ 9 (string-length time)))) selected)
                  (hash-insert more "selected" selected))) (range start end)))
          (hash "x" x "y" (+ y 3) "width" columns "height" room))))))
(define (layout-list single room columns x y)
  (define prefix (if single "layout" "new-layout"))
  (define query (sm-get (string-append prefix "-search")))
  (define size ((if single sm-bytes yinz-text-width) query))
  (define long (> columns (+ 73 size)))
  (define text (string-append "New session layout: " query (if long "_ (Search and select from list, <ENTER> when done)" "_ <ENTER>")))
  (define entries (sm-layouts prefix)) (define selected (sm-get (string-append prefix "-selected")))
  (define window (sm-window room (length entries) selected))
  (string-append
    (at (sm-text text (list (sm-range 2 0 (+ 20 size)) (sm-range 3 20 (+ 20 size))
          (sm-range 3 (+ (if long 52 22) size) (if long (+ 59 size) (string-length text)))) #f) x y) "\n"
    (yinz-ui-table
      (map (lambda (i)
          (define row (list-ref entries i)) (define name (hash-ref row "name"))
          (define size ((if single sm-bytes yinz-text-width) name))
          (define builtin (hash-contains? (hash-ref row "layout") "BuiltIn"))
          (define text (string-append name (if builtin " (built-in)" "")))
          (define ranges (append (list (sm-range 1 0 (if builtin size (string-length text))))
              (if builtin (list (sm-range 0 (+ size 1) (string-length text))) '())
              (map (lambda (index) (sm-range 3 index (+ index 1))) (hash-ref row "indices"))))
          (list (hash-insert (all-level (if (= i selected) "<↓↑>" "    ") 3) "selected" (= i selected))
            (sm-text text ranges (= i selected)))) (range (car window) (cadr window)))
      (hash "x" x "y" (+ y 2)))))
(define (truncate-path path remove)
  (define parts (append (if (starts-with? path "/") '("/") '())
      (filter (lambda (part) (not (equal? part ""))) (split-many path "/"))))
  (apply string-append (map (lambda (i)
        (define part (list-ref parts i))
        (define text (if (> remove 0) (begin (set! remove (max 0 (- remove (max 0 (- (yinz-text-width (substring part 1)) 1))))) (substring part 0 1)) part))
        (string-append text (if (and (not (= i 0)) (not (= i (- (length parts) 1)))) "/" ""))) (range (length parts)))))
(define (folder-prompt single columns x y)
  (define folder (sm-get (if single "folder" "new-folder")))
  (define change (shortcut "<Ctrl f>")) (define reset (shortcut "<Ctrl c>"))
  (define text
    (cond (folder
        (define length ((if single sm-bytes yinz-text-width) folder))
        (cond ((>= columns (+ 19 length (if single 30 41)))
            (string-append (prompt "New session folder:") " " (entry folder) " (" change " to change, " reset " to reset)"))
          ((and (not single) (>= columns (+ 7 length 41)))
            (string-append (prompt "Folder:") " " (entry folder) " (" change " to change, " reset " to reset)"))
          (else
            (define path (if (or single (>= columns (+ 7 length 21))) folder (truncate-path folder (max 0 (- length (max 0 (- columns 28)))))))
            (string-append (prompt "Folder:") " " (entry path) " (" change "/" reset ")"))))
      ((or single (>= columns 37)) (string-append (prompt "New session folder:") " (" change " to set)"))
      ((>= columns 25) (string-append (prompt "Folder:") " (" change " to set)"))
      (else (string-append (prompt "Folder:") " " change))))
  (ansi-line x y text))
(define (new-render single rows columns x y)
  (define name (sm-get (if single "search" "new-name")))
  (define layout (or single (equal? (sm-get "new-mode") "layout")))
  (define header
    (if layout
      (let ((name (if (equal? name "") "<RANDOM>" name)))
        (if single (string-append (prompt "New session name") ": " (entry name) " (" (shortcut "<ESC>") " to go back)")
          (if (> columns (+ 42 (yinz-text-width name)))
            (string-append (prompt "New session name:") ": " (entry name) " (" (shortcut "<ESC>") " to correct)")
            (string-append (prompt "New session name") ": " (entry name) " " (shortcut "<ESC>")))))
      (if (> columns (+ 58 (yinz-text-width name)))
        (string-append (prompt "New session name:") " " (entry name) "_ (" (shortcut "<ENTER>") " when done, blank for random)")
        (let* ((room (max 0 (- columns 35)))
            (truncated (if (> (yinz-text-width name) room)
                (string-append "..." (list->string (reverse (string->list (sm-truncate (list->string (reverse (string->list name))) (max 0 (- room 1))))))) name)))
          (string-append (prompt "New session name:") " " (entry truncated) "_ " (shortcut "<ENTER>"))))))
  (string-append (ansi-line x y header) "\n"
    (if layout (layout-list single (max 0 (- rows 8)) columns x (+ y 2)) "")
    (folder-prompt single columns x (max 0 (- (+ y rows) 3)))))
(define (controls columns x y)
  (define screen (sm-get "screen"))
  (define choices
    (cond ((equal? screen "single")
        (list (list 99 #t '("<Ctrl r>" "Rename" "<Ctrl x>" "Disconnect others" "<Del>" "Kill/Delete" "<Ctrl v>" "Notifications"))
          (list 77 #t '("<Ctrl r>" "Rename" "<Ctrl x>" "Disconnect others" "<Del>" "Kill/Delete"))
          (list 70 #t '("<Ctrl r>" "Rename" "<Ctrl x>" "Disconnect" "<Del>" "Kill/Delete"))
          (list 23 #f '("<Ctrl r>" "<Ctrl x>" "<Del>"))))
      ((equal? screen "attach")
        (list (list 91 #t '("<Ctrl r>" "Rename" "<Ctrl x>" "Disconnect others" "<Del>" "Kill" "<Ctrl d>" "Kill all"))
          (list 28 #f '("<Ctrl r>" "<Ctrl x>" "<Del>" "<Ctrl d>"))))
      ((equal? screen "dead")
        (list (list 84 #t '("<↓↑>" "Navigate" "<ENTER>" "Resurrect" "<DEL>" "Delete" "<Ctrl d>" "Delete all"))
          (list 28 #f '("<↓↑>" "<ENTER>" "<DEL>" "<Ctrl d>"))))
      ((equal? screen "notifications")
        (list (list 71 #t '("<↓↑/PgUp/PgDn>" "Navigate" "<ENTER>" "View" "<ESC>" "Back"))
          (list 24 #f '("<↓↑/PgUp/PgDn>" "<ENTER>" "<ESC>")))) (else '())))
  (define chosen (sm-find (lambda (choice) (>= columns (car choice))) choices))
  (cond ((and (equal? screen "new") (>= columns 50))
      (list (string-append "\u{1b}[m" (sm-pos (+ x 1) y) "\u{1b}[1mHelp: Fill in the form to start a new session.") 6))
    (chosen
      (define full (cadr chosen)) (define labels (list-ref chosen 2))
      (define text (if full
          (string-append "Help: " (string-join (map (lambda (i) (string-append (shortcut (list-ref labels i)) " - " (sm-bold (list-ref labels (+ i 1)))))
                (map (lambda (i) (* i 2)) (range (quotient (length labels) 2)))) ", "))
          (string-join (map shortcut labels) "/")))
      (list (string-append "\u{1b}[m" (sm-pos (+ x 1) y) text) (if full 6 0)))
    (else (list "" 0))))
(define (saved-line columns x y)
  (define saved (sm-get "saved-time"))
  (define time (if (json-null? saved) "(not saved)"
      (let ((text (sm-time-text (/ saved 1000) "")))
        (string-append "(saved " (if (equal? text "") "just now" (string-append text " ago")) ")"))))
  (define text (sm-find (lambda (text) (<= (yinz-text-width text) columns))
      (map (lambda (action) (string-append "<Ctrl a>" action " " time))
        '(" - Save current session for resurrection" " - Save session" " - Save" ""))))
  (if text (at (sm-text text (list (sm-range 3 0 8) (sm-range 2 (- (string-length text) (string-length time)) (string-length text))) #f) x y) ""))
(define (sm-render rows columns)
  (define welcome (sm-get "welcome"))
  (define width (if welcome (min columns 101) columns))
  (define left (quotient (- columns width) 2))
  (define x (if welcome (+ left 2) 0))
  (define y (if welcome (quotient (max 0 (- rows 15)) 2) 0))
  (define height (- rows y))
  (define screen (sm-get "screen"))
  (define content-width (min width 90))
  (define centered (+ x (quotient (- width content-width) 2)))
  (define content
    (cond ((equal? screen "single")
        (cond ((equal? (sm-get "single-mode") "layout") (new-render #t height width x y))
          ((sm-get "rename") (renaming height width x y))
          ((sm-get "kill-warning") (warning #f height width x y))
          (else
            (define room (max 0 (- height 5)))
            (define offset (+ y (quotient (max 0 (- (max 0 (- height 3)) (+ 2 room))) 2)))
            (define search (sm-get "search")) (define selected (sm-unified-selected))
            (define action (and (not (equal? search ""))
                (cond (selected (if (equal? (hash-ref selected "kind") "live") "Attach" "Resurrect"))
                  ((sm-name-exists? search "sessions") "Attach") ((sm-name-exists? search "dead") "Resurrect") (else "Create new"))))
            (string-append "\u{1b}[m" (sm-pos (+ centered 1) (+ offset 2)) "\u{1b}[0m"
              (prompt "Session:") " " (sm-bold (string-append search "_"))
              (if action (string-append " " (shortcut "<ENTER>") " - " action) "") "\n\n"
              (sm-unified-render room content-width centered (+ offset 2))))))
      ((equal? screen "new") (new-render #f (max 0 (- height 2)) width x (+ y 2)))
      ((equal? screen "dead") (dead-render height width x y))
      ((equal? screen "notifications") (sm-notifications-render height width x y))
      (else (cond ((sm-get "rename") (renaming height width x (+ y 2)))
          ((sm-get "kill-warning") (warning #f height width x y))
          (else (string-append (sm-pos x (+ y 3)) "\u{1b}[0m" (entry "Search:") " " (sm-bold (string-append (sm-get "tree-search") "_")) "\n\n"
              (let ((lines (sm-tree-render (max 0 (- height 7)) (max 0 (- width 7)))))
                (apply string-append (map (lambda (i) (string-append (sm-pos x (+ y i 5)) (list-ref lines i))) (range (length lines)))))))))))
  (define footer
    (cond ((sm-get "error") (yinz-ui-text (all-level (string-append "Error: " (sm-get "error")) 3) (hash "x" x "y" (+ y height) "width" width)))
      ((and (member screen '("single" "attach")) (not welcome))
        (define help-x (if (equal? screen "single") centered x))
        (define help (controls width help-x (max 0 (- rows 1))))
        (string-append (car help) (saved-line (max 0 (- width (cadr help))) (+ help-x (cadr help)) rows)))
      (else (car (controls width x rows)))))
  (string-append (if welcome (sm-banner left y width) "")
    (if (equal? screen "single") "" (screen-toggle x y (max 0 (- width 2)))) content footer
    (if welcome (sm-boundaries rows columns) "")))
