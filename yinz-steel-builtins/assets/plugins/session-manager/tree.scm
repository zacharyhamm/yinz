(require "./state.scm")
(require "./style.scm")
(provide sm-tree-render)
(define (colored text role) (sm-colored text "text_unselected" role))
(define (option text width) (list text width))
(define (telescope choices) (hash "choices" choices))
(define (name-span name role) (hash "text" name "role" role))
(define (spans kind row)
  (cond ((equal? kind "session")
      (define tabs (number->string (length (hash-ref row "tabs"))))
      (define panes (number->string (foldl (lambda (tab n) (+ n (length (hash-ref tab "panes")))) 0 (hash-ref row "tabs"))))
      (define users (number->string (sm-field row "connected_clients" 0)))
      (define tab-color (colored tabs "emphasis_1")) (define pane-color (colored panes "emphasis_2"))
      (define user-color (colored users "emphasis_2"))
      (append (list (telescope (list (option " > " 3))) (name-span (hash-ref row "name") "emphasis_0")
          (telescope (list (option (string-append " (" tab-color " tabs, " pane-color " panes)") (+ 16 (string-length tabs) (string-length panes)))
              (option (string-append " (" tab-color ", " pane-color ")") (+ 7 (string-length tabs) (string-length panes)))))
          (telescope (list (option (string-append " [" user-color " connected users]") (+ 19 (string-length users)))
              (option (string-append " [" user-color "]") (+ 3 (string-length users))))))
        (if (sm-field row "is_current_session" #f)
          (list (telescope (map (lambda (text) (option (colored text "emphasis_0") (string-length text))) '(" <CURRENT SESSION>" " <CURRENT>" " <C>")))) '())))
    ((equal? kind "tab")
      (define panes (number->string (length (hash-ref row "panes"))))
      (define color (colored panes "emphasis_2"))
      (list (telescope (list (option "  - " 4))) (name-span (hash-ref row "name") "emphasis_1")
        (telescope (list (option (string-append " (" color " panes)") (+ 9 (string-length panes)))
            (option (string-append " (" color ")") (+ 3 (string-length panes)))))))
    (else
      (define code (sm-field row "exit_status" 'json-null))
      (append (list (telescope (list (option "    > " 6))) (name-span (hash-ref row "title") #f))
        (if (json-null? code) '()
          (let* ((text (number->string code))
              (color (if (= code 0) (colored text "emphasis_0") (sm-colored text "exit_code_error" "base")))
              ;; The original counts the styled escape bytes for exit-code telescopes.
              (size (yinz-text-width color)))
            (list (telescope (list (option (string-append " (EXIT CODE: " color ")") (+ 14 size))
                  (option (string-append " (" color ")") (+ 3 size)))))))))))
(define (line kind row columns indices selected search arrows more)
  (define remaining columns)
  (define text (apply string-append (map (lambda (span)
          (if (hash-contains? span "choices")
            (let ((chosen (sm-find (lambda (choice) (< (cadr choice) remaining)) (hash-ref span "choices"))))
              (if chosen (begin (set! remaining (- remaining (cadr chosen))) (car chosen)) ""))
            (let* ((name (sm-truncate (hash-ref span "text") remaining)) (role (hash-ref span "role")))
              (set! remaining (max 0 (- remaining (yinz-text-width name))))
              (if (not indices) (if role (colored name role) (sm-bold name))
                (apply string-append (map (lambda (i)
                      (define text (string (string-ref name i)))
                      (if (member i indices) (colored text "emphasis_3") (if role (colored text role) (sm-bold text)))) (range (string-length name)))))))) (spans kind row))))
  (if selected
    (string-append (sm-background "list_selected") "\u{1b}[K" (sm-background "list_selected")
      (if arrows (colored (if search " <↓↑> " "<←↓↑→>") "emphasis_3") "      ") text)
    (string-append "\u{1b}[49m      " text
      (if (> more 0) (sm-colored (string-append " [+" (number->string more) "]") "exit_code_error" "base") ""))))
(define (section kind items selected deeper remove columns)
  (define count (length items))
  (define room (if (> remove count) 1 (max 0 (- count remove))))
  (define remaining (if (> remove count) (+ (- remove count) 1) 0))
  (define anchor (or selected 0))
  (define initial (max 0 (- anchor (quotient room 2))))
  (define end (min count (+ initial room)))
  (define start (max 0 (- initial (max 0 (- (+ initial room) count)))))
  (define above start)
  (define below (max 0 (- count end)))
  (define before '())
  (when (<= start anchor)
    (for-each (lambda (i)
        (when (< i count)
          (set! before (append before (list (line kind (list-ref items i) columns #f #f #f #f above))))
          (set! above 0))) (range start anchor)))
  (when (< anchor count)
    (define is-selected (and selected (not deeper)))
    (set! before (append before (list (line kind (list-ref items anchor) columns #f is-selected #f #t
            (if is-selected (+ above (if (>= (+ anchor 1) end) below 0)) 0))))))
  (define after '())
  (when (<= (+ anchor 1) end)
    (for-each (lambda (i)
        (set! after (cons (line kind (list-ref items i) columns #f #f #f #f below) after)) (set! below 0))
      (reverse (range (+ anchor 1) end))))
  (list before after remaining))
(define (sm-tree-render rows columns)
  (if (not (equal? (sm-get "tree-search") ""))
    (let ((results (sm-get "tree-results")) (selected (sm-get "tree-search-selected")) (used 0) (lines '()) (stopped #f))
      (define (height row) (if (hash-ref row "pane") 3 (if (hash-ref row "tab") 2 1)))
      (when (and selected (or (>= selected (length results)) (> (foldl (lambda (row count) (+ count (height row))) 0 (take results (min (length results) (+ selected 1)))) rows)))
        (sm-set! "tree-search-selected" #f) (set! selected #f))
      (for-each (lambda (i)
          (define row (list-ref results i))
          (define size (height row))
          (when (> (+ used size) rows) (set! stopped #t))
          (when (and (not stopped) (<= (+ used size) rows))
            (define indices (hash-ref row "indices"))
            (define tab (hash-ref row "tab")) (define pane (hash-ref row "pane"))
            (set! lines (append lines
                (list (line "session" (hash-ref row "session") columns (and (not tab) indices) (equal? selected i) #t #t 0))
                (if tab (list (line "tab" tab columns (and (not pane) indices) (equal? selected i) #t #f 0)) '())
                (if pane (list (line "pane" pane columns indices (equal? selected i) #t #f 0)) '())))
            (set! used (+ used size))))
        (range (length results))) lines)
    (let* ((sessions (sm-get "sessions")) (s (sm-get "session-selected")) (t (sm-get "tab-selected")) (p (sm-get "pane-selected"))
        (session (sm-at sessions s)) (tabs (if (and t session) (hash-ref session "tabs") '()))
        (tab (sm-at tabs t)) (panes (if (and p tab) (hash-ref tab "panes") '()))
        (remove (max 0 (- (+ (length sessions) (length tabs) (length panes)) rows)))
        (a (section "session" sessions s t remove columns))
        (b (if (and t session) (section "tab" tabs t p (list-ref a 2) columns) (list '() '() (list-ref a 2))))
        (c (if (and p tab) (section "pane" panes p #f (list-ref b 2) columns) (list '() '() 0))))
      (append (car a) (car b) (car c) (cadr c) (cadr b) (cadr a)))))
