(require "./state.scm")
(provide sm-notifications-refresh! sm-notifications-key! sm-notifications-render)
(define (sm-notifications-refresh!)
  (define rows (sm-call "ListNotifications" #f))
  (and rows
    (let* ((reversed (reverse rows))
        (id (sm-field (sm-at (sm-get "notifications") (sm-get "notification-selected")) "id" #f)))
      (and (not (equal? reversed (sm-get "notifications")))
        (begin (sm-set! "notifications" reversed)
          (sm-set! "notification-selected"
            (or (and id (sm-index (lambda (row) (equal? id (hash-ref row "id"))) reversed))
              (and (not (null? reversed)) 0))) #t)))))
(define (move! amount)
  (cond ((sm-get "notification-scroll") (sm-set! "notification-scroll" (max 0 (+ (sm-get "notification-scroll") amount))))
    ((not (null? (sm-get "notifications")))
      (sm-set! "notification-selected" (max 0 (min (- (length (sm-get "notifications")) 1) (+ (or (sm-get "notification-selected") 0) amount)))))))
(define (sm-notifications-key! key)
  (cond ((sm-key? key "Down" '()) (move! 1) #t)
    ((sm-key? key "Up" '()) (move! -1) #t)
    ((sm-key? key "PageDown" '()) (move! (max 1 (sm-get "notification-page-size"))) #t)
    ((sm-key? key "PageUp" '()) (move! (- (max 1 (sm-get "notification-page-size")))) #t)
    ((sm-key? key "Enter" '())
      (when (and (sm-get "notification-selected") (not (sm-get "notification-scroll"))) (sm-set! "notification-scroll" 0)) #t)
    (else #f)))
(define (age row)
  (define seconds (quotient (max 0 (- (yinz-wall-clock-ms) (hash-ref row "received_at_unix_ms"))) 1000))
  (cond ((< seconds 60) "just now") ((< seconds 3600) (string-append (number->string (quotient seconds 60)) "m ago"))
    ((< seconds 86400) (string-append (number->string (quotient seconds 3600)) "h ago"))
    (else (string-append (number->string (quotient seconds 86400)) "d ago"))))
(define (message row)
  (define outcome (sm-field row "outcome" 'json-null))
  (string-append (if (json-null? outcome) ""
      (string-append "[" (hash-ref (hash-ref outcome "original") "source")
        (if (hash-ref outcome "suppressed") ", suppressed" "") "] ")) (hash-ref row "message")))
(define (sanitize text newlines)
  (apply string-append (map (lambda (ch)
        (define code (char->integer ch))
        (cond ((= code 10) (if newlines "\n" " ")) ((= code 9) " ")
          ((or (< code 32) (and (>= code 127) (<= code 159))) "") (else (string ch)))) (string->list text))))
(define (wrap text width)
  (apply append (map (lambda (source)
        (let loop ((chars (string->list source)) (line "") (used 0) (lines '()))
          (if (null? chars) (reverse (cons line lines))
            (let* ((text (string (car chars))) (size (yinz-text-width text)))
              (if (and (> used 0) (> (+ used size) width)) (loop (cdr chars) text size (cons line lines))
                (loop (cdr chars) (string-append line text) (+ used size) lines)))))) (split-many text "\n"))))
(define (styled text start selected)
  (hash "text" text "selected" selected "levels" (list '() '() (range start (string-length text)))))
(define (sm-notifications-render rows columns x y)
  (define items (sm-get "notifications"))
  (define selected (sm-get "notification-selected"))
  (if (sm-get "notification-scroll")
    (let ((row (sm-at items selected)))
      (if (not row) (begin (sm-set! "notification-scroll" #f) "")
        (let* ((available (max 0 (- rows 4)))
            (lines (wrap (sanitize (message row) #t) (max columns 1)))
            (scroll (min (sm-get "notification-scroll") (max 0 (- (length lines) available)))))
          (sm-set! "notification-page-size" available) (sm-set! "notification-scroll" scroll)
          (string-append
            (yinz-ui-text (styled (string-append "Received " (age row)) 9 #f) (hash "x" x "y" (+ y 1)))
            (apply string-append (map (lambda (i)
                  (yinz-ui-text (list-ref lines (+ scroll i)) (hash "x" x "y" (+ y 3 i))))
                (range (min available (- (length lines) scroll)))))))))
    (let* ((available (max 0 (- rows 3))) (page (max 0 (- available 1))))
      (sm-set! "notification-page-size" page)
      (if (null? items) (yinz-ui-text "No notifications received in this session." (hash "x" x "y" (+ y 2)))
        (let* ((size (min (max 1 page) (length items)))
            (index (min (or selected 0) (- (length items) 1)))
            (first (min (max 0 (- index (quotient size 2))) (- (length items) size))))
          (yinz-ui-table (cons '("Received" "Notification")
              (map (lambda (i)
                  (define row (list-ref items i))
                  (list (styled (age row) 0 (equal? i selected))
                    (hash "text" (yinz-ui-truncate (sanitize (message row) #f) (max 0 (- columns 18))) "selected" (equal? i selected))))
                (range first (+ first size)))) (hash "x" x "y" (+ y 1) "width" columns "height" available)))))))
