(require "./state.scm")
(require "../bar/default-mode.scm")
(provide sm-color sm-bold sm-colored sm-pos sm-text sm-range sm-truncate sm-time-text sm-background)
(define esc (string (integer->char 27)))
(define defaults (hash-ref (hash-ref (bar-default-mode) "style") "colors"))
(define (sm-color group role) (hash-ref (hash-ref (or (sm-get "colors") defaults) group) role))
(define (color-code color)
  (if (hash-contains? color "Rgb") (string-append "2;" (string-join (map number->string (hash-ref color "Rgb")) ";"))
    (string-append "5;" (number->string (hash-ref color "EightBit")))))
(define (sm-background group) (string-append esc "[48;" (color-code (sm-color group "background")) "m"))
(define (sm-bold text) (string-append esc "[1m" text esc "[22m"))
(define (sm-colored text group role)
  (string-append esc "[38;" (color-code (sm-color group role)) ";1m" text esc "[39;22m"))
(define (sm-pos x y) (string-append esc "[" (number->string y) ";" (number->string x) "H"))
(define (sm-range level start end) (list level start end))
(define (sm-text text ranges selected)
  (hash "text" text "selected" selected "levels"
    (map (lambda (level)
        (apply append (map (lambda (r) (range (min (string-length text) (cadr r)) (min (string-length text) (list-ref r 2))))
            (filter (lambda (r) (= (car r) level)) ranges)))) (range 9))))
(define (sm-truncate text width)
  (let loop ((chars (string->list text)) (result ""))
    (if (null? chars) result
      (let ((next (string-append result (string (car chars)))))
        (if (> (yinz-text-width next) width) result (loop (cdr chars) next))))))
(define (sm-time-text seconds fallback)
  ;; Match the legacy humantime display, which discards every unit ending in s.
  (define parts '())
  (define rest (inexact->exact (floor seconds)))
  (for-each (lambda (unit)
      (define count (quotient rest (car unit)))
      (set! rest (modulo rest (car unit)))
      (when (> count 0)
        (define name (if (and (> count 1) (member (cadr unit) '("year" "month" "day")))
            (string-append (cadr unit) "s") (cadr unit)))
        (unless (ends-with? name "s") (set! parts (append parts (list (string-append (number->string count) name)))))))
    '((31557600 "year") (2630016 "month") (86400 "day") (3600 "h") (60 "m") (1 "s")))
  (if (null? parts) fallback (string-join parts " ")))
