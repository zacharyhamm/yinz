(require "./bar/default-mode.scm" "./bar/keys.scm" "./bar/style.scm")

(define hostname "")
(define mi (bar-default-mode))
(define tabs '())
(define groups '())
(define focused-group 0)
(define group-parts '())
(define group-row-visible #f)
(define hovered-group #f)
(define hovered-group-button #f)
(define new-group-range #f)
(define (tab-group tab) (let ((group (bar-get tab "group" #f))) (if (hash? group) group (hash "id" 0 "name" "Default"))))
(define (switch-to-tab number)
  (cond
    ((null? tabs) (yinz-command (hash "SwitchTabTo" number)))
    ((and (> number 0) (<= number (length tabs)))
      (yinz-command (hash "SwitchTabTo" (+ 1 (hash-ref (list-ref tabs (- number 1)) "global_position")))))))
(define (group-at col)
  (let loop ((remaining group-parts) (start 0))
    (if (null? remaining) #f
      (let ((part (car remaining)))
        (if (< col (+ start (hash-ref part "len"))) (bar-get part "tab" #f)
          (loop (cdr remaining) (+ start (hash-ref part "len"))))))))
(define (switch-group index)
  (when (and index (< index (length groups)))
    (yinz-command (hash "RunAction" (list (hash "SwitchTabGroup" (hash "id" (hash-ref (list-ref groups index) "id"))) (hash))))))
(define hide-swap-layout #f)
(define scroll #f)
(define hint #f)
(define hovered-tab #f)
(define hovered-button #f)
(define active-tab 0)
(define cached-keybinds '())
(define outstanding-hints 0)
(define parts '())
(define new-tab-range #f)
(define breadcrumb-range #f)

(define (in-range range col) (and range (>= col (car range)) (< col (cadr range))))
(define (tab-at col)
  (let loop ((remaining parts) (start 0))
    (if (null? remaining) #f
      (let ((part (car remaining)))
        (if (and (>= col start) (< col (+ start (hash-ref part "len"))))
          (let ((tab (bar-get part "tab" #f)))
            (and tab (not (= (+ tab 1) active-tab)) (<= (+ tab 1) 4294967295) (+ tab 1)))
          (loop (cdr remaining) (+ start (hash-ref part "len"))))))))
(define (tab-mouse-event event)
  (cond
    ((hash-contains? event "LeftClick")
      (define col (cadr (hash-ref event "LeftClick")))
      (cond ((and (not group-row-visible) (in-range breadcrumb-range col)) (yinz-command "FocusHostSession"))
        ((in-range new-tab-range col) (yinz-command (hash "NewTab" (hash "name" 'json-null "cwd" 'json-null))))
        (else (define tab (tab-at col)) (when tab (switch-to-tab tab)))) #f)
    ((hash-contains? event "Hover")
      (define col (cadr (hash-ref event "Hover")))
      (define button (and (not (hash-ref (hash-ref mi "capabilities") "arrow_fonts")) (in-range new-tab-range col)))
      (define tab (and (not (hash-ref (hash-ref mi "capabilities") "arrow_fonts")) (not button) (tab-at col)))
      (define changed (or (not (equal? button hovered-button)) (not (equal? tab hovered-tab))))
      (set! hovered-button button) (set! hovered-tab tab) changed)
    ((hash-contains? event "ScrollUp")
      (define next (min (+ active-tab 1) (length tabs)))
      (when (<= next 4294967295) (switch-to-tab next)) #f)
    ((hash-contains? event "ScrollDown") (switch-to-tab (max 1 (- active-tab 1))) #f)
    (else #f)))

(define (mouse-event event)
  (define kind (car (hash-keys->list event)))
  (define point (hash-ref event kind))
  (if (and group-row-visible (list? point) (not (null? point)) (= (car point) 0))
    (cond
      ((equal? kind "LeftClick")
        (cond ((in-range breadcrumb-range (cadr point)) (yinz-command "FocusHostSession"))
          ((in-range new-group-range (cadr point)) (yinz-command (hash "RunAction" (list "NewTabGroup" (hash)))))
          (else (switch-group (group-at (cadr point))))) #f)
      ((equal? kind "Hover")
        (define button (and (not (hash-ref (hash-ref mi "capabilities") "arrow_fonts")) (in-range new-group-range (cadr point))))
        (define next (and (not (hash-ref (hash-ref mi "capabilities") "arrow_fonts")) (not button) (group-at (cadr point))))
        (define changed (or (not (equal? hovered-group next)) (not (equal? hovered-group-button button)) (if (or hovered-tab hovered-button) #t #f)))
        (set! hovered-tab #f) (set! hovered-button #f)
        (set! hovered-group next) (set! hovered-group-button button) changed)
      (else #f))
    (let ((changed (tab-mouse-event event)) (old (or hovered-group hovered-group-button)))
      (set! hovered-group #f) (set! hovered-group-button #f) (or changed (if old #t #f)))))

(define (update-state event)
  (cond
    ((equal? event "InputReceived") (define changed (if hint #t #f)) (set! hint #f) changed)
    ((not (hash? event)) #f)
    ((hash-contains? event "InitialKeybinds")
      (set! cached-keybinds (hash-ref event "InitialKeybinds"))
      (unless (null? cached-keybinds) (set! mi (hash-insert mi "keybinds" cached-keybinds))) #t)
    ((hash-contains? event "ModeUpdate")
      (define mode (hash-ref event "ModeUpdate"))
      (if (null? (hash-ref mode "keybinds"))
        (unless (null? cached-keybinds) (set! mode (hash-insert mode "keybinds" cached-keybinds)))
        (set! cached-keybinds (hash-ref mode "keybinds")))
      (define changed (not (bar-equal? mi mode)))
      (set! mi mode) changed)
    ((hash-contains? event "TabUpdate")
      (define all-tabs (hash-ref event "TabUpdate"))
      (define active (filter (lambda (tab) (hash-ref tab "active")) all-tabs))
      (define group-id (if (null? active) focused-group (hash-ref (tab-group (car active)) "id")))
      (define next-groups (sort
          (foldl (lambda (tab result)
              (define group (tab-group tab))
              (if (not (null? (filter (lambda (g) (= (hash-ref g "id") (hash-ref group "id"))) result))) result (cons group result))) '() all-tabs)
          (lambda (a b) (< (hash-ref a "id") (hash-ref b "id")))))
      (define groups-changed (or (not (= focused-group group-id)) (not (bar-equal? groups next-groups))))
      (set! focused-group group-id) (set! groups next-groups)
      (define local-position -1)
      (define incoming (map (lambda (tab)
            (set! local-position (+ local-position 1))
            (hash-insert (hash-insert tab "global_position" (hash-ref tab "position")) "position" local-position))
          (filter (lambda (tab) (= (hash-ref (tab-group tab) "id") group-id)) all-tabs)))
      (define next (let loop ((remaining incoming) (index 1))
          (cond ((null? remaining) 0) ((hash-ref (car remaining) "active") index) (else (loop (cdr remaining) (+ index 1))))))
      (if (or (= next 0) (> next 4294967295)) #f
        (let ((changed (or groups-changed (not (= active-tab next)) (not (bar-equal? tabs incoming)))))
          (set! active-tab next) (set! tabs incoming) changed)))
    ((hash-contains? event "ActivePaneScroll")
      (define next (hash-ref event "ActivePaneScroll"))
      (define changed (not (bar-equal? (or scroll 'json-null) next)))
      (set! scroll (if (json-null? next) #f next)) changed)
    ((hash-contains? event "HintText")
      (define next (hash-ref event "HintText"))
      (if (null? (hash-keys->list next))
        (let ((changed (if hint #t #f))) (set! hint #f) changed)
        (begin (set! hint next) (set! outstanding-hints (+ outstanding-hints 1))
          (yinz-command (hash "SetTimeout" 5)) #t)))
    ((hash-contains? event "Timer")
      (set! outstanding-hints (max 0 (- outstanding-hints 1)))
      (if (and (= outstanding-hints 0) hint) (begin (set! hint #f) #t) #f))
    ((hash-contains? event "Mouse") (mouse-event (hash-ref event "Mouse")))
    (else #f)))
(define (update event)
  (define changed (update-state event))
  (and (not (null? tabs)) changed))
(define (load config)
  (set! hostname (bar-get (yinz-command "GetPluginIds") "hostname" ""))
  (set! hide-swap-layout (equal? (bar-get config "hide_swap_layout_indication" #f) "true"))
  (yinz-command (hash "SetSelectable" #f))
  (yinz-command (hash "Subscribe" '("TabUpdate" "ModeUpdate" "Mouse" "InitialKeybinds" "ActivePaneScroll" "HintText" "Timer" "InputReceived"))))

(define (colors) (hash-ref (hash-ref mi "style") "colors"))
(define (parts-width parts) (foldl (lambda (part n) (+ n (hash-ref part "len"))) 0 parts))
(define (ellipsize text budget)
  (cond ((<= (yinz-text-width text) budget) text) ((= budget 0) "")
    (else (let loop ((chars (string->list text)) (result "") (used 0))
        (if (null? chars) (string-append result "…")
          (let ((size (max 1 (yinz-text-width (string (car chars))))))
            (if (> (+ used size) (- budget 1)) (string-append result "…")
              (loop (cdr chars) (string-append result (string (car chars))) (+ used size)))))))))
(define (prefix cols)
  (define p (hash-ref (colors) "text_unselected"))
  (define dim (bar-dimmed? mi))
  (define (style text) (bar-paint text (if dim #f (hash-ref p "base")) (hash-ref p "background") (if dim "2" "1")))
  (define host (string-append " " (if (equal? hostname "") "Yinz" hostname) " "))
  (define result (list (bar-line (style host) (yinz-text-width host))))
  (define name (if (hash-ref (hash-ref mi "style") "hide_session_name") #f (hash-ref mi "session_name")))
  (define ancestors (if (equal? (bar-get mi "host_fullscreen" #f) #t) (hash-ref mi "session_ancestry") '()))
  (set! breadcrumb-range #f)
  (when (bar-present? name)
    (if (not (null? ancestors))
      (let ((ancestor (string-append "(" (string-join ancestors " ▸ ") " ▸ ")))
        (when (>= (max 0 (- cols (yinz-text-width host))) (+ (yinz-text-width ancestor) (yinz-text-width name) 2))
          (set! result (append result (list
                (bar-line (bar-paint ancestor (if dim #f (hash-ref p "base")) (hash-ref p "background") (if dim "2" "3")) (yinz-text-width ancestor))
                (bar-line (bar-paint name (if dim #f (hash-ref p "emphasis_0")) (hash-ref p "background") (if dim "2" "1")) (yinz-text-width name))
                (bar-line (style ") ") 2))))
          (set! breadcrumb-range (list (yinz-text-width host) (+ (yinz-text-width host) (yinz-text-width ancestor))))))
      (when (>= (max 0 (- cols (yinz-text-width host))) (+ (yinz-text-width name) 3))
        (set! result (append result (list (bar-line (style (string-append "(" name ") ")) (+ (yinz-text-width name) 3))))))))
  result)
(define (tile text fg bg flat-left)
  (define outer (hash-ref (hash-ref (colors) "text_unselected") "background"))
  (bar-line (string-append (bar-paint (bar-arrow mi) (if flat-left bg outer) bg "")
      (bar-paint text fg bg (if (bar-dimmed? mi) "3" "1"))
      (bar-paint (bar-arrow mi) bg outer ""))
    (+ (yinz-text-width text) (* 2 (yinz-text-width (bar-arrow mi))))))
(define (tab-part tab alternate budget)
  (define p (colors))
  (define r (hash-ref p (if (hash-ref tab "active") "ribbon_selected" "ribbon_unselected")))
  (define bg (hash-ref r (if (and (not (hash-ref tab "active"))
          (or (equal? hovered-tab (+ (hash-ref tab "position") 1))
            (and alternate (hash-ref (hash-ref mi "capabilities") "arrow_fonts")))) "emphasis_1" "background")))
  (define fg (hash-ref r (if (hash-ref tab "is_flashing_bell") "emphasis_3" "base")))
  (when (bar-dimmed? mi)
    (set! bg (hash-ref (hash-ref p "ribbon_unselected") "background"))
    (set! fg (hash-ref (hash-ref p "ribbon_unselected") "base")))
  (define suffix (cond ((hash-ref tab "is_fullscreen_active") " (FULLSCREEN)")
      ((hash-ref tab "is_sync_panes_active") " (SYNC)") (else "")))
  (when (or (hash-ref tab "has_bell_notification") (hash-ref tab "is_flashing_bell"))
    (set! suffix (string-append suffix " [!]")))
  (define name (if (and (hash-ref tab "active") (equal? (hash-ref mi "mode") "RenameTab") (equal? (hash-ref tab "name") ""))
      "Enter name..." (hash-ref tab "name")))
  (define text (string-append " " (ellipsize name (max 0 (- budget (yinz-text-width suffix)))) suffix " "))
  (define flat-left (= (hash-ref tab "position") 0))
  (define part (tile text fg bg flat-left))
  (unless (null? (hash-ref tab "other_focused_clients"))
    (define cursors (bar-focused-client-cursors tab (hash-ref p "multiplayer_user_colors")))
    (define outer (hash-ref (hash-ref p "text_unselected") "background"))
    (define (style text) (bar-paint text fg bg (if (bar-dimmed? mi) "3" "1")))
    (set! part (bar-line (string-append (bar-paint (bar-arrow mi) (if flat-left bg outer) bg "") (style text) (style "[")
          (apply string-append cursors) (style "]") (bar-paint (bar-arrow mi) bg outer ""))
        (+ (hash-ref part "len") (length cursors) 2))))
  (hash-insert part "tab" (hash-ref tab "position")))
(define (collapsed count left tab)
  (if (= count 0) (bar-line "" 0)
    (let ((n (if (< count 10000) (number->string count) "many")) (p (hash-ref (colors) "ribbon_unselected")))
      (hash-insert (tile (if left (string-append " ← +" n " ") (string-append " +" n " → "))
          (hash-ref p "base") (hash-ref p "background") #f) "tab" tab))))
(define (visible-tabs all active cols)
  (if (>= active (length all)) '()
    (let loop ((before (reverse (take all active))) (after (drop all (+ active 1)))
        (middle (list (list-ref all active))) (left-width 0) (right-width 0))
      (define left (collapsed (length before) #t (max 0 (- (length before) 1))))
      (define right (collapsed (length after) #f (+ (length before) (length middle))))
      (define total (+ (hash-ref left "len") (parts-width middle) (hash-ref right "len")))
      (define left-fits (and (not (null? before)) (<= (- (+ (hash-ref (car before) "len") total) (if (= (length before) 1) (hash-ref left "len") 0)) cols)))
      (define right-fits (and (not (null? after)) (<= (- (+ (hash-ref (car after) "len") total) (if (= (length after) 1) (hash-ref right "len") 0)) cols)))
      (cond ((> total cols) middle)
        ((and (or (<= left-width right-width) (not right-fits)) left-fits)
          (loop (cdr before) after (cons (car before) middle) (+ left-width (hash-ref (car before) "len")) right-width))
        (right-fits (loop before (cdr after) (append middle (list (car after))) left-width (+ right-width (hash-ref (car after) "len"))))
        (else (append (list left) middle (list right)))))))
(define (swap-keys)
  (define keys (bar-action-group (bar-mode-keymap mi) '(("PreviousSwapLayout") ("NextSwapLayout"))))
  (if (null? keys) (bar-line "" 0)
    (let* ((common (bar-common-modifiers keys))
        (labels (map (lambda (key) (bar-key-label (if (> (length keys) 1) (bar-strip-modifiers key common) key))) keys))
        (joined (string-join labels (bar-key-separator labels))) (modifier (string-join common "-"))
        (multi (and (not (null? common)) (> (length keys) 1)))
        (content (if multi (string-append " " modifier " <" joined "> ") (string-append " " joined " "))))
      (bar-line (yinz-ui-text (hash "text" content "opaque" #t "disabled" (bar-dimmed? mi)
            "levels" (if (bar-dimmed? mi) '() (list (if multi
                  (append (range (+ (yinz-text-width modifier) 1))
                    (range (+ (yinz-text-width modifier) 3) (min (string-length content) (+ (yinz-text-width modifier) 3 (yinz-text-width joined)))))
                  (range (string-length content))))))) (yinz-text-width content)))))
(define (indicator active)
  (cond
    ((and (not hide-swap-layout) (bar-present? (hash-ref active "active_swap_layout_name")))
      (define name (string-upcase (hash-ref active "active_swap_layout_name")))
      (bar-concat (swap-keys) (bar-line (yinz-ui-ribbon (hash "text" name "disabled" (bar-dimmed? mi)
              "selected" (and (not (bar-dimmed? mi)) (not (hash-ref active "is_swap_layout_dirty")))))
          (+ (yinz-text-width name) 2 (* 2 (yinz-text-width (bar-arrow mi)))))))
    (scroll
      (define text (string-append "[ SCROLL " (number->string (car scroll)) "/" (number->string (cadr scroll)) " ]"))
      (define p (hash-ref (colors) "text_unselected"))
      (bar-line (bar-paint text (hash-ref p "base") (hash-ref p "background") (if (bar-dimmed? mi) "3" "1")) (yinz-text-width text)))
    (else #f)))
(define (hint-part budget)
  (if (or (not hint) (equal? (bar-get mi "pane_frame_style" #f) "full")) #f
    (let ((sizes (sort (filter (lambda (size) (<= (string->number size) budget)) (hash-keys->list hint))
            (lambda (a b) (> (string->number a) (string->number b))))))
      (if (null? sizes) #f
        (let* ((best (hash-ref hint (car sizes))) (text (hash-ref best "text"))
            (levels (map (lambda (indices) (filter (lambda (index) (< index (string-length text))) indices))
                (take (hash-ref best "indices") (min 9 (length (hash-ref best "indices")))))))
          (bar-line (yinz-ui-text (hash "text" text "levels" levels "disabled" (bar-dimmed? mi))) (yinz-text-width text)))))))
(define (render-tabs rows columns)
  (if (null? tabs) ""
    (begin
      (define cols (max 0 (- columns 1)))
      (set! parts (if group-row-visible '() (prefix cols)))
      (set! new-tab-range #f)
      (define budget (max 8 (min 45 (- cols (parts-width parts) (* 4 (yinz-text-width (bar-arrow mi))) 5))))
      (define index -1)
      (define all (map (lambda (tab) (set! index (+ index 1)) (tab-part tab (= (modulo index 2) 1) budget)) tabs))
      (define active (car (filter (lambda (tab) (hash-ref tab "active")) tabs)))
      (if (>= (hash-ref active "position") (length all))
        (begin (set! parts '()) (set! breadcrumb-range #f) "")
        (begin
          (define active-part (list-ref all (hash-ref active "position")))
          (define status (and (not group-row-visible) (or (hint-part (max 0 (- cols (parts-width parts) (hash-ref active-part "len")))) (indicator active))))
          (when (and status (> (hash-ref status "len") 0) (> (+ (parts-width parts) (hash-ref active-part "len") (hash-ref status "len")) cols)) (set! status #f))
          (set! parts (append parts (visible-tabs all (hash-ref active "position")
                (max 0 (- cols (parts-width parts) (if status (hash-ref status "len") 0)))) (list (bar-line (bar-fill mi) 0))))
          (define p (hash-ref (colors) "ribbon_unselected"))
          (define alternate (if (hash-ref (hash-ref mi "capabilities") "arrow_fonts") (= (modulo (length tabs) 2) 1) hovered-button))
          (define button (tile " + " (hash-ref p "base") (hash-ref p (if (and alternate (not (bar-dimmed? mi))) "emphasis_1" "background")) #f))
          (define used (parts-width parts))
          (when (>= (max 0 (- cols used (if status (hash-ref status "len") 0))) (hash-ref button "len"))
            (set! new-tab-range (list used (+ used (hash-ref button "len"))))
            (set! parts (append parts (list button))))
          (when status
            (define padding (max 0 (- cols (parts-width parts) (hash-ref status "len"))))
            (define bg (hash-ref (hash-ref (colors) "text_unselected") "background"))
            (set! parts (append parts (list (bar-concat (bar-line (bar-paint (make-string padding #\space) bg bg "") padding) status)))))
          (set! parts (append parts (list (bar-line (bar-fill mi) 0))))
          (apply string-append (map (lambda (part) (hash-ref part "part")) parts)))))))

(define (render-groups columns)
  (define cols (max 0 (- columns 1)))
  (set! group-parts (prefix cols))
  (define index -1)
  (define active 0)
  (define budget (max 1 (min 40 (- cols (parts-width group-parts) (* 2 (yinz-text-width (bar-arrow mi))) 3))))
  (define all (map (lambda (group)
        (set! index (+ index 1))
        (define selected (= (hash-ref group "id") focused-group))
        (when selected (set! active index))
        (define palette (hash-ref (colors) (if (and selected (not (bar-dimmed? mi))) "ribbon_selected" "ribbon_unselected")))
        (hash-insert (tile (string-append " " (ellipsize (hash-ref group "name") budget) " ")
            (hash-ref palette "base") (hash-ref palette (if (and (not selected) (not (bar-dimmed? mi)) (equal? hovered-group index)) "emphasis_1" "background")) #f) "tab" index)) groups))
  (define available (max 0 (- cols (parts-width group-parts) (hash-ref (list-ref all active) "len"))))
  (define active-tab-info (car (filter (lambda (tab) (hash-ref tab "active")) tabs)))
  (define status (or (hint-part available) (indicator active-tab-info)))
  (when (and status (> (hash-ref status "len") available)) (set! status #f))
  (set! group-parts (append group-parts
      (visible-tabs all active (max 0 (- cols (parts-width group-parts) (if status (hash-ref status "len") 0))))))
  (define p (hash-ref (colors) "ribbon_unselected"))
  (define alternate (if (hash-ref (hash-ref mi "capabilities") "arrow_fonts") (= (modulo (length groups) 2) 1) hovered-group-button))
  (define button (tile " + " (hash-ref p "base") (hash-ref p (if (and alternate (not (bar-dimmed? mi))) "emphasis_1" "background")) #f))
  (define used (parts-width group-parts))
  (when (>= (max 0 (- cols used (if status (hash-ref status "len") 0))) (hash-ref button "len"))
    (set! new-group-range (list used (+ used (hash-ref button "len"))))
    (set! group-parts (append group-parts (list button))))
  (when status
    (define padding (max 0 (- cols (parts-width group-parts) (hash-ref status "len"))))
    (define bg (hash-ref (hash-ref (colors) "text_unselected") "background"))
    (set! group-parts (append group-parts
        (list (bar-concat (bar-line (bar-paint (make-string padding #\space) bg bg "") padding) status)))))
  (string-append (apply string-append (map (lambda (part) (hash-ref part "part")) group-parts)) (bar-fill mi)))

(define (render rows columns)
  (set! new-group-range #f)
  (set! group-row-visible (and (> rows 1) (not (null? groups))))
  (unless group-row-visible (set! hovered-group #f) (set! hovered-group-button #f))
  (if group-row-visible
    (string-append (render-groups columns) "\r\n" (render-tabs rows columns))
    (render-tabs rows columns)))
