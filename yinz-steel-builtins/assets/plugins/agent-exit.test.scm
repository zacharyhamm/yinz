(require "./testing/common.scm")
(define head "0123456789012345678901234567890123456789")
(define (listing . secondary)
  (string-append "worktree /repo\u{0}HEAD " head "\u{0}branch refs/heads/main\u{0}\u{0}"
    (if (or (null? secondary) (car secondary)) (string-append "worktree /repo/topic\u{0}HEAD " head "\u{0}branch refs/heads/topic\u{0}\u{0}") "")))
(define (commands) (yinz-json-string (test-commands)))
(define (last-run) (define result (t-last (t-named "RunCommand"))) (assert result) (hash-ref result "RunCommand"))
(define (has-command text) (string-contains? (commands) text))
(define (run-has text) (string-contains? (yinz-json-string (last-run)) text))
(define (key bare) (test-event (hash "Key" (t-key bare))))
(define (reply stdout . options)
  (test-event (hash "RunCommandResult" (list (if (null? options) 0 (car options)) (t-utf8 stdout) (t-utf8 (if (< (length options) 2) "" (cadr options))) (list-ref (last-run) 3)))))
(define replies (hash "ProjectConfigRead" (hash "config" (hash "default_branch" "main") "error" json-null) "RunCommand" json-null "RequestPluginPermissions" json-null "CloseSelf" json-null "RerunCommandPane" json-null "CloseTerminalPane" json-null))
(define (checkout . options)
  (t-load "./agent-exit.scm" replies (t-merge (hash "agent_cwd" "/repo/topic" "agent_pane_id" "7" "agent_target" "local") (if (null? options) (hash) (car options))))
  (reply "/repo/topic\n") (reply (if (< (length options) 2) (listing) (cadr options))))
(define (prepare . output)
  (define before (length (t-named "RunCommand"))) (key "Delete")
  (when (> (length (t-named "RunCommand")) before) (reply (if (null? output) (listing) (car output)))) (test-render 24 200))
(define (confirm . output) (apply prepare output) (key "Delete") (when (run-has "\"fetch\"") (reply "" 128 "origin unavailable")))
(define (clean)
  (assert (run-has "\"status\",\"--porcelain\",\"--untracked-files=all\"")) (reply "")
  (assert (run-has "\"rev-list\",\"--max-count=1\"")) (reply ""))
(define (preserved)
  (assert (not (has-command "\"worktree\",\"remove\""))) (assert (not (has-command "\"update-ref\""))))
(for-each (lambda (scenario)
    (test (string-append "agent-exit " (hash-ref scenario "name")) (lambda ()
        (checkout) (prepare) (assert (not (has-command "\"fetch\""))) (key "Delete")
        (assert (run-has "\"fetch\",\"--no-tags\",\"origin\",\"+refs/heads/main:refs/remotes/origin/main\""))
        (define fetch-fails (t-get scenario "fetchFails" #f)) (define local-fails (t-get scenario "localFails" #f)) (define remote-fails (t-get scenario "remoteFails" #f))
        (reply "" (if fetch-fails 128 0) "fetch unavailable") (reply (listing)) (reply "") (reply (hash-ref scenario "local") (if local-fails 128 0) "local unavailable")
        (define local-proof (and (equal? (hash-ref scenario "local") "") (not local-fails)))
        (when (and (not local-proof) (not fetch-fails)) (assert (run-has (string-append "refs/remotes/origin/main.." head))) (reply (t-get scenario "remote" "") (if remote-fails 128 0) "remote unavailable"))
        (if (or local-proof (and (not fetch-fails) (not remote-fails) (equal? (t-get scenario "remote" "") "")))
          (begin (reply "") (reply "") (assert-equal (t-last (test-commands)) "CloseSelf"))
          (begin (define rendered (test-render 30 200)) (assert (string-contains? rendered "worktree and branch preserved")) (assert (string-contains? rendered "local main or freshly fetched origin/main"))
            (when fetch-fails (assert (string-contains? rendered "fetch unavailable"))) (preserved)))
        (when fetch-fails (assert (not (has-command (string-append "refs/remotes/origin/main.." head))))))))
  (list (hash "name" "fresh remote proof" "local" head "remote" "") (hash "name" "local proof with remote behind" "local" "" "remote" head)
    (hash "name" "neither destination merged" "local" head "remote" head) (hash "name" "failed fetch with local proof" "local" "" "fetchFails" #t)
    (hash "name" "failed fetch excludes stale remote proof" "local" head "fetchFails" #t) (hash "name" "missing local base with remote proof" "local" "" "localFails" #t "remote" "")
    (hash "name" "Git verification failure" "local" "" "localFails" #t "remoteFails" #t)))
(for-each (lambda (local-proof)
    (test (string-append "agent-exit fetch deadline " (if local-proof "allows local cleanup" "preserves without local proof")) (lambda ()
        (checkout) (prepare) (key "Delete") (define fetch (last-run)) (test-advance 9999) (assert-equal (last-run) fetch)
        (define pending (length (test-commands))) (assert (not (string-contains? (test-render) "Deletion failed"))) (key "Esc") (assert-equal (length (test-commands)) pending)
        (test-advance 1) (assert (run-has "\"worktree\",\"list\"")) (define verifying (length (test-commands)))
        (test-event (hash "RunCommandResult" (list 0 '() '() (list-ref fetch 3)))) (assert-equal (length (test-commands)) verifying)
        (reply (listing)) (reply "") (assert (run-has (string-append "refs/heads/main.." head))) (reply (if local-proof "" head))
        (assert (not (has-command (string-append "refs/remotes/origin/main.." head))))
        (if local-proof (begin (assert (run-has "\"worktree\",\"remove\"")) (reply "") (reply "") (assert-equal (t-last (test-commands)) "CloseSelf"))
          (begin (define failure (test-render 30 200))
            (for-each (lambda (text) (assert (string-contains? failure text))) '("Fetch origin/main: Error: git timed out after 10000 ms" "worktree and branch preserved" "Delete: retry cleanup  Esc: close pane"))
            (preserved) (define count (length (test-commands))) (test-event (hash "RunCommandResult" (list 0 '() '() (list-ref fetch 3))))
            (assert-equal (length (test-commands)) count) (assert-equal (test-render 30 200) failure) (prepare) (assert (string-contains? (test-render 30 200) "Delete again"))
            (key "Esc") (assert (not (member "CloseSelf" (test-commands)))) (key "Esc") (assert-equal (take (reverse (test-commands)) 2) (list "CloseSelf" (hash "CloseTerminalPane" 7)))))))) '(#t #f))
(for-each (lambda (code)
    (test (string-append "agent-exit cancels fetch deadline after exit " (number->string code)) (lambda ()
        (checkout) (prepare) (key "Delete") (reply "" code) (define count (length (test-commands)))
        (test-advance 9999) (assert-equal (length (test-commands)) count) (test-advance 1) (assert-equal (length (test-commands)) count)
        (reply (listing)) (clean) (reply "") (reply "") (assert-equal (t-last (test-commands)) "CloseSelf")))) '(0 128))
(define (changed-listing change) (cond [(equal? change "head") (t-replace (listing) head (t-repeat "1" 40))] [(equal? change "branch") (t-replace (listing) "refs/heads/topic" "refs/heads/other")] [else (listing)]))
(for-each (lambda (change)
    (test (string-append "agent-exit refuses " change " changes during fetch") (lambda ()
        (checkout) (prepare) (key "Delete") (reply "") (reply (changed-listing change))
        (when (equal? change "dirty") (reply "?? new-file\n"))
        (assert (string-contains? (test-render) (if (equal? change "dirty") "uncommitted changes" "identity changed"))) (preserved)))) '("head" "branch" "dirty"))
(for-each (lambda (entry)
    (test (string-append "agent-exit fallback " (car entry)) (lambda ()
        (t-load "./agent-exit.scm" (hash "CloseSelf" json-null "RerunCommandPane" json-null "CloseTerminalPane" json-null) (hash "agent_pane_id" "7"))
        (assert (string-contains? (test-render) "restart agent")) (key (car entry))
        (assert-equal (reverse (map (lambda (command) (if (string? command) command (car (hash-keys->list command)))) (take (reverse (test-commands)) 2))) (cadr entry))))) '(("Enter" ("RerunCommandPane" "CloseSelf")) ("Esc" ("CloseTerminalPane" "CloseSelf"))))
(test "agent-exit offers no deletion without a secondary worktree" (lambda ()
    (t-load "./agent-exit.scm" (hash) (hash "agent_pane_id" "7")) (key "Delete") (assert (not (member "CloseSelf" (test-commands)))) (assert (not (string-contains? (test-render) "Delete worktree")))))
(test "agent-exit offers no deletion for a primary checkout" (lambda ()
    (t-load "./agent-exit.scm" replies (hash "agent_cwd" "/repo" "agent_target" "local")) (reply "/repo\n") (reply (listing #f)) (assert (not (string-contains? (test-render) "Delete worktree")))))
(test "agent-exit offers no deletion outside a repository" (lambda ()
    (t-load "./agent-exit.scm" replies (hash "agent_cwd" "/repo" "agent_target" "local")) (reply "" 128 "not a repository") (assert (not (string-contains? (test-render) "Delete worktree")))))
(for-each (lambda (throws)
    (test (if throws "agent-exit shows thrown project reads while inspecting Git" "agent-exit shows project configuration errors while inspecting Git") (lambda ()
        (t-load "./agent-exit.scm" (if throws (hash "RunCommand" json-null) (hash-insert replies "ProjectConfigRead" (hash "config" (hash "default_branch" "main") "error" "malformed project config"))) (hash "agent_cwd" "/repo/topic" "agent_target" "local"))
        (reply "/repo/topic\n") (reply (listing)) (assert (string-contains? (test-render) (if throws "unstubbed host operation ProjectConfigRead" "malformed project config")))
        (assert (has-command "RunCommand")) (assert (string-contains? (test-render) "Delete worktree"))))) '(#f #t))
(test "agent-exit confirms and cancels secondary worktree deletion" (lambda ()
    (checkout) (assert (string-contains? (test-render) "Delete: Delete worktree & branch and close pane")) (prepare)
    (define confirmation (test-render)) (assert (and (string-contains? confirmation "/repo/topic") (string-contains? confirmation "topic")))
    (key "Esc") (assert (not (string-contains? (test-render) "Delete again")))))
(for-each (lambda (target)
    (test (string-append "agent-exit revalidates then removes the " target " worktree and branch") (lambda ()
        (checkout (hash "agent_target" target)) (confirm) (reply (listing)) (clean) (reply "") (reply "")
        (assert (has-command "\"worktree\",\"remove\",\"--\",\"/repo/topic\"")) (assert (has-command (string-append "\"update-ref\",\"-d\",\"refs/heads/topic\",\"" head "\"")))
        (assert-equal (take (reverse (test-commands)) 2) (list "CloseSelf" (hash "CloseTerminalPane" 7)))))
    (for-each (lambda (changes)
        (test (string-append "agent-exit preserves " target " dirty worktree and branch: " (trim changes)) (lambda ()
            (checkout (hash "agent_target" target)) (confirm) (reply (listing)) (reply changes) (assert (string-contains? (test-render 24 200) "uncommitted changes")) (preserved) (assert (not (member "CloseSelf" (test-commands))))))) '(" M tracked\n" "?? untracked\n" "M  staged\n"))
    (test (string-append "agent-exit preserves " target " commits not merged into the configured base") (lambda ()
        (checkout (hash "agent_target" target)) (test-stub "ProjectConfigRead" (hash "config" (hash "default_branch" "trunk") "error" json-null))
        (confirm) (assert (has-command "+refs/heads/trunk:refs/remotes/origin/trunk")) (reply (listing)) (reply "") (assert (run-has (string-append "refs/heads/trunk.." head)))
        (reply (string-append head "\n")) (assert (string-contains? (test-render 24 200) "merged into local trunk")) (preserved) (assert (not (member "CloseSelf" (test-commands))))))) '("local" "bubblewrap"))
(test "agent-exit refuses branch deletion when the worktree disappeared externally" (lambda ()
    (checkout) (confirm) (reply (listing #f)) (assert (string-contains? (test-render) "worktree disappeared")) (assert (not (has-command "\"update-ref\"")))))
(test "agent-exit keeps diagnostics visible and retries after partial cleanup" (lambda ()
    (checkout) (confirm) (reply (listing)) (clean) (reply "") (reply "" 1 "branch is locked")
    (define failure (test-render)) (assert (string-contains? failure "branch is locked")) (assert (string-contains? failure "Worktree removed; branch cleanup remains.")) (assert (not (string-contains? failure "restart agent")))
    (define count (length (test-commands))) (key "Enter") (assert-equal (length (test-commands)) count)
    (prepare) (key "Esc") (assert (string-contains? (test-render) "branch is locked")) (confirm) (reply "") (assert-equal (t-last (test-commands)) "CloseSelf")))
(test "agent-exit treats an already absent branch as completed" (lambda () (checkout) (confirm) (reply (listing)) (clean) (reply "") (reply "") (assert-equal (t-last (test-commands)) "CloseSelf")))
(test "agent-exit refuses a branch whose head changed" (lambda ()
    (checkout) (confirm) (reply (listing)) (clean) (reply "") (reply "" 128 "cannot lock ref: is at another head but expected original") (assert (string-contains? (test-render) "cannot lock ref")) (assert (not (member "CloseSelf" (test-commands))))))
(test "agent-exit removes a detached secondary checkout without deleting a branch" (lambda ()
    (define detached (t-replace (listing) "branch refs/heads/topic" "detached")) (checkout (hash) detached) (prepare detached) (assert (string-contains? (test-render) "detached HEAD"))
    (key "Delete") (reply "" 128 "origin unavailable") (reply detached) (clean) (reply "") (assert-equal (t-last (test-commands)) "CloseSelf") (assert (not (has-command "update-ref")))))
(for-each (lambda (field)
    (test (string-append "agent-exit refuses cleanup when the confirmed " field " changes") (lambda ()
        (checkout) (confirm) (reply (changed-listing field)) (assert (string-contains? (test-render) "identity changed")) (assert (not (has-command "\"worktree\",\"remove\"")))))) '("head" "branch"))
(test "agent-exit refreshes a changed checkout before confirming its exact revision" (lambda ()
    (checkout) (define next (t-repeat "1" 40)) (define changed (t-replace (t-replace (listing) head next) "refs/heads/topic" "refs/heads/rebased"))
    (key "Delete") (assert (string-contains? (test-render) "Checking current checkout")) (define count (length (test-commands))) (key "Delete") (assert-equal (length (test-commands)) count)
    (reply changed) (define confirmation (test-render)) (for-each (lambda (text) (assert (string-contains? confirmation text))) (list next "Branch: rebased" "commits merged into the local base branch"))
    (key "Delete") (reply "" 128 "origin unavailable") (reply changed) (clean) (reply "") (reply "")
    (assert (has-command (string-append "\"refs/heads/rebased\",\"" next "\""))) (assert-equal (t-last (test-commands)) "CloseSelf")))
(test "agent-exit requires the complete confirmation to be visible before deleting" (lambda ()
    (checkout) (key "Delete") (reply (listing)) (define count (length (test-commands)))
    (key "Delete") (assert-equal (length (test-commands)) count)
    (for-each (lambda (size) (apply test-render size) (key "Delete") (assert-equal (length (test-commands)) count)) '((1 1) (2 8) (8 24)))
    (assert (string-contains? (test-render 8 24) "Deletion disabled")) (assert (string-contains? (test-render 8 24) "Esc: cancel")) (key "Delete") (assert-equal (length (test-commands)) count)
    (test-render 24 80) (key "Delete") (assert (> (length (test-commands)) count)) (set! count (length (test-commands))) (key "Enter") (assert-equal (length (test-commands)) count)))
(test "agent-exit never inspects an SSH pane's path locally" (lambda ()
    (t-load "./agent-exit.scm" (hash) (hash "agent_cwd" "/repo/topic" "agent_target" "ssh")) (assert (not (string-contains? (test-render) "Delete worktree"))) (assert (not (has-command "RunCommand")))))
(for-each (lambda (secondary)
    (test (string-append "agent-exit Esc closes panes in a " (if secondary "secondary" "primary") " checkout") (lambda ()
        (define directory (if secondary "/repo/topic" "/repo"))
        (t-load "./agent-exit.scm" (t-merge replies (hash "GetPluginIds" (hash "plugin_id" 1) "GetPaneInfo" (hash "is_suppressed" #f) "MessageToPlugin" json-null "SetSelfMouseSelectionSupport" json-null "SubscribePaneOutput" json-null "SetPaneSubtitle" json-null))
          (hash "agent_cwd" directory "agent_target" "local" "agent_pane_id" "7"))
        (reply (string-append directory "\n")) (reply (listing secondary)) (assert (string-contains? (test-render 24 200) "Esc: close pane"))
        (when secondary (prepare) (key "Esc") (assert (not (member "CloseSelf" (test-commands)))))
        (define count (length (test-commands))) (key "Esc") (assert-equal (drop (test-commands) count) (list (hash "CloseTerminalPane" 7) "CloseSelf")) (preserved)))) '(#f #t))
