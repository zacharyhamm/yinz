(require "./testing/common.scm")
(test "embedded tab bar receives tab updates and remains unselectable" (lambda ()
    (s-start (hash "columns" 240)) (test-wait-for-text "yinz-test>") (s-load "yinz:tab-bar")
    (test-wait-for "tab bar is unselectable" (lambda () (t-any (lambda (pane) (and (equal? (t-get pane "plugin_url" #f) "yinz:tab-bar") (not (hash-ref pane "is_selectable")))) (s-panes))))
    (s-action "SwitchToMode \"Tab\";") (s-key "r") (s-text "scheme-tab") (s-action "SwitchToMode \"Normal\";")
    (test-wait-for-text "scheme-tab") (s-action "NewTab;")
    (test-wait-for "second tab opened" (lambda () (= 2 (length (filter s-terminal? (s-panes))))))
    (s-action "SwitchToMode \"Tab\";") (s-key "r") (s-text "second-tab") (s-action "SwitchToMode \"Normal\";") (s-action "GoToPreviousTab;")
    (test-wait-for "original tab restored" (lambda () (and (string-contains? (s-screen) "scheme-tab") (string-contains? (s-screen) "second-tab"))))
    (assert (t-any (lambda (pane) (equal? (t-get pane "plugin_url" #f) "yinz:tab-bar")) (s-panes)))))
