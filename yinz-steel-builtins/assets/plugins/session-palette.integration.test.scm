(require "./testing/common.scm")
(test "session palette forms and acknowledged saving work in a real session" (lambda ()
    (s-start (hash "columns" 160 "backgroundPlugins" (list (hash "path" "yinz:session-palette" "configuration" (hash "shared" "true")))))
    (test-wait-for-text "yinz-test>") (s-key "Ctrl Alt p") (s-text "New session") (test-wait-for-text "› New session…") (s-key "Enter")
    (test-wait-for-text "Name (optional):") (s-text "preserved-name") (s-key "Enter") (s-key "Down") (s-key "Enter")
    (test-wait-for-text "Configure new session") (assert (string-contains? (s-screen) "preserved-name")) (assert (string-contains? (s-screen) "Layout (type to search)"))
    (s-key "Esc") (test-wait-for "original form restored" (lambda () (and (string-contains? (s-screen) "preserved-name") (not (string-contains? (s-screen) "Directory:")))))
    (s-key "Ctrl Alt p") (test-wait-for "palette closed" (lambda () (not (string-contains? (s-screen) "Name (optional):"))))
    (s-key "Ctrl Alt p") (s-text "Save current session") (test-wait-for-text "› Save current session") (s-key "Enter") (test-wait-for-text "Session saved")))
