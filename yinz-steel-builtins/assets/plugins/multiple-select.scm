(require "./bar/keys.scm" "./bar/default-mode.scm")
(yinz-declare-pane)

(define plugin-id 0)
(define client-id "")
(define own-tab #f)
(define total-tabs 0)
(define grouped '())
(define all-groups (hash))
(define mode (bar-default-mode))
(define closing #f)
(define highlighted-at #f)
(define baseline-width 0)
(define current-size '(0 0))
(define display-rows 0)
(define display-cols 0)
(define alternate #f)

(define (load configuration)
  (yinz-command (hash "Subscribe" '("Key" "InterceptedKeyPress" "ModeUpdate" "PaneUpdate" "TabUpdate" "Timer")))
  (define ids (yinz-command "GetPluginIds"))
  (set! plugin-id (hash-ref ids "plugin_id"))
  (set! client-id (number->string (hash-ref ids "client_id")))
  (yinz-command "InterceptKeyPresses")
  (yinz-command (hash "SetSelectable" #f)))

(define (close)
  (set! closing #t)
  (yinz-command "CloseSelf"))
(define (ungroup)
  (define clients (sort (hash-keys->list all-groups)
      (lambda (a b) (< (string->number a) (string->number b)))))
  (yinz-command (hash "GroupAndUngroupPanes"
      (list '() (apply append (map (lambda (client) (hash-ref all-groups client)) clients)) #t))))
(define (threshold-elapsed?)
  (or (not highlighted-at) (>= (- (yinz-now-ms) highlighted-at) 400)))
(define (pane-update manifest)
  (define panes (hash-ref manifest "panes"))
  (define indexed '())
  (set! all-groups (hash))
  (for-each (lambda (tab)
      (for-each (lambda (pane)
          (define id (hash (if (hash-ref pane "is_plugin") "Plugin" "Terminal") (hash-ref pane "id")))
          (define groups (hash-ref pane "index_in_pane_group"))
          (for-each (lambda (client)
              (set! all-groups (hash-insert all-groups client
                  (append (bar-get all-groups client '()) (list id))))) (hash-keys->list groups))
          (when (hash-contains? groups client-id)
            (set! indexed (append indexed (list (list (hash-ref groups client-id) id)))))
          (when (equal? id (hash "Plugin" plugin-id)) (set! own-tab (string->number tab))))
        (hash-ref panes tab))) (hash-keys->list panes))
  (when (null? (hash-keys->list all-groups)) (close))
  (define previous (length grouped))
  (set! grouped (map cadr (sort indexed (lambda (a b) (< (car a) (car b))))))
  (define count (length grouped))
  (unless (= previous count)
    (yinz-command (hash "RenamePluginPane" (list plugin-id "Multiple Pane Select")))
    (when (and (> previous 0) (> count 0) (threshold-elapsed?))
      (set! highlighted-at (yinz-now-ms))
      (yinz-command (hash "HighlightAndUnhighlightPanes" (list (list (hash "Plugin" plugin-id)) '())))
      (yinz-command (hash "SetTimeout" 0.4))))
  (set! total-tabs (length (hash-keys->list panes)))
  #t)
(define (new-tab)
  (yinz-command (hash "BreakPanesToNewTab" (list grouped json-null #t))))
(define (move-overlay)
  (define width (max (exact (floor (* display-cols 0.3))) 48))
  (define height (max (exact (floor (* display-rows 0.3))) 10))
  (yinz-command (hash "ChangeFloatingPanesCoordinates"
      (list (list (hash "Plugin" plugin-id)
          (hash "x" (hash "Fixed" (if alternate 2 (max 0 (- display-cols width 2))))
            "y" (hash "Fixed" (max 0 (- display-rows height 2)))
            "width" (hash "Fixed" width) "height" (hash "Fixed" height)
            "pinned" #t "borderless" #f)))))
  (set! alternate (not alternate)))
(define (key-press key)
  (when (null? (hash-ref key "key_modifiers"))
    (define bare (hash-ref key "bare_key"))
    (define character (if (hash? bare) (bar-get bare "Char" #f) #f))
    (cond
      ((member character '("b" "s" "f" "e" "c"))
        (if (equal? character "b") (new-tab)
          (yinz-command (hash (hash-ref (hash "s" "StackPanes" "f" "FloatMultiplePanes"
                  "e" "EmbedMultiplePanes" "c" "CloseMultiplePanes") character) grouped)))
        (close)
        (unless (equal? character "c") (ungroup)))
      ((and own-tab (member character '("l" "r")))
        (define target (+ own-tab (if (equal? character "l") -1 1)))
        (if (and (>= target 0) (< target total-tabs))
          (yinz-command (hash "BreakPanesToTabWithIndex" (list grouped target #t))) (new-tab))
        (close))
      ((equal? bare "Esc") (ungroup) (close))
      ((equal? bare "Tab") (move-overlay))))
  #f)
(define (update event)
  (if closing #f
    (begin
      (yinz-command "InterceptKeyPresses")
      (cond
        ((hash-contains? event "ModeUpdate")
          (define next (hash-ref event "ModeUpdate"))
          (if (equal? mode next) #f
            (begin (set! mode next) (set! baseline-width (max baseline-width (ui-width))) #t)))
        ((hash-contains? event "PaneUpdate") (pane-update (hash-ref event "PaneUpdate")))
        ((hash-contains? event "TabUpdate")
          (define active (filter (lambda (tab) (hash-ref tab "active")) (hash-ref event "TabUpdate")))
          (unless (null? active)
            (set! display-rows (hash-ref (car active) "display_area_rows"))
            (set! display-cols (hash-ref (car active) "display_area_columns"))) #f)
        ((hash-contains? event "InterceptedKeyPress") (key-press (hash-ref event "InterceptedKeyPress")))
        ((hash-contains? event "Timer")
          (when (threshold-elapsed?)
            (yinz-command (hash "HighlightAndUnhighlightPanes" (list '() (list (hash "Plugin" plugin-id)))))) #f)
        (else #f)))))

(define header "<ESC> - cancel, <TAB> - move")
(define shortcuts '("<b> - break out, <s> - stack, <c> - close"
    "<l> - break left, <r> - break right" "<e> - embed, <f> - float"))
(define (actions-text)
  (string-append "GROUP ACTIONS (" (number->string (length grouped))
    " SELECTED PANE" (if (= (length grouped) 1) "" "S") ")"))
(define (bindings)
  (define keymap (bar-mode-keymap mode))
  (define (find action)
    (define found (filter (lambda (entry)
          (and (pair? (cadr entry)) (equal? (car (cadr entry)) action))) keymap))
    (if (null? found) #f (caar found)))
  (define toggle (find "TogglePaneInGroup"))
  (define follow (find "ToggleGroupMarking"))
  (define common (bar-common-modifiers (filter (lambda (key) key) (list toggle follow))))
  (list (if (null? common) "" (string-append (string-join common " ") " + "))
    (and toggle (bar-key-label (bar-strip-modifiers toggle common)))
    (and follow (bar-key-label (bar-strip-modifiers follow common)))))
(define (toggle-text key) (string-append "<" key "> Toggle"))
(define (follow-text key) (string-append "<" key "> Follow Focus"))
(define (ui-width)
  (define keys (bindings))
  (foldl max 0 (list (+ (string-length (car keys))
        (if (cadr keys) (+ 4 (string-length (toggle-text (cadr keys)))) 0)
        (if (caddr keys) (+ 4 (string-length (follow-text (caddr keys)))) 0))
      (string-length header) (string-length (actions-text)) (foldl max 0 (map string-length shortcuts)))))
(define (styled text level indices)
  (hash "text" text "levels" (append (map (lambda (n) '()) (range level)) (list indices))))
(define (all text level) (styled text level (range (string-length text))))
(define (tokens text)
  (let loop ((chars (string->list text)) (i 0) (inside #f) (indices '()))
    (if (null? chars) (styled text 3 (reverse indices))
      (loop (cdr chars) (+ i 1) (and (not (equal? (car chars) #\>)) (or inside (equal? (car chars) #\<)))
        (if (or inside (equal? (car chars) #\<)) (cons i indices) indices)))))
(define (key-style text key)
  (define count (string-length key))
  (styled text 0 (apply append (map (lambda (i)
          (if (equal? (substring text i (+ i count)) key) (range i (+ i count)) '()))
        (range (+ 1 (- (string-length text) count)))))))
(define (text-at text x y) (yinz-ui-text text (yinz-ui-coordinates x y json-null json-null)))
(define (controls x y)
  (define keys (bindings))
  (define common (car keys))
  (define toggle (cadr keys))
  (define follow (caddr keys))
  (define next (+ x (string-length common)))
  (string-append
    (if (equal? common "") "" (text-at (all common 0) x y))
    (if toggle (yinz-ui-ribbon (key-style (toggle-text toggle) toggle)
        (yinz-ui-coordinates next y json-null json-null)) "")
    (if follow (yinz-ui-ribbon (hash-insert (key-style (follow-text follow) follow)
          "selected" (equal? (hash-ref mode "currently_marking_pane_group") #t))
        (yinz-ui-coordinates (+ next (if toggle (+ 4 (utf8-length (toggle-text toggle))) 0))
          y json-null json-null)) "")))
(define (render rows cols)
  (unless (equal? current-size (list rows cols))
    (set! current-size (list rows cols)) (set! baseline-width 0))
  (if (null? grouped)
    (string-append
      (text-at (all "PANES SELECTED FOR OTHER CLIENT" 2) (quotient (max 0 (- cols (string-length "PANES SELECTED FOR OTHER CLIENT"))) 2) (quotient rows 2))
      (text-at (tokens "<ESC> - close") (quotient (max 0 (- cols 13)) 2) (+ (quotient rows 2) 2)))
    (begin
      (set! baseline-width (max baseline-width (ui-width)))
      (define x (quotient (max 0 (- cols baseline-width)) 2))
      (define y (quotient (max 0 (- rows 8)) 2))
      (string-append (text-at (tokens header) x y) (text-at (all (actions-text) 2) x (+ y 2))
        (apply string-append (map (lambda (i) (text-at (tokens (list-ref shortcuts i)) x (+ y i 3))) (range 3)))
        (controls x (+ y 7))))))
