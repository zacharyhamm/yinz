;; The modal owns its form, project choice, probes, and launch lifecycle.
;; Shared pure planners interpret provider capabilities; all side effects use yinz-command.
(yinz-declare-pane-unless "duplicate_focused" "true")
(define (at object key fallback) (if (and (hash? object) (hash-contains? object key)) (hash-ref object key) fallback))
(define (present value) (and value (not (json-null? value))))
(define (sat a b) (max 0 (- a b)))
(define (nth values index) (if (and (>= index 0) (< index (length values))) (list-ref values index) #f))
(define (find pred values) (cond [(null? values) #f] [(pred (car values)) (car values)] [else (find pred (cdr values))]))
(define (index-of value values) (let loop ([values values] [i 0]) (cond [(null? values) #f] [(equal? value (car values)) i] [else (loop (cdr values) (+ i 1))])))
(define (range-n a b) (if (>= a b) '() (cons a (range-n (+ a 1) b))))
(define (color text level) (hash "text" text "levels" (map (lambda (i) (if (= i level) (range-n 0 (string-length text)) '())) (range-n 0 (+ level 1)))))
(define (capitalized text) (if (equal? text "") "" (string-append (string-upcase (substring text 0 1)) (substring text 1))))
(define (failure-text failure) (trim (error-object-message failure)))
(define (notify message) (yinz-command (hash "Notify" (list message json-null json-null))))
(define (ok result) (if (hash-contains? result "Err") (error (hash-ref result "Err")) (hash-ref result "Ok")))
(define providers '())
(define (model ns op . args) (yinz-agent-model "providers" "WithSnapshot" (list providers ns op args)))
(define (launch op . args) (apply model (append (list "launch" op) args)))
(define (agent-options op kind) (cons "Agent default" (launch op kind)))
(define defaults (launch "Defaults"))
(define (new-dialog)
  (define widget (yinz-ui-dialog (color "New agent" 2)
      (list (yinz-ui-select "project" "Project" '("(current directory)") 0)
        (yinz-ui-select "agent" "Agent" (map capitalized (launch "Offered")) 0)
        (yinz-ui-input "model" "Model (optional)" "")
        (yinz-ui-select "effort" "Reasoning effort" (agent-options "EffortOptions" "codex") 0)
        (yinz-ui-select "permission_mode" "Approval mode" (agent-options "PermissionModes" "codex") 0)
        (yinz-ui-input "prompt" "Prompt (optional)" "")
        (yinz-ui-checkbox "create_branch" "Create and switch branch" #t)
        (yinz-ui-combo "base" "Base" '() (hash-ref defaults "base"))
        (yinz-ui-combo "branch" "Branch" '() "")
        (yinz-ui-checkbox "worktree" "Use worktree" #t)
        (yinz-ui-combo "path" "Worktree directory (from repo root)" '() (hash-ref defaults "worktree_prefix"))
        (yinz-ui-checkbox "reuse" "Reuse existing branch or worktree" #f)
        (yinz-ui-button "create" "Create agent"))
      (hash "help" "<Enter> open  <↓/Tab> next  <Esc> back")))
  (yinz-ui-set-status! widget json-null) widget)
(define dialog (new-dialog))
(define state (hash "duplicate" #f "source" "." "projects" (hash) "plugin-id" 0 "panel" #f
    "job" "new" "caller" #f "fork-source" "waiting" "context" #f "context-kind" #f
    "path-edited" #f "error" #f "note" #f "requested-size" #f "probe" 0))
(define (get key) (hash-ref state key))
(define (put key value) (set! state (hash-insert state key value)))
(define (text id) (yinz-ui-op dialog "TextValue" id))
(define (value id) (yinz-ui-value dialog id))
(define (field id) (yinz-ui-op dialog "FieldInfo" id))
(define (has-field id) (present (field id)))
(define (set-value id value) (when (has-field id) (yinz-ui-set-value! dialog id value)))
(define (project-values) (map (lambda (key) (hash-ref (get "projects") key)) (sort (hash-keys->list (get "projects")) string<?)))
(define (selected-project) (define index (and (has-field "project") (value "project"))) (and (present index) (> index 0) (nth (project-values) (- index 1))))
(define (project-for cwd) (define project (model "projects" "ForCwd" (get "projects") cwd)) (and (present project) project))
(define (source-directory) (at (selected-project) "root" (get "source")))
(define (fill-worktree)
  (put "path-edited" #f)
  (define project (or (selected-project) (project-for (get "source"))))
  (define path (at project "worktree_dir" #f))
  (set-value "path" (if (present path) path (hash-ref defaults "worktree_prefix"))))
(define (refresh-launch reset)
  (define kind (string-downcase (text "agent")))
  (for-each (lambda (entry) (define id (car entry))
      (when (has-field id) (yinz-ui-set-options! dialog id (agent-options (cadr entry) kind)) (when reset (set-value id 0))))
    '(("effort" "EffortOptions") ("permission_mode" "PermissionModes"))))
(define (refresh-agents)
  (define selected (text "agent"))
  (yinz-ui-set-options! dialog "agent" (map capitalized (launch "Offered")))
  (refresh-launch (not (equal? selected (text "agent")))))
(define (message name)
  (yinz-command (hash "MessageToPlugin" (hash "message_name" name "plugin_url" json-null "destination_plugin_id" json-null
        "plugin_config" (hash) "message_payload" json-null "message_args" (hash) "new_plugin_args" json-null "floating_pane_coordinates" json-null))))
(define (finish pane)
  (put "job" "new")
  (when pane
    (when (get "panel") (yinz-command (hash "HidePaneWithId" (get "panel"))))
    (define kind (car (hash-keys->list pane)))
    (yinz-command (hash (if (equal? kind "Terminal") "FocusTerminalPane" "FocusPluginPane") (list (hash-ref pane kind) #f #f))))
  (yinz-command "CloseSelf"))
(define (load-projects)
  (with-handler (lambda (failure) #f)
    (yinz-data-define-all "shared:yinz" (yinz-agent-model "store" "SharedDefs" json-null))
    (define request (hash-insert (yinz-agent-model "store" "EntityRequest" "project") "limit" (yinz-agent-model "store" "FetchLimit" json-null)))
    (put "projects" (model "projects" "FromRows" (yinz-data-fetch "shared:yinz" request)))))
(define (fill-projects)
  (define projects (project-values)) (define active (project-for (get "source")))
  (yinz-ui-set-options! dialog "project" (cons "(current directory)" (map (lambda (project) (hash-ref project "name")) projects)))
  (set-value "project" (if active (+ 1 (or (index-of (hash-ref active "name") (map (lambda (project) (hash-ref project "name")) projects)) -1)) 0))
  (fill-worktree))
(define (probe-git)
  (put "probe" (+ 1 (get "probe")))
  (define cwd (source-directory))
  (for-each (lambda (entry)
      (yinz-command (hash "RunCommand" (list (cadr entry) (hash) cwd (hash "git_probe" (car entry) "git_probe_id" (number->string (get "probe"))) json-null json-null))))
    '(("branches" ("git" "for-each-ref" "--format=%(refname:short)" "--sort=-committerdate" "--count=200" "refs/heads"))
      ("worktrees" ("git" "worktree" "list" "--porcelain")))))
(define (fork-dialog)
  (define widget (yinz-ui-dialog (color "Fork agent" 2) (list
        (yinz-ui-select "agent" "Agent" (map capitalized (launch "Offered")) 0) (yinz-ui-button "fork" "Fork agent"))
      (hash "help" "<Enter> open  <↓/Tab> next  <Esc> back")))
  (yinz-ui-set-status! widget json-null) widget)
(define (load configuration)
  (yinz-command (hash "Subscribe" '("AgentProvidersChanged")))
  (with-handler (lambda (failure) #f) (set! providers (yinz-command "GetAgentProviders")))
  (refresh-agents)
  (put "source" (at configuration "caller_cwd" "."))
  (put "plugin-id" (hash-ref (yinz-command "GetPluginIds") "plugin_id"))
  (put "duplicate" (equal? (at configuration "duplicate_focused" "") "true"))
  (define fork (equal? (at configuration "fork_focused" "") "true"))
  (define caller (string->number (at configuration "caller_terminal_pane_id" "")))
  (put "caller" (and caller (integer? caller) (>= caller 0) (<= caller 4294967295) caller))
  (cond [(and (get "caller") (get "duplicate")) (put "job" "duplicate")]
    [(and (get "caller") fork) (put "job" "fork")]
    [(get "duplicate") (put "note" "duplicate needs a focused agent pane")]
    [fork (put "note" "fork needs a focused agent pane")])
  (define stop #f)
  (if (get "duplicate")
    (when (get "note") (notify (get "note")) (finish #f) (set! stop #t))
    (begin (load-projects) (fill-projects)
      (when (hash-contains? configuration "initial_prompt")
        (set-value "prompt" (hash-ref configuration "initial_prompt")) (yinz-ui-input-op dialog "prompt" "SetCursorPosition" 0))))
  (unless stop
    (when (equal? (get "job") "fork") (set! dialog (fork-dialog)))
    (unless (equal? (get "job") "new") (message "agent_subscribe"))
    (yinz-command (hash "Subscribe" '("Key" "Mouse" "TabUpdate" "PastedText" "RunCommandResult" "Visible" "PaneUpdate")))
    (when (equal? (get "job") "new") (probe-git))
    ;; Duplicate mode declares no pane and runs headless, so it has no pane to configure.
    (unless (get "duplicate")
      (yinz-command (hash "SetSelectable" #t))
      (yinz-command (hash "RenamePluginPane" (list (get "plugin-id") (if (equal? (get "job") "fork") "fork agent" "new agent")))))))
(define (changed id)
  (put "error" (and (equal? (get "job") "fork") (equal? (get "fork-source") "missing") "the focused pane is not an agent"))
  (when (equal? id "path") (put "path-edited" #t))
  (when (equal? id "agent") (refresh-launch #t))
  (when (equal? id "project") (fill-worktree) (probe-git))
  (when (and (equal? id "create_branch") (not (value "create_branch"))) (set-value "worktree" #f))
  (when (and (equal? id "worktree") (value "worktree")) (set-value "create_branch" #t)))
(define (spec)
  (define branch (value "create_branch")) (define worktree (value "worktree"))
  (hash "kind" (text "agent") "command" json-null "args" '() "model" (text "model")
    "effort" (if (> (value "effort") 0) (text "effort") json-null)
    "permission_mode" (if (> (value "permission_mode") 0) (text "permission_mode") json-null)
    "prompt" (text "prompt") "branch" (if branch (text "branch") json-null) "base" (text "base")
    "worktree" (if branch worktree json-null) "worktree_dir" (if (and branch worktree) (text "path") json-null)
    "reuse" (value "reuse") "allow_outside_worktree" (or (not branch) (not worktree))
    "bubblewrap" #f "env" (hash) "resume" json-null "hooks" json-null "reuse_prompt" json-null))
(define (submit)
  (with-handler (lambda (failure) (put "error" (failure-text failure)) #t)
    (when (value "create_branch")
      (when (or (equal? (trim (text "branch")) "") (equal? (trim (text "base")) "")) (error "branch and base are required"))
      (when (and (value "worktree") (equal? (trim (text "path")) "")) (error "worktree directory is required")))
    (define request (spec)) (ok (launch "Plan" request))
    (when (and (not (get "path-edited")) (not (selected-project))) (set! request (hash-insert request "worktree_dir" json-null)))
    (define result (yinz-command (hash "SpawnAgent" (hash "spec" request "source_directory" (source-directory) "cwd" json-null "name" json-null "context" (hash) "start_suppressed" #f))))
    (finish (hash-ref result "pane_id")) #f))
(define (agent-cwd pane)
  (define cwd (at (at pane "agent" #f) "cwd" #f))
  (if (and (present cwd) (not (equal? cwd ""))) cwd (at pane "cwd" json-null)))
(define (context-command pane kind)
  (launch "CommandInContext" kind (agent-cwd pane) (ok (launch "Target" (at pane "host" json-null) (at pane "bubblewrap" json-null)))))
(define (start command)
  (define pane (yinz-command (hash "OpenCommandPaneNearPlugin" (list command (hash "agent_pane" "true" "agent_agent_host_cwd" "true")))))
  (if (present pane) pane (error "could not open a pane")))
(define (fork)
  (cond [(equal? (get "fork-source") "waiting") (put "error" "still reading the focused pane") #t]
    [(equal? (get "fork-source") "missing") (put "error" "the focused pane is not an agent") #t]
    [else (with-handler (lambda (failure) (put "error" (failure-text failure)) #t)
        (finish (start (ok (context-command (get "context") (string-downcase (text "agent")))))) #f)]))
(define (handle event)
  (if (get "duplicate") #f
    (let ([kind (hash-ref event "kind")])
      (cond [(equal? kind "buttonPressed") (if (equal? (get "job") "fork") (fork) (submit))]
        [(equal? kind "cancel") (finish #f) #f]
        [(equal? kind "fieldChanged") (changed (hash-ref event "id")) #t]
        [else (hash-ref event "shouldRender")]))))
(define (permission-help kind mode)
  (define provider (find (lambda (p) (equal? (hash-ref p "kind") (string-downcase kind))) providers))
  (or (at (at (at provider "launch" #f) "permission_descriptions" #f) mode #f)
    (cond [(and (equal? kind "Codex") (equal? mode "skip")) "Bypasses approvals AND sandbox"]
      [(and (equal? kind "Claude") (member mode '("skip" "bypassPermissions"))) "Bypasses all permission checks"]
      [(and (equal? kind "Cursor") (member mode '("skip" "force"))) "Allows commands without approval"]
      [(equal? kind "Codex") (at (hash "never" "No prompts; keeps sandbox setting" "full-auto" "Automatic mode with workspace sandbox"
            "untrusted" "Asks before any untrusted command" "on-request" "Agent decides when to ask for approval" "on-failure" "Asks after a sandboxed command fails") mode "Uses the agent's permission settings")]
      [(equal? kind "Claude") (at (hash "acceptEdits" "Auto-approves file edits" "dontAsk" "Denies actions that need approval" "plan" "Plans without making changes"
            "auto" "Automatic permission approval" "manual" "Requests manual permission approvals") mode "Uses the agent's permission settings")]
      [else "Uses the agent's permission settings"])))
(define (help)
  (define id (yinz-ui-focused-id dialog)) (define info (and (present id) (field id)))
  (cond [(not (present info)) "<Enter> create  <Tab> next  <Esc> back"]
    [(equal? (hash-ref info "kind") "select")
      (cond [(and (equal? id "permission_mode") (not (hash-ref info "open"))) (permission-help (text "agent") (text "permission_mode"))]
        [(hash-ref info "open") "<Enter> choose  <↑↓> move  <Esc> close"] [else "<Enter> open  <↓/Tab> next  <Esc> back"])]
    [(equal? (hash-ref info "kind") "combo")
      (cond [(hash-ref info "open") "<↑↓> pick  <Enter> use  <Esc> close"] [(hash-ref info "editing") "<Enter> done  <↓> list  <Tab> next"] [else "<Enter> edit  <↓/Tab> next  <Esc> back"])]
    [(equal? (hash-ref info "kind") "checkbox") "<Enter> toggle  <Tab> next  <Esc> back"]
    [(equal? (hash-ref info "kind") "radio_group") (if (hash-ref info "radio_active") "<Arrows> choose  <Enter/Esc> done" "<Enter> activate  <↓/Tab> next")]
    [(hash-ref info "editing") "<Enter> done  <Tab> next  <Esc> back"] [else "<Enter> edit  <↓/Tab> next  <Esc> back"]))
(define (lines text)
  (define pieces (split-many text "\n"))
  (if (and (not (null? pieces)) (equal? (car (reverse pieces)) "")) (reverse (cdr (reverse pieces))) pieces))
(define (prompt-cut? cols)
  (and (has-field "prompt")
    (let* ([input (text "prompt")] [label (string-append (hash-ref (field "prompt") "label") ": ")]
        [window (model "panel" "InputWindow" label input (yinz-ui-input-op dialog "prompt" "CursorPosition") (sat cols (if (> cols 4) 4 0)))])
      (or (> (length (lines input)) 1) (> (caddr window) 0) (< (string-length (car window)) (+ (string-length label) (string-length input)))))))
(define (status cols)
  (cond [(get "error") (color (get "error") 3)] [(get "note") (get "note")]
    [(prompt-cut? cols)
      (define prompt (text "prompt"))
      (define (count n noun) (string-append (number->string n) " " noun (if (= n 1) "" "s")))
      (string-append "prompt: " (count (length (lines prompt)) "line") ", " (count (string-length prompt) "char"))]
    [else json-null]))
(define (render rows cols)
  (if (get "duplicate") ""
    (begin (yinz-ui-op dialog "SetHelp" (help)) (yinz-ui-set-status! dialog (status cols))
      (yinz-ui-render dialog (yinz-ui-coordinates 0 0 cols rows)))))
(define (resize columns rows)
  (unless (get "duplicate")
    (define height (min (+ 2 (yinz-ui-height dialog)) rows))
    (define width (min 60 (quotient (+ columns 1) 2)))
    (define y (min (quotient rows 5) (sat rows height)))
    (define size (list width height y))
    (unless (equal? size (get "requested-size"))
      (yinz-command (hash "ChangeFloatingPanesCoordinates" (list (list (hash "Plugin" (get "plugin-id"))
              (hash "x" json-null "y" (hash "Fixed" y) "width" (if (= width 0) json-null (hash "Fixed" width))
                "height" (if (= height 0) json-null (hash "Fixed" height)) "pinned" json-null "borderless" json-null)))))
      (put "requested-size" size))))
(define (worktree-paths stdout)
  (map (lambda (line) (trim (substring line 9)))
    (filter (lambda (line) (and (>= (string-length line) 9) (equal? (substring line 0 9) "worktree ") (not (equal? (trim (substring line 9)) "")))) (lines stdout))))
(define (parent-path path)
  (define pieces (split-many path "/"))
  (define result (string-join (reverse (cdr (reverse pieces))) "/"))
  (if (equal? result "") "/" result))
(define (worktree-suggestions stdout)
  (define paths (worktree-paths stdout))
  (if (null? paths) '()
    (let ([primary (car paths)])
      (foldl (lambda (path found)
          (define parent (parent-path path))
          (define value (cond [(equal? parent primary) ""]
              [(and (> (string-length parent) (string-length primary)) (equal? (substring parent 0 (+ (string-length primary) 1)) (string-append primary "/"))) (substring parent (+ (string-length primary) 1))]
              [else parent]))
          (if (or (equal? value "") (member value found)) found (append found (list value)))) '() (cdr paths)))))
(define (finish-probe code stdout context)
  (define kind (at context "git_probe" #f))
  (cond [(or (not kind) (not (equal? (at context "git_probe_id" #f) (number->string (get "probe"))))
        (and (present code) (not (= code 0)))) #f]
    [(equal? kind "branches")
      (define options (filter (lambda (branch) (not (equal? branch ""))) (map trim (lines stdout))))
      (for-each (lambda (id) (when (has-field id) (yinz-ui-set-options! dialog id options))) '("base" "branch")) #t]
    [(equal? kind "worktrees")
      (when (and (not (get "path-edited")) (not (selected-project)))
        (define primary (nth (worktree-paths stdout) 0))
        (when primary (define project (or (project-for (get "source")) (project-for primary)))
          (define path (at project "worktree_dir" #f)) (when (present path) (set-value "path" path))))
      (when (has-field "path") (yinz-ui-set-options! dialog "path" (worktree-suggestions stdout))) #t]
    [else #f]))
(define (pane-id pane) (hash (if (hash-ref pane "is_plugin") "Plugin" "Terminal") (hash-ref pane "id")))
(define (pane-update manifest)
  (define groups (hash-ref manifest "panes"))
  (define own (hash "Plugin" (get "plugin-id")))
  (define tab (find (lambda (key) (find (lambda (pane) (equal? (pane-id pane) own)) (hash-ref groups key))) (hash-keys->list groups)))
  (when tab
    (define panel (find (lambda (pane)
          (at (at pane "pane_tabs" #f) "overlay_group" #f)) (hash-ref groups tab)))
    (put "panel" (and panel (at (at panel "pane_tabs" #f) "pane_id" (pane-id panel))))) #f)
(define (update event)
  (define name (car (hash-keys->list event))) (define value (hash-ref event name))
  (cond [(equal? name "AgentProvidersChanged") (set! providers value) (refresh-agents) #t]
    [(equal? name "PaneUpdate") (pane-update value)]
    [(equal? name "TabUpdate") (define active (or (find (lambda (tab) (hash-ref tab "active")) value) (nth value 0)))
      (when active (resize (hash-ref active "display_area_columns") (hash-ref active "viewport_rows"))) #f]
    [(equal? name "Key") (handle (yinz-ui-handle-key dialog value))]
    [(equal? name "Mouse") (handle (yinz-ui-handle-mouse dialog value))]
    [(equal? name "PastedText") (define result (yinz-ui-paste! dialog value))
      (if (equal? (hash-ref result "kind") "fieldChanged") (begin (changed (hash-ref result "id")) #t) #f)]
    [(equal? name "RunCommandResult") (finish-probe (car value) (yinz-decode-utf8 (cadr value)) (list-ref value 3))]
    [(and (equal? name "Visible") (not value) (not (get "duplicate"))) (finish #f) #f] [else #f]))
(define (source-pane reply id)
  (define panes (at reply "panes" json-null))
  (or (and (present panes) (find (lambda (pane) (= (hash-ref pane "pane_id") id)) panes))
    (let ([pane (yinz-command (hash "GetPaneInfo" (hash "Terminal" id)))])
      (and (present pane) (model "agents" "AgentPane" pane json-null)))))
(define (fork-note pane kind)
  (define cwd (agent-cwd pane))
  (define parts (and (present cwd) (filter (lambda (s) (not (equal? s ""))) (split-many cwd "/"))))
  (define folder (if (and parts (not (null? parts))) (car (reverse parts)) (if (present cwd) cwd "")))
  (define host (at pane "host" json-null))
  (string-append "forking " kind (if (equal? folder "") "" (string-append " in " folder)) (if (present host) (string-append " on " host) "")))
(define (pipe incoming)
  (define name (hash-ref incoming "name"))
  (cond [(equal? name "agent_hello") (unless (equal? (get "job") "new") (message "agent_subscribe")) #f]
    [(not (equal? name "agent_snapshot")) #f]
    [else
      (define reply (with-handler (lambda (failure) #f) (model "agents" "PollReply" (yinz-json-parse (hash-ref incoming "payload")))))
      (cond [(not reply) #f] [(equal? (get "job") "duplicate")
          (put "job" "new")
          (define pane (source-pane reply (get "caller")))
          (define classification (and pane (model "agents" "Classify" pane (hash-ref reply "manual_kinds"))))
          (define command (and (present classification) (with-handler (lambda (failure) #f) (ok (context-command pane (car classification))))))
          (if command
            (with-handler (lambda (failure) (notify (failure-text failure)) (finish #f)) (finish (start command)))
            (begin (notify "the focused pane is not an agent") (finish #f))) #f]
        [(and (equal? (get "job") "fork") (equal? (get "fork-source") "waiting"))
          (define pane (source-pane reply (get "caller")))
          (define classification (and pane (model "agents" "Classify" pane (hash-ref reply "manual_kinds"))))
          (if (present classification)
            (begin (put "fork-source" "ready") (put "context" pane) (put "context-kind" (car classification))
              (define other (find (lambda (kind) (not (equal? kind (car classification)))) (launch "BuiltinOffered")))
              (when other (define options (map capitalized (launch "Offered"))) (define index (index-of (capitalized other) options)) (when index (set-value "agent" index)))
              (put "note" (fork-note pane (car classification))))
            (begin (put "fork-source" "missing") (put "error" "the focused pane is not an agent"))) #t]
        [else #f])]))
