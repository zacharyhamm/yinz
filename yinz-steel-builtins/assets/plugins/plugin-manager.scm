(require "./bar/default-mode.scm" "./bar/style.scm")

(define plugins (hash))
(define matches '())
(define selected #f)
(define expanded '())
(define tabs (hash))
(define plugin-tabs (hash))
(define search "")
(define mode (bar-default-mode))
(define new? #f)
(define new-mode #f)
(define url "")
(define configuration '())
(define draft-key "")
(define draft-value "")
(define editing "url")
(define config-index #f)
(define requests '())
(define background? #f)

(define (get value key fallback)
  (if (and (hash? value) (hash-contains? value key)) (hash-ref value key) fallback))
(define (char-key? key text) (equal? (get key "bare_key" #f) (hash "Char" text)))
(define (plain? key) (null? (hash-ref key "key_modifiers")))
(define (ctrl? key text) (and (equal? (hash-ref key "key_modifiers") '("Ctrl")) (char-key? key text)))
(define (editing-config?) (member editing '("key" "value")))
(define (pop text) (substring text 0 (max 0 (- (string-length text) 1))))
(define (replace-at items index value)
  (map (lambda (i) (if (= i index) value (list-ref items i))) (range (length items))))
(define (ids) (sort (hash-keys->list plugins) (lambda (a b) (< (string->number a) (string->number b)))))
(define (searching?) (not (equal? search "")))
(define (visible-ids) (if (searching?) (map (lambda (match) (hash-ref match "id")) matches) (ids)))
(define (reset-selection) (set! selected #f) (set! expanded '()))
(define (refilter)
  (define ordered (list->vector (ids)))
  (set! matches (if (searching?)
      (map (lambda (match) (hash-insert match "id" (vector-ref ordered (hash-ref match "index"))))
        (yinz-ui-fuzzy-filter (map (lambda (id) (hash-ref (hash-ref plugins id) "location")) (ids)) search)) '())))
(define (selected-id)
  (define visible (visible-ids))
  (and selected (< selected (length visible)) (string->number (list-ref visible selected))))
(define (open-new)
  (set! new? #t) (set! new-mode mode) (set! url "") (set! configuration '())
  (set! draft-key "") (set! draft-value "") (set! editing "url")
  (set! config-index #f) (set! requests '()) (set! background? #f))
(define (accept-draft)
  (unless (and (equal? draft-key "") (equal? draft-value ""))
    (set! configuration (append configuration (list (list draft-key draft-value))))
    (set! draft-key "") (set! draft-value "")))
(define (edit-field transform)
  (cond ((equal? editing "url") (set! url (transform url)))
    ((editing-config?)
      (if config-index
        (let* ((pair (list-ref configuration config-index)) (index (if (equal? editing "key") 0 1)))
          (set! configuration (replace-at configuration config-index
              (replace-at pair index (transform (list-ref pair index))))))
        (if (equal? editing "key") (set! draft-key (transform draft-key)) (set! draft-value (transform draft-value)))))))
(define (request-file)
  (define alphabet "0123456789abcdef")
  (define digits (list->string (map (lambda (i) (string-ref alphabet (yinz-random-integer 16))) (range 32))))
  (define id (string-append (substring digits 0 8) "-" (substring digits 8 12) "-4" (substring digits 13 16)
      "-" (string (string-ref "89ab" (yinz-random-integer 4))) (substring digits 17 20) "-" (substring digits 20)))
  (set! requests (cons id requests))
  (yinz-command (hash "MessageToPlugin" (hash "plugin_url" "filepicker" "plugin_config" (hash "request_id" id)
        "message_name" "filepicker" "message_args" (hash "request_id" id)
        "new_plugin_args" (hash "pane_title" "Select a plugin file (.wasm, .ts, .mts, .js or .mjs) to load..." "should_focus" #t)))))
(define (new-key key)
  (define bare (hash-ref key "bare_key"))
  (cond
    ((and (plain? key) (get bare "Char" #f)) (edit-field (lambda (s) (string-append s (hash-ref bare "Char")))) #t)
    ((and (plain? key) (equal? bare "Backspace")) (edit-field pop) #t)
    ((and (plain? key) (equal? bare "Enter"))
      (if (editing-config?) (begin (accept-draft) (set! editing "url"))
        (begin (accept-draft)
          (yinz-command (hash "LoadNewPlugin" (hash "url" url "config"
                (foldl (lambda (pair result) (hash-insert result (car pair) (cadr pair))) (hash) configuration)
                "load_in_background" background? "skip_plugin_cache" #t)))
          (set! new? #f))) #t)
    ((and (plain? key) (equal? bare "Tab"))
      (cond ((equal? editing "url") (set! editing "key"))
        ((equal? editing "key") (set! editing "value"))
        ((equal? editing "value")
          (if config-index (set! editing "url") (begin (accept-draft) (set! editing "key")))
          (set! config-index #f))
        (config-index (set! editing "key"))
        (else (set! editing "url"))) #t)
    ((and (plain? key) (equal? bare "Esc"))
      (if (or (editing-config?) config-index)
        (begin (set! editing "url") (set! config-index #f) (accept-draft)) (set! new? #f)) #t)
    ((and (plain? key) (member bare '("Down" "Up")))
      (unless (editing-config?)
        (define maximum (max 0 (- (length configuration) 1)))
        (set! config-index
          (cond ((and (not config-index) (not (null? configuration))) (if (equal? bare "Down") 0 maximum))
            ((equal? config-index (if (equal? bare "Down") maximum 0)) #f)
            (config-index (max 0 (+ config-index (if (equal? bare "Down") 1 -1)))) (else #f)))) #t)
    ((and (plain? key) (equal? bare "Delete"))
      (if config-index
        (begin (set! configuration (map (lambda (i) (list-ref configuration i)) (filter (lambda (i) (not (= i config-index))) (range (length configuration)))))
          (set! config-index #f) #t) #f))
    ((ctrl? key "f") (request-file) #f)
    ((ctrl? key "l") (set! background? (not background?)) #t)
    (else #f)))
(define (main-key key)
  (define bare (hash-ref key "bare_key"))
  (define id (selected-id))
  (cond
    ((and (plain? key) (get bare "Char" #f)) (set! search (string-append search (hash-ref bare "Char"))) (refilter) (reset-selection) #t)
    ((and (plain? key) (equal? bare "Backspace")) (set! search (pop search)) (refilter) (reset-selection) #t)
    ((and (plain? key) (member bare '("Down" "Up")))
      ;; Preserve the original Up behavior, including its inverse empty-search count.
      (define count (if (equal? bare "Down") (length (visible-ids)) (if (searching?) (length (ids)) (length matches))))
      (define maximum (max 0 (- count 1)))
      (set! selected (cond ((not selected) (if (equal? bare "Down") 0 maximum))
          ((= selected (if (equal? bare "Down") maximum 0)) #f)
          (else (max 0 (+ selected (if (equal? bare "Down") 1 -1)))))) #t)
    ((and (plain? key) (equal? bare "Right")) (when selected (set! expanded (cons selected expanded))) #t)
    ((and (plain? key) (equal? bare "Left")) (set! expanded (filter (lambda (i) (not (equal? i selected))) expanded)) #t)
    ((and (plain? key) (equal? bare "Enter")) (when id (yinz-command (hash "FocusPluginPane" (list id #t #f)))) #f)
    ((and (plain? key) (equal? bare "Tab")) (when id (yinz-command (hash "ReloadPlugin" id))) #f)
    ((and (plain? key) (equal? bare "Delete")) (when id (yinz-command (hash "ClosePluginPane" id))) #f)
    ((ctrl? key "a") (open-new) #t)
    ((and (plain? key) (equal? bare "Esc"))
      (if (searching?) (begin (set! search "") (refilter) #t) (begin (yinz-command "CloseSelf") #f)))
    (else #f)))
(define (load configuration)
  (yinz-command (hash "Subscribe" '("ModeUpdate" "PaneUpdate" "TabUpdate" "Key" "SessionUpdate")))
  (yinz-command (hash "RenamePluginPane" (list (hash-ref (yinz-command "GetPluginIds") "plugin_id") "Plugin Manager"))))
(define (update event)
  (cond
    ((get event "ModeUpdate" #f) (set! mode (hash-ref event "ModeUpdate")) #t)
    ((get event "SessionUpdate" #f)
      (for-each (lambda (session)
          (when (hash-ref session "is_current_session")
            (unless (equal? plugins (hash-ref session "plugins"))
              (set! plugins (hash-ref session "plugins")) (reset-selection) (refilter))
            (for-each (lambda (tab) (set! tabs (hash-insert tabs (number->string (hash-ref tab "position")) (hash-ref tab "name"))))
              (hash-ref session "tabs")))) (car (hash-ref event "SessionUpdate"))) #t)
    ((get event "PaneUpdate" #f)
      (define manifest (hash-ref (hash-ref event "PaneUpdate") "panes"))
      (for-each (lambda (position)
          (for-each (lambda (pane)
              (define id (and (hash-ref pane "is_plugin") (hash-ref pane "id")))
              (when id (set! plugin-tabs (hash-insert plugin-tabs (number->string id) position)))) (hash-ref manifest position)))
        (hash-keys->list manifest)) #f)
    ((get event "Key" #f) ((if new? new-key main-key) (hash-ref event "Key")))
    (else #f)))
(define (pipe message)
  (if (equal? (get message "name" "") "filepicker_result")
    (begin
      (define id (get (get message "args" (hash)) "request_id" #f))
      (define payload (get message "payload" json-null))
      (when (and new? id (not (json-null? payload)) (member id requests))
        (set! requests (filter (lambda (request) (not (equal? request id))) requests))
        (set! url (string-append "file:" payload))) #t) #f))

(define (styled text selected ranges)
  (hash "text" text "selected" selected "levels"
    (map (lambda (level) (apply append (map (lambda (span)
              (range (min (string-length text) (cadr span)) (min (string-length text) (caddr span))))
            (filter (lambda (span) (= (car span) level)) ranges)))) '(0 1 2 3))))
(define (whole text level) (styled text #f (list (list level 0 (string-length text)))))
(define (at text x y . width) (yinz-ui-text text (yinz-ui-coordinates x y (if (null? width) json-null (car width)) json-null)))
(define (nested items x y . width) (yinz-ui-nested-list items (yinz-ui-coordinates x y (if (null? width) json-null (car width)) json-null)))
(define (truncate text maximum)
  (if (> (string-length text) maximum)
    (string-append "[...]" (substring text (min (string-length text) (+ (- (string-length text) maximum) 5)))) text))
(define (config-line key value width padding indent selected)
  (define room (max 0 (- width padding)))
  (define k (truncate key (quotient room 2)))
  (define v (truncate value (- room (quotient room 2))))
  (define text (string-append k ": " v))
  (list (styled text selected (list (list 0 0 (string-length k)) (list 1 (+ (string-length k) 2) (string-length text)))) indent))
(define (plugin-lines id index cols)
  (define info (hash-ref plugins id))
  (define location (hash-ref info "location"))
  (define text (truncate location (max 0 (- cols 3))))
  (define indices (if (searching?) (hash-ref (list-ref matches index) "indices") '()))
  (define removed (max 0 (- (string-length location) (max 0 (- cols 3)))))
  (define adjusted (if (= removed 0) indices (filter (lambda (i) (>= i 5)) (map (lambda (i) (max 0 (- i removed))) indices))))
  (define first (hash-insert (styled text (equal? selected index) (list (list 0 0 (string-length text)))) "levels"
      (list (range (string-length text)) '() '() (filter (lambda (i) (< i (string-length text))) adjusted))))
  (if (member index expanded)
    (let* ((tab-name (get tabs (get plugin-tabs id #f) "N/A"))
        (tab-text (string-append "Tab: " (truncate tab-name (max 0 (- cols 10)))))
        (config (hash-ref info "configuration")))
      (append (list first (list (styled tab-text #f '((2 0 4))) 1))
        (if (null? (hash-keys->list config)) '()
          (cons (list (whole "Configuration:" 2) 1)
            (map (lambda (key) (config-line key (hash-ref config key) cols 9 2 #f)) (sort (hash-keys->list config) string<?))))))
    (list first)))
(define (main-render rows cols)
  (define all '())
  (define anchor 0)
  (for-each (lambda (index)
      (when (equal? selected index) (set! anchor (length all)))
      (set! all (append all (plugin-lines (list-ref (visible-ids) index) index cols)))) (range (length (visible-ids))))
  (let* ((maximum (max 0 (- rows 4))) (overflow (> (length all) maximum))
      (start (if overflow (max 0 (- anchor (quotient maximum 2))) 0))
      (end (if overflow (max 0 (- (+ start maximum) 1)) (length all)))
      (shown (map (lambda (i) (list-ref all i)) (range start (min end (length all)))))
      (below (max 0 (- (length all) end)))
      (full "Help: <←↓↑→> - Navigate/Expand, <ENTER> - focus, <TAB> - Reload, <Del> - Close, <Ctrl a> - New, <ESC> - Exit")
      (medium "Help: <←↓↑→/ENTER> - Navigate, <TAB> - Reload, <Del> - Close, <Ctrl a> - New, <ESC> - Exit")
      (short "<←↓↑→/ENTER/TAB/Del> - Navigate/Expand/Reload/Close, <Ctrl a> - New, <ESC> - Exit"))
    (string-append
      (at (styled (string-append " SEARCH: " (truncate search (max 0 (- cols 10))) "_") #f (list '(3 9 1000000))) 0 0)
      (if (> start 0) (let ((s (string-append "↑ [+" (number->string start) "]"))) (at (whole s 1) (max 0 (- cols (string-length s))) 1)) "")
      (if (> below 0) (let ((s (string-append "↓ [+" (number->string below) "]"))) (at (whole s 1) (max 0 (- cols (string-length s))) (+ 2 (length shown)))) "")
      (nested shown 0 2 cols)
      (at (cond ((>= cols (string-length full)) (styled full #f '((3 5 12) (3 32 39) (3 49 54) (3 65 70) (3 80 88) (3 96 101))))
          ((>= cols (string-length medium)) (styled medium #f '((3 6 18) (3 31 36) (3 47 52) (3 62 70) (3 78 83))))
          (else (styled short #f '((3 0 22) (3 53 61) (3 69 74))))) 0 rows cols))))
(define (empty-label s) (if (equal? s "") "<EMPTY>" s))
(define (editing-line key value cols)
  (define room (max 0 (- cols 6)))
  (define k (truncate key (quotient room 2)))
  (define v (truncate value (- room (quotient room 2))))
  (if (equal? editing "key")
    (let ((text (string-append k "_: " (empty-label v))))
      (styled text #f (list (list 3 0 (+ (string-length k) 1)) (list 1 (+ (string-length k) 3) (string-length text)))))
    (let* ((k (empty-label k)) (text (string-append k ": " v "_")))
      (styled text #f (list (list 0 0 (string-length k)) (list 3 (+ (string-length k) 2) (string-length text)))))))
(define (new-render rows cols)
  (define max-items (max 0 (- rows 10)))
  (define items (map (lambda (i)
        (define pair (list-ref configuration i))
        (if (and (equal? i config-index) (editing-config?)) (editing-line (car pair) (cadr pair) cols)
          (car (config-line (empty-label (car pair)) (empty-label (cadr pair)) cols 5 0 (equal? i config-index)))))
      (range (min max-items (length configuration)))))
  (define shown (cond ((and (editing-config?) (not config-index)) (append items (list (editing-line draft-key draft-value cols))))
      ((null? items) (list (whole "<NO CONFIGURATION>" 0))) (else items)))
  (define more (max 0 (- (length configuration) max-items)))
  (define y (+ 7 (length shown)))
  (define url-text (string-append "Enter Plugin URL: " (truncate url (max 0 (- cols (if (equal? editing "url") 19 18))))
      (if (equal? editing "url") "_" "")))
  (define config-title (cond ((editing-config?) "Plugin Configuration: [Editing: <TAB> - Next, <ENTER> - Accept]")
      ((null? configuration) "Plugin Configuration: <TAB> - Edit")
      (else "Plugin Configuration: <TAB> - Edit, <↓↑> - Navigate, <Del> - Delete")))
  (string-append
    (at "LOAD NEW PLUGIN" (max 0 (- (quotient cols 2) 7)) 0)
    (at (styled url-text #f (list '(2 0 17) (list (if (equal? editing "url") 3 0) 18 (string-length url-text)))) 0 2)
    (nested (list (styled "<Ctrl f> - Load from Disk" #f '((3 0 9)))) 0 3)
    (at (styled config-title #f (append '((2 0 21))
          (cond ((editing-config?) '((3 32 37) (3 46 53))) ((null? configuration) '((3 22 27))) (else '((3 22 27) (3 36 40) (3 53 58)))))) 0 5)
    (nested shown 0 6 cols)
    (if (> more 0) (at (whole (string-append "[+" (number->string more) "]") 1) 0 (+ 6 (length shown))) "")
    (at (hash-insert (whole "Ctrl l" 3) "opaque" #t) 0 y)
    (string (integer->char 27)) "[" (number->string (+ y 1)) ";7H" (bar-fill new-mode) "\n"
    (yinz-ui-ribbon (hash "text" "Load in Background" "selected" background?) (yinz-ui-coordinates 7 y json-null json-null))
    (yinz-ui-ribbon (hash "text" "Load in Foreground" "selected" (not background?)) (yinz-ui-coordinates 29 y json-null json-null))
    (if (editing-config?) "" (at (styled "Help: <ENTER> - Accept and Load Plugin, <ESC> - Cancel" #f '((3 6 13) (3 40 45))) 0 rows))))
(define (render rows cols) ((if new? new-render main-render) rows cols))
