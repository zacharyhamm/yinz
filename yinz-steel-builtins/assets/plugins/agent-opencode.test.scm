(require "./testing/common.scm")
(test "OpenCode registers its Scheme provider and hook adapter" (lambda ()
    (t-load "./agent-opencode.scm" (hash "RegisterAgentProvider" '()))
    (assert-equal (length (test-commands)) 1)
    (define provider (hash-ref (car (test-commands)) "RegisterAgentProvider"))
    (define launch (hash-ref provider "launch"))
    (assert-equal (hash-ref launch "prompt_args") '("--prompt" "{value}"))
    (assert-equal (hash-ref launch "resume_args") '("--session" "{value}"))
    (assert-equal (hash-ref (hash-ref launch "permissions") "skip") '("--auto"))
    (assert (json-null? (t-get provider "input" json-null)) "status hooks alone do not establish prompt support")
    (define hook (hash-ref (car (hash-ref provider "hooks")) "content"))
    (for-each (lambda (text) (assert (string-contains? hook text))) '("JSON.stringify(toHookEvent(payload))" "AskUserQuestion" "__TOKEN_ENV__"))))
