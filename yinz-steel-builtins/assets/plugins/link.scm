(require "./file-finder/common.scm")
(define known '())
(define cwds (hash))
(define entries (hash))
(define environment (hash))
(define (load configuration)
  (yinz-command (hash "Subscribe" '("PaneUpdate" "HighlightClicked" "CwdChanged")))
  (yinz-command (hash "ChangeHostFolder" "/"))
  (set! environment (yinz-command "GetSessionEnvironmentVariables")))
(define (pane-key id) (yinz-json-string id))
(define (scan id cwd)
  (define listing (ff-safe (lambda () (yinz-command (hash "FsList" (hash "path" (ff-host-path cwd))))) '()))
  (set! entries (hash-insert entries (pane-key id)
      (if (> (length listing) 500) '() (map (lambda (entry) (ff-leaf (hash-ref entry "path"))) listing)))))
(define (escape-regex text)
  (apply string-append (map (lambda (c)
        (define character (string c))
        (if (member character '("\\" "." "+" "*" "?" "(" ")" "|" "[" "]" "{" "}" "^" "$"))
          (string-append "\\" character) character)) (string->list text))))
(define (highlights id)
  (define key (pane-key id))
  (define context (if (hash-contains? cwds key) (hash "cwd" (hash-ref cwds key)) (hash)))
  (define (highlight pattern)
    (hash "pattern" pattern "style" "None" "layer" "Hint" "context" context
      "on_hover" #t "bold" #f "italic" #t "underline" #t "tooltip_text" "Open"))
  (yinz-command (hash "SetPaneRegexHighlights" (list id
        (cons (highlight path-pattern)
          (map (lambda (entry) (highlight (string-append "(?:^|\\s)(" (escape-regex entry)
                  "(?:/[A-Za-z0-9_./\\-+@%,#=~!\\$\\{\\}\\[\\]]+)?(?::\\d+(?::\\d+)?)?)(?::|\\s|$)")))
            (ff-get entries key '())))))))
(define (pane-update manifest)
  (define current '())
  (for-each (lambda (panes)
      (for-each (lambda (pane)
          (unless (hash-ref pane "is_plugin")
            (define id (hash "Terminal" (hash-ref pane "id")))
            (unless (member id current) (set! current (cons id current))))) panes))
    (hash-values->list (hash-ref manifest "panes")))
  (for-each (lambda (id)
      (unless (member id known)
        (define cwd (ff-safe (lambda () (yinz-command (hash "GetPaneCwd" (hash "pane_id" id)))) #f))
        (when (ff-present? cwd) (scan id cwd) (set! cwds (hash-insert cwds (pane-key id) cwd)))
        (highlights id))) current)
  (for-each (lambda (id)
      (unless (member id current)
        (set! cwds (hash-remove cwds (pane-key id)))
        (set! entries (hash-remove entries (pane-key id))))) known)
  (set! known current))
(define (cwd-changed id cwd)
  (unless (equal? (ff-get cwds (pane-key id) #f) cwd)
    (set! cwds (hash-insert cwds (pane-key id) cwd))
    (scan id cwd)
    (yinz-command (hash "ClearPaneHighlights" id))
    (highlights id)))
(define (ascii-alpha? c)
  (define n (char->integer c))
  (or (and (>= n 65) (<= n 90)) (and (>= n 97) (<= n 122))))
(define (digit? c) (and (>= (char->integer c) 48) (<= (char->integer c) 57)))
(define (variable-start? c) (or (ascii-alpha? c) (equal? c #\_)))
(define (variable-rest? c) (or (variable-start? c) (digit? c)))
(define (char-at text i) (car (string->list (substring text i (+ i 1)))))
(define (expand-path path)
  (define tilde (if (and (hash-contains? environment "HOME")
        (or (equal? path "~") (starts-with? path "~/")))
      (string-append (hash-ref environment "HOME") (substring path 1 (string-length path))) path))
  (define length (string-length tilde))
  (let loop ((i 0) (result ""))
    (if (>= i length) result
      (let ((c (char-at tilde i)))
        (if (and (equal? c #\$) (< (+ i 1) length))
          (let* ((braced (equal? (char-at tilde (+ i 1)) #\{))
              (start (+ i (if braced 2 1)))
              (end (if braced
                  (let search ((j start))
                    (cond ((>= j length) #f) ((equal? (char-at tilde j) #\}) j) (else (search (+ j 1)))))
                  (and (variable-start? (char-at tilde start))
                    (let search ((j (+ start 1)))
                      (if (and (< j length) (variable-rest? (char-at tilde j))) (search (+ j 1)) j))))))
            (if end
              (let ((next (+ end (if braced 1 0))))
                (loop next (string-append result (ff-get environment (substring tilde start end) (substring tilde i next)))))
              (loop (+ i 1) (string-append result "$"))))
          (loop (+ i 1) (string-append result (string c))))))))
(define (path-and-line text)
  (let loop ((end (string-length text)) (line json-null))
    (define colon (let search ((i (- end 1)))
        (cond ((< i 0) #f) ((equal? (char-at text i) #\:) i) (else (search (- i 1))))))
    (define suffix (and colon (substring text (+ colon 1) end)))
    (if (and suffix (not (equal? suffix "")) (ff-all digit? (string->list suffix)))
      (let ((number (string->number suffix)))
        (loop colon (if (<= number 4294967295) number json-null)))
      (list (substring text 0 end) line))))
(define (clicked matched context)
  (define parsed (path-and-line matched))
  (define expanded (expand-path (trim (car parsed))))
  (define path (if (or (ff-absolute? expanded) (not (hash-contains? context "cwd"))) expanded
      (if (equal? (hash-ref context "cwd") "") expanded (ff-join (hash-ref context "cwd") expanded))))
  (define metadata (ff-safe (lambda ()
        (yinz-command (hash "FsMetadata" (hash "path" (ff-host-path path) "follow_symlinks" #t)))) json-null))
  (unless (json-null? metadata)
    (if (hash-ref metadata "is_dir")
      (yinz-command (hash "MessageToPlugin"
          (hash "plugin_url" "filepicker" "destination_plugin_id" json-null
            "plugin_config" (hash "caller_cwd" path) "message_name" "filepicker" "message_payload" json-null
            "message_args" (hash "open_directly" "true") "floating_pane_coordinates" json-null
            "new_plugin_args" (hash "should_float" json-null "pane_id_to_replace" json-null
              "pane_title" (string-append "Browse: " path) "cwd" path "skip_cache" #f "should_focus" #t))))
      (yinz-command (hash "OpenFileFloating"
          (list (hash "path" path "line_number" (cadr parsed) "cwd" json-null) json-null (hash)))))))
(define (update event)
  (cond
    ((hash-contains? event "PaneUpdate") (pane-update (hash-ref event "PaneUpdate")))
    ((hash-contains? event "CwdChanged")
      (define change (hash-ref event "CwdChanged")) (cwd-changed (car change) (cadr change)))
    ((hash-contains? event "HighlightClicked")
      (define click (hash-ref event "HighlightClicked")) (clicked (hash-ref click "matched_string") (hash-ref click "context"))))
  #f)
(define path-pattern "(?:^|\\s)((?:(?:\\./|\\.\\./|/)[A-Za-z0-9_./\\-+@%,#=~!\\$\\{\\}\\[\\]]+|~/[A-Za-z0-9_./\\-+@%,#=~!\\$\\{\\}\\[\\]]+|\\$\\{?[A-Za-z_][A-Za-z0-9_]*\\}?/[A-Za-z0-9_./\\-+@%,#=~!\\$\\{\\}\\[\\]]+)(?::\\d+(?::\\d+)?)?)(?::|\\s|$)")
