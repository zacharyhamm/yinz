(require "./state.scm")
(provide a-refresh-usage! a-usage-lines a-usage-summary a-usage-display)

(define (usage-target)
  (define agent (a-field (a-row) "Agent" #f))
  (define pane (and agent (a-find (lambda (pane) (equal? (hash-ref agent "pane_id") (hash-ref pane "pane_id")))
        (or (a-some (a-field (a-get "snapshot") "panes" #f)) '()))))
  (define classification (and pane (a-some (a-model "Classify"
          (list pane (a-field (a-get "snapshot") "manual_kinds" (hash)))))))
  (and classification (hash "provider" (car classification)
      "reason" (cond ((a-some (a-field pane "host" #f)) "Quota unavailable for SSH agents")
        ((a-some (a-field pane "bubblewrap" #f)) "Quota unavailable for isolated agents")
        (else #f)))))
(define (usage-visible?)
  (and (if (json-null? (a-get "usage_visible")) (a-get "pane_shown") (a-get "usage_visible"))
    (not (a-get "history_hidden"))))
(define (usage-entry provider) (a-field (a-get "usage_cache") provider (hash)))
(define (usage-put! provider entry)
  (a-set! "usage_cache" (hash-insert (a-get "usage_cache") provider entry)))
(define (usage-text value)
  (if (string? value) (string-join (split-whitespace (yinz-text-sanitize (string-replace value "\r" " "))) " ") ""))
(define (usage-valid? value provider)
  (and (hash? value) (equal? (a-field value "provider" #f) provider)
    (member (a-field value "status" #f) '("ok" "unavailable" "unsupported" "expired" "error"))
    (list? (a-field value "windows" #f))
    (or (not (equal? (hash-ref value "status") "ok")) (pair? (hash-ref value "windows")))
    (not (member #f (map (lambda (window)
            (and (string? (a-field window "label" #f)) (number? (a-field window "used_percent" #f))
              (>= (hash-ref window "used_percent") 0)
              (let ((reset (a-some (a-field window "resets_at_ms" #f)))) (or (not reset) (number? reset)))))
          (hash-ref value "windows"))))
    (let ((observed (a-some (a-field value "observed_at_ms" #f)))) (or (not observed) (number? observed)))))
(define (usage-finish! provider request response)
  (define pending (a-field (a-get "usage_pending") provider #f))
  (when (and pending (= request (hash-ref pending "request")))
    (a-set! "usage_pending" (hash-remove (a-get "usage_pending") provider))
    (define value (a-field response "usage" #f))
    (unless (usage-valid? value provider)
      (set! value (hash "status" "error" "message" "Could not read provider usage")))
    (define entry (usage-entry provider))
    (when (equal? (hash-ref value "status") "ok") (set! entry (hash-insert entry "observation" value)))
    (usage-put! provider (hash-insert entry "result" value))
    (define target (usage-target))
    (when (and (usage-visible?) target (not (hash-ref target "reason")) (equal? provider (hash-ref target "provider")))
      (yinz-request-render))))
(define (usage-start! provider)
  (a-inc! "usage_request")
  (define request (a-get "usage_request"))
  (define operation (yinz-agent-control (hash "Usage" (hash "provider" provider))))
  (define entry (usage-entry provider))
  (usage-put! provider (hash-insert (hash-insert entry "checked_at" (yinz-now-ms)) "checked_wall" (yinz-wall-clock-ms)))
  (a-set! "usage_pending" (hash-insert (a-get "usage_pending") provider
      (hash "request" request "operation" operation "deadline" (+ (yinz-now-ms) 30000))))
  (yinz-catch (yinz-then operation (lambda (response) (usage-finish! provider request response)))
    (lambda (_) (usage-finish! provider request #f))))
(define (a-refresh-usage! . force)
  (define changed #f)
  (if (not (usage-visible?)) #f
    (begin
      (for-each (lambda (provider)
          (define pending (hash-ref (a-get "usage_pending") provider))
          (when (>= (yinz-now-ms) (hash-ref pending "deadline"))
            (usage-finish! provider (hash-ref pending "request")
              (hash "usage" (hash "provider" provider "status" "error" "windows" '() "message" "Usage refresh timed out")))
            (yinz-cancel! (hash-ref pending "operation")) (set! changed #t)))
        (hash-keys->list (a-get "usage_pending")))
      (define target (usage-target))
      (when (and target (not (hash-ref target "reason")))
        (define provider (hash-ref target "provider"))
        (define checked (a-field (usage-entry provider) "checked_at" #f))
        (define refresh (and (pair? force) (car force)))
        (when (and (not (hash-contains? (a-get "usage_pending") provider))
            (or refresh (not checked) (>= (- (yinz-now-ms) checked) 60000)))
          (usage-start! provider) (set! changed #t)))))
  changed)
(define (usage-age milliseconds)
  (define minutes (quotient (inexact->exact (floor (max 0 milliseconds))) 60000))
  (cond ((= minutes 0) "now") ((< minutes 60) (string-append (number->string minutes) "m"))
    ((< minutes 1440) (string-append (number->string (quotient minutes 60)) "h"))
    (else (string-append (number->string (quotient minutes 1440)) "d"))))
(define (usage-window window)
  (define used (hash-ref window "used_percent"))
  (define reset (a-some (a-field window "resets_at_ms" #f)))
  (string-append (if (>= used 90) "! " "") (usage-text (hash-ref window "label")) ": "
    (number->string used) "% used"
    (if reset (if (<= reset (yinz-wall-clock-ms)) " · reset due"
        (if (< (- reset (yinz-wall-clock-ms)) 60000) " · resets <1m"
          (string-append " · resets in " (usage-age (- reset (yinz-wall-clock-ms)))))) " · reset unknown")))
(define (usage-stale? entry)
  (define observation (a-field entry "observation" #f))
  (define observed (a-some (a-field observation "observed_at_ms" #f)))
  (and observation (or (not (equal? (a-field (a-field entry "result" #f) "status" #f) "ok"))
      (and observed (>= (- (yinz-wall-clock-ms) observed) 120000)))))
(define (a-usage-summary)
  (define target (usage-target))
  (and target (or (hash-ref target "reason")
      (let* ((provider (hash-ref target "provider")) (entry (usage-entry provider))
          (windows (a-field (a-field entry "observation" #f) "windows" '()))
          (status (a-field (a-field entry "result" #f) "status" #f)))
        (string-append "Local " provider ": "
          (cond ((not (null? windows))
              (string-append "up to " (number->string (foldl (lambda (window used) (max used (hash-ref window "used_percent"))) 0 windows))
                "% used" (if (usage-stale? entry) " · stale" "")))
            ((hash-contains? (a-get "usage_pending") provider) "refreshing quota")
            ((equal? status "expired") "credentials expired")
            ((equal? status "error") "quota refresh failed")
            ((equal? status "unsupported") "provider quota is not supported")
            (else "quota unavailable")))))))
(define (a-usage-display)
  (define target (usage-target))
  (if (not target) #f
    (let* ((provider (hash-ref target "provider")) (reason (hash-ref target "reason"))
        (entry (usage-entry provider)) (observation (a-field entry "observation" #f))
        (result (a-field entry "result" #f)) (pending (hash-contains? (a-get "usage_pending") provider))
        (plan (usage-text (a-field observation "plan" #f)))
        (checked (a-field entry "checked_wall" #f))
        (observed (a-some (a-field observation "observed_at_ms" #f))))
      (cond (reason (hash "lines" (list reason) "summary" reason "windows" '() "featured" #f "freshness" ""))
        (else
          (define windows (a-field observation "windows" '()))
          (define stale (usage-stale? entry))
          (define status (cond (pending "Refreshing…")
              ((equal? (a-field result "status" #f) "expired") "Credentials expired")
              ((equal? (a-field result "status" #f) "error") "Refresh failed")
              ((equal? (a-field result "status" #f) "unsupported") "Unsupported")
              ((or (equal? (a-field result "status" #f) "unavailable") (null? windows)) "Unavailable")
              (else "")))
          (define message (if (or pending (equal? (a-field result "status" #f) "ok")) ""
              (usage-text (a-field result "message" #f))))
          (define heading (string-append "Local " provider " account" (if (equal? plan "") "" (string-append " · " plan))))
          (define freshness (string-append (if (equal? status "") "" (string-append status " · "))
              (if stale (string-append "Stale" (if observed (string-append " " (usage-age (- (yinz-wall-clock-ms) observed))) "") " · ") "")
              (if checked (string-append "checked " (usage-age (- (yinz-wall-clock-ms) checked))) "Not checked")))
          ; Strict comparison preserves provider order for equally used windows.
          (define featured (foldl (lambda (window best)
                (if (or (not best) (> (hash-ref window "used_percent") (hash-ref best "used_percent"))) window best)) #f windows))
          (define used (and featured (hash-ref featured "used_percent")))
          (define remaining (and used (max 0 (min 100 (- 100 used)))))
          (hash "heading" heading "windows" (map usage-window windows) "freshness" freshness
            "message" message "summary" (a-usage-summary) "featured" featured
            "value" (and used (inexact->exact (floor (+ used 0.5)))) "remaining" remaining
            "tone" (cond ((or stale (not remaining)) "neutral") ((> remaining 25) "success") ((>= remaining 10) "attention") (else "error"))
            "label" (and used (string-append (number->string (inexact->exact (floor (+ used 0.5)))) "% USED · " (usage-text (hash-ref featured "label"))))
            "lines" (append (list heading) (map usage-window windows) (list freshness)
              (if (equal? message "") '() (list message)))))))))
(define (a-usage-lines)
  (define display (a-usage-display))
  (if display (hash-ref display "lines") '()))
