(require "./state.scm")
(require "./history.scm")
(require "./hints.scm")
(require "./activity.scm")
(require "./usage.scm")
(provide a-draw!)
(define (styled text level)
  (hash "text" text "levels" (if level
      (map (lambda (i) (if (or (= i level) (= i 5)) (range (string-length text)) '())) (range (max 6 (+ level 1)))) '())))
(define paint-x 0)
(define (paint text row cols . height)
  ; History and Markdown share dim styles with other plugins; normalize them only here.
  (define levels (a-field text "levels" '()))
  (define dim (a-at levels 4))
  (when (and dim (not (null? dim)))
    (set! levels (append levels (map (lambda (_) '()) (range (max 0 (- 6 (length levels)))))))
    (set! text (hash-insert text "levels" (map (lambda (i)
            (cond ((= i 4) '()) ((= i 5) (append dim (list-ref levels i))) (else (list-ref levels i)))) (range (length levels))))))
  (display (yinz-ui-text (hash-insert text "opaque" #t) (hash "x" paint-x "y" row "width" cols "height" (if (null? height) 'json-null (car height))))))
(define (prefix line text cursor)
  (define levels (a-field line "levels" '()))
  (define shifted (map (lambda (indices) (map (lambda (i) (+ i (string-length text))) indices)) levels))
  (set! shifted (append shifted (map (lambda (_) '()) (range (max 0 (- 6 (length shifted)))))))
  (set! shifted (map (lambda (i) (append (if (or (= i 5) (and cursor (= i 1))) (range (string-length text)) '()) (list-ref shifted i))) (range (length shifted))))
  (hash "text" (string-append text (hash-ref line "text")) "levels" shifted))
(define (divider label above below focused failed row cols)
  (define decorated (if focused (if (equal? label "") "▸" (string-append "▸ " label))
      (if (equal? label "") "" (string-append "  " label))))
  (paint (styled (a-panel "Divider" (list decorated above below cols)) (if failed 6 1)) row cols))
(define (archive-kind kind)
  (define known (hash "codex" "CDX" "claude" "CLA" "opencode" "OPC" "gemini" "GEM"
      "cursor" "CUR" "qwen" "QWN" "aider" "AID" "cline" "CLI" "pi" "PIA" "muse" "MUS"))
  (a-field known kind (string-append (string-upcase (substring kind 0 (min 3 (string-length kind))))
      (make-string (a-sub 3 (string-length kind)) #\space))))
(define (columns cols)
  (define kind 0) (define worktree 0) (define age #t)
  (for-each (lambda (row) (define run (a-field row "Run" #f))
      (when run (set! kind (max kind 3))
        (set! worktree (max worktree (min 16 (yinz-text-width (hash-ref run "worktree"))))))) (a-get "rows"))
  (define (furniture) (+ (if age 4 0) (if (> kind 0) (+ kind 2) 0) (if (> worktree 0) (+ worktree 2) 0)))
  (define body (a-sub cols 4))
  (when (< (a-sub body (furniture)) 12) (set! worktree 0))
  (when (< (a-sub body (furniture)) 8) (set! age #f))
  (when (< (a-sub body (furniture)) 8) (set! kind 0))
  (hash "kind" kind "worktree" worktree "age" age "title" (a-sub body (furniture))))
(define (archive-row layout now run)
  (string-append (if (hash-ref layout "age") (a-panel "AgeGutter" (list now (hash-ref run "started_at_ms"))) "")
    (apply string-append (map (lambda (key)
          (define width (hash-ref layout key)) (define text (a-panel "Cut" (list (if (equal? key "kind") (archive-kind (hash-ref run key)) (hash-ref run key)) width)))
          (if (= width 0) "" (string-append text (make-string (+ (- width (yinz-text-width text)) 2) #\space)))) '("kind" "worktree")))
    (a-panel "Cut" (list (string-append (if (hash-ref run "continuation") "↳ " "") (hash-ref run "title")) (hash-ref layout "title")))))
(define (list-text row selected live layout now cols rich)
  (define marker (if selected ">" " "))
  (cond ((a-field row "Project" #f) (styled (hash-ref row "Project") #f))
    ((a-field row "Branch" #f) (styled (hash-ref row "Branch") 5))
    ((a-field row "Agent" #f)
      (define identity (hash-ref (hash-ref row "Agent") "text"))
      (define status-start (a-sub (string-length identity) 2))
      (define label (if rich (string-append " · " (a-agent-status row)) ""))
      (define text (styled (string-append (if selected (if live ">" "·") " ") " "
            (a-panel "Cut" (list (substring identity 0 status-start) (a-sub cols (+ 4 (yinz-text-width label)))))
            (substring identity status-start (string-length identity)) label) 5))
      (when (and (not selected) (a-waiting? row))
        (define end (string-length (hash-ref text "text")))
        (set! text (hash-insert text "levels" (list '() (range (- end (string-length label) 1) end) '() '() '() (range end)))))
      (hash-insert text "selected" selected))
    ((a-field row "Run" #f)
      (define text (styled (string-append marker "   " (archive-row layout now (hash-ref row "Run"))) 5))
      (when (and (not selected) (hash-ref layout "age"))
        (set! text (hash-insert text "levels" (list '() (range 4 8) '() '() '() (range (string-length (hash-ref text "text")))))))
      (hash-insert text "selected" selected))
    (else (hash-insert (styled (string-append marker "   load older runs…") (if selected 5 1)) "selected" selected))))
(define (list-activity row selected cols)
  (define info (a-agent-info row))
  (define activity (hash-ref info "activity"))
  (hash-insert (styled (string-append "    " (a-panel "Cut"
          (list (if (equal? activity "") "No activity reported" activity) (a-sub cols 4))))
      (if (and (not selected) (a-waiting? row)) 1 5)) "selected" selected))
(define (placeholder cols)
  (define error (a-get "run_error"))
  (cond ((< (a-sub cols 2) 20) "too narrow for history")
    ((equal? (a-row) "MoreRuns") "Enter loads older runs")
    ((and error (equal? (car error) (a-selection-key))) (string-append "history unavailable: " (cadr error)))
    ((a-selected-run)
      (if (and (a-get "run") (a-run-matches? (a-get "run"))) "no events recorded" "loading…"))
    ((and (a-get "history_desired") (not (a-get "run"))) "loading…")
    ((a-selection) "nothing to show yet") (else "select an agent")))
(define (detail-header cols)
  (define agent (a-field (a-row) "Agent" #f))
  (if (not agent) '()
    (let* ((key (number->string (hash-ref agent "pane_id"))) (info (a-agent-info (a-row)))
        (status (hash-ref info "status")) (activity (hash-ref info "activity"))
        (task (hash-ref info "task")) (tracking (hash-ref info "tracking"))
        (sample (a-field (a-field (a-get "snapshot") "activity" #f) key #f)))
      (when (and (equal? status "idle") sample (>= (* 5 (cadr sample)) 60))
        (set! status (string-append status " " (number->string (quotient (* 5 (cadr sample)) 60)) "m")))
      ; A long question or tool call wraps here, since the list row can only show its start.
      (define wrapped (if (equal? activity "") '() (a-panel "WrapWords" (list activity (a-sub cols 2)))))
      (define lines (append (list (string-append key " · " (hash-ref agent "kind") " · " status))
          (take wrapped (min 3 (length wrapped)))
          (if (or (equal? task "") (equal? task activity)) '() (list (string-append "Task: " task)))
          (list (string-append "State: " tracking (if (member tracking '("screen activity" "screen summary")) " (estimated)" "")))
          (a-usage-lines)))
      (map (lambda (line) (styled (a-panel "Cut" (list line (a-sub cols 2))) 5)) lines))))
(define (draw-history top rows cols)
  (a-fill-history! cols)
  (define history (a-history)) (define run-header (hash-ref history "header"))
  ; A short pane keeps the start of the agent's details rather than losing the whole header.
  (define details (detail-header cols))
  (define detail-rows (max 1 (a-sub rows (+ 3 (length run-header)))))
  (define quota (a-usage-summary))
  ; The default overlay only has room for one detail line beside the run header.
  (when (and quota (> (length details) detail-rows))
    (set! details (cons (styled (a-panel "Cut" (list quota (a-sub cols 2))) 5) details)))
  (define header (append (take details (min (length details) detail-rows)) run-header))
  (define wanted (if (null? header) 0 (+ 1 (length header))))
  (define header-rows (if (>= rows (+ wanted 2)) wanted 0))
  (define hint (a-divider-hint))
  (define refusal (if (and hint (equal? (car hint) "instead")) (a-panel "WrapWords" (list (cadr hint) (a-sub cols 2))) '()))
  (define refusal-rows (min (length refusal) (a-sub rows (+ header-rows 1))))
  (define room (a-sub rows (+ header-rows refusal-rows)))
  (define entries (hash-ref history "entries")) (define events (hash-ref history "events"))
  (define count (length entries)) (define measurable (and (> room 0) (not (null? events))))
  (when measurable (a-reanchor-history!))
  (define max-scroll (a-sub count room))
  (a-set! "last_history_max_scroll" max-scroll) (a-set! "last_history_body_rows" room)
  (a-set! "history_scroll" (min (a-get "history_scroll") max-scroll))
  (define stepped (equal? (a-get "focus") "history"))
  (define anchored (and (> room 0) (a-position-search-hit!)))
  (when measurable
    (a-set! "history_cursor" (min (a-get "history_cursor") (- (length events) 1)))
    (cond ((and stepped (a-get "history_scrolled") (not anchored))
        (define end (- count (a-get "history_scroll")))
        (define cursor (a-cursor-into-window (a-sub end room) end))
        (when cursor (a-set! "history_cursor" cursor) (a-set! "history_cursor_anchor" (a-cursor-anchor))))
      ((or stepped anchored)
        (define reveal (a-reveal-cursor room)) (when reveal (a-set! "history_scroll" (min reveal max-scroll)))))
    (when stepped (a-set! "history_scrolled" #f)))
  (define end (- count (a-get "history_scroll"))) (define start (a-sub end room))
  (when measurable (a-set! "history_bottom_anchor" (a-bottom-anchor end)))
  (a-set! "last_history_window_start" start) (a-set! "last_history_body_top" (+ header-rows refusal-rows))
  (define focused (and stepped (a-keys-here?)))
  (define cursor (and (or focused (a-selected-revision)) (a-field (a-cursor-event) "start" #f)))
  (define failed (a-find (lambda (error) (and error (equal? (car error) (a-selection-key))))
      (list (a-get "resume_note") (a-get "run_error"))))
  (divider (a-history-label) start (- count end) focused failed top cols)
  (define body (+ top 1))
  (when (> header-rows 0)
    (for-each (lambda (i) (paint (prefix (list-ref header i) " " #f) (+ body i) cols)) (range (length header)))
    (paint (styled (a-panel "Divider" (list "" 0 0 cols)) 5) (+ body (length header)) cols)
    (set! body (+ body header-rows)))
  (for-each (lambda (i) (paint (styled (string-append " " (list-ref refusal i)) (if failed 6 5)) (+ body i) cols)) (range refusal-rows))
  (set! body (+ body refusal-rows))
  (if (null? entries)
    (let* ((wrapped (a-panel "WrapWords" (list (placeholder cols) (a-sub cols 2))))
        (lines (take wrapped (min (length wrapped) (max room 1)))))
      (for-each (lambda (i) (paint (styled (string-append "  " (list-ref lines i)) (cond (failed 6) ((equal? (a-row) "MoreRuns") 1) (else 5))) (+ body i) cols)) (range (length lines))))
    (for-each (lambda (i)
        (define marked (equal? i cursor))
        (paint (prefix (list-ref entries i) (if marked ">" " ") marked) (+ body (- i start)) cols)) (range start end))))
(define (draw-reader rows cols)
  (define room (a-sub rows 1)) (a-set! "last_reader_rows" room)
  (a-fill-reader! cols)
  (when (a-reader "reveal") (a-reveal-fold!) (a-reader-set! "reveal" #f))
  (define lines (a-reader-lines)) (define count (length lines))
  (define max-scroll (a-sub count room)) (define scroll (min (a-reader "scroll") max-scroll))
  (define end (min (+ scroll room) count))
  (define start (a-at (a-reader-starts) (a-reader "cursor")))
  (define cursor (and start (max start scroll)))
  (divider (a-reader-label) scroll (- count end) (a-keys-here?) #f 0 cols)
  (for-each (lambda (i)
      (define marked (equal? i cursor))
      (paint (prefix (list-ref lines i) (if marked ">" " ") marked) (+ 1 (- i scroll)) cols)) (range scroll end))
  (a-set! "last_reader_max_scroll" max-scroll) (a-reader-set! "scroll" scroll))
(define (draw-sheet rows cols)
  (define lines (a-key-sheet-lines cols)) (define max-scroll (a-sub (length lines) rows))
  (define scroll (min (or (a-get "key_sheet_scroll") 0) max-scroll))
  (a-set! "last_sheet_rows" rows) (a-set! "last_sheet_max_scroll" max-scroll) (a-set! "key_sheet_scroll" scroll)
  (if (null? lines) (paint (styled " no keys listed for this tab" 5) 0 cols)
    (for-each (lambda (i) (define line (list-ref lines i))
        (paint (hash "text" (car line) "levels" (list '() (range (cadr line)) '() '() '() (range (string-length (car line))))) (- i scroll) cols)) (range scroll (min (length lines) (+ scroll rows))))))
(define (a-draw! rows cols)
  (set! paint-x 0)
  (a-set! "list_lines" '())
  (a-set! "last_divider_col" #f)
  (when (or (< cols 51) (a-get "reading") (a-get "key_sheet_scroll")) (a-set! "divider_drag" #f))
  (define client (hash-ref (yinz-command "GetPluginIds") "client_id"))
  (a-set! "tabs_focused" (if (member client (a-get "bar_focused")) #t #f))
  (a-set! "last_rows" rows) (a-set! "last_cols" cols) (a-set! "last_footer_row" #f) (a-set! "last_label_rows" 0)
  (define footer (a-footer)) (define body-rows (- rows (if footer 1 0)))
  (define cursor (and (not (equal? (a-get "has_keyboard") #f)) (not (a-get "key_sheet_scroll"))
      (a-get "search_editing") (not (a-get "reading")) (> body-rows 0) (> cols 0) (list (cadr (a-search-box cols)) 0)))
  (yinz-command (hash "ShowCursor" (a-none cursor)))
  (cond ((or (= rows 0) (= cols 0))
      (for-each (lambda (key) (a-set! key 0)) '("last_window_start" "last_list_rows" "last_list_max_scroll" "last_history_rows" "last_history_body_rows" "last_history_max_scroll" "last_reader_rows" "last_reader_max_scroll")))
    (else
      ; Empty rows need the semantic background too, including after a theme change.
      (for-each (lambda (row) (paint (styled "" #f) row cols)) (range rows))
      (when footer (a-set! "last_footer_row" (- rows 1)) (paint (styled footer 1) (- rows 1) cols 1))
      (when (> body-rows 0)
        (cond ((a-get "key_sheet_scroll") (draw-sheet body-rows cols))
          ((a-get "reading") (draw-reader body-rows cols))
          (else
            (define label (a-view-label)) (define top 0)
            (when label
              (paint (styled label #f) 0 cols)
              (define failures (a-search-failure cols))
              (define failure (take failures (min (length failures) (min 3 (a-sub body-rows 2)))))
              (for-each (lambda (i) (paint (styled (list-ref failure i) 6) (+ i 1) cols)) (range (length failure)))
              (set! top (+ 1 (length failure))))
            (a-set! "last_label_rows" top)
            (define room (- body-rows top))
            (cond ((<= room 0)
                (for-each (lambda (key) (a-set! key 0)) '("last_window_start" "last_list_rows" "last_list_max_scroll" "last_history_rows" "last_history_body_rows" "last_history_max_scroll"))
                (a-set! "focus" "list"))
              ((null? (a-get "rows"))
                (a-set! "list_scroll" #f)
                (for-each (lambda (key) (a-set! key 0)) '("last_window_start" "last_list_rows" "last_list_max_scroll" "last_history_rows" "last_history_body_rows" "last_history_max_scroll"))
                (a-set! "focus" "list")
                (define messages (cond ((a-get "search_base") '("no matches"))
                    ((a-get "waiting_base") '("no agents waiting for you" "w shows every agent"))
                    ((not (a-get "strip_seen")) '("waiting for agent…")) (else '("no agents" "Ctrl e n starts one"))))
                (for-each (lambda (i) (paint (styled (list-ref messages i) (if (= i 0) 5 1)) (+ top i) cols)) (range (min room (length messages)))))
              (else
                (define split (and (>= cols 51) (>= room 3)))
                (define list-cols (if split (min (- cols 31) (max 20 (exact (floor (* cols (a-get "split_ratio")))))) cols))
                (define history-cols (if split (- cols list-cols 1) cols))
                (define history-rows (if split (- room 1) (quotient room 2)))
                (define list-rows (if split room (a-sub room (+ history-rows 1))))
                (when (and (not split) (or (< list-rows 3) (< history-rows 2))) (set! list-rows room) (set! history-rows 0))
                (when split (a-set! "last_divider_col" list-cols))
                (a-set! "last_history_top" (if split 0 list-rows))
                (define rich (and (>= rows 8) (>= list-cols 24)))
                (unless (equal? rich (a-get "list_rich")) (a-set! "list_scroll" #f))
                (a-set! "list_rich" rich)
                (define lines (let loop ((remaining (a-get "rows")) (i 0) (lines '()))
                    (if (null? remaining) (reverse lines)
                      (loop (cdr remaining) (+ i 1)
                        (if (and rich (a-field (car remaining) "Agent" #f))
                          (cons (list i #t) (cons (list i #f) lines)) (cons (list i #f) lines))))))
                (a-set! "list_lines" lines)
                (define count (length lines))
                (define selected-line (or (a-index (lambda (line) (= (car line) (a-get "selected"))) lines) 0))
                ; A centered window never opens on an activity line cut off from its agent. The
                ; selected agent's own lines stay visible, since that orphan lies above them. The
                ; furthest window obeys the same rule, so a click that pins the window, or a wheel
                ; scroll, keeps the lines where the centered window drew them.
                (define limit (a-sub count list-rows))
                (define bottom (if (and (< (+ limit 1) count) (cadr (list-ref lines limit))) (+ limit 1) limit))
                (define start (min (or (a-get "list_scroll") (a-sub selected-line (quotient list-rows 2))) bottom))
                (when (and (not (a-get "list_scroll")) (cadr (list-ref lines start))) (set! start (+ start 1)))
                (when (a-get "list_scroll") (a-set! "list_scroll" start))
                (a-set! "last_window_start" start) (a-set! "last_list_rows" list-rows) (a-set! "last_list_max_scroll" bottom)
                (define layout (columns list-cols)) (define now (yinz-wall-clock-ms))
                (for-each (lambda (i)
                    (define line (list-ref lines i)) (define index (car line))
                    (define row (list-ref (a-get "rows") index)) (define selected (= index (a-get "selected")))
                    (paint (if (cadr line) (list-activity row selected list-cols)
                        (list-text row selected (a-live?) layout now list-cols rich)) (+ top (- i start)) list-cols)) (range start (min count (+ start list-rows))))
                (a-set! "last_history_rows" history-rows)
                (if (= history-rows 0)
                  (begin (a-set! "focus" "list") (a-set! "last_history_max_scroll" 0) (a-set! "last_history_body_rows" 0))
                  (begin
                    (when split
                      (set! paint-x list-cols)
                      (for-each (lambda (row) (paint (styled "│" 5) row 1)) (range top (+ top room)))
                      (set! paint-x (+ list-cols 1)))
                    (draw-history (+ top (a-get "last_history_top")) history-rows history-cols)
                    (set! paint-x 0)))))))))))
