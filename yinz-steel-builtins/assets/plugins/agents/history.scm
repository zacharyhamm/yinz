(require "./state.scm")
(require "./overlay.scm")
(provide a-history a-fill-history! a-run-matches? a-cursor-event a-scroll-history! a-step-history!
  a-event-at-row a-history-page a-open-reader! a-read-key! a-reader a-reader-set!
  a-fill-reader! a-reader-lines a-reader-starts a-reader-label a-reveal-fold!
  a-scroll-reader! a-fold-at a-toggle-fold! a-open-target a-copy-event! a-open-file!
  a-divider-hint a-history-label a-shows-age? a-reanchor-history! a-bottom-anchor
  a-cursor-anchor a-cursor-into-window a-reveal-cursor a-position-search-hit!
  a-reader-page a-folding? a-event-end a-blank-history)
(define a-blank-history (hash "label" "" "entries" '() "events" '() "header" '()))
(define (a-history) (a-field (a-get "history_cache") "lines" a-blank-history))
(define (a-run-matches? run)
  (or (and (a-selection) (= (a-selection) (hash-ref run "pane_id")) (not (hash-ref run "ended")))
    (and (a-selected-run) (equal? (a-selected-run) (hash-ref run "id")))))
(define (a-fill-history! width)
  (define run (a-get "run"))
  (define matches (and run (a-run-matches? run)))
  (define now (yinz-wall-clock-ms))
  (define key (list (a-selection-key) width (if matches (list "run" (a-get "run_revision")) (list "strip" (a-get "generation"))) (quotient now 60000)))
  (unless (equal? key (a-field (a-get "history_cache") "key" #f))
    (define agent (a-field (a-row) "Agent" #f))
    (define summary (and agent (a-field (a-get "summaries") (number->string (hash-ref agent "pane_id")) #f)))
    (define lines (cond
        (matches (yinz-history-call (hash-ref run "parsed") "Lines" (list width now (a-get "run_offset_secs"))))
        (summary (yinz-agent-model "history" "Summary" (list (hash-ref agent "pane_id") (hash-ref agent "kind") summary (hash-ref agent "waiting") width now)))
        (else a-blank-history)))
    (a-set! "history_cache" (hash "key" key "lines" lines))))
(define (a-event-end event) (+ (hash-ref event "start") (hash-ref event "len")))
(define (a-cursor-event)
  (define events (hash-ref (a-history) "events"))
  (a-at events (- (length events) (a-get "history_cursor") 1)))
(define (a-cursor-anchor)
  (and (> (a-get "history_cursor") 0) (a-cursor-event) (list (hash-ref (a-cursor-event) "revision"))))
(define (a-event-at-row row)
  (define events (hash-ref (a-history) "events"))
  (define at (a-index (lambda (event) (and (<= (hash-ref event "start") row) (> (a-event-end event) row))) events))
  (and at (- (length events) at 1)))
(define (a-bottom-anchor end)
  (define row (- end 1))
  (define cursor (and (> (a-get "history_scroll") 0) (> end 0) (a-event-at-row row)))
  (and cursor (let* ((events (hash-ref (a-history) "events")) (event (list-ref events (- (length events) cursor 1))))
      (list (hash-ref event "revision") (- row (hash-ref event "start"))))))
(define (a-reanchor-history!)
  (define events (hash-ref (a-history) "events"))
  (define cursor (a-get "history_cursor_anchor"))
  (when cursor
    (define at (a-index (lambda (event) (equal? (hash-ref event "revision") (car cursor))) (reverse events)))
    (if at (a-set! "history_cursor" at) (a-set! "history_cursor_anchor" #f)))
  (define bottom (a-get "history_bottom_anchor"))
  (when bottom
    (define event (a-find (lambda (event) (equal? (hash-ref event "revision") (car bottom))) events))
    (if event (a-set! "history_scroll" (a-sub (length (hash-ref (a-history) "entries"))
          (+ 1 (hash-ref event "start") (min (cadr bottom) (a-sub (hash-ref event "len") 1)))))
      (a-set! "history_bottom_anchor" #f))))
(define (a-cursor-into-window start end)
  (define event (a-cursor-event))
  (define events (hash-ref (a-history) "events"))
  (and event (not (and (>= (hash-ref event "start") start) (<= (a-event-end event) end)))
    (let* ((inside (filter (lambda (i) (define e (list-ref events i))
              (and (>= (hash-ref e "start") start) (<= (a-event-end e) end))) (range (length events))))
        (after (> (a-event-end event) end)))
      (if (null? inside) (a-event-at-row (if after (- end 1) start))
        (- (length events) (if after (car (reverse inside)) (car inside)) 1)))))
(define (a-reveal-cursor room)
  (define event (a-cursor-event))
  (and event (let* ((count (length (hash-ref (a-history) "entries"))) (old (a-get "history_scroll"))
        (scroll (if (< (a-sub count old) (a-event-end event)) (a-sub count (a-event-end event)) old))
        (oldest (= (+ (a-get "history_cursor") 1) (length (hash-ref (a-history) "events"))))
        (head (if (and oldest (< (hash-ref event "start") room)) 0 (hash-ref event "start"))))
      (when (< (+ head room) (a-sub count scroll)) (set! scroll (a-sub count (+ head room))))
      (and (not (= old scroll)) scroll))))
(define (a-position-search-hit!)
  (define revision (a-get "pending_history_revision"))
  (define events (hash-ref (a-history) "events"))
  (define at (and revision (a-index (lambda (event) (equal? revision (hash-ref event "revision"))) (reverse events))))
  (when at
    (a-set! "history_cursor" at) (a-set! "history_cursor_anchor" (list revision))
    (a-set! "pending_history_revision" #f))
  (if at #t #f))
(define (a-history-page) (max 1 (a-sub (a-get "last_history_body_rows") 1)))
(define (a-scroll-history! delta)
  (define old (a-get "history_scroll"))
  (define target (if (>= delta 0) (min (+ old delta) (a-get "last_history_max_scroll")) (max 0 (+ old delta))))
  (a-set! "history_scroll" target)
  (unless (= old target) (a-set! "history_scrolled" #t) (a-set! "history_bottom_anchor" #f))
  (not (= old target)))
(define (a-step-history! delta)
  (define old (a-get "history_cursor"))
  (define target (if (>= delta 0) (min (+ old delta) (a-sub (length (hash-ref (a-history) "events")) 1)) (max 0 (+ old delta))))
  (a-set! "history_cursor" target) (a-set! "history_scrolled" #f) (a-set! "history_cursor_anchor" (a-cursor-anchor))
  (not (= old target)))
(define (a-reader key) (hash-ref (a-get "reading") key))
(define (a-reader-set! key value) (a-set! "reading" (hash-insert (a-get "reading") key value)))
(define (event-document event)
  (define key (list (a-get "run_revision") (hash-ref event "revision")))
  (define cached (a-get "prompt_document"))
  (if (equal? key (a-field cached "key" #f)) (hash-ref cached "document")
    (let ((doc (yinz-document-create (hash-ref event "kind") (hash-ref event "text"))))
      (when (equal? (hash-ref event "kind") "prompt")
        (a-set! "prompt_document" (hash "key" key "document" doc
            "sections" (yinz-document-call doc "Sections" 'json-null)))) doc)))
(define (a-open-reader!)
  (define event (a-cursor-event))
  (if (not event) #f
    (begin
      (define doc (event-document event))
      (define sections (if (equal? (hash-ref event "kind") "prompt")
          (hash-ref (a-get "prompt_document") "sections") '()))
      (a-inc! "reading_id")
      (a-set! "reading" (hash "kind" (hash-ref event "kind") "created_at_ms" (hash-ref event "created_at_ms")
          "text" (hash-ref event "text") "scroll" 0 "id" (a-get "reading_id") "sections" sections
          "document" doc "raw" #f "cursor" 0 "fold" 0 "reveal" #f
          "envelope" (and (not (null? sections)) (a-some (yinz-agent-model "history" "EnvelopeTag" (hash-ref event "text")))))) #t)))
(define (a-fill-reader! width)
  (when (a-get "reading")
    (define key (list (a-reader "id") (a-reader "fold") width))
    (unless (equal? key (a-field (a-get "reader_cache") "key" #f))
      (a-set! "reader_cache" (hash "key" key "lines" (yinz-document-call (a-reader "document") "Wrap"
            (list (a-sub width 2) (a-reader "raw") (map (lambda (section) (hash-ref section "open")) (a-reader "sections")))))))))
(define (a-reader-lines) (a-field (a-field (a-get "reader_cache") "lines" #f) "lines" '()))
(define (a-reader-starts) (a-field (a-field (a-get "reader_cache") "lines" #f) "starts" '()))
(define (a-reader-label)
  (define label (string-append (a-reader "kind") (if (a-reader "raw") " · source" "")
      (if (a-reader "envelope") (string-append " · " (a-reader "envelope")) "")
      (if (a-some (a-reader "created_at_ms")) (string-append " · " (a-panel "ShortAge" (list (yinz-wall-clock-ms) (a-reader "created_at_ms")))) "")))
  (if (a-get "open_note") (string-append (a-get "open_note") " · " label) label))
(define (a-reveal-fold!)
  (define starts (a-reader-starts))
  (define start (a-at starts (a-reader "cursor")))
  (when start
    (define end (or (a-at starts (+ (a-reader "cursor") 1)) (length (a-reader-lines))))
    (define scroll (a-reader "scroll"))
    (when (> end (+ scroll (a-get "last_reader_rows"))) (set! scroll (a-sub end (a-get "last_reader_rows"))))
    (a-reader-set! "scroll" (min start scroll))))
(define (a-fold-at row)
  (define starts (a-reader-starts))
  (and (not (null? starts)) (a-sub (length (filter (lambda (start) (<= start row)) starts)) 1)))
(define (a-reader-page) (max 1 (a-sub (a-get "last_reader_rows") 1)))
(define (a-scroll-reader! delta)
  (if (not (a-get "reading")) #f
    (let* ((old (a-reader "scroll")) (target (if (>= delta 0) (min (+ old delta) (a-get "last_reader_max_scroll")) (max 0 (+ old delta)))))
      (if (= old target) #f
        (begin (a-reader-set! "scroll" target)
          (define cursor (a-fold-at target)) (when cursor (a-reader-set! "cursor" cursor)) #t)))))
(define (a-folding?) (and (a-get "reading") (not (a-reader "raw")) (not (null? (a-reader "sections")))))
(define (step-fold! delta)
  (define old (a-reader "cursor"))
  (define target (if (>= delta 0) (min (+ old delta) (a-sub (length (a-reader "sections")) 1)) (max 0 (+ old delta))))
  (unless (= old target) (a-reader-set! "cursor" target) (a-reader-set! "reveal" #t)) (not (= old target)))
(define (a-toggle-fold!)
  (define section (and (a-get "reading") (a-at (a-reader "sections") (a-reader "cursor"))))
  (if (or (not section) (<= (hash-ref section "lines") 1)) #f
    (begin
      (a-reader-set! "sections" (map (lambda (i) (define value (list-ref (a-reader "sections") i))
            (if (= i (a-reader "cursor")) (hash-insert value "open" (not (hash-ref value "open"))) value)) (range (length (a-reader "sections")))))
      (a-reader-set! "fold" (+ (a-reader "fold") 1)) (a-reader-set! "reveal" #t) #t)))
(define (toggle-raw!)
  (if (null? (a-reader "sections")) #f
    (begin (a-reader-set! "raw" (not (a-reader "raw"))) (a-reader-set! "fold" (+ (a-reader "fold") 1))
      (a-reader-set! "scroll" 0) (a-reader-set! "cursor" 0) #t)))
(define (named-path)
  (define (first-path sections) (a-some (a-field (a-find (lambda (section) (a-some (hash-ref section "path"))) sections) "path" 'json-null)))
  (cond ((a-get "reading")
      (if (a-reader "raw") (first-path (a-reader "sections"))
        (a-some (a-field (a-at (a-reader "sections") (a-reader "cursor")) "path" 'json-null))))
    ((a-cursor-event)
      (define event (a-cursor-event))
      (and (equal? (hash-ref event "kind") "prompt")
        (begin (event-document event) (first-path (hash-ref (a-get "prompt_document") "sections")))))
    (else #f)))
(define (a-open-target)
  (define run (a-get "run"))
  (define path (and (not (a-some (a-field run "host" 'json-null))) (named-path)))
  (and path (if (starts-with? path "/") path
      (let ((cwd (a-some (a-field run "cwd" 'json-null))))
        (and cwd (string-append (let loop ((text cwd))
              (if (ends-with? text "/") (loop (substring text 0 (- (string-length text) 1))) text)) "/" path))))))
(define (a-open-file!)
  (define path (a-open-target))
  (if path
    (begin (a-hide!) (a-call (hash "OpenFileFloating" (list
            (hash "path" path "line_number" 'json-null "cwd" 'json-null) 'json-null (hash))) #f) #f)
    (begin
      (define host (and (named-path) (a-some (a-field (a-get "run") "host" 'json-null))))
      (a-set! "open_note" (if host (string-append "file is on " host) "no file named here")) #t)))
(define (a-copy-event!)
  (define section (and (a-get "reading") (not (a-reader "raw")) (a-at (a-reader "sections") (a-reader "cursor"))))
  (define text (cond (section (hash-ref section "text")) ((a-get "reading") (a-reader "text")) (else (a-field (a-cursor-event) "text" #f))))
  (if (not text) #f
    (begin (a-set! "open_note" (if section (string-append "copied " (hash-ref section "name") " · v then y copies the whole event") "copied the whole event"))
      (a-call (hash "CopyToClipboard" text) #f) #t)))
(define (a-read-key! key)
  (define bare (hash-ref key "bare_key")) (define char (a-char key))
  (define plain (null? (hash-ref key "key_modifiers")))
  (cond ((and plain (a-folding?) (equal? char "k")) (step-fold! -1))
    ((and plain (a-folding?) (equal? char "j")) (step-fold! 1))
    ((and plain (a-folding?) (equal? bare "Enter")) (a-toggle-fold!))
    ((and plain (equal? char "o")) (a-open-file!))
    ((and plain (equal? char "v")) (toggle-raw!))
    ((and plain (equal? char "y")) (a-copy-event!))
    ((equal? bare "Esc") (a-close-reader!))
    ((or (equal? bare "Up") (and plain (equal? char "k"))) (a-scroll-reader! -1))
    ((or (equal? bare "Down") (and plain (equal? char "j"))) (a-scroll-reader! 1))
    ((equal? bare "PageUp") (a-scroll-reader! (- (a-reader-page))))
    ((equal? bare "PageDown") (a-scroll-reader! (a-reader-page))) (else #f)))
(define (a-divider-hint)
  (define selection (a-selection-key)) (define note (a-get "resume_note")) (define ask (a-get "summarizing"))
  (define failure (a-get "run_error"))
  (and selection (cond
      ((equal? selection (a-get "confirming_resume")) '("before" "resume? y/n"))
      ((and note (equal? (car note) selection)) (list "instead" (string-append "resume failed: " (cadr note))))
      ((and failure (equal? (car failure) selection) (a-get "run"))
        (list "instead" (string-append "history unavailable: " (cadr failure))))
      ((a-get "open_note") (list "before" (a-get "open_note")))
      ((and ask (equal? (hash-ref ask "row") selection))
        (if (hash-ref ask "stale") '("instead" "no new summary · s to try again") '("beside" "summarising…")))
      ((and (a-get "waiting_base") (a-field (a-row) "Agent" #f) (not (a-waiting? (a-row)))) '("beside" "no longer waiting"))
      (else #f))))
(define (a-history-label)
  (define label (hash-ref (a-history) "label")) (define hint (a-divider-hint))
  (cond ((not hint) label) ((or (equal? (car hint) "instead") (equal? label "")) (cadr hint))
    ((equal? (car hint) "before") (string-append (cadr hint) " · " label))
    (else (string-append label " · " (cadr hint)))))
(define (a-shows-age?)
  (cond ((a-get "reading") (if (a-some (a-reader "created_at_ms")) #t #f))
    ((and (a-get "search_base") (a-get "searched_at_ms") (not (a-get "search_editing"))) #t)
    ((a-find (lambda (row) (a-some (a-field (a-field row "Run" #f) "started_at_ms" 'json-null))) (a-get "rows")) #t)
    ((and (a-get "run") (a-run-matches? (a-get "run"))) (hash-ref (a-get "run") "stamped"))
    (else (if (and (a-selection) (a-some (a-field (a-field (a-get "summaries") (number->string (a-selection)) #f) "created_at_ms" 'json-null))) #t #f))))
