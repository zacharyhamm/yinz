(require "./state.scm" "../shared/agent-status.scm")
(provide a-prompt-text a-prompt-key! a-prompt-paste!)
(define (draft-key) (list (a-get "own_client_id") (a-selection)))
(define (a-prompt-text . client)
  (a-field (a-get "prompt_drafts")
    (if (null? client) (draft-key) (list (car client) (a-selection))) ""))
(define (set-draft! text)
  (a-set! "prompt_drafts" (hash-insert (a-get "prompt_drafts") (draft-key) text))
  (a-set! "prompt_error" #f) #t)
(define (a-prompt-paste! text)
  (and (a-selection) (not (a-get "tabs_focused")) (equal? (a-get "focus") "prompt")
    (set-draft! (string-append (a-prompt-text) (a-panel "SingleLine" (list text))))))
(define (a-prompt-key! key)
  (define bare (hash-ref key "bare_key")) (define char (a-char key))
  (define text (a-prompt-text))
  (cond ((equal? bare "Esc") (a-set! "focus" "history") #t)
    ((equal? bare "Enter")
      (when (and (a-selection) (not (equal? (string-trim text) "")))
        (with-handler (lambda (e) (a-set! "prompt_error" (error-object-message e)))
          (when (member (agent-row-status (a-row)) '("held" "exited"))
            (error "Agent is not running. Restart it before sending a prompt."))
          (yinz-agent-send (a-selection) text) (set-draft! ""))) #t)
    ((a-key? key (hash "Char" "u") '("Ctrl")) (set-draft! ""))
    ((equal? bare "Backspace") (set-draft! (substring text 0 (max 0 (- (string-length text) 1)))))
    ((and char (or (null? (hash-ref key "key_modifiers")) (equal? (hash-ref key "key_modifiers") '("Shift"))))
      (set-draft! (string-append text char)))
    (else #f)))
