(require "./state.scm")
(require "./overlay.scm")
(require "../shared/archive.scm")
(provide a-broadcast! a-discover-service! a-receive-snapshot! a-refresh-strip! a-load-history!
  a-load-more! a-request-summary! a-expire-summary! a-resume-run! a-load-run!
  a-hydrate-newest a-stored-header a-active-header a-fetch a-entity)
(define (a-fetch request) (yinz-data-fetch "shared:yinz" request))
(define (a-entity name) (yinz-agent-model "store" "EntityRequest" name))
(define (a-broadcast! name payload)
  (a-call (hash "MessageToPlugin" (hash "plugin_url" 'json-null "destination_plugin_id" 'json-null
        "plugin_config" (hash) "message_name" name "message_payload" (a-none payload)
        "message_args" (hash) "new_plugin_args" 'json-null "floating_pane_coordinates" 'json-null)) #f))
(define (a-discover-service! sessions)
  (define ids '())
  (for-each (lambda (session)
      (when (hash-ref session "is_current_session")
        (define plugins (hash-ref session "plugins"))
        (for-each (lambda (key)
            (when (equal? (hash-ref (hash-ref plugins key) "location") "yinz:agent-service")
              (set! ids (cons (string->number key) ids)))) (hash-keys->list plugins)))) sessions)
  (define id (and (= (length ids) 1) (car ids)))
  (unless (equal? id (a-get "service_id"))
    (a-set! "service_id" id) (a-set! "service_seq" 0) (a-broadcast! "agent_subscribe" #f)))
(define (run-before? a b)
  (if (= (hash-ref a "started_at_ms") (hash-ref b "started_at_ms"))
    (string<? (hash-ref a "id") (hash-ref b "id")) (> (hash-ref a "started_at_ms") (hash-ref b "started_at_ms"))))
(define (a-receive-snapshot! message)
  (unless (a-get "service_id")
    (define sessions (a-call "GetSessionList" #f))
    (when sessions (a-discover-service! (hash-ref sessions "live_sessions"))))
  (define trusted (and (a-get "service_id")
      (equal? (hash-ref message "source") (hash "Plugin" (a-get "service_id")))))
  (define raw-seq (a-field (hash-ref message "args") "seq" "0"))
  (define digits (if (starts-with? raw-seq "+") (substring raw-seq 1 (string-length raw-seq)) raw-seq))
  (define seq (and (> (string-length digits) 0)
      (foldl (lambda (ch okay) (and okay (char<=? #\0 ch) (char<=? ch #\9))) #t (string->list digits))
      (string->number digits)))
  (if (or (not trusted) (not seq) (not (integer? seq)) (<= seq (a-get "service_seq")) (> seq 18446744073709551615)) #f
    (let ((snapshot (with-handler (lambda (e) #f)
            (a-model "PollReply" (list (yinz-json-parse (hash-ref message "payload")))))))
      (if (not snapshot) #f
        (begin
          (a-set! "service_seq" seq)
          (for-each (lambda (run)
              (define id (hash-ref run "id"))
              (define old (a-find (lambda (header) (equal? (hash-ref header "id") id)) (a-get "archived_runs")))
              (cond ((json-null? (hash-ref run "ended_at_ms"))
                  (a-set! "archived_runs" (filter (lambda (header) (not (equal? (hash-ref header "id") id))) (a-get "archived_runs"))))
                (old (a-set! "archived_runs" (map (lambda (header) (if (equal? (hash-ref header "id") id) run header)) (a-get "archived_runs"))))
                (else
                  (when (and (a-get "archive_loaded_through") (run-before? run (a-get "archive_loaded_through")))
                    (a-set! "archive_offset" (min 4294967295 (+ (a-get "archive_offset") 1))))
                  (a-set! "archived_runs" (append (a-get "archived_runs") (list run)))))) (hash-ref snapshot "runs"))
          (a-set! "archived_runs" (sort (a-get "archived_runs") run-before?))
          (a-set! "snapshot" snapshot)
          (define first (not (a-get "strip_seen"))) (a-set! "strip_seen" #t)
          (define changed (a-refresh-strip!)) (or changed first))))))
(define (archive-row header)
  (hash "Run" (hash "run_id" (hash-ref header "id") "kind" (hash-ref header "kind")
      "title" (hash-ref header "title") "worktree" (a-model "WorktreeCell" (list header))
      "started_at_ms" (hash-ref header "started_at_ms") "continuation" (not (json-null? (a-field header "previous_run_id" 'json-null))))))
(define (a-refresh-strip!)
  (define snapshot (a-get "snapshot"))
  (if (not snapshot) #f
    (let* ((panes (or (a-some (hash-ref snapshot "panes")) '()))
        (request (hash-insert (a-entity "project") "limit" (yinz-agent-model "store" "FetchLimit" 'json-null)))
        (registry (with-handler (lambda (e) (hash)) (yinz-agent-model "projects" "FromRows" (list (a-fetch request)))))
        (repositories (hash-ref snapshot "repositories")) (projects (hash)) (branches (hash)))
      (for-each (lambda (pane)
          (define location (a-some (a-model "PaneCheckoutLocation" (list pane))))
          (when location
            (define id (number->string (hash-ref pane "pane_id")))
            (define project (a-some (yinz-agent-model "projects" "ProjectForCwd" (list repositories registry location))))
            (when project (set! projects (hash-insert projects id (hash-ref project "name"))))
            (define branch (a-some (a-field (a-field repositories location #f) "branch" 'json-null)))
            (when branch (set! branches (hash-insert branches id branch))))) panes)
      (define rows (a-model "StripRows" (list panes (hash-ref snapshot "manual_kinds") (hash-ref snapshot "activity")
            projects branches (hash-ref snapshot "summaries") (hash-ref snapshot "hooks"))))
      (set! rows (map (lambda (row)
            (define agent (a-field row "Agent" #f))
            (if (and agent (a-find (lambda (header) (and (= (hash-ref header "pane_id") (hash-ref agent "pane_id"))
                      (json-null? (hash-ref header "ended_at_ms")) (not (json-null? (a-field header "previous_run_id" 'json-null))))) (hash-ref snapshot "runs")))
              (let* ((text (hash-ref agent "text")) (head (let loop ((i 0))
                      (if (and (< i (string-length text)) (char-whitespace? (string-ref text i))) (loop (+ i 1)) i))))
                (hash "Agent" (hash-insert agent "text" (string-append (substring text 0 head) "↳ " (substring text head (string-length text))))))
              row)) rows))
      (when (or (not (null? (a-get "archived_runs"))) (a-get "archive_more"))
        (set! rows (append rows (list (hash "Project" "archive")) (map archive-row (a-get "archived_runs"))
            (if (a-get "archive_more") '("MoreRuns") '()))))
      (define was (a-selection-key))
      (define changed (a-set-rows! (hash "rows" rows "focused" (hash-ref snapshot "focused") "summaries" (hash-ref snapshot "summaries"))))
      (a-follow-selection! was)
      (define revision (a-get "run_revision")) (define error (a-get "run_error"))
      (a-load-history!)
      (define answered (summary-in-strip!))
      (or changed answered (not (= revision (a-get "run_revision"))) (not (equal? error (a-get "run_error")))))))
(define (a-load-more!)
  (with-handler (lambda (e) #f)
    (define request (a-entity "agent_run"))
    (set! request (hash-insert request "filter" (hash "And" (list (hash "Eq" (list "active" (hash "Bool" #f))) (hash "NotNull" "header")))))
    (set! request (hash-insert request "sort" '(("started_at_ms" "Desc") ("uid" "Asc"))))
    (set! request (hash-insert request "select" '("header")))
    (set! request (hash-insert (hash-insert request "limit" 50) "offset" (a-get "archive_offset")))
    (define rows (a-fetch request))
    (define headers (a-model "RunHeadersFromRows" (list rows)))
    (unless (null? headers) (a-set! "archive_loaded_through" (car (reverse headers))))
    (for-each (lambda (header)
        (unless (a-find (lambda (old) (equal? (hash-ref old "id") (hash-ref header "id"))) (a-get "archived_runs"))
          (a-set! "archived_runs" (append (a-get "archived_runs") (list header))))) headers)
    (a-set! "archive_offset" (min 4294967295 (+ (a-get "archive_offset") (length (hash-ref rows "rows")))))
    (a-set! "archive_more" (hash-ref rows "truncated"))))
(define (a-active-header pane)
  (and pane (a-find (lambda (run) (and (= (hash-ref run "pane_id") pane) (json-null? (hash-ref run "ended_at_ms"))))
      (a-field (a-get "snapshot") "runs" '()))))
(define (a-hydrate-newest run)
  (set! run (hash-insert run "omitted_entries" 0))
  (with-handler (lambda (e) run)
    (define id (hash-ref run "id"))
    (define rows (a-fetch (a-model "NewestEntriesRequest" (list id))))
    (define entries (a-field (a-model "EntriesFromRows" (list rows)) id #f))
    (if (not entries) run
      (let loop ((rest (reverse entries)) (kept '()) (spent 0))
        (define bytes (if (null? rest) 0 (length (bytes->list (string->bytes (hash-ref (car rest) "text"))))))
        (if (or (null? rest) (and (not (null? kept)) (> (+ spent bytes) 262144)))
          (hash-insert (hash-insert run "entries" kept) "omitted_entries"
            (+ (- (length entries) (length kept)) (if (hash-ref rows "truncated") 1 0)))
          (loop (cdr rest) (cons (car rest) kept) (+ spent bytes)))))))
(define (a-load-history!)
  (define id (or (a-selected-run) (a-field (a-active-header (a-selection)) "id" #f)))
  (when id
    (with-handler (lambda (e) (a-set! "run_error" (and (a-selection-key) (list (a-selection-key) (trim (error-object-message e))))))
      (define rows (a-fetch (a-model "RunByIdRequest" (list id))))
      (define run (a-at (a-model "RunsFromRows" (list rows)) 0))
      (unless run (error "the run is no longer in the archive"))
      (set! run (if (a-selected-revision)
          (let ((page (archive-search-detail id (a-selected-revision))))
            (hash-insert (hash-insert run "entries" (hash-ref page "entries")) "omitted_entries" (if (hash-ref page "earlier") 1 0)))
          (a-hydrate-newest run)))
      (define fingerprint (yinz-agent-model "history" "Fingerprint" run))
      (unless (equal? fingerprint (a-field (a-get "run") "fingerprint" #f)) (a-load-run! run fingerprint)))))
(define (a-load-run! run fingerprint)
  (a-set! "run_offset_secs" (or (a-some (a-call (hash "GetLocalUtcOffset" (hash "epoch_ms" (hash-ref run "started_at_ms"))) #f)) 0))
  (define old (a-get "run"))
  (define parsed (if old (hash-ref old "parsed") (yinz-history-create run)))
  (when old (yinz-history-call parsed "Update" run))
  (define summary (a-some (hash-ref run "summary")))
  (define entries (hash-ref run "entries"))
  (define stamped (or (a-find (lambda (entry) (not (json-null? (hash-ref entry "created_at_ms")))) entries)
      (and summary (not (json-null? (hash-ref summary "created_at_ms"))))))
  (a-set! "run" (hash "id" (hash-ref run "id") "pane_id" (hash-ref run "pane_id")
      "ended" (not (json-null? (hash-ref run "ended_at_ms"))) "host" (hash-ref run "host") "cwd" (hash-ref run "cwd")
      "stamped" (if stamped #t #f) "fingerprint" fingerprint "parsed" parsed))
  (a-inc! "run_revision") (a-set! "run_error" #f)
  (define ask (a-get "summarizing"))
  (when (and ask (or (equal? (hash-ref ask "row") (string-append "run:" (hash-ref run "id")))
        (and (json-null? (hash-ref run "ended_at_ms")) (equal? (hash-ref ask "row") (string-append "pane:" (number->string (hash-ref run "pane_id")))))))
    (define (since value) (and (a-some value) (>= value (hash-ref ask "asked_at_ms"))))
    (when (or (and summary (since (hash-ref summary "created_at_ms")))
        (a-find (lambda (entry) (and (equal? (hash-ref entry "kind") "summary") (since (hash-ref entry "created_at_ms")))) entries))
      (a-set! "summarizing" #f))))
(define (a-stored-header id)
  (define rows (with-handler (lambda (e) (error "that run's record could not be read")) (a-fetch (a-model "RunByIdRequest" (list id)))))
  (define run (a-at (a-model "RunsFromRows" (list rows)) 0))
  (unless run (error "that run is no longer in the archive"))
  (a-model "RunHeader" (list run)))
(define (a-resume-run! id)
  (with-handler (lambda (e) (a-set! "resume_note" (list (string-append "run:" id) (trim (error-object-message e)))))
    (define header (a-stored-header id))
    (when (json-null? (hash-ref header "ended_at_ms")) (error "that run is live again"))
    (define planned (yinz-agent-model "providers" "WithSnapshot" (list (a-get "providers") "launch" "ResumeCommand"
          (map (lambda (name) (a-field header name 'json-null)) '("kind" "session_id" "cwd" "host" "bubblewrap")))))
    (when (hash-contains? planned "Err") (error (hash-ref planned "Err")))
    (define command (hash-ref planned "Ok"))
    (define pane (a-some (a-call (hash "OpenCommandPaneNearPlugin" (list command (a-model "AgentPaneContext" '()))) #f)))
    (unless pane (error "the pane could not be opened"))
    (a-hide!)
    (define plugin (a-field pane "Plugin" #f))
    (a-call (hash (if plugin "FocusPluginPane" "FocusTerminalPane") (list (or plugin (hash-ref pane "Terminal")) #f #f)) #f)
    (a-set! "resume_note" #f)))
(define (a-request-summary!)
  (if (not (or (a-selection) (a-selected-run))) #f
    (let* ((row (a-selection-key)) (old (a-get "summarizing"))
        (changed (or (not (equal? row (a-field old "row" #f))) (a-field old "stale" #f) (a-get "resume_note"))))
      (a-broadcast! "agent_summarize" (yinz-json-string (hash "pane_id" (a-none (a-selection)) "run_id" (a-none (a-selected-run)))))
      (a-set! "summarizing" (hash "row" row "asked_at_ms" (yinz-wall-clock-ms) "stale" #f))
      (a-set! "resume_note" #f) (if changed #t #f))))
(define (summary-in-strip!)
  (define ask (a-get "summarizing"))
  (define answered (and ask (a-find (lambda (key)
          (define summary (hash-ref (a-get "summaries") key))
          (and (equal? (hash-ref ask "row") (string-append "pane:" key))
            (a-some (hash-ref summary "created_at_ms")) (>= (hash-ref summary "created_at_ms") (hash-ref ask "asked_at_ms"))))
        (hash-keys->list (a-get "summaries")))))
  (when answered (a-set! "summarizing" #f)) (if answered #t #f))
(define (a-expire-summary! now)
  (define ask (a-get "summarizing"))
  (if (and ask (not (hash-ref ask "stale")) (>= (- now (hash-ref ask "asked_at_ms")) 70000))
    (begin (a-set! "summarizing" (hash-insert ask "stale" #t)) #t) #f))
