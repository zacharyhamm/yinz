(provide a-get a-set! a-reset! a-field a-some a-at a-index a-find a-call a-model a-panel
  a-row a-row-data a-row-key a-selection-key a-selection a-selected-run a-selected-revision
  a-selectable? a-waiting? a-waiting-rows a-waiting-count a-live? a-step a-set-rows!
  a-leave-row! a-follow-selection! a-close-reader! a-keys-here? a-bar-keys?
  a-clear-search! a-clear-waiting! a-clear-predecessors!
  a-invalidate-history! a-key? a-char a-inc! a-none a-sub a-base-strip a-predecessor-rows)
(define state (hash))
(define (a-get key) (hash-ref state key))
(define (a-set! key value) (set! state (hash-insert state key value)))
(define (a-inc! key) (a-set! key (+ (a-get key) 1)))
(define (a-field object key fallback)
  (if (and (hash? object) (hash-contains? object key)) (hash-ref object key) fallback))
(define (a-some value) (and (not (json-null? value)) value))
(define (a-none value) (if value value 'json-null))
(define (a-at items index) (and index (>= index 0) (< index (length items)) (list-ref items index)))
(define (a-index predicate items)
  (let loop ((items items) (i 0))
    (cond ((null? items) #f) ((predicate (car items)) i) (else (loop (cdr items) (+ i 1))))))
(define (a-find predicate items) (a-at items (a-index predicate items)))
(define (a-call command fallback) (with-handler (lambda (error) fallback) (yinz-command command)))
(define (a-model op args) (yinz-agent-model "providers" "WithSnapshot" (list (a-get "providers") "agents" op args)))
(define (a-panel op args) (yinz-agent-model "panel" op args))
(define (a-sub n by) (max 0 (- n by)))
(define (a-key? key bare modifiers)
  (and (equal? (a-field key "bare_key" #f) bare) (equal? (a-field key "key_modifiers" '()) modifiers)))
(define (a-char key) (a-field (a-field key "bare_key" #f) "Char" #f))
(define (a-reset!)
  (set! state (hash
      "configuration" (hash) "providers" '() "service_id" #f "service_seq" 0 "snapshot" #f
      "archived_runs" '() "archive_sorted" #f "archive_rows" #f "archive_offset" 0 "archive_loaded_through" #f "archive_more" #f
      "pane_tabs" #f "own_plugin_id" 0 "own_client_id" 0 "initial_cwd" ""
      "bar_focused" '() "tabs_focused" #f "age_minute" 0 "rows" '() "summaries" (hash)
      "pulse" #f "pulse_timer" #f "maintenance_at" 0
      "history_request" 0 "history_pending" #f "history_desired" #f "history_next" #f
      "history_deadline" 0 "history_retry_at" #f "history_hidden" #f "prompt_document" #f "search_headers" (hash)
      "client_modes" (hash) "quota_images" (hash) "last_quota_top" #f "render_client" 0
      "usage_cache" (hash) "usage_pending" (hash) "usage_request" 0 "usage_visible" 'json-null
      "run" #f "run_offset_secs" 0 "history_scroll" 0 "history_cursor" 0
      "history_cursor_anchor" #f "history_bottom_anchor" #f "history_scrolled" #f
      "reading" #f "reader_cache" #f "reading_id" 0 "last_reader_max_scroll" 0 "last_reader_rows" 0 "last_reader_left" 0 "last_reader_width" 0
      "prompt_drafts" (hash) "prompt_error" #f "last_prompt_row" #f
      "focus" "list" "has_keyboard" 'json-null "pane_shown" #f "last_label_rows" 0
      "open_note" #f "strip_seen" #f "select_on_open" #f "open_request" 0 "run_error" #f "key_sheet_scroll" #f
      "last_sheet_rows" 0 "last_sheet_max_scroll" 0 "selected" 0 "focused" #f
      "last_window_start" 0 "list_scroll" #f "list_lines" '() "list_rich" #f "click_press" #f "mouse_position" #f
      "split_ratio" (/ 1.0 3) "divider_drag" #f "last_divider_col" #f "last_history_top" 0
      "last_rows" 0 "last_cols" 0 "last_footer_row" #f "last_list_rows" 0 "last_list_max_scroll" 0 "last_list_offset" 0 "last_list_window" 0 "last_history_rows" 0
      "last_history_body_rows" 0 "last_history_window_start" 0 "last_history_body_top" 0
      "last_history_max_scroll" 0 "generation" 0 "run_revision" 0 "history_cache" #f
      "summarizing" #f "confirming_resume" #f "resume_note" #f "search_revisions" (hash)
      "pending_history_revision" #f "predecessors" #f "predecessor_request" 0
      "search_editing" #f "search_pending" #f "search_deadline_ms" 0 "search_query" ""
      "search_draft" #f "applied_search_query" #f "searched_at_ms" #f "search_request" 0
      "search_error" #f "search_truncated" #f "search_base" #f "waiting_base" #f
      "panel_pane" #f "panel_tab" #f "panel_client_tabs" (hash) "panel_surface" '(0 0)
      "panel_corner" 0 "panel_rect" #f "panel_requested" #f "panel_floating" #f)))
(a-reset!)
(define (a-row) (a-at (a-get "rows") (a-get "selected")))
(define (a-row-data row kind) (a-field row kind #f))
(define (a-row-key row)
  (cond ((a-field row "Agent" #f) (string-append "pane:" (number->string (hash-ref (hash-ref row "Agent") "pane_id"))))
    ((a-field row "Run" #f) (string-append "run:" (hash-ref (hash-ref row "Run") "run_id")))
    ((equal? row "MoreRuns") "more") (else #f)))
(define (a-selection-key) (a-row-key (a-row)))
(define (a-selection) (a-field (a-field (a-row) "Agent" #f) "pane_id" #f))
(define (a-selected-run) (a-field (a-field (a-row) "Run" #f) "run_id" #f))
(define (a-selected-revision) (a-field (a-get "search_revisions") (or (a-selected-run) "") #f))
(define (a-selectable? row) (if (a-row-key row) #t #f))
(define (a-waiting? row) (a-field (a-field row "Agent" #f) "waiting" #f))
(define (a-live?) (and (a-selection) (equal? (a-selection) (a-get "focused"))))
(define (a-keys-here?) (and (not (equal? (a-get "has_keyboard") #f)) (not (a-get "tabs_focused"))))
(define (a-bar-keys?) (and (not (equal? (a-get "has_keyboard") #f)) (a-get "tabs_focused")))
(define (a-base-strip)
  (or (a-get "waiting_base") (a-field (a-get "predecessors") "base" #f) (a-get "search_base")
    (hash "rows" (a-get "rows") "summaries" (a-get "summaries") "focused" (a-none (a-get "focused")))))
(define (a-waiting-count) (length (filter a-waiting? (hash-ref (a-base-strip) "rows"))))
(define (a-predecessor-rows previous)
  (define rows (hash-ref (hash-ref previous "base") "rows"))
  (define last-live (a-find (lambda (i) (a-field (list-ref rows i) "Agent" #f)) (reverse (range (length rows)))))
  (define result (hash-ref previous "result"))
  (define diagnostic (a-field result "diagnostic" ""))
  (define headers (a-field result "headers" '()))
  (append (take rows (if last-live (+ last-live 1) 0))
    (list (hash "Project" (cond ((not result) "Loading predecessors…") ((not (equal? diagnostic "")) diagnostic)
          ((null? headers) "No predecessors recorded") (else "Previous agents"))))
    (map (lambda (run) (hash "Run" (hash "run_id" (hash-ref run "id") "kind" (hash-ref run "kind")
            "title" (hash-ref run "title") "worktree" (a-model "WorktreeCell" (list run)) "started_at_ms" (hash-ref run "started_at_ms")
            "continuation" (if (a-some (a-field run "previous_run_id" 'json-null)) #t #f)))) headers)))
(define (a-waiting-rows rows keep)
  (define headers '()) (define answer '())
  (for-each (lambda (row)
      (cond ((a-field row "Project" #f) (set! headers (list row)))
        ((a-field row "Branch" #f)
          (when (and (not (null? headers)) (a-field (car (reverse headers)) "Branch" #f))
            (set! headers (reverse (cdr (reverse headers)))))
          (set! headers (append headers (list row))))
        ((or (a-waiting? row) (and keep (a-field row "Agent" #f) (equal? (a-row-key row) keep)))
          (set! answer (append answer headers (list row))) (set! headers '())))) rows)
  answer)
(define (a-step rows selected direction)
  (define indices (if (> direction 0) (range (min (length rows) (+ selected 1)) (length rows))
      (reverse (range (min selected (length rows))))))
  (or (a-find (lambda (i) (a-selectable? (list-ref rows i))) indices) selected))
(define (a-close-reader!)
  (define had (if (a-get "reading") #t #f))
  (a-set! "reading" #f) (a-set! "reader_cache" #f) had)
(define (a-invalidate-history!)
  (a-set! "history_desired" #f)
  (a-set! "history_retry_at" #f)
  (define next (a-get "history_next")) (a-set! "history_next" #f)
  (when next (yinz-resolve! next #f)))
(define (a-leave-row!)
  (a-set! "pulse" #f)
  (a-invalidate-history!)
  (a-set! "run" #f) (a-set! "history_cache" #f) (a-set! "prompt_document" #f)
  (for-each (lambda (key) (a-set! key #f))
    '("pending_history_revision" "list_scroll" "history_cursor_anchor" "history_bottom_anchor"
      "history_scrolled" "summarizing" "confirming_resume" "resume_note" "open_note" "run_error"))
  (a-set! "history_scroll" 0) (a-set! "history_cursor" 0) (a-close-reader!))
(define (a-follow-selection! was)
  (if (equal? was (a-selection-key)) #f
    (begin (a-set! "prompt_error" #f)
      (when (equal? (a-get "focus") "prompt") (a-set! "focus" "history"))
      (a-leave-row!) (a-set! "pending_history_revision" (a-selected-revision)) #t)))
(define (a-set-rows! strip . keep-option)
  (define keep (if (null? keep-option) (a-selection-key) (car keep-option)))
  (define filtered (or (a-get "predecessors") (a-get "waiting_base")))
  (define rows (hash-ref strip "rows"))
  (define focused (a-some (hash-ref strip "focused")))
  (define summaries (hash-ref strip "summaries"))
  (when (a-get "waiting_base") (a-set! "waiting_base" strip) (set! rows (a-waiting-rows rows keep)))
  (when (a-get "predecessors")
    (a-set! "predecessors" (hash-insert (a-get "predecessors") "base" strip))
    (set! rows (a-predecessor-rows (a-get "predecessors"))))
  (if (a-get "search_base")
    (let ((was-waiting (a-waiting-count)) (was-live (a-live?)))
      (a-set! "search_base" (hash "rows" rows "summaries" summaries "focused" (a-none focused)))
      (a-set! "focused" (or focused (a-get "focused")))
      (or (not (equal? was-live (a-live?))) (not (= was-waiting (a-waiting-count)))))
    (let* ((was (a-selection-key))
        (same (and was (a-index (lambda (row) (equal? (a-row-key row) was)) rows)))
        (last-run (and (equal? was "more") (a-find (lambda (row) (a-field row "Run" #f))
              (reverse (take (a-get "rows") (min (a-get "selected") (length (a-get "rows"))))))))
        (last-run-at (and last-run (a-index (lambda (row) (equal? (a-row-key row) (a-row-key last-run))) rows)))
        (first-loaded (and (equal? was "more")
            (if last-run-at (a-step rows last-run-at 1)
              (a-find (lambda (i) (a-selectable? (list-ref rows i))) (reverse (range (length rows)))))))
        (nearest (and filtered (a-find (lambda (i) (a-selectable? (list-ref rows i)))
              (append (range (min (a-get "selected") (length rows)) (length rows))
                (reverse (range (min (a-get "selected") (length rows))))))))
        (selected (or same first-loaded nearest (a-index a-selectable? rows) 0))
        (new-focus (or focused (a-get "focused")))
        (new-live (and new-focus (equal? new-focus (a-field (a-field (a-at rows selected) "Agent" #f) "pane_id" #f))))
        (changed (or (not (equal? rows (a-get "rows"))) (not (= selected (a-get "selected")))
            (not (equal? summaries (a-get "summaries"))) (not (equal? (if new-live #t #f) (if (a-live?) #t #f))))))
      (when changed (a-inc! "generation"))
      (unless (equal? was (a-row-key (a-at rows selected))) (a-set! "list_scroll" #f))
      (a-set! "rows" rows) (a-set! "selected" selected) (a-set! "summaries" summaries)
      (a-set! "focused" new-focus) changed)))

(define (a-clear-waiting!)
  (define base (a-get "waiting_base"))
  (if (not base) #f (begin (a-set! "waiting_base" #f) (a-set! "list_scroll" #f) (a-set-rows! base) #t)))
(define (a-clear-predecessors!)
  (define previous (a-get "predecessors"))
  (if (not previous) #f (begin (a-set! "predecessors" #f) (a-set-rows! (hash-ref previous "base")) #t)))
(define (a-clear-search!)
  (a-set! "search_headers" (hash)) (a-set! "search_revisions" (hash)) (a-set! "pending_history_revision" #f)
  (a-set! "applied_search_query" #f) (a-set! "searched_at_ms" #f) (a-inc! "search_request")
  (a-set! "search_pending" #f) (a-set! "search_editing" #f)
  (define base (a-get "search_base"))
  (if (not base) #f
    (let ((keep (a-selection-key)))
      (a-set! "search_base" #f) (a-set! "search_draft" #f) (a-set! "rows" (hash-ref base "rows"))
      (a-set! "summaries" (hash-ref base "summaries")) (a-set! "search_query" "")
      (a-set! "search_error" #f) (a-set! "search_truncated" #f)
      (a-set! "selected" (or (and keep (a-index (lambda (row) (equal? (a-row-key row) keep)) (a-get "rows")))
          (a-index a-selectable? (a-get "rows")) 0))
      (a-inc! "generation") #t)))
