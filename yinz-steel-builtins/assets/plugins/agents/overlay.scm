(require "./state.scm")
(provide a-end-visit! a-hide! a-own-pane a-panel-pane a-panel-panes! a-panel-tabs!
  a-place-panel! a-reposition! a-own-pane-changed! a-take-ring! a-keys-to-list! a-focus-bar!)
(define (uint text)
  (define chars (string->list text))
  (when (and (not (null? chars)) (char=? (car chars) #\+)) (set! chars (cdr chars)))
  (and (not (null? chars)) (foldl (lambda (ch ok) (and ok (>= (char->integer ch) 48) (<= (char->integer ch) 57))) #t chars)
    (let ((n (string->number (list->string chars)))) (and n (<= n 18446744073709551615) n))))
(define (measure text)
  (and text (let* ((text (trim text)) (n (string-length text))
        (percent (and (> n 0) (char=? (string-ref text (- n 1)) #\%)))
        (value (uint (if percent (trim (substring text 0 (- n 1))) text))))
      (and value (list value percent)))))
(define (resolve config name whole fallback)
  (define value (or (measure (a-field config name #f)) (list fallback #t)))
  (if (cadr value) (quotient (min 18446744073709551615 (* whole (car value))) 100) (car value)))
(define (padding config rows cols)
  (define value (measure (a-field config "pad" #f)))
  (define pad (if (and value (not (cadr value))) (car value) 3))
  (foldl min pad (list (quotient rows 4) (quotient cols 4) (quotient (a-sub rows 8) 2)
      (quotient (a-sub cols (min 24 (max cols 1))) 2))))
(define (panel-rect corner size)
  (define surface (a-get "panel_surface"))
  (define rows (car surface)) (define cols (cadr surface))
  (and (> rows 0) (> cols 0)
    (let* ((config (a-get "configuration")) (pad (padding config rows cols))
        (width (if size (car size) (min cols (max (min 24 cols) (min (resolve config "width" cols 60) (a-sub cols (* pad 2)))))))
        (height (if size (cadr size) (min rows (max (min 8 rows) (min (resolve config "height" rows 66) (a-sub rows (* pad 2)))))))
        (w (min cols (max 1 width))) (h (min rows (max 1 height)))
        (x (if (member corner '(0 1)) pad (max pad (a-sub cols (+ pad w)))))
        (y (if (member corner '(0 3)) (max pad (a-sub rows (+ pad h))) pad)))
      (hash "x" (min x (a-sub cols w)) "y" (min y (a-sub rows h)) "cols" w "rows" h))))
(define (placement! rect override)
  (a-call (hash "ChangeOverlayCoordinates"
      (hash "placements" (list (list (or (a-get "panel_pane") (hash "Plugin" (a-get "own_plugin_id")))
            (hash "x" (hash "Fixed" (hash-ref rect "x")) "y" (hash "Fixed" (hash-ref rect "y"))
              "width" (hash "Fixed" (hash-ref rect "cols")) "height" (hash "Fixed" (hash-ref rect "rows"))
              "pinned" 'json-null "borderless" 'json-null))) "override_user_placement" override)) #f))
(define (a-place-panel! override)
  (when (a-get "panel_floating")
    (define rect (panel-rect (a-get "panel_corner") #f))
    (when (and rect (or override (not (equal? rect (a-get "panel_requested")))))
      (a-set! "panel_requested" rect) (placement! rect override)
      (unless (a-get "panel_rect") (a-set! "panel_rect" rect)))))
(define (a-reposition!)
  (when (and (a-get "pane_shown") (a-get "panel_floating"))
    (a-set! "panel_corner" (modulo (+ (a-get "panel_corner") 1) 4))
    (define old (a-get "panel_rect"))
    (define rect (panel-rect (a-get "panel_corner") (and old (list (hash-ref old "cols") (hash-ref old "rows")))))
    (when rect (placement! rect #t) (a-set! "panel_rect" rect)
      (a-set! "panel_requested" (panel-rect (a-get "panel_corner") #f)))))
(define (pane-id pane) (hash (if (a-field pane "is_plugin" #f) "Plugin" "Terminal") (hash-ref pane "id")))
(define (panes manifest) (apply append (hash-values->list (hash-ref manifest "panes"))))
(define (a-own-pane manifest)
  (a-find (lambda (pane) (and (a-field pane "is_plugin" #f) (= (hash-ref pane "id") (a-get "own_plugin_id")))) (panes manifest)))
(define (a-panel-pane manifest)
  (define all (panes manifest))
  (define owner (a-find (lambda (pane)
        (a-find (lambda (slot) (equal? (a-field slot "plugin_id" 'json-null) (a-get "own_plugin_id")))
          (a-field (a-field pane "pane_tabs" #f) "tabs" '()))) all))
  (if owner
    (a-find (lambda (pane) (equal? (pane-id pane) (hash-ref (hash-ref owner "pane_tabs") "pane_id"))) all)
    (a-own-pane manifest)))
(define (a-panel-panes! manifest)
  (define own (a-panel-pane manifest))
  (when own
    (define tabs (hash-ref manifest "panes"))
    (define tab (a-find (lambda (key) (a-find (lambda (pane) (equal? (pane-id pane) (pane-id own))) (hash-ref tabs key))) (hash-keys->list tabs)))
    (when tab
      (a-set! "panel_tab" (string->number tab)) (a-set! "panel_pane" (pane-id own))
      (a-set! "panel_floating" (hash-ref own "is_floating"))
      (when (a-get "panel_floating")
        (when (> (hash-ref own "pane_columns") 0)
          (a-set! "panel_rect" (hash "x" (hash-ref own "pane_x") "y" (hash-ref own "pane_y")
              "cols" (hash-ref own "pane_columns") "rows" (hash-ref own "pane_rows"))))
        (a-place-panel! #f)))))
(define (a-panel-tabs! tabs)
  (define active (a-find (lambda (tab) (hash-ref tab "active")) tabs))
  (when active
    (define client (number->string (a-get "own_client_id")))
    (define old (a-field (a-get "panel_client_tabs") client #f))
    (define position (hash-ref active "position"))
    (a-set! "panel_client_tabs" (hash-insert (a-get "panel_client_tabs") client position))
    (when (and (not (a-get "pane_tabs")) (a-get "pane_shown") (equal? old (a-get "panel_tab")) (not (equal? (a-get "panel_tab") position)))
      (a-call (hash "BreakPanesToTabWithIndex" (list (list (or (a-get "panel_pane") (hash "Plugin" (a-get "own_plugin_id")))) position #f)) #f))
    (define surface (list (hash-ref active "display_area_rows") (hash-ref active "display_area_columns")))
    (unless (equal? surface (a-get "panel_surface"))
      (a-set! "panel_surface" surface) (a-place-panel! #f))))
(define (a-end-visit!)
  (a-invalidate-history!) (a-set! "history_hidden" #t)
  (a-set! "tabs_focused" #f) (a-set! "bar_focused" '()) (a-set! "focus" "list")
  (a-set! "divider_drag" #f) (a-set! "click_press" #f) (a-set! "confirming_resume" #f) (a-set! "key_sheet_scroll" #f))
(define (a-hide!)
  (a-end-visit!) (a-set! "pane_shown" #f)
  (a-call (hash "HidePaneWithId" (or (a-get "panel_pane") (hash "Plugin" (a-get "own_plugin_id")))) #f))
(define (a-own-pane-changed! visible focused)
  (when (and (a-get "pane_shown") (not visible)) (a-end-visit!))
  (a-set! "pane_shown" visible)
  (define old (a-get "has_keyboard"))
  (define focused (and visible focused))
  (a-set! "has_keyboard" focused)
  (and visible (not (json-null? old)) (not (equal? old focused))))
(define (a-keys-to-list!)
  (a-set! "tabs_focused" #f) (a-set! "focus" "list")
  (a-set! "bar_focused" (filter (lambda (client) (not (= client (a-get "own_client_id")))) (a-get "bar_focused"))))
(define (a-take-ring! stop)
  (define tabs (if (member stop '("tabs" "management_tabs")) #t #f))
  (define changed (not (equal? tabs (a-get "tabs_focused"))))
  (a-set! "tabs_focused" tabs)
  (a-set! "bar_focused" (filter (lambda (client) (not (= client (a-get "own_client_id")))) (a-get "bar_focused")))
  (when tabs (a-set! "bar_focused" (append (a-get "bar_focused") (list (a-get "own_client_id")))))
  (when (a-get "pane_tabs") (a-call (hash "PaneTabs" (hash "Focus" (hash "id" (a-get "pane_tabs") "bar" tabs))) #f))
  (define focus (cond ((and (equal? stop "history") (> (a-get "last_history_rows") 0)) "history")
      (tabs (a-get "focus")) (else "list")))
  (set! changed (or changed (not (equal? focus (a-get "focus")))))
  (a-set! "focus" focus) changed)
(define (a-focus-bar!) (a-take-ring! "tabs"))
