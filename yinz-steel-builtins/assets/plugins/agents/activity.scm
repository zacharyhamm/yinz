(require "./state.scm" "../shared/agent-status.scm")
(provide a-agent-status a-agent-info a-quiet-minutes a-snapshot-quiet-minutes a-pulse-elapsed a-check-pulse! a-hook-pulse!)
(define (a-agent-status row) (agent-row-status row))
;; Whole minutes a pane's screen has been still, from the service's activity sample, which
;; counts quiet polls five seconds apart; #f under a minute.
(define (a-snapshot-quiet-minutes snapshot id)
  (define sample (a-field (a-field snapshot "activity" #f) (number->string id) #f))
  (define minutes (if sample (quotient (* 5 (cadr sample)) 60) 0))
  (and (> minutes 0) minutes))
(define (a-quiet-minutes id) (a-snapshot-quiet-minutes (a-get "snapshot") id))
;; Sanitizing drops a bare carriage return, so it becomes a space first rather than joining words.
(define (one-line text)
  (if (string? text) (string-join (split-whitespace (yinz-text-sanitize (string-replace text "\r" " "))) " ") ""))
(define (a-agent-info row)
  (define id (a-field (a-field row "Agent" #f) "pane_id" #f))
  (define key (if id (number->string id) ""))
  (define snapshot (a-get "snapshot"))
  (define pane (a-find (lambda (pane) (equal? id (hash-ref pane "pane_id")))
      (or (a-some (a-field snapshot "panes" #f)) '())))
  (define status (a-agent-status row))
  (define hook (a-field (a-field snapshot "hooks" #f) key #f))
  (define phase (a-field (hash "working" "Busy" "needs input" "Waiting" "idle" "Idle") status #f))
  (define reported (and phase (equal? phase (a-field hook "phase" #f))))
  ; The canonical waiting row already checks summary freshness against the current screen.
  (define summary (and (not reported) (equal? status "needs input")
      (a-some (a-field (a-field snapshot "summaries" #f) key #f))))
  (define task (one-line (a-field pane "title" "")))
  (define detail (one-line (if summary (a-field summary "text" #f) (and reported
          (cond ((equal? status "working") (a-field hook "detail" #f))
            ((equal? status "needs input") (a-field hook "waiting_on" #f)) (else #f))))))
  (hash "status" status "activity" (if (equal? detail "") task detail) "task" task
    "tracking" (cond ((member status '("held" "exited")) "pane status") (reported "hooks")
      (summary "screen summary")
      ((a-field (a-field snapshot "activity" #f) key #f) "screen activity") (else "no activity yet"))))
(define (a-pulse-elapsed)
  (define pulse (a-get "pulse"))
  (and pulse (equal? (car pulse) (a-selection)) (not (a-get "history_hidden"))
    (equal? (a-agent-status (a-row)) "working") (- (yinz-now-ms) (cadr pulse))))
(define (a-check-pulse!)
  (define elapsed (a-pulse-elapsed))
  (define expired (and (a-get "pulse") (or (not elapsed) (>= elapsed 1000))))
  (when expired (a-set! "pulse" #f)) expired)
(define (a-arm-pulse!)
  (when (and (a-get "pulse") (not (a-get "pulse_timer")))
    (a-set! "pulse_timer" #t)
    (yinz-then (yinz-sleep 50) (lambda (_)
        (a-set! "pulse_timer" #f)
        (define had (a-get "pulse"))
        (a-check-pulse!)
        (when had (yinz-request-render))
        (a-arm-pulse!)))))
(define (a-hook-pulse! event)
  (if (and (a-selection) (equal? (a-selection) (hash-ref event "pane_id"))
      (not (a-get "history_hidden")) (equal? (a-agent-status (a-row)) "working"))
    (begin (a-set! "pulse" (list (a-selection) (yinz-now-ms))) (a-arm-pulse!) #t) #f))
