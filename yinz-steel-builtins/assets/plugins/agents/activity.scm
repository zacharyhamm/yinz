(require "./state.scm")
(provide a-agent-status a-agent-info a-live-counts)
(define (a-agent-status row)
  (define text (a-field (a-field row "Agent" #f) "text" ""))
  (define symbol (substring text (max 0 (- (string-length text) 1)) (string-length text)))
  (cond ((equal? symbol "■") "held") ((equal? symbol "×") "exited")
    ((a-waiting? row) "needs input")
    (else (a-field (hash "●" "working" "!" "needs input" "○" "idle") symbol "unknown"))))
;; Sanitizing drops a bare carriage return, so it becomes a space first rather than joining words.
(define (one-line text)
  (if (string? text) (string-join (split-whitespace (yinz-text-sanitize (string-replace text "\r" " "))) " ") ""))
(define (a-agent-info row)
  (define id (a-field (a-field row "Agent" #f) "pane_id" #f))
  (define key (if id (number->string id) ""))
  (define snapshot (a-get "snapshot"))
  (define pane (a-find (lambda (pane) (equal? id (hash-ref pane "pane_id")))
      (or (a-some (a-field snapshot "panes" #f)) '())))
  (define status (a-agent-status row))
  (define hook (a-field (a-field snapshot "hooks" #f) key #f))
  (define phase (a-field (hash "working" "Busy" "needs input" "Waiting" "idle" "Idle") status #f))
  (define reported (and phase (equal? phase (a-field hook "phase" #f))))
  ; The canonical waiting row already checks summary freshness against the current screen.
  (define summary (and (not reported) (equal? status "needs input")
      (a-some (a-field (a-field snapshot "summaries" #f) key #f))))
  (define task (one-line (a-field pane "title" "")))
  (define detail (one-line (if summary (a-field summary "text" #f) (and reported
          (cond ((equal? status "working") (a-field hook "detail" #f))
            ((equal? status "needs input") (a-field hook "waiting_on" #f)) (else #f))))))
  (hash "status" status "activity" (if (equal? detail "") task detail) "task" task
    "tracking" (cond ((member status '("held" "exited")) "pane status") (reported "hooks")
      (summary "screen summary")
      ((a-field (a-field snapshot "activity" #f) key #f) "screen activity") (else "no activity yet"))))
(define (a-live-counts)
  (define statuses (map a-agent-status (filter (lambda (row) (a-field row "Agent" #f))
        (hash-ref (a-base-strip) "rows"))))
  (cons (string-append (number->string (length statuses)) (if (= (length statuses) 1) " agent" " agents"))
    (filter (lambda (text) text)
      (map (lambda (status)
          (define count (length (filter (lambda (value) (equal? value status)) statuses)))
          (and (> count 0) (string-append (number->string count) " " status)))
        '("needs input" "working" "idle" "held" "exited" "unknown")))))
