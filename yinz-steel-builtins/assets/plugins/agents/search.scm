(require "./state.scm")
(require "./service.scm")
(require "../shared/archive.scm")
(provide a-clear-search! a-clear-waiting! a-clear-predecessors! a-toggle-waiting!
  a-begin-search! a-search-key! a-cancel-search! a-paste! a-begin-predecessors! a-expire-search!
  a-search-prompts-only?)
(define (a-search-prompts-only?) (starts-with? (trim (a-get "search_query")) "prompt:"))
(define (search-text)
  (define query (trim (a-get "search_query")))
  (if (a-search-prompts-only?) (trim (substring query 7)) query))
(define (strip) (hash "rows" (a-get "rows") "focused" (a-none (a-get "focused")) "summaries" (a-get "summaries")))
(define (a-clear-waiting!)
  (define base (a-get "waiting_base"))
  (if (not base) #f (begin (a-set! "waiting_base" #f) (a-set! "list_scroll" #f) (a-set-rows! base) #t)))
(define (a-clear-predecessors!)
  (define previous (a-get "predecessors"))
  (if (not previous) #f (begin (a-set! "predecessors" #f) (a-set-rows! (hash-ref previous "base")) #t)))
(define (a-clear-search!)
  (a-set! "search_headers" (hash)) (a-set! "search_revisions" (hash)) (a-set! "pending_history_revision" #f)
  (a-set! "applied_search_query" #f) (a-set! "searched_at_ms" #f) (a-inc! "search_request")
  (a-set! "search_pending" #f) (a-set! "search_editing" #f)
  (define base (a-get "search_base"))
  (if (not base) #f
    (let ((keep (a-selection-key)))
      (a-set! "search_base" #f) (a-set! "search_draft" #f) (a-set! "rows" (hash-ref base "rows"))
      (a-set! "summaries" (hash-ref base "summaries")) (a-set! "search_query" "")
      (a-set! "search_error" #f) (a-set! "search_truncated" #f)
      (a-set! "selected" (or (and keep (a-index (lambda (row) (equal? (a-row-key row) keep)) (a-get "rows")))
          (a-index a-selectable? (a-get "rows")) 0))
      (a-inc! "generation") #t)))
(define (a-toggle-waiting!)
  (a-set! "focus" "list") (a-set! "list_scroll" #f)
  (unless (a-clear-waiting!)
    (a-clear-search!) (a-clear-predecessors!)
    (define base (strip)) (define was (a-selection-key))
    (a-set! "waiting_base" base) (a-set-rows! base #f)
    (unless (and was (a-index (lambda (row) (equal? (a-row-key row) was)) (a-get "rows")))
      (a-set! "selected" (or (a-index a-selectable? (a-get "rows")) 0)))) #t)
(define (a-begin-predecessors!)
  (define agent (a-field (a-row) "Agent" #f))
  (if (not agent) #f
    (begin
      (define pane (hash-ref agent "pane_id"))
      (a-clear-waiting!) (a-clear-search!) (a-clear-predecessors!) (a-inc! "predecessor_request")
      (define previous (hash "base" (strip) "pane_id" pane "title" (hash-ref agent "text") "result" #f))
      (a-set! "rows" (a-predecessor-rows previous)) (a-set! "predecessors" previous)
      (a-set! "selected" (or (a-index (lambda (row) (equal? (a-field (a-field row "Agent" #f) "pane_id" #f) pane)) (a-get "rows")) 0))
      (a-inc! "generation")
      (define anchor (a-active-header pane))
      (define result (if anchor (archive-predecessors anchor) (hash "headers" '() "diagnostic" "No recorded active run for this agent")))
      (define selection (a-selection-key))
      (when anchor (set! previous (hash-insert previous "title" (hash-ref anchor "title"))))
      (set! previous (hash-insert previous "result" result)) (a-set! "predecessors" previous)
      (define rows (a-predecessor-rows previous)) (a-set! "rows" rows)
      (a-set! "selected" (or (a-index (lambda (row) (a-field row "Run" #f)) rows)
          (and selection (a-index (lambda (row) (equal? (a-row-key row) selection)) rows)) (a-index a-selectable? rows) 0))
      (a-inc! "generation") (a-follow-selection! selection) #t)))
(define (a-begin-search!)
  (a-clear-waiting!) (a-clear-predecessors!) (a-inc! "search_request") (a-set! "search_pending" #f)
  (unless (a-get "search_base") (a-set! "search_base" (strip)) (a-set! "search_query" ""))
  (when (a-get "search_draft") (a-set! "search_query" (a-get "search_draft")) (a-set! "search_draft" #f))
  (a-set! "search_error" #f) (a-set! "search_editing" #t) #t)
(define (edited!) (a-inc! "search_request") (a-set! "search_pending" #f) (a-set! "search_error" #f))
(define (a-cancel-search!)
  (if (not (a-get "applied_search_query")) (a-clear-search!)
    (begin (a-inc! "search_request") (a-set! "search_pending" #f) (a-set! "search_editing" #f)
      (a-set! "search_query" (a-get "applied_search_query")) (a-set! "search_error" #f) #t)))
(define (hit-first snippet query)
  (define (alnum ch) (char-alphanumeric? ch))
  (define words (split-whitespace query))
  (define word (a-find (lambda (word) (not (equal? word ""))) (map (lambda (word)
          (define chars (string->list word))
          (let loop () (when (and (not (null? chars)) (not (alnum (car chars)))) (set! chars (cdr chars)) (loop)))
          (set! chars (reverse chars))
          (let loop () (when (and (not (null? chars)) (not (alnum (car chars)))) (set! chars (cdr chars)) (loop)))
          (list->string (reverse chars))) words)))
  (define at (and word (a-find (lambda (i)
          (and (<= (+ i (string-length word)) (string-length snippet))
            (foldl (lambda (j okay) (and okay (equal? (string-downcase (string (string-ref snippet (+ i j))))
                    (string-downcase (string (string-ref word j)))))) #t (range (string-length word))))) (range (string-length snippet)))))
  (if (and at (> at 8))
    (let ((text (substring snippet (- at 8) (string-length snippet))))
      (define first (or (a-index (lambda (ch) (not (char-whitespace? ch))) (string->list text)) (string-length text)))
      (string-append "…" (substring text first (string-length text)))) snippet))
(define (apply-search! found)
  (a-set! "search_headers" (hash-ref found "runs"))
  (a-set! "search_pending" #f) (a-set! "search_error" #f) (a-set! "search_truncated" (hash-ref found "truncated"))
  (a-set! "search_editing" #f) (a-set! "applied_search_query" (a-get "search_query")) (a-set! "searched_at_ms" (yinz-wall-clock-ms))
  (define selection (a-selection-key)) (define revision (a-selected-revision))
  (define revisions (hash)) (define rows '())
  (for-each (lambda (hit)
      (define id (hash-ref hit "run_id")) (define header (a-field (hash-ref found "runs") id #f))
      (when header
        (set! revisions (hash-insert revisions id (hash-ref hit "revision")))
        (define snippet (hit-first (hash-ref hit "snippet") (search-text)))
        (set! rows (append rows (list (hash "Run" (hash "run_id" id "kind" (hash-ref header "kind")
                  "title" (if (equal? snippet "") (hash-ref header "title") (string-append snippet " — " (hash-ref header "title")))
                  "worktree" (a-model "WorktreeCell" (list header)) "started_at_ms" (hash-ref header "started_at_ms") "continuation" #f))))))) (hash-ref found "hits"))
  (a-set! "search_revisions" revisions) (a-set! "rows" rows)
  (a-set! "selected" (or (a-index a-selectable? rows) 0)) (a-set! "list_scroll" #f) (a-inc! "generation")
  (unless (a-follow-selection! selection)
    (unless (equal? revision (a-selected-revision)) (a-leave-row!) (a-set! "pending_history_revision" (a-selected-revision))))
  (when (a-get "pending_history_revision") (a-set! "run" #f)) #t)
(define (search!)
  (unless (or (equal? (search-text) "") (a-get "search_pending"))
    (a-inc! "search_request") (a-set! "search_pending" #t)
    (a-set! "search_deadline_ms" (+ (yinz-wall-clock-ms) 15000)) (a-set! "search_error" #f)
    (with-handler (lambda (e) (a-set! "search_pending" #f) (a-set! "search_error" (trim (error-object-message e))))
      (apply-search! (archive-search-runs (search-text) (a-search-prompts-only?))))) #t)
;; Tab is handled by the caller after cancelling, so the normal focus ring stays in one place.
(define (a-search-key! key)
  (define bare (hash-ref key "bare_key")) (define char (a-char key))
  (cond ((equal? bare "Esc") (a-cancel-search!))
    ((equal? bare "Enter") (search!))
    ((a-key? key (hash "Char" "u") '("Ctrl"))
      (unless (equal? (a-get "search_query") "") (a-set! "search_query" "") (edited!)) #t)
    ((equal? bare "Backspace")
      (define query (a-get "search_query"))
      (unless (equal? query "") (a-set! "search_query" (substring query 0 (- (string-length query) 1))) (edited!)) #t)
    ((and char (or (null? (hash-ref key "key_modifiers")) (equal? (hash-ref key "key_modifiers") '("Shift"))))
      (a-set! "search_query" (string-append (a-get "search_query") char)) (edited!) #t)
    (else #f)))
(define (a-paste! text)
  (if (or (a-get "tabs_focused") (not (a-get "search_editing"))) #f
    (let ((line (a-panel "SingleLine" (list text))))
      (if (equal? line "") #f (begin (a-set! "search_query" (string-append (a-get "search_query") line)) (edited!) #t)))))
(define (a-expire-search! now)
  (if (and (a-get "search_editing") (a-get "search_pending") (>= now (a-get "search_deadline_ms")))
    (begin (a-set! "search_pending" #f) (a-set! "search_error" "agent did not answer") #t) #f))
