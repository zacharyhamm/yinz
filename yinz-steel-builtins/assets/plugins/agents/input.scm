(require "./state.scm")
(require "./overlay.scm")
(require "./service.scm")
(require "./history.scm")
(require "./search.scm")
(provide a-on-key! a-on-mouse!)
(define (activate!)
  (define pane (a-selection))
  (when pane (a-hide!) (a-call (hash "FocusTerminalPane" (list pane #f #f)) #f)))
(define (older!) (a-load-more!) (a-refresh-strip!))
(define (step-list! direction)
  (define old (a-get "selected")) (define next (a-step (a-get "rows") old direction))
  (define centered (if (a-get "list_scroll") #t #f))
  (a-set! "selected" next) (a-set! "list_scroll" #f) (or (not (= old next)) centered))
(define (scroll-sheet! delta)
  (define old (a-get "key_sheet_scroll"))
  (if (not old) #f (let ((target (min (max 0 (+ old delta)) (a-get "last_sheet_max_scroll"))))
      (a-set! "key_sheet_scroll" target) (not (= old target)))))
(define (agent-key! key)
  (define bare (hash-ref key "bare_key")) (define char (a-char key))
  (define mods (hash-ref key "key_modifiers")) (define plain (null? mods)) (define shift (equal? mods '("Shift")))
  (define history (equal? (a-get "focus") "history"))
  (cond
    ((and (a-get "reading") (equal? bare "Tab"))
      (if shift (a-set! "tabs_focused" #t) (a-focus-bar!)) #t)
    ((a-get "reading") (a-read-key! key))
    ((a-get "confirming_resume")
      (define armed (a-get "confirming_resume")) (a-set! "confirming_resume" #f)
      (cond ((and plain (equal? char "y"))
          (when (and armed (equal? armed (a-selection-key)) (a-selected-run)) (a-resume-run! (a-selected-run))))
        ((or (equal? bare "Esc") (and plain (equal? char "n"))) #t)
        (else (a-on-key! key))) #t)
    ((a-key? key (hash "Char" "r") '("Ctrl")) (a-broadcast! "agent_refresh" #f) #f)
    ((equal? bare "Tab")
      (cond ((and (not history) (not shift) (> (a-get "last_history_rows") 0)) (a-set! "focus" "history") #t)
        ((and history shift) (a-set! "focus" "list") #t)
        ((and (not history) shift) (a-set! "tabs_focused" #t) #t)
        (else (a-focus-bar!) #f)))
    ((or (equal? bare "Up") (equal? bare "Down"))
      (define direction (if (equal? bare "Up") -1 1))
      (if history (a-step-history! (- direction)) (step-list! direction)))
    ((and (or plain shift) (member char '("D" "F")))
      (when (a-selection)
        (a-call (hash "LoadNewPlugin" (hash "url" "new-agent"
              "config" (hash "caller_terminal_pane_id" (number->string (a-selection))
                (if (equal? char "F") "fork_focused" "duplicate_focused") "true" "overlay" "true" "modal" "true")
              "load_in_background" #f "skip_plugin_cache" #f)) #f)) #f)
    ((and plain (equal? char "w")) (a-toggle-waiting!))
    ((and plain (equal? char "p")) (a-begin-predecessors!))
    ((and plain (equal? char "c") (a-get "predecessors")) (a-clear-predecessors!))
    ((and plain (equal? char "c") (a-get "waiting_base")) (a-clear-waiting!))
    ((and plain (equal? char "/")) (a-begin-search!))
    ((and plain (equal? char "c") (a-get "search_base")) (a-clear-search!))
    ((and plain (member char '("j" "k")))
      (define direction (if (equal? char "k") -1 1))
      (if history (a-step-history! (- direction)) (step-list! direction)))
    ((and plain (equal? char "s")) (a-request-summary!))
    ((and plain (equal? char "r"))
      (if (not (a-selected-run)) #f (begin (a-set! "resume_note" #f) (a-set! "confirming_resume" (a-selection-key)) #t)))
    ((and plain history (equal? char "o")) (a-open-file!))
    ((and plain history (equal? char "y")) (a-copy-event!))
    ((and plain (equal? bare "PageUp")) (a-scroll-history! (a-history-page)))
    ((and plain (equal? bare "PageDown")) (a-scroll-history! (- (a-history-page))))
    ((equal? bare "Esc")
      (if (or (a-clear-predecessors!) (a-clear-waiting!) (and (a-get "search_base") (a-clear-search!))) #t
        (begin (a-hide!) #f)))
    ((equal? bare "Enter")
      (cond (history (a-open-reader!)) ((equal? (a-row) "MoreRuns") (older!))
        ((and (a-selected-run) (> (a-get "last_history_rows") 0)) (a-set! "focus" "history") #t)
        ((a-selection) (activate!) #f) (else #f)))
    (else #f)))
(define (dispatch! key)
  (define bare (hash-ref key "bare_key")) (define plain (null? (hash-ref key "key_modifiers")))
  (cond ((a-get "tabs_focused")
      (if (a-key? key "Tab" '("Shift"))
        (begin (a-keys-to-list!)
          (when (a-get "pane_tabs") (a-call (hash "PaneTabs" (hash "Focus" (hash "id" (a-get "pane_tabs") "bar" #f))) #f))
          (a-take-ring! "history"))
        (begin
          (when (and plain (member bare '("Enter" "Tab" "Esc"))) (a-keys-to-list!))
          (when (and plain (or (member bare '("Left" "Right" "Enter" "Tab" "Esc")) (equal? (a-char key) "r")))
            (a-call (hash "RunAction" (list (hash "Write" (hash "key_with_modifier" key "bytes" '() "is_kitty_keyboard_protocol" #f)) (hash))) #f)))) #t)
    ((a-get "search_editing")
      (if (equal? bare "Tab")
        (let ((draft (a-get "search_query")))
          (a-set! "search_query" "") (a-cancel-search!)
          (a-set! "search_draft" (and (not (equal? draft "")) draft)) (a-set! "focus" "list") (agent-key! key) #t)
        (a-search-key! key)))
    (else
      (define noted (if (a-get "open_note") #t #f)) (a-set! "open_note" #f)
      (define changed (agent-key! key)) (or changed noted))))
(define (a-on-key! key)
  (define bare (hash-ref key "bare_key")) (define char (a-char key))
  (define plain (null? (hash-ref key "key_modifiers")))
  (define question (and (equal? char "?") (or plain (equal? (hash-ref key "key_modifiers") '("Shift")))))
  (cond ((a-get "tabs_focused") (dispatch! key))
    ((a-key? key (hash "Char" "o") '("Ctrl")) (a-reposition!) #f)
    ((and (not (a-get "key_sheet_scroll")) question (not (a-get "search_editing"))) (a-set! "key_sheet_scroll" 0) #t)
    ((a-get "key_sheet_scroll")
      (define page (max 1 (a-sub (a-get "last_sheet_rows") 1)))
      (cond ((or question (and plain (or (equal? bare "Esc") (equal? char "q")))) (a-set! "key_sheet_scroll" #f) #t)
        ((or (equal? bare "Down") (and plain (equal? char "j"))) (scroll-sheet! 1))
        ((or (equal? bare "Up") (and plain (equal? char "k"))) (scroll-sheet! -1))
        ((equal? bare "PageDown") (scroll-sheet! page)) ((equal? bare "PageUp") (scroll-sheet! (- page)))
        ((equal? bare "Tab") (dispatch! key))
        (else (a-set! "key_sheet_scroll" #f) (dispatch! key) #t)))
    (else (dispatch! key))))
(define (scroll-surface! delta)
  (define point (a-get "mouse_position"))
  (define line (and point (a-sub (car point) (a-get "last_label_rows"))))
  (define target (cond ((not point) (a-get "focus")) ((< line (a-get "last_list_rows")) "list")
      ((and (> (a-get "last_history_rows") 0) (<= line (+ (a-get "last_list_rows") (a-get "last_history_rows")))) "history") (else #f)))
  (cond ((equal? target "history") (a-scroll-history! (- delta)))
    ((and target (> (a-get "last_list_rows") 0))
      (define maximum (a-sub (length (a-get "rows")) (a-get "last_list_rows")))
      (define start (min (or (a-get "list_scroll") (a-get "last_window_start")) maximum))
      (define next (min maximum (max 0 (+ start delta))))
      (unless (= start next) (a-set! "list_scroll" next)) (not (= start next)))
    (else #f)))
(define (point-at! line keys)
  (if (and (> (a-get "last_history_rows") 0) (>= line (a-get "last_list_rows")))
    (let* ((was (and (equal? (a-get "focus") "history") keys))
        (body (- line (+ (a-get "last_list_rows") 1 (a-get "last_history_body_top"))))
        (event (and (>= body 0) (< body (a-get "last_history_body_rows")) (a-event-at-row (+ (a-get "last_history_window_start") body)))))
      (a-set! "focus" "history")
      (cond ((not event) (list (not was) #f))
        ((and was (= event (a-get "history_cursor"))) (list #f (list "read" event)))
        (else (define moved (not (= event (a-get "history_cursor"))))
          (a-set! "history_cursor" event) (a-set! "history_cursor_anchor" (a-cursor-anchor))
          (a-set! "history_scrolled" #f) (list (or moved (not was)) #f))))
    (let* ((was (and (equal? (a-get "focus") "list") keys))
        (index (+ (a-get "last_window_start") line)) (row (and (< line (a-get "last_list_rows")) (a-at (a-get "rows") index))))
      (a-set! "focus" "list")
      (if (not (a-selectable? row)) (list (not was) #f)
        (let ((again (and was (= index (a-get "selected")))) (moved (not (= index (a-get "selected")))))
          (a-set! "list_scroll" (a-get "last_window_start")) (a-set! "selected" index)
          (cond ((equal? row "MoreRuns") (older!) (list #t #f))
            ((and (a-field row "Agent" #f) again) (list #f (list "activate" index)))
            (else (list (or moved (not was)) #f))))))))
(define (click-action! action)
  (cond ((equal? (car action) "activate")
      (when (and (= (cadr action) (a-get "selected")) (a-selection)) (activate!)) #f)
    (else (and (equal? (a-get "focus") "history") (= (a-get "history_cursor") (cadr action))
        (not (a-get "reading")) (a-open-reader!)))))
(define (reader-click! row keys)
  (define line (+ (a-reader "scroll") row))
  (define fold (and (< row (a-get "last_reader_rows")) (< line (length (a-reader-lines))) (a-fold-at line)))
  (if (or (not fold) (not (equal? (a-at (a-reader-starts) fold) line))) #f
    (if (and (= (a-reader "cursor") fold) keys) (a-toggle-fold!)
      (begin (a-reader-set! "cursor" fold) #t))))
(define (content-mouse! kind args keys)
  (cond ((a-get "reading")
      (cond ((equal? kind "ScrollUp") (a-scroll-reader! (- (max args 1))))
        ((equal? kind "ScrollDown") (a-scroll-reader! (max args 1)))
        ((and (equal? kind "LeftClick") (>= (car args) 1)) (reader-click! (- (car args) 1) keys)) (else #f)))
    ((and (equal? kind "LeftClick") (>= (car args) 0))
      (a-set! "click_press" #f)
      (define content (- (car args) (a-get "last_label_rows")))
      (if (< content 0) #f
        (let ((point (point-at! content keys)))
          (when (cadr point) (a-set! "click_press" (list args (cadr point)))) (car point))))
    ((equal? kind "Release")
      (define press (a-get "click_press")) (a-set! "click_press" #f)
      (and press (equal? (car press) args) (click-action! (cadr press))))
    ((equal? kind "ScrollUp") (scroll-surface! (- (max args 1))))
    ((equal? kind "ScrollDown") (scroll-surface! (max args 1))) (else #f)))
(define (a-on-mouse! mouse)
  (define kind (if (string? mouse) mouse (car (hash-keys->list mouse))))
  (define args (if (hash? mouse) (hash-ref mouse kind) #f))
  (when (member kind '("Hover" "LeftClick" "RightClick" "Hold" "Release")) (a-set! "mouse_position" args))
  (define point (a-get "mouse_position"))
  (cond ((or (= (a-get "last_rows") 0) (= (a-get "last_cols") 0)) #f)
    ((and point (or (< (car point) 0) (>= (car point) (a-get "last_rows")) (>= (cadr point) (a-get "last_cols"))
          (equal? (car point) (a-get "last_footer_row")))) #f)
    ((a-get "key_sheet_scroll")
      (cond ((member kind '("LeftClick" "RightClick")) (a-set! "key_sheet_scroll" #f) #t)
        ((equal? kind "ScrollUp") (scroll-sheet! (- (max args 1))))
        ((equal? kind "ScrollDown") (scroll-sheet! (max args 1))) (else #f)))
    (else
      (define keys (and (a-keys-here?) (not (a-get "search_editing"))))
      (define left-bar (and (equal? kind "LeftClick") (a-get "tabs_focused")))
      (when left-bar
        (a-set! "tabs_focused" #f)
        (a-set! "bar_focused" (filter (lambda (client) (not (= client (a-get "own_client_id")))) (a-get "bar_focused")))
        (when (a-get "pane_tabs") (a-call (hash "PaneTabs" (hash "Focus" (hash "id" (a-get "pane_tabs") "bar" #f))) #f)))
      (define changed (content-mouse! kind args keys)) (or changed left-bar))))
