(require "./state.scm")
(require "./history.scm")
(require "./search.scm")
(require "./activity.scm")
(provide a-footer a-key-sheet-lines a-search-box a-view-label a-search-failure)
(define tail '(("Ctrl e o" "move the panel (Ctrl-o when locked)") ("?" "shut this sheet")))
(define (hints)
  (define (all keys) (list keys (length keys)))
  (define row (a-row)) (define selection (a-selection-key))
  (cond
    ((a-get "reading")
      (define folding (a-folding?))
      (list (append (list "Esc back" (if folding "j/k fold" "↑↓ scroll") "y copy")
          (if (a-open-target) '("o file") '())
          (if (null? (a-reader "sections")) '() (list (if (a-reader "raw") "v folds" "v source")))
          (if folding '("Enter open") '()) '("PgUp/PgDn page")) 1))
    ((equal? (a-get "focus") "prompt")
      (all (if (a-get "prompt_error") (list (string-append "Send failed: " (a-get "prompt_error")) "Enter retry" "Esc back")
          '("Enter send" "Esc history" "Ctrl-u clear" "Tab bar"))))
    ((a-get "search_editing")
      (all (cond ((a-get "search_pending") '("searching…" "Esc cancel"))
          ((a-get "search_error") '("Enter retry" "prompt: text" "Esc back"))
          (else (append '("Enter apply" "prompt: text" "Esc cancel") (if (equal? (a-get "search_query") "") '() '("Ctrl-u clear")))))))
    ((and selection (equal? selection (a-get "confirming_resume"))) (all '("y resume" "n cancel")))
    (else
      (define waiting (a-waiting-count)) (define toggle (string-append "w waiting (" (number->string waiting) ")"))
      (define search (a-get "search_base")) (define keys '())
      (define note (a-get "resume_note"))
      (when (and note (equal? selection (car note))) (set! keys (list (string-append "resume failed: " (cadr note)))))
      (cond ((a-get "waiting_base") (set! keys (append keys (list "Esc/w all" (string-append (number->string waiting) " waiting")))))
        ((or (a-get "predecessors") search) (set! keys (append keys '("Esc/c clear")))))
      (if (null? (a-get "rows"))
        (all (append keys (cond (search (append (if (> waiting 0) (list toggle) '()) '("/ edit")))
              ((not (a-get "waiting_base")) (append '("/ search") (if (a-get "strip_seen") '("Tab bar") '()) '("Esc hide")))
              (else '()))))
        (begin
          (when (and (> waiting 0) (not (a-get "waiting_base"))) (set! keys (append keys (list toggle))))
          (define history (and (equal? (a-get "focus") "history") (not (equal? (a-get "has_keyboard") #f))))
          (define keep 0)
          (if history
            (begin (set! keys (append keys '("↑↓ event") (if (a-cursor-event) '("Enter read") '())))
              (set! keep (length keys))
              (set! keys (append keys (if (a-cursor-event) '("y copy") '()) (if (a-open-target) '("o file") '()))))
            (begin
              (set! keys (append keys (cond ((a-selection) '("Enter focus"))
                    ((and (a-selected-run) (> (a-get "last_history_rows") 0)) '("Enter history"))
                    ((equal? row "MoreRuns") '("Enter load older runs")) (else '()))))
              (set! keep (length keys))))
          (set! keys (append keys (if (> waiting 0) '("n next input") '()) (cond ((a-selection) '("s summary" "p previous"))
                ((a-selected-run) '("r resume" "s summary")) (else '()))
              (if (and (not (a-get "waiting_base")) (= waiting 0)) (list toggle) '())
              (list (if search "/ edit" "/ search"))
              (cond (history (list "PgUp/PgDn scroll" (if (a-get "last_prompt_row") "Tab prompt" "Tab bar")))
                ((> (a-get "last_history_rows") 0) '("Tab history")) (else '("Tab bar")))))
          (list keys keep))))))
(define (key-sheet)
  (define selection (a-selection-key))
  (cond
    ((a-bar-keys?) '(("←/→" "highlight a tab") ("Enter" "activate the highlighted tab")
        ("Tab/Esc" "return to the active tab's list") ("Shift+Tab" "to the active view's last region")
        ("other keys/paste" "ignored while the bar has focus") ("click a tab/arrow" "activate a tab/browse hidden tabs")))
    ((equal? (a-get "focus") "prompt")
      '(("Enter" "send the prompt to the selected agent") ("Esc / Shift+Tab" "back to history")
        ("Ctrl-u" "clear the prompt") ("Tab" "to the panel tab bar")))
    ((a-get "reading")
      (append (cond ((a-folding?) '(("j/k" "the next or previous fold") ("Enter" "open or shut the fold")
              ("click" "point at a fold; again opens it") ("↑/↓" "scroll a line") ("PgUp/PgDn" "scroll a page")
              ("y" "copy the fold") ("o" "open the file the fold names") ("v" "show the source")))
          ((not (null? (a-reader "sections"))) '(("j/k ↑/↓" "scroll a line") ("PgUp/PgDn" "scroll a page")
              ("y" "copy the whole event") ("o" "open the first file it names") ("v" "back to the folds")))
          (else '(("j/k ↑/↓" "scroll a line") ("PgUp/PgDn" "scroll a page") ("y" "copy the event"))))
        '(("wheel" "scroll") ("Esc" "back to the history") ("Tab" "to the panel tab bar") ("Shift+Tab" "to the tab bar")) tail))
    ((and selection (equal? selection (a-get "confirming_resume")))
      (append '(("y" "resume the run in a new pane") ("n/Esc" "cancel") ("other keys" "cancel, then act as usual")) tail))
    (else
      (define history (equal? (a-get "focus") "history")) (define empty (null? (a-get "rows")))
      (define rows (cond (history '(("↑/↓ j/k" "the previous or next event") ("Enter" "read the event in full")
              ("y" "copy the whole event") ("o" "open the file the event names") ("click" "point at an event; again reads it")
              ("PgUp/PgDn" "scroll the history") ("wheel" "scroll the column under it")))
          (empty '())
          (else (list '("↑/↓ j/k" "choose an agent or a run")
              (list "Enter" (cond ((a-selected-run) "into the run's history") ((equal? (a-row) "MoreRuns") "load older runs") (else "go to the agent; the panel goes")))
              (list "click" (cond ((a-selection) "select; again goes to the agent") ((equal? (a-row) "MoreRuns") "load older runs") (else "select the row")))))))
      (define filtered (or (a-get "search_base") (a-get "predecessors") (a-get "waiting_base")))
      (append rows '(("drag divider" "resize the list and details")
          ("○ / ●" "idle / working") ("! / ?" "needs input / unknown activity") ("■ / ×" "held / exited")) (cond ((a-selection) '(("s" "summarise the agent now") ("p" "the agent's previous runs") ("D / F" "duplicate / fork the agent")))
          ((a-selected-run) '(("r" "resume the run (asks y/n)") ("s" "summarise the run now"))) (else '()))
        (list '("n" "next agent needing input, in the full list")
          (list "w" (if (a-get "waiting_base") "every agent again" "only agents waiting for you"))
          (list "/" (if (a-get "search_base") "edit the search" "search every run"))
          '("prompt: text" "search user prompts only"))
        (if filtered '(("c" "back to the whole list")) '())
        (if (and (not history) (not empty)) '(("PgUp/PgDn" "scroll the history") ("wheel" "scroll the column under it")) '())
        (if (and empty (not (a-get "strip_seen"))) '() (list (list "Tab" (if (or history (= (a-get "last_history_rows") 0)) (if (a-get "last_prompt_row") "into the prompt" "to the panel tab bar") "into the history"))))
        (list (list "Shift+Tab" (if history "back to the list" "to the tab bar")) '("Ctrl-r" "refresh branches, history, and quotas")
          (list "Esc" (if filtered "back to the whole list" "put the panel away"))) tail))))
(define (a-key-sheet-lines cols)
  (define sheet (key-sheet))
  (define width (min (quotient (a-sub cols 1) 2) (foldl (lambda (entry n) (max n (yinz-text-width (car entry)))) 0 sheet)))
  (apply append (map (lambda (entry) (a-panel "KeySheetLines" (list (car entry) (cadr entry) width cols))) sheet)))
(define (a-footer)
  (define cols (a-get "last_cols"))
  (and (>= (a-get "last_rows") 2) (> cols 0)
    (cond ((a-bar-keys?) (a-panel "FitKeys" (list '("←/→ choose" "Enter open" "Tab/Esc list") cols)))
      ((a-get "key_sheet_scroll") (a-panel "FitKeys" (list (if (> (length (a-key-sheet-lines cols)) (- (a-get "last_rows") 1)) '("Esc/? close" "j/k scroll") '("Esc/? close")) cols)))
      (else (define values (hints))
        (if (a-get "search_editing") (a-panel "FitKeys" (list (car values) cols))
          (a-panel "FitHintsMarked" (list (car values) cols (cadr values))))))))
(define (search-label cols)
  (cond ((< cols 12) "/")
    ((< cols 40) (if (a-search-prompts-only?) "User: " "All: "))
    (else (if (a-search-prompts-only?) "Search [User prompts]: " "Search [All messages]: "))))
(define (a-search-box cols)
  (a-panel "InputWindow" (list (search-label cols) (a-get "search_query") (string-length (a-get "search_query")) cols)))
(define (a-view-label)
  (cond ((a-get "search_editing") (car (a-search-box (a-get "last_cols"))))
    ((a-get "predecessors") (string-append "Previous agents: " (hash-ref (a-get "predecessors") "title")))
    ((a-get "search_base")
      (define at (a-get "searched_at_ms")) (define now (yinz-wall-clock-ms))
      (string-append (search-label (a-get "last_cols")) (a-get "search_query")
        (if (and at (>= (- now at) 60000)) (string-append " · " (a-panel "ShortAge" (list now at)) " ago") "")
        (if (a-get "search_truncated") "  more matches omitted" "")))
    ((a-get "waiting_base") "Waiting for you")
    (else #f)))
(define (a-search-failure cols)
  (if (and (a-get "search_editing") (a-get "search_error"))
    (a-panel "WrapWords" (list (string-append "failed: " (a-get "search_error")) cols)) '()))
