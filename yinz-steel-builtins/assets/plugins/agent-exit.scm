;; Keep exited panes restartable; delete only a visible, unchanged, clean, merged checkout.
(yinz-declare-pane)
(define busy #f)
(define confirmation-visible #f)
(define confirming #f)
(define deletion-failed #f)
(define removed-worktree #f)
(define status "Agent exited.")
(define checkout #f)
(define directory #f)
(define failure-status #f)
(define pane #f)
(define pending #f)
(define next-command 0)

(define (get object key fallback)
  (if (hash-contains? object key) (hash-ref object key) fallback))
(define (present value) (and value (not (json-null? value)) (not (equal? value ""))))
(define (error-text error) (string-append "Error: " (trim (error-object-message error))))
(define (command argv success failure timeout)
  (set! next-command (+ next-command 1))
  (set! pending (list (number->string next-command) argv success failure
      (if timeout (+ (yinz-now-ms) timeout) #f)))
  (with-handler (lambda (error) (set! pending #f) (failure (error-text error)))
    (yinz-command (hash "Subscribe" '("RunCommandResult")))
    (yinz-command (hash "RunCommand"
        (list argv (hash) "/" (hash "agent-exit" (number->string next-command)) 1048576 'json-null)))
    (when timeout
      (yinz-command (hash "Subscribe" '("Timer")))
      (yinz-command (hash "SetTimeout" (/ timeout 1000.0))))))

(define (command-result result)
  (when (and pending (equal? (get (list-ref result 3) "agent-exit" #f) (car pending)))
    (define callbacks pending)
    (set! pending #f)
    (define stdout (yinz-decode-utf8 (cadr result)))
    (if (equal? (car result) 0) ((list-ref callbacks 2) stdout)
      (let ((stderr (trim (yinz-decode-utf8 (caddr result)))))
        ((list-ref callbacks 3)
          (string-append "Error: " (car (cadr callbacks)) " failed ("
            (if (json-null? (car result)) "signal" (number->string (car result))) "): "
            (if (equal? stderr "") (trim stdout) stderr)))))))

(define (timer)
  (when (and pending (list-ref pending 4))
    (define remaining (- (list-ref pending 4) (yinz-now-ms)))
    (if (> remaining 0) (yinz-command (hash "SetTimeout" (/ remaining 1000.0)))
      (let ((callbacks pending))
        ;; Stop waiting and ignore late results; Git continues running.
        (set! pending #f)
        ((list-ref callbacks 3)
          (string-append "Error: " (car (cadr callbacks)) " timed out after 10000 ms"))))))

(define (worktrees output)
  (define result '())
  (define current (hash))
  (define (finish)
    (when (and (present (get current "path" #f)) (present (get current "head" #f)))
      (set! result (cons current result)))
    (set! current (hash)))
  (for-each (lambda (field)
      (cond
        ((equal? field "") (finish))
        ((starts-with? field "worktree ") (set! current (hash-insert current "path" (substring field 9))))
        ((starts-with? field "HEAD ") (set! current (hash-insert current "head" (substring field 5))))
        ((starts-with? field "branch refs/heads/")
          (set! current (hash-insert current "branch" (substring field 18))))))
    (split-many output (string (integer->char 0))))
  (finish)
  (reverse result))

(define (find-checkout listed path)
  (if (null? listed) #f
    (if (equal? (hash-ref (car listed) "path") path) (car listed)
      (find-checkout (cdr listed) path))))
(define (list-checkouts path success failure)
  (command (list "git" "-C" path "worktree" "list" "--porcelain" "-z")
    (lambda (output) (success (worktrees output))) failure #f))

(define (inspect-checkout)
  (define (ignore failure) (yinz-request-render))
  (command (list "git" "-C" directory "rev-parse" "--path-format=absolute" "--show-toplevel")
    (lambda (output)
      (define path (trim output))
      (list-checkouts path (lambda (listed)
          (define found (find-checkout listed path))
          (when (and found (not (equal? path (hash-ref (car listed) "path"))))
            (set! checkout (hash-insert found "primary" (hash-ref (car listed) "path"))))
          (yinz-request-render)) ignore))
    ignore #f))

(define (failure message)
  (set! status (string-append "Deletion failed: " message))
  (set! failure-status status)
  (set! deletion-failed #t)
  (set! confirming #f)
  (set! busy #f)
  (yinz-request-render))
(define (refuse message) (failure (string-append "Error: " message)))
(define (confirm-checkout)
  (set! busy #t)
  (set! confirmation-visible #f)
  (set! status "Checking current checkout before deletion...")
  (define (ready)
    (set! confirming #t)
    (set! deletion-failed #f)
    (set! busy #f)
    (yinz-request-render))
  (if removed-worktree (ready)
    (list-checkouts (hash-ref checkout "primary") (lambda (listed)
        (define found (find-checkout listed (hash-ref checkout "path")))
        (if (or (not found) (equal? (hash-ref found "path") (hash-ref (car listed) "path")))
          (refuse "The secondary worktree is unavailable; deletion was refused.")
          (begin
            (set! checkout (hash-insert found "primary" (hash-ref checkout "primary")))
            (ready)))) failure)))

(define (close)
  (when pane (yinz-command (hash "CloseTerminalPane" pane)))
  (yinz-command "CloseSelf"))

(define (delete-branch original)
  (define branch (get original "branch" #f))
  (if branch
    (command (list "git" "-C" (hash-ref original "primary") "update-ref" "-d"
        (string-append "refs/heads/" branch) (hash-ref original "head"))
      (lambda (output) (close)) failure #f)
    (close)))

(define (delete-checkout)
  (define original checkout)
  (set! busy #t)
  (set! status "Deleting worktree...")
  (if removed-worktree (delete-branch original)
    (with-handler (lambda (error) (failure (error-text error)))
      (define config (yinz-command (hash "ProjectConfigRead" (hash "directory" (hash-ref original "path")))))
      (define config-error (get config "error" #f))
      (if (present config-error) (refuse config-error)
        (begin
          (define base (get (hash-ref config "config") "default_branch" "main"))
          (when (json-null? base) (set! base "main"))
          (define references (list (string-append "refs/heads/" base)))
          (define diagnostics '())
          (define (preserved)
            (refuse (string-append "Cannot verify commits merged into local " base
                " or freshly fetched origin/" base "; worktree and branch preserved.\n"
                (string-join (reverse diagnostics) "\n"))))
          (define (remove-worktree)
            (command (list "git" "-C" (hash-ref original "primary") "worktree" "remove" "--"
                (hash-ref original "path"))
              (lambda (output) (set! removed-worktree #t) (delete-branch original)) failure #f))
          (define (prove remaining)
            (if (null? remaining) (preserved)
              (command (list "git" "-C" (hash-ref original "primary") "rev-list" "--max-count=1"
                  (string-append (car remaining) ".." (hash-ref original "head")) "--")
                (lambda (output) (if (equal? (trim output) "") (remove-worktree) (prove (cdr remaining))))
                (lambda (error)
                  (set! diagnostics (cons (string-append (car remaining) ": " error) diagnostics))
                  (prove (cdr remaining))) #f)))
          (define (verify)
            (list-checkouts (hash-ref original "primary") (lambda (listed)
                (define found (find-checkout listed (hash-ref original "path")))
                (cond
                  ((not found) (refuse "The worktree disappeared; deletion was refused."))
                  ((or (equal? (hash-ref found "path") (hash-ref (car listed) "path"))
                      (not (equal? (hash-ref found "head") (hash-ref original "head")))
                      (not (equal? (get found "branch" #f) (get original "branch" #f))))
                    (refuse "The worktree identity changed; deletion was refused."))
                  (else
                    (command (list "git" "-C" (hash-ref original "path") "status" "--porcelain" "--untracked-files=all")
                      (lambda (changes)
                        (if (equal? (trim changes) "") (prove references)
                          (refuse "Worktree has uncommitted changes (including untracked files); worktree and branch preserved.")))
                      failure #f)))) failure))
          (command (list "git" "-C" (hash-ref original "primary") "fetch" "--no-tags" "origin"
              (string-append "+refs/heads/" base ":refs/remotes/origin/" base))
            (lambda (output)
              (set! references (append references (list (string-append "refs/remotes/origin/" base))))
              (verify))
            (lambda (error)
              (set! diagnostics (cons (string-append "Fetch origin/" base ": " error) diagnostics))
              (verify)) 10000))))))

(define (load config)
  (set! pane (if (hash-contains? config "agent_pane_id") (string->number (hash-ref config "agent_pane_id")) #f))
  (set! directory (get config "agent_cwd" #f))
  (yinz-command (hash "Subscribe" '("Key")))
  (cond
    ((or (not (present directory)) (equal? (get config "agent_target" #f) "ssh"))
      (set! status "No local checkout is available."))
    (else
      (with-handler (lambda (error) (set! status (error-text error)))
        (define config (yinz-command (hash "ProjectConfigRead" (hash "directory" directory))))
        (when (present (get config "error" #f)) (set! status (hash-ref config "error"))))
      (if (member (get config "agent_target" #f) '("local" "bubblewrap")) (inspect-checkout)
        (set! status "Checkout identity is unavailable.")))))

(define (key-event event)
  (define key (if (null? (hash-ref event "key_modifiers")) (hash-ref event "bare_key") #f))
  (cond
    (busy #t)
    ((and (equal? key "Delete") checkout)
      (cond ((and confirming confirmation-visible) (delete-checkout))
        ((not confirming) (confirm-checkout))) #t)
    (confirming
      (when (equal? key "Esc")
        (set! confirming #f)
        (set! deletion-failed removed-worktree)
        (set! status (if deletion-failed (or failure-status "Cleanup is incomplete.") "Agent exited."))) #t)
    ((equal? key "Esc") (close) #t)
    ((and (equal? key "Enter") (not removed-worktree))
      (when pane (yinz-command (hash "RerunCommandPane" pane)))
      (yinz-command "CloseSelf") #t)
    (else #t)))

(define (update event)
  (cond
    ((hash-contains? event "RunCommandResult") (command-result (hash-ref event "RunCommandResult")) #f)
    ((hash-contains? event "Timer") (timer) #f)
    ((hash-contains? event "Key") (key-event (hash-ref event "Key")))
    (else #f)))

(define (render rows cols)
  (define (wrap lines) (apply append (map (lambda (line) (yinz-ui-wrap line (max 1 cols))) lines)))
  (define (limit lines count) (take lines (min (length lines) (max 0 count))))
  (define lines '())
  (if (and confirming checkout)
    (begin
      (set! lines (wrap (list
            (if removed-worktree "Worktree removed. Delete remaining branch?" "Delete worktree and branch?")
            (string-append "Worktree: " (hash-ref checkout "path"))
            (string-append "Branch: " (get checkout "branch" "detached HEAD (checkout only)"))
            (string-append "Revision: " (hash-ref checkout "head"))
            "Deletion requires a clean worktree and commits merged into the local base branch or its freshly fetched origin branch."
            "Delete again: confirm deletion. Esc: cancel.")))
      (set! confirmation-visible (and (> cols 0) (<= (length lines) rows)))
      (unless confirmation-visible
        (define footer (wrap '("Deletion disabled: enlarge pane to review." "Esc: cancel.")))
        (set! lines (append (limit lines (- rows (length footer))) footer))))
    (begin
      (set! confirmation-visible #f)
      (define controls (wrap (cond
            (busy '("Waiting for this operation to finish..."))
            (deletion-failed
              (append (list (if removed-worktree "Worktree removed; branch cleanup remains." "Worktree cleanup is incomplete."))
                (if removed-worktree '() '("Enter: restart agent")) '("Delete: retry cleanup  Esc: close pane")))
            (else (append '("Enter: restart agent  Esc: close pane")
                (if checkout '("Delete: Delete worktree & branch and close pane") '()))))))
      (set! lines (append
          (limit (wrap (append (filter (lambda (line) (not (equal? line ""))) (split-many status "\n"))
                (list (string-append "Directory: " (or directory "unknown")))))
            (- rows (length controls))) controls))))
  (define y -1)
  (apply string-append (map (lambda (line)
        (set! y (+ y 1))
        (string-append (string (integer->char 27)) "Pytext;0/" (number->string y) "/"
          (number->string cols) "/1;"
          (string-join (map number->string (bytes->list (string->bytes (yinz-text-truncate (yinz-text-sanitize line) cols)))) ",")
          (string (integer->char 27)) "\\")) (limit lines rows))))
