(require "./testing/common.scm")
(define replies (hash "GetPluginIds" (hash "plugin_id" 7 "client_id" 3 "hostname" "host") "SwitchTabTo" json-null "FocusHostSession" json-null "Reconfigure" json-null "MessageToPlugin" json-null "ChangeFloatingPanesCoordinates" json-null "RenamePluginPane" json-null "BreakPanesToTabWithIndex" json-null "CloseSelf" json-null))
(define active-tab (t-tab (hash "viewport_columns" 120 "display_area_columns" 120)))
(define (frame) (test-render 1 120))
(test "compact bar clipboard messages take precedence and clear on input" (lambda ()
    (t-load "./compact-bar.scm" replies) (assert-equal (trim (frame)) "")
    (test-event (hash "TabUpdate" (list active-tab))) (assert (string-contains? (frame) "main"))
    (for-each (lambda (entry)
        (test-event (hash "CopyToClipboard" (car entry))) (test-event "SystemClipboardFailure") (assert (string-contains? (frame) (cadr entry)))
        (test-event "InputReceived") (assert (string-contains? (frame) "main")))
      '(("System" "Text copied to system clipboard") ("Primary" "Text copied to system primary selection") ("Command" "Text piped to external command")))
    (test-event "SystemClipboardFailure") (assert (string-contains? (frame) "Error using the system clipboard")) (test-event "InputReceived")
    (test-event (hash "TabUpdate" (list (t-merge active-tab (hash "name" "ignored" "active" #f))))) (assert (string-contains? (frame) "main"))))
(test "compact bar clicks and wheel scrolling preserve one-based tab navigation" (lambda ()
    (t-load "./compact-bar.scm" replies)
    (test-event (hash "TabUpdate" (list active-tab (t-merge active-tab (hash "position" 1 "tab_id" 1 "name" "second" "active" #f)))))
    (define rendered (frame)) (assert (string-contains? rendered "second"))
    (test-event (hash "Mouse" (hash "LeftClick" (list 0 (t-index rendered "main"))))) (assert-equal (t-named "SwitchTabTo") '())
    (test-event (hash "Mouse" (hash "LeftClick" (list 0 (t-index rendered "second")))))
    (test-event (hash "Mouse" (hash "ScrollUp" 0))) (test-event (hash "Mouse" (hash "ScrollDown" 0)))
    (assert-equal (t-named "SwitchTabTo") (list (hash "SwitchTabTo" 2) (hash "SwitchTabTo" 2) (hash "SwitchTabTo" 1)))
    (test-event (hash "ModeUpdate" (t-mode (hash "session_name" "child" "session_ancestry" '("parent") "host_fullscreen" #t))))
    (define nested (frame)) (assert (string-contains? nested "parent"))
    (test-event (hash "Mouse" (hash "LeftClick" (list 0 (t-index nested "parent"))))) (assert-equal (t-last (test-commands)) "FocusHostSession")))
(test "compact bar launches persisted tooltips only for its own client and active tab" (lambda ()
    (t-load "./compact-bar.scm" replies (hash "tooltip" "Ctrl y")) (assert-equal (length (t-named "Reconfigure")) 1)
    (test-event (hash "TabUpdate" (list active-tab)))
    (define pane (hash "id" 7 "is_plugin" #t "is_focused" #f "is_fullscreen" #f "is_floating" #f "is_suppressed" #f "is_stack_list_member" #f "title" "compact-bar" "exited" #f "exit_status" json-null "is_held" #f "restart_error" json-null "pane_x" 0 "pane_content_x" 0 "pane_y" 0 "pane_content_y" 0 "pane_rows" 1 "pane_content_rows" 1 "pane_columns" 120 "pane_content_columns" 120 "cursor_coordinates_in_pane" json-null "terminal_command" json-null "plugin_url" "yinz:compact-bar" "is_selectable" #f "index_in_pane_group" (hash) "default_fg" json-null "default_bg" json-null "cwd" json-null "host" json-null "target" "Local" "agent" json-null))
    (define (panes tab) (test-event (hash "PaneUpdate" (hash "panes" (hash tab (list pane))))))
    (panes "0") (test-pipe (hash "name" "toggle_tooltip" "payload" "3" "is_private" #f)) (test-pipe (hash "name" "toggle_tooltip" "payload" "4"))
    (panes "1") (test-pipe (hash "name" "toggle_tooltip" "payload" "3")) (assert-equal (t-named "MessageToPlugin") '())
    (panes "0") (test-pipe (hash "name" "toggle_tooltip" "payload" "3"))
    (define messages (t-named "MessageToPlugin")) (assert-equal (length messages) 1)
    (define message (hash-ref (car messages) "MessageToPlugin"))
    (assert-equal (hash-ref message "message_name") "toggle_persisted_tooltip")
    (assert-equal (hash-ref (hash-ref message "plugin_config") "is_tooltip") "true")
    (assert-equal (hash-ref (hash-ref message "message_args") "persist") "")
    (test-event (hash "ModeUpdate" (t-mode (hash "mode" "Pane")))) (assert-equal (length (t-named "MessageToPlugin")) 2)
    (test-event (hash "ModeUpdate" (t-mode (hash "mode" "Locked")))) (test-event (hash "ModeUpdate" (t-mode))) (assert-equal (length (t-named "MessageToPlugin")) 2)))
(test "compact tooltip retains initial keys, follows tabs, and closes in normal mode" (lambda ()
    (t-load "./compact-bar.scm" replies (hash "is_tooltip" "true"))
    (test-event (hash "InitialKeybinds" (list (list "Pane" (list (list (t-key (hash "Char" "f")) '("ToggleFocusFullscreen")))))))
    (test-event (hash "ModeUpdate" (t-mode (hash "mode" "Pane")))) (assert (string-contains? (test-render 10 80) "Toggle fullscreen"))
    (test-event (hash "TabUpdate" (list active-tab)))
    (test-event (hash "TabUpdate" (list (hash-insert active-tab "active" #f) (t-merge active-tab (hash "position" 1 "tab_id" 1)))))
    (assert-equal (t-last (t-named "BreakPanesToTabWithIndex")) (hash "BreakPanesToTabWithIndex" (list (list (hash "Plugin" 7)) 1 #f)))
    (test-event (hash "Mouse" (hash "ScrollUp" 0))) (assert-equal (t-named "SwitchTabTo") '())
    (test-event (hash "ModeUpdate" (t-mode))) (assert (member "CloseSelf" (test-commands)))))
(test "compact tooltip persists across modes until toggled again" (lambda ()
    (t-load "./compact-bar.scm" replies (hash "is_tooltip" "true"))
    (test-pipe (hash "name" "toggle_persisted_tooltip")) (test-event (hash "ModeUpdate" (t-mode)))
    (test-event (hash "ModeUpdate" (t-mode (hash "mode" "RenamePane")))) (assert (not (member "CloseSelf" (test-commands))))
    (assert (string-contains? (test-render 10 80) "Renaming pane..."))
    (test-pipe (hash "name" "toggle_persisted_tooltip")) (assert-equal (t-last (test-commands)) "CloseSelf")))
