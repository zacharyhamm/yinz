(require "../project-store/common.scm")
(provide configuration-project-start configuration-project-update configuration-project-render configuration-project-cancel)

(define dialog #f)
(define path-field #f)
(define checking #f)
(define request 0)
(define initial-cwd ".")
(define host-ready #f)
(define waiting-submit #f)
(define new-project? #f)
(define project #f)
(define closed? #f)
(define providers '())
(define offered '())
(define existing-dialog #f)
(define new-dialog #f)
(define existing-path #f)
(define new-path #f)
(define (field id) (yinz-ui-op dialog "TextValue" id))
(define (title step)
  (yinz-command (hash "RenamePluginPane" (list (hash-ref (yinz-command "GetPluginIds") "plugin_id")
        (string-append "First Run Setup Wizard (Step " step "/3)")))))
(define (project-dialog create?)
  (define widget (yinz-ui-dialog "Choose your first project"
      (append (list (yinz-ui-select "mode" "Project" '("Use existing folder" "Create new project") (if create? 1 0))
          (yinz-ui-input "path" (if create? "Parent directory" "Folder or local Git repository") initial-cwd))
        (if create? (list (yinz-ui-input "folder" "New folder name" "")) '())
        (list (yinz-ui-input "name" "Project name (optional)" "")
          (yinz-ui-button "open" (if create? "Create project" "Use folder"))))
      (hash "wrap" #t "message" (if create? "Create a new Git project. The parent directory must already exist."
          "Choose an existing local folder. You can add more projects later."))))
  (yinz-ui-focus! widget "path") widget)
(define (switch-project-mode)
  (set! new-project? (= (yinz-ui-value dialog "mode") 1))
  (yinz-ui-path-cancel! path-field)
  (when (and new-project? (not new-dialog))
    (set! new-dialog (project-dialog #t))
    (set! new-path (yinz-ui-path-field new-dialog "path" "directory" initial-cwd)))
  (set! dialog (if new-project? new-dialog existing-dialog))
  (set! path-field (if new-project? new-path existing-path))
  (yinz-ui-set-value! dialog "mode" (if new-project? 1 0))
  (yinz-ui-focus! dialog "path"))
(define (status text) (yinz-ui-set-status! dialog text))
(define (configuration-project-start)
  (yinz-command (hash "Subscribe" '("Mouse" "PastedText" "RunCommandResult" "BeforeClose" "HostFolderChanged" "FailedToChangeHostFolder")))
  (define ids (yinz-command "GetPluginIds"))
  (set! initial-cwd (ps-get ids "initial_cwd" "."))
  (set! existing-dialog (project-dialog #f))
  (set! dialog existing-dialog)
  (set! existing-path (yinz-ui-path-field dialog "path" "directory" initial-cwd))
  (set! path-field existing-path)
  ;; Mount the real root so /host paths do not collide with plugin mounts such as /tmp.
  (yinz-command (hash "ChangeHostFolder" "/"))
  (title "2"))
(define (configuration-project-cancel)
  (set! closed? #t)
  (when path-field (yinz-ui-path-cancel! path-field))
  (set! waiting-submit #f)
  (set! checking #f))
(define (failed message)
  (set! checking #f)
  (unless closed? (status message) (yinz-request-render)) #t)
(define (fail failure) (failed (trim (error-object-message failure))))
(define (control request success)
  (set! checking "control")
  (yinz-catch (yinz-then (yinz-agent-control request)
      (lambda (response)
        (unless closed?
          (set! checking #f)
          (if (equal? (ps-get response "outcome" "failed") "ok")
            (with-handler fail (success response))
            (failed (ps-get response "message" "The operation failed. Try again.")))
          (yinz-request-render)))) failed) #t)
(define (launch-step saved)
  (set! project saved)
  (set! path-field #f)
  (set! providers (with-handler (lambda (_) '()) (yinz-agent-providers)))
  (set! offered (yinz-agent-model "providers" "WithSnapshot" (list providers "launch" "Offered" '())))
  (set! dialog (yinz-ui-dialog "Start working"
      (list (yinz-ui-select "provider" "Agent provider" offered 0)
        (yinz-ui-button "agent" "Launch agent")
        (yinz-ui-button "terminal" "Open terminal")
        (yinz-ui-button "finish" "Finish without launching"))
      (hash "wrap" #t "message" (string-append (hash-ref project "name") "\n" (hash-ref project "root")))))
  (title "3") #t)
(define (finish pane)
  (set! closed? #t)
  (yinz-command "CloseSelf")
  ;; Closure restores the prior tiled focus; focus the resulting pane afterwards.
  (when pane (yinz-command (hash "FocusTerminalPane" (list pane #f #f)))) #t)
(define (launch-agent)
  (status "Launching agent…")
  (control (hash "Spawn" (hash "spec" (hash "kind" (field "provider") "allow_outside_worktree" #t)
        "cwd" (hash-ref project "root") "project" (hash-ref project "name") "remote_host" json-null))
    (lambda (response)
      (define pane (ps-get (ps-get response "spawned" #f) "pane_id" #f))
      (unless (and (string? pane) (starts-with? pane "terminal_")) (error "Agent launched but its pane was not returned."))
      (finish (string->number (substring pane 9))))))
(define (open-terminal)
  (with-handler fail
    (set! checking "terminal")
    (define pane (yinz-command (hash "OpenTerminalNearPlugin" (hash "path" (string-append "/host" (hash-ref project "root"))))))
    (when (json-null? pane) (error "Project saved, but its shell could not be opened. Try again."))
    (finish (hash-ref pane "Terminal"))))
(define (folder-name)
  (define folder (field "folder"))
  (when (or (equal? (trim folder) "") (member folder '("." "..")) (string-contains? folder "/"))
    (error "Enter a new folder name, without slashes.")) folder)
(define (create-project parent)
  (define folder (folder-name))
  (define name (trim (field "name")))
  ;; First launch can precede any plugin that initializes the shared registry.
  (yinz-data-define-all ps-namespace (ps-model "store" "SharedDefs" json-null))
  (status "Creating project…")
  (control (hash "CreateProject" (hash "name" (if (equal? name "") folder name)
        "destination" (string-append (if (equal? parent "/") "" parent) "/" folder)))
    (lambda (response) (launch-step (hash-ref response "project")))))
(define (submit)
  (if (not host-ready)
    (begin (set! waiting-submit #t) (status "Preparing local folders…") #t)
    (with-handler fail
      (define path (field "path"))
      (when new-project? (folder-name))
      (when (equal? (trim path) "") (error "Enter a project folder or press Ctrl-f to browse."))
      (set! request (+ request 1))
      (set! checking (number->string request))
      (status "Checking project folder…")
      ;; The path is an argv value, never shell source. cd validates directories and
      ;; pwd -P canonicalizes symlinks and relative paths before they enter the registry.
      (yinz-command (hash "RunCommand" (list
            (list "/bin/sh" "-c" "CDPATH= cd -P -- \"$1\" || exit; shift; case \"$1\" in '~') set -- \"$HOME\";; '~/'*) set -- \"$HOME/${1#??}\";; esac; CDPATH= cd -P -- \"$1\" && pwd -P" "yinz-project" initial-cwd path)
            (hash) "/host" (hash "setup_project" checking) json-null json-null))) #t)))
(define (remember root)
  (yinz-data-define-all ps-namespace (ps-model "store" "SharedDefs" json-null))
  (define rows (ps-fetch-all (ps-request "project")))
  (define projects (ps-projects rows))
  (define names (hash-keys->list projects))
  (define existing (filter (lambda (name) (equal? (hash-ref (hash-ref projects name) "root") root)) names))
  (define entered (trim (yinz-ui-op dialog "TextValue" "name")))
  (define parts (filter (lambda (part) (not (equal? part ""))) (split-many root "/")))
  (define name (trim (cond ((not (equal? entered "")) entered) ((pair? existing) (car existing))
        ((pair? parts) (car (reverse parts))) (else "root"))))
  (when (and (member name names) (not (equal? root (hash-ref (hash-ref projects name) "root"))))
    (error "A different folder already uses this project name. Enter another name."))
  ;; PlanRemember carries assertions from these exact rows into the atomic batch.
  (define plan (ps-plan "projects" "PlanRemember" rows name root json-null))
  (ps-apply (cadr plan))
  (launch-step (car plan)))
(define (configuration-project-update event)
  (cond
    (closed? #f)
    ((ps-get event "HostFolderChanged" #f)
      (set! host-ready #t)
      (if waiting-submit (begin (set! waiting-submit #f) (submit)) #t))
    ((and (hash? event) (hash-contains? event "FailedToChangeHostFolder"))
      (status "Could not access local folders. Close setup and try again.") #t)
    ((ps-get event "FailedToWriteConfigToDisk" #f)
      (status "The keybinding preset could not be saved. You can retry it later in Configuration.") #t)
    ((ps-get event "RunCommandResult" #f)
      (define result (hash-ref event "RunCommandResult"))
      (if (and checking (equal? checking (ps-get (list-ref result 3) "setup_project" #f)))
        (with-handler fail
          (set! checking #f)
          (unless (equal? (car result) 0) (error "Could not open that folder. Check that it exists and is readable."))
          (define output (yinz-decode-utf8 (cadr result)))
          (define root (if (ends-with? output "\n") (substring output 0 (- (string-length output) 1)) output))
          (when (equal? root "") (error "Could not resolve the project folder."))
          (if new-project? (create-project root) (remember root))) #f))
    (else
      (define picked (and path-field (not checking) (not waiting-submit) (yinz-ui-path-handle-event path-field event)))
      (cond (picked (when (equal? (hash-ref picked "kind") "error") (status (hash-ref picked "message"))) #t)
        ((and (ps-get event "Key" #f) (equal? (hash-ref event "Key") (hash "bare_key" "Esc" "key_modifiers" '())))
          (configuration-project-cancel) (yinz-command "CloseSelf") #t)
        ((or checking waiting-submit) #f)
        (else
          (define action (cond ((ps-get event "Key" #f) (yinz-ui-handle-key dialog (hash-ref event "Key")))
              ((ps-get event "Mouse" #f) (yinz-ui-handle-mouse dialog (hash-ref event "Mouse")))
              ((ps-get event "PastedText" #f) (yinz-ui-paste! dialog (hash-ref event "PastedText")))
              (else #f)))
          (cond ((not action) #f)
            ((equal? (hash-ref action "kind") "buttonPressed")
              (cond ((not project) (submit))
                ((equal? (hash-ref action "id") "agent") (launch-agent))
                ((equal? (hash-ref action "id") "terminal") (open-terminal))
                (else (finish #f))))
            ((and (equal? (hash-ref action "kind") "fieldChanged") (equal? (hash-ref action "id") "mode"))
              (switch-project-mode) #t)
            ((equal? (hash-ref action "kind") "cancel") (configuration-project-cancel) (yinz-command "CloseSelf") #t)
            (else (hash-ref action "shouldRender"))))))))
(define (configuration-project-render rows cols)
  (yinz-ui-op dialog "SetHelp" (cond (project (if (< cols 30) "Tab Enter Esc" "Tab next · Enter select · Esc skip")) ((< cols 30) "Tab Enter Esc") ((or (< rows 12) (< cols 50)) "^F browse · Tab · Enter · Esc") (else "Ctrl-f browse folder · Tab next · Enter select · Esc skip")))
  (yinz-ui-render dialog (hash "x" 0 "y" 0 "width" cols "height" rows)))
