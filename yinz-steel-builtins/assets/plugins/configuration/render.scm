(require "../bar/keys.scm" "../bar/style.scm" "../bar/default-mode.scm")
(provide configuration-render)

(define (modifier-text modifiers) (if (null? modifiers) "<UNBOUND>" (string-join modifiers "-")))
(define (styled text selected ranges)
  (hash "text" text "selected" selected "levels"
    (map (lambda (level)
        (apply append (map (lambda (span) (range (min (string-length text) (cadr span)) (min (string-length text) (caddr span))))
            (filter (lambda (span) (= (car span) level)) ranges)))) '(0 1 2 3))))
(define (whole text level selected) (styled text selected (if level (list (list level 0 (string-length text))) '())))
(define (at value x y rows cols)
  (if (and (< x cols) (>= y 0))
    (yinz-ui-text value (yinz-ui-coordinates x y json-null json-null)) ""))
(define (list-at items x y rows cols . width)
  (if (and (< x cols) (>= y 0))
    (yinz-ui-nested-list items (yinz-ui-coordinates x y (if (null? width) json-null (car width)) json-null)) ""))
(define (warning state cols)
  (define primary (hash-ref state "primary"))
  (define secondary (hash-ref state "secondary"))
  (cond ((or (> (length primary) 1) (> (length secondary) 1) (member "Super" primary) (member "Super" secondary))
      (if (>= cols 38) "Warning: requires supporting terminal." "Requires supporting terminal"))
    ((and (null? primary) (null? secondary))
      (if (>= cols 49) "Warning: no leaders defined. UI will be disabled." "No leaders. UI will be unusable."))
    (else #f)))
(define (info state x y rows cols)
  (define message (or (hash-ref state "notification") (warning state cols)))
  (if message (at (whole (yinz-text-sanitize message) 3 #f) x y rows cols) ""))
(define (menu state rows cols)
  (if (hash-ref state "setup") ""
    (let* ((long? (>= cols 51)) (first (if long? "Rebind leader keys" "Rebind keys"))
        (second (if long? "Change mode behavior" "Mode behavior")) (second-x (if long? 28 21)))
      (string-append
        (at (hash-insert (whole "<TAB>" 3 #f) "opaque" #t) 0 0 rows cols)
        (string (integer->char 27)) "[0;6H" (bar-fill (or (hash-ref state "mode") (bar-default-mode)))
        (if (> cols 6) (yinz-ui-ribbon (whole first #f (equal? (hash-ref state "screen") "rebind")) (yinz-ui-coordinates 6 0 json-null json-null)) "")
        (if (> cols second-x) (yinz-ui-ribbon (whole second #f (equal? (hash-ref state "screen") "presets")) (yinz-ui-coordinates second-x 0 json-null json-null)) "")))))
(define (help-line candidates rows cols)
  (define choice (let loop ((options candidates))
      (if (or (null? (cdr options)) (<= (string-length (caar options)) cols)) (car options) (loop (cdr options)))))
  (at (styled (car choice) #f (map (lambda (span) (cons 2 span)) (cdr choice))) 0 rows rows cols))
(define (modifier-menu modifiers focus index selected-focus color x y rows cols width)
  (list-at
    (map (lambda (i)
        (define name (list-ref '("Ctrl" "Alt" "Super" "Shift") i))
        (whole name (and (member name modifiers) color) (and (equal? focus selected-focus) (= i index)))) '(0 1 2 3)) x y rows cols width))
(define (rebind state rows cols)
  (define wide? (>= cols 62))
  (define medium? (>= cols 35))
  (define width (if wide? 62 35))
  (define x (quotient (max 0 (- cols width)) 2))
  (define y (quotient (max 0 (- rows 10)) 2))
  (define locked? (hash-ref state "locked"))
  (define primary (hash-ref state "primary"))
  (define secondary (hash-ref state "secondary"))
  (define focus (hash-ref state "focus"))
  (define index (hash-ref state "index"))
  (define secondary-x (+ x (quotient width 2)))
  (define title (cond (locked? (cond (wide? "Rebind leader keys (Non-Colliding preset)") (medium? "Rebind leader keys (Non-Colliding)") (else "Rebind leader keys")))
      (wide? "Rebind leader keys (Default preset)") (else "Rebind leader keys")))
  (define explanation1
    (cond (locked? (cond (wide? "Unlock toggle - used to expose the other modes (eg. PANE, TAB)") (medium? "Unlock toggle - expose other modes") (else "")))
      (wide? "Primary - the modifier used to switch modes (eg. PANE, TAB)") (medium? "Primary - used to switch modes") (else "")))
  (define explanation2
    (cond (locked? (cond (wide? "Secondary modifier - prefixes common actions (eg. New Pane)") (medium? "Secondary modifier - common actions") (else "")))
      (wide? "Secondary - the modifier used for common actions (eg. New Pane)") (medium? "Secondary - common actions") (else "")))
  (define secondary-title (string-append (if wide? (if locked? "Secondary Modifier: " "Secondary: ") "") (modifier-text secondary)))
  (string-append
    (at (whole title 2 #f) x y rows cols)
    (at (styled explanation1 #f (list (list 1 0 (if locked? 13 7)))) x (+ y 2) rows cols)
    (at (styled explanation2 #f (list (list 1 0 (if locked? 18 9)))) x (+ y 3) rows cols)
    (if locked?
      (let* ((leader (hash-ref state "main"))
          (text (string-append (if wide? "Unlock Toggle: " "")
              (cond ((equal? focus "capture") "...") (leader (bar-key-label leader)) (else "<UNBOUND>")))))
        (string-append
          (at (styled text (equal? focus "unlock") (list (list 3 (if wide? 15 0) (string-length text)))) x (+ y 5) rows cols)
          (if (equal? focus "capture")
            (list-at (list (styled "[Enter new key] eg." #f '((3 0 15))) "\"Ctrl g\", \"Alt g\"," "\"Alt ESC\", \"Ctrl SPACE\"") x (+ y 6) rows cols) "")))
      (let ((text (string-append (if wide? "Primary: " "") (modifier-text primary))))
        (string-append
          (at (styled text #f (list (list 3 (if wide? 9 0) (string-length text)))) x (+ y 5) rows cols)
          (modifier-menu primary focus index "primary" 3 x (+ y 6) rows cols (string-length text)))))
    (at (styled secondary-title #f (list (list 0 (if wide? (if locked? 20 11) 0) (string-length secondary-title)))) secondary-x (+ y 5) rows cols)
    (modifier-menu secondary focus index "secondary" 0 secondary-x (+ y 6) rows cols (string-length secondary-title))
    (help-line '(("Help: <←↓↑→> - navigate, <SPACE> - select, <ENTER> - apply, <Ctrl a> - save, <Ctrl c> - reset, <ESC> - close" (6 13) (25 32) (43 50) (60 68) (77 85) (95 100))
        ("Help: <←↓↑→/SPACE> - navigate/select, <ENTER/Ctrl a> - apply/save, <Ctrl c> - reset, <ESC> - close" (6 18) (38 52) (67 76) (85 90))
        ("Help: <←↓↑→>/<SPACE>/<ENTER> select/<Ctrl a> save/<Ctrl c> reset/<ESC>" (6 12) (13 20) (21 28) (36 44) (50 58) (65 70))
        ("<←↓↑→>/<SPACE>/<ENTER>/<Ctrl a>/<Ctrl c>/<ESC>" (0 6) (7 14) (15 22) (23 31) (32 40) (41 46))) rows cols)
    (info state x (+ (quotient (max 0 (- rows 15)) 2) (if (> rows 14) 14 10)) rows cols)))
(define (preset-bullet primary which selected wide? medium?)
  (define n (string-length primary))
  (define title (if (= which 0) "1. Default" (if (or wide? medium?) "2. Unlock First (non-colliding)" "2. Unlock First")))
  (define description
    (if (= which 0)
      (cond (wide? "All modes available directly from the base mode, eg.:") (medium? "Modes available directly, eg.:") (else "Directly, eg.:"))
      (cond (wide? (string-append "Single key modes available after unlocking with " primary " g, eg.:"))
        (medium? (string-append "Single key modes after " primary " g, eg.:"))
        (else (string-append primary " g + single key, eg.:")))))
  (define (example key mode)
    (define text (string-append primary (if (= which 0) " " " g + ") key
        (if (= which 0) (if (or wide? medium?) " - to enter " " - ") (if (or wide? medium?) " to enter " " ")) mode " mode"))
    (define mode-start (+ n (if (= which 0) (if (or wide? medium?) 14 5) (if (or wide? medium?) 16 7))))
    (list (styled text selected (append (list (list 3 0 (+ n 3)) (list 2 mode-start (+ mode-start (string-length mode) (if (if (= which 1) (or wide? medium?) (not (or wide? medium?))) 1 0))))
          (if (= which 1) (list (list 3 (+ n 5) (+ n 7))) '()))) 1))
  (list (whole title 1 selected) (list (whole description #f selected) 1) (example "p" "PANE") (example "t" "TAB")))
(define (presets state rows cols)
  (define primary (modifier-text (hash-ref state "primary")))
  (define secondary (modifier-text (hash-ref state "secondary")))
  (define n (string-length primary))
  (define wide? (>= cols (+ 61 n)))
  (define medium? (>= cols (+ 36 n)))
  (define width (+ n (cond (wide? 61) (medium? 36) (else 26))))
  (define x (quotient (max 0 (- cols width)) 2))
  (define setup? (hash-ref state "setup"))
  (define size (if setup? 18 15))
  (define effective-rows (+ rows (if setup? 8 0)))
  (define base-y (quotient (max 0 (- effective-rows size)) 2))
  (define title-y (max 0 (- (quotient (max 0 (- rows size)) 2) 1)))
  (define selected (hash-ref state "preset"))
  (define leader-text (if wide? (string-append "Leader keys: " primary " - modes, " secondary " - quicknav and shortcuts")
      (string-append "Leaders: " primary ", " secondary)))
  (string-append
    (if setup?
      (string-append
        (at (whole (if wide? "Hi there! How would you like to interact with Yinz?" "Hi there! Which do you prefer?") 2 #f) x title-y rows cols)
        (at (styled (if wide? "Not sure? Press <ENTER> to choose Default." "Not sure? Press <ENTER>") #f '((0 0 10) (2 16 23) (1 34 41))) x (+ title-y 2) rows cols)
        (at (whole (if wide? "Everything can always be changed later." "Can be changed later. Tips appear") #f #f) x (+ title-y 4) rows cols)
        (at (whole (if wide? "Tips appear on screen - you don't need to remember anything." "on screen - no need to remember") #f #f) x (+ title-y 5) rows cols))
      (at (whole (if wide? "Override keybindings with one of the following presets:" "Override keybindings:") 2 #f) x (+ base-y 1) rows cols))
    (list-at (preset-bullet primary 0 (equal? selected 0) wide? medium?) x (+ base-y (if (> effective-rows 14) 3 2)) rows cols)
    (list-at (preset-bullet primary 1 (equal? selected 1) wide? medium?) x (+ base-y (if (> effective-rows 14) 8 6)) rows cols)
    (at (styled leader-text #f
        (if wide? (list '(2 0 12) (list 3 13 (+ n 14)) (list 0 (+ n 23) (+ n 23 (string-length secondary))))
          (list '(2 0 8) (list 3 9 (+ n 10)) (list 0 (+ n 11) (+ n 12 (string-length secondary))))))
      x (+ base-y (if (> effective-rows 14) 13 10)) rows cols)
    (info state x (+ base-y (if (> effective-rows 14) 14 10)) rows cols)
    (help-line (if setup?
        '(("Help: <↓↑> - navigate, <ENTER> - apply & save, <ESC> - close" (6 10) (23 30) (47 51)) ("Help: <↓↑> / <ENTER> / <ESC>" (6 10) (13 20) (23 28)))
        '(("Help: <↓↑> - navigate, <ENTER> - apply, <Ctrl a> - apply & save, <ESC> - close" (6 10) (23 30) (40 48) (65 70)) ("Help: <↓↑> / <ENTER> / <Ctrl a> / <ESC>" (6 10) (13 20) (23 31) (34 39)))) effective-rows cols)))
(define (configuration-render state rows cols)
  (if (or (= rows 0) (= cols 0)) ""
    (string-append (menu state rows cols)
      (if (equal? (hash-ref state "screen") "rebind") (rebind state rows cols) (presets state rows cols)))))
