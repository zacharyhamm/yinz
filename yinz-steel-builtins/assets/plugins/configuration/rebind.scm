(require "../bar/keys.scm")
(provide configuration-rebind-plan configuration-infer-leaders)

(define modes '("Locked" "Normal" "Pane" "Tab" "Resize" "Move" "Search" "Scroll" "Session" "Agent" "Select" "Notifications"))
(define (keymap mode-info mode)
  (if mode-info (bar-mode-keymap mode-info mode) '()))
(define (current-keys mode-info mode actions)
  (map car (filter (lambda (binding) (bar-equal? (cadr binding) actions)) (keymap mode-info mode))))
(define (first-or-false items) (if (null? items) #f (car items)))
(define (configuration-infer-leaders mode-info)
  (define unlock (first-or-false (current-keys mode-info "Locked" (list (bar-switch-mode "Normal")))))
  (define base (if (bar-present? (hash-ref mode-info "base_mode")) (hash-ref mode-info "base_mode") "Normal"))
  (define secondary (first-or-false (current-keys mode-info base (list (bar-new-pane json-null)))))
  (hash "main" unlock
    "primary" (and unlock (hash-ref unlock "key_modifiers"))
    "secondary" (and secondary (hash-ref secondary "key_modifiers"))))
(define (configuration-rebind-plan mode-info primary secondary main locked? save?)
  (define unbind '())
  (define bind '())
  (define (remove! mode key) (set! unbind (cons (list mode key) unbind)))
  (define (bind! mode key actions) (set! bind (cons (list mode key actions) bind)))
  (define (remove-actions! mode actions)
    (for-each (lambda (key) (remove! mode key)) (current-keys mode-info mode actions)))
  (define (bind-secondary! item)
    (define bare (car item))
    (define actions (cadr item))
    (define key (bar-key bare secondary))
    (for-each (lambda (mode) (remove-actions! mode actions)) '("Normal" "Locked"))
    (for-each (lambda (mode) (bind! mode key actions)) '("Normal" "Locked")))
  (define (bind-primary! item)
    (define target (car item))
    (define key (bar-char-key (cadr item) primary))
    (for-each (lambda (mode)
        (for-each (lambda (existing)
            (unless (and (equal? mode target) (member (hash-ref existing "bare_key") '("Enter" "Esc")))
              (remove! mode existing)))
          (current-keys mode-info mode (list (bar-switch-mode (if (equal? mode target) "Normal" target)))))) modes)
    (for-each (lambda (mode)
        (cond ((equal? mode target) (bind! mode key (list (bar-switch-mode "Normal"))))
          ((not (equal? mode "Locked")) (bind! mode key (list (bar-switch-mode target)))))) modes))
  (define (bind-unlock!)
    (define previous (first-or-false (current-keys mode-info "Locked" (list (bar-switch-mode "Normal")))))
    (when previous (for-each (lambda (mode) (remove! mode previous)) modes))
    (for-each (lambda (mode) (bind! mode main (list (bar-switch-mode (if (equal? mode "Locked") "Normal" "Locked"))))) modes))
  (when (and locked? main) (bind-unlock!))
  (for-each bind-secondary!
    (list (list (hash "Char" "n") (list (bar-new-pane json-null)))
      (list (hash "Char" "f") '("ToggleFloatingPanes"))
      (list (hash "Char" "i") (list (bar-direction "MoveTab" "Left")))
      (list (hash "Char" "o") (list (bar-direction "MoveTab" "Right")))
      (list (hash "Char" "h") (list (bar-direction "MoveFocusOrTab" "Left")))
      (list "Left" (list (bar-direction "MoveFocusOrTab" "Left")))
      (list (hash "Char" "l") (list (bar-direction "MoveFocusOrTab" "Right")))
      (list "Right" (list (bar-direction "MoveFocusOrTab" "Right")))
      (list (hash "Char" "j") (list (bar-direction "MoveFocus" "Down")))
      (list "Down" (list (bar-direction "MoveFocus" "Down")))
      (list (hash "Char" "k") (list (bar-direction "MoveFocus" "Up")))
      (list "Up" (list (bar-direction "MoveFocus" "Up")))
      (list (hash "Char" "+") (list (bar-resize "Increase" json-null)))
      (list (hash "Char" "=") (list (bar-resize "Increase" json-null)))
      (list (hash "Char" "-") (list (bar-resize "Decrease" json-null)))
      (list (hash "Char" "[") '("PreviousSwapLayout"))
      (list (hash "Char" "]") '("NextSwapLayout"))))
  (unless locked?
    (for-each bind-primary! '(("Locked" "g") ("Pane" "p") ("Tab" "t") ("Resize" "n") ("Move" "h")
        ("Scroll" "s") ("Session" "o") ("Agent" "e")))
    (for-each (lambda (mode)
        (remove-actions! mode '("Quit"))
        (bind! mode (bar-char-key "q" primary) '("Quit"))) (cdr modes)))
  (hash "keys_to_unbind" (reverse unbind) "keys_to_rebind" (reverse bind) "write_config_to_disk" save?))
