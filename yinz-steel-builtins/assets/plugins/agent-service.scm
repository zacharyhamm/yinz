(require "./agent-service/state.scm")
(require "./agent-service/probes.scm")
(require "./agent-service/runs.scm")
(require "./agent-service/observe.scm")
(require "./agent-service/summaries.scm")
(require "./agent-service/completions.scm")
(require "./agent-service/operations.scm")

(define (load configuration)
  (as-reset!)
  (as-send (hash "Subscribe" '("AgentProvidersChanged")))
  (as-set! "providers" (as-safe (lambda () (as-send "GetAgentProviders")) '()))
  (as-send (hash "Subscribe" '("AgentEvent" "PaneUpdate" "TabUpdate" "CommandChanged" "CwdChanged" "SessionUpdate" "RunCommandResult" "WebRequestResult" "Timer")))
  (as-set! "env" (as-send "GetSessionEnvironmentVariables"))
  (as-set! "host" (hash-ref (as-send "GetPluginIds") "host_id"))
  (as-safe (lambda () (yinz-data-define-all "shared:yinz" (yinz-agent-model "store" "SharedDefs" json-null))) #f)
  (as-bootstrap!)
  (for-each (lambda (entity)
      (define handle (as-log-safe "watch metadata" (lambda () (yinz-data-watch "shared:yinz" (as-entity-request entity) "Rows")) #f))
      (when handle (as-set! "watches" (as-unique (cons (hash-ref handle "watch_id") (as-get "watches")))))) '("project" "agent_assignment" "agent_latch"))
  (as-send (hash "SetTimeout" 5))
  (as-message "agent_hello" json-null json-null (hash)))
(define (update event)
  (when (hash? event)
    (cond
      ((hash-contains? event "AgentProvidersChanged") (as-set! "providers" (hash-ref event "AgentProvidersChanged")))
      ((hash-contains? event "PluginDataChanged")
        (when (member (hash-ref (hash-ref event "PluginDataChanged") "watch_id") (as-get "watches"))
          (as-restore-metadata!) (as-publish! #t)))
      ((hash-contains? event "PaneUpdate") (as-set! "manifest" (hash-ref event "PaneUpdate")) (as-rebuild!) (as-publish! #f))
      ((hash-contains? event "TabUpdate")
        (as-log-safe "remove closed tab assignments" (lambda () (as-call "prune-assignments" (hash-ref event "TabUpdate"))) #f)
        (as-set! "tabs" (hash-ref event "TabUpdate")) (as-rebuild!) (as-publish! #f))
      ((hash-contains? event "CommandChanged")
        (define changed (hash-ref event "CommandChanged")) (define pane (car changed))
        (when (hash-contains? pane "Terminal") (as-call "command" (hash-ref pane "Terminal") (cadr changed) (caddr changed)) (as-publish! #f)))
      ((hash-contains? event "CwdChanged")
        (define changed (hash-ref event "CwdChanged")) (define pane (car changed))
        (when (hash-contains? pane "Terminal")
          (as-record-cwd! (hash-ref pane "Terminal") (cadr changed)) (as-rejoin! "cwds" "cwd")
          (as-call "resolve-repositories") (as-call "refresh-remote") (as-publish! #f)))
      ((hash-contains? event "AgentEvent")
        (define raw (hash-ref event "AgentEvent"))
        (define parsed (as-model "HookEvent" (hash-ref raw "raw")))
        (when (hash-contains? parsed "Ok") (as-call "hook" (hash-ref raw "pane_id") (hash-ref raw "kind") (hash-ref parsed "Ok"))))
      ((hash-contains? event "SessionUpdate")
        (define current (as-find (lambda (session) (hash-ref session "is_current_session")) (car (hash-ref event "SessionUpdate"))))
        (when current (as-set-session! (hash-ref current "name"))))
      ((hash-contains? event "RunCommandResult") (as-call "finish-probe" (hash-ref event "RunCommandResult")))
      ((hash-contains? event "WebRequestResult")
        (define result (hash-ref event "WebRequestResult")) (define context (list-ref result 3))
        (as-call (if (hash-contains? context "complete_id") "finish-completion" "finish-summary") (car result) (caddr result) context))
      ((hash-contains? event "Timer")
        (define elapsed (hash-ref event "Timer"))
        (unless (as-get "bootstrapped") (as-bootstrap!))
        (as-set! "poll-window" (inexact->exact (floor (* (max elapsed 5) 1500))))
        (as-call "observe") (as-call "age-completions") (as-call "repair-commands") (as-call "repair-cwds")
        (as-call "retry-repositories" elapsed) (as-call "refresh-remote")
        (as-set! "git-elapsed" (+ (as-get "git-elapsed") elapsed))
        (when (>= (as-get "git-elapsed") 60)
          (as-set! "git-elapsed" (- (as-get "git-elapsed") (* 60 (floor (/ (as-get "git-elapsed") 60)))))
          (as-call "refresh-repositories"))
        (as-publish! #f) (as-send (hash "SetTimeout" 5)))))
  (as-call "drain") (as-call "persist") #f)
(define (pipe message)
  (define name (hash-ref message "name")) (define payload (hash-ref message "payload")) (define source (hash-ref message "source"))
  (cond
    ((equal? name "agent_action")
      (when (as-present? payload)
        (define parsed (as-model "MutationParse" payload))
        (define request (as-field parsed "Ok" #f))
        (define request-id (if request (hash-ref request "request_id") ""))
        (define authorized (cond
            ((and (hash? source) (hash-contains? source "Cli")) #t)
            ((and (hash? source) (hash-contains? source "Plugin"))
              (as-safe (lambda ()
                  (define snapshot (as-send "GetSessionList"))
                  (as-find (lambda (session)
                      (define plugin (as-field (hash-ref session "plugins") (number->string (hash-ref source "Plugin")) #f))
                      (and (hash-ref session "is_current_session") plugin (equal? (hash-ref plugin "location") "yinz:agents"))) (hash-ref snapshot "live_sessions"))) #f))
            (else #f)))
        (define reply (with-handler (lambda (error) (hash "ok" #f "error" (trim (%async-error error))))
            (unless authorized (error "agent operations require a CLI caller or the builtin Agents panel"))
            (unless request (error (hash-ref parsed "Err")))
            (hash "ok" #t "data" (as-call "operation" (hash-ref request "op") (hash-ref request "args") (hash-ref message "pane_id")))))
        (cond ((and (hash? source) (hash-contains? source "Cli"))
            (as-send (hash "CliPipeOutput" (list (hash-ref source "Cli") (string-append (yinz-json-string reply) "\n"))))
            (as-send (hash "UnblockCliPipeInput" (hash-ref source "Cli"))))
          ((and (hash? source) (hash-contains? source "Plugin") (not (equal? request-id "")))
            (as-message "yinz_rpc_reply" (hash-ref source "Plugin") (yinz-json-string (hash "version" 1 "call_id" request-id "result" reply)) (hash))))))
    ((equal? name "llm_complete") (as-call "complete" message))
    ((equal? name "agent_summarize")
      (when (as-present? payload)
        (define parsed (as-model "SummarizeRequest" payload)) (define request (as-field parsed "Ok" #f))
        (when request
          (cond ((as-present? (hash-ref request "pane_id")) (as-call "summarize-pane" (hash-ref request "pane_id")))
            ((as-present? (hash-ref request "run_id")) (as-call "summarize-run" (hash-ref request "run_id"))))))
      (as-call "persist"))
    ((equal? name "arrange_projects_refresh") (when (and (hash? source) (hash-contains? source "Plugin")) (as-call "arrangement-request" (hash-ref source "Plugin"))))
    ((equal? name "agent_refresh") (as-call "refresh-repositories"))
    ((equal? name "agent_subscribe")
      (when (and (hash? source) (hash-contains? source "Plugin") (not (member (hash-ref source "Plugin") (as-get "subscribers"))))
        (as-set! "subscribers" (append (as-get "subscribers") (list (hash-ref source "Plugin")))))
      (as-publish! #t))) #f)
(define (render rows cols) "")
