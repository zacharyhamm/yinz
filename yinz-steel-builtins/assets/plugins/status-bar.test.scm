(require "./testing/common.scm")
(define replies (hash "GetLocalUtcOffset" 0 "GetYinzVersion" "test" "FsMetadata" json-null "FsWrite" json-null))
(for-each (lambda (failure)
    (test (string-append "status bar keeps drawing when tip cache fails: " failure) (lambda ()
        (define cache (cond [(equal? failure "malformed") "{"] [(equal? failure "invalid counts") "{\"yinz_version\":\"test\",\"cached_data\":{\"quicknav\":-1}}"] [else "{\"yinz_version\":\"test\",\"cached_data\":{\"quicknav\":1}}"] ))
        (when (member failure '("FsMetadata" "FsRead" "FsWrite")) (test-stub-error failure "cache unavailable"))
        (t-load "./status-bar.scm" (t-merge replies (hash "FsMetadata" (hash) "FsRead" (t-utf8 cache))))
        (assert (string-contains? (test-render 1 80) "00:00"))
        (test-event (hash "TabUpdate" (list (t-tab)))) (assert (string-contains? (test-render 2 200) "open new pane"))
        (assert-equal (t-named "SetTimeout") (list (hash "SetTimeout" 60.0)))))) '("FsMetadata" "FsRead" "FsWrite" "malformed" "invalid counts"))
(for-each (lambda (entry)
    (test (string-append "status bar tip cache threshold and version: " (car entry) "/" (number->string (cadr entry))) (lambda ()
        (t-load "./status-bar.scm" (t-merge replies (hash "FsMetadata" (hash) "FsRead" (t-utf8 (yinz-json-string (hash "yinz_version" (car entry) "cached_data" (hash "quicknav" (cadr entry))))))))
        (define writes (t-named "FsWrite")) (assert-equal (length writes) 1)
        (define contents (yinz-json-parse (bytes->string/utf8 (list->bytes (hash-ref (hash-ref (car writes) "FsWrite") "contents")))))
        (assert-equal (hash-ref contents "yinz_version") "test") (assert-equal (hash-ref (hash-ref contents "cached_data") "quicknav") (caddr entry))))) '(("test" 20 21) ("old" 300 2)))
(test "status bar deduplicates timers through repeated Alt and pointer reveals" (lambda ()
    (t-load "./status-bar.scm" replies) (test-render 1 80)
    (for-each (lambda (_) (test-event (hash "ModifiersHeld" (hash "modifiers" '("Alt") "is_live" #f))) (test-event (hash "Mouse" (hash "Hover" '(0 0)))) (test-event (hash "Mouse" (hash "Hover" '(0 65535))))) (range 0 20))
    (assert-equal (t-named "SetTimeout") (list (hash "SetTimeout" 60.0) (hash "SetTimeout" 3.0)))
    (test-advance 3000) (assert-equal (t-last (t-named "SetTimeout")) (hash "SetTimeout" 57.0))
    (test-advance 1000) (assert-equal (length (t-named "SetTimeout")) 3)
    (test-advance 56000) (assert-equal (length (t-named "SetTimeout")) 4) (assert (string-contains? (test-render 1 80) "00:01"))))
(test "status bar refreshes the UTC offset at the next whole hour" (lambda ()
    (t-load "./status-bar.scm" (hash-insert replies "GetLocalUtcOffset" 19800)) (assert (string-contains? (test-render 1 80) "05:30"))
    (test-advance 3599999) (assert-equal (length (t-named "GetLocalUtcOffset")) 1)
    (test-stub "GetLocalUtcOffset" -18000) (test-advance 1) (assert-equal (length (t-named "GetLocalUtcOffset")) 2)
    (assert (string-contains? (test-render 1 80) "20:00"))))
(define to-normal (hash "SwitchToMode" (hash "input_mode" "Normal")))
(define (bind key action) (list (t-key key) (list action to-normal)))
(define done (list (t-key "Enter") (list to-normal)))
(define (pipe-action name) (hash "KeybindPipe" (hash "name" name "payload" json-null "args" json-null "plugin" json-null "plugin_id" json-null "configuration" json-null "launch_new" #f "skip_cache" #f "floating" #f "in_place" json-null "cwd" json-null "pane_title" json-null)))
(test "status bar names the Agent-mode key that moves the panel by its message" (lambda ()
    (t-load "./status-bar.scm" replies (hash "classic" "true")) (test-event (hash "TabUpdate" (list (t-tab))))
    (define other (bind (hash "Char" "m") (pipe-action "something_else")))
    (define move (bind (hash "Char" "o") (pipe-action "agent_strip_reposition")))
    (define (mode bindings) (test-event (hash "ModeUpdate" (t-mode (hash "mode" "Agent" "keybinds" (list (list "Agent" (append bindings (list done)))))))))
    (mode (list other)) (define without (test-render 2 200)) (assert (and (string-contains? without "Select pane") (not (string-contains? without "Move panel"))) without)
    (mode (list other move)) (define frame (test-render 2 200)) (assert (string-contains? frame "<o> Move panel") frame)))
(test "status bar names the Tab-mode arrows for bindings that also leave the mode" (lambda ()
    (t-load "./status-bar.scm" replies (hash "classic" "true")) (test-event (hash "TabUpdate" (list (t-tab))))
    (define bindings (list (bind "Left" "GoToPreviousTab") (bind "Up" "GoToPreviousTab") (bind (hash "Char" "h") "GoToPreviousTab") (bind "Right" "GoToNextTab") (bind "Down" "GoToNextTab") (bind (hash "Char" "l") "GoToNextTab") done))
    (test-event (hash "ModeUpdate" (t-mode (hash "mode" "Tab" "keybinds" (list (list "Tab" bindings))))))
    (define frame (test-render 2 200)) (assert (string-contains? frame "<←→> Change focus") frame)))
(test "status bar clipboard messages clear on input and live Alt release restores the clock" (lambda ()
    (t-load "./status-bar.scm" replies)
    (test-event (hash "ModeUpdate" (t-mode (hash "keybinds" (list (list "Normal" (list
                  (list (t-key (hash "Char" "n") "Alt") (list (hash "NewPane" (hash "direction" json-null "pane_name" json-null "start_suppressed" #f))))
                  (list (t-key (hash "Char" "p") "Ctrl") (list (hash "SwitchToMode" (hash "input_mode" "Pane")))))))))))
    (test-event (hash "ModifiersHeld" (hash "modifiers" '("Alt") "is_live" #t))) (assert (string-contains? (test-render 1 200) "New Pane"))
    (test-event (hash "ModifiersHeld" (hash "modifiers" '() "is_live" #t))) (assert (string-contains? (test-render 1 200) "00:00"))
    (test-event (hash "CopyToClipboard" "System")) (assert (string-contains? (test-render 1 200) "Text copied to system clipboard"))
    (test-event "SystemClipboardFailure") (assert (string-contains? (test-render 1 200) "Text copied to system clipboard"))
    (test-event "InputReceived") (assert (string-contains? (test-render 1 200) "00:00"))
    (test-event "SystemClipboardFailure") (assert (string-contains? (test-render 1 200) "Error using the system clipboard"))))
