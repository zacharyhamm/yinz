---
source: yinz-panes/src/./unit/layout_applier_tests/reapply.rs
expression: "take_pane_state_snapshot(&tiled_panes, &floating_panes, &focus_pane_id,\n&viewport, &display_area,)"
---
VIEWPORT: x=0, y=0, cols=200, rows=50
DISPLAY: cols=200, rows=50
FOCUS: None

TILED PANES (4)
  Terminal(TerminalId(1)):
    geom: x=40, y=0, cols=120, rows=25
    logical_position: 1
    run: Command(vim)
    selectable: true
    title: vim
    borderless: false

  Terminal(TerminalId(2)):
    geom: x=40, y=25, cols=120, rows=25
    logical_position: 3
    run: Command(cargo) args=["watch", "-x", "test"]
    selectable: true
    title: cargo watch -x test
    borderless: false

  Plugin(PluginId(102)):
    geom: x=0, y=0, cols=40, rows=50
    logical_position: 0
    run: Plugin(file:/path/to/filebrowser.scm)
    selectable: true
    title: file:/path/to/filebrowser.scm
    borderless: false

  Plugin(PluginId(103)):
    geom: x=160, y=0, cols=40, rows=50
    logical_position: 2
    run: Plugin(yinz:compact-bar)
    selectable: true
    title: yinz:compact-bar
    borderless: false
