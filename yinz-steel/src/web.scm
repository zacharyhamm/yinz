;; Production authoring helpers over the native HTTP transport.
(define %web-routes '())
(define %web-next 0)
(define %web-active (hash))
(define %web-recent '())
(define %web-prefixes '())
(define %web-pages '())
(define %web-hooks (hash))
(define %web-republishing #f)
(define (yinz-web-json value . status)
  (hash "status" (if (null? status) 200 (car status)) "headers"
    (hash "content-type" "application/json; charset=utf-8" "cache-control" "no-store")
    "body" (yinz-json-string value)))
(define (yinz-web-text text . status)
  (hash "status" (if (null? status) 200 (car status)) "headers"
    (hash "content-type" "text/plain; charset=utf-8" "cache-control" "no-store") "body" text))
(define (yinz-web-html node . status)
  (hash "status" (if (null? status) 200 (car status)) "headers"
    (hash "content-type" "text/html; charset=utf-8" "cache-control" "no-store") "body" (yinz-html node)))
(define (yinz-web-error status code . message)
  (yinz-web-json (hash "error" (if (null? message) (hash "code" code) (hash "code" code "message" (car message)))) status))
(define (yinz-web-redirect path)
  (%web-validate-response (hash "status" 303 "headers" (hash "location" path) "body" "")))
(define (yinz-web-not-modified) (hash "status" 304 "headers" (hash) "body" ""))
(define (yinz-web-query request key . fallback)
  (%async-get (%async-get request "query" (hash)) key (if (null? fallback) #f (car fallback))))
(define (yinz-web-param request key) (%async-get (%async-get request "params" (hash)) key #f))
(define (yinz-web-header request key)
  (%async-get (%async-get request "headers" (hash)) (string-downcase key) #f))
(define (yinz-web-body-json request) (%web-body-json request))
(define (%web-pattern pattern)
  (define parts (%web-split-path pattern))
  (define names '())
  (for-each (lambda (part)
    (when (or (starts-with? part ":") (starts-with? part "*"))
      (define name (substring part 1 (string-length part)))
      (unless (regex-match? (regex "^[a-zA-Z][a-zA-Z0-9_-]*$") name) (error "invalid route parameter"))
      (when (member name names) (error "duplicate route parameter"))
      (set! names (cons name names)))) parts)
  (let check ((remaining parts))
    (unless (null? remaining)
      (when (and (starts-with? (car remaining) "*") (pair? (cdr remaining))) (error "rest parameter must be final"))
      (check (cdr remaining))))
  parts)
(define (yinz-web-route method pattern handler)
  (unless (and (member method '("GET" "HEAD" "POST" "*")) (procedure? handler)) (error "invalid web route"))
  (define parts (%web-pattern pattern))
  (set! %web-next (+ %web-next 1))
  (define id %web-next)
  (define replacement (vector method pattern parts handler id))
  (define replaced #f)
  (set! %web-routes (map (lambda (route)
    (if (and (equal? method (vector-ref route 0)) (equal? pattern (vector-ref route 1)))
        (begin (set! replaced #t) replacement) route)) %web-routes))
  (unless replaced (set! %web-routes (append %web-routes (list replacement))))
  (lambda () (set! %web-routes (filter (lambda (route) (not (= id (vector-ref route 4)))) %web-routes))))
(define (%web-method request registered)
  (cond ((equal? request registered) 3)
        ((and (equal? request "HEAD") (equal? registered "GET")) 2)
        ((equal? registered "*") 1) (else 0)))
(define (%web-match pattern segments)
  (let walk ((parts pattern) (remaining segments) (params (hash)) (score '()))
    (cond
      ((null? parts) (if (null? remaining) (cons (append score '(4)) params) #f))
      ((starts-with? (car parts) "*")
       (cons (append score '(1)) (hash-insert params (substring (car parts) 1 (string-length (car parts))) (string-join remaining "/"))))
      ((null? remaining) #f)
      ((starts-with? (car parts) ":")
       (walk (cdr parts) (cdr remaining) (hash-insert params (substring (car parts) 1 (string-length (car parts))) (car remaining)) (append score '(2))))
      ((equal? (car parts) (car remaining)) (walk (cdr parts) (cdr remaining) params (append score '(3))))
      (else #f))))
(define (%web-greater? left right)
  (cond ((null? right) (pair? left)) ((null? left) #f)
        ((> (car left) (car right)) #t) ((< (car left) (car right)) #f)
        (else (%web-greater? (cdr left) (cdr right)))))
(define (%web-select request)
  (define best #f)
  (for-each (lambda (route)
    (define rank (%web-method (hash-ref request "method") (vector-ref route 0)))
    (when (> rank 0)
      (define matched (%web-match (vector-ref route 2) (filter (lambda (s) (not (equal? s ""))) (hash-ref request "segments"))))
      (when matched
        (define score (append (car matched) (list rank)))
        (when (or (not best) (%web-greater? score (vector-ref best 0)))
          (set! best (vector score route (cdr matched))))))) %web-routes)
  best)
(define (%web-failure failure)
  ;; Keep the error object for deferred source formatting after the VM returns.
  (with-handler (lambda (_) (void)) (%web-diagnostic (%async-original failure)))
  (define typed (%web-error-response (%async-error failure)))
  (yinz-web-error (hash-ref typed "status") (hash-ref typed "code")))
(define (%web-remember id)
  (set! %web-recent (append %web-recent (list id)))
  (when (> (length %web-recent) 1024) (set! %web-recent (cdr %web-recent))))
;; [completed?, handler scope, deadline timer, detach result, detach timer]
(define (%web-complete id token response . send?)
  (unless (vector-ref token 0)
    (define normalized (and (or (null? send?) (car send?)) (with-handler %web-failure (%web-validate-response response))))
    ;; Fence before cleanup or sending: either may throw or invoke cancellation hooks.
    (vector-set! token 0 #t)
    (set! %web-active (hash-remove %web-active id))
    (%web-remember id)
    ((vector-ref token 3))
    ((vector-ref token 4))
    (when (vector-ref token 2) (yinz-cancel! (vector-ref token 2)))
    (%async-scope-close (vector-ref token 1))
    (when normalized
      (with-handler (lambda (failure) (%async-log (string-append "web response send: " (%async-error failure))))
        (yinz-command (hash "HttpRespond" (hash "request_id" id "response" (yinz-json-string normalized))))))))
(define (yinz-web-dispatch request)
  (define id (hash-ref request "id"))
  (unless (or (hash-contains? %web-active id) (member id %web-recent))
    (if (>= (length (hash-keys->list %web-active)) 64)
        (begin (%web-remember id) (yinz-command (hash "HttpRespond" (hash "request_id" id "response" (yinz-json-string (yinz-web-error 503 "busy"))))))
        (begin
          (define scope (%async-scope-new))
          (define token (vector #f scope #f (lambda () (void)) (lambda () (void))))
          (vector-set! scope 2 (lambda (failure) (%web-complete id token (%web-failure failure))))
          (set! %web-active (hash-insert %web-active id token))
          (define remaining (max 0 (min 2147483647 (- (hash-ref request "deadline_ms") (yinz-wall-clock-ms)))))
          (define timer (yinz-sleep remaining))
          (vector-set! token 2 timer)
          (vector-set! token 4 (%async-observe timer (lambda (_) (%web-complete id token #f #f))
            (lambda (_) (%web-complete id token #f #f)) %async-client))
          (if (not (yinz-pending? timer))
              (%web-complete id token (%web-failure "deadline timer registration failed"))
          (if (= remaining 0) (%web-complete id token #f #f)
            (with-handler (lambda (failure) (%web-complete id token (%web-failure failure)))
              (define selected (%web-select request))
              (define result (%async-with-scope scope (lambda ()
                (if selected ((vector-ref (vector-ref selected 1) 3) (hash-insert request "params" (vector-ref selected 2)))
                    (yinz-web-error 404 "not_found")))))
              (if (yinz-deferred? result)
                  (vector-set! token 3 (%async-observe result
                    (lambda (response) (%web-complete id token response))
                    (lambda (failure) (%web-complete id token (%web-failure failure))) %async-client))
                  (%web-complete id token result))))))))
  #f)
(define (%web-close-all)
  (for-each (lambda (id) (when (hash-contains? %web-active id) (%web-complete id (hash-ref %web-active id) #f #f)))
    (hash-keys->list %web-active)))

(vector-set! %async-web-cleanup 0 %web-close-all)

(define (yinz-web-assets prefix directory)
  (%web-public-path prefix #t)
  (when (and (not (member prefix %web-prefixes)) (>= (length %web-prefixes) 4)) (error "too many asset prefixes"))
  (when (ormap (lambda (page) (starts-with? (vector-ref page 0) prefix)) %web-pages) (error "asset prefix contains a page"))
  (yinz-command (hash "HttpAssets" (hash "prefix" prefix "directory" directory)))
  (unless (member prefix %web-prefixes) (set! %web-prefixes (cons prefix %web-prefixes)))
  json-null)
(define (%web-render-page page)
  (define mime (vector-ref page 1))
  (define value ((vector-ref page 2)))
  (define body (cond ((equal? mime "text/html; charset=utf-8") (yinz-html value))
                    ((equal? mime "application/manifest+json") (yinz-json-string value))
                    ((and (equal? mime "text/plain; charset=utf-8") (string? value)) value)
                    (else (error "invalid page MIME or value"))))
  (when (> (utf8-length body) 524288) (error "page exceeds 512 KiB"))
  (hash "path" (vector-ref page 0) "content_type" mime "body" body))
(define (%web-republish pages)
  (when %web-republishing (error "recursive hook/page publication"))
  (set! %web-republishing #t)
  (with-handler (lambda (failure) (set! %web-republishing #f) (raise-error failure))
    (define rendered (map %web-render-page pages))
    (for-each (lambda (page) (yinz-command (hash "HttpPublish" page))) rendered))
  (set! %web-republishing #f))
(define (yinz-web-page path content-type thunk)
  (unless (procedure? thunk) (error "page needs a render thunk"))
  (%web-public-path path #f)
  (when (ormap (lambda (prefix) (starts-with? path prefix)) %web-prefixes) (error "page under asset prefix"))
  (define existing (filter (lambda (page) (not (equal? path (vector-ref page 0)))) %web-pages))
  (when (>= (length existing) 16) (error "too many frozen pages"))
  (define page (vector path content-type thunk))
  (%web-republish (list page))
  (set! %web-pages (append existing (list page)))
  json-null)
(define (yinz-web-hook-define name default)
  (when %web-republishing (error "hook mutation during publication"))
  (unless (and (string? name) (procedure? default)) (error "invalid hook"))
  (define old (%async-get %web-hooks name (cons #f '())))
  (set! %web-hooks (hash-insert %web-hooks name (cons default (cdr old))))
  (%web-republish %web-pages))
(define (yinz-web-hook-wrap! name wrapper)
  (when %web-republishing (error "hook mutation during publication"))
  (unless (procedure? wrapper) (error "hook wrapper must be a function"))
  (define hook (hash-ref %web-hooks name))
  (set! %web-hooks (hash-insert %web-hooks name (cons (car hook) (cons wrapper (cdr hook)))))
  (%web-republish %web-pages))
(define (yinz-web-hook name . arguments)
  (define hook (hash-ref %web-hooks name))
  (define (call wrappers args)
    (if (null? wrappers) (apply (car hook) args)
        (apply (car wrappers) (cons (lambda next-args (call (cdr wrappers) next-args)) args))))
  (call (cdr hook) arguments))
(define (yinz-web-hook-names) (sort (hash-keys->list %web-hooks) string<?))
(define (yinz-web-agent-error->status value)
  (define decoded (if (string? value) (yinz-agent-view-error value) value))
  (define code (%async-get decoded "code" "failed"))
  (cond ((equal? code "invalid") 400) ((equal? code "not_found") 404)
        ((equal? code "target_changed") 409)
        ((and (equal? code "unavailable") (equal? (%async-get decoded "op" #f) "focus") (equal? (%async-get decoded "origin" #f) "native")) 409)
        ((member code '("paused" "unavailable")) 503) (else 502)))
