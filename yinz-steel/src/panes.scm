;; Pane operations observe startup and exit before dispatching a command.
(define (%pane-id pane)
  (define id (if (and (hash? pane) (= (length (hash-keys->list pane)) 1))
                 (%async-get pane "Terminal" #f) pane))
  (unless (and (integer? id) (exact? id) (<= 0 id) (<= id 4294967295))
    (error "agent pane must be a terminal ID fitting u32"))
  id)
(define (%pane-get object key fallback) (%async-get object key fallback))
(define (%pane-duration value)
  (unless (and (number? value) (<= 0 value) (>= 2147483647 value))
    (error "timer duration must be between 0 and 2147483647 milliseconds")) value)
(define (%pane-options value label)
  (unless (hash? value) (error (string-append label " must be an object"))) value)
(define (%pane-cleanup-add operation cleanup)
  (define previous (vector-ref operation 4))
  (vector-set! operation 4 (lambda () (previous) (cleanup))))
(define (%pane-listen operation type callback)
  (define origin %async-client)
  (define release
    (yinz-on-event type (lambda (payload)
      (when (yinz-pending? operation)
        (%async-with-client origin
          (lambda () (with-handler (lambda (failure) (yinz-reject! operation failure))
            (callback payload))))) #f)))
  (%pane-cleanup-add operation release))
(define (%pane-timer milliseconds fire failure)
  (define timer (yinz-sleep milliseconds))
  (%async-observe timer
    (lambda (_) (with-handler failure (fire)))
    (lambda (message) (unless (equal? message "operation cancelled") (failure message)))
    %async-client)
  timer)
(define (%pane-step value)
  (%pane-options value "pane step")
  (define path (%pane-get value "path" #f))
  (when (and path (not (string? path))) (error "path must be a string"))
  (unless (or (and path (not (equal? path ""))) (eq? (%pane-get value "remote_default_shell" #f) #t))
    (error "pane step needs a path or remote_default_shell"))
  (for-each (lambda (key)
    (when (and (hash-contains? value key) (not (string? (hash-ref value key))))
      (error (string-append key " must be a string")))) '("name" "stdin"))
  (when (hash-contains? value "timeoutMs") (%pane-duration (hash-ref value "timeoutMs")))
  (define args (%pane-get value "args" '()))
  (unless (and (list? args) (not (member #f (map string? args)))) (error "args must be strings"))
  (for-each (lambda (key)
    (define found (%pane-get value key json-null))
    (unless (or (json-null? found) (string? found)) (error (string-append key " must be a string or null")))) '("cwd" "remote_host"))
  (when (and (hash-contains? value "remote_default_shell") (not (boolean? (hash-ref value "remote_default_shell"))))
    (error "remote_default_shell must be a boolean"))
  (define target (%pane-get value "target" json-null))
  (unless (or (json-null? target) (equal? target "Local"))
    (%pane-options target "target")
    (unless (= (length (hash-keys->list target)) 1) (error "invalid pane target"))
    (define ssh (%pane-get target "Ssh" #f))
    (define fields (or ssh (%pane-get target "Bubblewrap" #f)))
    (%pane-options fields "target fields")
    (unless (string? (%pane-get fields (if ssh "host" "root") #f)) (error "target needs a host or root")))
  ;; Validate JSON data and detach any caller-owned vectors before queueing.
  (yinz-json-parse (yinz-json-string value)))
(define (%pane-target command)
  (define remote (%pane-get command "remote_host" json-null))
  (define fallback (if (and (string? remote) (not (equal? (trim remote) "")))
                       (hash "Ssh" (hash "host" (trim remote))) "Local"))
  (define raw (%pane-get command "target" json-null))
  (define target (if (json-null? raw) fallback raw))
  (cond [(equal? target "Local") '("Local")]
        [(hash-contains? target "Ssh") (list "Ssh" (hash-ref (hash-ref target "Ssh") "host"))]
        [else (list "Bubblewrap" (hash-ref (hash-ref target "Bubblewrap") "root"))]))
(define (%pane-command step pane)
  (define command (foldl (lambda (key result) (hash-remove result key)) step '("name" "stdin" "timeoutMs")))
  (if (equal? (%pane-get command "cwd" #f) "inherit")
      (let ([info (and pane (yinz-command (hash "GetPaneInfo" pane)))])
        (hash-insert command "cwd"
          (if (and info (not (json-null? info)) (equal? (%pane-target info) (%pane-target command)))
              (%pane-get info "cwd" json-null) json-null)))
      command))
(define (%pane-result id code closed) (hash "paneId" (hash "Terminal" id) "exitCode" code "closed" closed))
(define (%pane-observe operation initial-id context started)
  (define id initial-id)
  (define seen-start #f)
  (define queued '())
  (define (receive type payload)
    (if (eq? id #f) (set! queued (append queued (list (cons type payload))))
        (if (equal? type "PaneClosed")
            (when (equal? (%pane-get payload "Terminal" #f) id)
              (yinz-resolve! operation (%pane-result id json-null #t)))
            (when (and (list? payload) (pair? payload) (equal? (car payload) id)
                       (or (not context)
                           (equal? (%pane-get (car (reverse payload)) "__yinz_pane_step" #f)
                                   (hash-ref context "__yinz_pane_step"))))
              (if (equal? type "CommandPaneExited")
                  (yinz-resolve! operation (%pane-result id (cadr payload) #f))
                  (unless seen-start (set! seen-start #t) (started)))))))
  (for-each (lambda (type) (%pane-listen operation type (lambda (payload) (receive type payload))))
    '("CommandPaneOpened" "CommandPaneReRun" "CommandPaneExited" "PaneClosed"))
  (lambda (pane)
    (set! id (%pane-id pane))
    (define events queued) (set! queued '())
    (for-each (lambda (entry) (when (yinz-pending? operation) (receive (car entry) (cdr entry)))) events)))
(define (yinz-wait-for-pane-exit pane)
  (define operation (yinz-deferred))
  (with-handler (lambda (failure) (yinz-reject! operation failure))
    (define id (%pane-id pane))
    (%pane-observe operation id #f (lambda () (void)))
    (define (exited? info)
      (and (hash? info) (equal? (%pane-get info "id" #f) id)
           (eq? (%pane-get info "is_plugin" #t) #f) (eq? (%pane-get info "exited" #f) #t)))
    (define (accept info)
      (when (exited? info) (yinz-resolve! operation (%pane-result id (%pane-get info "exit_status" json-null) #f))))
    (%pane-listen operation "PaneUpdate" (lambda (manifest)
      (define panes (%pane-get manifest "panes" (hash)))
      (for-each (lambda (tab) (for-each accept (hash-ref panes tab))) (hash-keys->list panes))))
    (define info (yinz-command (hash "GetPaneInfo" (hash "Terminal" id))))
    (if (json-null? info) (yinz-resolve! operation (%pane-result id json-null #t)) (accept info)))
  operation)
(define (yinz-run-in-pane pane value)
  (define operation (yinz-deferred))
  (with-handler (lambda (failure) (yinz-reject! operation failure))
    (define id (%pane-id pane)) (define step (%pane-step value))
    (define context (hash "__yinz_pane_step" (string-append %rpc-prefix ":" (%async-id))))
    (%pane-observe operation id context (lambda ()
      (when (hash-contains? step "stdin")
        (yinz-command (hash "WriteCharsToPaneId" (list (hash-ref step "stdin") (hash "Terminal" id)))))
      (when (hash-contains? step "timeoutMs")
        (define timer (%pane-timer (hash-ref step "timeoutMs")
          (lambda () (yinz-reject! operation "pane wait timed out")) (lambda (failure) (yinz-reject! operation failure))))
        (%pane-cleanup-add operation (lambda () (yinz-cancel! timer))))))
    (yinz-command (hash "RunCommandInPane"
      (hash "pane_id" (hash "Terminal" id) "command" (%pane-command step (hash "Terminal" id)) "context" context "keep_scrollback" #t))))
  operation)

;; A slot names any pane: a terminal ID, or a hash naming a terminal or a plugin pane.
(define (%pane-slot pane)
  (if (and (hash? pane) (= (length (hash-keys->list pane)) 1) (hash-contains? pane "Plugin"))
      (let ([id (hash-ref pane "Plugin")])
        (unless (and (integer? id) (exact? id) (<= 0 id) (<= id 4294967295))
          (error "plugin pane must be a plugin ID fitting u32"))
        (hash "Plugin" id))
      (hash "Terminal" (%pane-id pane))))
(define (yinz-open-plugin-in-place-of pane url . arguments)
  (define operation (yinz-deferred))
  (with-handler (lambda (failure) (yinz-reject! operation failure))
    (define options (%pane-options (if (null? arguments) (hash) (car arguments)) "plugin in place options"))
    (unless (string? url) (error "plugin url must be a string"))
    (yinz-resolve! operation (yinz-command (hash "OpenPluginPaneInPlaceOfPaneId" (hash
      "pane_id" (%pane-slot pane) "plugin_url" url
      "configuration" (%pane-get options "configuration" (hash)) "context" (%pane-get options "context" (hash)))))))
  operation)

;; A sequence handle exposes procedures so its state remains owned by the guest.
(define (yinz-pane-sequence value)
  (define options (%pane-options value "paneSequence options"))
  (define raw-steps (%pane-get options "steps" #f))
  (unless (and (list? raw-steps) (pair? raw-steps)) (error "paneSequence needs nonempty steps"))
  (define steps (map %pane-step raw-steps))
  (for-each (lambda (key)
    (when (and (hash-contains? options key) (not (boolean? (hash-ref options key))))
      (error (string-append key " must be a boolean")))) '("stopOnFailure" "closeOnSuccess" "keepScrollback"))
  (for-each (lambda (key)
    (when (and (hash-contains? options key) (not (procedure? (hash-ref options key))))
      (error (string-append key " must be a function")))) '("onStep" "onDone"))
  (when (and (hash-contains? options "name") (not (string? (hash-ref options "name")))) (error "name must be a string"))
  (define on-cancel (%pane-get options "onCancel" "keep"))
  (unless (member on-cancel '("close" "keep")) (error "onCancel must be close or keep"))
  (define grace (%pane-duration (%pane-get options "killGraceMs" 5000)))
  (define floating (%pane-get options "floating" #f))
  (unless (boolean? floating)
    (%pane-options floating "floating coordinates")
    (for-each (lambda (key)
      (define v (%pane-get floating key json-null))
      (unless (or (json-null? v) (boolean? v)) (error (string-append key " must be a boolean")))) '("pinned" "borderless"))
    (for-each (lambda (key)
      (define v (%pane-get floating key json-null))
      (unless (json-null? v)
        (%pane-options v key)
        (define keys (hash-keys->list v))
        (unless (and (= (length keys) 1) (member (car keys) '("Percent" "Fixed"))
                     (integer? (hash-ref v (car keys))) (exact? (hash-ref v (car keys))) (>= (hash-ref v (car keys)) 0))
          (error (string-append "invalid floating " key))))) '("x" "y" "width" "height")))
  (define pane #f) (define status "running") (define index 0) (define failed-step json-null)
  (define current #f) (define timer #f) (define ending #f) (define codes '())
  (define done (yinz-deferred))
  (define origin %async-client)
  (define (callback key arguments)
    (define callback-procedure (%pane-get options key #f))
    (when callback-procedure
      (define (report failure) (yinz-log (%async-error failure)))
      (with-handler report (%async-track (apply callback-procedure arguments) (lambda (_) (void)) report))))
  (define (clean)
    (when current (define previous current) (set! current #f) (yinz-cancel! previous))
    (when timer (define previous timer) (set! timer #f) (yinz-cancel! previous)))
  (define (failure error)
    (when (yinz-pending? done) (clean) (set! status "failed") (yinz-reject! done error)))
  (define (finish outcome)
    (when (yinz-pending? done)
      (clean) (set! status outcome)
      (with-handler failure
        (when (or (and (equal? outcome "success") (%pane-get options "closeOnSuccess" #f))
                  (and (equal? outcome "cancelled") (equal? on-cancel "close")))
          (yinz-command (hash "CloseTerminalPane" (hash-ref pane "Terminal"))))
        (define result (hash "status" outcome "paneId" (if pane pane json-null) "exitCodes" codes "failedStep" failed-step))
        (callback "onDone" (list result)) (yinz-resolve! done result))))
  (define (exited result)
    (when (yinz-pending? done)
      (clean)
      (if (hash-ref result "closed") (finish "pane_closed")
          (begin
            (define code (hash-ref result "exitCode"))
            (set! codes (append codes (list code)))
            (when (and (json-null? failed-step) (or (and (not ending) (not (equal? code 0))) (equal? ending "failed")))
              (set! failed-step (+ index 1)))
            (callback "onStep" (list (+ index 1) (list-ref steps index) code))
            (cond [ending (finish ending)]
                  [(and (not (json-null? failed-step)) (not (eq? (%pane-get options "stopOnFailure" #t) #f))) (finish "failed")]
                  [else (set! index (+ index 1))
                    (if (= index (length steps)) (finish (if (json-null? failed-step) "success" "failed")) (launch))])))))
  (define (escalate outcome)
    (when (and (equal? status "running") (not ending) (yinz-pending? done))
      ;; A refused first signal leaves the sequence running and retryable.
      (yinz-command (hash "SendSigintToPaneId" pane))
      (set! ending outcome) (set! status (if (equal? outcome "cancelled") "cancelling" "running"))
      (when timer (yinz-cancel! timer))
      (with-handler failure
        (set! timer (%pane-timer grace
          (lambda ()
            (yinz-command (hash "SendSigkillToPaneId" pane))
            (set! timer (%pane-timer grace
              (lambda () (exited (%pane-result (hash-ref pane "Terminal") json-null #f))) failure))) failure)))))
  (define (launch)
    (with-handler failure
      (define step (list-ref steps index))
      (define context (hash "__yinz_pane_step" (string-append %rpc-prefix ":" (%async-id))))
      (set! current (yinz-deferred))
      (define this current)
      (%async-observe this exited
        (lambda (error) (unless (equal? error "operation cancelled") (failure error))) origin)
      (define set-pane (%pane-observe this (and pane (hash-ref pane "Terminal")) context
        (lambda ()
          (when (hash-contains? step "stdin") (yinz-command (hash "WriteCharsToPaneId" (list (hash-ref step "stdin") pane))))
          (when (and (hash-contains? step "timeoutMs") (not ending))
            (set! timer (%pane-timer (hash-ref step "timeoutMs") (lambda () (escalate "failed")) failure))))))
      (define command (%pane-command step pane))
      (if pane
          (yinz-command (hash "RunCommandInPane" (hash "pane_id" pane "command" command "context" context
            "keep_scrollback" (%pane-get options "keepScrollback" #t))))
          (begin
            (set! pane (if floating
              (yinz-command (hash "OpenCommandPaneFloating" (list command (if (eq? floating #t) json-null floating) context)))
              (yinz-command (hash "OpenCommandPane" (list command context)))))
            (when (or (not pane) (json-null? pane)) (error "No pane was returned"))
            (when (hash-contains? options "name") (yinz-command (hash "RenameTerminalPane" (list (%pane-id pane) (hash-ref options "name")))))
            (set-pane pane)))))
  (vector-set! done 4 clean)
  (define handle (hash "done" done
    "paneId" (lambda () (if pane pane json-null)) "status" (lambda () status)
    "push" (lambda (step) (when (and (equal? status "running") (not ending)) (set! steps (append steps (list (%pane-step step))))) json-null)
    "cancel" (lambda () (%async-with-client origin (lambda () (escalate "cancelled"))) json-null)))
  (launch) handle)
;; A plugin gets a pane only when its entry file declares one with a literal top-level form.
;; The host scans the source for these forms before evaluation and checks the result here.
(define %yinz-pane 'undeclared) ; 'undeclared | #t | (key . value)
(define %yinz-pane-sealed #f)
(define (%yinz-pane-set! spec)
  (when %yinz-pane-sealed
    (error "yinz-declare-pane must be a top-level form of the plugin's entry file"))
  (unless (eq? %yinz-pane 'undeclared) (error "a plugin declares its pane once"))
  (set! %yinz-pane spec)
  json-null)
(define (yinz-declare-pane) (%yinz-pane-set! #t))
(define (yinz-declare-pane-unless key value)
  (unless (and (string? key) (string? value))
    (error "yinz-declare-pane-unless takes two string literals"))
  (%yinz-pane-set! (cons key value)))
;; Host-invoked once, after module evaluation and before load. Seals further declarations.
(define (yinz-pane-declared? configuration)
  (set! %yinz-pane-sealed #t)
  (cond [(eq? %yinz-pane 'undeclared) #f]
        [(eq? %yinz-pane #t) #t]
        [else (not (and (hash-contains? configuration (car %yinz-pane))
                        (equal? (hash-ref configuration (car %yinz-pane)) (cdr %yinz-pane))))]))
