;; Deferred values stay inside the interpreter; only commands and replies cross the host boundary.
(define %async-next 0)
(define %async-operations (hash))
(define %async-events (hash))
(define %async-handlers (hash))
(define %async-required (hash))
(define %async-permissions (hash))
(define %async-timers (hash))
(define %async-timer-deadline #f)
(define %async-jobs '())
(define %async-dirty #f)
(define %async-version 0)
(define %async-failure #f)
(define %async-current-error #f)
(define %async-unloading #f)
(define %async-unloaded #f)
(define %async-frames (hash))

(define (%async-get object key fallback)
  (if (and (hash? object) (hash-contains? object key)) (hash-ref object key) fallback))
(define (%async-error error)
  (if (string? error) error (error-object-message error)))
(define (%async-id)
  (set! %async-next (+ %async-next 1))
  (number->string %async-next))
(define (yinz-async-enter client) (set! %async-client client) json-null)
(define (%async-with-client client thunk)
  (define previous %async-client)
  (set! %async-client client)
  (define result
    (with-handler (lambda (failure)
                    (set! %async-client previous)
                    (raise-error failure))
      (thunk)))
  (set! %async-client previous)
  result)
(define (%async-host command permission)
  (%trace-command command)
  (if %async-client
      (%async-native-command
        (hash "__yinz_runtime"
          (hash "client" %async-client "command" command "permission_id" permission)))
      (%async-native-command command)))
(define (yinz-command command)
  (define unsubscribe (%async-get command "Unsubscribe" #f))
  (%async-host
    (if unsubscribe
        (hash "Unsubscribe"
          (filter (lambda (type) (= (%async-get %async-required type 0) 0)) unsubscribe))
        command)
    json-null))
(define (%async-retain type)
  (yinz-command (hash "Subscribe" (list type)))
  (set! %async-required
    (hash-insert %async-required type (+ (%async-get %async-required type 0) 1)))
  (lambda ()
    (set! %async-required
      (hash-insert %async-required type (- (hash-ref %async-required type) 1)))))
(define (%async-invalidate)
  (set! %async-version (+ %async-version 1))
  (set! %async-dirty #t))
(define (yinz-request-render) (%async-invalidate) json-null)
(define (%async-enqueue client thunk)
  (set! %async-jobs (append %async-jobs (list (cons client thunk)))))
(define (%async-drain)
  (unless (null? %async-jobs)
    (define job (car %async-jobs))
    (set! %async-jobs (cdr %async-jobs))
    (%async-with-client (car job) (cdr job))
    (%async-drain)))

;; Keep the original exception privately; public catch callbacks still receive its message.
(define (%async-original failure)
  (if (and (string? failure) %async-current-error
           (equal? failure (%async-error %async-current-error)))
      %async-current-error failure))
(define (%async-with-error exception thunk)
  (define previous %async-current-error)
  (set! %async-current-error exception)
  (define result (with-handler (lambda (failure)
                   (set! %async-current-error previous) (raise-error failure)) (thunk)))
  (set! %async-current-error previous)
  result)
;; [tag, state, result, observers, cleanup, origin client, operation id, exception, trace, cancel]
(define (yinz-deferred)
  (when (>= (length (hash-keys->list %async-operations)) 4096)
    (error "too many pending deferred operations"))
  (define id (%async-id))
  (define deferred (vector 'yinz-deferred "pending" json-null '() (lambda () (void)) %async-client id #f (%trace-task "operation") #f))
  (set! %async-operations (hash-insert %async-operations id deferred))
  deferred)
(define (yinz-deferred? value)
  (and (vector? value) (= (vector-length value) 10)
       (equal? (vector-ref value 0) 'yinz-deferred)))
(define (yinz-pending? value)
  (and (yinz-deferred? value) (equal? (vector-ref value 1) "pending")))
(define (%async-observe deferred success failure client)
  (define observer (vector success failure client))
  (if (yinz-pending? deferred)
      (vector-set! deferred 3 (append (vector-ref deferred 3) (list observer)))
      (%async-notify deferred observer)))
(define (%async-notify deferred observer)
  (%async-enqueue (vector-ref observer 2)
    (lambda ()
      (%async-with-error (vector-ref deferred 7)
        (lambda ()
          ((vector-ref observer (if (equal? (vector-ref deferred 1) "fulfilled") 0 1))
           (vector-ref deferred 2)))))))
(define (%async-settle deferred state value . outcomes)
  (when (yinz-pending? deferred)
    (vector-set! deferred 1 state)
    (vector-set! deferred 2 value)
    (set! %async-operations (hash-remove %async-operations (vector-ref deferred 6)))
    (define cleanup (vector-ref deferred 4))
    (vector-set! deferred 4 (lambda () (void)))
    (with-handler %async-fail
      (%async-with-client (vector-ref deferred 5) cleanup))
    ((vector-ref deferred 8) (if (pair? outcomes) (car outcomes) (if (equal? state "fulfilled") "finished" "failed")))
    (define observers (vector-ref deferred 3))
    (vector-set! deferred 3 '())
    (for-each (lambda (observer) (%async-notify deferred observer)) observers))
  deferred)
(define (yinz-resolve! deferred value)
  (cond
    ((eq? deferred value) (yinz-reject! deferred "a deferred cannot resolve to itself"))
    ((yinz-deferred? value)
     (%async-observe value
       (lambda (result) (yinz-resolve! deferred result))
       (lambda (failure) (yinz-reject! deferred failure))
       (vector-ref deferred 5)))
    (else (%async-settle deferred "fulfilled" value)))
  deferred)
(define (yinz-reject! deferred failure)
  (when (yinz-pending? deferred)
    (define original (%async-original failure))
    (unless (string? original) (vector-set! deferred 7 original)))
  (%async-settle deferred "rejected" (%async-error failure)))
(define (%async-chain value success failure)
  (define result (yinz-deferred))
  (define (receive callback value)
    (with-handler (lambda (error) (yinz-reject! result error))
      (yinz-resolve! result (callback value))))
  (if (yinz-deferred? value)
      (%async-observe value
        (lambda (value) (receive success value))
        (lambda (error)
          (if failure (receive failure error) (yinz-reject! result error)))
        %async-client)
      (%async-enqueue %async-client (lambda () (receive success value))))
  result)
(define (yinz-then value callback)
  (%async-chain value callback #f))
(define (yinz-catch value callback)
  (%async-chain value (lambda (value) value) callback))
(define (%async-force-cancel! deferred) (%async-settle deferred "rejected" "operation cancelled" "cancelled"))
(define (%async-set-cancel! deferred callback) (vector-set! deferred 9 callback))
(define (yinz-cancel! deferred)
  (when (yinz-pending? deferred)
    (define callback (vector-ref deferred 9))
    (if callback (%async-with-client (vector-ref deferred 5) callback)
        (%async-force-cancel! deferred)))
  deferred)
(define (%async-track value success failure)
  (if (yinz-deferred? value)
      (let ((terminal (%trace-task "task")))
        (%async-observe value
          (lambda (result) (terminal "finished") (success result))
          (lambda (error) (terminal "failed") (failure error)) %async-client))
      (success value)))
(define (%async-fail failure)
  (unless %async-failure (set! %async-failure (%async-original failure))))
(define (%async-check)
  (when %async-failure
    (define failure %async-failure)
    (set! %async-failure #f)
    (if (string? failure) (error failure) (raise-error failure))))
(define (yinz-async-poll)
  (%async-drain)
  (%async-check)
  (define dirty %async-dirty)
  (set! %async-dirty #f)
  dirty)
(define (yinz-async-cancel)
  (for-each
    (lambda (id)
      (when (hash-contains? %async-operations id)
        (%async-force-cancel! (hash-ref %async-operations id))))
    (hash-keys->list %async-operations))
  (set! %async-jobs '())
  json-null)

(define (%async-wait type predicate subscribe?)
  (define deferred (yinz-deferred))
  (define id (vector-ref deferred 6))
  (define release (lambda () (void)))
  (vector-set! deferred 4
    (lambda ()
      (set! %async-events (hash-remove %async-events id))
      (release)))
  (with-handler (lambda (failure) (yinz-reject! deferred failure))
    (when subscribe? (set! release (%async-retain type)))
    (set! %async-events (hash-insert %async-events id (vector deferred type predicate))))
  deferred)
(define (yinz-wait-for-event type . predicate)
  (%async-wait type (if (null? predicate) (lambda (payload) #t) (car predicate)) #t))
(define (yinz-wait-for-pipe name . predicate)
  (%async-wait (string-append "pipe:" name)
    (if (null? predicate) (lambda (message) #t) (car predicate)) #f))
(define (yinz-on-event type callback)
  (define release (%async-retain type))
  (define id (%async-id))
  (set! %async-handlers (hash-insert %async-handlers id (cons type callback)))
  (lambda ()
    (when (hash-contains? %async-handlers id)
      (set! %async-handlers (hash-remove %async-handlers id))
      (release))))
(define (%async-deliver type payload waiters handlers)
  (for-each
    (lambda (id)
      (when (hash-contains? %async-events id)
        (define entry (hash-ref %async-events id))
        (when (equal? type (vector-ref entry 1))
          (define deferred (vector-ref entry 0))
          (with-handler (lambda (failure) (yinz-reject! deferred failure))
            (when ((vector-ref entry 2) payload) (yinz-resolve! deferred payload))))))
    waiters)
  (when (equal? type "Timer") (%async-fire-timers))
  (for-each
    (lambda (id)
      (when (hash-contains? %async-handlers id)
        (define handler (hash-ref %async-handlers id))
        (when (equal? type (car handler))
          (%async-track ((cdr handler) payload)
            (lambda (changed) (when (eq? changed #t) (%async-invalidate)))
            %async-fail))))
    handlers))
(define (yinz-async-event event)
  (when (or (string? event) (and (hash? event) (pair? (hash-keys->list event))))
    (define type (if (string? event) event (car (hash-keys->list event))))
    (%async-deliver type (if (string? event) json-null (hash-ref event type))
      (hash-keys->list %async-events) (hash-keys->list %async-handlers)))
  (yinz-async-poll))
(define (yinz-request command event predicate)
  (define deferred (yinz-wait-for-event event predicate))
  (with-handler (lambda (failure) (yinz-reject! deferred failure))
    (when (yinz-pending? deferred) (yinz-command command)))
  deferred)
(define (yinz-wait-for-permissions permissions)
  (define deferred (yinz-deferred))
  (define id (vector-ref deferred 6))
  (define release (lambda () (void)))
  (vector-set! deferred 4
    (lambda () (set! %async-permissions (hash-remove %async-permissions id)) (release)))
  (with-handler (lambda (failure) (yinz-reject! deferred failure))
    (set! release (%async-retain "PermissionRequestResult"))
    (set! %async-permissions (hash-insert %async-permissions id deferred))
    (%async-host (hash "RequestPluginPermissions" permissions) id))
  deferred)
(define (yinz-async-permission id result)
  (when (hash-contains? %async-permissions id)
    (define deferred (hash-ref %async-permissions id))
    (if (equal? (%async-get result "Ok" #f) "Granted")
        (yinz-resolve! deferred json-null)
        (yinz-reject! deferred (%async-get result "Err" "plugin permissions denied"))))
  (yinz-async-poll))

(define (%async-arm-timer)
  (define next #f)
  (for-each (lambda (id)
              (define timer (hash-ref %async-timers id))
              (when (or (not next) (< (cdr timer) (cdr next))) (set! next timer)))
            (hash-keys->list %async-timers))
  (when (and next (or (not %async-timer-deadline) (< (cdr next) %async-timer-deadline)))
    (%async-with-client (vector-ref (car next) 5)
      (lambda ()
        (yinz-command (hash "SetTimeout" (max 0.001 (/ (- (cdr next) (yinz-now-ms)) 1000.0))))))
    (set! %async-timer-deadline (cdr next))))
(define (%async-fire-timers)
  (set! %async-timer-deadline #f)
  (define now (yinz-now-ms))
  (for-each (lambda (id)
              (when (hash-contains? %async-timers id)
                (define timer (hash-ref %async-timers id))
                (when (<= (cdr timer) now) (yinz-resolve! (car timer) json-null))))
            (hash-keys->list %async-timers))
  (%async-arm-timer))
(define (yinz-sleep milliseconds)
  (unless (and (number? milliseconds) (>= milliseconds 0) (>= 2147483647 milliseconds))
    (error "timer duration must be between 0 and 2147483647 milliseconds"))
  (define deferred (yinz-deferred))
  (define id (vector-ref deferred 6))
  (define release (lambda () (void)))
  (vector-set! deferred 4
    (lambda () (set! %async-timers (hash-remove %async-timers id)) (release)))
  (with-handler (lambda (failure) (yinz-reject! deferred failure))
    (set! release (%async-retain "Timer"))
    (set! %async-timers
      (hash-insert %async-timers id (cons deferred (+ (yinz-now-ms) milliseconds))))
    (%async-arm-timer))
  deferred)

(define (%async-render hook arguments)
  (define frame (%async-get %async-frames %async-client #f))
  (unless (and frame (equal? (vector-ref frame 0) arguments))
    (set! frame (vector arguments -1 "" #f #f))
    (set! %async-frames (hash-insert %async-frames %async-client frame)))
  (unless (or (vector-ref frame 3)
              (and (vector-ref frame 4) (= (vector-ref frame 1) %async-version)))
    (define version %async-version)
    (define value (if hook (apply hook arguments) ""))
    (define deferred? (yinz-deferred? value))
    (vector-set! frame 3 deferred?)
    (vector-set! frame 4 deferred?)
    (%async-track value
      (lambda (text)
        (vector-set! frame 3 #f)
        (when (= version %async-version)
          (unless (or (string? text) (eq? text json-null) (void? text))
            (error "render must return a string or a deferred string"))
          (vector-set! frame 2 (if (string? text) text ""))
          (vector-set! frame 1 version))
        (when deferred? (set! %async-dirty #t)))
      (lambda (failure) (vector-set! frame 3 #f) (%async-fail failure))))
  frame)
(define (yinz-async-lifecycle kind hook arguments cleanup)
  (when (equal? kind "load")
    (define trace (%async-get (car arguments) "trace" #f))
    (cond ((equal? trace "true") (yinz-trace #t)) ((equal? trace "false") (yinz-trace #f))))
  (when (equal? kind "update") (yinz-trace-input "event" (car arguments)))
  (%async-check)
  (define waiters (hash-keys->list %async-events))
  (define handlers (hash-keys->list %async-handlers))
  (define (finish-unload)
    (with-handler (lambda (failure)
                    (yinz-log (string-append "unload cleanup failed: " (%async-error failure))))
      (when cleanup (cleanup)))
    (set! %async-unloaded #t))
  (cond
    ((equal? kind "render")
     (define frame (and (not %async-unloading) (%async-render hook arguments)))
     (%async-drain)
     (%async-check)
     (if frame (vector-ref frame 2) ""))
    ((equal? kind "unload")
     (unless %async-unloading
       (set! %async-unloading #t)
       (with-handler (lambda (failure)
                       (yinz-log (string-append "unload failed: " (%async-error failure)))
                       (finish-unload))
         (%async-track (if hook (apply hook arguments) json-null)
           (lambda (value) (finish-unload))
           (lambda (failure)
             (yinz-log (string-append "unload failed: " (%async-error failure)))
             (finish-unload)))))
     (%async-drain)
     json-null)
    (else
     (unless %async-unloading
       (%async-track (if hook (apply hook arguments) json-null)
         (lambda (changed) (when (or (equal? kind "load") (eq? changed #t)) (%async-invalidate)))
         %async-fail))
     (cond
       ((equal? kind "update")
        (define event (car arguments))
        (when (or (string? event) (and (hash? event) (pair? (hash-keys->list event))))
          (define type (if (string? event) event (car (hash-keys->list event))))
          (%async-deliver type (if (string? event) json-null (hash-ref event type)) waiters handlers)))
       ((equal? kind "pipe")
        (define message (car arguments))
        (when (and (hash? message) (hash-contains? message "name"))
          (%async-deliver (string-append "pipe:" (hash-ref message "name")) message waiters '()))))
     (yinz-async-poll))))
(define (yinz-async-unloaded) %async-unloaded)
