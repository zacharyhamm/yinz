;; A path field adds browsing to an ordinary form input. The caller owns the form,
;; routes events here before its other handlers, and cancels on close/unload.
(define %path-input-next 0)
(define (yinz-ui-path-field widget id kind . base-directory)
  (unless (member kind '("file" "directory")) (error "path field kind must be file or directory"))
  (define base (%ui-option base-directory #f))
  (when (and base (not (and (string? base) (not (equal? base "")))))
    (error "path field base directory must be a nonempty string"))
  (vector widget id kind #f base))
(define (yinz-ui-path-cancel! field)
  (define pending (vector-ref field 3))
  (when pending
    (vector-set! field 3 #f)
    (yinz-command (hash "Pick" (hash "Cancel" (hash "request_id" pending "timeout" #f))))))
(define (yinz-ui-path-handle-event field event)
  (define widget (vector-ref field 0))
  (define id (vector-ref field 1))
  (define kind (vector-ref field 2))
  (define pending (vector-ref field 3))
  (define key (%ui-get event "Key" #f))
  (define result (%ui-get event "PickResult" #f))
  (define (reply kind) (hash "kind" kind "id" id "shouldRender" #t))
  (cond
    ((and result pending (equal? pending (%ui-get result "request_id" #f)))
      (vector-set! field 3 #f)
      (yinz-ui-focus! widget id)
      (define answer (hash-ref result "result"))
      (cond ((hash-contains? answer "Err") (hash-insert (reply "error") "message" (hash-ref answer "Err")))
        ((json-null? (hash-ref answer "Ok")) (reply "none"))
        (else (yinz-ui-set-value! widget id (hash-ref answer "Ok")) (reply "fieldChanged"))))
    ((and key (equal? (yinz-ui-focused-id widget) id)
        (equal? (%ui-get key "key_modifiers" '()) '("Ctrl"))
        (equal? (%ui-get key "bare_key" #f) (hash "Char" "f")))
      (if pending (reply "none")
        (with-handler (lambda (failure)
            (vector-set! field 3 #f)
            (hash-insert (reply "error") "message" (trim (error-object-message failure))))
          (define current (yinz-ui-op widget "TextValue" id))
          (define parent (if (equal? kind "directory") current
              (let loop ((chars (reverse (string->list current))))
                (cond ((null? chars) "") ((equal? (car chars) #\/) (list->string (reverse chars)))
                  (else (loop (cdr chars)))))))
          (define base (vector-ref field 4))
          (define root (cond ((or (not base) (starts-with? parent "/")) parent)
              ((equal? parent "") base)
              (else (string-append base (if (ends-with? base "/") "" "/") parent))))
          (set! %path-input-next (+ 1 %path-input-next))
          (define request (string-append "path-field:" (number->string %path-input-next)))
          (vector-set! field 3 request)
          (yinz-command (hash "Subscribe" '("PickResult")))
          (yinz-command (hash "Pick" (hash "Start" (hash "request_id" request
                  "options" (if (equal? root "") (hash "kind" kind) (hash "kind" kind "roots" (list root)))))))
          (reply "none"))))
    ;; Do not let keys intended for the picker submit or edit the underlying form.
    ((and pending (or key (%ui-get event "PastedText" #f) (%ui-get event "Mouse" #f))) (reply "none"))
    (else #f)))
