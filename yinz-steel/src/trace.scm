;; Trace names and lifecycle markers only; arguments, replies and error payloads stay private.
(define %async-client #f)
(define %trace-enabled #f)
(define %trace-next 0)
(define (yinz-trace . enabled)
  (when (> (length enabled) 1) (error "trace accepts one boolean"))
  (define value (if (null? enabled) #t (car enabled)))
  (unless (boolean? value) (error "trace requires a boolean"))
  (set! %trace-enabled value)
  (void))
(define (%trace-marker marker origin)
  (when %trace-enabled
    ;; Diagnostics must never replace a dispatch failure or interrupt cleanup.
    (with-handler (lambda (_) (void))
      (yinz-log (string-append "trace instance=" %rpc-prefix " client="
        (if origin (number->string origin) "null") " " marker)))))
(define (%trace-name name)
  (define encoded (yinz-json-string (substring name 0 (min (string-length name) 200))))
  (apply string-append (map (lambda (char)
    (define code (char->integer char))
    (if (or (<= 127 code 159) (= code 8232) (= code 8233))
        (let ((hex (number->string code 16)))
          (string-append "\\u" (make-string (- 4 (string-length hex)) #\0) hex))
        (string char))) (string->list encoded))))
(define (%trace-command command)
  (when %trace-enabled
    (with-handler (lambda (failure)
                    (%trace-marker "command invalid" %async-client)
                    (raise-error failure))
      (%yinz-validate-command command))
    (define name (if (string? command) command
                    (and (hash? command) (= (length (hash-keys->list command)) 1)
                         (car (hash-keys->list command)))))
    (%trace-marker (if (string? name) (string-append "command " (%trace-name name)) "command invalid") %async-client)))
(define (yinz-trace-input kind value)
  (when %trace-enabled
    (define name (if (equal? kind "pipe")
                     (if (hash? value) (hash-ref value "name") "")
                     (if (string? value) value (if (and (hash? value) (pair? (hash-keys->list value)))
                         (car (hash-keys->list value)) ""))))
    (%trace-marker (string-append kind " " (%trace-name name)) %async-client)))
(define (%trace-task label)
  (set! %trace-next (+ %trace-next 1))
  (define id %trace-next)
  (define origin %async-client)
  (define prefix (string-append label " " (number->string id) " "))
  (%trace-marker (string-append prefix "started") origin)
  (lambda (outcome) (%trace-marker (string-append prefix outcome) origin)))
