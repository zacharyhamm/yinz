;; Widgets own only rendering state. Cursor delivery uses the ordinary permission-aware bridge.
(define (%ui-get object key fallback)
  (if (and (hash? object) (hash-contains? object key)) (hash-ref object key) fallback))
(define (%ui-option options fallback) (if (null? options) fallback (car options)))
(define (%ui-style value)
  (if (string? value) (hash "text" value) value))
(define (yinz-ui-styled text . options)
  (hash-insert (%ui-option options (hash)) "text" text))
(define (yinz-ui-coordinates x y width height . scroll)
  (hash "x" x "y" y "width" width "height" height "scroll" (%ui-option scroll 0)))
(define (%ui-pure op args) (yinz-ui-pure (hash "op" op "args" args)))
(define (yinz-ui-text text . coordinates)
  (%ui-pure "Text" (list (%ui-style text) (%ui-option coordinates json-null))))
(define (yinz-ui-ribbon text . coordinates)
  (%ui-pure "Ribbon" (list (%ui-style text) (%ui-option coordinates json-null))))
(define (yinz-ui-table rows . coordinates)
  (%ui-pure "Table" (list (map (lambda (row) (map %ui-style row)) rows) (%ui-option coordinates json-null))))
(define (yinz-ui-nested-list items . coordinates)
  (%ui-pure "NestedList" (list (map (lambda (item)
    (if (list? item) (list (%ui-style (car item)) (cadr item)) (list (%ui-style item) 0))) items)
    (%ui-option coordinates json-null))))
(define (yinz-ui-list-window count rows selected) (%ui-pure "ListWindow" (list count rows selected)))
(define (yinz-ui-wrap text width) (%ui-pure "Wrap" (list text width)))
(define (yinz-ui-wrap-input text width) (%ui-pure "WrapInput" (list text width)))
(define (yinz-ui-fuzzy-filter options query) (%ui-pure "FuzzyFilter" (list options query)))
(define (yinz-ui-truncate text width . ellipsis) (%ui-pure "Truncate" (list text width (%ui-option ellipsis "…"))))
(define (yinz-ui-pad text width) (%ui-pure "Pad" (list text width)))
(define (yinz-ui-pad-left text width) (%ui-pure "PadLeft" (list text width)))
(define (yinz-ui-center text width) (%ui-pure "Center" (list text width)))
(define (yinz-ui-image-place id columns rows) (%ui-pure "ImagePlace" (list id columns rows)))
(define (yinz-ui-image-row id row columns) (%ui-pure "ImageRow" (list id row columns)))

(define (yinz-ui-input id label value) (hash "kind" "text_input" "id" id "label" label "value" value))
(define (yinz-ui-checkbox id label checked) (hash "kind" "checkbox" "id" id "label" label "value" checked))
(define (yinz-ui-radio id label options selected)
  (hash "kind" "radio_group" "id" id "label" label "options" options "value" selected))
(define (yinz-ui-select id label options selected)
  (hash "kind" "select" "id" id "label" label "options" options "value" selected))
(define (yinz-ui-combo id label options text)
  (hash "kind" "combo" "id" id "label" label "options" options "value" text))
(define (yinz-ui-button id label . options)
  (hash-insert (hash-insert (hash-insert (%ui-option options (hash)) "kind" "button") "id" id) "label" label))
(define (yinz-ui-form fields) (yinz-ui-create (hash "kind" "Form" "fields" fields)))
(define (yinz-ui-dialog title fields . options)
  (yinz-ui-create (hash "kind" "Form" "fields" fields "dialog"
    (hash-insert (%ui-option options (hash)) "title" title))))
(define (yinz-ui-markdown source . options)
  (yinz-ui-create (hash-insert (hash-insert (%ui-option options (hash)) "kind" "Markdown") "source" source)))
(define (yinz-ui-op widget op . arguments)
  (yinz-ui-call widget (if (null? arguments) (hash "op" op) (hash "op" op "args" (car arguments)))))
(define (yinz-ui-value widget id) (yinz-ui-op widget "Value" id))
(define (yinz-ui-values widget) (yinz-ui-op widget "Values"))
(define (yinz-ui-set-value! widget id value) (yinz-ui-op widget "SetValue" (list id value)))
(define (yinz-ui-set-options! widget id options) (yinz-ui-op widget "SetOptions" (list id options)))
(define (yinz-ui-focus! widget id) (yinz-ui-op widget "Focus" id))
(define (yinz-ui-focused-id widget) (yinz-ui-op widget "FocusedId"))
(define (yinz-ui-move-focus! widget forward) (yinz-ui-op widget "MoveFocus" forward))
(define (%ui-unwrap event names)
  (if (null? names) event
    (if (and (hash? event) (hash-contains? event (car names))) (hash-ref event (car names))
      (%ui-unwrap event (cdr names)))))
(define (yinz-ui-handle-key widget key) (yinz-ui-op widget "Key" (%ui-unwrap key '("Key" "InterceptedKeyPress"))))
(define (yinz-ui-handle-mouse widget mouse) (yinz-ui-op widget "Mouse" (%ui-unwrap mouse '("Mouse"))))
(define (yinz-ui-paste! widget text) (yinz-ui-op widget "Paste" text))
(define (yinz-ui-render-buffer widget coordinates) (yinz-ui-op widget "Render" coordinates))
(define (yinz-ui-render widget coordinates)
  (define output (yinz-ui-render-buffer widget coordinates))
  (when (%ui-get output "updateCursor" #f) (yinz-command (hash "ShowCursor" (hash-ref output "cursor"))))
  (hash-ref output "text"))
(define (yinz-ui-lines markdown width) (yinz-ui-op markdown "Lines" width))
(define (yinz-ui-height widget) (yinz-ui-op widget "Height" json-null))
(define (yinz-ui-set-status! dialog status) (yinz-ui-op dialog "SetStatus" status))
(define (yinz-ui-input-op widget id op . args)
  (yinz-ui-op widget "Input" (list id (if (null? args) (hash "op" op) (hash "op" op "args" (car args))))))

(define (yinz-ui-truncate-ansi text width) (yinz-ui-pure (hash "op" "TruncateAnsi" "args" (list text width))))
