;; Agent observation is separate from explicit host-controlled agent requests.
(define %agent-panes (hash))
(define %agent-watching #f)
(define (yinz-agent-cache-event event)
  (when (and (hash? event) (hash-contains? event "PaneUpdate"))
    (define manifest (hash-ref event "PaneUpdate"))
    (define tabs (%async-get manifest "panes" (hash)))
    (set! %agent-panes
      (foldl (lambda (tab cache)
        (foldl (lambda (pane cache)
          (if (%async-get pane "is_plugin" #t) cache
              (hash-insert cache (hash-ref pane "id") pane))) cache (hash-ref tabs tab)))
        (hash) (hash-keys->list tabs))))
  json-null)
(define (%agent-watch)
  (unless %agent-watching (%async-retain "PaneUpdate") (set! %agent-watching #t)))
(define (%agent-operation start)
  (define operation (yinz-deferred))
  (with-handler (lambda (failure) (yinz-reject! operation failure)) (start operation))
  operation)
(define (%agent-options arguments)
  (%pane-options (if (null? arguments) (hash) (car arguments)) "agent options"))
(define (%agent-states states)
  (define values (if (string? states) (list states) states))
  (unless (and (list? values) (pair? values)
               (not (member #f (map (lambda (value) (and (string? value)
                 (if (member value '("Busy" "Waiting" "Idle" "Exited" "busy" "waiting" "idle" "exited")) #t #f))) values))))
    (error "invalid agent states"))
  (map string-downcase values))
(define (%agent-observe-state operation pane states options)
  (define id (%pane-id pane))
  (define wanted (%agent-states states))
  (define preceding (and (hash-contains? options "after") (%agent-states (hash-ref options "after"))))
  (define seen (not preceding))
  (%pane-listen operation "PaneUpdate" (lambda (_)
    (define info (%async-get %agent-panes id (hash)))
    (define agent (%async-get info "agent" (hash)))
    (define raw (%async-get agent "state" #f))
    (define state (and (string? raw) (string-downcase raw)))
    (cond [(and seen (member state wanted)) (yinz-resolve! operation info)]
          [(and preceding (member state preceding)) (set! seen #t)]))))
(define (%agent-observe-turn operation pane options)
  (define id (%pane-id pane))
  (define fallback (%async-get options "fallback" #f))
  (when (and fallback (not (equal? fallback "idle"))) (error "fallback must be idle"))
  (%pane-listen operation "AgentEvent" (lambda (event)
    (when (and (equal? (%async-get event "pane_id" #f) id)
               (member (%async-get event "hook" #f) '("Stop" "StopFailure" "Interrupt")))
      (yinz-resolve! operation (hash "message" (%async-get event "last_message" json-null)
        "hook" (hash-ref event "hook") "state" (%async-get event "state" json-null)
        "sessionId" (%async-get event "session_id" json-null))))))
  (when fallback
    (define idle (yinz-deferred))
    (%pane-cleanup-add operation (lambda () (yinz-cancel! idle)))
    (%async-observe idle
      (lambda (pane) (yinz-resolve! operation
        (hash "message" json-null "hook" json-null "state" "Idle"
          "sessionId" (%async-get (hash-ref pane "agent") "session_id" json-null))))
      (lambda (failure) (when (yinz-pending? operation) (yinz-reject! operation failure))) %async-client)
    (%agent-observe-state idle id "Idle" (hash "after" '("Busy" "Waiting")))))
(define (yinz-agent-info pane)
  (define id (%pane-id pane)) (%agent-watch)
  (%async-get (%async-get %agent-panes id (hash)) "agent" json-null))
(define (yinz-agent-all)
  (%agent-watch)
  (foldl (lambda (id result)
    (define agent (%async-get (hash-ref %agent-panes id) "agent" json-null))
    (if (json-null? agent) result (hash-insert result (number->string id) agent)))
    (hash) (hash-keys->list %agent-panes)))
(define (yinz-agent-on handler)
  (unless (procedure? handler) (error "agent handler must be a function"))
  (yinz-on-event "AgentEvent" handler))
(define (yinz-agent-wait-for-state pane states . options)
  (%agent-operation (lambda (operation) (%agent-observe-state operation pane states (%agent-options options)))))
(define (yinz-agent-wait-for-event pane . hooks)
  (%agent-operation (lambda (operation)
    (define id (%pane-id pane))
    (define raw (and (pair? hooks) (car hooks)))
    (define wanted (if (string? raw) (list raw) raw))
    (when (and wanted (not (and (list? wanted) (not (member #f (map string? wanted))))))
      (error "hooks must be a string or array of strings"))
    (%pane-listen operation "AgentEvent" (lambda (event)
      (when (and (equal? (%async-get event "pane_id" #f) id)
                 (or (not wanted) (member (%async-get event "hook" #f) wanted)))
        (yinz-resolve! operation event)))))))
(define (yinz-agent-wait-for-turn pane . options)
  (%agent-operation (lambda (operation) (%agent-observe-turn operation pane (%agent-options options)))))
(define (%agent-send-target pane text options)
  (define target (hash "Terminal" (%pane-id pane)))
  (unless (and (string? text) (boolean? (%async-get options "enter" #t)))
    (error "agent send requires text and a boolean enter option")) target)
(define (yinz-agent-send pane text . arguments)
  (define options (%agent-options arguments))
  (define target (%agent-send-target pane text options))
  (yinz-command (hash "WriteToPaneId"
    (list (string->bytes (string-append "\u{1b}[200~" text "\u{1b}[201~")) target)))
  (when (%async-get options "enter" #t)
    (yinz-command (hash "WriteToPaneId" (list '(13) target)))) json-null)
(define (yinz-agent-prompt pane text . arguments)
  (%agent-operation (lambda (operation)
    (define options (%agent-options arguments))
    (%agent-send-target pane text options)
    (%agent-observe-turn operation pane options)
    (yinz-agent-send pane text options))))
(define (yinz-agent-control request)
  (%agent-operation (lambda (operation)
    (define serialized (yinz-json-string request))
    (define id (string-append %rpc-prefix ":agent:" (%async-id)))
    (%pane-listen operation "CustomMessage" (lambda (payload)
      (when (and (list? payload) (= (length payload) 2) (equal? (car payload) "agent-response"))
        (define reply (yinz-json-parse (cadr payload)))
        (when (equal? (%async-get reply "id" #f) id)
          (yinz-resolve! operation (hash-ref reply "response"))))))
    (yinz-command (hash "AgentControl" (hash "id" id "request" serialized))))))
(define (yinz-agent-register-provider definition) (yinz-command (hash "RegisterAgentProvider" definition)))
(define (yinz-agent-providers) (yinz-command "GetAgentProviders"))
(define (yinz-agent-spawn-details options)
  (%pane-options options "agent spawn options")
  (define spec (foldl (lambda (key value) (hash-remove value key)) options
    '("sourceDirectory" "cwd" "name" "context" "startSuppressed")))
  (yinz-command (hash "SpawnAgent" (hash "spec" spec
    "source_directory" (%async-get options "sourceDirectory" json-null)
    "cwd" (%async-get options "cwd" json-null) "name" (%async-get options "name" json-null)
    "context" (%async-get options "context" (hash)) "start_suppressed" (%async-get options "startSuppressed" #f)))))
(define (yinz-agent-spawn options) (hash-ref (yinz-agent-spawn-details options) "pane_id"))
