;; Version-one plugin RPC. Raw protocol plugins keep their own pipe handler until
;; they opt into this SDK by calling yinz-rpc-call or yinz-rpc-handle.
(define (yinz-instance-id) %rpc-prefix)
(define %rpc-enabled #f)
(define %rpc-handlers (hash))
(define %rpc-calls (hash))
(define %rpc-next 0)
(define %rpc-max-bytes 1048576)

(define (%rpc-name? value) (and (string? value) (> (string-length value) 0)))
(define (%rpc-id? value) (and (integer? value) (exact? value) (<= 0 value) (<= value 4294967295)))
(define (%rpc-json value)
  (define text (yinz-json-string value))
  (when (> (utf8-length text) %rpc-max-bytes)
    (error "RPC payload exceeds 1048576 bytes"))
  text)
(define (%rpc-send name payload destination url config)
  (yinz-command
    (hash "MessageToPlugin"
      (hash "plugin_url" url "destination_plugin_id" destination "plugin_config" config
            "message_name" name "message_payload" (%rpc-json payload) "message_args" (hash)
            "new_plugin_args" json-null "floating_pane_coordinates" json-null))))
(define (yinz-rpc-handle name handler)
  (unless (%rpc-name? name) (error "RPC name must be nonempty"))
  (unless (procedure? handler) (error "RPC handler must be a function"))
  (set! %rpc-enabled #t)
  (set! %rpc-handlers (hash-insert %rpc-handlers name handler))
  json-null)

(define (yinz-rpc-call options . progress)
  (set! %rpc-enabled #t)
  (define operation (yinz-deferred))
  (with-handler (lambda (failure) (yinz-reject! operation failure))
    (unless (hash? options) (error "RPC options must be an object"))
    (for-each
      (lambda (key)
        (unless (member key '("pluginId" "pluginUrl" "pluginConfig" "name" "payload" "timeoutMs" "onProgress"))
          (error (string-append "unknown RPC option: " key))))
      (hash-keys->list options))
    (when (> (length progress) 1) (error "RPC accepts one progress callback"))
    (define on-progress
      (if (null? progress) (%async-get options "onProgress" #f) (car progress)))
    (unless (or (eq? on-progress #f) (procedure? on-progress))
      (error "onProgress must be a function"))
    (define has-id (hash-contains? options "pluginId"))
    (define has-url (hash-contains? options "pluginUrl"))
    (when (eq? has-id has-url) (error "RPC requires exactly one destination"))
    (define destination (%async-get options "pluginId" json-null))
    (define url (%async-get options "pluginUrl" json-null))
    (when (and has-id (not (%rpc-id? destination))) (error "pluginId must fit u32"))
    (when (and has-url (not (%rpc-name? url))) (error "pluginUrl must be nonempty"))
    (when (and has-id (hash-contains? options "pluginConfig"))
      (error "pluginConfig requires pluginUrl"))
    (define name (%async-get options "name" #f))
    (unless (%rpc-name? name) (error "RPC name must be nonempty"))
    (define config (%async-get options "pluginConfig" (hash)))
    (unless (and (hash? config)
                 (not (member #f
                   (map (lambda (key) (and (string? key) (string? (hash-ref config key))))
                        (hash-keys->list config)))))
      (error "pluginConfig must be a string map"))
    (set! %rpc-next (+ %rpc-next 1))
    (define id (string-append %rpc-prefix ":rpc" (number->string %rpc-next)))
    (define timer #f)
    (vector-set! operation 4
      (lambda ()
        (set! %rpc-calls (hash-remove %rpc-calls id))
        (when timer (yinz-cancel! timer))))
    (set! %rpc-calls (hash-insert %rpc-calls id (vector operation destination on-progress %async-client)))
    (when (hash-contains? options "timeoutMs")
      (set! timer (yinz-sleep (hash-ref options "timeoutMs")))
      (%async-observe timer
        (lambda (ignored) (yinz-reject! operation (string-append "RPC timed out: " name)))
        (lambda (failure) (yinz-reject! operation failure)) %async-client))
    (when (or (not timer) (yinz-pending? timer))
      (%rpc-send "yinz_rpc_call"
        (hash "version" 1 "call_id" id "name" name "payload" (%async-get options "payload" json-null))
        destination url config)))
  operation)

(define (%rpc-error failure)
  (define text (%async-error failure))
  (substring text 0 (min (string-length text) 2000)))
(define (%rpc-reply id destination result failure)
  (define payload
    (with-handler
      (lambda (failure) (hash "version" 1 "call_id" id "error" (%rpc-error failure)))
      (define body
        (if failure
            (hash "version" 1 "call_id" id "error" (%rpc-error failure))
            (hash "version" 1 "call_id" id "result" (if (void? result) json-null result))))
      (%rpc-json body)
      body))
  (when (hash-contains? payload "error")
    (let shrink ()
      (define text (hash-ref payload "error"))
      (when (and (> (utf8-length (yinz-json-string payload)) %rpc-max-bytes)
                 (> (string-length text) 0))
        (set! payload (hash-insert payload "error" (substring text 0 (quotient (string-length text) 2))))
        (shrink))))
  (with-handler %async-fail
    (%rpc-send "yinz_rpc_reply" payload destination json-null (hash))))
(define (%rpc-request call source)
  (define name (%async-get call "name" #f))
  (when (%rpc-name? name)
    (define id (hash-ref call "call_id"))
    (define origin %async-client)
    (define active #t)
    (define (progress value)
      (when active
        (%async-with-client origin
          (lambda ()
            (%rpc-send "yinz_rpc_progress" (hash "version" 1 "call_id" id "payload" value)
              source json-null (hash)))))
      json-null)
    (define (reply result failure)
      (set! active #f)
      (%async-with-client origin (lambda () (%rpc-reply id source result failure))))
    (with-handler (lambda (failure) (reply json-null failure))
      (unless (hash-contains? %rpc-handlers name)
        (error (string-append "no rpc handler named " name)))
      (define payload (%async-get call "payload" json-null))
      (%async-track
        ((hash-ref %rpc-handlers name) payload
          (hash "version" 1 "callId" id "name" name "payload" payload
                "source" (hash "Plugin" source) "progress" progress))
        (lambda (result) (reply result #f))
        (lambda (failure) (reply json-null failure))))))
(define (%rpc-response name call source)
  (define id (hash-ref call "call_id"))
  (when (hash-contains? %rpc-calls id)
    (define waiting (hash-ref %rpc-calls id))
    (define operation (vector-ref waiting 0))
    (define destination (vector-ref waiting 1))
    (when (or (json-null? destination) (equal? destination source))
      (if (equal? name "yinz_rpc_progress")
          (when (and (hash-contains? call "payload")
                     (not (hash-contains? call "error")) (not (hash-contains? call "result")))
            (define callback (vector-ref waiting 2))
            (when callback
              (with-handler (lambda (failure) (yinz-reject! operation failure))
                (%async-with-client (vector-ref waiting 3)
                  (lambda () (callback (hash-ref call "payload")))))))
          (if (hash-contains? call "error")
              (when (and (not (hash-contains? call "result")) (string? (hash-ref call "error")))
                (yinz-reject! operation (hash-ref call "error")))
              (yinz-resolve! operation (%async-get call "result" json-null)))))))
(define (yinz-rpc-dispatch message)
  (define name (%async-get message "name" #f))
  (if (and %rpc-enabled (member name '("yinz_rpc_call" "yinz_rpc_reply" "yinz_rpc_progress")))
      (begin
        (define source (%async-get (%async-get message "source" #f) "Plugin" #f))
        (define encoded (%async-get message "payload" #f))
        (when (and (%rpc-id? source) (string? encoded) (<= (utf8-length encoded) %rpc-max-bytes))
          (define call (with-handler (lambda (ignored) #f) (yinz-json-parse encoded)))
          (when (and (hash? call) (equal? (%async-get call "version" #f) 1)
                     (%rpc-name? (%async-get call "call_id" #f)))
            (if (equal? name "yinz_rpc_call")
                (%rpc-request call source)
                (%rpc-response name call source))))
        #t)
      #f))
