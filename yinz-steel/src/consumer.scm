;; Correlated host services keep cleanup on the original deferred, not a chained result.
(define %completion-enabled #f)
(define %completion-calls (hash))
(define (%consumer-id kind) (string-append %rpc-prefix ":" kind (%async-id)))
(define (%consumer-options options allowed name)
  (unless (hash? options) (error (string-append name " options must be an object")))
  (for-each (lambda (key)
              (unless (member key allowed)
                (error (string-append "unknown " name " option: " key))))
    (hash-keys->list options)))
(define (%consumer-json value)
  (define encoded (yinz-json-string value))
  (when (> (utf8-length encoded) 64000) (error "RPC payload exceeds 64000 bytes"))
  encoded)
(define (%completion-tool-calls calls arguments-required?)
  (unless (list? calls) (error "tool_calls must be an array"))
  (for-each (lambda (call)
    (unless (and (hash? call) (string? (%async-get call "id" #f))
                 (string? (%async-get call "name" #f))
                 (or (and (not arguments-required?) (not (hash-contains? call "arguments")))
                     (string? (%async-get call "arguments" #f))))
      (error "invalid completion tool call"))) calls))

(define (yinz-complete options)
  (set! %completion-enabled #t)
  (define operation (yinz-deferred))
  (with-handler (lambda (failure) (yinz-reject! operation failure))
    (yinz-json-string options)
    (%consumer-options options '("messages" "system" "model" "tools" "toolChoice" "temperature" "maxTokens" "timeoutMs") "completion")
    (define messages (%async-get options "messages" #f))
    (define system (%async-get options "system" json-null))
    (define model (%async-get options "model" json-null))
    (define tools (%async-get options "tools" '()))
    (define temperature (%async-get options "temperature" json-null))
    (define maximum (%async-get options "maxTokens" json-null))
    (define timeout (%async-get options "timeoutMs" 60000))
    (unless (and (list? messages) (<= (length messages) 200)
                 (or (pair? messages) (not (json-null? system))))
      (error "completion requires messages (at most 200) or a system prompt"))
    (unless (and (list? tools) (<= (length tools) 64)) (error "completion allows at most 64 tools"))
    (unless (and (or (json-null? system) (string? system)) (or (json-null? model) (string? model)))
      (error "system and model must be strings"))
    (unless (or (json-null? temperature) (number? temperature)) (error "temperature must be finite"))
    (unless (or (json-null? maximum) (%rpc-id? maximum)) (error "maxTokens must fit u32"))
    (unless (and (number? timeout) (>= timeout 0) (<= timeout 2147483647))
      (error "timer duration must be between 0 and 2147483647 milliseconds"))
    (for-each (lambda (message)
      (unless (and (hash? message) (member (%async-get message "role" #f) '("system" "user" "assistant" "tool"))
                   (or (not (hash-contains? message "content")) (string? (hash-ref message "content"))))
        (error "invalid completion message"))
      (define call-id (%async-get message "tool_call_id" json-null))
      (unless (or (string? call-id) (and (json-null? call-id) (not (equal? (hash-ref message "role") "tool"))))
        (error "tool messages require tool_call_id"))
      (%completion-tool-calls (%async-get message "tool_calls" '()) #f)) messages)
    (define id (%consumer-id "hc"))
    (define payload (hash "request_id" id "messages" messages "system" system "model" model "tools" tools
                          "tool_choice" (%async-get options "toolChoice" json-null) "temperature" temperature "max_tokens" maximum))
    (define encoded (%consumer-json payload))
    (define daemons '())
    (for-each (lambda (session)
      (when (hash-ref session "is_current_session")
        (define plugins (hash-ref session "plugins"))
        (for-each (lambda (key)
          (when (equal? (hash-ref (hash-ref plugins key) "location") "yinz:agent-service")
            (set! daemons (cons (string->number key) daemons)))) (hash-keys->list plugins))))
      (hash-ref (yinz-command "GetSessionList") "live_sessions"))
    (unless (= (length daemons) 1)
      (error (if (null? daemons) "no agent-service in the current session" "multiple agent-service plugins in the current session")))
    (define destination (car daemons))
    (unless (%rpc-id? destination) (error "invalid agent-service plugin ID"))
    (define timer #f)
    (vector-set! operation 4 (lambda ()
      (set! %completion-calls (hash-remove %completion-calls id))
      (when timer (yinz-cancel! timer))))
    (set! %completion-calls (hash-insert %completion-calls id (cons operation destination)))
    (set! timer (yinz-sleep timeout))
    (%async-observe timer
      (lambda (_) (yinz-reject! operation "LLM completion timed out"))
      (lambda (failure) (yinz-reject! operation failure)) %async-client)
    (when (yinz-pending? timer)
      (yinz-command (hash "MessageToPlugin"
        (hash "plugin_url" json-null "destination_plugin_id" destination "plugin_config" (hash)
              "message_name" "llm_complete" "message_payload" encoded "message_args" (hash)
              "new_plugin_args" json-null "floating_pane_coordinates" json-null)))))
  operation)

(define (yinz-consumer-pipe message)
  (define name (%async-get message "name" #f))
  (if (and %completion-enabled (member name '("llm_complete" "llm_complete_result")))
      (begin
        (when (and (equal? name "llm_complete_result") (string? (%async-get message "payload" #f)))
          (with-handler (lambda (_) #f)
            (define reply (yinz-json-parse (hash-ref message "payload")))
            (define id (%async-get reply "request_id" #f))
            (when (and (string? id) (hash-contains? %completion-calls id))
              (define waiting (hash-ref %completion-calls id))
              (when (equal? (%async-get (%async-get message "source" #f) "Plugin" #f) (cdr waiting))
                (define failure (hash-ref reply "error"))
                (unless (string? failure) (error "invalid completion error"))
                (if (not (equal? failure "")) (yinz-reject! (car waiting) failure)
                    (begin
                      (for-each (lambda (key) (unless (string? (hash-ref reply key)) (error "invalid completion result")))
                        '("content" "finish_reason" "model"))
                      (%completion-tool-calls (hash-ref reply "tool_calls") #t)
                      (define usage (hash-ref reply "usage"))
                      (unless (json-null? usage)
                        (for-each (lambda (key)
                          (define count (hash-ref usage key))
                          (unless (and (integer? count) (<= 0 count) (<= count 9007199254740991))
                            (error "invalid completion usage"))) '("prompt_tokens" "completion_tokens" "total_tokens")))
                      (yinz-resolve! (car waiting)
                        (hash "content" (hash-ref reply "content") "toolCalls" (hash-ref reply "tool_calls")
                              "finishReason" (hash-ref reply "finish_reason") "usage" usage "model" (hash-ref reply "model")))))))))
        #t)
      #f))

(define (yinz-pick options)
  (define operation (yinz-deferred))
  (with-handler (lambda (failure) (yinz-reject! operation failure))
    (%consumer-options options '("kind" "roots" "extensions" "hidden" "recursive" "timeoutMs") "pick")
    (define kind (%async-get options "kind" #f))
    (unless (member kind '("file" "directory")) (error "pick kind must be file or directory"))
    (when (hash-contains? options "roots")
      (define roots (hash-ref options "roots"))
      (unless (and (list? roots) (pair? roots)
                   (not (member #f (map (lambda (root)
                     (and (%rpc-name? root) (not (member (integer->char 0) (string->list root))))) roots))))
        (error "roots must contain nonempty paths without NUL")))
    (when (hash-contains? options "extensions")
      (define extensions (hash-ref options "extensions"))
      (unless (and (equal? kind "file") (list? extensions)
                   (not (member #f (map (lambda (ext)
                     (and (%rpc-name? ext) (not (equal? (string-ref ext 0) #\.))
                          (not (member #t (map (lambda (char) (or (equal? char (integer->char 0))
                            (if (member char '(#\/ #\\ #\* #\? #\[ #\])) #t #f))) (string->list ext)))))) extensions))))
        (error "extensions must be literal file suffixes without leading dots")))
    (for-each (lambda (key)
      (when (and (hash-contains? options key) (not (boolean? (hash-ref options key))))
        (error (string-append key " must be boolean")))) '("hidden" "recursive"))
    (define timeout (%async-get options "timeoutMs" #f))
    (when (and (hash-contains? options "timeoutMs")
               (not (and (integer? timeout) (exact? timeout) (<= 0 timeout 9007199254740991))))
      (error "timeoutMs must be a nonnegative integer"))
    (define id (%consumer-id "pick:"))
    (define origin %async-client)
    (define started #f)
    (define finished #f)
    (define timer #f)
    (define off (lambda () (void)))
    (define (stop timeout?)
      (when (and started (not finished))
        (%async-with-client origin (lambda ()
          (yinz-command (hash "Pick" (hash "Cancel" (hash "request_id" id "timeout" timeout?))))))))
    (%async-set-cancel! operation (lambda () (stop #f)))
    (vector-set! operation 4 (lambda () (off) (when timer (yinz-cancel! timer)) (stop #f)))
    (set! off (yinz-on-event "PickResult" (lambda (reply)
      (when (equal? (%async-get reply "request_id" #f) id)
        (set! finished #t)
        (define result (hash-ref reply "result"))
        (if (hash-contains? result "Ok") (yinz-resolve! operation (hash-ref result "Ok"))
            (yinz-reject! operation (hash-ref result "Err"))))
      (void))))
    (yinz-command (hash "Pick" (hash "Start" (hash "request_id" id "options" options))))
    (set! started #t)
    (when timeout
      (set! timer (yinz-sleep timeout))
      (%async-observe timer (lambda (_) (stop #t))
        (lambda (failure) (yinz-reject! operation failure)) origin)))
  operation)

(define (yinz-test-plugin name . options)
  (define operation (yinz-deferred))
  (define id (%consumer-id "test:"))
  (define started #f)
  (define finished #f)
  (define off (lambda () (void)))
  (vector-set! operation 4 (lambda ()
    (off)
    (when (and started (not finished)) (yinz-command (hash "CancelPluginTest" id)))))
  (with-handler (lambda (failure) (yinz-reject! operation failure))
    (when (> (length options) 1) (error "test-plugin accepts one options object"))
    (set! off (yinz-on-event "CustomMessage" (lambda (payload)
      (when (equal? (car payload) (string-append "__yinz_plugin_test:" id))
        (set! finished #t)
        (with-handler (lambda (failure) (yinz-reject! operation failure))
          (define result (yinz-json-parse (cadr payload)))
          (if (hash-contains? result "Err") (yinz-reject! operation (hash-ref result "Err"))
              (yinz-resolve! operation (hash-ref result "Ok")))))
      (void))))
    (yinz-command (hash "TestPlugin"
      (hash "name" name "options" (if (null? options) (hash) (car options)) "request_id" id)))
    (set! started #t))
  operation)
