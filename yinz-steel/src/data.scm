;; Data commands remain guest calls so permissions, actors, and errors use the normal bridge.
(define (yinz-data-request namespace request) (hash-insert request "namespace" namespace))
(define (yinz-data-define namespace definition)
  (yinz-command (hash "DataDefineEntity" (hash "namespace" namespace "def" definition "allow_destructive" #f))))
(define (yinz-data-define-all namespace definitions)
  (for-each (lambda (definition) (yinz-data-define namespace definition)) definitions))
(define (yinz-data-fetch namespace request)
  (yinz-command (hash "DataFetch" (hash "request" (yinz-data-request namespace request)))))
(define (yinz-data-count namespace request)
  (yinz-command (hash "DataCount" (hash "request" (yinz-data-request namespace request)))))
(define (yinz-data-apply namespace mutations)
  (yinz-command (hash "DataApply" (hash "namespace" namespace "mutations" mutations))))
(define (yinz-data-watch namespace request mode)
  (yinz-command (hash "DataWatch" (hash "request" (yinz-data-request namespace request) "mode" mode))))
(define (yinz-data-fetch-all namespace initial)
  (define request (hash-insert initial "limit" (yinz-agent-model "store" "FetchLimit" json-null)))
  (let loop ((request request) (collected '()))
    (define page (yinz-data-fetch namespace request))
    (define rows (append collected (hash-ref page "rows")))
    (if (hash-ref page "truncated")
        (let ((cursor (hash-ref page "next_cursor")) (previous (%async-get request "after_id" json-null)))
          (when (json-null? cursor) (error "cannot finish pagination: missing cursor"))
          (when (and (not (json-null? previous)) (<= cursor previous))
            (error "cannot finish pagination: cursor did not advance"))
          (loop (hash-insert request "after_id" cursor) rows))
        (hash-insert page "rows" rows))))

;; Builders preserve the wire API, including explicitly tagged values and revisions.
(define (%data-options defaults options)
  (when (> (length options) 1) (error "expected at most one data options hash"))
  (if (null? options) defaults
    (let ((options (car options)))
      (unless (hash? options) (error "data options must be a hash"))
      (foldl (lambda (key result)
        (unless (hash-contains? defaults key) (error "unknown data option" key))
        (hash-insert result key (hash-ref options key))) defaults (hash-keys->list options)))))
(define (%data-tag value)
  (cond
    ((json-null? value) "Null")
    ((hash? value)
      (unless (= (length (hash-keys->list value)) 1) (error "expected one data value tag"))
      (define kind (car (hash-keys->list value)))
      (define payload (hash-ref value kind))
      (unless (cond
        ((equal? kind "Int") (and (exact-integer? payload) (<= -9223372036854775808 payload 9223372036854775807)))
        ((equal? kind "Real") (number? payload))
        ((equal? kind "Text") (string? payload))
        ((equal? kind "Bool") (boolean? payload))
        ((equal? kind "Blob") (or (bytevector? payload)
          (and (list? payload) (andmap (lambda (byte) (and (exact-integer? byte) (<= 0 byte 255))) payload))))
        (else #f)) (error "invalid tagged data value"))
      value)
    ((boolean? value) (hash "Bool" value))
    ((exact-integer? value) (%data-tag (hash "Int" value)))
    ((number? value) (hash "Real" value))
    ((string? value) (hash "Text" value))
    ((bytevector? value) (hash "Blob" value))
    (else (error "unsupported data value"))))
(define (yinz-data-eq attribute value) (hash "Eq" (list attribute (%data-tag value))))
(define (yinz-data-put entity values . options)
  (define pairs (if (hash? values)
    (map (lambda (key) (list key (hash-ref values key))) (hash-keys->list values)) values))
  (hash "Put" (hash-insert (hash-insert
    (%data-options (hash "uid" json-null "expect_rev" json-null) options) "entity" entity)
    "values" (map (lambda (pair)
      (unless (and (list? pair) (= (length pair) 2) (string? (car pair)))
        (error "data values require attribute/value pairs"))
      (list (car pair) (%data-tag (cadr pair)))) pairs))))
(define (yinz-data-attr name kind . options)
  (define lower (string-downcase (if (symbol? kind) (symbol->string kind) kind)))
  (define kinds (hash "text" "Text" "int" "Int" "real" "Real" "bool" "Bool" "blob" "Blob" "json" "Json"))
  (unless (hash-contains? kinds lower) (error "unknown data attribute kind" kind))
  (define result (%data-options
    (hash "indexed" #f "full_text" #f "unique" #f "required" #f "default" json-null) options))
  (for-each (lambda (key)
    (unless (boolean? (hash-ref result key)) (error "data attribute option must be boolean" key)))
    '("indexed" "full_text" "unique" "required"))
  (unless (json-null? (hash-ref result "default"))
    (set! result (hash-insert result "default" (%data-tag (hash-ref result "default")))))
  (hash-insert (hash-insert result "name" name) "kind" (hash-ref kinds lower)))
(define (yinz-data-query entity . options)
  (%data-options (yinz-agent-model "store" "EntityRequest" entity) options))
(define (yinz-data-row columns values)
  (when (hash? columns) (set! columns (hash-ref columns "columns")))
  (unless (= (length columns) (length values)) (error "data row column/value count differs"))
  (foldl (lambda (pair result)
    (define value (cadr pair))
    (define decoded (if (equal? value "Null") json-null
      (begin (%data-tag value) (hash-ref value (car (hash-keys->list value))))))
    (hash-insert result (car pair) decoded)) (hash) (map list columns values)))
