;; Guest conveniences keep their subscriptions, correlation and cleanup here.
(define (%service-map value name)
  (unless (and (hash? value)
               (not (member #f (map (lambda (key) (and (string? key) (string? (hash-ref value key))))
                                    (hash-keys->list value)))))
    (error (string-append name " must be a string map")))
  value)
(define (%service-option options camel scheme fallback)
  (%async-get options camel (%async-get options scheme fallback)))
(define (%service-request operation command arguments context-index project on-output)
  (define context (list-ref arguments context-index))
  (when (hash-contains? context "__yinz_async") (error "context key __yinz_async is reserved"))
  (define token (%async-id))
  (define owned-context (hash-insert context "__yinz_async" token))
  (define args (map (lambda (index) (if (= index context-index) owned-context (list-ref arguments index)))
                    (range (length arguments))))
  (define waiter #f)
  (define off (lambda () (void)))
  (define origin %async-client)
  (vector-set! operation 4 (lambda () (when waiter (yinz-cancel! waiter)) (off)))
  (set! waiter
    (yinz-wait-for-event (string-append command "Result")
      (lambda (payload) (equal? (%async-get (list-ref payload 3) "__yinz_async" #f) token))))
  (%async-observe waiter
    (lambda (payload)
      (with-handler (lambda (failure) (yinz-reject! operation failure))
        (yinz-resolve! operation
          (hash-insert (project payload) "context" (hash-remove (list-ref payload 3) "__yinz_async")))))
    (lambda (failure) (yinz-reject! operation failure)) origin)
  (when on-output
    (set! off
      (yinz-on-event "RunCommandOutput"
        (lambda (payload)
          (when (and (yinz-pending? operation)
                     (equal? (%async-get (%async-get payload "context" #f) "__yinz_async" #f) token))
            (with-handler (lambda (failure) (yinz-reject! operation failure))
              (%async-with-client origin
                (lambda () (on-output
                  (hash-insert payload "context" (hash-remove (hash-ref payload "context") "__yinz_async")))))))
          #f))))
  (when (yinz-pending? waiter) (yinz-command (hash command args))))
(define (yinz-run-command options)
  (define operation (yinz-deferred))
  (with-handler (lambda (failure) (yinz-reject! operation failure))
    (unless (hash? options) (error "run-command options must be an object"))
    (define argv (%async-get options "command" #f))
    (unless (and (list? argv) (pair? argv) (not (member #f (map string? argv)))
                 (> (string-length (car argv)) 0))
      (error "command must be a nonempty array of strings with an executable"))
    (define cwd (%async-get options "cwd" "/host"))
    (unless (string? cwd) (error "cwd must be a string"))
    (define maximum (%service-option options "maxBytesReturned" "max-bytes" json-null))
    (unless (or (json-null? maximum) (and (integer? maximum) (exact? maximum) (<= 0 maximum) (<= maximum 9007199254740991)))
      (error "maxBytesReturned must be a nonnegative safe integer"))
    (define on-output (%service-option options "onOutput" "on-output" #f))
    (unless (or (eq? on-output #f) (procedure? on-output)) (error "onOutput must be a function"))
    (%service-request operation "RunCommand"
      (list argv (%service-map (%service-option options "envVariables" "env" (hash)) "envVariables")
            cwd (%service-map (%async-get options "context" (hash)) "context") maximum
            (if on-output #t json-null)) 3
      (lambda (payload) (hash "exit-code" (car payload) "stdout" (cadr payload) "stderr" (caddr payload)))
      on-output))
  operation)
(define (yinz-web-request options)
  (define operation (yinz-deferred))
  (with-handler (lambda (failure) (yinz-reject! operation failure))
    (unless (hash? options) (error "web-request options must be an object"))
    (define url (%async-get options "url" #f))
    (unless (%rpc-name? url) (error "url must be a nonempty string"))
    (define verb (%async-get options "verb" "Get"))
    (unless (member verb '("Get" "Post" "Put" "Delete" "Patch"))
      (error "verb must be Get, Post, Put, Delete, or Patch"))
    (define body (%async-get options "body" ""))
    (define bytes (if (string? body) (string->bytes body) body))
    (unless (or (bytevector? bytes) (and (list? bytes) (not (member #f (map (lambda (byte) (and (integer? byte) (exact? byte) (<= 0 byte) (<= byte 255))) bytes)))))
      (error "body must be text or a byte list"))
    (define proxy (%async-get options "proxy" json-null))
    (define stream (%service-option options "streamId" "stream-id" json-null))
    (unless (or (json-null? proxy) (string? proxy)) (error "proxy must be a string"))
    (unless (or (json-null? stream) (string? stream)) (error "streamId must be a string"))
    (%service-request operation "WebRequest"
      (list url verb (%service-map (%async-get options "headers" (hash)) "headers") bytes
            (%service-map (%async-get options "context" (hash)) "context") stream proxy) 4
      (lambda (payload) (hash "status" (car payload) "headers" (cadr payload) "body" (caddr payload))) #f))
  operation)

(define (%service-timer milliseconds callback repeat)
  (unless (procedure? callback) (error "timer callback must be a function"))
  (unless (and (number? milliseconds) (<= 0 milliseconds) (<= milliseconds 2147483647))
    (error "timer duration must be between 0 and 2147483647 milliseconds"))
  (define handle (yinz-deferred))
  (define pending #f)
  (define origin %async-client)
  (define release (lambda () (void)))
  (define (failure error)
    (when (yinz-pending? handle) (yinz-reject! handle error) (%async-fail error)))
  (define (arm)
    (when (yinz-pending? handle)
      (set! pending (yinz-deferred))
      (define timer pending)
      (define id (vector-ref timer 6))
      (vector-set! timer 4 (lambda () (set! %async-timers (hash-remove %async-timers id))))
      (set! %async-timers (hash-insert %async-timers id (cons timer (+ (yinz-now-ms) milliseconds))))
      (%async-observe timer
        (lambda (ignored)
          (when (yinz-pending? handle)
            (with-handler failure
              (%async-track (callback)
                (lambda (changed)
                  (when (eq? changed #t) (%async-invalidate))
                  (when (yinz-pending? handle)
                    (if repeat (arm) (yinz-resolve! handle json-null)))) failure))))
        failure origin)
      (%async-arm-timer)))
  (vector-set! handle 4 (lambda () (when pending (yinz-cancel! pending)) (release)))
  (with-handler failure (set! release (%async-retain "Timer")) (arm))
  handle)
(define (yinz-after milliseconds callback) (%service-timer milliseconds callback #f))
(define (yinz-every milliseconds callback) (%service-timer milliseconds callback #t))

(define (yinz-data-watch-callback namespace request callback . modes)
  (unless (procedure? callback) (error "watch callback must be a function"))
  (define origin %async-client)
  (define id #f)
  (define disposed #f)
  (define off
    (yinz-on-event "PluginDataChanged"
      (lambda (event)
        (if (and (not disposed) (equal? (%async-get event "watch_id" #f) id))
            (%async-with-client origin (lambda () (callback (hash-ref event "rows") event))) #f))))
  (with-handler (lambda (failure) (off) (raise-error failure))
    (define result (yinz-data-watch namespace request (if (null? modes) "Rows" (car modes))))
    (set! id (hash-ref result "watch_id"))
    (hash "watch-id" id "initial" (hash-ref result "rows") "dispose"
      (lambda ()
        (unless disposed
          (%async-with-client origin (lambda () (yinz-command (hash "DataUnwatch" (hash "watch_id" id)))))
          (set! disposed #t)
          (off))
        json-null))))

(define %keybinding-handlers (hash))
(define %keybinding-enabled #f)
(define %keybinding-prefix "__yinz_default_keybinding:")
(define (%keybinding-all predicate values) (not (member #f (map predicate values))))
(define (%keybinding-name value)
  (unless (string? value) (error "KDL name must be a string"))
  (define letters (string->list "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_"))
  (define more (append letters (string->list "0123456789-")))
  (define chars (string->list value))
  (if (and (pair? chars) (member (car chars) letters)
           (%keybinding-all (lambda (char) (if (member char more) #t #f)) chars))
      value (%keybinding-quote value)))
(define (%keybinding-quote value)
  (cond
    ((string? value)
     (string-append "\""
       (apply string-append
         (map (lambda (char)
           (cond ((equal? char #\\) "\\\\") ((equal? char #\") "\\\"")
                 ((equal? char #\newline) "\\n") ((equal? char #\return) "\\r")
                 ((equal? char #\tab) "\\t") (else (string char)))) (string->list value))) "\""))
    ((boolean? value) (if value "true" "false"))
    ((number? value) (yinz-json-string value))
    (else (error "KDL values must be strings, finite numbers, or booleans"))))
(define (%keybinding-sort values)
  (define (insert value values)
    (cond ((null? values) (list value)) ((string<? value (car values)) (cons value values))
          (else (cons (car values) (insert value (cdr values))))))
  (foldl insert '() values))
(define (%keybinding-action value)
  (if (string? value) (%keybinding-name value)
      (begin
        (unless (and (hash? value) (%rpc-name? (%async-get value "name" #f))) (error "an action needs a name"))
        (define props (%async-get value "props" (hash)))
        (define out
          (append (list (%keybinding-name (hash-ref value "name")))
            (map %keybinding-quote (%async-get value "args" '()))
            (map (lambda (key) (string-append (%keybinding-name key) "=" (%keybinding-quote (hash-ref props key))))
                 (%keybinding-sort (hash-keys->list props)))))
        (when (hash-contains? value "children")
          (define children (hash-ref value "children"))
          (set! out (append out (list (string-append "{ "
            (string-join
              (map (lambda (key) (string-append (%keybinding-name key) " " (%keybinding-quote (hash-ref children key))))
                   (%keybinding-sort (hash-keys->list children))) "; ") "; }")))))
        (string-join out " "))))
(define (yinz-register-default-keybindings bindings)
  (unless (list? bindings) (error "default keybindings must be an array"))
  (define replacement (hash))
  (define index 0)
  (define modes
    (map (lambda (binding)
      (set! index (+ index 1))
      (unless (hash? binding) (error "default keybinding must be an object"))
      (for-each (lambda (key) (unless (member key '("mode" "key" "actions" "handler"))
                               (error (string-append "unknown default keybinding field: " key))))
        (hash-keys->list binding))
      (define handler (%async-get binding "handler" #f))
      (define has-actions (hash-contains? binding "actions"))
      (unless (or (and has-actions (eq? handler #f)) (and (not has-actions) (procedure? handler)))
        (error "default keybinding needs exactly one of actions or handler"))
      (unless (%rpc-name? (%async-get binding "mode" #f)) (error "default keybinding needs a mode"))
      (unless (%rpc-name? (%async-get binding "key" #f)) (error "default keybinding needs a key"))
      (define actions
        (if handler
            (let ((name (string-append %keybinding-prefix (number->string index))))
              (set! replacement (hash-insert replacement name handler))
              (list (string-append "MessagePlugin { name " (%keybinding-quote name) "; }")))
            (map %keybinding-action (hash-ref binding "actions"))))
      (string-append (%keybinding-name (hash-ref binding "mode")) " { bind "
        (%keybinding-quote (hash-ref binding "key")) " { " (string-join actions "; ") "; }; }")) bindings))
  (yinz-command (hash "RegisterDefaultKeybindings"
    (string-append "keybinds clear-defaults=true { " (string-join modes "; ") (if (null? modes) "" "; ") "}")))
  (set! %keybinding-handlers replacement)
  (set! %keybinding-enabled #t)
  json-null)
(define (yinz-keybinding-dispatch message)
  (define name (%async-get message "name" #f))
  (if (and %keybinding-enabled (string? name) (starts-with? name %keybinding-prefix))
      (begin
        (when (and (equal? (%async-get message "source" #f) "Keybind") (hash-contains? %keybinding-handlers name))
          (%async-track ((hash-ref %keybinding-handlers name) message)
            (lambda (changed) (when (eq? changed #t) (%async-invalidate))) %async-fail))
        #t)
      #f))
