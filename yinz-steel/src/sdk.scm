(define json-null 'json-null)
(define (json-null? value) (equal? value json-null))
(define (display value) (yinz-raw-display value yinz-output-port))
(define (write value) (yinz-raw-write value yinz-output-port))
(define (write-string value) (yinz-raw-write-string value yinz-output-port))
(define (write-char value) (yinz-raw-write-char value yinz-output-port))
(define (newline) (write-char #\newline))
(define (displayln value) (display value) (newline))
(define (yinz-log message)
  (yinz-raw-display message yinz-log-port)
  (yinz-raw-write-char #\newline yinz-log-port))

(define (yinz-cell-pixel-size) (yinz-command "GetCellPixelSize"))
