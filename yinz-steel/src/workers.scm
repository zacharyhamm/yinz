;; Each worker evaluates the plugin in its own process and keeps its own state.
(define yinz-worker-handlers (hash))
(define yinz-worker-callback #f)
(define yinz-current-worker #f)
(define yinz-worker-event-handler #f)
(define yinz-worker-pending #f)

(define (yinz-register-workers handlers)
  (set! yinz-worker-handlers handlers)
  json-null)
(define (yinz-worker-names) (hash-keys->list yinz-worker-handlers))
(define (yinz-worker-bind name)
  (set! yinz-current-worker name)
  (set! yinz-worker-callback (hash-ref yinz-worker-handlers name))
  json-null)
(define (yinz-worker-name) yinz-current-worker)
(define (yinz-register-worker-events callback) (set! yinz-worker-event-handler callback) json-null)
(define (yinz-worker-ready) (not yinz-worker-pending))
(define (yinz-worker-failed failure)
  (yinz-log (string-append "worker failed: " (%async-error failure)))
  (set! yinz-worker-pending #f))
(define (yinz-worker-message name payload)
  (when yinz-worker-pending (error "worker already has a pending job"))
  (set! yinz-worker-pending #t)
  (with-handler yinz-worker-failed
    (%async-track (yinz-worker-callback name payload)
      (lambda (value) (set! yinz-worker-pending #f)) yinz-worker-failed))
  (yinz-async-poll)
  json-null)
(define (yinz-worker-event event)
  (yinz-agent-cache-event event)
  (yinz-async-lifecycle "update" yinz-worker-event-handler (list event) #f))
(define (yinz-post-worker worker name payload)
  (yinz-command (hash "PostMessageTo" (hash "worker_name" worker "name" name "payload" payload))))
(define (yinz-post-plugin name payload)
  (yinz-command (hash "PostMessageToPlugin" (hash "worker_name" json-null "name" name "payload" payload))))
