;; Callback handles are scoped to their provider, opening, and acting client.
(define %palette-handles (hash))
(define %palette-picks (hash))
(define %palette-next-handle 0)
(define %palette-providers (hash))

(define (%palette-get object key fallback)
  (if (and (hash? object) (hash-contains? object key)) (hash-ref object key) fallback))
(define (%palette-present? value) (and value (not (equal? value 'json-null))))
(define (%palette-host name value) (yinz-command (hash name value)))
(define (%palette-command value) (%palette-host "CommandPalette" value))
(define (%palette-clean value)
  (list->string (map (lambda (c) (if (or (equal? c #\newline) (equal? c #\tab)) #\space c))
                    (string->list (yinz-text-sanitize value)))))
(define (%palette-clip value count) (list->string (take (string->list value) (min count (length (string->list value))))))
(define (%palette-client-id) (or %async-client (hash-ref (yinz-command "GetPluginIds") "client_id")))

(define (%palette-remember callback scope client)
  (set! %palette-next-handle (+ %palette-next-handle 1))
  (define id (number->string %palette-next-handle))
  (set! %palette-handles (hash-insert %palette-handles id (hash "callback" callback "scope" scope "client" client "number" %palette-next-handle)))
  id)

(define (%palette-wire-actions actions scope client)
  (map (lambda (item)
         (define wired (hash "id" (hash-ref item "id") "label" (hash-ref item "label")
               "description" (%palette-get item "description" "") "aliases" (%palette-get item "aliases" '())
               "handle" (%palette-remember (hash-ref item "run") scope client)))
         (if (hash-contains? item "cells") (hash-insert wired "cells" (hash-ref item "cells")) wired))
       actions))

(define (%palette-wire-field field)
  (define kind (hash-ref field "type"))
  (define id (hash-ref field "id"))
  (define label (hash-ref field "label"))
  (define initial (%palette-get field "initialValue" ""))
  (cond
    ((equal? kind "choice")
     (define options (hash-ref field "options"))
     (hash "type" "choice" "id" id "label" label "options" options
           "initialValue" (%palette-get field "initialValue" (car options))))
    ((or (member kind '("number" "file" "multiline" "key"))
         (and (member kind '("text" "directory"))
              (or (%palette-get field "help" #f) (%palette-get field "error" #f))))
     (hash "type" "input" "id" id "label" label "initialValue" initial
           "options" (hash "kind" kind "help" (%palette-get field "help" "")
                           "error" (%palette-get field "error" "")
                           "minimum" (%palette-get field "minimum" 'json-null)
                           "maximum" (%palette-get field "maximum" 'json-null))))
    (else (hash "type" kind "id" id "label" label "initialValue" initial))))

(define (%palette-pick-kind field)
  (if (equal? (hash-ref field "type") "input") (hash-ref (hash-ref field "options") "kind")
      (hash-ref field "type")))

(define (%palette-wire-view view scope client)
  (define kind (hash-ref view "type"))
  (define title (hash-ref view "title"))
  (define wired (cond
    ((equal? kind "text") view)
    ((equal? kind "actions")
     (hash "type" "actions" "title" title "initialQuery" (%palette-get view "initialQuery" "")
           "actions" (%palette-wire-actions (%palette-get view "actions" '()) scope client)
           "source" (if (%palette-get view "source" #f)
             (let ((id (%palette-remember (hash-ref view "source") scope client)))
               (when (%palette-get view "onClose" #f)
                 (set! %palette-handles (hash-insert %palette-handles id
                   (hash-insert (hash-insert (hash-ref %palette-handles id) "onRelease" (hash-ref view "onClose")) "origin" %async-client)))) id) 'json-null)))
    (else
     (define fields (map %palette-wire-field (hash-ref view "fields")))
     (define browse-actions
       (map (lambda (field)
              (define id (hash-ref field "id"))
              (hash "id" (string-append "browse:" id) "label" (string-append "Browse… (" (hash-ref field "label") ")")
                    "run" (lambda (values context)
                            (hash "type" "pick" "field" id "values" values "kind" (%palette-pick-kind field)))))
            (filter (lambda (field) (member (%palette-pick-kind field) '("file" "directory"))) fields)))
     (hash "type" "form" "title" title "fields" fields
           "submitLabel" (%palette-get view "submitLabel" "Submit")
           "handle" (%palette-remember (hash-ref view "onSubmit") scope client)
           "actions" (%palette-wire-actions (append (%palette-get view "actions" '()) browse-actions) scope client)
           "confirmation" (%palette-get view "confirmation" #f)))))
  (when (and (equal? kind "actions") (hash-contains? view "columns"))
    (set! wired (hash-insert wired "columns" (hash-ref view "columns"))))
  (define description (%palette-get view "description" ""))
  (if (equal? description "") wired (hash-insert wired "description" description)))

(define (%palette-reply scope result)
  (%palette-command (hash "type" "reply" "scope" scope "result" result)))

(define (%palette-start-pick value scope client)
  (define field (hash-ref value "field"))
  (define values (hash-ref value "values"))
  (define kind (hash-ref value "kind"))
  (define current (%palette-get values field ""))
  (define root
    (if (equal? kind "file")
        (let loop ((characters (reverse (string->list current))))
          (cond ((null? characters) "")
                ((equal? (car characters) #\/) (list->string (reverse characters)))
                (else (loop (cdr characters))))) current))
  (define options (if (equal? root "") (hash "kind" kind)
                      (hash "kind" kind "roots" (list root))))
  (set! %palette-next-handle (+ %palette-next-handle 1))
  (define id (string-append "palette:" (number->string %palette-next-handle)))
  (set! %palette-picks (hash-insert %palette-picks id (hash "scope" scope "client" client "field" field "values" values)))
  (call-with-exception-handler
    (lambda (failure)
      (set! %palette-picks (hash-remove %palette-picks id))
      (%palette-command (hash "type" "suspend" "scope" scope "suspended" #f))
      (%palette-reply scope (hash "Err" (%palette-clip (%palette-clean (trim (error-object-message failure))) 2048))))
    (lambda ()
      (%palette-command (hash "type" "suspend" "scope" scope "suspended" #t))
      (yinz-command (hash "Subscribe" '("PickResult")))
      (%palette-host "Pick" (hash "Start" (hash "request_id" id "options" options))))))

(define (%palette-finish value scope client discover?)
  (cond
    (discover? (%palette-reply scope (hash "Ok" (hash "type" "actions" "actions" (%palette-wire-actions value scope client)))))
    ((equal? (%palette-get value "type" #f) "pick") (%palette-start-pick value scope client))
    ((equal? (%palette-get value "type" #f) "fields") (%palette-reply scope (hash "Ok" value)))
    ((equal? (%palette-get value "type" #f) "complete") (%palette-reply scope (hash "Ok" value)))
    ((member (%palette-get value "type" #f) '("actions" "form" "text"))
     (%palette-reply scope (hash "Ok" (hash "type" "view" "view" (%palette-wire-view value scope client)))))
    (else (%palette-reply scope (hash "Ok" (hash "type" "close"))))))

(define (%palette-cancel-picks predicate)
  (for-each (lambda (id)
              (when (predicate (hash-ref %palette-picks id))
                (set! %palette-picks (hash-remove %palette-picks id))
                (%palette-host "Pick" (hash "Cancel" (hash "request_id" id "timeout" #f)))))
            (hash-keys->list %palette-picks)))

(define (%palette-release-handle id)
  (define entry (%palette-get %palette-handles id #f))
  (when entry
    (set! %palette-handles (hash-remove %palette-handles id))
    (define cleanup (%palette-get entry "onRelease" #f))
    (when cleanup
      (%async-with-client (%palette-get entry "origin" #f)
        (lambda ()
          (with-handler (lambda (failure) (yinz-log (%async-error failure))) (cleanup)))))))

(define (%palette-forget predicate)
  (for-each (lambda (id)
              (when (predicate (hash-ref %palette-handles id)) (%palette-release-handle id)))
            (hash-keys->list %palette-handles))
  (%palette-cancel-picks predicate))

;; Tasks keep cancellation and continuation identity separate from reusable action handles.
(define %palette-tasks (hash))
(define (%palette-task-key scope client) (yinz-json-string (list client scope)))
(define (%palette-task-remove task)
  (define key (%palette-task-key (vector-ref task 0) (vector-ref task 1)))
  (when (eq? (%palette-get %palette-tasks key #f) task)
    (set! %palette-tasks (hash-remove %palette-tasks key))))
(define (%palette-task-cancel task preserve-closed)
  (unless (or (vector-ref task 2) (and preserve-closed (vector-ref task 3)))
    (vector-set! task 2 #t)
    (%palette-task-remove task)
    (define callbacks (hash-values->list (vector-ref task 4)))
    (vector-set! task 4 (hash))
    (%async-with-client (vector-ref task 6) (lambda ()
      (for-each (lambda (callback)
        (with-handler (lambda (failure) (yinz-log (string-append "Palette cancellation failed: " (%async-error failure))))
          (callback))) callbacks)))))
(define (%palette-cancel-tasks predicate preserve-closed)
  (for-each (lambda (task) (when (predicate task) (%palette-task-cancel task preserve-closed)))
    (hash-values->list %palette-tasks)))
(define (%palette-task-context task context query discover?)
  (define client (vector-ref task 6))
  (define scope (vector-ref task 0))
  (define augmented
    (hash-insert (hash-insert context "cancelled" (lambda () (vector-ref task 2))) "onCancel"
      (lambda (callback)
        (unless (procedure? callback) (error "onCancel requires a function"))
        (define id (%async-id))
        (if (vector-ref task 2)
            (%async-with-client client callback)
            (vector-set! task 4 (hash-insert (vector-ref task 4) id callback)))
        (lambda () (vector-set! task 4 (hash-remove (vector-ref task 4) id))))))
  (if discover? (hash-insert augmented "query" query)
      (hash-insert (hash-insert augmented "suspend"
        (lambda (suspended)
          (unless (boolean? suspended) (error "suspended must be a boolean"))
          (unless (vector-ref task 2)
            (%async-with-client client
              (lambda () (%palette-command (hash "type" "suspend" "scope" scope "suspended" suspended)))))))
        "close" (lambda ()
          (unless (or (vector-ref task 2) (vector-ref task 3) (vector-ref task 5))
            (%async-with-client client
              (lambda () (%palette-command (hash "type" "close" "scope" scope))))
            (vector-set! task 3 #t))))))
(define (%palette-task-finish task value failure discover?)
  (%palette-task-remove task)
  (vector-set! task 4 (hash))
  (vector-set! task 5 #t)
  (unless (vector-ref task 2)
    (define scope (vector-ref task 0)) (define client (vector-ref task 1))
    (define first-handle %palette-next-handle)
    (define (failed failure)
      (%palette-forget (lambda (entry)
        (and (= (hash-ref entry "client") client) (equal? (hash-ref entry "scope") scope)
             (> (%palette-get entry "number" 0) first-handle))))
      (define message (%palette-clip (%palette-clean (trim (%async-error failure))) 2048))
      (when (vector-ref task 3) (yinz-log (string-append "Palette callback failed after close: " message)))
      (%palette-reply scope (hash "Err" message)))
    (%async-with-client (vector-ref task 6) (lambda ()
      (with-handler failed
        (if failure (failed failure)
            (cond
              [(and (not discover?) (equal? (%palette-get value "type" #f) "complete"))
               (define view (%palette-get value "view" json-null))
               (%palette-reply scope (hash "Ok" (hash "type" "complete" "notification" (hash-ref value "notification")
                 "view" (if (or (vector-ref task 3) (json-null? view)) json-null (%palette-wire-view view scope client)))))]
              [(vector-ref task 3) (%palette-reply scope (hash "Ok" (hash "type" "close")))]
              [else (%palette-finish value scope client discover?)])))))))

(define (yinz-palette-message message)
  (define kind (hash-ref message "type"))
  (define client (%palette-client-id))
  (cond
    ((equal? kind "release")
     (for-each (lambda (id)
                 (when (equal? (%palette-get (%palette-get %palette-handles id #f) "client" #f) client)
                   (%palette-release-handle id)))
               (hash-ref message "handles")))
    ((equal? kind "cancel")
     (define scope (hash-ref message "scope"))
     (define task (%palette-get %palette-tasks (%palette-task-key scope client) #f))
     (when task (%palette-task-cancel task #f))
     (%palette-cancel-picks (lambda (entry)
                     (and (= (hash-ref entry "client") client)
                          (equal? (hash-ref entry "scope") scope)))))
    ((or (equal? kind "dismiss") (equal? kind "disconnect"))
     (define (matches scope owner)
       (and (= owner client)
            (or (equal? kind "disconnect") (= (hash-ref scope "opening") (hash-ref message "opening")))))
     (%palette-cancel-tasks (lambda (task) (matches (vector-ref task 0) (vector-ref task 1))) (equal? kind "dismiss"))
     (%palette-forget (lambda (entry) (matches (hash-ref entry "scope") (hash-ref entry "client")))))
    (else
     (define scope (hash-ref message "scope"))
     (define discover? (equal? kind "discover"))
     (define key (%palette-task-key scope client))
     (define prior (%palette-get %palette-tasks key #f))
     (when prior (%palette-task-cancel prior #f))
     (when (>= (length (hash-keys->list %palette-tasks)) 4096) (error "too many pending palette operations"))
     ;; Scope identity and the host callback origin are separate in offline runtimes.
     ;; scope, client, cancelled, closed, cancellation callbacks, finished, origin
     (define task (vector scope client #f #f (hash) #f %async-client))
     (set! %palette-tasks (hash-insert %palette-tasks key task))
     (with-handler (lambda (failure) (%palette-task-finish task json-null failure discover?))
       (define root? (and discover? (not (%palette-present? (%palette-get message "source" json-null)))))
       (define registration (hash-ref scope "registration"))
       (define provider (%palette-get %palette-providers registration #f))
       (define entry (if root? #f (%palette-get %palette-handles (hash-ref message (if discover? "source" "handle")) #f)))
       (unless (and provider
                    (or root? (and entry (= (hash-ref entry "client") client)
                                   (equal? (hash-ref (hash-ref entry "scope") "registration") registration)
                                   (= (hash-ref (hash-ref entry "scope") "opening") (hash-ref scope "opening")))))
         (error "Palette callback is no longer available"))
       (define query (%palette-get message "query" ""))
       (define context (%palette-task-context task (hash-ref message "context") query discover?))
       (define value
         (if root? ((hash-ref provider "callback") query context)
             ((hash-ref entry "callback") (if discover? query (%palette-get message "values" json-null)) context)))
       (%async-track value
         (lambda (value) (%palette-task-finish task value #f discover?))
         (lambda (failure) (%palette-task-finish task json-null failure discover?))))))
  #f)

(define (yinz-palette-register id title actions)
  (when (pair? (filter (lambda (registration) (equal? (hash-ref (hash-ref %palette-providers registration) "id") id))
                       (hash-keys->list %palette-providers)))
    (error "Palette provider is already registered"))
  (set! %palette-next-handle (+ %palette-next-handle 1))
  (define registration (number->string %palette-next-handle))
  (define static? (list? actions))
  (define release (%async-retain "BeforeClose"))
  (define client %async-client)
  (with-handler (lambda (failure) (release) (error (%async-error failure)))
    (%palette-command (hash "type" "register" "id" id "title" title
                         "registration" registration "staticActions" static?)))
  (set! %palette-providers
        (hash-insert %palette-providers registration
                     (hash "id" id "callback" (if static? (lambda (query context) actions) actions)
                           "release" release "client" client)))
  (lambda () (yinz-palette-unregister registration)))

(define (yinz-palette-unregister registration)
  (when (hash-contains? %palette-providers registration)
    (define provider (hash-ref %palette-providers registration))
    (%async-with-client (hash-ref provider "client")
      (lambda () (%palette-command (hash "type" "unregister" "registration" registration))))
    (set! %palette-providers (hash-remove %palette-providers registration))
    ((hash-ref provider "release"))
    (%palette-cancel-tasks (lambda (task) (equal? (hash-ref (vector-ref task 0) "registration") registration)) #f)
    (%palette-forget (lambda (entry) (equal? (hash-ref (hash-ref entry "scope") "registration") registration)))))

(define (yinz-palette-unload)
  (for-each yinz-palette-unregister (hash-keys->list %palette-providers)))

(define (palette message) (yinz-palette-message message))

(define (yinz-palette-update event)
  (when (equal? event "BeforeClose")
    (%palette-cancel-tasks (lambda (task) #t) #f)
    (%palette-forget (lambda (entry) #t))
    (for-each (lambda (provider) ((hash-ref provider "release"))) (hash-values->list %palette-providers))
    (set! %palette-handles (hash))
    (set! %palette-providers (hash)))
  (when (and (hash? event) (hash-contains? event "PickResult"))
    (define result (hash-ref event "PickResult"))
    (define id (hash-ref result "request_id"))
    (define pending (%palette-get %palette-picks id #f))
    (when (and pending (= (hash-ref pending "client") (%palette-client-id)))
      (set! %palette-picks (hash-remove %palette-picks id))
      (define scope (hash-ref pending "scope"))
      (define answer (hash-ref result "result"))
      (%palette-command (hash "type" "suspend" "scope" scope "suspended" #f))
      (%palette-reply scope
             (if (hash-contains? answer "Err") answer
                 (hash "Ok" (hash "type" "fields"
                                  "values" (if (%palette-present? (hash-ref answer "Ok"))
                                               (hash-insert (hash-ref pending "values")
                                                            (hash-ref pending "field") (hash-ref answer "Ok"))
                                               (hash-ref pending "values"))))))))
  #f)

