---
source: yinz-config/src/kdl/./unit/keybinds.rs
assertion_line: 796
expression: serialized.to_string()
---
keybinds clear-defaults=true {
    shared {
        bind "Ctrl n" {
            NewPane
            SwitchToMode "locked"
            MessagePlugin "yinz:strider" {
                name "message_name"
                cwd "/tmp"
                payload "message_payload"
                launch_new true
                skip_cache true
                floating true
                in_place true
                title "plugin_title"
                config_key_1 "config_value_1"
                config_key_2 "config_value_2"
            }
        }
    }
}
