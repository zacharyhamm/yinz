// If you'd like to override the default keybindings completely, be sure to change "keybinds" to "keybinds clear-defaults=true"
keybinds {
    normal {
        // uncomment this and adjust key if using copy_on_select=false
        // bind "Alt c" { Copy; }
    }
    locked {
        // Ctrl+g waits 250ms before unlocking. Follow it with plain g within
        // that time to send Ctrl+g to the terminal and stay locked. Change the
        // window with `locked_escape_timeout_ms`, or set it to 0 to unlock
        // immediately and never quote Ctrl+g.
        bind "Ctrl g" { SwitchToMode "Normal"; }
    }
    resize {
        bind "Ctrl n" { SwitchToMode "Normal"; }
        bind "h" "Left" { Resize "Increase Left"; }
        bind "j" "Down" { Resize "Increase Down"; }
        bind "k" "Up" { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "=" "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
    }
    pane {
        bind "Ctrl p" { SwitchToMode "Normal"; }
        bind "h" "Left" { MoveFocus "Left"; }
        bind "l" "Right" { MoveFocus "Right"; }
        bind "j" "Down" { MoveFocus "Down"; }
        bind "k" "Up" { MoveFocus "Up"; }
        bind "p" { SwitchFocus; }
        bind ";" { FocusLastPane; }
        bind "n" { NewPane; SwitchToMode "Normal"; }
        bind "d" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "r" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "s" { NewPane "stacked"; SwitchToMode "Normal"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "f" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "Shift f" { ToggleFocusNoUiFullscreen; SwitchToMode "Normal"; }
        bind "z" { TogglePaneFrames; SwitchToMode "Normal"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "Normal"; }
        bind "c" { SwitchToMode "RenamePane"; PaneNameInput 0;}
        bind "i" { TogglePanePinned; SwitchToMode "Normal"; }
        bind "v" { SwitchToMode "Select"; }
    }
    select {
        bind "h" "Left" { MoveTextSelection "Left"; }
        bind "j" "Down" { MoveTextSelection "Down"; }
        bind "k" "Up" { MoveTextSelection "Up"; }
        bind "l" "Right" { MoveTextSelection "Right"; }
        bind "o" { SwapTextSelectionEnds; }
        bind "Enter" { Copy; SwitchToMode "Normal"; }
        bind "Ctrl c" { SwitchToMode "Normal"; }
    }
    move {
        bind "Ctrl h" { SwitchToMode "Normal"; }
        bind "n" "Tab" { MovePane; }
        bind "p" { MovePaneBackwards; }
        bind "h" "Left" { MovePane "Left"; }
        bind "j" "Down" { MovePane "Down"; }
        bind "k" "Up" { MovePane "Up"; }
        bind "l" "Right" { MovePane "Right"; }
    }
    tab {
        bind "a" { ArrangePanesByProject; SwitchToMode "normal"; }
        bind "Ctrl t" { SwitchToMode "Normal"; }
        bind "r" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "h" "Left" "Up" "k" { GoToPreviousTab; }
        bind "l" "Right" "Down" "j" { GoToNextTab; }
        bind "n" { NewTab; SwitchToMode "Normal"; }
        bind "g" { NewTabGroup; SwitchToMode "Normal"; }
        bind "x" { CloseTab; SwitchToMode "Normal"; }
        bind "s" { ToggleActiveSyncTab; SwitchToMode "Normal"; }
        bind "b" { BreakPane; SwitchToMode "Normal"; }
        bind "]" { BreakPaneRight; SwitchToMode "Normal"; }
        bind "[" { BreakPaneLeft; SwitchToMode "Normal"; }
        bind "{" { MovePaneToPreviousTabGroup; SwitchToMode "Normal"; }
        bind "}" { MovePaneToNextTabGroup; SwitchToMode "Normal"; }
        bind "1" { GoToTabInGroup 1; SwitchToMode "Normal"; }
        bind "2" { GoToTabInGroup 2; SwitchToMode "Normal"; }
        bind "3" { GoToTabInGroup 3; SwitchToMode "Normal"; }
        bind "4" { GoToTabInGroup 4; SwitchToMode "Normal"; }
        bind "5" { GoToTabInGroup 5; SwitchToMode "Normal"; }
        bind "6" { GoToTabInGroup 6; SwitchToMode "Normal"; }
        bind "7" { GoToTabInGroup 7; SwitchToMode "Normal"; }
        bind "8" { GoToTabInGroup 8; SwitchToMode "Normal"; }
        bind "9" { GoToTabInGroup 9; SwitchToMode "Normal"; }
        bind "Tab" { ToggleTab; }
    }
    scroll {
        bind "Ctrl s" { SwitchToMode "Normal"; }
        bind "e" { EditScrollback; SwitchToMode "Normal"; }
        bind "s" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" "Right" "l" { PageScrollDown; }
        bind "Ctrl b" "PageUp" "Left" "h" { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "[" { ScrollToPreviousPrompt; }
        bind "]" { ScrollToNextPrompt; }
        bind "m" { SelectCommandAtScrollPosition; }
        bind "c" { CopyLastCommandOutput; SwitchToMode "Normal"; }
        // uncomment this and adjust key if using copy_on_select=false
        // bind "Alt c" { Copy; }
    }
    search {
        bind "Ctrl s" { SwitchToMode "Normal"; }
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" "Right" "l" { PageScrollDown; }
        bind "Ctrl b" "PageUp" "Left" "h" { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "[" { ScrollToPreviousPrompt; }
        bind "]" { ScrollToNextPrompt; }
        bind "m" { SelectCommandAtScrollPosition; }
        bind "n" { Search "down"; }
        bind "p" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }
    entersearch {
        bind "Ctrl c" "Esc" { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Search"; }
    }
    renametab {
        bind "Ctrl c" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenameTab; SwitchToMode "Tab"; }
    }
    renamepane {
        bind "Ctrl c" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenamePane; SwitchToMode "Pane"; }
    }
    session {
        bind "Ctrl o" { SwitchToMode "Normal"; }
        bind "Ctrl s" { SwitchToMode "Scroll"; }
        bind "n" { SwitchToMode "Notifications"; }
        bind "d" { Detach; }
        bind "]" { FocusHostSession; SwitchToMode "Normal"; }
        bind "[" { FocusGuestSession; SwitchToMode "Normal"; }
        bind "f" { ToggleHostFullscreen; SwitchToMode "Normal"; }
        bind "w" {
            SwitchToMode "Normal";
            ToggleCommandPalette
        }
        bind "c" {
            LaunchOrFocusPlugin "configuration" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
        bind "p" {
            SwitchToMode "Normal";
            ToggleCommandPalette
        }
        bind "l" {
            SwitchToMode "Normal";
            ToggleCommandPalette
        }
    }
    agent {
        bind "Ctrl e" { SwitchToMode "Normal"; }
        bind "n" {
            LaunchOrFocusPlugin "new-agent" {
                floating true
                overlay true
                modal true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
        bind "d" {
            LaunchOrFocusPlugin "duplicate-agent" {
                floating true
                overlay true
                modal true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
        bind "f" {
            LaunchOrFocusPlugin "fork-agent" {
                floating true
                overlay true
                modal true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
        // Open the overlay and select Agents.
        bind "a" {
            LaunchOrFocusPlugin "agents" {
                floating true
                overlay true
                awaits_placement true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }

        // Move the panel one corner clockwise, wherever the keyboard is, while the
        // panel is up. The message names no plugin, so it goes to the plugins
        // already running and starts none: with the panel not running this does
        // nothing, and a hidden panel stays where it is. Inside the panel Ctrl o
        // does the same, but only in Locked mode - in every other mode Ctrl o
        // enters Session mode, and no plugin sees it.
        bind "o" {
            MessagePlugin { name "agent_strip_reposition"; };
            SwitchToMode "Normal"
        }
    }
    notifications {
        bind "Esc" { SwitchToMode "Normal"; }
        bind "Down" "j" { MoveNotificationSelection "Down"; }
        bind "Up" "k" { MoveNotificationSelection "Up"; }
        bind "Space" { ToggleNotificationDetail; }
        // Activating a notification leaves the mode on its own, so Enter needs no SwitchToMode
        bind "Enter" { ActivateNotification; }
    }
    tmux {
        bind "[" { SwitchToMode "Scroll"; }
        bind "Ctrl b" { Write 2; SwitchToMode "Normal"; }
        bind "\"" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "%" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "c" { NewTab; SwitchToMode "Normal"; }
        bind "," { SwitchToMode "RenameTab"; }
        bind "p" { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "n" { GoToNextTab; SwitchToMode "Normal"; }
        bind "Left" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "Right" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "Down" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "Up" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "h" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "l" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "j" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "k" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "o" { FocusNextPane; }
        bind "d" { Detach; }
        bind "Space" { NextSwapLayout; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
    }
    shared {
        bind "Ctrl Alt p" { ToggleCommandPalette; }
    }
    shared_except "locked" "select" {
        bind "Alt a" { ActivateLastNotification; }
        bind "Ctrl g" { SwitchToMode "Locked"; }
        bind "Ctrl q" { Quit; }
        bind "Alt f" { ToggleFloatingPanes; }
        bind "Alt n" { NewPane; }
        // Fuzzy-find a file in the project of the focused pane. Needs `fzf` on PATH.
        // The picker opens in a floating pane; the file then opens in that same pane,
        // which closes when the editor or viewer quits.
        bind "Alt e" {
            LaunchOrFocusPlugin "file-finder" {
                floating true
                overlay true
                move_to_focused_tab true
            }
        }
        bind "Alt i" { MoveTab "Left"; }
        bind "Alt o" { MoveTab "Right"; }
        bind "Alt Shift h" { GoToPreviousTabGroup; }
        bind "Alt Shift l" { GoToNextTabGroup; }
        bind "Alt h" "Alt Left" { MoveFocusOrTab "Left"; }
        bind "Alt l" "Alt Right" { MoveFocusOrTab "Right"; }
        bind "Alt j" "Alt Down" { MoveFocus "Down"; }
        bind "Alt k" "Alt Up" { MoveFocus "Up"; }
        bind "Alt =" "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        bind "Alt [" { PreviousSwapLayout; }
        bind "Alt ]" { NextSwapLayout; }
        bind "Alt p" { TogglePaneInGroup; }
        bind "Alt Shift p" { ToggleGroupMarking; }
    }
    shared_except "normal" "locked" "notifications" {
        bind "Enter" "Esc" { SwitchToMode "Normal"; }
    }
    shared_except "pane" "locked" {
        bind "Ctrl p" { SwitchToMode "Pane"; }
    }
    shared_except "resize" "locked" {
        bind "Ctrl n" { SwitchToMode "Resize"; }
    }
    shared_except "scroll" "locked" {
        bind "Ctrl s" { SwitchToMode "Scroll"; }
    }
    shared_except "session" "locked" {
        bind "Ctrl o" { SwitchToMode "Session"; }
    }
    shared_except "tab" "locked" {
        bind "Ctrl t" { SwitchToMode "Tab"; }
    }
    shared_except "move" "locked" {
        bind "Ctrl h" { SwitchToMode "Move"; }
    }
    shared_except "tmux" "locked" {
        bind "Ctrl b" { SwitchToMode "Tmux"; }
    }
    shared_except "agent" "locked" {
        bind "Ctrl e" { SwitchToMode "Agent"; }
    }
}

// Plugin aliases - can be used to change the implementation of Yinz
// declarations are refreshed on config reload
plugins {
    // Repository Scheme plugins install on first use. Update with `yinz plugins update`.
    // my-panel repo="https://github.com/example/yinz-panel.git" branch="main"
    // local-tools repo="~/src/yinz-tools" entrypoint="src/main.scm" { greeting "Hello"; }
    tab-bar location="yinz:tab-bar"
    status-bar location="yinz:status-bar"
    strider location="yinz:strider"
    compact-bar location="yinz:compact-bar"
    filepicker location="yinz:strider" {
        cwd "/"
    }
    configuration location="yinz:configuration"
    // The shipped Scheme hooks, so `hooks { agent_exit "agent-exit" }` below and
    // `yinz action set-hook agent_waiting agent-policy --write` can name them by alias.
    context-menu location="yinz:context-menu"
    agent-policy location="yinz:agent-policy"
    agent-exit location="yinz:agent-exit"
    // Fuzzy file finder for the project of the focused pane, bound to Alt e above.
    // Requires `fzf` on PATH.
    //
    // Files open in the editor Yinz already uses elsewhere (scrollback_editor, then
    // $EDITOR, $VISUAL, vi). Add `open_<extension>` entries to route particular types
    // somewhere else instead; `{}` stands for the file path, and is appended if you
    // leave it out. `open_default` catches everything unmatched.
    //
    //     open_md  "glow -p"
    //     open_png "chafa"
    //     open_pdf "zathura {}"
    //
    // Legacy opener strings split on whitespace before substitution; they do not run
    // through a shell. Quotes have no special meaning. Blank values select the editor.
    // For literal arguments or a plugin reader, use one JSON object:
    //
    //     openers_json r#"{
    //       "pdf": {"plugin": "pdf-reader", "message": "open"},
    //       "png": {"argv": ["/opt/Image Tools/viewer", "--title", "Selected image", "{}"]},
    //       "txt": null
    //     }"#
    //
    // Keys are lowercase extensions without a leading dot, or "default". Resolution:
    // structured extension, legacy extension, structured default, legacy open_default,
    // editor. A selected null or blank legacy entry stops resolution at the editor.
    // Missing/blank/{} JSON adds no entries; configuration merges replace the whole map.
    // Invalid JSON or entries notify and cancel the opening; there is no legacy fallback.
    // Plugin entries accept plugin (alias/URL) with optional config, or plugin_id.
    // Do not combine plugin_id with plugin or config. Optional message defaults to "open".
    // args forwards string values unchanged. delivery is "auto" (default) or "message".
    // "message" requires an existing destination and never launches or focuses it.
    // argv requires a nonblank executable. It stays literal; subsequent arguments replace
    // every {} once with the path, or append the path if none contain {}. Empty arguments
    // survive. Quotes, spaces, commas, Unicode and percent signs are literal. NUL is invalid.
    //
    // Readers receive the raw absolute selected path as a message payload. Configure
    // reader settings in a normal plugin alias, e.g. pdf-reader location="file:/.../main.scm".
    // Destinations accept aliases, yinz: URLs, absolute paths and absolute local file: URLs.
    // Raw paths are file-URL encoded; URLs are decoded once by the host. Thus a raw %2C
    // filename differs from URL %2C (a comma). Escape literal # and ? in URLs; raw paths
    // need no escaping. Relative paths, remote authorities, queries and fragments fail.
    // Lookup reuses the lowest matching reader ID. Auto delivery focuses pane readers,
    // but leaves existing background destinations hidden. IDs address one instance.
    // Opener config overlays alias defaults for lookup and cold launch only.
    // Alias settings narrow matching; empty settings match any configuration at that source.
    // New readers float and keep their permission prompts. An alias cwd wins; otherwise
    // cold readers start at /, while reused readers retain their cwd. caller_cwd metadata
    // names the selected file's parent; it does not set reader cwd or carry the document.
    // There is no delivery acknowledgement or retry. Async load errors use the reader's
    // error pane; readers must handle messages arriving before their async load finishes.
    // Concurrent finders can create duplicate readers. Sequential searches reuse readers.
    // Legacy listings require UTF-8 filenames without newlines. Structured listings
    // preserve newlines with NUL-delimited candidates and output.
    // listing_json example: {"kind":"file","roots":["/home/me"],"extensions":["pdf"]}
    // kind is "file" or "directory". hidden defaults false; recursive defaults true.
    // Roots default to the focused pane cwd. Relative roots resolve against that cwd.
    // Structured listing ignores file_command and does not jump to the Git toplevel.
    // Directory selection uses the default opener, including roots named like files.
    //
    // Other keys: `file_command` replaces the file listing (default: git-tracked and
    // untracked-not-ignored files from the git root, or `find` outside a checkout),
    // `fzf_args` adds flags to fzf, and `x`/`y`/`width`/`height` size the overlay.
    // `file_command` and `fzf_args` are spliced into a shell script as written.
    file-finder location="yinz:file-finder"
    // The Agents overlay tab. Cell counts and percentages are accepted.
    agents location="yinz:agents" {
        shared true
        // width "60%"
        // height "66%"
        // pad "3"
    }
    configuration-palette location="yinz:configuration-palette" {
        shared true
    }
    session-palette location="yinz:session-palette" {
        shared true
    }
    layout-palette location="yinz:layout-palette" {
        shared true
    }
    plugin-palette location="yinz:plugin-palette" {
        shared true
    }
    todos location="yinz:todos"
    new-agent location="yinz:new-agent"
    duplicate-agent location="yinz:new-agent" {
        duplicate_focused true
    }
    // The same modal again, asking one question first: which agent to start in the
    // focused pane's place. It opens on an agent *other* than the one running, which is
    // the whole reason to fork rather than duplicate.
    fork-agent location="yinz:new-agent" {
        fork_focused true
    }
    // One shared instance owns the event-fed
    // agent snapshot for the whole session.
    agent-service location="yinz:agent-service" {
        shared true
        // Endpoint settings serve summaries and stateless plugin completions.
        // base_url "https://api.openai.com/v1"
        // model "gpt-4o-mini"
        // api_key_env "OPENAI_API_KEY"
        // summaries "true"
        // plugin_completions "true"
        // plugin_completion_model "gpt-4o-mini"
    }
    // Answers `yinz pipe` for the project registry and the todo lists, and
    // discovers projects from the agent snapshot. The data itself lives in the
    // plugin data store, which agent reads directly. Shared for the same reason
    // as the others: two instances would both answer the same broadcast.
    project-store location="yinz:project-store" {
        shared true
    }
}

// Plugins to load in the background when a new session starts
// This block adds to the built-in defaults; `load_plugins clear-defaults=true`
// replaces them instead
// Ordered plugin tabs. An explicit block replaces the defaults; an empty block disables grouping.
// overlay_tab_plugins {
//     agents label="Agents"
//     todos label="Todos"
// }

load_plugins {
    // Watches for coding agents from session start, rather than only while a
    // panel is open. Named by alias, not by "yinz:agent-service", so the
    // `shared true` above applies — plugin identity is (location,
    // configuration), and the bare url would load a second, unshared watcher.
    "agent-service"
    "project-store"
    "session-palette"
    "layout-palette"
    "plugin-palette"
    "configuration-palette"
    "yinz:link"
    // "file:/path/to/my-plugin.scm"     // see docs/PLUGINS.md
}

// Hook points a plugin can own: a moment in the session's life. Each takes one plugin url,
// or an empty string to leave the point unhooked. See docs/PLUGINS.md "Hooks".
// (Requires restart)
//
// hooks {
//     agent_exit "yinz:agent-exit"            // opened in place of an exited agent pane
//     agent_waiting "file:my-policy.scm"       // headless: a plugin in the plugin folder
//     context_menu "yinz:context-menu"        // answers right-clicks, with context_menu_on_right_click true
// }

// Choose what to do when yinz receives SIGTERM, SIGINT, SIGQUIT or SIGHUP
// eg. when terminal window with an active yinz session is closed
// (Requires restart)
// Options:
//   - detach (Default)
//   - quit
//
// on_force_close "quit"

// Choose how to handle a nested Yinz session detected running inside a pane
// Options:
//   - ask (Default - prompt with a modal to zoom in or control on focus)
//   - fullscreen (always zoom into the nested session)
//   - descend (always control the nested session on focus)
//   - never (never prompt or descend; do it manually)
//
// nested_session_handling "ask"

// Which escape sequence desktop notifications coming from panes are
// forwarded to the host terminal with.
// Options:
//   - "auto" (Default — detect from the host terminal environment)
//   - "osc9" (the legacy iTerm2 protocol, understood by most terminals)
//   - "osc99" (kitty's notification protocol)
//   - "bell" (ring the terminal bell instead)
//   - "off" (do not forward notifications to the host terminal)
//
// host_notification_protocol "auto"

//  Send a request for a simplified ui (without arrow fonts) to plugins
//  Options:
//    - true
//    - false (Default)
//
// simplified_ui true

// Choose the path to the default shell that yinz will use for opening new panes
// Default: $SHELL
//
// default_shell "fish"

// Choose the path to override cwd that yinz will use for opening new panes
//
// default_cwd ""

// Toggle between having pane frames around the panes
// Options:
//   - true (default)
//   - false
//
// pane_frames true

// Background opacity for Agent, the command palette and translucent overlays.
// Text and controls remain opaque. 0 is clear; 100 is solid.
background_opacity "85%"

// Set the pane frame style when pane_frames is enabled
// Options:
//   - titles (default - draw a title above each pane)
//   - full (draw a full frame around each pane)
//   - none (equivalent to pane_frames false)
//
// pane_frame_style "titles"

// The corner notifications appear in - they stack downwards from a top corner
// and upwards from a bottom one
// Options:
//   - top-left
//   - top-right (default)
//   - bottom-left
//   - bottom-right
//
// notification_position "top-right"

// How long a notification stays on screen, in seconds
//
// notification_timeout 10

// Toggle between having Yinz lay out panes according to a predefined set of layouts whenever possible
// Options:
//   - true (default)
//   - false
//
// auto_layout true

// Whether sessions should be serialized to the cache folder (including their tabs/panes, cwds and running commands) so that they can later be resurrected
// (Requires restart)
// Options:
//   - true (default)
//   - false
//
// session_serialization false

// Whether pane viewports are serialized along with the session, default is false
// (Requires restart)
// Options:
//   - true
//   - false (default)
//
// serialize_pane_viewport true

// Scrollback lines to serialize along with the pane viewport when serializing sessions, 0
// defaults to the scrollback size. If this number is higher than the scrollback size, it will
// also default to the scrollback size. This does nothing if `serialize_pane_viewport` is not true.
// (Requires restart)
//
// scrollback_lines_to_serialize 10000

// Define color themes for Yinz
// For more examples, see: https://github.com/zacharyhamm/yinz/tree/main/yinz-config/assets/themes
// Once these themes are defined, one of them should to be selected in the "theme" section of this file
//
// themes {
//     dracula {
//         fg 248 248 242
//         bg 40 42 54
//         red 255 85 85
//         green 80 250 123
//         yellow 241 250 140
//         blue 98 114 164
//         magenta 255 121 198
//         orange 255 184 108
//         cyan 139 233 253
//         black 0 0 0
//         white 255 255 255
//     }
// }

// Choose the theme that is specified in the themes section.
// Default: default
//
// theme "default"

// Themes to use when the host terminal reports a dark or light color palette.
// Both must be set for automatic switching to take place, otherwise `theme`
// remains authoritative. Until the host terminal reports (or if it never does),
// the dark theme is used.
//
// theme_dark "nightfox"
// theme_light "dayfox"

// Pin the session to a dark or light appearance, ignoring what the host
// terminal reports. Resolved before the first render. When unset, the host
// terminal decides.
// Options: dark, light
//
// explicit_theme_hue "dark"

// The name of the default layout to load on startup
// Default: "default"
// (Requires restart)
//
// default_layout "compact"

// Choose the mode that yinz uses when starting up.
// Default: normal
//
// default_mode "locked"

// Toggle enabling the mouse mode.
// On certain configurations, or terminals this could
// potentially interfere with copying text.
// (Requires restart)
// Options:
//   - true (default)
//   - false
//
// mouse_mode false

// Run each pane's process under a small supervisor process, so that panes
// survive their session's server exiting - for instance if it is killed or
// crashes. List survivors with `yinz pty-host list`, put one back on screen
// with `yinz pty-host adopt <id>`, or give up on it with `yinz pty-host
// kill <id>`. This is also what lets `yinz action warp-pane` move a running
// pane from one session to another, and `yinz action warp-tab` move a whole
// tab.
// Read once when the session is created; attaching later will not change it.
// (Requires restart)
// Options:
//   - true (default)
//   - false
//
// detachable_panes false

// Configure the scroll back buffer size
// This is the number of lines yinz stores for each pane in the scroll back
// buffer. Excess number of lines are discarded in a FIFO fashion.
// (Requires restart)
// Valid values: positive integers
// Default value: 10000
//
// scroll_buffer_size 10000

// Provide a command to execute when copying text. The text will be piped to
// the stdin of the program to perform the copy. This can be used with
// terminal emulators which do not support the OSC 52 ANSI control sequence
// that will be used by default if this option is not set.
// Examples:
//
// copy_command "xclip -selection clipboard" // x11
// copy_command "wl-copy"                    // wayland
// copy_command "pbcopy"                     // osx

// Choose the destination for copied text
// Allows using the primary selection buffer (on x11/wayland) instead of the system clipboard.
// Does not apply when using copy_command.
// Options:
//   - system (default)
//   - primary
//
// copy_clipboard "primary"

// Enable or disable automatic copy (and clear) of selection when releasing mouse
// Default: true
//
// copy_on_select false

// Path to the default editor to use to edit pane scrollbuffer
// Default: $EDITOR or $VISUAL
//
// scrollback_editor "/usr/bin/vim"

// When attaching to an existing session with other users,
// should the session be mirrored (true)
// or should each user have their own cursor (false)
// (Requires restart)
// Default: false
//
// mirror_session true

// The folder in which Yinz will look for layouts
// (Requires restart)
//
// layout_dir "/path/to/my/layout_dir"

// The folder in which Yinz will look for themes
// (Requires restart)
//
// theme_dir "/path/to/my/theme_dir"

// The folder in which Yinz will look for plugins you wrote yourself
// (Requires restart)
//
// user_plugin_dir "/path/to/my/plugins"

// Enable or disable the rendering of styled and colored underlines (undercurl).
// May need to be disabled for certain unsupported terminals
// (Requires restart)
// Default: true
//
// styled_underlines false

// Enable or disable writing of session metadata to disk (if disabled, other sessions might not know
// metadata info on this session)
// (Requires restart)
// Default: false
//
// disable_session_metadata true

// Enable or disable support for the enhanced Kitty Keyboard Protocol (the host terminal must also support it)
// (Requires restart)
// Default: true (if the host terminal supports it)
//
// support_kitty_keyboard_protocol false

// Ask the host terminal to report the modifier keys themselves, so the UI can show
// something for as long as eg. Alt is held. Needs Kitty Keyboard flags that also make
// every printable key arrive as an escape code: AltGr glyphs, dead keys and IME input
// will stop working. US-ASCII, shifted punctuation included, keeps working on a terminal
// that supports reporting alternate keys. (Requires restart) Default: false
//
// report_modifier_keys true

// Enable or disable support for the Kitty Graphics Protocol, used to display images (the host terminal must also support it)
// (Requires restart)
// Default: true (if the host terminal supports it)
//
// support_kitty_graphics_protocol false

// Whether to stack panes when resizing beyond a certain size
// Default: true
//
// stacked_resize false

// The smallest tiled pane worth giving a newly spawned coding agent, as a terminal
// size. Before an agent pane joins a tab, yinz projects the area each tiled pane
// would have if the tab's tiled panes (floating ones aside) shared the viewport
// equally, and compares it with columns x rows. A tab that would fall below it
// sends the agent to the roomiest other tab that stays above it, or to a new tab.
// Set either to 0 to always open agents where they were asked for.
// Default: 80 and 24
//
// agent_pane_min_columns 80
// agent_pane_min_rows 24

// Whether to let programs running inside panes read the paste buffer (clipboard)
// with the OSC 52 escape sequence. When enabled, any program in any pane -
// including one running on a remote machine over SSH - can read the clipboard
// without the user being asked.
// Default: false
//
// dangerously_enable_paste_buffer_read true

// Whether stacked panes display as a list with the expanded pane pinned to the bottom
// Default: true
//
// stacked_pane_list false

// Whether to enable mouse hover effects and pane grouping functionality
// Default: true
//
// advanced_mouse_actions false

// Whether Ctrl+ScrollWheel resizes panes
// Default: true
//
// mouse_scroll_resize false

// Whether to enable mouse hover visual effects (frame highlight and help text)
// Default: true
//
// mouse_hover_effects false

// Whether triple-clicking inside command output marked by the shell (OSC 133) selects
// the command and its output instead of the logical line
// Default: true
//
// osc133_command_selection false

// Characters that terminate a word when double-clicking to select it
// whitespace is always a separator and need not be listed here
// Default: "[]{}<>()"
//
// word_separators "[]{}<>()"

// Whether to output OSC8 hyperlink sequences
// Default: true
//
// osc8_hyperlinks false

// A command to run (will be wrapped with sh -c and provided the RESURRECT_COMMAND env variable)
// after Yinz attempts to discover a command inside a pane when resurrecting sessions, the STDOUT
// of this command will be used instead of the discovered RESURRECT_COMMAND
// can be useful for removing wrappers around commands
// Note: be sure to escape backslashes and similar characters properly
//
// post_command_discovery_hook "echo $RESURRECT_COMMAND | sed <your_regex_here>"

// Map supported managed Claude/Codex launch palettes through the active Yinz theme.
// Use "off" to show their original colors. Takes effect immediately, including scrollback.
// agent_theme_mapping "semantic"

// Enable tab groups (default: true). Disable to show all tabs in a single tab-bar row.
// tab_groups false
