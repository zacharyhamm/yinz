themes {
    "shades-of-purple" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Shades%20Of%20Purple
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#121134"
        terminal {
            foreground "#ffffff"
            background "#1e1d40"
            black "#000000"
            red "#d90429"
            green "#3ad900"
            yellow "#ffe700"
            blue "#6943ff"
            magenta "#ff2c70"
            cyan "#00c5c7"
            white "#c7c7c7"
            bright_black "#686868"
            bright_red "#f92a1c"
            bright_green "#43d426"
            bright_yellow "#f1d000"
            bright_blue "#6871ff"
            bright_magenta "#ff77ff"
            bright_cyan "#79e8fb"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#ffffff"
            background "#1e1d40"
            emphasis_0 "#ffe700"
            emphasis_1 "#00c5c7"
            emphasis_2 "#3ad900"
            emphasis_3 "#ff2e71"
        }
        text_selected {
            base "#242424"
            background "#b362ff"
            emphasis_0 "#282400"
            emphasis_1 "#002929"
            emphasis_2 "#0b2a00"
            emphasis_3 "#480c20"
        }
        table_cell_unselected {
            base "#ffffff"
            background "#1e1d40"
            emphasis_0 "#ffe700"
            emphasis_1 "#00c5c7"
            emphasis_2 "#3ad900"
            emphasis_3 "#ff2e71"
        }
        table_cell_selected {
            base "#242424"
            background "#b362ff"
            emphasis_0 "#282400"
            emphasis_1 "#002929"
            emphasis_2 "#0b2a00"
            emphasis_3 "#480c20"
        }
        list_unselected {
            base "#ffffff"
            background "#1e1d40"
            emphasis_0 "#ffe700"
            emphasis_1 "#00c5c7"
            emphasis_2 "#3ad900"
            emphasis_3 "#ff2e71"
        }
        list_selected {
            base "#242424"
            background "#b362ff"
            emphasis_0 "#282400"
            emphasis_1 "#002929"
            emphasis_2 "#0b2a00"
            emphasis_3 "#480c20"
        }
        ribbon_selected {
            base "#1e1d40"
            background "#3ad900"
            emphasis_0 "#9d031e"
            emphasis_1 "#554d00"
            emphasis_2 "#931941"
            emphasis_3 "#4d31ba"
        }
        ribbon_unselected {
            base "#1e1d40"
            background "#ffffff"
            emphasis_0 "#d90429"
            emphasis_1 "#ffffff"
            emphasis_2 "#6943ff"
            emphasis_3 "#e02762"
        }
        table_title {
            base "#3ad900"
            background "#1e1d40"
            emphasis_0 "#ffe700"
            emphasis_1 "#00c5c7"
            emphasis_2 "#3ad900"
            emphasis_3 "#ff2e71"
        }
        frame_unselected {
            base "#ffffff"
            background "#1e1d40"
            emphasis_0 "#ffffff"
            emphasis_1 "#ffffff"
            emphasis_2 "#ffffff"
            emphasis_3 "#ffffff"
        }
        frame_selected {
            base "#3ad900"
            background "#1e1d40"
            emphasis_0 "#ffe700"
            emphasis_1 "#00c5c7"
            emphasis_2 "#3ad900"
            emphasis_3 "#ff2e71"
        }
        frame_highlight {
            base "#ffe700"
            background "#1e1d40"
            emphasis_0 "#ff2e71"
            emphasis_1 "#ffe700"
            emphasis_2 "#ffe700"
            emphasis_3 "#ffe700"
        }
        exit_code_success {
            base "#3ad900"
            background "#1e1d40"
            emphasis_0 "#00c5c7"
            emphasis_1 "#ffffff"
            emphasis_2 "#ff2e71"
            emphasis_3 "#8d70ff"
        }
        exit_code_error {
            base "#e5566f"
            background "#1e1d40"
            emphasis_0 "#ffe700"
            emphasis_1 "#ffffff"
            emphasis_2 "#ff2e71"
            emphasis_3 "#8d70ff"
        }
        multiplayer_user_colors {
            player_1 "#ff2e71"
            player_2 "#8d70ff"
            player_3 "#ff77ff"
            player_4 "#ffe700"
            player_5 "#00c5c7"
            player_6 "#f1d000"
            player_7 "#e5566f"
            player_8 "#c7c7c7"
            player_9 "#fa4236"
            player_10 "#7179ff"
        }
    }
}
