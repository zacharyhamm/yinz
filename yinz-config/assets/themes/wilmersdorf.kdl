themes {
    "wilmersdorf" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Wilmersdorf
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#1c1f27"
        terminal {
            foreground "#c6c6c6"
            background "#282b33"
            black "#34373e"
            red "#e06383"
            green "#7ebebd"
            yellow "#cccccc"
            blue "#a6c1e0"
            magenta "#e1c1ee"
            cyan "#5b94ab"
            white "#ababab"
            bright_black "#50545d"
            bright_red "#fa7193"
            bright_green "#8fd7d6"
            bright_yellow "#d1dfff"
            bright_blue "#b2cff0"
            bright_magenta "#efccfd"
            bright_cyan "#69abc5"
            bright_white "#d3d3d3"
        }
        text_unselected {
            base "#c6c6c6"
            background "#282b33"
            emphasis_0 "#cccccc"
            emphasis_1 "#6299af"
            emphasis_2 "#7ebebd"
            emphasis_3 "#e1c1ee"
        }
        text_selected {
            base "#282b33"
            background "#c6c6c6"
            emphasis_0 "#535353"
            emphasis_1 "#365765"
            emphasis_2 "#3a5857"
            emphasis_3 "#5b4e60"
        }
        table_cell_unselected {
            base "#c6c6c6"
            background "#282b33"
            emphasis_0 "#cccccc"
            emphasis_1 "#6299af"
            emphasis_2 "#7ebebd"
            emphasis_3 "#e1c1ee"
        }
        table_cell_selected {
            base "#c6c6c6"
            background "#1f2024"
            emphasis_0 "#cccccc"
            emphasis_1 "#5b94ab"
            emphasis_2 "#7ebebd"
            emphasis_3 "#e1c1ee"
        }
        list_unselected {
            base "#c6c6c6"
            background "#282b33"
            emphasis_0 "#cccccc"
            emphasis_1 "#6299af"
            emphasis_2 "#7ebebd"
            emphasis_3 "#e1c1ee"
        }
        list_selected {
            base "#c6c6c6"
            background "#1f2024"
            emphasis_0 "#cccccc"
            emphasis_1 "#5b94ab"
            emphasis_2 "#7ebebd"
            emphasis_3 "#e1c1ee"
        }
        ribbon_selected {
            base "#282b33"
            background "#7ebebd"
            emphasis_0 "#703141"
            emphasis_1 "#454545"
            emphasis_2 "#4d4251"
            emphasis_3 "#3d4652"
        }
        ribbon_unselected {
            base "#282b33"
            background "#c6c6c6"
            emphasis_0 "#843a4d"
            emphasis_1 "#c6c6c6"
            emphasis_2 "#485462"
            emphasis_3 "#5b4e60"
        }
        table_title {
            base "#7ebebd"
            background "#282b33"
            emphasis_0 "#cccccc"
            emphasis_1 "#6299af"
            emphasis_2 "#7ebebd"
            emphasis_3 "#e1c1ee"
        }
        frame_unselected {
            base "#c6c6c6"
            background "#282b33"
            emphasis_0 "#c6c6c6"
            emphasis_1 "#c6c6c6"
            emphasis_2 "#c6c6c6"
            emphasis_3 "#c6c6c6"
        }
        frame_selected {
            base "#7ebebd"
            background "#282b33"
            emphasis_0 "#cccccc"
            emphasis_1 "#6299af"
            emphasis_2 "#7ebebd"
            emphasis_3 "#e1c1ee"
        }
        frame_highlight {
            base "#cccccc"
            background "#282b33"
            emphasis_0 "#e1c1ee"
            emphasis_1 "#cccccc"
            emphasis_2 "#cccccc"
            emphasis_3 "#cccccc"
        }
        exit_code_success {
            base "#7ebebd"
            background "#282b33"
            emphasis_0 "#6299af"
            emphasis_1 "#c6c6c6"
            emphasis_2 "#e1c1ee"
            emphasis_3 "#a6c1e0"
        }
        exit_code_error {
            base "#e26b89"
            background "#282b33"
            emphasis_0 "#cccccc"
            emphasis_1 "#c6c6c6"
            emphasis_2 "#e1c1ee"
            emphasis_3 "#a6c1e0"
        }
        multiplayer_user_colors {
            player_1 "#e1c1ee"
            player_2 "#a6c1e0"
            player_3 "#efccfd"
            player_4 "#cccccc"
            player_5 "#6299af"
            player_6 "#d1dfff"
            player_7 "#e26b89"
            player_8 "#ababab"
            player_9 "#fa7193"
            player_10 "#b2cff0"
        }
    }
}
