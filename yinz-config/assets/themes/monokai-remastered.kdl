themes {
    "monokai-remastered" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Monokai%20Remastered
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000000"
        terminal {
            foreground "#d9d9d9"
            background "#0c0c0c"
            black "#1a1a1a"
            red "#f4005f"
            green "#98e024"
            yellow "#fd971f"
            blue "#9d65ff"
            magenta "#f4005f"
            cyan "#58d1eb"
            white "#c4c5b5"
            bright_black "#625e4c"
            bright_red "#f4005f"
            bright_green "#98e024"
            bright_yellow "#e0d561"
            bright_blue "#9d65ff"
            bright_magenta "#f4005f"
            bright_cyan "#58d1eb"
            bright_white "#f6f6ef"
        }
        text_unselected {
            base "#d9d9d9"
            background "#0c0c0c"
            emphasis_0 "#fd971f"
            emphasis_1 "#58d1eb"
            emphasis_2 "#98e024"
            emphasis_3 "#f4005f"
        }
        text_selected {
            base "#0c0c0c"
            background "#d9d9d9"
            emphasis_0 "#8a5211"
            emphasis_1 "#2b6774"
            emphasis_2 "#486911"
            emphasis_3 "#994164"
        }
        table_cell_unselected {
            base "#d9d9d9"
            background "#0c0c0c"
            emphasis_0 "#fd971f"
            emphasis_1 "#58d1eb"
            emphasis_2 "#98e024"
            emphasis_3 "#f4005f"
        }
        table_cell_selected {
            base "#ffffff"
            background "#343434"
            emphasis_0 "#fd971f"
            emphasis_1 "#58d1eb"
            emphasis_2 "#98e024"
            emphasis_3 "#f96aa2"
        }
        list_unselected {
            base "#d9d9d9"
            background "#0c0c0c"
            emphasis_0 "#fd971f"
            emphasis_1 "#58d1eb"
            emphasis_2 "#98e024"
            emphasis_3 "#f4005f"
        }
        list_selected {
            base "#ffffff"
            background "#343434"
            emphasis_0 "#fd971f"
            emphasis_1 "#58d1eb"
            emphasis_2 "#98e024"
            emphasis_3 "#f96aa2"
        }
        ribbon_selected {
            base "#0c0c0c"
            background "#98e024"
            emphasis_0 "#ae0044"
            emphasis_1 "#7d4b0f"
            emphasis_2 "#ae0044"
            emphasis_3 "#6641a5"
        }
        ribbon_unselected {
            base "#0c0c0c"
            background "#d9d9d9"
            emphasis_0 "#be004a"
            emphasis_1 "#d9d9d9"
            emphasis_2 "#7048b6"
            emphasis_3 "#be004a"
        }
        table_title {
            base "#98e024"
            background "#0c0c0c"
            emphasis_0 "#fd971f"
            emphasis_1 "#58d1eb"
            emphasis_2 "#98e024"
            emphasis_3 "#f4005f"
        }
        frame_unselected {
            base "#d9d9d9"
            background "#0c0c0c"
            emphasis_0 "#d9d9d9"
            emphasis_1 "#d9d9d9"
            emphasis_2 "#d9d9d9"
            emphasis_3 "#d9d9d9"
        }
        frame_selected {
            base "#98e024"
            background "#0c0c0c"
            emphasis_0 "#fd971f"
            emphasis_1 "#58d1eb"
            emphasis_2 "#98e024"
            emphasis_3 "#f4005f"
        }
        frame_highlight {
            base "#fd971f"
            background "#0c0c0c"
            emphasis_0 "#f4005f"
            emphasis_1 "#fd971f"
            emphasis_2 "#fd971f"
            emphasis_3 "#fd971f"
        }
        exit_code_success {
            base "#98e024"
            background "#0c0c0c"
            emphasis_0 "#58d1eb"
            emphasis_1 "#d9d9d9"
            emphasis_2 "#f4005f"
            emphasis_3 "#9d65ff"
        }
        exit_code_error {
            base "#f4005f"
            background "#0c0c0c"
            emphasis_0 "#fd971f"
            emphasis_1 "#d9d9d9"
            emphasis_2 "#f4005f"
            emphasis_3 "#9d65ff"
        }
        multiplayer_user_colors {
            player_1 "#f4005f"
            player_2 "#9d65ff"
            player_3 "#f4005f"
            player_4 "#fd971f"
            player_5 "#58d1eb"
            player_6 "#e0d561"
            player_7 "#f4005f"
            player_8 "#c4c5b5"
            player_9 "#f4005f"
            player_10 "#9d65ff"
        }
    }
}
