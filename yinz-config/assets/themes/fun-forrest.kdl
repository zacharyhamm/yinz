themes {
    "fun-forrest" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Fun%20Forrest
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#190600"
        terminal {
            foreground "#dec165"
            background "#251200"
            black "#000000"
            red "#d6262b"
            green "#919c00"
            yellow "#be8a13"
            blue "#4699a3"
            magenta "#8d4331"
            cyan "#da8213"
            white "#ddc265"
            bright_black "#7f6a55"
            bright_red "#e55a1c"
            bright_green "#bfc65a"
            bright_yellow "#ffcb1b"
            bright_blue "#7cc9cf"
            bright_magenta "#d26349"
            bright_cyan "#e6a96b"
            bright_white "#ffeaa3"
        }
        text_unselected {
            base "#dec165"
            background "#251200"
            emphasis_0 "#be8a13"
            emphasis_1 "#da8213"
            emphasis_2 "#919c00"
            emphasis_3 "#aa7265"
        }
        text_selected {
            base "#000000"
            background "#e5591c"
            emphasis_0 "#291e04"
            emphasis_1 "#2d1b04"
            emphasis_2 "#1f2100"
            emphasis_3 "#331812"
        }
        table_cell_unselected {
            base "#dec165"
            background "#251200"
            emphasis_0 "#be8a13"
            emphasis_1 "#da8213"
            emphasis_2 "#919c00"
            emphasis_3 "#aa7265"
        }
        table_cell_selected {
            base "#000000"
            background "#e5591c"
            emphasis_0 "#291e04"
            emphasis_1 "#2d1b04"
            emphasis_2 "#1f2100"
            emphasis_3 "#331812"
        }
        list_unselected {
            base "#dec165"
            background "#251200"
            emphasis_0 "#be8a13"
            emphasis_1 "#da8213"
            emphasis_2 "#919c00"
            emphasis_3 "#aa7265"
        }
        list_selected {
            base "#000000"
            background "#e5591c"
            emphasis_0 "#291e04"
            emphasis_1 "#2d1b04"
            emphasis_2 "#1f2100"
            emphasis_3 "#331812"
        }
        ribbon_selected {
            base "#251200"
            background "#919c00"
            emphasis_0 "#5c1013"
            emphasis_1 "#3c2b06"
            emphasis_2 "#4a231a"
            emphasis_3 "#173236"
        }
        ribbon_unselected {
            base "#251200"
            background "#dec165"
            emphasis_0 "#9e1c20"
            emphasis_1 "#dec165"
            emphasis_2 "#28585e"
            emphasis_3 "#813d2d"
        }
        table_title {
            base "#919c00"
            background "#251200"
            emphasis_0 "#be8a13"
            emphasis_1 "#da8213"
            emphasis_2 "#919c00"
            emphasis_3 "#aa7265"
        }
        frame_unselected {
            base "#dec165"
            background "#251200"
            emphasis_0 "#dec165"
            emphasis_1 "#dec165"
            emphasis_2 "#dec165"
            emphasis_3 "#dec165"
        }
        frame_selected {
            base "#919c00"
            background "#251200"
            emphasis_0 "#be8a13"
            emphasis_1 "#da8213"
            emphasis_2 "#919c00"
            emphasis_3 "#aa7265"
        }
        frame_highlight {
            base "#be8a13"
            background "#251200"
            emphasis_0 "#aa7265"
            emphasis_1 "#be8a13"
            emphasis_2 "#be8a13"
            emphasis_3 "#be8a13"
        }
        exit_code_success {
            base "#919c00"
            background "#251200"
            emphasis_0 "#da8213"
            emphasis_1 "#dec165"
            emphasis_2 "#aa7265"
            emphasis_3 "#4699a3"
        }
        exit_code_error {
            base "#dd4d51"
            background "#251200"
            emphasis_0 "#be8a13"
            emphasis_1 "#dec165"
            emphasis_2 "#aa7265"
            emphasis_3 "#4699a3"
        }
        multiplayer_user_colors {
            player_1 "#aa7265"
            player_2 "#4699a3"
            player_3 "#d26349"
            player_4 "#be8a13"
            player_5 "#da8213"
            player_6 "#ffcb1b"
            player_7 "#dd4d51"
            player_8 "#ddc265"
            player_9 "#e55a1c"
            player_10 "#7cc9cf"
        }
    }
}
