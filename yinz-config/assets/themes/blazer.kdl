themes {
    "blazer" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Blazer
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#010d1a"
        terminal {
            foreground "#d9e6f2"
            background "#0d1926"
            black "#000000"
            red "#b87a7a"
            green "#7ab87a"
            yellow "#b8b87a"
            blue "#7a7ab8"
            magenta "#b87ab8"
            cyan "#7ab8b8"
            white "#d9d9d9"
            bright_black "#4c4c4c"
            bright_red "#dbbdbd"
            bright_green "#bddbbd"
            bright_yellow "#dbdbbd"
            bright_blue "#bdbddb"
            bright_magenta "#dbbddb"
            bright_cyan "#bddbdb"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#d9e6f2"
            background "#0d1926"
            emphasis_0 "#b8b87a"
            emphasis_1 "#7ab8b8"
            emphasis_2 "#7ab87a"
            emphasis_3 "#b87ab8"
        }
        text_selected {
            base "#000000"
            background "#c1ddff"
            emphasis_0 "#626241"
            emphasis_1 "#446666"
            emphasis_2 "#456845"
            emphasis_3 "#7b527b"
        }
        table_cell_unselected {
            base "#d9e6f2"
            background "#0d1926"
            emphasis_0 "#b8b87a"
            emphasis_1 "#7ab8b8"
            emphasis_2 "#7ab87a"
            emphasis_3 "#b87ab8"
        }
        table_cell_selected {
            base "#000000"
            background "#c1ddff"
            emphasis_0 "#626241"
            emphasis_1 "#446666"
            emphasis_2 "#456845"
            emphasis_3 "#7b527b"
        }
        list_unselected {
            base "#d9e6f2"
            background "#0d1926"
            emphasis_0 "#b8b87a"
            emphasis_1 "#7ab8b8"
            emphasis_2 "#7ab87a"
            emphasis_3 "#b87ab8"
        }
        list_selected {
            base "#000000"
            background "#c1ddff"
            emphasis_0 "#626241"
            emphasis_1 "#446666"
            emphasis_2 "#456845"
            emphasis_3 "#7b527b"
        }
        ribbon_selected {
            base "#0d1926"
            background "#7ab87a"
            emphasis_0 "#543737"
            emphasis_1 "#40402b"
            emphasis_2 "#503550"
            emphasis_3 "#3c3c5b"
        }
        ribbon_unselected {
            base "#0d1926"
            background "#d9e6f2"
            emphasis_0 "#885a5a"
            emphasis_1 "#d9e6f2"
            emphasis_2 "#616192"
            emphasis_3 "#835783"
        }
        table_title {
            base "#7ab87a"
            background "#0d1926"
            emphasis_0 "#b8b87a"
            emphasis_1 "#7ab8b8"
            emphasis_2 "#7ab87a"
            emphasis_3 "#b87ab8"
        }
        frame_unselected {
            base "#d9e6f2"
            background "#0d1926"
            emphasis_0 "#d9e6f2"
            emphasis_1 "#d9e6f2"
            emphasis_2 "#d9e6f2"
            emphasis_3 "#d9e6f2"
        }
        frame_selected {
            base "#7ab87a"
            background "#0d1926"
            emphasis_0 "#b8b87a"
            emphasis_1 "#7ab8b8"
            emphasis_2 "#7ab87a"
            emphasis_3 "#b87ab8"
        }
        frame_highlight {
            base "#b8b87a"
            background "#0d1926"
            emphasis_0 "#b87ab8"
            emphasis_1 "#b8b87a"
            emphasis_2 "#b8b87a"
            emphasis_3 "#b8b87a"
        }
        exit_code_success {
            base "#7ab87a"
            background "#0d1926"
            emphasis_0 "#7ab8b8"
            emphasis_1 "#d9e6f2"
            emphasis_2 "#b87ab8"
            emphasis_3 "#7b7bb8"
        }
        exit_code_error {
            base "#b87a7a"
            background "#0d1926"
            emphasis_0 "#b8b87a"
            emphasis_1 "#d9e6f2"
            emphasis_2 "#b87ab8"
            emphasis_3 "#7b7bb8"
        }
        multiplayer_user_colors {
            player_1 "#b87ab8"
            player_2 "#7b7bb8"
            player_3 "#dbbddb"
            player_4 "#b8b87a"
            player_5 "#7ab8b8"
            player_6 "#dbdbbd"
            player_7 "#b87a7a"
            player_8 "#d9d9d9"
            player_9 "#dbbdbd"
            player_10 "#bdbddb"
        }
    }
}
