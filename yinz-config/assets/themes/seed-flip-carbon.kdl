themes {
    "seed-flip-carbon" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/SeedFlip%20Carbon
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#eeeeee"
        terminal {
            foreground "#000000"
            background "#fafafa"
            black "#d4d4d4"
            red "#993333"
            green "#339955"
            yellow "#998833"
            blue "#335d99"
            magenta "#993399"
            cyan "#339999"
            white "#000000"
            bright_black "#aeaeae"
            bright_red "#c65353"
            bright_green "#53c679"
            bright_yellow "#c6b353"
            bright_blue "#5383c6"
            bright_magenta "#c653c6"
            bright_cyan "#53c6c6"
            bright_white "#000000"
        }
        text_unselected {
            base "#000000"
            background "#fafafa"
            emphasis_0 "#82732b"
            emphasis_1 "#2a7f7f"
            emphasis_2 "#2c8349"
            emphasis_3 "#993399"
        }
        text_selected {
            base "#fafafa"
            background "#000000"
            emphasis_0 "#85762c"
            emphasis_1 "#2b8282"
            emphasis_2 "#2d864b"
            emphasis_3 "#a954a9"
        }
        table_cell_unselected {
            base "#000000"
            background "#fafafa"
            emphasis_0 "#82732b"
            emphasis_1 "#2a7f7f"
            emphasis_2 "#2c8349"
            emphasis_3 "#993399"
        }
        table_cell_selected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#85762c"
            emphasis_1 "#2b8282"
            emphasis_2 "#2d864b"
            emphasis_3 "#993399"
        }
        list_unselected {
            base "#000000"
            background "#fafafa"
            emphasis_0 "#82732b"
            emphasis_1 "#2a7f7f"
            emphasis_2 "#2c8349"
            emphasis_3 "#993399"
        }
        list_selected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#85762c"
            emphasis_1 "#2b8282"
            emphasis_2 "#2d864b"
            emphasis_3 "#993399"
        }
        ribbon_selected {
            base "#202020"
            background "#339955"
            emphasis_0 "#3a1313"
            emphasis_1 "#24200c"
            emphasis_2 "#351235"
            emphasis_3 "#122035"
        }
        ribbon_unselected {
            base "#fafafa"
            background "#000000"
            emphasis_0 "#ae5d5d"
            emphasis_1 "#000000"
            emphasis_2 "#5276a9"
            emphasis_3 "#a954a9"
        }
        table_title {
            base "#2c8349"
            background "#fafafa"
            emphasis_0 "#82732b"
            emphasis_1 "#2a7f7f"
            emphasis_2 "#2c8349"
            emphasis_3 "#993399"
        }
        frame_unselected {
            base "#000000"
            background "#fafafa"
            emphasis_0 "#000000"
            emphasis_1 "#000000"
            emphasis_2 "#000000"
            emphasis_3 "#000000"
        }
        frame_selected {
            base "#2c8349"
            background "#fafafa"
            emphasis_0 "#82732b"
            emphasis_1 "#2a7f7f"
            emphasis_2 "#2c8349"
            emphasis_3 "#993399"
        }
        frame_highlight {
            base "#82732b"
            background "#fafafa"
            emphasis_0 "#993399"
            emphasis_1 "#82732b"
            emphasis_2 "#82732b"
            emphasis_3 "#82732b"
        }
        exit_code_success {
            base "#2c8349"
            background "#fafafa"
            emphasis_0 "#2a7f7f"
            emphasis_1 "#000000"
            emphasis_2 "#993399"
            emphasis_3 "#335d99"
        }
        exit_code_error {
            base "#993333"
            background "#fafafa"
            emphasis_0 "#82732b"
            emphasis_1 "#000000"
            emphasis_2 "#993399"
            emphasis_3 "#335d99"
        }
        multiplayer_user_colors {
            player_1 "#993399"
            player_2 "#335d99"
            player_3 "#b04ab0"
            player_4 "#82732b"
            player_5 "#2a7f7f"
            player_6 "#807436"
            player_7 "#993333"
            player_8 "#000000"
            player_9 "#be5050"
            player_10 "#4a75b1"
        }
    }
}
