        }
        frame_highlight {
            base 203 75 22
            background 0
            emphasis_0 211 54 130
            emphasis_1 203 75 22
            emphasis_2 203 75 22
            emphasis_3 203 75 22
        }
        exit_code_success {
            base 133 153 0
            background 0
            emphasis_0 42 161 152
            emphasis_1 7 54 66
            emphasis_2 211 54 130
            emphasis_3 38 139 210
        }
        exit_code_error {
            base 220 50 47
            background 0
            emphasis_0 181 137 0
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
