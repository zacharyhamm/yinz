themes {
    "neobones-light" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Neobones%20Light
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#d9e1da"
        terminal {
            foreground "#202e18"
            background "#e5ede6"
            black "#e5ede6"
            red "#a8334c"
            green "#567a30"
            yellow "#944927"
            blue "#286486"
            magenta "#88507d"
            cyan "#3b8992"
            white "#202e18"
            bright_black "#99ac9c"
            bright_red "#94253e"
            bright_green "#3f5a22"
            bright_yellow "#803d1c"
            bright_blue "#1d5573"
            bright_magenta "#7b3b70"
            bright_cyan "#2b747c"
            bright_white "#415934"
        }
        text_unselected {
            base "#202e18"
            background "#e5ede6"
            emphasis_0 "#944927"
            emphasis_1 "#32737b"
            emphasis_2 "#52742e"
            emphasis_3 "#88507d"
        }
        text_selected {
            base "#e5ede6"
            background "#202e18"
            emphasis_0 "#b6866f"
            emphasis_1 "#71979c"
            emphasis_2 "#82976d"
            emphasis_3 "#a986a2"
        }
        table_cell_unselected {
            base "#202e18"
            background "#e5ede6"
            emphasis_0 "#944927"
            emphasis_1 "#32737b"
            emphasis_2 "#52742e"
            emphasis_3 "#88507d"
        }
        table_cell_selected {
            base "#202e18"
            background "#ade48c"
            emphasis_0 "#914826"
            emphasis_1 "#2b646b"
            emphasis_2 "#476528"
            emphasis_3 "#7f4b75"
        }
        list_unselected {
            base "#202e18"
            background "#e5ede6"
            emphasis_0 "#944927"
            emphasis_1 "#32737b"
            emphasis_2 "#52742e"
            emphasis_3 "#88507d"
        }
        list_selected {
            base "#202e18"
            background "#ade48c"
            emphasis_0 "#914826"
            emphasis_1 "#2b646b"
            emphasis_2 "#476528"
            emphasis_3 "#7f4b75"
        }
        ribbon_selected {
            base "#f0f5f0"
            background "#567a30"
            emphasis_0 "#faf2f4"
            emphasis_1 "#f8f3f1"
            emphasis_2 "#f7f3f6"
            emphasis_3 "#f1f5f7"
        }
        ribbon_unselected {
            base "#e5ede6"
            background "#202e18"
            emphasis_0 "#c77b8b"
            emphasis_1 "#202e18"
            emphasis_2 "#6d96ad"
            emphasis_3 "#ac85a4"
        }
        table_title {
            base "#52742e"
            background "#e5ede6"
            emphasis_0 "#944927"
            emphasis_1 "#32737b"
            emphasis_2 "#52742e"
            emphasis_3 "#88507d"
        }
        frame_unselected {
            base "#202e18"
            background "#e5ede6"
            emphasis_0 "#202e18"
            emphasis_1 "#202e18"
            emphasis_2 "#202e18"
            emphasis_3 "#202e18"
        }
        frame_selected {
            base "#52742e"
            background "#e5ede6"
            emphasis_0 "#944927"
            emphasis_1 "#32737b"
            emphasis_2 "#52742e"
            emphasis_3 "#88507d"
        }
        frame_highlight {
            base "#944927"
            background "#e5ede6"
            emphasis_0 "#88507d"
            emphasis_1 "#944927"
            emphasis_2 "#944927"
            emphasis_3 "#944927"
        }
        exit_code_success {
            base "#52742e"
            background "#e5ede6"
            emphasis_0 "#32737b"
            emphasis_1 "#202e18"
            emphasis_2 "#88507d"
            emphasis_3 "#286486"
        }
        exit_code_error {
            base "#a8334c"
            background "#e5ede6"
            emphasis_0 "#944927"
            emphasis_1 "#202e18"
            emphasis_2 "#88507d"
            emphasis_3 "#286486"
        }
        multiplayer_user_colors {
            player_1 "#88507d"
            player_2 "#286486"
            player_3 "#7b3b70"
            player_4 "#944927"
            player_5 "#32737b"
            player_6 "#803d1c"
            player_7 "#a8334c"
            player_8 "#202e18"
            player_9 "#94253e"
            player_10 "#1d5573"
        }
    }
}
