themes {
    "one-double-dark" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/One%20Double%20Dark
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#1c2028"
        terminal {
            foreground "#dbdfe5"
            background "#282c34"
            black "#3d4452"
            red "#f16372"
            green "#8cc570"
            yellow "#ecbe70"
            blue "#3fb1f5"
            magenta "#d373e3"
            cyan "#17b9c4"
            white "#dbdfe5"
            bright_black "#525d6f"
            bright_red "#ff777b"
            bright_green "#82d882"
            bright_yellow "#f5c065"
            bright_blue "#6dcaff"
            bright_magenta "#ff7bf4"
            bright_cyan "#00e5fb"
            bright_white "#f7f9fc"
        }
        text_unselected {
            base "#dbdfe5"
            background "#282c34"
            emphasis_0 "#ecbe70"
            emphasis_1 "#17b9c4"
            emphasis_2 "#8cc570"
            emphasis_3 "#d373e3"
        }
        text_selected {
            base "#282c34"
            background "#dbdfe5"
            emphasis_0 "#706146"
            emphasis_1 "#47686a"
            emphasis_2 "#576750"
            emphasis_3 "#6f5d72"
        }
        table_cell_unselected {
            base "#dbdfe5"
            background "#282c34"
            emphasis_0 "#ecbe70"
            emphasis_1 "#17b9c4"
            emphasis_2 "#8cc570"
            emphasis_3 "#d373e3"
        }
        table_cell_selected {
            base "#cdd6f4"
            background "#585b70"
            emphasis_0 "#f1d097"
            emphasis_1 "#9ae1e5"
            emphasis_2 "#bddead"
            emphasis_3 "#eec8f4"
        }
        list_unselected {
            base "#dbdfe5"
            background "#282c34"
            emphasis_0 "#ecbe70"
            emphasis_1 "#17b9c4"
            emphasis_2 "#8cc570"
            emphasis_3 "#d373e3"
        }
        list_selected {
            base "#cdd6f4"
            background "#585b70"
            emphasis_0 "#f1d097"
            emphasis_1 "#9ae1e5"
            emphasis_2 "#bddead"
            emphasis_3 "#eec8f4"
        }
        ribbon_selected {
            base "#282c34"
            background "#8cc570"
            emphasis_0 "#773138"
            emphasis_1 "#564529"
            emphasis_2 "#63366b"
            emphasis_3 "#1b4c6a"
        }
        ribbon_unselected {
            base "#282c34"
            background "#dbdfe5"
            emphasis_0 "#a4434d"
            emphasis_1 "#dbdfe5"
            emphasis_2 "#256890"
            emphasis_3 "#894a93"
        }
        table_title {
            base "#8cc570"
            background "#282c34"
            emphasis_0 "#ecbe70"
            emphasis_1 "#17b9c4"
            emphasis_2 "#8cc570"
            emphasis_3 "#d373e3"
        }
        frame_unselected {
            base "#dbdfe5"
            background "#282c34"
            emphasis_0 "#dbdfe5"
            emphasis_1 "#dbdfe5"
            emphasis_2 "#dbdfe5"
            emphasis_3 "#dbdfe5"
        }
        frame_selected {
            base "#8cc570"
            background "#282c34"
            emphasis_0 "#ecbe70"
            emphasis_1 "#17b9c4"
            emphasis_2 "#8cc570"
            emphasis_3 "#d373e3"
        }
        frame_highlight {
            base "#ecbe70"
            background "#282c34"
            emphasis_0 "#d373e3"
            emphasis_1 "#ecbe70"
            emphasis_2 "#ecbe70"
            emphasis_3 "#ecbe70"
        }
        exit_code_success {
            base "#8cc570"
            background "#282c34"
            emphasis_0 "#17b9c4"
            emphasis_1 "#dbdfe5"
            emphasis_2 "#d373e3"
            emphasis_3 "#3fb1f5"
        }
        exit_code_error {
            base "#f16372"
            background "#282c34"
            emphasis_0 "#ecbe70"
            emphasis_1 "#dbdfe5"
            emphasis_2 "#d373e3"
            emphasis_3 "#3fb1f5"
        }
        multiplayer_user_colors {
            player_1 "#d373e3"
            player_2 "#3fb1f5"
            player_3 "#ff7bf4"
            player_4 "#ecbe70"
            player_5 "#17b9c4"
            player_6 "#f5c065"
            player_7 "#f16372"
            player_8 "#dbdfe5"
            player_9 "#ff777b"
            player_10 "#6dcaff"
        }
    }
}
