themes {
    "gleam-classic" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Gleam%20Classic
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#121212"
        terminal {
            foreground "#ffffff"
            background "#1e1e1e"
            black "#000000"
            red "#f44747"
            green "#aadd8b"
            yellow "#ffd596"
            blue "#6796e6"
            magenta "#fe7ab2"
            cyan "#b181ec"
            white "#f7f7f7"
            bright_black "#808080"
            bright_red "#ff4a4a"
            bright_green "#c8ffa7"
            bright_yellow "#fdffab"
            bright_blue "#9ce7ff"
            bright_magenta "#ffaff3"
            bright_cyan "#d9baff"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#ffffff"
            background "#1e1e1e"
            emphasis_0 "#ffd596"
            emphasis_1 "#b181ec"
            emphasis_2 "#aadd8b"
            emphasis_3 "#fe7ab2"
        }
        text_selected {
            base "#060606"
            background "#777777"
            emphasis_0 "#070604"
            emphasis_1 "#08060b"
            emphasis_2 "#050704"
            emphasis_3 "#0b0508"
        }
        table_cell_unselected {
            base "#ffffff"
            background "#1e1e1e"
            emphasis_0 "#ffd596"
            emphasis_1 "#b181ec"
            emphasis_2 "#aadd8b"
            emphasis_3 "#fe7ab2"
        }
        table_cell_selected {
            base "#060606"
            background "#777777"
            emphasis_0 "#070604"
            emphasis_1 "#08060b"
            emphasis_2 "#050704"
            emphasis_3 "#0b0508"
        }
        list_unselected {
            base "#ffffff"
            background "#1e1e1e"
            emphasis_0 "#ffd596"
            emphasis_1 "#b181ec"
            emphasis_2 "#aadd8b"
            emphasis_3 "#fe7ab2"
        }
        list_selected {
            base "#060606"
            background "#777777"
            emphasis_0 "#070604"
            emphasis_1 "#08060b"
            emphasis_2 "#050704"
            emphasis_3 "#0b0508"
        }
        ribbon_selected {
            base "#1e1e1e"
            background "#aadd8b"
            emphasis_0 "#a12f2f"
            emphasis_1 "#67563d"
            emphasis_2 "#87415f"
            emphasis_3 "#3d5988"
        }
        ribbon_unselected {
            base "#1e1e1e"
            background "#ffffff"
            emphasis_0 "#d63e3e"
            emphasis_1 "#ffffff"
            emphasis_2 "#5176b5"
            emphasis_3 "#b5577f"
        }
        table_title {
            base "#aadd8b"
            background "#1e1e1e"
            emphasis_0 "#ffd596"
            emphasis_1 "#b181ec"
            emphasis_2 "#aadd8b"
            emphasis_3 "#fe7ab2"
        }
        frame_unselected {
            base "#ffffff"
            background "#1e1e1e"
            emphasis_0 "#ffffff"
            emphasis_1 "#ffffff"
            emphasis_2 "#ffffff"
            emphasis_3 "#ffffff"
        }
        frame_selected {
            base "#aadd8b"
            background "#1e1e1e"
            emphasis_0 "#ffd596"
            emphasis_1 "#b181ec"
            emphasis_2 "#aadd8b"
            emphasis_3 "#fe7ab2"
        }
        frame_highlight {
            base "#ffd596"
            background "#1e1e1e"
            emphasis_0 "#fe7ab2"
            emphasis_1 "#ffd596"
            emphasis_2 "#ffd596"
            emphasis_3 "#ffd596"
        }
        exit_code_success {
            base "#aadd8b"
            background "#1e1e1e"
            emphasis_0 "#b181ec"
            emphasis_1 "#ffffff"
            emphasis_2 "#fe7ab2"
            emphasis_3 "#6796e6"
        }
        exit_code_error {
            base "#f44747"
            background "#1e1e1e"
            emphasis_0 "#ffd596"
            emphasis_1 "#ffffff"
            emphasis_2 "#fe7ab2"
            emphasis_3 "#6796e6"
        }
        multiplayer_user_colors {
            player_1 "#fe7ab2"
            player_2 "#6796e6"
            player_3 "#ffaff3"
            player_4 "#ffd596"
            player_5 "#b181ec"
            player_6 "#fdffab"
            player_7 "#f44747"
            player_8 "#f7f7f7"
            player_9 "#ff4a4a"
            player_10 "#9ce7ff"
        }
    }
}
