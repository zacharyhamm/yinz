themes {
    "synthwave" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Synthwave
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000000"
        terminal {
            foreground "#dad9c7"
            background "#000000"
            black "#000000"
            red "#f6188f"
            green "#1ebb2b"
            yellow "#fdf834"
            blue "#2186ec"
            magenta "#f85a21"
            cyan "#12c3e2"
            white "#ffffff"
            bright_black "#7f7094"
            bright_red "#f841a0"
            bright_green "#25c141"
            bright_yellow "#fdf454"
            bright_blue "#2f9ded"
            bright_magenta "#f97137"
            bright_cyan "#19cde6"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#dad9c7"
            background "#000000"
            emphasis_0 "#fdf834"
            emphasis_1 "#12c3e2"
            emphasis_2 "#1ebb2b"
            emphasis_3 "#f85a21"
        }
        text_selected {
            base "#000000"
            background "#19cde6"
            emphasis_0 "#4e4d10"
            emphasis_1 "#085361"
            emphasis_2 "#0e5814"
            emphasis_3 "#843012"
        }
        table_cell_unselected {
            base "#dad9c7"
            background "#000000"
            emphasis_0 "#fdf834"
            emphasis_1 "#12c3e2"
            emphasis_2 "#1ebb2b"
            emphasis_3 "#f85a21"
        }
        table_cell_selected {
            base "#000000"
            background "#19cde6"
            emphasis_0 "#4e4d10"
            emphasis_1 "#085361"
            emphasis_2 "#0e5814"
            emphasis_3 "#843012"
        }
        list_unselected {
            base "#dad9c7"
            background "#000000"
            emphasis_0 "#fdf834"
            emphasis_1 "#12c3e2"
            emphasis_2 "#1ebb2b"
            emphasis_3 "#f85a21"
        }
        list_selected {
            base "#000000"
            background "#19cde6"
            emphasis_0 "#4e4d10"
            emphasis_1 "#085361"
            emphasis_2 "#0e5814"
            emphasis_3 "#843012"
        }
        ribbon_selected {
            base "#000000"
            background "#1ebb2b"
            emphasis_0 "#700b41"
            emphasis_1 "#3c3a0c"
            emphasis_2 "#64240d"
            emphasis_3 "#0e3a67"
        }
        ribbon_unselected {
            base "#000000"
            background "#dad9c7"
            emphasis_0 "#b51269"
            emphasis_1 "#dad9c7"
            emphasis_2 "#175fa8"
            emphasis_3 "#a53c16"
        }
        table_title {
            base "#1ebb2b"
            background "#000000"
            emphasis_0 "#fdf834"
            emphasis_1 "#12c3e2"
            emphasis_2 "#1ebb2b"
            emphasis_3 "#f85a21"
        }
        frame_unselected {
            base "#dad9c7"
            background "#000000"
            emphasis_0 "#dad9c7"
            emphasis_1 "#dad9c7"
            emphasis_2 "#dad9c7"
            emphasis_3 "#dad9c7"
        }
        frame_selected {
            base "#1ebb2b"
            background "#000000"
            emphasis_0 "#fdf834"
            emphasis_1 "#12c3e2"
            emphasis_2 "#1ebb2b"
            emphasis_3 "#f85a21"
        }
        frame_highlight {
            base "#fdf834"
            background "#000000"
            emphasis_0 "#f85a21"
            emphasis_1 "#fdf834"
            emphasis_2 "#fdf834"
            emphasis_3 "#fdf834"
        }
        exit_code_success {
            base "#1ebb2b"
            background "#000000"
            emphasis_0 "#12c3e2"
            emphasis_1 "#dad9c7"
            emphasis_2 "#f85a21"
            emphasis_3 "#2186ec"
        }
        exit_code_error {
            base "#f6188f"
            background "#000000"
            emphasis_0 "#fdf834"
            emphasis_1 "#dad9c7"
            emphasis_2 "#f85a21"
            emphasis_3 "#2186ec"
        }
        multiplayer_user_colors {
            player_1 "#f85a21"
            player_2 "#2186ec"
            player_3 "#f97137"
            player_4 "#fdf834"
            player_5 "#12c3e2"
            player_6 "#fdf454"
            player_7 "#f6188f"
            player_8 "#ffffff"
            player_9 "#f841a0"
            player_10 "#2f9ded"
        }
    }
}
