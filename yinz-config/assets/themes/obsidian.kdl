themes {
    "obsidian" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Obsidian
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#1c2427"
        terminal {
            foreground "#cdcdcd"
            background "#283033"
            black "#000000"
            red "#b30d0e"
            green "#00bb00"
            yellow "#fecd22"
            blue "#3a9bdb"
            magenta "#bb00bb"
            cyan "#00bbbb"
            white "#bbbbbb"
            bright_black "#555555"
            bright_red "#ff0003"
            bright_green "#93c863"
            bright_yellow "#fef874"
            bright_blue "#a1d7ff"
            bright_magenta "#ff55ff"
            bright_cyan "#55ffff"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#cdcdcd"
            background "#283033"
            emphasis_0 "#fecd22"
            emphasis_1 "#00bbbb"
            emphasis_2 "#00bb00"
            emphasis_3 "#d86cd8"
        }
        text_selected {
            base "#283033"
            background "#cdcdcd"
            emphasis_0 "#6a550e"
            emphasis_1 "#1c6161"
            emphasis_2 "#266326"
            emphasis_3 "#6d4c6d"
        }
        table_cell_unselected {
            base "#cdcdcd"
            background "#283033"
            emphasis_0 "#fecd22"
            emphasis_1 "#00bbbb"
            emphasis_2 "#00bb00"
            emphasis_3 "#d86cd8"
        }
        table_cell_selected {
            base "#dfe1e2"
            background "#3e4c4f"
            emphasis_0 "#fecd22"
            emphasis_1 "#3bcbcb"
            emphasis_2 "#51d151"
            emphasis_3 "#e6a1e6"
        }
        list_unselected {
            base "#cdcdcd"
            background "#283033"
            emphasis_0 "#fecd22"
            emphasis_1 "#00bbbb"
            emphasis_2 "#00bb00"
            emphasis_3 "#d86cd8"
        }
        list_selected {
            base "#dfe1e2"
            background "#3e4c4f"
            emphasis_0 "#fecd22"
            emphasis_1 "#3bcbcb"
            emphasis_2 "#51d151"
            emphasis_3 "#e6a1e6"
        }
        ribbon_selected {
            base "#283033"
            background "#00bb00"
            emphasis_0 "#750909"
            emphasis_1 "#443709"
            emphasis_2 "#680068"
            emphasis_3 "#163b53"
        }
        ribbon_unselected {
            base "#283033"
            background "#cdcdcd"
            emphasis_0 "#b10d0e"
            emphasis_1 "#cdcdcd"
            emphasis_2 "#235c83"
            emphasis_3 "#9d009d"
        }
        table_title {
            base "#00bb00"
            background "#283033"
            emphasis_0 "#fecd22"
            emphasis_1 "#00bbbb"
            emphasis_2 "#00bb00"
            emphasis_3 "#d86cd8"
        }
        frame_unselected {
            base "#cdcdcd"
            background "#283033"
            emphasis_0 "#cdcdcd"
            emphasis_1 "#cdcdcd"
            emphasis_2 "#cdcdcd"
            emphasis_3 "#cdcdcd"
        }
        frame_selected {
            base "#00bb00"
            background "#283033"
            emphasis_0 "#fecd22"
            emphasis_1 "#00bbbb"
            emphasis_2 "#00bb00"
            emphasis_3 "#d86cd8"
        }
        frame_highlight {
            base "#fecd22"
            background "#283033"
            emphasis_0 "#d86cd8"
            emphasis_1 "#fecd22"
            emphasis_2 "#fecd22"
            emphasis_3 "#fecd22"
        }
        exit_code_success {
            base "#00bb00"
            background "#283033"
            emphasis_0 "#00bbbb"
            emphasis_1 "#cdcdcd"
            emphasis_2 "#d86cd8"
            emphasis_3 "#3d9ddc"
        }
        exit_code_error {
            base "#d67c7d"
            background "#283033"
            emphasis_0 "#fecd22"
            emphasis_1 "#cdcdcd"
            emphasis_2 "#d86cd8"
            emphasis_3 "#3d9ddc"
        }
        multiplayer_user_colors {
            player_1 "#d86cd8"
            player_2 "#3d9ddc"
            player_3 "#ff55ff"
            player_4 "#fecd22"
            player_5 "#00bbbb"
            player_6 "#fef874"
            player_7 "#d67c7d"
            player_8 "#bbbbbb"
            player_9 "#ff5f61"
            player_10 "#a1d7ff"
        }
    }
}
