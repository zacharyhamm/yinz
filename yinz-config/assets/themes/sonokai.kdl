themes {
    "sonokai" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Sonokai
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#202228"
        terminal {
            foreground "#e2e2e3"
            background "#2c2e34"
            black "#181819"
            red "#fc5d7c"
            green "#9ed072"
            yellow "#e7c664"
            blue "#76cce0"
            magenta "#b39df3"
            cyan "#f39660"
            white "#e2e2e3"
            bright_black "#7f8490"
            bright_red "#fc5d7c"
            bright_green "#9ed072"
            bright_yellow "#e7c664"
            bright_blue "#76cce0"
            bright_magenta "#b39df3"
            bright_cyan "#f39660"
            bright_white "#e2e2e3"
        }
        text_unselected {
            base "#e2e2e3"
            background "#2c2e34"
            emphasis_0 "#e7c664"
            emphasis_1 "#f39660"
            emphasis_2 "#9ed072"
            emphasis_3 "#b39df3"
        }
        text_selected {
            base "#2c2e34"
            background "#e2e2e3"
            emphasis_0 "#746332"
            emphasis_1 "#8b593c"
            emphasis_2 "#526c3b"
            emphasis_3 "#695e8a"
        }
        table_cell_unselected {
            base "#e2e2e3"
            background "#2c2e34"
            emphasis_0 "#e7c664"
            emphasis_1 "#f39660"
            emphasis_2 "#9ed072"
            emphasis_3 "#b39df3"
        }
        table_cell_selected {
            base "#e2e2e3"
            background "#414550"
            emphasis_0 "#e7c664"
            emphasis_1 "#f49d6a"
            emphasis_2 "#9ed072"
            emphasis_3 "#baa7f4"
        }
        list_unselected {
            base "#e2e2e3"
            background "#2c2e34"
            emphasis_0 "#e7c664"
            emphasis_1 "#f39660"
            emphasis_2 "#9ed072"
            emphasis_3 "#b39df3"
        }
        list_selected {
            base "#e2e2e3"
            background "#414550"
            emphasis_0 "#e7c664"
            emphasis_1 "#f49d6a"
            emphasis_2 "#9ed072"
            emphasis_3 "#baa7f4"
        }
        ribbon_selected {
            base "#2c2e34"
            background "#9ed072"
            emphasis_0 "#883243"
            emphasis_1 "#5c4f28"
            emphasis_2 "#544a72"
            emphasis_3 "#31555d"
        }
        ribbon_unselected {
            base "#2c2e34"
            background "#e2e2e3"
            emphasis_0 "#ac3f55"
            emphasis_1 "#e2e2e3"
            emphasis_2 "#3e6b76"
            emphasis_3 "#6a5d90"
        }
        table_title {
            base "#9ed072"
            background "#2c2e34"
            emphasis_0 "#e7c664"
            emphasis_1 "#f39660"
            emphasis_2 "#9ed072"
            emphasis_3 "#b39df3"
        }
        frame_unselected {
            base "#e2e2e3"
            background "#2c2e34"
            emphasis_0 "#e2e2e3"
            emphasis_1 "#e2e2e3"
            emphasis_2 "#e2e2e3"
            emphasis_3 "#e2e2e3"
        }
        frame_selected {
            base "#9ed072"
            background "#2c2e34"
            emphasis_0 "#e7c664"
            emphasis_1 "#f39660"
            emphasis_2 "#9ed072"
            emphasis_3 "#b39df3"
        }
        frame_highlight {
            base "#e7c664"
            background "#2c2e34"
            emphasis_0 "#b39df3"
            emphasis_1 "#e7c664"
            emphasis_2 "#e7c664"
            emphasis_3 "#e7c664"
        }
        exit_code_success {
            base "#9ed072"
            background "#2c2e34"
            emphasis_0 "#f39660"
            emphasis_1 "#e2e2e3"
            emphasis_2 "#b39df3"
            emphasis_3 "#76cce0"
        }
        exit_code_error {
            base "#fc5d7c"
            background "#2c2e34"
            emphasis_0 "#e7c664"
            emphasis_1 "#e2e2e3"
            emphasis_2 "#b39df3"
            emphasis_3 "#76cce0"
        }
        multiplayer_user_colors {
            player_1 "#b39df3"
            player_2 "#76cce0"
            player_3 "#b39df3"
            player_4 "#e7c664"
            player_5 "#f39660"
            player_6 "#e7c664"
            player_7 "#fc5d7c"
            player_8 "#e2e2e3"
            player_9 "#fc5d7c"
            player_10 "#76cce0"
        }
    }
}
