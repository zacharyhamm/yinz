themes {
    "monospace-light" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Monospace%20Light
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#e8ebf1"
        terminal {
            foreground "#475365"
            background "#f4f7fd"
            black "#333e4f"
            red "#d03941"
            green "#007b49"
            yellow "#a65921"
            blue "#3c60dd"
            magenta "#6f4cde"
            cyan "#0075a2"
            white "#5d6a7d"
            bright_black "#000000"
            bright_red "#a52430"
            bright_green "#00522f"
            bright_yellow "#904b1a"
            bright_blue "#002487"
            bright_magenta "#4d21bb"
            bright_cyan "#00607e"
            bright_white "#475365"
        }
        text_unselected {
            base "#475365"
            background "#f4f7fd"
            emphasis_0 "#a65921"
            emphasis_1 "#0075a2"
            emphasis_2 "#007b49"
            emphasis_3 "#6f4cde"
        }
        text_selected {
            base "#f4f7fd"
            background "#475365"
            emphasis_0 "#d7c1b1"
            emphasis_1 "#aacbd8"
            emphasis_2 "#a9cdbe"
            emphasis_3 "#c9bfeb"
        }
        table_cell_unselected {
            base "#475365"
            background "#f4f7fd"
            emphasis_0 "#a65921"
            emphasis_1 "#0075a2"
            emphasis_2 "#007b49"
            emphasis_3 "#6f4cde"
        }
        table_cell_selected {
            base "#1f2939"
            background "#c7d3ff"
            emphasis_0 "#8c4b1c"
            emphasis_1 "#006389"
            emphasis_2 "#006a3f"
            emphasis_3 "#6243c5"
        }
        list_unselected {
            base "#475365"
            background "#f4f7fd"
            emphasis_0 "#a65921"
            emphasis_1 "#0075a2"
            emphasis_2 "#007b49"
            emphasis_3 "#6f4cde"
        }
        list_selected {
            base "#1f2939"
            background "#c7d3ff"
            emphasis_0 "#8c4b1c"
            emphasis_1 "#006389"
            emphasis_2 "#006a3f"
            emphasis_3 "#6243c5"
        }
        ribbon_selected {
            base "#f4f7fd"
            background "#007b49"
            emphasis_0 "#f9e8e9"
            emphasis_1 "#f4eae3"
            emphasis_2 "#eeeafb"
            emphasis_3 "#e7ecfb"
        }
        ribbon_unselected {
            base "#f4f7fd"
            background "#475365"
            emphasis_0 "#eeb8ba"
            emphasis_1 "#475365"
            emphasis_2 "#b6c4f2"
            emphasis_3 "#cabef3"
        }
        table_title {
            base "#007b49"
            background "#f4f7fd"
            emphasis_0 "#a65921"
            emphasis_1 "#0075a2"
            emphasis_2 "#007b49"
            emphasis_3 "#6f4cde"
        }
        frame_unselected {
            base "#475365"
            background "#f4f7fd"
            emphasis_0 "#475365"
            emphasis_1 "#475365"
            emphasis_2 "#475365"
            emphasis_3 "#475365"
        }
        frame_selected {
            base "#007b49"
            background "#f4f7fd"
            emphasis_0 "#a65921"
            emphasis_1 "#0075a2"
            emphasis_2 "#007b49"
            emphasis_3 "#6f4cde"
        }
        frame_highlight {
            base "#a65921"
            background "#f4f7fd"
            emphasis_0 "#6f4cde"
            emphasis_1 "#a65921"
            emphasis_2 "#a65921"
            emphasis_3 "#a65921"
        }
        exit_code_success {
            base "#007b49"
            background "#f4f7fd"
            emphasis_0 "#0075a2"
            emphasis_1 "#475365"
            emphasis_2 "#6f4cde"
            emphasis_3 "#3c60dd"
        }
        exit_code_error {
            base "#d03941"
            background "#f4f7fd"
            emphasis_0 "#a65921"
            emphasis_1 "#475365"
            emphasis_2 "#6f4cde"
            emphasis_3 "#3c60dd"
        }
        multiplayer_user_colors {
            player_1 "#6f4cde"
            player_2 "#3c60dd"
            player_3 "#4d21bb"
            player_4 "#a65921"
            player_5 "#0075a2"
            player_6 "#904b1a"
            player_7 "#d03941"
            player_8 "#5d6a7d"
            player_9 "#a52430"
            player_10 "#002487"
        }
    }
}
