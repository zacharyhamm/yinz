themes {
    "man-page" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Man%20Page
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#f2e890"
        terminal {
            foreground "#000000"
            background "#fef49c"
            black "#000000"
            red "#cc0000"
            green "#00a600"
            yellow "#999900"
            blue "#0000b2"
            magenta "#b200b2"
            cyan "#00a6b2"
            white "#b2b2b2"
            bright_black "#666666"
            bright_red "#e50000"
            bright_green "#00cc00"
            bright_yellow "#bfbf00"
            bright_blue "#0000ff"
            bright_magenta "#e500e5"
            bright_cyan "#00cbcb"
            bright_white "#e5e5e5"
        }
        text_unselected {
            base "#000000"
            background "#fef49c"
            emphasis_0 "#727200"
            emphasis_1 "#007a83"
            emphasis_2 "#008100"
            emphasis_3 "#b200b2"
        }
        text_selected {
            base "#fef49c"
            background "#000000"
            emphasis_0 "#787837"
            emphasis_1 "#3a7f84"
            emphasis_2 "#3c843c"
            emphasis_3 "#b14bb1"
        }
        table_cell_unselected {
            base "#000000"
            background "#fef49c"
            emphasis_0 "#727200"
            emphasis_1 "#007a83"
            emphasis_2 "#008100"
            emphasis_3 "#b200b2"
        }
        table_cell_selected {
            base "#000000"
            background "#a4c9cd"
            emphasis_0 "#535300"
            emphasis_1 "#005960"
            emphasis_2 "#005e00"
            emphasis_3 "#910091"
        }
        list_unselected {
            base "#000000"
            background "#fef49c"
            emphasis_0 "#727200"
            emphasis_1 "#007a83"
            emphasis_2 "#008100"
            emphasis_3 "#b200b2"
        }
        list_selected {
            base "#000000"
            background "#a4c9cd"
            emphasis_0 "#535300"
            emphasis_1 "#005960"
            emphasis_2 "#005e00"
            emphasis_3 "#910091"
        }
        ribbon_selected {
            base "#2a281a"
            background "#00a600"
            emphasis_0 "#590000"
            emphasis_1 "#2a2a00"
            emphasis_2 "#4e004e"
            emphasis_3 "#000095"
        }
        ribbon_unselected {
            base "#fef49c"
            background "#000000"
            emphasis_0 "#d73838"
            emphasis_1 "#000000"
            emphasis_2 "#6969d2"
            emphasis_3 "#c133c1"
        }
        table_title {
            base "#008100"
            background "#fef49c"
            emphasis_0 "#727200"
            emphasis_1 "#007a83"
            emphasis_2 "#008100"
            emphasis_3 "#b200b2"
        }
        frame_unselected {
            base "#000000"
            background "#fef49c"
            emphasis_0 "#000000"
            emphasis_1 "#000000"
            emphasis_2 "#000000"
            emphasis_3 "#000000"
        }
        frame_selected {
            base "#008100"
            background "#fef49c"
            emphasis_0 "#727200"
            emphasis_1 "#007a83"
            emphasis_2 "#008100"
            emphasis_3 "#b200b2"
        }
        frame_highlight {
            base "#727200"
            background "#fef49c"
            emphasis_0 "#b200b2"
            emphasis_1 "#727200"
            emphasis_2 "#727200"
            emphasis_3 "#727200"
        }
        exit_code_success {
            base "#008100"
            background "#fef49c"
            emphasis_0 "#007a83"
            emphasis_1 "#000000"
            emphasis_2 "#b200b2"
            emphasis_3 "#0000b2"
        }
        exit_code_error {
            base "#cc0000"
            background "#fef49c"
            emphasis_0 "#727200"
            emphasis_1 "#000000"
            emphasis_2 "#b200b2"
            emphasis_3 "#0000b2"
        }
        multiplayer_user_colors {
            player_1 "#b200b2"
            player_2 "#0000b2"
            player_3 "#c300c3"
            player_4 "#727200"
            player_5 "#007a83"
            player_6 "#727200"
            player_7 "#cc0000"
            player_8 "#6e6e6e"
            player_9 "#df0000"
            player_10 "#0000ff"
        }
    }
}
