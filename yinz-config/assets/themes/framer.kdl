themes {
    "framer" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Framer
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#050505"
        terminal {
            foreground "#777777"
            background "#111111"
            black "#141414"
            red "#ff5555"
            green "#98ec65"
            yellow "#ffcc33"
            blue "#00aaff"
            magenta "#aa88ff"
            cyan "#88ddff"
            white "#cccccc"
            bright_black "#414141"
            bright_red "#ff8888"
            bright_green "#b6f292"
            bright_yellow "#ffd966"
            bright_blue "#33bbff"
            bright_magenta "#cebbff"
            bright_cyan "#bbecff"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#7c7c7c"
            background "#111111"
            emphasis_0 "#ffcc33"
            emphasis_1 "#88ddff"
            emphasis_2 "#98ec65"
            emphasis_3 "#aa88ff"
        }
        text_selected {
            base "#ffffff"
            background "#666666"
            emphasis_0 "#ffe289"
            emphasis_1 "#bbecff"
            emphasis_2 "#bdf39c"
            emphasis_3 "#e9e0ff"
        }
        table_cell_unselected {
            base "#7c7c7c"
            background "#111111"
            emphasis_0 "#ffcc33"
            emphasis_1 "#88ddff"
            emphasis_2 "#98ec65"
            emphasis_3 "#aa88ff"
        }
        table_cell_selected {
            base "#ffffff"
            background "#666666"
            emphasis_0 "#ffe289"
            emphasis_1 "#bbecff"
            emphasis_2 "#bdf39c"
            emphasis_3 "#e9e0ff"
        }
        list_unselected {
            base "#7c7c7c"
            background "#111111"
            emphasis_0 "#ffcc33"
            emphasis_1 "#88ddff"
            emphasis_2 "#98ec65"
            emphasis_3 "#aa88ff"
        }
        list_selected {
            base "#ffffff"
            background "#666666"
            emphasis_0 "#ffe289"
            emphasis_1 "#bbecff"
            emphasis_2 "#bdf39c"
            emphasis_3 "#e9e0ff"
        }
        ribbon_selected {
            base "#111111"
            background "#98ec65"
            emphasis_0 "#a63737"
            emphasis_1 "#725b17"
            emphasis_2 "#655198"
            emphasis_3 "#006395"
        }
        ribbon_unselected {
            base "#111111"
            background "#7c7c7c"
            emphasis_0 "#210b0b"
            emphasis_1 "#7c7c7c"
            emphasis_2 "#00131d"
            emphasis_3 "#130f1d"
        }
        table_title {
            base "#98ec65"
            background "#111111"
            emphasis_0 "#ffcc33"
            emphasis_1 "#88ddff"
            emphasis_2 "#98ec65"
            emphasis_3 "#aa88ff"
        }
        frame_unselected {
            base "#7c7c7c"
            background "#111111"
            emphasis_0 "#7c7c7c"
            emphasis_1 "#7c7c7c"
            emphasis_2 "#7c7c7c"
            emphasis_3 "#7c7c7c"
        }
        frame_selected {
            base "#98ec65"
            background "#111111"
            emphasis_0 "#ffcc33"
            emphasis_1 "#88ddff"
            emphasis_2 "#98ec65"
            emphasis_3 "#aa88ff"
        }
        frame_highlight {
            base "#ffcc33"
            background "#111111"
            emphasis_0 "#aa88ff"
            emphasis_1 "#ffcc33"
            emphasis_2 "#ffcc33"
            emphasis_3 "#ffcc33"
        }
        exit_code_success {
            base "#98ec65"
            background "#111111"
            emphasis_0 "#88ddff"
            emphasis_1 "#7c7c7c"
            emphasis_2 "#aa88ff"
            emphasis_3 "#00aaff"
        }
        exit_code_error {
            base "#ff5555"
            background "#111111"
            emphasis_0 "#ffcc33"
            emphasis_1 "#7c7c7c"
            emphasis_2 "#aa88ff"
            emphasis_3 "#00aaff"
        }
        multiplayer_user_colors {
            player_1 "#aa88ff"
            player_2 "#00aaff"
            player_3 "#cebbff"
            player_4 "#ffcc33"
            player_5 "#88ddff"
            player_6 "#ffd966"
            player_7 "#ff5555"
            player_8 "#cccccc"
            player_9 "#ff8888"
            player_10 "#33bbff"
        }
    }
}
