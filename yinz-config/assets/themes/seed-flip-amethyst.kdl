themes {
    "seed-flip-amethyst" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/SeedFlip%20Amethyst
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#ecebea"
        terminal {
            foreground "#1a0a2e"
            background "#f8f7f6"
            black "#d7d1cb"
            red "#bd0f0f"
            green "#0fbd49"
            yellow "#bda00f"
            blue "#0f58bd"
            magenta "#bd0fbd"
            cyan "#0fbdbd"
            white "#0e0519"
            bright_black "#b5aba0"
            bright_red "#ee2b2b"
            bright_green "#12d452"
            bright_yellow "#d4b312"
            bright_blue "#2b7cee"
            bright_magenta "#ee2bee"
            bright_cyan "#05c8c8"
            bright_white "#1a0a2e"
        }
        text_unselected {
            base "#1a0a2e"
            background "#f8f7f6"
            emphasis_0 "#85700b"
            emphasis_1 "#0a7f7f"
            emphasis_2 "#0a8433"
            emphasis_3 "#bd0fbd"
        }
        text_selected {
            base "#f8f7f6"
            background "#1a0a2e"
            emphasis_0 "#917c17"
            emphasis_1 "#178b8b"
            emphasis_2 "#199041"
            emphasis_3 "#ca3fca"
        }
        table_cell_unselected {
            base "#1a0a2e"
            background "#f8f7f6"
            emphasis_0 "#85700b"
            emphasis_1 "#0a7f7f"
            emphasis_2 "#0a8433"
            emphasis_3 "#bd0fbd"
        }
        table_cell_selected {
            base "#1a0a2e"
            background "#ffffff"
            emphasis_0 "#8b750b"
            emphasis_1 "#0a8484"
            emphasis_2 "#0b8935"
            emphasis_3 "#bd0fbd"
        }
        list_unselected {
            base "#1a0a2e"
            background "#f8f7f6"
            emphasis_0 "#85700b"
            emphasis_1 "#0a7f7f"
            emphasis_2 "#0a8433"
            emphasis_3 "#bd0fbd"
        }
        list_selected {
            base "#1a0a2e"
            background "#ffffff"
            emphasis_0 "#8b750b"
            emphasis_1 "#0a8484"
            emphasis_2 "#0b8935"
            emphasis_3 "#bd0fbd"
        }
        ribbon_selected {
            base "#3a3a3a"
            background "#0fbd49"
            emphasis_0 "#790a0a"
            emphasis_1 "#453a05"
            emphasis_2 "#6a086a"
            emphasis_3 "#0a3879"
        }
        ribbon_unselected {
            base "#f8f7f6"
            background "#1a0a2e"
            emphasis_0 "#d05454"
            emphasis_1 "#1a0a2e"
            emphasis_2 "#467ecc"
            emphasis_3 "#ca3fca"
        }
        table_title {
            base "#0a8433"
            background "#f8f7f6"
            emphasis_0 "#85700b"
            emphasis_1 "#0a7f7f"
            emphasis_2 "#0a8433"
            emphasis_3 "#bd0fbd"
        }
        frame_unselected {
            base "#1a0a2e"
            background "#f8f7f6"
            emphasis_0 "#1a0a2e"
            emphasis_1 "#1a0a2e"
            emphasis_2 "#1a0a2e"
            emphasis_3 "#1a0a2e"
        }
        frame_selected {
            base "#0a8433"
            background "#f8f7f6"
            emphasis_0 "#85700b"
            emphasis_1 "#0a7f7f"
            emphasis_2 "#0a8433"
            emphasis_3 "#bd0fbd"
        }
        frame_highlight {
            base "#85700b"
            background "#f8f7f6"
            emphasis_0 "#bd0fbd"
            emphasis_1 "#85700b"
            emphasis_2 "#85700b"
            emphasis_3 "#85700b"
        }
        exit_code_success {
            base "#0a8433"
            background "#f8f7f6"
            emphasis_0 "#0a7f7f"
            emphasis_1 "#1a0a2e"
            emphasis_2 "#bd0fbd"
            emphasis_3 "#0f58bd"
        }
        exit_code_error {
            base "#bd0f0f"
            background "#f8f7f6"
            emphasis_0 "#85700b"
            emphasis_1 "#1a0a2e"
            emphasis_2 "#bd0fbd"
            emphasis_3 "#0f58bd"
        }
        multiplayer_user_colors {
            player_1 "#bd0fbd"
            player_2 "#0f58bd"
            player_3 "#c323c3"
            player_4 "#85700b"
            player_5 "#0a7f7f"
            player_6 "#85700b"
            player_7 "#bd0f0f"
            player_8 "#0e0519"
            player_9 "#db2828"
            player_10 "#276fd6"
        }
    }
}
