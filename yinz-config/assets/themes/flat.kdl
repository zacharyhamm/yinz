themes {
    "flat" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Flat
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#001634"
        terminal {
            foreground "#2cc55d"
            background "#002240"
            black "#222d3f"
            red "#a82320"
            green "#32a548"
            yellow "#e58d11"
            blue "#3167ac"
            magenta "#781aa0"
            cyan "#2c9370"
            white "#b0b6ba"
            bright_black "#475262"
            bright_red "#d4312e"
            bright_green "#2d9440"
            bright_yellow "#e5be0c"
            bright_blue "#3c7dd2"
            bright_magenta "#8230a7"
            bright_cyan "#35b387"
            bright_white "#e7eced"
        }
        text_unselected {
            base "#2cc55d"
            background "#002240"
            emphasis_0 "#e58d11"
            emphasis_1 "#359876"
            emphasis_2 "#32a548"
            emphasis_3 "#ab71c4"
        }
        text_selected {
            base "#002240"
            background "#2cc55d"
            emphasis_0 "#4f3d24"
            emphasis_1 "#34443f"
            emphasis_2 "#314535"
            emphasis_3 "#463d4a"
        }
        table_cell_unselected {
            base "#2cc55d"
            background "#002240"
            emphasis_0 "#e58d11"
            emphasis_1 "#359876"
            emphasis_2 "#32a548"
            emphasis_3 "#ab71c4"
        }
        table_cell_selected {
            base "#ffffff"
            background "#792b9c"
            emphasis_0 "#efba6e"
            emphasis_1 "#9dcdbc"
            emphasis_2 "#96d1a1"
            emphasis_3 "#d6b9e2"
        }
        list_unselected {
            base "#2cc55d"
            background "#002240"
            emphasis_0 "#e58d11"
            emphasis_1 "#359876"
            emphasis_2 "#32a548"
            emphasis_3 "#ab71c4"
        }
        list_selected {
            base "#ffffff"
            background "#792b9c"
            emphasis_0 "#efba6e"
            emphasis_1 "#9dcdbc"
            emphasis_2 "#96d1a1"
            emphasis_3 "#d6b9e2"
        }
        ribbon_selected {
            base "#002240"
            background "#32a548"
            emphasis_0 "#541110"
            emphasis_1 "#3c2504"
            emphasis_2 "#440f5b"
            emphasis_3 "#142b47"
        }
        ribbon_unselected {
            base "#002240"
            background "#2cc55d"
            emphasis_0 "#7e1a18"
            emphasis_1 "#2cc55d"
            emphasis_2 "#1f416d"
            emphasis_3 "#671689"
        }
        table_title {
            base "#32a548"
            background "#002240"
            emphasis_0 "#e58d11"
            emphasis_1 "#359876"
            emphasis_2 "#32a548"
            emphasis_3 "#ab71c4"
        }
        frame_unselected {
            base "#2cc55d"
            background "#002240"
            emphasis_0 "#2cc55d"
            emphasis_1 "#2cc55d"
            emphasis_2 "#2cc55d"
            emphasis_3 "#2cc55d"
        }
        frame_selected {
            base "#32a548"
            background "#002240"
            emphasis_0 "#e58d11"
            emphasis_1 "#359876"
            emphasis_2 "#32a548"
            emphasis_3 "#ab71c4"
        }
        frame_highlight {
            base "#e58d11"
            background "#002240"
            emphasis_0 "#ab71c4"
            emphasis_1 "#e58d11"
            emphasis_2 "#e58d11"
            emphasis_3 "#e58d11"
        }
        exit_code_success {
            base "#32a548"
            background "#002240"
            emphasis_0 "#359876"
            emphasis_1 "#2cc55d"
            emphasis_2 "#ab71c4"
            emphasis_3 "#608abf"
        }
        exit_code_error {
            base "#c66f6d"
            background "#002240"
            emphasis_0 "#e58d11"
            emphasis_1 "#2cc55d"
            emphasis_2 "#ab71c4"
            emphasis_3 "#608abf"
        }
        multiplayer_user_colors {
            player_1 "#ab71c4"
            player_2 "#608abf"
            player_3 "#aa72c3"
            player_4 "#e58d11"
            player_5 "#359876"
            player_6 "#e5be0c"
            player_7 "#c66f6d"
            player_8 "#b0b6ba"
            player_9 "#de5f5d"
            player_10 "#4e89d6"
        }
    }
}
