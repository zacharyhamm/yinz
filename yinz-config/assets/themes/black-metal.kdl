themes {
    "black-metal" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Black%20Metal
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000000"
        terminal {
            foreground "#c1c1c1"
            background "#000000"
            black "#000000"
            red "#486e6f"
            green "#dd9999"
            yellow "#a06666"
            blue "#888888"
            magenta "#999999"
            cyan "#aaaaaa"
            white "#c1c1c1"
            bright_black "#404040"
            bright_red "#486e6f"
            bright_green "#dd9999"
            bright_yellow "#a06666"
            bright_blue "#888888"
            bright_magenta "#999999"
            bright_cyan "#aaaaaa"
            bright_white "#c1c1c1"
        }
        text_unselected {
            base "#c1c1c1"
            background "#000000"
            emphasis_0 "#a06666"
            emphasis_1 "#aaaaaa"
            emphasis_2 "#dd9999"
            emphasis_3 "#999999"
        }
        text_selected {
            base "#000000"
            background "#c1c1c1"
            emphasis_0 "#6d4545"
            emphasis_1 "#4f4f4f"
            emphasis_2 "#674747"
            emphasis_3 "#4f4f4f"
        }
        table_cell_unselected {
            base "#c1c1c1"
            background "#000000"
            emphasis_0 "#a06666"
            emphasis_1 "#aaaaaa"
            emphasis_2 "#dd9999"
            emphasis_3 "#999999"
        }
        table_cell_selected {
            base "#000000"
            background "#c1c1c1"
            emphasis_0 "#6d4545"
            emphasis_1 "#4f4f4f"
            emphasis_2 "#674747"
            emphasis_3 "#4f4f4f"
        }
        list_unselected {
            base "#c1c1c1"
            background "#000000"
            emphasis_0 "#a06666"
            emphasis_1 "#aaaaaa"
            emphasis_2 "#dd9999"
            emphasis_3 "#999999"
        }
        list_selected {
            base "#000000"
            background "#c1c1c1"
            emphasis_0 "#6d4545"
            emphasis_1 "#4f4f4f"
            emphasis_2 "#674747"
            emphasis_3 "#4f4f4f"
        }
        ribbon_selected {
            base "#000000"
            background "#dd9999"
            emphasis_0 "#2c4444"
            emphasis_1 "#573737"
            emphasis_2 "#3f3f3f"
            emphasis_3 "#3f3f3f"
        }
        ribbon_unselected {
            base "#000000"
            background "#c1c1c1"
            emphasis_0 "#375455"
            emphasis_1 "#c1c1c1"
            emphasis_2 "#4f4f4f"
            emphasis_3 "#4f4f4f"
        }
        table_title {
            base "#dd9999"
            background "#000000"
            emphasis_0 "#a06666"
            emphasis_1 "#aaaaaa"
            emphasis_2 "#dd9999"
            emphasis_3 "#999999"
        }
        frame_unselected {
            base "#c1c1c1"
            background "#000000"
            emphasis_0 "#c1c1c1"
            emphasis_1 "#c1c1c1"
            emphasis_2 "#c1c1c1"
            emphasis_3 "#c1c1c1"
        }
        frame_selected {
            base "#dd9999"
            background "#000000"
            emphasis_0 "#a06666"
            emphasis_1 "#aaaaaa"
            emphasis_2 "#dd9999"
            emphasis_3 "#999999"
        }
        frame_highlight {
            base "#a06666"
            background "#000000"
            emphasis_0 "#999999"
            emphasis_1 "#a06666"
            emphasis_2 "#a06666"
            emphasis_3 "#a06666"
        }
        exit_code_success {
            base "#dd9999"
            background "#000000"
            emphasis_0 "#aaaaaa"
            emphasis_1 "#c1c1c1"
            emphasis_2 "#999999"
            emphasis_3 "#888888"
        }
        exit_code_error {
            base "#587b7b"
            background "#000000"
            emphasis_0 "#a06666"
            emphasis_1 "#c1c1c1"
            emphasis_2 "#999999"
            emphasis_3 "#888888"
        }
        multiplayer_user_colors {
            player_1 "#999999"
            player_2 "#888888"
            player_3 "#999999"
            player_4 "#a06666"
            player_5 "#aaaaaa"
            player_6 "#a06666"
            player_7 "#587b7b"
            player_8 "#c1c1c1"
            player_9 "#587b7b"
            player_10 "#888888"
        }
    }
}
