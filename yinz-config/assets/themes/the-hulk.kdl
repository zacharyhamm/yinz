themes {
    "the-hulk" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/The%20Hulk
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#0f1112"
        terminal {
            foreground "#b5b5b5"
            background "#1b1d1e"
            black "#1b1d1e"
            red "#269d1b"
            green "#13ce30"
            yellow "#63e457"
            blue "#2525f5"
            magenta "#712c81"
            cyan "#378ca9"
            white "#d9d8d1"
            bright_black "#505354"
            bright_red "#8dff2a"
            bright_green "#48ff77"
            bright_yellow "#3afe16"
            bright_blue "#506b95"
            bright_magenta "#72589d"
            bright_cyan "#4085a6"
            bright_white "#e5e6e1"
        }
        text_unselected {
            base "#b5b5b5"
            background "#1b1d1e"
            emphasis_0 "#63e457"
            emphasis_1 "#3a8eaa"
            emphasis_2 "#13ce30"
            emphasis_3 "#a174ac"
        }
        text_selected {
            base "#1b1d1e"
            background "#b5b5b5"
            emphasis_0 "#23511f"
            emphasis_1 "#3a4a4f"
            emphasis_2 "#1d5126"
            emphasis_3 "#4d444f"
        }
        table_cell_unselected {
            base "#b5b5b5"
            background "#1b1d1e"
            emphasis_0 "#63e457"
            emphasis_1 "#3a8eaa"
            emphasis_2 "#13ce30"
            emphasis_3 "#a174ac"
        }
        table_cell_selected {
            base "#a4cba3"
            background "#4d504c"
            emphasis_0 "#63e457"
            emphasis_1 "#9dc7d5"
            emphasis_2 "#50db66"
            emphasis_3 "#d0b9d5"
        }
        list_unselected {
            base "#b5b5b5"
            background "#1b1d1e"
            emphasis_0 "#63e457"
            emphasis_1 "#3a8eaa"
            emphasis_2 "#13ce30"
            emphasis_3 "#a174ac"
        }
        list_selected {
            base "#a4cba3"
            background "#4d504c"
            emphasis_0 "#63e457"
            emphasis_1 "#9dc7d5"
            emphasis_2 "#50db66"
            emphasis_3 "#d0b9d5"
        }
        ribbon_selected {
            base "#1b1d1e"
            background "#13ce30"
            emphasis_0 "#13500e"
            emphasis_1 "#224e1e"
            emphasis_2 "#692978"
            emphasis_3 "#2020d2"
        }
        ribbon_unselected {
            base "#1b1d1e"
            background "#b5b5b5"
            emphasis_0 "#14530e"
            emphasis_1 "#b5b5b5"
            emphasis_2 "#2121d8"
            emphasis_3 "#6d2a7c"
        }
        table_title {
            base "#13ce30"
            background "#1b1d1e"
            emphasis_0 "#63e457"
            emphasis_1 "#3a8eaa"
            emphasis_2 "#13ce30"
            emphasis_3 "#a174ac"
        }
        frame_unselected {
            base "#b5b5b5"
            background "#1b1d1e"
            emphasis_0 "#b5b5b5"
            emphasis_1 "#b5b5b5"
            emphasis_2 "#b5b5b5"
            emphasis_3 "#b5b5b5"
        }
        frame_selected {
            base "#13ce30"
            background "#1b1d1e"
            emphasis_0 "#63e457"
            emphasis_1 "#3a8eaa"
            emphasis_2 "#13ce30"
            emphasis_3 "#a174ac"
        }
        frame_highlight {
            base "#63e457"
            background "#1b1d1e"
            emphasis_0 "#a174ac"
            emphasis_1 "#63e457"
            emphasis_2 "#63e457"
            emphasis_3 "#63e457"
        }
        exit_code_success {
            base "#13ce30"
            background "#1b1d1e"
            emphasis_0 "#3a8eaa"
            emphasis_1 "#b5b5b5"
            emphasis_2 "#a174ac"
            emphasis_3 "#7474f9"
        }
        exit_code_error {
            base "#269d1b"
            background "#1b1d1e"
            emphasis_0 "#63e457"
            emphasis_1 "#b5b5b5"
            emphasis_2 "#a174ac"
            emphasis_3 "#7474f9"
        }
        multiplayer_user_colors {
            player_1 "#a174ac"
            player_2 "#7474f9"
            player_3 "#8f7ab1"
            player_4 "#63e457"
            player_5 "#3a8eaa"
            player_6 "#3afe16"
            player_7 "#269d1b"
            player_8 "#d9d8d1"
            player_9 "#8dff2a"
            player_10 "#6f85a8"
        }
    }
}
