themes {
    "aardvark-blue" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Aardvark%20Blue
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#041434"
        terminal {
            foreground "#dddddd"
            background "#102040"
            black "#191919"
            red "#aa342e"
            green "#4b8c0f"
            yellow "#dbba00"
            blue "#1370d3"
            magenta "#c43ac3"
            cyan "#008eb0"
            white "#bebebe"
            bright_black "#525252"
            bright_red "#f05b50"
            bright_green "#95dc55"
            bright_yellow "#ffe763"
            bright_blue "#60a4ec"
            bright_magenta "#e26be2"
            bright_cyan "#60b6cb"
            bright_white "#f7f7f7"
        }
        text_unselected {
            base "#dddddd"
            background "#102040"
            emphasis_0 "#dbba00"
            emphasis_1 "#0d94b4"
            emphasis_2 "#5c9726"
            emphasis_3 "#cd58cc"
        }
        text_selected {
            base "#000000"
            background "#bfdbfe"
            emphasis_0 "#6f5e00"
            emphasis_1 "#006780"
            emphasis_2 "#396b0b"
            emphasis_3 "#9c2e9b"
        }
        table_cell_unselected {
            base "#dddddd"
            background "#102040"
            emphasis_0 "#dbba00"
            emphasis_1 "#0d94b4"
            emphasis_2 "#5c9726"
            emphasis_3 "#cd58cc"
        }
        table_cell_selected {
            base "#000000"
            background "#bfdbfe"
            emphasis_0 "#6f5e00"
            emphasis_1 "#006780"
            emphasis_2 "#396b0b"
            emphasis_3 "#9c2e9b"
        }
        list_unselected {
            base "#dddddd"
            background "#102040"
            emphasis_0 "#dbba00"
            emphasis_1 "#0d94b4"
            emphasis_2 "#5c9726"
            emphasis_3 "#cd58cc"
        }
        list_selected {
            base "#000000"
            background "#bfdbfe"
            emphasis_0 "#6f5e00"
            emphasis_1 "#006780"
            emphasis_2 "#396b0b"
            emphasis_3 "#9c2e9b"
        }
        ribbon_selected {
            base "#091224"
            background "#4b8c0f"
            emphasis_0 "#230b0a"
            emphasis_1 "#151200"
            emphasis_2 "#20091f"
            emphasis_3 "#031324"
        }
        ribbon_unselected {
            base "#102040"
            background "#dddddd"
            emphasis_0 "#aa342e"
            emphasis_1 "#dddddd"
            emphasis_2 "#1061b7"
            emphasis_3 "#a02f9f"
        }
        table_title {
            base "#5c9726"
            background "#102040"
            emphasis_0 "#dbba00"
            emphasis_1 "#0d94b4"
            emphasis_2 "#5c9726"
            emphasis_3 "#cd58cc"
        }
        frame_unselected {
            base "#dddddd"
            background "#102040"
            emphasis_0 "#dddddd"
            emphasis_1 "#dddddd"
            emphasis_2 "#dddddd"
            emphasis_3 "#dddddd"
        }
        frame_selected {
            base "#5c9726"
            background "#102040"
            emphasis_0 "#dbba00"
            emphasis_1 "#0d94b4"
            emphasis_2 "#5c9726"
            emphasis_3 "#cd58cc"
        }
        frame_highlight {
            base "#dbba00"
            background "#102040"
            emphasis_0 "#cd58cc"
            emphasis_1 "#dbba00"
            emphasis_2 "#dbba00"
            emphasis_3 "#dbba00"
        }
        exit_code_success {
            base "#5c9726"
            background "#102040"
            emphasis_0 "#0d94b4"
            emphasis_1 "#dddddd"
            emphasis_2 "#cd58cc"
            emphasis_3 "#3e8adb"
        }
        exit_code_error {
            base "#c3716c"
            background "#102040"
            emphasis_0 "#dbba00"
            emphasis_1 "#dddddd"
            emphasis_2 "#cd58cc"
            emphasis_3 "#3e8adb"
        }
        multiplayer_user_colors {
            player_1 "#cd58cc"
            player_2 "#3e8adb"
            player_3 "#e26be2"
            player_4 "#dbba00"
            player_5 "#0d94b4"
            player_6 "#ffe763"
            player_7 "#c3716c"
            player_8 "#bebebe"
            player_9 "#f05b50"
            player_10 "#60a4ec"
        }
    }
}
