themes {
    "golden-retriever-honey" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Golden%20Retriever%20Honey
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#f1eadb"
        terminal {
            foreground "#5b4630"
            background "#fdf6e7"
            black "#6b4a2f"
            red "#d35400"
            green "#8ba83e"
            yellow "#d4b24c"
            blue "#4a8fbd"
            magenta "#a86bd8"
            cyan "#5fb7a7"
            white "#c2baac"
            bright_black "#805e3b"
            bright_red "#f1734f"
            bright_green "#9abc5d"
            bright_yellow "#d9ba4f"
            bright_blue "#6eb9f5"
            bright_magenta "#c28ae6"
            bright_cyan "#56c9b5"
            bright_white "#f4e4c9"
        }
        text_unselected {
            base "#5b4630"
            background "#fdf6e7"
            emphasis_0 "#846f2f"
            emphasis_1 "#407b71"
            emphasis_2 "#64792d"
            emphasis_3 "#8e5bb7"
        }
        text_selected {
            base "#fdf6e7"
            background "#5b4630"
            emphasis_0 "#bdb9ac"
            emphasis_1 "#b0bcb9"
            emphasis_2 "#b7bbac"
            emphasis_3 "#c0b5c8"
        }
        table_cell_unselected {
            base "#5b4630"
            background "#fdf6e7"
            emphasis_0 "#846f2f"
            emphasis_1 "#407b71"
            emphasis_2 "#64792d"
            emphasis_3 "#8e5bb7"
        }
        table_cell_selected {
            base "#4b3826"
            background "#c6a477"
            emphasis_0 "#493d1a"
            emphasis_1 "#23443e"
            emphasis_2 "#384319"
            emphasis_3 "#4f3266"
        }
        list_unselected {
            base "#5b4630"
            background "#fdf6e7"
            emphasis_0 "#846f2f"
            emphasis_1 "#407b71"
            emphasis_2 "#64792d"
            emphasis_3 "#8e5bb7"
        }
        list_selected {
            base "#4b3826"
            background "#c6a477"
            emphasis_0 "#493d1a"
            emphasis_1 "#23443e"
            emphasis_2 "#384319"
            emphasis_3 "#4f3266"
        }
        ribbon_selected {
            base "#373532"
            background "#8ba83e"
            emphasis_0 "#5c2500"
            emphasis_1 "#3e3416"
            emphasis_2 "#432b56"
            emphasis_3 "#1d384a"
        }
        ribbon_unselected {
            base "#fdf6e7"
            background "#5b4630"
            emphasis_0 "#eaac83"
            emphasis_1 "#5b4630"
            emphasis_2 "#96bed9"
            emphasis_3 "#ceace9"
        }
        table_title {
            base "#64792d"
            background "#fdf6e7"
            emphasis_0 "#846f2f"
            emphasis_1 "#407b71"
            emphasis_2 "#64792d"
            emphasis_3 "#8e5bb7"
        }
        frame_unselected {
            base "#5b4630"
            background "#fdf6e7"
            emphasis_0 "#5b4630"
            emphasis_1 "#5b4630"
            emphasis_2 "#5b4630"
            emphasis_3 "#5b4630"
        }
        frame_selected {
            base "#64792d"
            background "#fdf6e7"
            emphasis_0 "#846f2f"
            emphasis_1 "#407b71"
            emphasis_2 "#64792d"
            emphasis_3 "#8e5bb7"
        }
        frame_highlight {
            base "#846f2f"
            background "#fdf6e7"
            emphasis_0 "#8e5bb7"
            emphasis_1 "#846f2f"
            emphasis_2 "#846f2f"
            emphasis_3 "#846f2f"
        }
        exit_code_success {
            base "#64792d"
            background "#fdf6e7"
            emphasis_0 "#407b71"
            emphasis_1 "#5b4630"
            emphasis_2 "#8e5bb7"
            emphasis_3 "#3e779d"
        }
        exit_code_error {
            base "#c14d00"
            background "#fdf6e7"
            emphasis_0 "#846f2f"
            emphasis_1 "#5b4630"
            emphasis_2 "#8e5bb7"
            emphasis_3 "#3e779d"
        }
        multiplayer_user_colors {
            player_1 "#8e5bb7"
            player_2 "#3e779d"
            player_3 "#8961a2"
            player_4 "#846f2f"
            player_5 "#407b71"
            player_6 "#837030"
            player_7 "#c14d00"
            player_8 "#757068"
            player_9 "#b4563b"
            player_10 "#46769c"
        }
    }
}
