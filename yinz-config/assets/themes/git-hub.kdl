themes {
    "git-hub" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/GitHub
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#e8e8e8"
        terminal {
            foreground "#3e3e3e"
            background "#f4f4f4"
            black "#3e3e3e"
            red "#970b16"
            green "#07962a"
            yellow "#c5bb94"
            blue "#003e8a"
            magenta "#e94691"
            cyan "#7cc4df"
            white "#b2b2b2"
            bright_black "#666666"
            bright_red "#de0000"
            bright_green "#7ac895"
            bright_yellow "#d7b600"
            bright_blue "#2e6cba"
            bright_magenta "#f29592"
            bright_cyan "#00c7cb"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#3e3e3e"
            background "#f4f4f4"
            emphasis_0 "#767059"
            emphasis_1 "#4b7687"
            emphasis_2 "#068224"
            emphasis_3 "#c33a79"
        }
        text_selected {
            base "#f4f4f4"
            background "#3e3e3e"
            emphasis_0 "#aba8a0"
            emphasis_1 "#9cabb1"
            emphasis_2 "#89b293"
            emphasis_3 "#c99cb1"
        }
        table_cell_unselected {
            base "#3e3e3e"
            background "#f4f4f4"
            emphasis_0 "#767059"
            emphasis_1 "#4b7687"
            emphasis_2 "#068224"
            emphasis_3 "#c33a79"
        }
        table_cell_selected {
            base "#4e4e4e"
            background "#a9c1e2"
            emphasis_0 "#534e3e"
            emphasis_1 "#34525e"
            emphasis_2 "#045b1a"
            emphasis_3 "#8a2956"
        }
        list_unselected {
            base "#3e3e3e"
            background "#f4f4f4"
            emphasis_0 "#767059"
            emphasis_1 "#4b7687"
            emphasis_2 "#068224"
            emphasis_3 "#c33a79"
        }
        list_selected {
            base "#4e4e4e"
            background "#a9c1e2"
            emphasis_0 "#534e3e"
            emphasis_1 "#34525e"
            emphasis_2 "#045b1a"
            emphasis_3 "#8a2956"
        }
        ribbon_selected {
            base "#191919"
            background "#07962a"
            emphasis_0 "#3a0408"
            emphasis_1 "#1a1914"
            emphasis_2 "#2e0e1c"
            emphasis_3 "#001938"
        }
        ribbon_unselected {
            base "#f4f4f4"
            background "#3e3e3e"
            emphasis_0 "#d49a9e"
            emphasis_1 "#3e3e3e"
            emphasis_2 "#90abcc"
            emphasis_3 "#f187b7"
        }
        table_title {
            base "#068224"
            background "#f4f4f4"
            emphasis_0 "#767059"
            emphasis_1 "#4b7687"
            emphasis_2 "#068224"
            emphasis_3 "#c33a79"
        }
        frame_unselected {
            base "#3e3e3e"
            background "#f4f4f4"
            emphasis_0 "#3e3e3e"
            emphasis_1 "#3e3e3e"
            emphasis_2 "#3e3e3e"
            emphasis_3 "#3e3e3e"
        }
        frame_selected {
            base "#068224"
            background "#f4f4f4"
            emphasis_0 "#767059"
            emphasis_1 "#4b7687"
            emphasis_2 "#068224"
            emphasis_3 "#c33a79"
        }
        frame_highlight {
            base "#767059"
            background "#f4f4f4"
            emphasis_0 "#c33a79"
            emphasis_1 "#767059"
            emphasis_2 "#767059"
            emphasis_3 "#767059"
        }
        exit_code_success {
            base "#068224"
            background "#f4f4f4"
            emphasis_0 "#4b7687"
            emphasis_1 "#3e3e3e"
            emphasis_2 "#c33a79"
            emphasis_3 "#003e8a"
        }
        exit_code_error {
            base "#970b16"
            background "#f4f4f4"
            emphasis_0 "#767059"
            emphasis_1 "#3e3e3e"
            emphasis_2 "#c33a79"
            emphasis_3 "#003e8a"
        }
        multiplayer_user_colors {
            player_1 "#c33a79"
            player_2 "#003e8a"
            player_3 "#9b5f5d"
            player_4 "#767059"
            player_5 "#4b7687"
            player_6 "#836f00"
            player_7 "#970b16"
            player_8 "#707070"
            player_9 "#de0000"
            player_10 "#2e6cba"
        }
    }
}
