themes {
    "under-the-sea" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Under%20The%20Sea
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#00050a"
        terminal {
            foreground "#ffffff"
            background "#011116"
            black "#022026"
            red "#b2302d"
            green "#00a941"
            yellow "#59819c"
            blue "#459a86"
            magenta "#00599d"
            cyan "#5d7e19"
            white "#405555"
            bright_black "#384451"
            bright_red "#ff4242"
            bright_green "#2aea5e"
            bright_yellow "#8ed4fd"
            bright_blue "#61d5ba"
            bright_magenta "#1298ff"
            bright_cyan "#98d028"
            bright_white "#58fbd6"
        }
        text_unselected {
            base "#ffffff"
            background "#011116"
            emphasis_0 "#59819c"
            emphasis_1 "#658525"
            emphasis_2 "#00a941"
            emphasis_3 "#3c80b4"
        }
        text_selected {
            base "#011116"
            background "#ffffff"
            emphasis_0 "#6d787f"
            emphasis_1 "#71795f"
            emphasis_2 "#4e8162"
            emphasis_3 "#677986"
        }
        table_cell_unselected {
            base "#ffffff"
            background "#011116"
            emphasis_0 "#59819c"
            emphasis_1 "#658525"
            emphasis_2 "#00a941"
            emphasis_3 "#3c80b4"
        }
        table_cell_selected {
            base "#4dffda"
            background "#415555"
            emphasis_0 "#b5c7d3"
            emphasis_1 "#bbc99e"
            emphasis_2 "#81d5a1"
            emphasis_3 "#aac8de"
        }
        list_unselected {
            base "#ffffff"
            background "#011116"
            emphasis_0 "#59819c"
            emphasis_1 "#658525"
            emphasis_2 "#00a941"
            emphasis_3 "#3c80b4"
        }
        list_selected {
            base "#4dffda"
            background "#415555"
            emphasis_0 "#b5c7d3"
            emphasis_1 "#bbc99e"
            emphasis_2 "#81d5a1"
            emphasis_3 "#aac8de"
        }
        ribbon_selected {
            base "#011116"
            background "#00a941"
            emphasis_0 "#531615"
            emphasis_1 "#1f2d36"
            emphasis_2 "#002d50"
            emphasis_3 "#16302a"
        }
        ribbon_unselected {
            base "#011116"
            background "#ffffff"
            emphasis_0 "#b2302d"
            emphasis_1 "#ffffff"
            emphasis_2 "#3a8272"
            emphasis_3 "#00599d"
        }
        table_title {
            base "#00a941"
            background "#011116"
            emphasis_0 "#59819c"
            emphasis_1 "#658525"
            emphasis_2 "#00a941"
            emphasis_3 "#3c80b4"
        }
        frame_unselected {
            base "#ffffff"
            background "#011116"
            emphasis_0 "#ffffff"
            emphasis_1 "#ffffff"
            emphasis_2 "#ffffff"
            emphasis_3 "#ffffff"
        }
        frame_selected {
            base "#00a941"
            background "#011116"
            emphasis_0 "#59819c"
            emphasis_1 "#658525"
            emphasis_2 "#00a941"
            emphasis_3 "#3c80b4"
        }
        frame_highlight {
            base "#59819c"
            background "#011116"
            emphasis_0 "#3c80b4"
            emphasis_1 "#59819c"
            emphasis_2 "#59819c"
            emphasis_3 "#59819c"
        }
        exit_code_success {
            base "#00a941"
            background "#011116"
            emphasis_0 "#658525"
            emphasis_1 "#ffffff"
            emphasis_2 "#3c80b4"
            emphasis_3 "#459a86"
        }
        exit_code_error {
            base "#c25b59"
            background "#011116"
            emphasis_0 "#59819c"
            emphasis_1 "#ffffff"
            emphasis_2 "#3c80b4"
            emphasis_3 "#459a86"
        }
        multiplayer_user_colors {
            player_1 "#3c80b4"
            player_2 "#459a86"
            player_3 "#1298ff"
            player_4 "#59819c"
            player_5 "#658525"
            player_6 "#8ed4fd"
            player_7 "#c25b59"
            player_8 "#6e7e7e"
            player_9 "#ff4242"
            player_10 "#61d5ba"
        }
    }
}
