themes {
    "jellybeans" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Jellybeans
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#060606"
        terminal {
            foreground "#dedede"
            background "#121212"
            black "#929292"
            red "#e27373"
            green "#94b979"
            yellow "#ffba7b"
            blue "#97bedc"
            magenta "#e1c0fa"
            cyan "#00988e"
            white "#dedede"
            bright_black "#bdbdbd"
            bright_red "#ffa1a1"
            bright_green "#bddeab"
            bright_yellow "#ffdca0"
            bright_blue "#b1d8f6"
            bright_magenta "#fbdaff"
            bright_cyan "#1ab2a8"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#dedede"
            background "#121212"
            emphasis_0 "#ffba7b"
            emphasis_1 "#00988e"
            emphasis_2 "#94b979"
            emphasis_3 "#e1c0fa"
        }
        text_selected {
            base "#121212"
            background "#dedede"
            emphasis_0 "#7d5b3c"
            emphasis_1 "#496866"
            emphasis_2 "#5a6651"
            emphasis_3 "#6c5c78"
        }
        table_cell_unselected {
            base "#dedede"
            background "#121212"
            emphasis_0 "#ffba7b"
            emphasis_1 "#00988e"
            emphasis_2 "#94b979"
            emphasis_3 "#e1c0fa"
        }
        table_cell_selected {
            base "#f4f4f4"
            background "#474e91"
            emphasis_0 "#ffba7b"
            emphasis_1 "#93d3cf"
            emphasis_2 "#b6cfa4"
            emphasis_3 "#e1c0fa"
        }
        list_unselected {
            base "#dedede"
            background "#121212"
            emphasis_0 "#ffba7b"
            emphasis_1 "#00988e"
            emphasis_2 "#94b979"
            emphasis_3 "#e1c0fa"
        }
        list_selected {
            base "#f4f4f4"
            background "#474e91"
            emphasis_0 "#ffba7b"
            emphasis_1 "#93d3cf"
            emphasis_2 "#b6cfa4"
            emphasis_3 "#e1c0fa"
        }
        ribbon_selected {
            base "#121212"
            background "#94b979"
            emphasis_0 "#653333"
            emphasis_1 "#543d29"
            emphasis_2 "#493e51"
            emphasis_3 "#36444f"
        }
        ribbon_unselected {
            base "#121212"
            background "#dedede"
            emphasis_0 "#964c4c"
            emphasis_1 "#dedede"
            emphasis_2 "#516575"
            emphasis_3 "#6c5c78"
        }
        table_title {
            base "#94b979"
            background "#121212"
            emphasis_0 "#ffba7b"
            emphasis_1 "#00988e"
            emphasis_2 "#94b979"
            emphasis_3 "#e1c0fa"
        }
        frame_unselected {
            base "#dedede"
            background "#121212"
            emphasis_0 "#dedede"
            emphasis_1 "#dedede"
            emphasis_2 "#dedede"
            emphasis_3 "#dedede"
        }
        frame_selected {
            base "#94b979"
            background "#121212"
            emphasis_0 "#ffba7b"
            emphasis_1 "#00988e"
            emphasis_2 "#94b979"
            emphasis_3 "#e1c0fa"
        }
        frame_highlight {
            base "#ffba7b"
            background "#121212"
            emphasis_0 "#e1c0fa"
            emphasis_1 "#ffba7b"
            emphasis_2 "#ffba7b"
            emphasis_3 "#ffba7b"
        }
        exit_code_success {
            base "#94b979"
            background "#121212"
            emphasis_0 "#00988e"
            emphasis_1 "#dedede"
            emphasis_2 "#e1c0fa"
            emphasis_3 "#97bedc"
        }
        exit_code_error {
            base "#e27373"
            background "#121212"
            emphasis_0 "#ffba7b"
            emphasis_1 "#dedede"
            emphasis_2 "#e1c0fa"
            emphasis_3 "#97bedc"
        }
        multiplayer_user_colors {
            player_1 "#e1c0fa"
            player_2 "#97bedc"
            player_3 "#fbdaff"
            player_4 "#ffba7b"
            player_5 "#00988e"
            player_6 "#ffdca0"
            player_7 "#e27373"
            player_8 "#dedede"
            player_9 "#ffa1a1"
            player_10 "#b1d8f6"
        }
    }
}
