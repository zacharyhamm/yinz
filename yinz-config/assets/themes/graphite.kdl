themes {
    "graphite" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Graphite
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#101216"
        terminal {
            foreground "#d2d6dc"
            background "#1c1e22"
            black "#15171a"
            red "#e58888"
            green "#a7c59f"
            yellow "#cec59d"
            blue "#8db4d0"
            magenta "#baabcb"
            cyan "#a8c6d4"
            white "#b4b9c0"
            bright_black "#7e8590"
            bright_red "#f19f9f"
            bright_green "#b9d5b1"
            bright_yellow "#cfba97"
            bright_blue "#a5c6de"
            bright_magenta "#ccbedd"
            bright_cyan "#bcd6e2"
            bright_white "#eceff3"
        }
        text_unselected {
            base "#d2d6dc"
            background "#1c1e22"
            emphasis_0 "#cec59d"
            emphasis_1 "#a8c6d4"
            emphasis_2 "#a7c59f"
            emphasis_3 "#baabcb"
        }
        text_selected {
            base "#1c1e22"
            background "#d2d6dc"
            emphasis_0 "#625d4a"
            emphasis_1 "#505f65"
            emphasis_2 "#53614f"
            emphasis_3 "#625a6b"
        }
        table_cell_unselected {
            base "#d2d6dc"
            background "#1c1e22"
            emphasis_0 "#cec59d"
            emphasis_1 "#a8c6d4"
            emphasis_2 "#a7c59f"
            emphasis_3 "#baabcb"
        }
        table_cell_selected {
            base "#999a9c"
            background "#2e333b"
            emphasis_0 "#cec59d"
            emphasis_1 "#a8c6d4"
            emphasis_2 "#a7c59f"
            emphasis_3 "#baabcb"
        }
        list_unselected {
            base "#d2d6dc"
            background "#1c1e22"
            emphasis_0 "#cec59d"
            emphasis_1 "#a8c6d4"
            emphasis_2 "#a7c59f"
            emphasis_3 "#baabcb"
        }
        list_selected {
            base "#999a9c"
            background "#2e333b"
            emphasis_0 "#cec59d"
            emphasis_1 "#a8c6d4"
            emphasis_2 "#a7c59f"
            emphasis_3 "#baabcb"
        }
        ribbon_selected {
            base "#1c1e22"
            background "#a7c59f"
            emphasis_0 "#6c4040"
            emphasis_1 "#504c3d"
            emphasis_2 "#514a58"
            emphasis_3 "#3d4e5b"
        }
        ribbon_unselected {
            base "#1c1e22"
            background "#d2d6dc"
            emphasis_0 "#844e4e"
            emphasis_1 "#d2d6dc"
            emphasis_2 "#4b5f6e"
            emphasis_3 "#625a6b"
        }
        table_title {
            base "#a7c59f"
            background "#1c1e22"
            emphasis_0 "#cec59d"
            emphasis_1 "#a8c6d4"
            emphasis_2 "#a7c59f"
            emphasis_3 "#baabcb"
        }
        frame_unselected {
            base "#d2d6dc"
            background "#1c1e22"
            emphasis_0 "#d2d6dc"
            emphasis_1 "#d2d6dc"
            emphasis_2 "#d2d6dc"
            emphasis_3 "#d2d6dc"
        }
        frame_selected {
            base "#a7c59f"
            background "#1c1e22"
            emphasis_0 "#cec59d"
            emphasis_1 "#a8c6d4"
            emphasis_2 "#a7c59f"
            emphasis_3 "#baabcb"
        }
        frame_highlight {
            base "#cec59d"
            background "#1c1e22"
            emphasis_0 "#baabcb"
            emphasis_1 "#cec59d"
            emphasis_2 "#cec59d"
            emphasis_3 "#cec59d"
        }
        exit_code_success {
            base "#a7c59f"
            background "#1c1e22"
            emphasis_0 "#a8c6d4"
            emphasis_1 "#d2d6dc"
            emphasis_2 "#baabcb"
            emphasis_3 "#8db4d0"
        }
        exit_code_error {
            base "#e58888"
            background "#1c1e22"
            emphasis_0 "#cec59d"
            emphasis_1 "#d2d6dc"
            emphasis_2 "#baabcb"
            emphasis_3 "#8db4d0"
        }
        multiplayer_user_colors {
            player_1 "#baabcb"
            player_2 "#8db4d0"
            player_3 "#ccbedd"
            player_4 "#cec59d"
            player_5 "#a8c6d4"
            player_6 "#cfba97"
            player_7 "#e58888"
            player_8 "#b4b9c0"
            player_9 "#f19f9f"
            player_10 "#a5c6de"
        }
    }
}
