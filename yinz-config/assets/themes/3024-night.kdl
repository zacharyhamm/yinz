themes {
    "3024-night" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/3024%20Night
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000000"
        terminal {
            foreground "#a5a2a2"
            background "#090300"
            black "#090300"
            red "#db2d20"
            green "#01a252"
            yellow "#fded02"
            blue "#01a0e4"
            magenta "#a16a94"
            cyan "#b5e4f4"
            white "#a5a2a2"
            bright_black "#5c5855"
            bright_red "#e8bbd0"
            bright_green "#47413f"
            bright_yellow "#4a4543"
            bright_blue "#807d7c"
            bright_magenta "#d6d5d4"
            bright_cyan "#cdab53"
            bright_white "#f7f7f7"
        }
        text_unselected {
            base "#a5a2a2"
            background "#090300"
            emphasis_0 "#fded02"
            emphasis_1 "#b5e4f4"
            emphasis_2 "#01a252"
            emphasis_3 "#a16a94"
        }
        text_selected {
            base "#090300"
            background "#a5a2a2"
            emphasis_0 "#3f3b01"
            emphasis_1 "#2f3b3f"
            emphasis_2 "#204030"
            emphasis_3 "#41373e"
        }
        table_cell_unselected {
            base "#a5a2a2"
            background "#090300"
            emphasis_0 "#fded02"
            emphasis_1 "#b5e4f4"
            emphasis_2 "#01a252"
            emphasis_3 "#a16a94"
        }
        table_cell_selected {
            base "#b5b3b3"
            background "#4a4543"
            emphasis_0 "#fded02"
            emphasis_1 "#b5e4f4"
            emphasis_2 "#63c694"
            emphasis_3 "#c9aac2"
        }
        list_unselected {
            base "#a5a2a2"
            background "#090300"
            emphasis_0 "#fded02"
            emphasis_1 "#b5e4f4"
            emphasis_2 "#01a252"
            emphasis_3 "#a16a94"
        }
        list_selected {
            base "#b5b3b3"
            background "#4a4543"
            emphasis_0 "#fded02"
            emphasis_1 "#b5e4f4"
            emphasis_2 "#63c694"
            emphasis_3 "#c9aac2"
        }
        ribbon_selected {
            base "#090300"
            background "#01a252"
            emphasis_0 "#4d100b"
            emphasis_1 "#2a2700"
            emphasis_2 "#33212e"
            emphasis_3 "#002a3c"
        }
        ribbon_unselected {
            base "#090300"
            background "#a5a2a2"
            emphasis_0 "#711711"
            emphasis_1 "#a5a2a2"
            emphasis_2 "#003e59"
            emphasis_3 "#4b3145"
        }
        table_title {
            base "#01a252"
            background "#090300"
            emphasis_0 "#fded02"
            emphasis_1 "#b5e4f4"
            emphasis_2 "#01a252"
            emphasis_3 "#a16a94"
        }
        frame_unselected {
            base "#a5a2a2"
            background "#090300"
            emphasis_0 "#a5a2a2"
            emphasis_1 "#a5a2a2"
            emphasis_2 "#a5a2a2"
            emphasis_3 "#a5a2a2"
        }
        frame_selected {
            base "#01a252"
            background "#090300"
            emphasis_0 "#fded02"
            emphasis_1 "#b5e4f4"
            emphasis_2 "#01a252"
            emphasis_3 "#a16a94"
        }
        frame_highlight {
            base "#fded02"
            background "#090300"
            emphasis_0 "#a16a94"
            emphasis_1 "#fded02"
            emphasis_2 "#fded02"
            emphasis_3 "#fded02"
        }
        exit_code_success {
            base "#01a252"
            background "#090300"
            emphasis_0 "#b5e4f4"
            emphasis_1 "#a5a2a2"
            emphasis_2 "#a16a94"
            emphasis_3 "#01a0e4"
        }
        exit_code_error {
            base "#dd362a"
            background "#090300"
            emphasis_0 "#fded02"
            emphasis_1 "#a5a2a2"
            emphasis_2 "#a16a94"
            emphasis_3 "#01a0e4"
        }
        multiplayer_user_colors {
            player_1 "#a16a94"
            player_2 "#01a0e4"
            player_3 "#d6d5d4"
            player_4 "#fded02"
            player_5 "#b5e4f4"
            player_6 "#7a7674"
            player_7 "#dd362a"
            player_8 "#a5a2a2"
            player_9 "#e8bbd0"
            player_10 "#807d7c"
        }
    }
}
