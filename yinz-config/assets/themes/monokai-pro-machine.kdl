themes {
    "monokai-pro-machine" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Monokai%20Pro%20Machine
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#1b252a"
        terminal {
            foreground "#f2fffc"
            background "#273136"
            black "#273136"
            red "#ff6d7e"
            green "#a2e57b"
            yellow "#ffed72"
            blue "#ffb270"
            magenta "#baa0f8"
            cyan "#7cd5f1"
            white "#f2fffc"
            bright_black "#6b7678"
            bright_red "#ff6d7e"
            bright_green "#a2e57b"
            bright_yellow "#ffed72"
            bright_blue "#ffb270"
            bright_magenta "#baa0f8"
            bright_cyan "#7cd5f1"
            bright_white "#f2fffc"
        }
        text_unselected {
            base "#f2fffc"
            background "#273136"
            emphasis_0 "#ffed72"
            emphasis_1 "#7cd5f1"
            emphasis_2 "#a2e57b"
            emphasis_3 "#baa0f8"
        }
        text_selected {
            base "#273136"
            background "#f2fffc"
            emphasis_0 "#7e7538"
            emphasis_1 "#567a86"
            emphasis_2 "#5b7e47"
            emphasis_3 "#787189"
        }
        table_cell_unselected {
            base "#f2fffc"
            background "#273136"
            emphasis_0 "#ffed72"
            emphasis_1 "#7cd5f1"
            emphasis_2 "#a2e57b"
            emphasis_3 "#baa0f8"
        }
        table_cell_selected {
            base "#f2fffc"
            background "#545f62"
            emphasis_0 "#ffed72"
            emphasis_1 "#9de0f5"
            emphasis_2 "#a7e783"
            emphasis_3 "#dccffb"
        }
        list_unselected {
            base "#f2fffc"
            background "#273136"
            emphasis_0 "#ffed72"
            emphasis_1 "#7cd5f1"
            emphasis_2 "#a2e57b"
            emphasis_3 "#baa0f8"
        }
        list_selected {
            base "#f2fffc"
            background "#545f62"
            emphasis_0 "#ffed72"
            emphasis_1 "#9de0f5"
            emphasis_2 "#a7e783"
            emphasis_3 "#dccffb"
        }
        ribbon_selected {
            base "#273136"
            background "#a2e57b"
            emphasis_0 "#95404a"
            emphasis_1 "#635c2c"
            emphasis_2 "#625482"
            emphasis_3 "#775334"
        }
        ribbon_unselected {
            base "#273136"
            background "#f2fffc"
            emphasis_0 "#be515e"
            emphasis_1 "#f2fffc"
            emphasis_2 "#996b43"
            emphasis_3 "#7d6ba6"
        }
        table_title {
            base "#a2e57b"
            background "#273136"
            emphasis_0 "#ffed72"
            emphasis_1 "#7cd5f1"
            emphasis_2 "#a2e57b"
            emphasis_3 "#baa0f8"
        }
        frame_unselected {
            base "#f2fffc"
            background "#273136"
            emphasis_0 "#f2fffc"
            emphasis_1 "#f2fffc"
            emphasis_2 "#f2fffc"
            emphasis_3 "#f2fffc"
        }
        frame_selected {
            base "#a2e57b"
            background "#273136"
            emphasis_0 "#ffed72"
            emphasis_1 "#7cd5f1"
            emphasis_2 "#a2e57b"
            emphasis_3 "#baa0f8"
        }
        frame_highlight {
            base "#ffed72"
            background "#273136"
            emphasis_0 "#baa0f8"
            emphasis_1 "#ffed72"
            emphasis_2 "#ffed72"
            emphasis_3 "#ffed72"
        }
        exit_code_success {
            base "#a2e57b"
            background "#273136"
            emphasis_0 "#7cd5f1"
            emphasis_1 "#f2fffc"
            emphasis_2 "#baa0f8"
            emphasis_3 "#ffb270"
        }
        exit_code_error {
            base "#ff6d7e"
            background "#273136"
            emphasis_0 "#ffed72"
            emphasis_1 "#f2fffc"
            emphasis_2 "#baa0f8"
            emphasis_3 "#ffb270"
        }
        multiplayer_user_colors {
            player_1 "#baa0f8"
            player_2 "#ffb270"
            player_3 "#baa0f8"
            player_4 "#ffed72"
            player_5 "#7cd5f1"
            player_6 "#ffed72"
            player_7 "#ff6d7e"
            player_8 "#f2fffc"
            player_9 "#ff6d7e"
            player_10 "#ffb270"
        }
    }
}
