themes {
    "nocturnal-winter" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Nocturnal%20Winter
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#01010b"
        terminal {
            foreground "#e6e5e5"
            background "#0d0d17"
            black "#4d4d4d"
            red "#f12d52"
            green "#09cd7e"
            yellow "#f5f17a"
            blue "#3182e0"
            magenta "#ff2b6d"
            cyan "#09c87a"
            white "#fcfcfc"
            bright_black "#808080"
            bright_red "#f16d86"
            bright_green "#0ae78d"
            bright_yellow "#fffc67"
            bright_blue "#6096ff"
            bright_magenta "#ff78a2"
            bright_cyan "#0ae78d"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#e6e5e5"
            background "#0d0d17"
            emphasis_0 "#f5f17a"
            emphasis_1 "#09c87a"
            emphasis_2 "#09cd7e"
            emphasis_3 "#ff2b6d"
        }
        text_selected {
            base "#000000"
            background "#adbdd0"
            emphasis_0 "#4f4d27"
            emphasis_1 "#045735"
            emphasis_2 "#045735"
            emphasis_3 "#92193e"
        }
        table_cell_unselected {
            base "#e6e5e5"
            background "#0d0d17"
            emphasis_0 "#f5f17a"
            emphasis_1 "#09c87a"
            emphasis_2 "#09cd7e"
            emphasis_3 "#ff2b6d"
        }
        table_cell_selected {
            base "#000000"
            background "#adbdd0"
            emphasis_0 "#4f4d27"
            emphasis_1 "#045735"
            emphasis_2 "#045735"
            emphasis_3 "#92193e"
        }
        list_unselected {
            base "#e6e5e5"
            background "#0d0d17"
            emphasis_0 "#f5f17a"
            emphasis_1 "#09c87a"
            emphasis_2 "#09cd7e"
            emphasis_3 "#ff2b6d"
        }
        list_selected {
            base "#000000"
            background "#adbdd0"
            emphasis_0 "#4f4d27"
            emphasis_1 "#045735"
            emphasis_2 "#045735"
            emphasis_3 "#92193e"
        }
        ribbon_selected {
            base "#0d0d17"
            background "#09cd7e"
            emphasis_0 "#88192e"
            emphasis_1 "#484724"
            emphasis_2 "#88173a"
            emphasis_3 "#1b477a"
        }
        ribbon_unselected {
            base "#0d0d17"
            background "#e6e5e5"
            emphasis_0 "#c42543"
            emphasis_1 "#e6e5e5"
            emphasis_2 "#2767b2"
            emphasis_3 "#c42154"
        }
        table_title {
            base "#09cd7e"
            background "#0d0d17"
            emphasis_0 "#f5f17a"
            emphasis_1 "#09c87a"
            emphasis_2 "#09cd7e"
            emphasis_3 "#ff2b6d"
        }
        frame_unselected {
            base "#e6e5e5"
            background "#0d0d17"
            emphasis_0 "#e6e5e5"
            emphasis_1 "#e6e5e5"
            emphasis_2 "#e6e5e5"
            emphasis_3 "#e6e5e5"
        }
        frame_selected {
            base "#09cd7e"
            background "#0d0d17"
            emphasis_0 "#f5f17a"
            emphasis_1 "#09c87a"
            emphasis_2 "#09cd7e"
            emphasis_3 "#ff2b6d"
        }
        frame_highlight {
            base "#f5f17a"
            background "#0d0d17"
            emphasis_0 "#ff2b6d"
            emphasis_1 "#f5f17a"
            emphasis_2 "#f5f17a"
            emphasis_3 "#f5f17a"
        }
        exit_code_success {
            base "#09cd7e"
            background "#0d0d17"
            emphasis_0 "#09c87a"
            emphasis_1 "#e6e5e5"
            emphasis_2 "#ff2b6d"
            emphasis_3 "#3182e0"
        }
        exit_code_error {
            base "#f12d52"
            background "#0d0d17"
            emphasis_0 "#f5f17a"
            emphasis_1 "#e6e5e5"
            emphasis_2 "#ff2b6d"
            emphasis_3 "#3182e0"
        }
        multiplayer_user_colors {
            player_1 "#ff2b6d"
            player_2 "#3182e0"
            player_3 "#ff78a2"
            player_4 "#f5f17a"
            player_5 "#09c87a"
            player_6 "#fffc67"
            player_7 "#f12d52"
            player_8 "#fcfcfc"
            player_9 "#f16d86"
            player_10 "#6096ff"
        }
    }
}
