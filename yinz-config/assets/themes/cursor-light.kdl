themes {
    "cursor-light" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Cursor%20Light
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#e7e7e7"
        terminal {
            foreground "#252525"
            background "#f3f3f3"
            black "#252525"
            red "#cf2d56"
            green "#1f8a65"
            yellow "#a16900"
            blue "#3c7cab"
            magenta "#b8448b"
            cyan "#4c7f8c"
            white "#afafaf"
            bright_black "#5c5c5c"
            bright_red "#e75e78"
            bright_green "#55a583"
            bright_yellow "#c08532"
            bright_blue "#6299c3"
            bright_magenta "#d06ba6"
            bright_cyan "#6f9ba6"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#252525"
            background "#f3f3f3"
            emphasis_0 "#9a6400"
            emphasis_1 "#477682"
            emphasis_2 "#1c7e5c"
            emphasis_3 "#b7438a"
        }
        text_selected {
            base "#f3f3f3"
            background "#252525"
            emphasis_0 "#a7874a"
            emphasis_1 "#739097"
            emphasis_2 "#5b9782"
            emphasis_3 "#bb75a0"
        }
        table_cell_unselected {
            base "#252525"
            background "#f3f3f3"
            emphasis_0 "#9a6400"
            emphasis_1 "#477682"
            emphasis_2 "#1c7e5c"
            emphasis_3 "#b7438a"
        }
        table_cell_selected {
            base "#252525"
            background "#d9d9d9"
            emphasis_0 "#835600"
            emphasis_1 "#3d656f"
            emphasis_2 "#186c4f"
            emphasis_3 "#9d3a77"
        }
        list_unselected {
            base "#252525"
            background "#f3f3f3"
            emphasis_0 "#9a6400"
            emphasis_1 "#477682"
            emphasis_2 "#1c7e5c"
            emphasis_3 "#b7438a"
        }
        list_selected {
            base "#252525"
            background "#d9d9d9"
            emphasis_0 "#835600"
            emphasis_1 "#3d656f"
            emphasis_2 "#186c4f"
            emphasis_3 "#9d3a77"
        }
        ribbon_selected {
            base "#0d0d0d"
            background "#1f8a65"
            emphasis_0 "#1d060c"
            emphasis_1 "#130c00"
            emphasis_2 "#170911"
            emphasis_3 "#070e13"
        }
        ribbon_unselected {
            base "#f3f3f3"
            background "#252525"
            emphasis_0 "#dc6482"
            emphasis_1 "#252525"
            emphasis_2 "#5b91b8"
            emphasis_3 "#c86da4"
        }
        table_title {
            base "#1c7e5c"
            background "#f3f3f3"
            emphasis_0 "#9a6400"
            emphasis_1 "#477682"
            emphasis_2 "#1c7e5c"
            emphasis_3 "#b7438a"
        }
        frame_unselected {
            base "#252525"
            background "#f3f3f3"
            emphasis_0 "#252525"
            emphasis_1 "#252525"
            emphasis_2 "#252525"
            emphasis_3 "#252525"
        }
        frame_selected {
            base "#1c7e5c"
            background "#f3f3f3"
            emphasis_0 "#9a6400"
            emphasis_1 "#477682"
            emphasis_2 "#1c7e5c"
            emphasis_3 "#b7438a"
        }
        frame_highlight {
            base "#9a6400"
            background "#f3f3f3"
            emphasis_0 "#b7438a"
            emphasis_1 "#9a6400"
            emphasis_2 "#9a6400"
            emphasis_3 "#9a6400"
        }
        exit_code_success {
            base "#1c7e5c"
            background "#f3f3f3"
            emphasis_0 "#477682"
            emphasis_1 "#252525"
            emphasis_2 "#b7438a"
            emphasis_3 "#3874a0"
        }
        exit_code_error {
            base "#cf2d56"
            background "#f3f3f3"
            emphasis_0 "#9a6400"
            emphasis_1 "#252525"
            emphasis_2 "#b7438a"
            emphasis_3 "#3874a0"
        }
        multiplayer_user_colors {
            player_1 "#b7438a"
            player_2 "#3874a0"
            player_3 "#a45483"
            player_4 "#9a6400"
            player_5 "#477682"
            player_6 "#946626"
            player_7 "#cf2d56"
            player_8 "#6f6f6f"
            player_9 "#b74a5f"
            player_10 "#4a7393"
        }
    }
}
