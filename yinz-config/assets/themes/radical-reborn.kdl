themes {
    "radical-reborn" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/RadicalReborn
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#080716"
        terminal {
            foreground "#defff7"
            background "#141322"
            black "#30317d"
            red "#ff5395"
            green "#d8ff4e"
            yellow "#fffc7e"
            blue "#7dd9e4"
            magenta "#fa61b8"
            cyan "#a8ffef"
            white "#cff0e8"
            bright_black "#4627c2"
            bright_red "#ff427b"
            bright_green "#c8ff00"
            bright_yellow "#f8d846"
            bright_blue "#84f9fe"
            bright_magenta "#d5358f"
            bright_cyan "#83fee8"
            bright_white "#cbfff2"
        }
        text_unselected {
            base "#defff7"
            background "#141322"
            emphasis_0 "#fffc7e"
            emphasis_1 "#a8ffef"
            emphasis_2 "#d8ff4e"
            emphasis_3 "#fa61b8"
        }
        text_selected {
            base "#141322"
            background "#defff7"
            emphasis_0 "#76753a"
            emphasis_1 "#507a72"
            emphasis_2 "#677a25"
            emphasis_3 "#b44e88"
        }
        table_cell_unselected {
            base "#defff7"
            background "#141322"
            emphasis_0 "#fffc7e"
            emphasis_1 "#a8ffef"
            emphasis_2 "#d8ff4e"
            emphasis_3 "#fa61b8"
        }
        table_cell_selected {
            base "#eec1c1"
            background "#3c2e61"
            emphasis_0 "#fffc7e"
            emphasis_1 "#a8ffef"
            emphasis_2 "#d8ff4e"
            emphasis_3 "#fa6cbd"
        }
        list_unselected {
            base "#defff7"
            background "#141322"
            emphasis_0 "#fffc7e"
            emphasis_1 "#a8ffef"
            emphasis_2 "#d8ff4e"
            emphasis_3 "#fa61b8"
        }
        list_selected {
            base "#eec1c1"
            background "#3c2e61"
            emphasis_0 "#fffc7e"
            emphasis_1 "#a8ffef"
            emphasis_2 "#d8ff4e"
            emphasis_3 "#fa6cbd"
        }
        ribbon_selected {
            base "#141322"
            background "#d8ff4e"
            emphasis_0 "#bc3d6e"
            emphasis_1 "#706f37"
            emphasis_2 "#b24583"
            emphasis_3 "#43757a"
        }
        ribbon_unselected {
            base "#141322"
            background "#defff7"
            emphasis_0 "#c64074"
            emphasis_1 "#defff7"
            emphasis_2 "#467a80"
            emphasis_3 "#ba4889"
        }
        table_title {
            base "#d8ff4e"
            background "#141322"
            emphasis_0 "#fffc7e"
            emphasis_1 "#a8ffef"
            emphasis_2 "#d8ff4e"
            emphasis_3 "#fa61b8"
        }
        frame_unselected {
            base "#defff7"
            background "#141322"
            emphasis_0 "#defff7"
            emphasis_1 "#defff7"
            emphasis_2 "#defff7"
            emphasis_3 "#defff7"
        }
        frame_selected {
            base "#d8ff4e"
            background "#141322"
            emphasis_0 "#fffc7e"
            emphasis_1 "#a8ffef"
            emphasis_2 "#d8ff4e"
            emphasis_3 "#fa61b8"
        }
        frame_highlight {
            base "#fffc7e"
            background "#141322"
            emphasis_0 "#fa61b8"
            emphasis_1 "#fffc7e"
            emphasis_2 "#fffc7e"
            emphasis_3 "#fffc7e"
        }
        exit_code_success {
            base "#d8ff4e"
            background "#141322"
            emphasis_0 "#a8ffef"
            emphasis_1 "#defff7"
            emphasis_2 "#fa61b8"
            emphasis_3 "#7dd9e4"
        }
        exit_code_error {
            base "#ff5395"
            background "#141322"
            emphasis_0 "#fffc7e"
            emphasis_1 "#defff7"
            emphasis_2 "#fa61b8"
            emphasis_3 "#7dd9e4"
        }
        multiplayer_user_colors {
            player_1 "#fa61b8"
            player_2 "#7dd9e4"
            player_3 "#d84397"
            player_4 "#fffc7e"
            player_5 "#a8ffef"
            player_6 "#f8d846"
            player_7 "#ff5395"
            player_8 "#cff0e8"
            player_9 "#ff427b"
            player_10 "#84f9fe"
        }
    }
}
