themes {
    "daybreak" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Daybreak
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#e7e3dc"
        terminal {
            foreground "#44413b"
            background "#f3efe8"
            black "#44413b"
            red "#af2817"
            green "#3c6a12"
            yellow "#795900"
            blue "#186875"
            magenta "#754193"
            cyan "#006a62"
            white "#6e6b62"
            bright_black "#8c8579"
            bright_red "#c03a27"
            bright_green "#538625"
            bright_yellow "#9a4c1f"
            bright_blue "#207887"
            bright_magenta "#8552a3"
            bright_cyan "#087a71"
            bright_white "#2e2c27"
        }
        text_unselected {
            base "#44413b"
            background "#f3efe8"
            emphasis_0 "#795900"
            emphasis_1 "#006a62"
            emphasis_2 "#3c6a12"
            emphasis_3 "#754193"
        }
        text_selected {
            base "#f3efe8"
            background "#44413b"
            emphasis_0 "#bcac7f"
            emphasis_1 "#83b7b3"
            emphasis_2 "#9db488"
            emphasis_3 "#bda4cb"
        }
        table_cell_unselected {
            base "#44413b"
            background "#f3efe8"
            emphasis_0 "#795900"
            emphasis_1 "#006a62"
            emphasis_2 "#3c6a12"
            emphasis_3 "#754193"
        }
        table_cell_selected {
            base "#62605c"
            background "#e2daca"
            emphasis_0 "#795900"
            emphasis_1 "#006a62"
            emphasis_2 "#3c6a12"
            emphasis_3 "#754193"
        }
        list_unselected {
            base "#44413b"
            background "#f3efe8"
            emphasis_0 "#795900"
            emphasis_1 "#006a62"
            emphasis_2 "#3c6a12"
            emphasis_3 "#754193"
        }
        list_selected {
            base "#62605c"
            background "#e2daca"
            emphasis_0 "#795900"
            emphasis_1 "#006a62"
            emphasis_2 "#3c6a12"
            emphasis_3 "#754193"
        }
        ribbon_selected {
            base "#f3efe8"
            background "#3c6a12"
            emphasis_0 "#eed2cf"
            emphasis_1 "#dfd8c3"
            emphasis_2 "#e0d4e6"
            emphasis_3 "#c9dbdf"
        }
        ribbon_unselected {
            base "#f3efe8"
            background "#44413b"
            emphasis_0 "#db9e96"
            emphasis_1 "#44413b"
            emphasis_2 "#8cb4ba"
            emphasis_3 "#bda4cb"
        }
        table_title {
            base "#3c6a12"
            background "#f3efe8"
            emphasis_0 "#795900"
            emphasis_1 "#006a62"
            emphasis_2 "#3c6a12"
            emphasis_3 "#754193"
        }
        frame_unselected {
            base "#44413b"
            background "#f3efe8"
            emphasis_0 "#44413b"
            emphasis_1 "#44413b"
            emphasis_2 "#44413b"
            emphasis_3 "#44413b"
        }
        frame_selected {
            base "#3c6a12"
            background "#f3efe8"
            emphasis_0 "#795900"
            emphasis_1 "#006a62"
            emphasis_2 "#3c6a12"
            emphasis_3 "#754193"
        }
        frame_highlight {
            base "#795900"
            background "#f3efe8"
            emphasis_0 "#754193"
            emphasis_1 "#795900"
            emphasis_2 "#795900"
            emphasis_3 "#795900"
        }
        exit_code_success {
            base "#3c6a12"
            background "#f3efe8"
            emphasis_0 "#006a62"
            emphasis_1 "#44413b"
            emphasis_2 "#754193"
            emphasis_3 "#186875"
        }
        exit_code_error {
            base "#af2817"
            background "#f3efe8"
            emphasis_0 "#795900"
            emphasis_1 "#44413b"
            emphasis_2 "#754193"
            emphasis_3 "#186875"
        }
        multiplayer_user_colors {
            player_1 "#754193"
            player_2 "#186875"
            player_3 "#8552a3"
            player_4 "#795900"
            player_5 "#006a62"
            player_6 "#9a4c1f"
            player_7 "#af2817"
            player_8 "#6e6b62"
            player_9 "#c03a27"
            player_10 "#207786"
        }
    }
}
