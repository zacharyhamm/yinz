themes {
    "x-berlin" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/X%20Berlin
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000000"
        terminal {
            foreground "#cccccc"
            background "#000000"
            black "#000000"
            red "#999999"
            green "#bbbbbb"
            yellow "#dddddd"
            blue "#888888"
            magenta "#aaaaaa"
            cyan "#cccccc"
            white "#ffffff"
            bright_black "#404040"
            bright_red "#bbbbbb"
            bright_green "#dddddd"
            bright_yellow "#ffffff"
            bright_blue "#aaaaaa"
            bright_magenta "#cccccc"
            bright_cyan "#eeeeee"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#cccccc"
            background "#000000"
            emphasis_0 "#dddddd"
            emphasis_1 "#cccccc"
            emphasis_2 "#bbbbbb"
            emphasis_3 "#aaaaaa"
        }
        text_selected {
            base "#000000"
            background "#cccccc"
            emphasis_0 "#565656"
            emphasis_1 "#565656"
            emphasis_2 "#565656"
            emphasis_3 "#565656"
        }
        table_cell_unselected {
            base "#cccccc"
            background "#000000"
            emphasis_0 "#dddddd"
            emphasis_1 "#cccccc"
            emphasis_2 "#bbbbbb"
            emphasis_3 "#aaaaaa"
        }
        table_cell_selected {
            base "#000000"
            background "#cccccc"
            emphasis_0 "#565656"
            emphasis_1 "#565656"
            emphasis_2 "#565656"
            emphasis_3 "#565656"
        }
        list_unselected {
            base "#cccccc"
            background "#000000"
            emphasis_0 "#dddddd"
            emphasis_1 "#cccccc"
            emphasis_2 "#bbbbbb"
            emphasis_3 "#aaaaaa"
        }
        list_selected {
            base "#000000"
            background "#cccccc"
            emphasis_0 "#565656"
            emphasis_1 "#565656"
            emphasis_2 "#565656"
            emphasis_3 "#565656"
        }
        ribbon_selected {
            base "#000000"
            background "#bbbbbb"
            emphasis_0 "#4b4b4b"
            emphasis_1 "#4b4b4b"
            emphasis_2 "#4b4b4b"
            emphasis_3 "#4b4b4b"
        }
        ribbon_unselected {
            base "#000000"
            background "#cccccc"
            emphasis_0 "#565656"
            emphasis_1 "#cccccc"
            emphasis_2 "#565656"
            emphasis_3 "#565656"
        }
        table_title {
            base "#bbbbbb"
            background "#000000"
            emphasis_0 "#dddddd"
            emphasis_1 "#cccccc"
            emphasis_2 "#bbbbbb"
            emphasis_3 "#aaaaaa"
        }
        frame_unselected {
            base "#cccccc"
            background "#000000"
            emphasis_0 "#cccccc"
            emphasis_1 "#cccccc"
            emphasis_2 "#cccccc"
            emphasis_3 "#cccccc"
        }
        frame_selected {
            base "#bbbbbb"
            background "#000000"
            emphasis_0 "#dddddd"
            emphasis_1 "#cccccc"
            emphasis_2 "#bbbbbb"
            emphasis_3 "#aaaaaa"
        }
        frame_highlight {
            base "#dddddd"
            background "#000000"
            emphasis_0 "#aaaaaa"
            emphasis_1 "#dddddd"
            emphasis_2 "#dddddd"
            emphasis_3 "#dddddd"
        }
        exit_code_success {
            base "#bbbbbb"
            background "#000000"
            emphasis_0 "#cccccc"
            emphasis_1 "#cccccc"
            emphasis_2 "#aaaaaa"
            emphasis_3 "#888888"
        }
        exit_code_error {
            base "#999999"
            background "#000000"
            emphasis_0 "#dddddd"
            emphasis_1 "#cccccc"
            emphasis_2 "#aaaaaa"
            emphasis_3 "#888888"
        }
        multiplayer_user_colors {
            player_1 "#aaaaaa"
            player_2 "#888888"
            player_3 "#cccccc"
            player_4 "#dddddd"
            player_5 "#cccccc"
            player_6 "#ffffff"
            player_7 "#999999"
            player_8 "#ffffff"
            player_9 "#bbbbbb"
            player_10 "#aaaaaa"
        }
    }
}
