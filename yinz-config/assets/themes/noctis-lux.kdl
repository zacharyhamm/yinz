themes {
    "noctis-lux" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Noctis%20Lux
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#f2ece0"
        terminal {
            foreground "#005661"
            background "#fef8ec"
            black "#003b42"
            red "#e34e1c"
            green "#00b368"
            yellow "#f49725"
            blue "#0094f0"
            magenta "#ff5792"
            cyan "#00bdd6"
            white "#8ca6a6"
            bright_black "#004d57"
            bright_red "#ff4000"
            bright_green "#00d17a"
            bright_yellow "#ff8c00"
            bright_blue "#0fa3ff"
            bright_magenta "#ff6b9f"
            bright_cyan "#00cbe6"
            bright_white "#bbc3c4"
        }
        text_unselected {
            base "#005661"
            background "#fef8ec"
            emphasis_0 "#a26419"
            emphasis_1 "#007e8f"
            emphasis_2 "#00844d"
            emphasis_3 "#c44370"
        }
        text_selected {
            base "#fef8ec"
            background "#005661"
            emphasis_0 "#d1bb9f"
            emphasis_1 "#99c6cc"
            emphasis_2 "#99c8b4"
            emphasis_3 "#dfb2c2"
        }
        table_cell_unselected {
            base "#005661"
            background "#fef8ec"
            emphasis_0 "#a26419"
            emphasis_1 "#007e8f"
            emphasis_2 "#00844d"
            emphasis_3 "#c44370"
        }
        table_cell_selected {
            base "#005661"
            background "#f4e2b8"
            emphasis_0 "#905916"
            emphasis_1 "#00707f"
            emphasis_2 "#007544"
            emphasis_3 "#ae3b64"
        }
        list_unselected {
            base "#005661"
            background "#fef8ec"
            emphasis_0 "#a26419"
            emphasis_1 "#007e8f"
            emphasis_2 "#00844d"
            emphasis_3 "#c44370"
        }
        list_selected {
            base "#005661"
            background "#f4e2b8"
            emphasis_0 "#905916"
            emphasis_1 "#00707f"
            emphasis_2 "#007544"
            emphasis_3 "#ae3b64"
        }
        ribbon_selected {
            base "#353431"
            background "#00b368"
            emphasis_0 "#5e200c"
            emphasis_1 "#4b2e0b"
            emphasis_2 "#5b1f34"
            emphasis_3 "#003759"
        }
        ribbon_unselected {
            base "#fef8ec"
            background "#005661"
            emphasis_0 "#f2ae97"
            emphasis_1 "#005661"
            emphasis_2 "#79c7f7"
            emphasis_3 "#ffa3c3"
        }
        table_title {
            base "#00844d"
            background "#fef8ec"
            emphasis_0 "#a26419"
            emphasis_1 "#007e8f"
            emphasis_2 "#00844d"
            emphasis_3 "#c44370"
        }
        frame_unselected {
            base "#005661"
            background "#fef8ec"
            emphasis_0 "#005661"
            emphasis_1 "#005661"
            emphasis_2 "#005661"
            emphasis_3 "#005661"
        }
        frame_selected {
            base "#00844d"
            background "#fef8ec"
            emphasis_0 "#a26419"
            emphasis_1 "#007e8f"
            emphasis_2 "#00844d"
            emphasis_3 "#c44370"
        }
        frame_highlight {
            base "#a26419"
            background "#fef8ec"
            emphasis_0 "#c44370"
            emphasis_1 "#a26419"
            emphasis_2 "#a26419"
            emphasis_3 "#a26419"
        }
        exit_code_success {
            base "#00844d"
            background "#fef8ec"
            emphasis_0 "#007e8f"
            emphasis_1 "#005661"
            emphasis_2 "#c44370"
            emphasis_3 "#0077c1"
        }
        exit_code_error {
            base "#ca4519"
            background "#fef8ec"
            emphasis_0 "#a26419"
            emphasis_1 "#005661"
            emphasis_2 "#c44370"
            emphasis_3 "#0077c1"
        }
        multiplayer_user_colors {
            player_1 "#c44370"
            player_2 "#0077c1"
            player_3 "#b94e73"
            player_4 "#a26419"
            player_5 "#007e8f"
            player_6 "#ac5e00"
            player_7 "#ca4519"
            player_8 "#647676"
            player_9 "#d63600"
            player_10 "#0b77ba"
        }
    }
}
