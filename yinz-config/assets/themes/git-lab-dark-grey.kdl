themes {
    "git-lab-dark-grey" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/GitLab%20Dark%20Grey
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#161616"
        terminal {
            foreground "#ffffff"
            background "#222222"
            black "#000000"
            red "#f57f6c"
            green "#52b87a"
            yellow "#d99530"
            blue "#7fb6ed"
            magenta "#f88aaf"
            cyan "#32c5d2"
            white "#ffffff"
            bright_black "#666666"
            bright_red "#fcb5aa"
            bright_green "#91d4a8"
            bright_yellow "#e9be74"
            bright_blue "#498dd1"
            bright_magenta "#fcacc5"
            bright_cyan "#5edee3"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#ffffff"
            background "#222222"
            emphasis_0 "#d99530"
            emphasis_1 "#32c5d2"
            emphasis_2 "#52b87a"
            emphasis_3 "#f88aaf"
        }
        text_selected {
            base "#222222"
            background "#ad95e9"
            emphasis_0 "#4d3511"
            emphasis_1 "#103f44"
            emphasis_2 "#1d402b"
            emphasis_3 "#532e3a"
        }
        table_cell_unselected {
            base "#ffffff"
            background "#222222"
            emphasis_0 "#d99530"
            emphasis_1 "#32c5d2"
            emphasis_2 "#52b87a"
            emphasis_3 "#f88aaf"
        }
        table_cell_selected {
            base "#222222"
            background "#ad95e9"
            emphasis_0 "#4d3511"
            emphasis_1 "#103f44"
            emphasis_2 "#1d402b"
            emphasis_3 "#532e3a"
        }
        list_unselected {
            base "#ffffff"
            background "#222222"
            emphasis_0 "#d99530"
            emphasis_1 "#32c5d2"
            emphasis_2 "#52b87a"
            emphasis_3 "#f88aaf"
        }
        list_selected {
            base "#222222"
            background "#ad95e9"
            emphasis_0 "#4d3511"
            emphasis_1 "#103f44"
            emphasis_2 "#1d402b"
            emphasis_3 "#532e3a"
        }
        ribbon_selected {
            base "#222222"
            background "#52b87a"
            emphasis_0 "#5b2f28"
            emphasis_1 "#4f3612"
            emphasis_2 "#56303c"
            emphasis_3 "#2b3d50"
        }
        ribbon_unselected {
            base "#222222"
            background "#ffffff"
            emphasis_0 "#b45d4f"
            emphasis_1 "#ffffff"
            emphasis_2 "#55799e"
            emphasis_3 "#ab5f79"
        }
        table_title {
            base "#52b87a"
            background "#222222"
            emphasis_0 "#d99530"
            emphasis_1 "#32c5d2"
            emphasis_2 "#52b87a"
            emphasis_3 "#f88aaf"
        }
        frame_unselected {
            base "#ffffff"
            background "#222222"
            emphasis_0 "#ffffff"
            emphasis_1 "#ffffff"
            emphasis_2 "#ffffff"
            emphasis_3 "#ffffff"
        }
        frame_selected {
            base "#52b87a"
            background "#222222"
            emphasis_0 "#d99530"
            emphasis_1 "#32c5d2"
            emphasis_2 "#52b87a"
            emphasis_3 "#f88aaf"
        }
        frame_highlight {
            base "#d99530"
            background "#222222"
            emphasis_0 "#f88aaf"
            emphasis_1 "#d99530"
            emphasis_2 "#d99530"
            emphasis_3 "#d99530"
        }
        exit_code_success {
            base "#52b87a"
            background "#222222"
            emphasis_0 "#32c5d2"
            emphasis_1 "#ffffff"
            emphasis_2 "#f88aaf"
            emphasis_3 "#7fb6ed"
        }
        exit_code_error {
            base "#f57f6c"
            background "#222222"
            emphasis_0 "#d99530"
            emphasis_1 "#ffffff"
            emphasis_2 "#f88aaf"
            emphasis_3 "#7fb6ed"
        }
        multiplayer_user_colors {
            player_1 "#f88aaf"
            player_2 "#7fb6ed"
            player_3 "#fcacc5"
            player_4 "#d99530"
            player_5 "#32c5d2"
            player_6 "#e9be74"
            player_7 "#f57f6c"
            player_8 "#ffffff"
            player_9 "#fcb5aa"
            player_10 "#498dd1"
        }
    }
}
