themes {
    "material-darker" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Material%20Darker
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#151515"
        terminal {
            foreground "#eeffff"
            background "#212121"
            black "#000000"
            red "#ff5370"
            green "#c3e88d"
            yellow "#ffcb6b"
            blue "#82aaff"
            magenta "#c792ea"
            cyan "#89ddff"
            white "#ffffff"
            bright_black "#545454"
            bright_red "#ff5370"
            bright_green "#c3e88d"
            bright_yellow "#ffcb6b"
            bright_blue "#82aaff"
            bright_magenta "#c792ea"
            bright_cyan "#89ddff"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#eeffff"
            background "#212121"
            emphasis_0 "#ffcb6b"
            emphasis_1 "#89ddff"
            emphasis_2 "#c3e88d"
            emphasis_3 "#c792ea"
        }
        text_selected {
            base "#545454"
            background "#eeffff"
            emphasis_0 "#8d703b"
            emphasis_1 "#4c7a8d"
            emphasis_2 "#677b4b"
            emphasis_3 "#8b66a3"
        }
        table_cell_unselected {
            base "#eeffff"
            background "#212121"
            emphasis_0 "#ffcb6b"
            emphasis_1 "#89ddff"
            emphasis_2 "#c3e88d"
            emphasis_3 "#c792ea"
        }
        table_cell_selected {
            base "#545454"
            background "#eeffff"
            emphasis_0 "#8d703b"
            emphasis_1 "#4c7a8d"
            emphasis_2 "#677b4b"
            emphasis_3 "#8b66a3"
        }
        list_unselected {
            base "#eeffff"
            background "#212121"
            emphasis_0 "#ffcb6b"
            emphasis_1 "#89ddff"
            emphasis_2 "#c3e88d"
            emphasis_3 "#c792ea"
        }
        list_selected {
            base "#545454"
            background "#eeffff"
            emphasis_0 "#8d703b"
            emphasis_1 "#4c7a8d"
            emphasis_2 "#677b4b"
            emphasis_3 "#8b66a3"
        }
        ribbon_selected {
            base "#212121"
            background "#c3e88d"
            emphasis_0 "#aa374b"
            emphasis_1 "#755d31"
            emphasis_2 "#735588"
            emphasis_3 "#496090"
        }
        ribbon_unselected {
            base "#212121"
            background "#eeffff"
            emphasis_0 "#cc425a"
            emphasis_1 "#eeffff"
            emphasis_2 "#5873ad"
            emphasis_3 "#8b66a3"
        }
        table_title {
            base "#c3e88d"
            background "#212121"
            emphasis_0 "#ffcb6b"
            emphasis_1 "#89ddff"
            emphasis_2 "#c3e88d"
            emphasis_3 "#c792ea"
        }
        frame_unselected {
            base "#eeffff"
            background "#212121"
            emphasis_0 "#eeffff"
            emphasis_1 "#eeffff"
            emphasis_2 "#eeffff"
            emphasis_3 "#eeffff"
        }
        frame_selected {
            base "#c3e88d"
            background "#212121"
            emphasis_0 "#ffcb6b"
            emphasis_1 "#89ddff"
            emphasis_2 "#c3e88d"
            emphasis_3 "#c792ea"
        }
        frame_highlight {
            base "#ffcb6b"
            background "#212121"
            emphasis_0 "#c792ea"
            emphasis_1 "#ffcb6b"
            emphasis_2 "#ffcb6b"
            emphasis_3 "#ffcb6b"
        }
        exit_code_success {
            base "#c3e88d"
            background "#212121"
            emphasis_0 "#89ddff"
            emphasis_1 "#eeffff"
            emphasis_2 "#c792ea"
            emphasis_3 "#82aaff"
        }
        exit_code_error {
            base "#ff5370"
            background "#212121"
            emphasis_0 "#ffcb6b"
            emphasis_1 "#eeffff"
            emphasis_2 "#c792ea"
            emphasis_3 "#82aaff"
        }
        multiplayer_user_colors {
            player_1 "#c792ea"
            player_2 "#82aaff"
            player_3 "#c792ea"
            player_4 "#ffcb6b"
            player_5 "#89ddff"
            player_6 "#ffcb6b"
            player_7 "#ff5370"
            player_8 "#ffffff"
            player_9 "#ff5370"
            player_10 "#82aaff"
        }
    }
}
