themes {
    "afterglow" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Afterglow
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#151515"
        terminal {
            foreground "#d0d0d0"
            background "#212121"
            black "#151515"
            red "#ac4142"
            green "#7e8e50"
            yellow "#e5b567"
            blue "#6c99bb"
            magenta "#9f4e85"
            cyan "#7dd6cf"
            white "#d0d0d0"
            bright_black "#505050"
            bright_red "#ac4142"
            bright_green "#7e8e50"
            bright_yellow "#e5b567"
            bright_blue "#6c99bb"
            bright_magenta "#9f4e85"
            bright_cyan "#7dd6cf"
            bright_white "#f5f5f5"
        }
        text_unselected {
            base "#d0d0d0"
            background "#212121"
            emphasis_0 "#e5b567"
            emphasis_1 "#7dd6cf"
            emphasis_2 "#7e8e50"
            emphasis_3 "#b3739f"
        }
        text_selected {
            base "#212121"
            background "#d0d0d0"
            emphasis_0 "#6c5530"
            emphasis_1 "#38605d"
            emphasis_2 "#555d3d"
            emphasis_3 "#704f65"
        }
        table_cell_unselected {
            base "#d0d0d0"
            background "#212121"
            emphasis_0 "#e5b567"
            emphasis_1 "#7dd6cf"
            emphasis_2 "#7e8e50"
            emphasis_3 "#b3739f"
        }
        table_cell_selected {
            base "#d0d0d0"
            background "#303030"
            emphasis_0 "#e5b567"
            emphasis_1 "#7dd6cf"
            emphasis_2 "#8f9d67"
            emphasis_3 "#bd86ab"
        }
        list_unselected {
            base "#d0d0d0"
            background "#212121"
            emphasis_0 "#e5b567"
            emphasis_1 "#7dd6cf"
            emphasis_2 "#7e8e50"
            emphasis_3 "#b3739f"
        }
        list_selected {
            base "#d0d0d0"
            background "#303030"
            emphasis_0 "#e5b567"
            emphasis_1 "#7dd6cf"
            emphasis_2 "#8f9d67"
            emphasis_3 "#bd86ab"
        }
        ribbon_selected {
            base "#212121"
            background "#7e8e50"
            emphasis_0 "#391616"
            emphasis_1 "#281f12"
            emphasis_2 "#32182a"
            emphasis_3 "#18222a"
        }
        ribbon_unselected {
            base "#212121"
            background "#d0d0d0"
            emphasis_0 "#993a3b"
            emphasis_1 "#d0d0d0"
            emphasis_2 "#415c71"
            emphasis_3 "#854170"
        }
        table_title {
            base "#7e8e50"
            background "#212121"
            emphasis_0 "#e5b567"
            emphasis_1 "#7dd6cf"
            emphasis_2 "#7e8e50"
            emphasis_3 "#b3739f"
        }
        frame_unselected {
            base "#d0d0d0"
            background "#212121"
            emphasis_0 "#d0d0d0"
            emphasis_1 "#d0d0d0"
            emphasis_2 "#d0d0d0"
            emphasis_3 "#d0d0d0"
        }
        frame_selected {
            base "#7e8e50"
            background "#212121"
            emphasis_0 "#e5b567"
            emphasis_1 "#7dd6cf"
            emphasis_2 "#7e8e50"
            emphasis_3 "#b3739f"
        }
        frame_highlight {
            base "#e5b567"
            background "#212121"
            emphasis_0 "#b3739f"
            emphasis_1 "#e5b567"
            emphasis_2 "#e5b567"
            emphasis_3 "#e5b567"
        }
        exit_code_success {
            base "#7e8e50"
            background "#212121"
            emphasis_0 "#7dd6cf"
            emphasis_1 "#d0d0d0"
            emphasis_2 "#b3739f"
            emphasis_3 "#6c99bb"
        }
        exit_code_error {
            base "#c17172"
            background "#212121"
            emphasis_0 "#e5b567"
            emphasis_1 "#d0d0d0"
            emphasis_2 "#b3739f"
            emphasis_3 "#6c99bb"
        }
        multiplayer_user_colors {
            player_1 "#b3739f"
            player_2 "#6c99bb"
            player_3 "#b3739f"
            player_4 "#e5b567"
            player_5 "#7dd6cf"
            player_6 "#e5b567"
            player_7 "#c17172"
            player_8 "#d0d0d0"
            player_9 "#c17172"
            player_10 "#6c99bb"
        }
    }
}
