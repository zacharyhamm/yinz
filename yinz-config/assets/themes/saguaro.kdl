themes {
    "saguaro" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Saguaro
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#001007"
        terminal {
            foreground "#fff0d5"
            background "#001c13"
            black "#aebdb5"
            red "#f08a68"
            green "#82d49d"
            yellow "#f2c85f"
            blue "#72d2ce"
            magenta "#e887b0"
            cyan "#7bd9d5"
            white "#fff0d5"
            bright_black "#c5d0ca"
            bright_red "#ffa078"
            bright_green "#a2dfb5"
            bright_yellow "#f8d982"
            bright_blue "#9be1dc"
            bright_magenta "#f0a6c5"
            bright_cyan "#a3e7e2"
            bright_white "#fff9ea"
        }
        text_unselected {
            base "#fff0d5"
            background "#001c13"
            emphasis_0 "#f2c85f"
            emphasis_1 "#7bd9d5"
            emphasis_2 "#82d49d"
            emphasis_3 "#e887b0"
        }
        text_selected {
            base "#001c13"
            background "#fff0d5"
            emphasis_0 "#826b33"
            emphasis_1 "#447775"
            emphasis_2 "#497859"
            emphasis_3 "#896373"
        }
        table_cell_unselected {
            base "#fff0d5"
            background "#001c13"
            emphasis_0 "#f2c85f"
            emphasis_1 "#7bd9d5"
            emphasis_2 "#82d49d"
            emphasis_3 "#e887b0"
        }
        table_cell_selected {
            base "#fff4dc"
            background "#7b3d25"
            emphasis_0 "#f2c85f"
            emphasis_1 "#7bd9d5"
            emphasis_2 "#82d49d"
            emphasis_3 "#efadc9"
        }
        list_unselected {
            base "#fff0d5"
            background "#001c13"
            emphasis_0 "#f2c85f"
            emphasis_1 "#7bd9d5"
            emphasis_2 "#82d49d"
            emphasis_3 "#e887b0"
        }
        list_selected {
            base "#fff4dc"
            background "#7b3d25"
            emphasis_0 "#f2c85f"
            emphasis_1 "#7bd9d5"
            emphasis_2 "#82d49d"
            emphasis_3 "#efadc9"
        }
        ribbon_selected {
            base "#001c13"
            background "#82d49d"
            emphasis_0 "#754333"
            emphasis_1 "#5f4e25"
            emphasis_2 "#724256"
            emphasis_3 "#2f5756"
        }
        ribbon_unselected {
            base "#001c13"
            background "#fff0d5"
            emphasis_0 "#a05c45"
            emphasis_1 "#fff0d5"
            emphasis_2 "#417775"
            emphasis_3 "#9b5a75"
        }
        table_title {
            base "#82d49d"
            background "#001c13"
            emphasis_0 "#f2c85f"
            emphasis_1 "#7bd9d5"
            emphasis_2 "#82d49d"
            emphasis_3 "#e887b0"
        }
        frame_unselected {
            base "#fff0d5"
            background "#001c13"
            emphasis_0 "#fff0d5"
            emphasis_1 "#fff0d5"
            emphasis_2 "#fff0d5"
            emphasis_3 "#fff0d5"
        }
        frame_selected {
            base "#82d49d"
            background "#001c13"
            emphasis_0 "#f2c85f"
            emphasis_1 "#7bd9d5"
            emphasis_2 "#82d49d"
            emphasis_3 "#e887b0"
        }
        frame_highlight {
            base "#f2c85f"
            background "#001c13"
            emphasis_0 "#e887b0"
            emphasis_1 "#f2c85f"
            emphasis_2 "#f2c85f"
            emphasis_3 "#f2c85f"
        }
        exit_code_success {
            base "#82d49d"
            background "#001c13"
            emphasis_0 "#7bd9d5"
            emphasis_1 "#fff0d5"
            emphasis_2 "#e887b0"
            emphasis_3 "#72d2ce"
        }
        exit_code_error {
            base "#f08a68"
            background "#001c13"
            emphasis_0 "#f2c85f"
            emphasis_1 "#fff0d5"
            emphasis_2 "#e887b0"
            emphasis_3 "#72d2ce"
        }
        multiplayer_user_colors {
            player_1 "#e887b0"
            player_2 "#72d2ce"
            player_3 "#f0a6c5"
            player_4 "#f2c85f"
            player_5 "#7bd9d5"
            player_6 "#f8d982"
            player_7 "#f08a68"
            player_8 "#fff0d5"
            player_9 "#ffa078"
            player_10 "#9be1dc"
        }
    }
}
