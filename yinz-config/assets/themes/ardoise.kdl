themes {
    "ardoise" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Ardoise
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#121212"
        terminal {
            foreground "#eaeaea"
            background "#1e1e1e"
            black "#2c2c2c"
            red "#d3322d"
            green "#588b35"
            yellow "#fca93a"
            blue "#2465c2"
            magenta "#7332b4"
            cyan "#64e1b8"
            white "#f7f7f7"
            bright_black "#535353"
            bright_red "#fa5852"
            bright_green "#8dc252"
            bright_yellow "#ffea51"
            bright_blue "#6ab5f8"
            bright_magenta "#be68ca"
            bright_cyan "#89ffdb"
            bright_white "#fefefe"
        }
        text_unselected {
            base "#eaeaea"
            background "#1e1e1e"
            emphasis_0 "#fca93a"
            emphasis_1 "#64e1b8"
            emphasis_2 "#629241"
            emphasis_3 "#9e71cb"
        }
        text_selected {
            base "#1e1e1e"
            background "#eaeaea"
            emphasis_0 "#8a622c"
            emphasis_1 "#347560"
            emphasis_2 "#606e58"
            emphasis_3 "#71657d"
        }
        table_cell_unselected {
            base "#eaeaea"
            background "#1e1e1e"
            emphasis_0 "#fca93a"
            emphasis_1 "#64e1b8"
            emphasis_2 "#629241"
            emphasis_3 "#9e71cb"
        }
        table_cell_selected {
            base "#f1f3f5"
            background "#46515e"
            emphasis_0 "#fcb350"
            emphasis_1 "#64e1b8"
            emphasis_2 "#b1c9a1"
            emphasis_3 "#cfb9e5"
        }
        list_unselected {
            base "#eaeaea"
            background "#1e1e1e"
            emphasis_0 "#fca93a"
            emphasis_1 "#64e1b8"
            emphasis_2 "#629241"
            emphasis_3 "#9e71cb"
        }
        list_selected {
            base "#f1f3f5"
            background "#46515e"
            emphasis_0 "#fcb350"
            emphasis_1 "#64e1b8"
            emphasis_2 "#b1c9a1"
            emphasis_3 "#cfb9e5"
        }
        ribbon_selected {
            base "#141414"
            background "#588b35"
            emphasis_0 "#2a0a09"
            emphasis_1 "#1c1306"
            emphasis_2 "#1c0c2c"
            emphasis_3 "#071427"
        }
        ribbon_unselected {
            base "#1e1e1e"
            background "#eaeaea"
            emphasis_0 "#c72f2b"
            emphasis_1 "#eaeaea"
            emphasis_2 "#2465c2"
            emphasis_3 "#7332b4"
        }
        table_title {
            base "#629241"
            background "#1e1e1e"
            emphasis_0 "#fca93a"
            emphasis_1 "#64e1b8"
            emphasis_2 "#629241"
            emphasis_3 "#9e71cb"
        }
        frame_unselected {
            base "#eaeaea"
            background "#1e1e1e"
            emphasis_0 "#eaeaea"
            emphasis_1 "#eaeaea"
            emphasis_2 "#eaeaea"
            emphasis_3 "#eaeaea"
        }
        frame_selected {
            base "#629241"
            background "#1e1e1e"
            emphasis_0 "#fca93a"
            emphasis_1 "#64e1b8"
            emphasis_2 "#629241"
            emphasis_3 "#9e71cb"
        }
        frame_highlight {
            base "#fca93a"
            background "#1e1e1e"
            emphasis_0 "#9e71cb"
            emphasis_1 "#fca93a"
            emphasis_2 "#fca93a"
            emphasis_3 "#fca93a"
        }
        exit_code_success {
            base "#629241"
            background "#1e1e1e"
            emphasis_0 "#64e1b8"
            emphasis_1 "#eaeaea"
            emphasis_2 "#9e71cb"
            emphasis_3 "#5286cf"
        }
        exit_code_error {
            base "#dc5b57"
            background "#1e1e1e"
            emphasis_0 "#fca93a"
            emphasis_1 "#eaeaea"
            emphasis_2 "#9e71cb"
            emphasis_3 "#5286cf"
        }
        multiplayer_user_colors {
            player_1 "#9e71cb"
            player_2 "#5286cf"
            player_3 "#be68ca"
            player_4 "#fca93a"
            player_5 "#64e1b8"
            player_6 "#ffea51"
            player_7 "#dc5b57"
            player_8 "#f7f7f7"
            player_9 "#fa5852"
            player_10 "#6ab5f8"
        }
    }
}
