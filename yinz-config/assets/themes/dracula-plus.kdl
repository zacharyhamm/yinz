themes {
    "dracula-plus" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Dracula%2B
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#151515"
        terminal {
            foreground "#f8f8f2"
            background "#212121"
            black "#21222c"
            red "#ff5555"
            green "#50fa7b"
            yellow "#ffcb6b"
            blue "#82aaff"
            magenta "#c792ea"
            cyan "#8be9fd"
            white "#f8f8f2"
            bright_black "#545454"
            bright_red "#ff6e6e"
            bright_green "#69ff94"
            bright_yellow "#ffcb6b"
            bright_blue "#d6acff"
            bright_magenta "#ff92df"
            bright_cyan "#a4ffff"
            bright_white "#f8f8f2"
        }
        text_unselected {
            base "#f8f8f2"
            background "#212121"
            emphasis_0 "#ffcb6b"
            emphasis_1 "#8be9fd"
            emphasis_2 "#50fa7b"
            emphasis_3 "#c792ea"
        }
        text_selected {
            base "#545454"
            background "#f8f8f2"
            emphasis_0 "#8a6e3a"
            emphasis_1 "#487983"
            emphasis_2 "#2a8240"
            emphasis_3 "#8864a0"
        }
        table_cell_unselected {
            base "#f8f8f2"
            background "#212121"
            emphasis_0 "#ffcb6b"
            emphasis_1 "#8be9fd"
            emphasis_2 "#50fa7b"
            emphasis_3 "#c792ea"
        }
        table_cell_selected {
            base "#545454"
            background "#f8f8f2"
            emphasis_0 "#8a6e3a"
            emphasis_1 "#487983"
            emphasis_2 "#2a8240"
            emphasis_3 "#8864a0"
        }
        list_unselected {
            base "#f8f8f2"
            background "#212121"
            emphasis_0 "#ffcb6b"
            emphasis_1 "#8be9fd"
            emphasis_2 "#50fa7b"
            emphasis_3 "#c792ea"
        }
        list_selected {
            base "#545454"
            background "#f8f8f2"
            emphasis_0 "#8a6e3a"
            emphasis_1 "#487983"
            emphasis_2 "#2a8240"
            emphasis_3 "#8864a0"
        }
        ribbon_selected {
            base "#212121"
            background "#50fa7b"
            emphasis_0 "#ac3939"
            emphasis_1 "#755d31"
            emphasis_2 "#735588"
            emphasis_3 "#496090"
        }
        ribbon_unselected {
            base "#212121"
            background "#f8f8f2"
            emphasis_0 "#c94343"
            emphasis_1 "#f8f8f2"
            emphasis_2 "#5771aa"
            emphasis_3 "#8864a0"
        }
        table_title {
            base "#50fa7b"
            background "#212121"
            emphasis_0 "#ffcb6b"
            emphasis_1 "#8be9fd"
            emphasis_2 "#50fa7b"
            emphasis_3 "#c792ea"
        }
        frame_unselected {
            base "#f8f8f2"
            background "#212121"
            emphasis_0 "#f8f8f2"
            emphasis_1 "#f8f8f2"
            emphasis_2 "#f8f8f2"
            emphasis_3 "#f8f8f2"
        }
        frame_selected {
            base "#50fa7b"
            background "#212121"
            emphasis_0 "#ffcb6b"
            emphasis_1 "#8be9fd"
            emphasis_2 "#50fa7b"
            emphasis_3 "#c792ea"
        }
        frame_highlight {
            base "#ffcb6b"
            background "#212121"
            emphasis_0 "#c792ea"
            emphasis_1 "#ffcb6b"
            emphasis_2 "#ffcb6b"
            emphasis_3 "#ffcb6b"
        }
        exit_code_success {
            base "#50fa7b"
            background "#212121"
            emphasis_0 "#8be9fd"
            emphasis_1 "#f8f8f2"
            emphasis_2 "#c792ea"
            emphasis_3 "#82aaff"
        }
        exit_code_error {
            base "#ff5555"
            background "#212121"
            emphasis_0 "#ffcb6b"
            emphasis_1 "#f8f8f2"
            emphasis_2 "#c792ea"
            emphasis_3 "#82aaff"
        }
        multiplayer_user_colors {
            player_1 "#c792ea"
            player_2 "#82aaff"
            player_3 "#ff92df"
            player_4 "#ffcb6b"
            player_5 "#8be9fd"
            player_6 "#ffcb6b"
            player_7 "#ff5555"
            player_8 "#f8f8f2"
            player_9 "#ff6e6e"
            player_10 "#d6acff"
        }
    }
}
