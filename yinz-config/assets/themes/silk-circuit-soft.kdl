themes {
    "silk-circuit-soft" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/SilkCircuit%20Soft
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#0e0a1a"
        terminal {
            foreground "#f8f8f2"
            background "#1a1626"
            black "#141220"
            red "#ff6677"
            green "#66ff99"
            yellow "#ffe699"
            blue "#92aaff"
            magenta "#ff99ff"
            cyan "#99ffee"
            white "#f8f8f2"
            bright_black "#6272a4"
            bright_red "#ff7788"
            bright_green "#80ffb3"
            bright_yellow "#ffffa5"
            bright_blue "#a2bbff"
            bright_magenta "#ffb3ff"
            bright_cyan "#b3ffea"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#f8f8f2"
            background "#1a1626"
            emphasis_0 "#ffe699"
            emphasis_1 "#99ffee"
            emphasis_2 "#66ff99"
            emphasis_3 "#ff99ff"
        }
        text_selected {
            base "#1a1626"
            background "#f8f8f2"
            emphasis_0 "#7d714b"
            emphasis_1 "#4a7b73"
            emphasis_2 "#33804d"
            emphasis_3 "#9a5c9a"
        }
        table_cell_unselected {
            base "#f8f8f2"
            background "#1a1626"
            emphasis_0 "#ffe699"
            emphasis_1 "#99ffee"
            emphasis_2 "#66ff99"
            emphasis_3 "#ff99ff"
        }
        table_cell_selected {
            base "#f8f8f2"
            background "#44475a"
            emphasis_0 "#ffe699"
            emphasis_1 "#99ffee"
            emphasis_2 "#66ff99"
            emphasis_3 "#ff99ff"
        }
        list_unselected {
            base "#f8f8f2"
            background "#1a1626"
            emphasis_0 "#ffe699"
            emphasis_1 "#99ffee"
            emphasis_2 "#66ff99"
            emphasis_3 "#ff99ff"
        }
        list_selected {
            base "#f8f8f2"
            background "#44475a"
            emphasis_0 "#ffe699"
            emphasis_1 "#99ffee"
            emphasis_2 "#66ff99"
            emphasis_3 "#ff99ff"
        }
        ribbon_selected {
            base "#1a1626"
            background "#66ff99"
            emphasis_0 "#a9444f"
            emphasis_1 "#6f6443"
            emphasis_2 "#885288"
            emphasis_3 "#556395"
        }
        ribbon_unselected {
            base "#1a1626"
            background "#f8f8f2"
            emphasis_0 "#be4c59"
            emphasis_1 "#f8f8f2"
            emphasis_2 "#606fa7"
            emphasis_3 "#9a5c9a"
        }
        table_title {
            base "#66ff99"
            background "#1a1626"
            emphasis_0 "#ffe699"
            emphasis_1 "#99ffee"
            emphasis_2 "#66ff99"
            emphasis_3 "#ff99ff"
        }
        frame_unselected {
            base "#f8f8f2"
            background "#1a1626"
            emphasis_0 "#f8f8f2"
            emphasis_1 "#f8f8f2"
            emphasis_2 "#f8f8f2"
            emphasis_3 "#f8f8f2"
        }
        frame_selected {
            base "#66ff99"
            background "#1a1626"
            emphasis_0 "#ffe699"
            emphasis_1 "#99ffee"
            emphasis_2 "#66ff99"
            emphasis_3 "#ff99ff"
        }
        frame_highlight {
            base "#ffe699"
            background "#1a1626"
            emphasis_0 "#ff99ff"
            emphasis_1 "#ffe699"
            emphasis_2 "#ffe699"
            emphasis_3 "#ffe699"
        }
        exit_code_success {
            base "#66ff99"
            background "#1a1626"
            emphasis_0 "#99ffee"
            emphasis_1 "#f8f8f2"
            emphasis_2 "#ff99ff"
            emphasis_3 "#92aaff"
        }
        exit_code_error {
            base "#ff6677"
            background "#1a1626"
            emphasis_0 "#ffe699"
            emphasis_1 "#f8f8f2"
            emphasis_2 "#ff99ff"
            emphasis_3 "#92aaff"
        }
        multiplayer_user_colors {
            player_1 "#ff99ff"
            player_2 "#92aaff"
            player_3 "#ffb3ff"
            player_4 "#ffe699"
            player_5 "#99ffee"
            player_6 "#ffffa5"
            player_7 "#ff6677"
            player_8 "#f8f8f2"
            player_9 "#ff7788"
            player_10 "#a2bbff"
        }
    }
}
