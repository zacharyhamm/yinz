themes {
    "doom-peacock" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Doom%20Peacock
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#1f1e1b"
        terminal {
            foreground "#ede0ce"
            background "#2b2a27"
            black "#1c1f24"
            red "#cb4b16"
            green "#26a6a6"
            yellow "#bcd42a"
            blue "#2a6cc6"
            magenta "#a9a1e1"
            cyan "#5699af"
            white "#ede0ce"
            bright_black "#51504d"
            bright_red "#ff5d38"
            bright_green "#98be65"
            bright_yellow "#e6f972"
            bright_blue "#51afef"
            bright_magenta "#c678dd"
            bright_cyan "#46d9ff"
            bright_white "#dfdfdf"
        }
        text_unselected {
            base "#ede0ce"
            background "#2b2a27"
            emphasis_0 "#bcd42a"
            emphasis_1 "#579ab0"
            emphasis_2 "#26a6a6"
            emphasis_3 "#a9a1e1"
        }
        text_selected {
            base "#2b2a27"
            background "#ede0ce"
            emphasis_0 "#5e6a15"
            emphasis_1 "#55676d"
            emphasis_2 "#476b6b"
            emphasis_3 "#656279"
        }
        table_cell_unselected {
            base "#ede0ce"
            background "#2b2a27"
            emphasis_0 "#bcd42a"
            emphasis_1 "#579ab0"
            emphasis_2 "#26a6a6"
            emphasis_3 "#a9a1e1"
        }
        table_cell_selected {
            base "#ffffff"
            background "#a60033"
            emphasis_0 "#bcd42a"
            emphasis_1 "#a7cad5"
            emphasis_2 "#8bd0d0"
            emphasis_3 "#c5bfeb"
        }
        list_unselected {
            base "#ede0ce"
            background "#2b2a27"
            emphasis_0 "#bcd42a"
            emphasis_1 "#579ab0"
            emphasis_2 "#26a6a6"
            emphasis_3 "#a9a1e1"
        }
        list_selected {
            base "#ffffff"
            background "#a60033"
            emphasis_0 "#bcd42a"
            emphasis_1 "#a7cad5"
            emphasis_2 "#8bd0d0"
            emphasis_3 "#c5bfeb"
        }
        ribbon_selected {
            base "#2b2a27"
            background "#26a6a6"
            emphasis_0 "#531f09"
            emphasis_1 "#2c320a"
            emphasis_2 "#2f2d3f"
            emphasis_3 "#122f57"
        }
        ribbon_unselected {
            base "#2b2a27"
            background "#ede0ce"
            emphasis_0 "#af4113"
            emphasis_1 "#ede0ce"
            emphasis_2 "#2764b6"
            emphasis_3 "#656086"
        }
        table_title {
            base "#26a6a6"
            background "#2b2a27"
            emphasis_0 "#bcd42a"
            emphasis_1 "#579ab0"
            emphasis_2 "#26a6a6"
            emphasis_3 "#a9a1e1"
        }
        frame_unselected {
            base "#ede0ce"
            background "#2b2a27"
            emphasis_0 "#ede0ce"
            emphasis_1 "#ede0ce"
            emphasis_2 "#ede0ce"
            emphasis_3 "#ede0ce"
        }
        frame_selected {
            base "#26a6a6"
            background "#2b2a27"
            emphasis_0 "#bcd42a"
            emphasis_1 "#579ab0"
            emphasis_2 "#26a6a6"
            emphasis_3 "#a9a1e1"
        }
        frame_highlight {
            base "#bcd42a"
            background "#2b2a27"
            emphasis_0 "#a9a1e1"
            emphasis_1 "#bcd42a"
            emphasis_2 "#bcd42a"
            emphasis_3 "#bcd42a"
        }
        exit_code_success {
            base "#26a6a6"
            background "#2b2a27"
            emphasis_0 "#579ab0"
            emphasis_1 "#ede0ce"
            emphasis_2 "#a9a1e1"
            emphasis_3 "#6293d5"
        }
        exit_code_error {
            base "#d7764e"
            background "#2b2a27"
            emphasis_0 "#bcd42a"
            emphasis_1 "#ede0ce"
            emphasis_2 "#a9a1e1"
            emphasis_3 "#6293d5"
        }
        multiplayer_user_colors {
            player_1 "#a9a1e1"
            player_2 "#6293d5"
            player_3 "#c678dd"
            player_4 "#bcd42a"
            player_5 "#579ab0"
            player_6 "#e6f972"
            player_7 "#d7764e"
            player_8 "#ede0ce"
            player_9 "#ff5d38"
            player_10 "#51afef"
        }
    }
}
