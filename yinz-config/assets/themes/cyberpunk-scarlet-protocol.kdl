themes {
    "cyberpunk-scarlet-protocol" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Cyberpunk%20Scarlet%20Protocol
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#04050a"
        terminal {
            foreground "#e41951"
            background "#101116"
            black "#101116"
            red "#ff0051"
            green "#01dc84"
            yellow "#faf945"
            blue "#0271b6"
            magenta "#c930c7"
            cyan "#00c5c7"
            white "#c7c7c7"
            bright_black "#686868"
            bright_red "#ff6e67"
            bright_green "#60fa68"
            bright_yellow "#fffc67"
            bright_blue "#6871ff"
            bright_magenta "#bd35ec"
            bright_cyan "#60fdff"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#e73163"
            background "#101116"
            emphasis_0 "#faf945"
            emphasis_1 "#00c5c7"
            emphasis_2 "#01dc84"
            emphasis_3 "#cc3aca"
        }
        text_selected {
            base "#000000"
            background "#c1deff"
            emphasis_0 "#63631b"
            emphasis_1 "#006c6d"
            emphasis_2 "#016f43"
            emphasis_3 "#a227a1"
        }
        table_cell_unselected {
            base "#e73163"
            background "#101116"
            emphasis_0 "#faf945"
            emphasis_1 "#00c5c7"
            emphasis_2 "#01dc84"
            emphasis_3 "#cc3aca"
        }
        table_cell_selected {
            base "#000000"
            background "#c1deff"
            emphasis_0 "#63631b"
            emphasis_1 "#006c6d"
            emphasis_2 "#016f43"
            emphasis_3 "#a227a1"
        }
        list_unselected {
            base "#e73163"
            background "#101116"
            emphasis_0 "#faf945"
            emphasis_1 "#00c5c7"
            emphasis_2 "#01dc84"
            emphasis_3 "#cc3aca"
        }
        list_selected {
            base "#000000"
            background "#c1deff"
            emphasis_0 "#63631b"
            emphasis_1 "#006c6d"
            emphasis_2 "#016f43"
            emphasis_3 "#a227a1"
        }
        ribbon_selected {
            base "#101116"
            background "#01dc84"
            emphasis_0 "#a10033"
            emphasis_1 "#515116"
            emphasis_2 "#862085"
            emphasis_3 "#015285"
        }
        ribbon_unselected {
            base "#101116"
            background "#e73163"
            emphasis_0 "#2c000e"
            emphasis_1 "#e73163"
            emphasis_2 "#00131f"
            emphasis_3 "#1f071e"
        }
        table_title {
            base "#01dc84"
            background "#101116"
            emphasis_0 "#faf945"
            emphasis_1 "#00c5c7"
            emphasis_2 "#01dc84"
            emphasis_3 "#cc3aca"
        }
        frame_unselected {
            base "#e73163"
            background "#101116"
            emphasis_0 "#e73163"
            emphasis_1 "#e73163"
            emphasis_2 "#e73163"
            emphasis_3 "#e73163"
        }
        frame_selected {
            base "#01dc84"
            background "#101116"
            emphasis_0 "#faf945"
            emphasis_1 "#00c5c7"
            emphasis_2 "#01dc84"
            emphasis_3 "#cc3aca"
        }
        frame_highlight {
            base "#faf945"
            background "#101116"
            emphasis_0 "#cc3aca"
            emphasis_1 "#faf945"
            emphasis_2 "#faf945"
            emphasis_3 "#faf945"
        }
        exit_code_success {
            base "#01dc84"
            background "#101116"
            emphasis_0 "#00c5c7"
            emphasis_1 "#e73163"
            emphasis_2 "#cc3aca"
            emphasis_3 "#2283bf"
        }
        exit_code_error {
            base "#ff0051"
            background "#101116"
            emphasis_0 "#faf945"
            emphasis_1 "#e73163"
            emphasis_2 "#cc3aca"
            emphasis_3 "#2283bf"
        }
        multiplayer_user_colors {
            player_1 "#cc3aca"
            player_2 "#2283bf"
            player_3 "#bf3aec"
            player_4 "#faf945"
            player_5 "#00c5c7"
            player_6 "#fffc67"
            player_7 "#ff0051"
            player_8 "#c7c7c7"
            player_9 "#ff6e67"
            player_10 "#6871ff"
        }
    }
}
