themes {
    "tomorrow-night" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Tomorrow%20Night
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#111315"
        terminal {
            foreground "#c5c8c6"
            background "#1d1f21"
            black "#000000"
            red "#cc6666"
            green "#b5bd68"
            yellow "#f0c674"
            blue "#81a2be"
            magenta "#b294bb"
            cyan "#8abeb7"
            white "#ffffff"
            bright_black "#4c4c4c"
            bright_red "#cc6666"
            bright_green "#b5bd68"
            bright_yellow "#f0c674"
            bright_blue "#81a2be"
            bright_magenta "#b294bb"
            bright_cyan "#8abeb7"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#c5c8c6"
            background "#1d1f21"
            emphasis_0 "#f0c674"
            emphasis_1 "#8abeb7"
            emphasis_2 "#b5bd68"
            emphasis_3 "#b294bb"
        }
        text_selected {
            base "#1d1f21"
            background "#c5c8c6"
            emphasis_0 "#62512f"
            emphasis_1 "#405855"
            emphasis_2 "#52562f"
            emphasis_3 "#5d4f61"
        }
        table_cell_unselected {
            base "#c5c8c6"
            background "#1d1f21"
            emphasis_0 "#f0c674"
            emphasis_1 "#8abeb7"
            emphasis_2 "#b5bd68"
            emphasis_3 "#b294bb"
        }
        table_cell_selected {
            base "#c5c8c6"
            background "#373b41"
            emphasis_0 "#f0c674"
            emphasis_1 "#8abeb7"
            emphasis_2 "#b5bd68"
            emphasis_3 "#b79bbf"
        }
        list_unselected {
            base "#c5c8c6"
            background "#1d1f21"
            emphasis_0 "#f0c674"
            emphasis_1 "#8abeb7"
            emphasis_2 "#b5bd68"
            emphasis_3 "#b294bb"
        }
        list_selected {
            base "#c5c8c6"
            background "#373b41"
            emphasis_0 "#f0c674"
            emphasis_1 "#8abeb7"
            emphasis_2 "#b5bd68"
            emphasis_3 "#b79bbf"
        }
        ribbon_selected {
            base "#1d1f21"
            background "#b5bd68"
            emphasis_0 "#703838"
            emphasis_1 "#554629"
            emphasis_2 "#524456"
            emphasis_3 "#3b4a57"
        }
        ribbon_unselected {
            base "#1d1f21"
            background "#c5c8c6"
            emphasis_0 "#814040"
            emphasis_1 "#c5c8c6"
            emphasis_2 "#445665"
            emphasis_3 "#5e4e63"
        }
        table_title {
            base "#b5bd68"
            background "#1d1f21"
            emphasis_0 "#f0c674"
            emphasis_1 "#8abeb7"
            emphasis_2 "#b5bd68"
            emphasis_3 "#b294bb"
        }
        frame_unselected {
            base "#c5c8c6"
            background "#1d1f21"
            emphasis_0 "#c5c8c6"
            emphasis_1 "#c5c8c6"
            emphasis_2 "#c5c8c6"
            emphasis_3 "#c5c8c6"
        }
        frame_selected {
            base "#b5bd68"
            background "#1d1f21"
            emphasis_0 "#f0c674"
            emphasis_1 "#8abeb7"
            emphasis_2 "#b5bd68"
            emphasis_3 "#b294bb"
        }
        frame_highlight {
            base "#f0c674"
            background "#1d1f21"
            emphasis_0 "#b294bb"
            emphasis_1 "#f0c674"
            emphasis_2 "#f0c674"
            emphasis_3 "#f0c674"
        }
        exit_code_success {
            base "#b5bd68"
            background "#1d1f21"
            emphasis_0 "#8abeb7"
            emphasis_1 "#c5c8c6"
            emphasis_2 "#b294bb"
            emphasis_3 "#81a2be"
        }
        exit_code_error {
            base "#cd6868"
            background "#1d1f21"
            emphasis_0 "#f0c674"
            emphasis_1 "#c5c8c6"
            emphasis_2 "#b294bb"
            emphasis_3 "#81a2be"
        }
        multiplayer_user_colors {
            player_1 "#b294bb"
            player_2 "#81a2be"
            player_3 "#b294bb"
            player_4 "#f0c674"
            player_5 "#8abeb7"
            player_6 "#f0c674"
            player_7 "#cd6868"
            player_8 "#ffffff"
            player_9 "#cd6868"
            player_10 "#81a2be"
        }
    }
}
