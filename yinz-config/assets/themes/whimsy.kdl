themes {
    "whimsy" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Whimsy
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#1d1c2f"
        terminal {
            foreground "#b3b0d6"
            background "#29283b"
            black "#535178"
            red "#ef6487"
            green "#5eca89"
            yellow "#fdd877"
            blue "#65aef7"
            magenta "#aa7ff0"
            cyan "#43c1be"
            white "#ffffff"
            bright_black "#535178"
            bright_red "#ef6487"
            bright_green "#5eca89"
            bright_yellow "#fdd877"
            bright_blue "#65aef7"
            bright_magenta "#aa7ff0"
            bright_cyan "#43c1be"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#b3b0d6"
            background "#29283b"
            emphasis_0 "#fdd877"
            emphasis_1 "#43c1be"
            emphasis_2 "#5eca89"
            emphasis_3 "#aa7ff0"
        }
        text_selected {
            base "#29283b"
            background "#b3b0d6"
            emphasis_0 "#514526"
            emphasis_1 "#1b4e4d"
            emphasis_2 "#244e35"
            emphasis_3 "#4d3f64"
        }
        table_cell_unselected {
            base "#b3b0d6"
            background "#29283b"
            emphasis_0 "#fdd877"
            emphasis_1 "#43c1be"
            emphasis_2 "#5eca89"
            emphasis_3 "#aa7ff0"
        }
        table_cell_selected {
            base "#ffffff"
            background "#3d3c58"
            emphasis_0 "#fdd877"
            emphasis_1 "#43c1be"
            emphasis_2 "#5eca89"
            emphasis_3 "#bb99f3"
        }
        list_unselected {
            base "#b3b0d6"
            background "#29283b"
            emphasis_0 "#fdd877"
            emphasis_1 "#43c1be"
            emphasis_2 "#5eca89"
            emphasis_3 "#aa7ff0"
        }
        list_selected {
            base "#ffffff"
            background "#3d3c58"
            emphasis_0 "#fdd877"
            emphasis_1 "#43c1be"
            emphasis_2 "#5eca89"
            emphasis_3 "#bb99f3"
        }
        ribbon_selected {
            base "#29283b"
            background "#5eca89"
            emphasis_0 "#753142"
            emphasis_1 "#524627"
            emphasis_2 "#523d74"
            emphasis_3 "#2a4968"
        }
        ribbon_unselected {
            base "#29283b"
            background "#b3b0d6"
            emphasis_0 "#733041"
            emphasis_1 "#b3b0d6"
            emphasis_2 "#2a4867"
            emphasis_3 "#513c72"
        }
        table_title {
            base "#5eca89"
            background "#29283b"
            emphasis_0 "#fdd877"
            emphasis_1 "#43c1be"
            emphasis_2 "#5eca89"
            emphasis_3 "#aa7ff0"
        }
        frame_unselected {
            base "#b3b0d6"
            background "#29283b"
            emphasis_0 "#b3b0d6"
            emphasis_1 "#b3b0d6"
            emphasis_2 "#b3b0d6"
            emphasis_3 "#b3b0d6"
        }
        frame_selected {
            base "#5eca89"
            background "#29283b"
            emphasis_0 "#fdd877"
            emphasis_1 "#43c1be"
            emphasis_2 "#5eca89"
            emphasis_3 "#aa7ff0"
        }
        frame_highlight {
            base "#fdd877"
            background "#29283b"
            emphasis_0 "#aa7ff0"
            emphasis_1 "#fdd877"
            emphasis_2 "#fdd877"
            emphasis_3 "#fdd877"
        }
        exit_code_success {
            base "#5eca89"
            background "#29283b"
            emphasis_0 "#43c1be"
            emphasis_1 "#b3b0d6"
            emphasis_2 "#aa7ff0"
            emphasis_3 "#65aef7"
        }
        exit_code_error {
            base "#ef6487"
            background "#29283b"
            emphasis_0 "#fdd877"
            emphasis_1 "#b3b0d6"
            emphasis_2 "#aa7ff0"
            emphasis_3 "#65aef7"
        }
        multiplayer_user_colors {
            player_1 "#aa7ff0"
            player_2 "#65aef7"
            player_3 "#aa7ff0"
            player_4 "#fdd877"
            player_5 "#43c1be"
            player_6 "#fdd877"
            player_7 "#ef6487"
            player_8 "#ffffff"
            player_9 "#ef6487"
            player_10 "#65aef7"
        }
    }
}
