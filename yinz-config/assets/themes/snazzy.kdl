themes {
    "snazzy" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Snazzy
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#12131d"
        terminal {
            foreground "#ebece6"
            background "#1e1f29"
            black "#000000"
            red "#fc4346"
            green "#50fb7c"
            yellow "#f0fb8c"
            blue "#49baff"
            magenta "#fc4cb4"
            cyan "#8be9fe"
            white "#ededec"
            bright_black "#555555"
            bright_red "#fc4346"
            bright_green "#50fb7c"
            bright_yellow "#f0fb8c"
            bright_blue "#49baff"
            bright_magenta "#fc4cb4"
            bright_cyan "#8be9fe"
            bright_white "#ededec"
        }
        text_unselected {
            base "#ebece6"
            background "#1e1f29"
            emphasis_0 "#f0fb8c"
            emphasis_1 "#8be9fe"
            emphasis_2 "#50fb7c"
            emphasis_3 "#fc4cb4"
        }
        text_selected {
            base "#000000"
            background "#81aec6"
            emphasis_0 "#3c3f23"
            emphasis_1 "#274147"
            emphasis_2 "#164623"
            emphasis_3 "#6c204d"
        }
        table_cell_unselected {
            base "#ebece6"
            background "#1e1f29"
            emphasis_0 "#f0fb8c"
            emphasis_1 "#8be9fe"
            emphasis_2 "#50fb7c"
            emphasis_3 "#fc4cb4"
        }
        table_cell_selected {
            base "#000000"
            background "#81aec6"
            emphasis_0 "#3c3f23"
            emphasis_1 "#274147"
            emphasis_2 "#164623"
            emphasis_3 "#6c204d"
        }
        list_unselected {
            base "#ebece6"
            background "#1e1f29"
            emphasis_0 "#f0fb8c"
            emphasis_1 "#8be9fe"
            emphasis_2 "#50fb7c"
            emphasis_3 "#fc4cb4"
        }
        list_selected {
            base "#000000"
            background "#81aec6"
            emphasis_0 "#3c3f23"
            emphasis_1 "#274147"
            emphasis_2 "#164623"
            emphasis_3 "#6c204d"
        }
        ribbon_selected {
            base "#1e1f29"
            background "#50fb7c"
            emphasis_0 "#b43032"
            emphasis_1 "#616539"
            emphasis_2 "#a83378"
            emphasis_3 "#28678d"
        }
        ribbon_unselected {
            base "#1e1f29"
            background "#ebece6"
            emphasis_0 "#c53437"
            emphasis_1 "#ebece6"
            emphasis_2 "#2c709a"
            emphasis_3 "#b83783"
        }
        table_title {
            base "#50fb7c"
            background "#1e1f29"
            emphasis_0 "#f0fb8c"
            emphasis_1 "#8be9fe"
            emphasis_2 "#50fb7c"
            emphasis_3 "#fc4cb4"
        }
        frame_unselected {
            base "#ebece6"
            background "#1e1f29"
            emphasis_0 "#ebece6"
            emphasis_1 "#ebece6"
            emphasis_2 "#ebece6"
            emphasis_3 "#ebece6"
        }
        frame_selected {
            base "#50fb7c"
            background "#1e1f29"
            emphasis_0 "#f0fb8c"
            emphasis_1 "#8be9fe"
            emphasis_2 "#50fb7c"
            emphasis_3 "#fc4cb4"
        }
        frame_highlight {
            base "#f0fb8c"
            background "#1e1f29"
            emphasis_0 "#fc4cb4"
            emphasis_1 "#f0fb8c"
            emphasis_2 "#f0fb8c"
            emphasis_3 "#f0fb8c"
        }
        exit_code_success {
            base "#50fb7c"
            background "#1e1f29"
            emphasis_0 "#8be9fe"
            emphasis_1 "#ebece6"
            emphasis_2 "#fc4cb4"
            emphasis_3 "#49baff"
        }
        exit_code_error {
            base "#fc4346"
            background "#1e1f29"
            emphasis_0 "#f0fb8c"
            emphasis_1 "#ebece6"
            emphasis_2 "#fc4cb4"
            emphasis_3 "#49baff"
        }
        multiplayer_user_colors {
            player_1 "#fc4cb4"
            player_2 "#49baff"
            player_3 "#fc4cb4"
            player_4 "#f0fb8c"
            player_5 "#8be9fe"
            player_6 "#f0fb8c"
            player_7 "#fc4346"
            player_8 "#ededec"
            player_9 "#fc4346"
            player_10 "#49baff"
        }
    }
}
