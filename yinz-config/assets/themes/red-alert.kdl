themes {
    "red-alert" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Red%20Alert
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#6a1817"
        terminal {
            foreground "#ffffff"
            background "#762423"
            black "#000000"
            red "#d62e4e"
            green "#71be6b"
            yellow "#beb86b"
            blue "#489bee"
            magenta "#e979d7"
            cyan "#6bbeb8"
            white "#d6d6d6"
            bright_black "#666666"
            bright_red "#e02553"
            bright_green "#aff08c"
            bright_yellow "#dfddb7"
            bright_blue "#65aaf1"
            bright_magenta "#ddb7df"
            bright_cyan "#b7dfdd"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#ffffff"
            background "#762423"
            emphasis_0 "#beb86b"
            emphasis_1 "#6bbeb8"
            emphasis_2 "#71be6b"
            emphasis_3 "#ec8adc"
        }
        text_selected {
            base "#762423"
            background "#ffffff"
            emphasis_0 "#7c7846"
            emphasis_1 "#48807c"
            emphasis_2 "#4e8249"
            emphasis_3 "#ab599e"
        }
        table_cell_unselected {
            base "#ffffff"
            background "#762423"
            emphasis_0 "#beb86b"
            emphasis_1 "#6bbeb8"
            emphasis_2 "#71be6b"
            emphasis_3 "#ec8adc"
        }
        table_cell_selected {
            base "#ffffff"
            background "#073642"
            emphasis_0 "#beb86b"
            emphasis_1 "#6bbeb8"
            emphasis_2 "#71be6b"
            emphasis_3 "#e979d7"
        }
        list_unselected {
            base "#ffffff"
            background "#762423"
            emphasis_0 "#beb86b"
            emphasis_1 "#6bbeb8"
            emphasis_2 "#71be6b"
            emphasis_3 "#ec8adc"
        }
        list_selected {
            base "#ffffff"
            background "#073642"
            emphasis_0 "#beb86b"
            emphasis_1 "#6bbeb8"
            emphasis_2 "#71be6b"
            emphasis_3 "#e979d7"
        }
        ribbon_selected {
            base "#762423"
            background "#71be6b"
            emphasis_0 "#7c1b2d"
            emphasis_1 "#454227"
            emphasis_2 "#5e3157"
            emphasis_3 "#1f4368"
        }
        ribbon_unselected {
            base "#762423"
            background "#ffffff"
            emphasis_0 "#d62e4e"
            emphasis_1 "#ffffff"
            emphasis_2 "#3879ba"
            emphasis_3 "#ab599e"
        }
        table_title {
            base "#71be6b"
            background "#762423"
            emphasis_0 "#beb86b"
            emphasis_1 "#6bbeb8"
            emphasis_2 "#71be6b"
            emphasis_3 "#ec8adc"
        }
        frame_unselected {
            base "#ffffff"
            background "#762423"
            emphasis_0 "#ffffff"
            emphasis_1 "#ffffff"
            emphasis_2 "#ffffff"
            emphasis_3 "#ffffff"
        }
        frame_selected {
            base "#71be6b"
            background "#762423"
            emphasis_0 "#beb86b"
            emphasis_1 "#6bbeb8"
            emphasis_2 "#71be6b"
            emphasis_3 "#ec8adc"
        }
        frame_highlight {
            base "#beb86b"
            background "#762423"
            emphasis_0 "#ec8adc"
            emphasis_1 "#beb86b"
            emphasis_2 "#beb86b"
            emphasis_3 "#beb86b"
        }
        exit_code_success {
            base "#71be6b"
            background "#762423"
            emphasis_0 "#6bbeb8"
            emphasis_1 "#ffffff"
            emphasis_2 "#ec8adc"
            emphasis_3 "#6fb1f2"
        }
        exit_code_error {
            base "#ea94a4"
            background "#762423"
            emphasis_0 "#beb86b"
            emphasis_1 "#ffffff"
            emphasis_2 "#ec8adc"
            emphasis_3 "#6fb1f2"
        }
        multiplayer_user_colors {
            player_1 "#ec8adc"
            player_2 "#6fb1f2"
            player_3 "#ddb7df"
            player_4 "#beb86b"
            player_5 "#6bbeb8"
            player_6 "#dfddb7"
            player_7 "#ea94a4"
            player_8 "#d6d6d6"
            player_9 "#ef90a7"
            player_10 "#71b1f2"
        }
    }
}
