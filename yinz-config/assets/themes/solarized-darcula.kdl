themes {
    "solarized-darcula" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Solarized%20Darcula
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#313335"
        terminal {
            foreground "#d2d8d9"
            background "#3d3f41"
            black "#25292a"
            red "#f24840"
            green "#629655"
            yellow "#b68800"
            blue "#2075c7"
            magenta "#797fd4"
            cyan "#15968d"
            white "#d2d8d9"
            bright_black "#65696a"
            bright_red "#f24840"
            bright_green "#629655"
            bright_yellow "#b68800"
            bright_blue "#2075c7"
            bright_magenta "#797fd4"
            bright_cyan "#15968d"
            bright_white "#d2d8d9"
        }
        text_unselected {
            base "#d2d8d9"
            background "#3d3f41"
            emphasis_0 "#c8a640"
            emphasis_1 "#60b8b2"
            emphasis_2 "#8eb485"
            emphasis_3 "#a0a5e1"
        }
        text_selected {
            base "#3d3f41"
            background "#d2d8d9"
            emphasis_0 "#6c5c2c"
            emphasis_1 "#3b6562"
            emphasis_2 "#50624c"
            emphasis_3 "#595c78"
        }
        table_cell_unselected {
            base "#d2d8d9"
            background "#3d3f41"
            emphasis_0 "#c8a640"
            emphasis_1 "#60b8b2"
            emphasis_2 "#8eb485"
            emphasis_3 "#a0a5e1"
        }
        table_cell_selected {
            base "#d2d8d9"
            background "#214283"
            emphasis_0 "#ceaf53"
            emphasis_1 "#70bfb9"
            emphasis_2 "#99bb90"
            emphasis_3 "#a9ade3"
        }
        list_unselected {
            base "#d2d8d9"
            background "#3d3f41"
            emphasis_0 "#c8a640"
            emphasis_1 "#60b8b2"
            emphasis_2 "#8eb485"
            emphasis_3 "#a0a5e1"
        }
        list_selected {
            base "#d2d8d9"
            background "#214283"
            emphasis_0 "#ceaf53"
            emphasis_1 "#70bfb9"
            emphasis_2 "#99bb90"
            emphasis_3 "#a9ade3"
        }
        ribbon_selected {
            base "#222324"
            background "#629655"
            emphasis_0 "#411311"
            emphasis_1 "#2c2100"
            emphasis_2 "#202138"
            emphasis_3 "#0a243e"
        }
        ribbon_unselected {
            base "#3d3f41"
            background "#d2d8d9"
            emphasis_0 "#aa332d"
            emphasis_1 "#d2d8d9"
            emphasis_2 "#1a5fa2"
            emphasis_3 "#545994"
        }
        table_title {
            base "#8eb485"
            background "#3d3f41"
            emphasis_0 "#c8a640"
            emphasis_1 "#60b8b2"
            emphasis_2 "#8eb485"
            emphasis_3 "#a0a5e1"
        }
        frame_unselected {
            base "#d2d8d9"
            background "#3d3f41"
            emphasis_0 "#d2d8d9"
            emphasis_1 "#d2d8d9"
            emphasis_2 "#d2d8d9"
            emphasis_3 "#d2d8d9"
        }
        frame_selected {
            base "#8eb485"
            background "#3d3f41"
            emphasis_0 "#c8a640"
            emphasis_1 "#60b8b2"
            emphasis_2 "#8eb485"
            emphasis_3 "#a0a5e1"
        }
        frame_highlight {
            base "#c8a640"
            background "#3d3f41"
            emphasis_0 "#a0a5e1"
            emphasis_1 "#c8a640"
            emphasis_2 "#c8a640"
            emphasis_3 "#c8a640"
        }
        exit_code_success {
            base "#8eb485"
            background "#3d3f41"
            emphasis_0 "#60b8b2"
            emphasis_1 "#d2d8d9"
            emphasis_2 "#a0a5e1"
            emphasis_3 "#7caede"
        }
        exit_code_error {
            base "#f78b86"
            background "#3d3f41"
            emphasis_0 "#c8a640"
            emphasis_1 "#d2d8d9"
            emphasis_2 "#a0a5e1"
            emphasis_3 "#7caede"
        }
        multiplayer_user_colors {
            player_1 "#a0a5e1"
            player_2 "#7caede"
            player_3 "#a0a5e1"
            player_4 "#c8a640"
            player_5 "#60b8b2"
            player_6 "#c8a640"
            player_7 "#f78b86"
            player_8 "#d2d8d9"
            player_9 "#f78b86"
            player_10 "#7caede"
        }
    }
}
