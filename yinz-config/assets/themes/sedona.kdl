themes {
    "sedona" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Sedona
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#490b23"
        terminal {
            foreground "#fff0dc"
            background "#55172f"
            black "#c8b9bd"
            red "#f58d79"
            green "#83cd94"
            yellow "#efc257"
            blue "#8fc1e5"
            magenta "#dc98c7"
            cyan "#79d1cb"
            white "#fff0dc"
            bright_black "#d9c9cd"
            bright_red "#fba594"
            bright_green "#9ad9a7"
            bright_yellow "#f8d47b"
            bright_blue "#acd2ed"
            bright_magenta "#e7b2d5"
            bright_cyan "#99dfda"
            bright_white "#fff9ed"
        }
        text_unselected {
            base "#fff0dc"
            background "#55172f"
            emphasis_0 "#efc257"
            emphasis_1 "#79d1cb"
            emphasis_2 "#83cd94"
            emphasis_3 "#dc98c7"
        }
        text_selected {
            base "#55172f"
            background "#fff0dc"
            emphasis_0 "#846b30"
            emphasis_1 "#457773"
            emphasis_2 "#4d7856"
            emphasis_3 "#89637e"
        }
        table_cell_unselected {
            base "#fff0dc"
            background "#55172f"
            emphasis_0 "#efc257"
            emphasis_1 "#79d1cb"
            emphasis_2 "#83cd94"
            emphasis_3 "#dc98c7"
        }
        table_cell_selected {
            base "#fff8ea"
            background "#772c47"
            emphasis_0 "#efc257"
            emphasis_1 "#79d1cb"
            emphasis_2 "#83cd94"
            emphasis_3 "#dfa1cc"
        }
        list_unselected {
            base "#fff0dc"
            background "#55172f"
            emphasis_0 "#efc257"
            emphasis_1 "#79d1cb"
            emphasis_2 "#83cd94"
            emphasis_3 "#dc98c7"
        }
        list_selected {
            base "#fff8ea"
            background "#772c47"
            emphasis_0 "#efc257"
            emphasis_1 "#79d1cb"
            emphasis_2 "#83cd94"
            emphasis_3 "#dfa1cc"
        }
        ribbon_selected {
            base "#55172f"
            background "#83cd94"
            emphasis_0 "#6f4037"
            emphasis_1 "#5b4a21"
            emphasis_2 "#614358"
            emphasis_3 "#3b4f5e"
        }
        ribbon_unselected {
            base "#55172f"
            background "#fff0dc"
            emphasis_0 "#a05c4f"
            emphasis_1 "#fff0dc"
            emphasis_2 "#557288"
            emphasis_3 "#8d617f"
        }
        table_title {
            base "#83cd94"
            background "#55172f"
            emphasis_0 "#efc257"
            emphasis_1 "#79d1cb"
            emphasis_2 "#83cd94"
            emphasis_3 "#dc98c7"
        }
        frame_unselected {
            base "#fff0dc"
            background "#55172f"
            emphasis_0 "#fff0dc"
            emphasis_1 "#fff0dc"
            emphasis_2 "#fff0dc"
            emphasis_3 "#fff0dc"
        }
        frame_selected {
            base "#83cd94"
            background "#55172f"
            emphasis_0 "#efc257"
            emphasis_1 "#79d1cb"
            emphasis_2 "#83cd94"
            emphasis_3 "#dc98c7"
        }
        frame_highlight {
            base "#efc257"
            background "#55172f"
            emphasis_0 "#dc98c7"
            emphasis_1 "#efc257"
            emphasis_2 "#efc257"
            emphasis_3 "#efc257"
        }
        exit_code_success {
            base "#83cd94"
            background "#55172f"
            emphasis_0 "#79d1cb"
            emphasis_1 "#fff0dc"
            emphasis_2 "#dc98c7"
            emphasis_3 "#8fc1e5"
        }
        exit_code_error {
            base "#f58d79"
            background "#55172f"
            emphasis_0 "#efc257"
            emphasis_1 "#fff0dc"
            emphasis_2 "#dc98c7"
            emphasis_3 "#8fc1e5"
        }
        multiplayer_user_colors {
            player_1 "#dc98c7"
            player_2 "#8fc1e5"
            player_3 "#e7b2d5"
            player_4 "#efc257"
            player_5 "#79d1cb"
            player_6 "#f8d47b"
            player_7 "#f58d79"
            player_8 "#fff0dc"
            player_9 "#fba594"
            player_10 "#acd2ed"
        }
    }
}
