themes {
    "no-clown-fiesta" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/No%20Clown%20Fiesta
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#040404"
        terminal {
            foreground "#e0e1e4"
            background "#101010"
            black "#151515"
            red "#b46958"
            green "#90a959"
            yellow "#f4bf75"
            blue "#bad7ff"
            magenta "#aa759f"
            cyan "#88afa2"
            white "#e1e1e1"
            bright_black "#727272"
            bright_red "#7e97ab"
            bright_green "#90a959"
            bright_yellow "#f4bf75"
            bright_blue "#bad7ff"
            bright_magenta "#aa759f"
            bright_cyan "#88afa2"
            bright_white "#afafaf"
        }
        text_unselected {
            base "#e0e1e4"
            background "#101010"
            emphasis_0 "#f4bf75"
            emphasis_1 "#88afa2"
            emphasis_2 "#90a959"
            emphasis_3 "#aa759f"
        }
        text_selected {
            base "#eff0f1"
            background "#696d79"
            emphasis_0 "#fceeda"
            emphasis_1 "#eaf1ee"
            emphasis_2 "#edf1e4"
            emphasis_3 "#f4eef3"
        }
        table_cell_unselected {
            base "#e0e1e4"
            background "#101010"
            emphasis_0 "#f4bf75"
            emphasis_1 "#88afa2"
            emphasis_2 "#90a959"
            emphasis_3 "#aa759f"
        }
        table_cell_selected {
            base "#eff0f1"
            background "#696d79"
            emphasis_0 "#fceeda"
            emphasis_1 "#eaf1ee"
            emphasis_2 "#edf1e4"
            emphasis_3 "#f4eef3"
        }
        list_unselected {
            base "#e0e1e4"
            background "#101010"
            emphasis_0 "#f4bf75"
            emphasis_1 "#88afa2"
            emphasis_2 "#90a959"
            emphasis_3 "#aa759f"
        }
        list_selected {
            base "#eff0f1"
            background "#696d79"
            emphasis_0 "#fceeda"
            emphasis_1 "#eaf1ee"
            emphasis_2 "#edf1e4"
            emphasis_3 "#f4eef3"
        }
        ribbon_selected {
            base "#101010"
            background "#90a959"
            emphasis_0 "#502f27"
            emphasis_1 "#443521"
            emphasis_2 "#463041"
            emphasis_3 "#313843"
        }
        ribbon_unselected {
            base "#101010"
            background "#e0e1e4"
            emphasis_0 "#915447"
            emphasis_1 "#e0e1e4"
            emphasis_2 "#586578"
            emphasis_3 "#7f5877"
        }
        table_title {
            base "#90a959"
            background "#101010"
            emphasis_0 "#f4bf75"
            emphasis_1 "#88afa2"
            emphasis_2 "#90a959"
            emphasis_3 "#aa759f"
        }
        frame_unselected {
            base "#e0e1e4"
            background "#101010"
            emphasis_0 "#e0e1e4"
            emphasis_1 "#e0e1e4"
            emphasis_2 "#e0e1e4"
            emphasis_3 "#e0e1e4"
        }
        frame_selected {
            base "#90a959"
            background "#101010"
            emphasis_0 "#f4bf75"
            emphasis_1 "#88afa2"
            emphasis_2 "#90a959"
            emphasis_3 "#aa759f"
        }
        frame_highlight {
            base "#f4bf75"
            background "#101010"
            emphasis_0 "#aa759f"
            emphasis_1 "#f4bf75"
            emphasis_2 "#f4bf75"
            emphasis_3 "#f4bf75"
        }
        exit_code_success {
            base "#90a959"
            background "#101010"
            emphasis_0 "#88afa2"
            emphasis_1 "#e0e1e4"
            emphasis_2 "#aa759f"
            emphasis_3 "#bad7ff"
        }
        exit_code_error {
            base "#b46958"
            background "#101010"
            emphasis_0 "#f4bf75"
            emphasis_1 "#e0e1e4"
            emphasis_2 "#aa759f"
            emphasis_3 "#bad7ff"
        }
        multiplayer_user_colors {
            player_1 "#aa759f"
            player_2 "#bad7ff"
            player_3 "#aa759f"
            player_4 "#f4bf75"
            player_5 "#88afa2"
            player_6 "#f4bf75"
            player_7 "#b46958"
            player_8 "#e1e1e1"
            player_9 "#7e97ab"
            player_10 "#bad7ff"
        }
    }
}
