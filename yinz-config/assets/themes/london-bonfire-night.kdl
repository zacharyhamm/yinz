themes {
    "london-bonfire-night" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/London%20Bonfire%20Night
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#020002"
        terminal {
            foreground "#e8e0c8"
            background "#0e0c0e"
            black "#1a1418"
            red "#d65a3a"
            green "#6a8a4a"
            yellow "#e8b048"
            blue "#5a7ab8"
            magenta "#d76aa8"
            cyan "#88a8c8"
            white "#e8e0c8"
            bright_black "#44403c"
            bright_red "#ec7654"
            bright_green "#88a868"
            bright_yellow "#f5c25c"
            bright_blue "#7a96d0"
            bright_magenta "#ed85bc"
            bright_cyan "#a0bcd6"
            bright_white "#fdf6df"
        }
        text_unselected {
            base "#e8e0c8"
            background "#0e0c0e"
            emphasis_0 "#e8b048"
            emphasis_1 "#88a8c8"
            emphasis_2 "#6a8a4a"
            emphasis_3 "#d76aa8"
        }
        text_selected {
            base "#0e0c0e"
            background "#e8e0c8"
            emphasis_0 "#7d5f27"
            emphasis_1 "#526579"
            emphasis_2 "#556a40"
            emphasis_3 "#964a75"
        }
        table_cell_unselected {
            base "#e8e0c8"
            background "#0e0c0e"
            emphasis_0 "#e8b048"
            emphasis_1 "#88a8c8"
            emphasis_2 "#6a8a4a"
            emphasis_3 "#d76aa8"
        }
        table_cell_selected {
            base "#e8e0c8"
            background "#2a2228"
            emphasis_0 "#e8b048"
            emphasis_1 "#88a8c8"
            emphasis_2 "#769459"
            emphasis_3 "#d76aa8"
        }
        list_unselected {
            base "#e8e0c8"
            background "#0e0c0e"
            emphasis_0 "#e8b048"
            emphasis_1 "#88a8c8"
            emphasis_2 "#6a8a4a"
            emphasis_3 "#d76aa8"
        }
        list_selected {
            base "#e8e0c8"
            background "#2a2228"
            emphasis_0 "#e8b048"
            emphasis_1 "#88a8c8"
            emphasis_2 "#769459"
            emphasis_3 "#d76aa8"
        }
        ribbon_selected {
            base "#0e0c0e"
            background "#6a8a4a"
            emphasis_0 "#29110b"
            emphasis_1 "#1f170a"
            emphasis_2 "#25121d"
            emphasis_3 "#121825"
        }
        ribbon_unselected {
            base "#0e0c0e"
            background "#e8e0c8"
            emphasis_0 "#a6462d"
            emphasis_1 "#e8e0c8"
            emphasis_2 "#496395"
            emphasis_3 "#964a75"
        }
        table_title {
            base "#6a8a4a"
            background "#0e0c0e"
            emphasis_0 "#e8b048"
            emphasis_1 "#88a8c8"
            emphasis_2 "#6a8a4a"
            emphasis_3 "#d76aa8"
        }
        frame_unselected {
            base "#e8e0c8"
            background "#0e0c0e"
            emphasis_0 "#e8e0c8"
            emphasis_1 "#e8e0c8"
            emphasis_2 "#e8e0c8"
            emphasis_3 "#e8e0c8"
        }
        frame_selected {
            base "#6a8a4a"
            background "#0e0c0e"
            emphasis_0 "#e8b048"
            emphasis_1 "#88a8c8"
            emphasis_2 "#6a8a4a"
            emphasis_3 "#d76aa8"
        }
        frame_highlight {
            base "#e8b048"
            background "#0e0c0e"
            emphasis_0 "#d76aa8"
            emphasis_1 "#e8b048"
            emphasis_2 "#e8b048"
            emphasis_3 "#e8b048"
        }
        exit_code_success {
            base "#6a8a4a"
            background "#0e0c0e"
            emphasis_0 "#88a8c8"
            emphasis_1 "#e8e0c8"
            emphasis_2 "#d76aa8"
            emphasis_3 "#5a7ab8"
        }
        exit_code_error {
            base "#d65a3a"
            background "#0e0c0e"
            emphasis_0 "#e8b048"
            emphasis_1 "#e8e0c8"
            emphasis_2 "#d76aa8"
            emphasis_3 "#5a7ab8"
        }
        multiplayer_user_colors {
            player_1 "#d76aa8"
            player_2 "#5a7ab8"
            player_3 "#ed85bc"
            player_4 "#e8b048"
            player_5 "#88a8c8"
            player_6 "#f5c25c"
            player_7 "#d65a3a"
            player_8 "#e8e0c8"
            player_9 "#ec7654"
            player_10 "#7a96d0"
        }
    }
}
