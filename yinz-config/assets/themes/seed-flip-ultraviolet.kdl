themes {
    "seed-flip-ultraviolet" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/SeedFlip%20Ultraviolet
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000008"
        terminal {
            foreground "#e8e0f5"
            background "#0b0014"
            black "#05000a"
            red "#f04242"
            green "#42f07c"
            yellow "#f0d342"
            blue "#428bf0"
            magenta "#f042f0"
            cyan "#42f0f0"
            white "#f6f3fb"
            bright_black "#5b2687"
            bright_red "#f58989"
            bright_green "#89f5ad"
            bright_yellow "#f5e389"
            bright_blue "#89b6f5"
            bright_magenta "#f589f5"
            bright_cyan "#89f5f5"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#e8e0f5"
            background "#0b0014"
            emphasis_0 "#f0d342"
            emphasis_1 "#42f0f0"
            emphasis_2 "#42f07c"
            emphasis_3 "#f042f0"
        }
        text_selected {
            base "#0b0014"
            background "#e8e0f5"
            emphasis_0 "#736520"
            emphasis_1 "#1f7070"
            emphasis_2 "#20743c"
            emphasis_3 "#a82ea8"
        }
        table_cell_unselected {
            base "#e8e0f5"
            background "#0b0014"
            emphasis_0 "#f0d342"
            emphasis_1 "#42f0f0"
            emphasis_2 "#42f07c"
            emphasis_3 "#f042f0"
        }
        table_cell_selected {
            base "#e8e0f5"
            background "#13082a"
            emphasis_0 "#f0d342"
            emphasis_1 "#42f0f0"
            emphasis_2 "#42f07c"
            emphasis_3 "#f042f0"
        }
        list_unselected {
            base "#e8e0f5"
            background "#0b0014"
            emphasis_0 "#f0d342"
            emphasis_1 "#42f0f0"
            emphasis_2 "#42f07c"
            emphasis_3 "#f042f0"
        }
        list_selected {
            base "#e8e0f5"
            background "#13082a"
            emphasis_0 "#f0d342"
            emphasis_1 "#42f0f0"
            emphasis_2 "#42f07c"
            emphasis_3 "#f042f0"
        }
        ribbon_selected {
            base "#0b0014"
            background "#42f07c"
            emphasis_0 "#a82e2e"
            emphasis_1 "#685b1c"
            emphasis_2 "#972997"
            emphasis_3 "#2b5b9d"
        }
        ribbon_unselected {
            base "#0b0014"
            background "#e8e0f5"
            emphasis_0 "#ba3333"
            emphasis_1 "#e8e0f5"
            emphasis_2 "#3065af"
            emphasis_3 "#a82ea8"
        }
        table_title {
            base "#42f07c"
            background "#0b0014"
            emphasis_0 "#f0d342"
            emphasis_1 "#42f0f0"
            emphasis_2 "#42f07c"
            emphasis_3 "#f042f0"
        }
        frame_unselected {
            base "#e8e0f5"
            background "#0b0014"
            emphasis_0 "#e8e0f5"
            emphasis_1 "#e8e0f5"
            emphasis_2 "#e8e0f5"
            emphasis_3 "#e8e0f5"
        }
        frame_selected {
            base "#42f07c"
            background "#0b0014"
            emphasis_0 "#f0d342"
            emphasis_1 "#42f0f0"
            emphasis_2 "#42f07c"
            emphasis_3 "#f042f0"
        }
        frame_highlight {
            base "#f0d342"
            background "#0b0014"
            emphasis_0 "#f042f0"
            emphasis_1 "#f0d342"
            emphasis_2 "#f0d342"
            emphasis_3 "#f0d342"
        }
        exit_code_success {
            base "#42f07c"
            background "#0b0014"
            emphasis_0 "#42f0f0"
            emphasis_1 "#e8e0f5"
            emphasis_2 "#f042f0"
            emphasis_3 "#428bf0"
        }
        exit_code_error {
            base "#f04242"
            background "#0b0014"
            emphasis_0 "#f0d342"
            emphasis_1 "#e8e0f5"
            emphasis_2 "#f042f0"
            emphasis_3 "#428bf0"
        }
        multiplayer_user_colors {
            player_1 "#f042f0"
            player_2 "#428bf0"
            player_3 "#f589f5"
            player_4 "#f0d342"
            player_5 "#42f0f0"
            player_6 "#f5e389"
            player_7 "#f04242"
            player_8 "#f6f3fb"
            player_9 "#f58989"
            player_10 "#89b6f5"
        }
    }
}
