themes {
    "eventide" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Eventide
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000614"
        terminal {
            foreground "#e6edf3"
            background "#0b1220"
            black "#aeb8c5"
            red "#ff7272"
            green "#62d6a5"
            yellow "#ffd166"
            blue "#79aaff"
            magenta "#c79aff"
            cyan "#73d9e8"
            white "#e6edf3"
            bright_black "#c3ccd6"
            bright_red "#ff9292"
            bright_green "#82e2b8"
            bright_yellow "#ffe08a"
            bright_blue "#9bbdff"
            bright_magenta "#dab6ff"
            bright_cyan "#96e8f1"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#e6edf3"
            background "#0b1220"
            emphasis_0 "#ffd166"
            emphasis_1 "#73d9e8"
            emphasis_2 "#62d6a5"
            emphasis_3 "#c79aff"
        }
        text_selected {
            base "#0b1220"
            background "#e6edf3"
            emphasis_0 "#7f6833"
            emphasis_1 "#3d737b"
            emphasis_2 "#36765b"
            emphasis_3 "#7a5e9c"
        }
        table_cell_unselected {
            base "#e6edf3"
            background "#0b1220"
            emphasis_0 "#ffd166"
            emphasis_1 "#73d9e8"
            emphasis_2 "#62d6a5"
            emphasis_3 "#c79aff"
        }
        table_cell_selected {
            base "#f5f8fc"
            background "#284361"
            emphasis_0 "#ffd166"
            emphasis_1 "#73d9e8"
            emphasis_2 "#62d6a5"
            emphasis_3 "#c79aff"
        }
        list_unselected {
            base "#e6edf3"
            background "#0b1220"
            emphasis_0 "#ffd166"
            emphasis_1 "#73d9e8"
            emphasis_2 "#62d6a5"
            emphasis_3 "#c79aff"
        }
        list_selected {
            base "#f5f8fc"
            background "#284361"
            emphasis_0 "#ffd166"
            emphasis_1 "#73d9e8"
            emphasis_2 "#62d6a5"
            emphasis_3 "#c79aff"
        }
        ribbon_selected {
            base "#0b1220"
            background "#62d6a5"
            emphasis_0 "#803939"
            emphasis_1 "#5e4d26"
            emphasis_2 "#5b4674"
            emphasis_3 "#395078"
        }
        ribbon_unselected {
            base "#0b1220"
            background "#e6edf3"
            emphasis_0 "#ad4d4d"
            emphasis_1 "#e6edf3"
            emphasis_2 "#4c6ba1"
            emphasis_3 "#7a5e9c"
        }
        table_title {
            base "#62d6a5"
            background "#0b1220"
            emphasis_0 "#ffd166"
            emphasis_1 "#73d9e8"
            emphasis_2 "#62d6a5"
            emphasis_3 "#c79aff"
        }
        frame_unselected {
            base "#e6edf3"
            background "#0b1220"
            emphasis_0 "#e6edf3"
            emphasis_1 "#e6edf3"
            emphasis_2 "#e6edf3"
            emphasis_3 "#e6edf3"
        }
        frame_selected {
            base "#62d6a5"
            background "#0b1220"
            emphasis_0 "#ffd166"
            emphasis_1 "#73d9e8"
            emphasis_2 "#62d6a5"
            emphasis_3 "#c79aff"
        }
        frame_highlight {
            base "#ffd166"
            background "#0b1220"
            emphasis_0 "#c79aff"
            emphasis_1 "#ffd166"
            emphasis_2 "#ffd166"
            emphasis_3 "#ffd166"
        }
        exit_code_success {
            base "#62d6a5"
            background "#0b1220"
            emphasis_0 "#73d9e8"
            emphasis_1 "#e6edf3"
            emphasis_2 "#c79aff"
            emphasis_3 "#79aaff"
        }
        exit_code_error {
            base "#ff7272"
            background "#0b1220"
            emphasis_0 "#ffd166"
            emphasis_1 "#e6edf3"
            emphasis_2 "#c79aff"
            emphasis_3 "#79aaff"
        }
        multiplayer_user_colors {
            player_1 "#c79aff"
            player_2 "#79aaff"
            player_3 "#dab6ff"
            player_4 "#ffd166"
            player_5 "#73d9e8"
            player_6 "#ffe08a"
            player_7 "#ff7272"
            player_8 "#e6edf3"
            player_9 "#ff9292"
            player_10 "#9bbdff"
        }
    }
}
