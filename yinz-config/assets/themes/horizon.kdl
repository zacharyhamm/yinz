themes {
    "horizon" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Horizon
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#10121a"
        terminal {
            foreground "#d5d8da"
            background "#1c1e26"
            black "#000000"
            red "#e95678"
            green "#29d398"
            yellow "#fab795"
            blue "#26bbd9"
            magenta "#ee64ac"
            cyan "#59e1e3"
            white "#e5e5e5"
            bright_black "#666666"
            bright_red "#ec6a88"
            bright_green "#3fdaa4"
            bright_yellow "#fbc3a7"
            bright_blue "#3fc4de"
            bright_magenta "#f075b5"
            bright_cyan "#6be4e6"
            bright_white "#e5e5e5"
        }
        text_unselected {
            base "#d5d8da"
            background "#1c1e26"
            emphasis_0 "#fab795"
            emphasis_1 "#59e1e3"
            emphasis_2 "#29d398"
            emphasis_3 "#ee64ac"
        }
        text_selected {
            base "#f7f7f7"
            background "#6c6f93"
            emphasis_0 "#fef5f0"
            emphasis_1 "#e6fbfb"
            emphasis_2 "#e9fbf4"
            emphasis_3 "#fef4f9"
        }
        table_cell_unselected {
            base "#d5d8da"
            background "#1c1e26"
            emphasis_0 "#fab795"
            emphasis_1 "#59e1e3"
            emphasis_2 "#29d398"
            emphasis_3 "#ee64ac"
        }
        table_cell_selected {
            base "#f7f7f7"
            background "#6c6f93"
            emphasis_0 "#fef5f0"
            emphasis_1 "#e6fbfb"
            emphasis_2 "#e9fbf4"
            emphasis_3 "#fef4f9"
        }
        list_unselected {
            base "#d5d8da"
            background "#1c1e26"
            emphasis_0 "#fab795"
            emphasis_1 "#59e1e3"
            emphasis_2 "#29d398"
            emphasis_3 "#ee64ac"
        }
        list_selected {
            base "#f7f7f7"
            background "#6c6f93"
            emphasis_0 "#fef5f0"
            emphasis_1 "#e6fbfb"
            emphasis_2 "#e9fbf4"
            emphasis_3 "#fef4f9"
        }
        ribbon_selected {
            base "#1c1e26"
            background "#29d398"
            emphasis_0 "#802f42"
            emphasis_1 "#5e4538"
            emphasis_2 "#783357"
            emphasis_3 "#11525f"
        }
        ribbon_unselected {
            base "#1c1e26"
            background "#d5d8da"
            emphasis_0 "#a03b52"
            emphasis_1 "#d5d8da"
            emphasis_2 "#156778"
            emphasis_3 "#963f6d"
        }
        table_title {
            base "#29d398"
            background "#1c1e26"
            emphasis_0 "#fab795"
            emphasis_1 "#59e1e3"
            emphasis_2 "#29d398"
            emphasis_3 "#ee64ac"
        }
        frame_unselected {
            base "#d5d8da"
            background "#1c1e26"
            emphasis_0 "#d5d8da"
            emphasis_1 "#d5d8da"
            emphasis_2 "#d5d8da"
            emphasis_3 "#d5d8da"
        }
        frame_selected {
            base "#29d398"
            background "#1c1e26"
            emphasis_0 "#fab795"
            emphasis_1 "#59e1e3"
            emphasis_2 "#29d398"
            emphasis_3 "#ee64ac"
        }
        frame_highlight {
            base "#fab795"
            background "#1c1e26"
            emphasis_0 "#ee64ac"
            emphasis_1 "#fab795"
            emphasis_2 "#fab795"
            emphasis_3 "#fab795"
        }
        exit_code_success {
            base "#29d398"
            background "#1c1e26"
            emphasis_0 "#59e1e3"
            emphasis_1 "#d5d8da"
            emphasis_2 "#ee64ac"
            emphasis_3 "#26bbd9"
        }
        exit_code_error {
            base "#e95678"
            background "#1c1e26"
            emphasis_0 "#fab795"
            emphasis_1 "#d5d8da"
            emphasis_2 "#ee64ac"
            emphasis_3 "#26bbd9"
        }
        multiplayer_user_colors {
            player_1 "#ee64ac"
            player_2 "#26bbd9"
            player_3 "#f075b5"
            player_4 "#fab795"
            player_5 "#59e1e3"
            player_6 "#fbc3a7"
            player_7 "#e95678"
            player_8 "#e5e5e5"
            player_9 "#ec6a88"
            player_10 "#3fc4de"
        }
    }
}
