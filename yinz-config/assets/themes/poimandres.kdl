themes {
    "poimandres" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Poimandres
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#0e121c"
        terminal {
            foreground "#a6accd"
            background "#1a1e28"
            black "#1a1e28"
            red "#d0679d"
            green "#5de4c7"
            yellow "#fffac2"
            blue "#89ddff"
            magenta "#fcc5e9"
            cyan "#add7ff"
            white "#ffffff"
            bright_black "#a6accd"
            bright_red "#d0679d"
            bright_green "#5de4c7"
            bright_yellow "#fffac2"
            bright_blue "#add7ff"
            bright_magenta "#fae4fc"
            bright_cyan "#89ddff"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#a6accd"
            background "#1a1e28"
            emphasis_0 "#fffac2"
            emphasis_1 "#add7ff"
            emphasis_2 "#5de4c7"
            emphasis_3 "#fcc5e9"
        }
        text_selected {
            base "#424242"
            background "#a6accd"
            emphasis_0 "#434233"
            emphasis_1 "#364350"
            emphasis_2 "#1e4940"
            emphasis_3 "#4e3d48"
        }
        table_cell_unselected {
            base "#a6accd"
            background "#1a1e28"
            emphasis_0 "#fffac2"
            emphasis_1 "#add7ff"
            emphasis_2 "#5de4c7"
            emphasis_3 "#fcc5e9"
        }
        table_cell_selected {
            base "#424242"
            background "#a6accd"
            emphasis_0 "#434233"
            emphasis_1 "#364350"
            emphasis_2 "#1e4940"
            emphasis_3 "#4e3d48"
        }
        list_unselected {
            base "#a6accd"
            background "#1a1e28"
            emphasis_0 "#fffac2"
            emphasis_1 "#add7ff"
            emphasis_2 "#5de4c7"
            emphasis_3 "#fcc5e9"
        }
        list_selected {
            base "#424242"
            background "#a6accd"
            emphasis_0 "#434233"
            emphasis_1 "#364350"
            emphasis_2 "#1e4940"
            emphasis_3 "#4e3d48"
        }
        ribbon_selected {
            base "#1a1e28"
            background "#5de4c7"
            emphasis_0 "#854264"
            emphasis_1 "#5b5945"
            emphasis_2 "#685160"
            emphasis_3 "#395d6b"
        }
        ribbon_unselected {
            base "#1a1e28"
            background "#a6accd"
            emphasis_0 "#64314b"
            emphasis_1 "#a6accd"
            emphasis_2 "#2b4550"
            emphasis_3 "#4e3d48"
        }
        table_title {
            base "#5de4c7"
            background "#1a1e28"
            emphasis_0 "#fffac2"
            emphasis_1 "#add7ff"
            emphasis_2 "#5de4c7"
            emphasis_3 "#fcc5e9"
        }
        frame_unselected {
            base "#a6accd"
            background "#1a1e28"
            emphasis_0 "#a6accd"
            emphasis_1 "#a6accd"
            emphasis_2 "#a6accd"
            emphasis_3 "#a6accd"
        }
        frame_selected {
            base "#5de4c7"
            background "#1a1e28"
            emphasis_0 "#fffac2"
            emphasis_1 "#add7ff"
            emphasis_2 "#5de4c7"
            emphasis_3 "#fcc5e9"
        }
        frame_highlight {
            base "#fffac2"
            background "#1a1e28"
            emphasis_0 "#fcc5e9"
            emphasis_1 "#fffac2"
            emphasis_2 "#fffac2"
            emphasis_3 "#fffac2"
        }
        exit_code_success {
            base "#5de4c7"
            background "#1a1e28"
            emphasis_0 "#add7ff"
            emphasis_1 "#a6accd"
            emphasis_2 "#fcc5e9"
            emphasis_3 "#89ddff"
        }
        exit_code_error {
            base "#d0679d"
            background "#1a1e28"
            emphasis_0 "#fffac2"
            emphasis_1 "#a6accd"
            emphasis_2 "#fcc5e9"
            emphasis_3 "#89ddff"
        }
        multiplayer_user_colors {
            player_1 "#fcc5e9"
            player_2 "#89ddff"
            player_3 "#fae4fc"
            player_4 "#fffac2"
            player_5 "#add7ff"
            player_6 "#fffac2"
            player_7 "#d0679d"
            player_8 "#ffffff"
            player_9 "#d0679d"
            player_10 "#add7ff"
        }
    }
}
