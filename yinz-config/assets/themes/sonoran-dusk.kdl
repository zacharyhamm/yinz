themes {
    "sonoran-dusk" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Sonoran%20Dusk
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#0e0318"
        terminal {
            foreground "#e8e1d9"
            background "#1a0f24"
            black "#2d2433"
            red "#e76f51"
            green "#8abf7f"
            yellow "#e9c46a"
            blue "#5dade2"
            magenta "#c678dd"
            cyan "#2dd4bf"
            white "#e8e2d1"
            bright_black "#6b7280"
            bright_red "#ff8a65"
            bright_green "#a6e3a1"
            bright_yellow "#ffd166"
            bright_blue "#7ec8f8"
            bright_magenta "#d48cff"
            bright_cyan "#52e6d6"
            bright_white "#fff1d6"
        }
        text_unselected {
            base "#e8e1d9"
            background "#1a0f24"
            emphasis_0 "#e9c46a"
            emphasis_1 "#2dd4bf"
            emphasis_2 "#8abf7f"
            emphasis_3 "#c678dd"
        }
        text_selected {
            base "#1a0f24"
            background "#e8e1d9"
            emphasis_0 "#756235"
            emphasis_1 "#187166"
            emphasis_2 "#4e6c48"
            emphasis_3 "#855193"
        }
        table_cell_unselected {
            base "#e8e1d9"
            background "#1a0f24"
            emphasis_0 "#e9c46a"
            emphasis_1 "#2dd4bf"
            emphasis_2 "#8abf7f"
            emphasis_3 "#c678dd"
        }
        table_cell_selected {
            base "#e8e1d9"
            background "#3a2a45"
            emphasis_0 "#e9c46a"
            emphasis_1 "#2dd4bf"
            emphasis_2 "#8abf7f"
            emphasis_3 "#c77add"
        }
        list_unselected {
            base "#e8e1d9"
            background "#1a0f24"
            emphasis_0 "#e9c46a"
            emphasis_1 "#2dd4bf"
            emphasis_2 "#8abf7f"
            emphasis_3 "#c678dd"
        }
        list_selected {
            base "#e8e1d9"
            background "#3a2a45"
            emphasis_0 "#e9c46a"
            emphasis_1 "#2dd4bf"
            emphasis_2 "#8abf7f"
            emphasis_3 "#c77add"
        }
        ribbon_selected {
            base "#1a0f24"
            background "#8abf7f"
            emphasis_0 "#6d3426"
            emphasis_1 "#4f4324"
            emphasis_2 "#5b3765"
            emphasis_3 "#27485e"
        }
        ribbon_unselected {
            base "#1a0f24"
            background "#e8e1d9"
            emphasis_0 "#9f4d38"
            emphasis_1 "#e8e1d9"
            emphasis_2 "#396989"
            emphasis_3 "#855094"
        }
        table_title {
            base "#8abf7f"
            background "#1a0f24"
            emphasis_0 "#e9c46a"
            emphasis_1 "#2dd4bf"
            emphasis_2 "#8abf7f"
            emphasis_3 "#c678dd"
        }
        frame_unselected {
            base "#e8e1d9"
            background "#1a0f24"
            emphasis_0 "#e8e1d9"
            emphasis_1 "#e8e1d9"
            emphasis_2 "#e8e1d9"
            emphasis_3 "#e8e1d9"
        }
        frame_selected {
            base "#8abf7f"
            background "#1a0f24"
            emphasis_0 "#e9c46a"
            emphasis_1 "#2dd4bf"
            emphasis_2 "#8abf7f"
            emphasis_3 "#c678dd"
        }
        frame_highlight {
            base "#e9c46a"
            background "#1a0f24"
            emphasis_0 "#c678dd"
            emphasis_1 "#e9c46a"
            emphasis_2 "#e9c46a"
            emphasis_3 "#e9c46a"
        }
        exit_code_success {
            base "#8abf7f"
            background "#1a0f24"
            emphasis_0 "#2dd4bf"
            emphasis_1 "#e8e1d9"
            emphasis_2 "#c678dd"
            emphasis_3 "#5dade2"
        }
        exit_code_error {
            base "#e76f51"
            background "#1a0f24"
            emphasis_0 "#e9c46a"
            emphasis_1 "#e8e1d9"
            emphasis_2 "#c678dd"
            emphasis_3 "#5dade2"
        }
        multiplayer_user_colors {
            player_1 "#c678dd"
            player_2 "#5dade2"
            player_3 "#d48cff"
            player_4 "#e9c46a"
            player_5 "#2dd4bf"
            player_6 "#ffd166"
            player_7 "#e76f51"
            player_8 "#e8e2d1"
            player_9 "#ff8a65"
            player_10 "#7ec8f8"
        }
    }
}
