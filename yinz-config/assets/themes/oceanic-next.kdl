themes {
    "oceanic-next" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Oceanic%20Next
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#0a2029"
        terminal {
            foreground "#c0c5ce"
            background "#162c35"
            black "#162c35"
            red "#ec5f67"
            green "#99c794"
            yellow "#fac863"
            blue "#6699cc"
            magenta "#c594c5"
            cyan "#5fb3b3"
            white "#ffffff"
            bright_black "#65737e"
            bright_red "#ec5f67"
            bright_green "#99c794"
            bright_yellow "#fac863"
            bright_blue "#6699cc"
            bright_magenta "#c594c5"
            bright_cyan "#5fb3b3"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#c0c5ce"
            background "#162c35"
            emphasis_0 "#fac863"
            emphasis_1 "#5fb3b3"
            emphasis_2 "#99c794"
            emphasis_3 "#c594c5"
        }
        text_selected {
            base "#162c35"
            background "#c0c5ce"
            emphasis_0 "#624f28"
            emphasis_1 "#445555"
            emphasis_2 "#495547"
            emphasis_3 "#594f59"
        }
        table_cell_unselected {
            base "#c0c5ce"
            background "#162c35"
            emphasis_0 "#fac863"
            emphasis_1 "#5fb3b3"
            emphasis_2 "#99c794"
            emphasis_3 "#c594c5"
        }
        table_cell_selected {
            base "#cdd1d8"
            background "#4f5b66"
            emphasis_0 "#fac965"
            emphasis_1 "#aed9d9"
            emphasis_2 "#b9d9b6"
            emphasis_3 "#e2c9e2"
        }
        list_unselected {
            base "#c0c5ce"
            background "#162c35"
            emphasis_0 "#fac863"
            emphasis_1 "#5fb3b3"
            emphasis_2 "#99c794"
            emphasis_3 "#c594c5"
        }
        list_selected {
            base "#cdd1d8"
            background "#4f5b66"
            emphasis_0 "#fac965"
            emphasis_1 "#aed9d9"
            emphasis_2 "#b9d9b6"
            emphasis_3 "#e2c9e2"
        }
        ribbon_selected {
            base "#162c35"
            background "#99c794"
            emphasis_0 "#7f3337"
            emphasis_1 "#5b4924"
            emphasis_2 "#5b445b"
            emphasis_3 "#344d67"
        }
        ribbon_unselected {
            base "#162c35"
            background "#c0c5ce"
            emphasis_0 "#89373c"
            emphasis_1 "#c0c5ce"
            emphasis_2 "#385470"
            emphasis_3 "#634a63"
        }
        table_title {
            base "#99c794"
            background "#162c35"
            emphasis_0 "#fac863"
            emphasis_1 "#5fb3b3"
            emphasis_2 "#99c794"
            emphasis_3 "#c594c5"
        }
        frame_unselected {
            base "#c0c5ce"
            background "#162c35"
            emphasis_0 "#c0c5ce"
            emphasis_1 "#c0c5ce"
            emphasis_2 "#c0c5ce"
            emphasis_3 "#c0c5ce"
        }
        frame_selected {
            base "#99c794"
            background "#162c35"
            emphasis_0 "#fac863"
            emphasis_1 "#5fb3b3"
            emphasis_2 "#99c794"
            emphasis_3 "#c594c5"
        }
        frame_highlight {
            base "#fac863"
            background "#162c35"
            emphasis_0 "#c594c5"
            emphasis_1 "#fac863"
            emphasis_2 "#fac863"
            emphasis_3 "#fac863"
        }
        exit_code_success {
            base "#99c794"
            background "#162c35"
            emphasis_0 "#5fb3b3"
            emphasis_1 "#c0c5ce"
            emphasis_2 "#c594c5"
            emphasis_3 "#6699cc"
        }
        exit_code_error {
            base "#ec6269"
            background "#162c35"
            emphasis_0 "#fac863"
            emphasis_1 "#c0c5ce"
            emphasis_2 "#c594c5"
            emphasis_3 "#6699cc"
        }
        multiplayer_user_colors {
            player_1 "#c594c5"
            player_2 "#6699cc"
            player_3 "#c594c5"
            player_4 "#fac863"
            player_5 "#5fb3b3"
            player_6 "#fac863"
            player_7 "#ec6269"
            player_8 "#ffffff"
            player_9 "#ec6269"
            player_10 "#6699cc"
        }
    }
}
