themes {
    "desert-rose" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Desert%20Rose
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#4e1426"
        terminal {
            foreground "#fff0df"
            background "#5a2032"
            black "#c9b9b8"
            red "#ff978b"
            green "#94d1a1"
            yellow "#edc96d"
            blue "#8fc4e8"
            magenta "#dfa2c9"
            cyan "#82d7d2"
            white "#fff0df"
            bright_black "#dacbca"
            bright_red "#ffaea3"
            bright_green "#a9dcaf"
            bright_yellow "#f8d98b"
            bright_blue "#acd4ef"
            bright_magenta "#e9bad7"
            bright_cyan "#a2e4df"
            bright_white "#fffaf2"
        }
        text_unselected {
            base "#fff0df"
            background "#5a2032"
            emphasis_0 "#edc96d"
            emphasis_1 "#82d7d2"
            emphasis_2 "#94d1a1"
            emphasis_3 "#dfa2c9"
        }
        text_selected {
            base "#5a2032"
            background "#fff0df"
            emphasis_0 "#806d3b"
            emphasis_1 "#487774"
            emphasis_2 "#56765c"
            emphasis_3 "#816777"
        }
        table_cell_unselected {
            base "#fff0df"
            background "#5a2032"
            emphasis_0 "#edc96d"
            emphasis_1 "#82d7d2"
            emphasis_2 "#94d1a1"
            emphasis_3 "#dfa2c9"
        }
        table_cell_selected {
            base "#fff7ed"
            background "#7d4050"
            emphasis_0 "#edc96d"
            emphasis_1 "#82d7d2"
            emphasis_2 "#9ad4a6"
            emphasis_3 "#e7b9d6"
        }
        list_unselected {
            base "#fff0df"
            background "#5a2032"
            emphasis_0 "#edc96d"
            emphasis_1 "#82d7d2"
            emphasis_2 "#94d1a1"
            emphasis_3 "#dfa2c9"
        }
        list_selected {
            base "#fff7ed"
            background "#7d4050"
            emphasis_0 "#edc96d"
            emphasis_1 "#82d7d2"
            emphasis_2 "#9ad4a6"
            emphasis_3 "#e7b9d6"
        }
        ribbon_selected {
            base "#5a2032"
            background "#94d1a1"
            emphasis_0 "#73443f"
            emphasis_1 "#5d4f2b"
            emphasis_2 "#64485a"
            emphasis_3 "#3d5362"
        }
        ribbon_unselected {
            base "#5a2032"
            background "#fff0df"
            emphasis_0 "#9d5d56"
            emphasis_1 "#fff0df"
            emphasis_2 "#537287"
            emphasis_3 "#88637b"
        }
        table_title {
            base "#94d1a1"
            background "#5a2032"
            emphasis_0 "#edc96d"
            emphasis_1 "#82d7d2"
            emphasis_2 "#94d1a1"
            emphasis_3 "#dfa2c9"
        }
        frame_unselected {
            base "#fff0df"
            background "#5a2032"
            emphasis_0 "#fff0df"
            emphasis_1 "#fff0df"
            emphasis_2 "#fff0df"
            emphasis_3 "#fff0df"
        }
        frame_selected {
            base "#94d1a1"
            background "#5a2032"
            emphasis_0 "#edc96d"
            emphasis_1 "#82d7d2"
            emphasis_2 "#94d1a1"
            emphasis_3 "#dfa2c9"
        }
        frame_highlight {
            base "#edc96d"
            background "#5a2032"
            emphasis_0 "#dfa2c9"
            emphasis_1 "#edc96d"
            emphasis_2 "#edc96d"
            emphasis_3 "#edc96d"
        }
        exit_code_success {
            base "#94d1a1"
            background "#5a2032"
            emphasis_0 "#82d7d2"
            emphasis_1 "#fff0df"
            emphasis_2 "#dfa2c9"
            emphasis_3 "#8fc4e8"
        }
        exit_code_error {
            base "#ff978b"
            background "#5a2032"
            emphasis_0 "#edc96d"
            emphasis_1 "#fff0df"
            emphasis_2 "#dfa2c9"
            emphasis_3 "#8fc4e8"
        }
        multiplayer_user_colors {
            player_1 "#dfa2c9"
            player_2 "#8fc4e8"
            player_3 "#e9bad7"
            player_4 "#edc96d"
            player_5 "#82d7d2"
            player_6 "#f8d98b"
            player_7 "#ff978b"
            player_8 "#fff0df"
            player_9 "#ffaea3"
            player_10 "#acd4ef"
        }
    }
}
