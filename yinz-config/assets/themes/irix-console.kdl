themes {
    "irix-console" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/IRIX%20Console
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000000"
        terminal {
            foreground "#f2f2f2"
            background "#0c0c0c"
            black "#1a1919"
            red "#d42426"
            green "#37a327"
            yellow "#c29d28"
            blue "#0739e2"
            magenta "#911f9c"
            cyan "#4497df"
            white "#cccccc"
            bright_black "#767676"
            bright_red "#f34f59"
            bright_green "#45c731"
            bright_yellow "#f9f2a7"
            bright_blue "#4079ff"
            bright_magenta "#c31ba2"
            bright_cyan "#6ed7d7"
            bright_white "#f2f2f2"
        }
        text_unselected {
            base "#f2f2f2"
            background "#0c0c0c"
            emphasis_0 "#c29d28"
            emphasis_1 "#4497df"
            emphasis_2 "#37a327"
            emphasis_3 "#ad58b5"
        }
        text_selected {
            base "#000000"
            background "#c2deff"
            emphasis_0 "#745e18"
            emphasis_1 "#2d6494"
            emphasis_2 "#266f1b"
            emphasis_3 "#911f9c"
        }
        table_cell_unselected {
            base "#f2f2f2"
            background "#0c0c0c"
            emphasis_0 "#c29d28"
            emphasis_1 "#4497df"
            emphasis_2 "#37a327"
            emphasis_3 "#ad58b5"
        }
        table_cell_selected {
            base "#000000"
            background "#c2deff"
            emphasis_0 "#745e18"
            emphasis_1 "#2d6494"
            emphasis_2 "#266f1b"
            emphasis_3 "#911f9c"
        }
        list_unselected {
            base "#f2f2f2"
            background "#0c0c0c"
            emphasis_0 "#c29d28"
            emphasis_1 "#4497df"
            emphasis_2 "#37a327"
            emphasis_3 "#ad58b5"
        }
        list_selected {
            base "#000000"
            background "#c2deff"
            emphasis_0 "#745e18"
            emphasis_1 "#2d6494"
            emphasis_2 "#266f1b"
            emphasis_3 "#911f9c"
        }
        ribbon_selected {
            base "#0c0c0c"
            background "#37a327"
            emphasis_0 "#520e0f"
            emphasis_1 "#31270a"
            emphasis_2 "#450f4b"
            emphasis_3 "#041d73"
        }
        ribbon_unselected {
            base "#0c0c0c"
            background "#f2f2f2"
            emphasis_0 "#d42426"
            emphasis_1 "#f2f2f2"
            emphasis_2 "#0739e2"
            emphasis_3 "#911f9c"
        }
        table_title {
            base "#37a327"
            background "#0c0c0c"
            emphasis_0 "#c29d28"
            emphasis_1 "#4497df"
            emphasis_2 "#37a327"
            emphasis_3 "#ad58b5"
        }
        frame_unselected {
            base "#f2f2f2"
            background "#0c0c0c"
            emphasis_0 "#f2f2f2"
            emphasis_1 "#f2f2f2"
            emphasis_2 "#f2f2f2"
            emphasis_3 "#f2f2f2"
        }
        frame_selected {
            base "#37a327"
            background "#0c0c0c"
            emphasis_0 "#c29d28"
            emphasis_1 "#4497df"
            emphasis_2 "#37a327"
            emphasis_3 "#ad58b5"
        }
        frame_highlight {
            base "#c29d28"
            background "#0c0c0c"
            emphasis_0 "#ad58b5"
            emphasis_1 "#c29d28"
            emphasis_2 "#c29d28"
            emphasis_3 "#c29d28"
        }
        exit_code_success {
            base "#37a327"
            background "#0c0c0c"
            emphasis_0 "#4497df"
            emphasis_1 "#f2f2f2"
            emphasis_2 "#ad58b5"
            emphasis_3 "#4d71ea"
        }
        exit_code_error {
            base "#da4244"
            background "#0c0c0c"
            emphasis_0 "#c29d28"
            emphasis_1 "#f2f2f2"
            emphasis_2 "#ad58b5"
            emphasis_3 "#4d71ea"
        }
        multiplayer_user_colors {
            player_1 "#ad58b5"
            player_2 "#4d71ea"
            player_3 "#cc3caf"
            player_4 "#c29d28"
            player_5 "#4497df"
            player_6 "#f9f2a7"
            player_7 "#da4244"
            player_8 "#cccccc"
            player_9 "#f34f59"
            player_10 "#4079ff"
        }
    }
}
