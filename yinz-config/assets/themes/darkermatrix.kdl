themes {
    "darkermatrix" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Darkermatrix
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000002"
        terminal {
            foreground "#35451a"
            background "#070c0e"
            black "#091013"
            red "#1a4831"
            green "#6fa64c"
            yellow "#595900"
            blue "#00cb6b"
            magenta "#4e375a"
            cyan "#125459"
            white "#1a4833"
            bright_black "#404040"
            bright_red "#0d452a"
            bright_green "#90d762"
            bright_yellow "#e2e500"
            bright_blue "#00ff87"
            bright_magenta "#4e375a"
            bright_cyan "#176c73"
            bright_white "#00381e"
        }
        text_unselected {
            base "#727d5f"
            background "#070c0e"
            emphasis_0 "#7d7d37"
            emphasis_1 "#508185"
            emphasis_2 "#6fa64c"
            emphasis_3 "#84748c"
        }
        text_selected {
            base "#070c0e"
            background "#727d5f"
            emphasis_0 "#0b0b06"
            emphasis_1 "#080c0d"
            emphasis_2 "#080c06"
            emphasis_3 "#0c0b0d"
        }
        table_cell_unselected {
            base "#727d5f"
            background "#070c0e"
            emphasis_0 "#7d7d37"
            emphasis_1 "#508185"
            emphasis_2 "#6fa64c"
            emphasis_3 "#84748c"
        }
        table_cell_selected {
            base "#00ff87"
            background "#0f191c"
            emphasis_0 "#848442"
            emphasis_1 "#5a888b"
            emphasis_2 "#6fa64c"
            emphasis_3 "#8a7b92"
        }
        list_unselected {
            base "#727d5f"
            background "#070c0e"
            emphasis_0 "#7d7d37"
            emphasis_1 "#508185"
            emphasis_2 "#6fa64c"
            emphasis_3 "#84748c"
        }
        list_selected {
            base "#00ff87"
            background "#0f191c"
            emphasis_0 "#848442"
            emphasis_1 "#5a888b"
            emphasis_2 "#6fa64c"
            emphasis_3 "#8a7b92"
        }
        ribbon_selected {
            base "#070c0e"
            background "#6fa64c"
            emphasis_0 "#143726"
            emphasis_1 "#323200"
            emphasis_2 "#3b2a44"
            emphasis_3 "#00391e"
        }
        ribbon_unselected {
            base "#070c0e"
            background "#727d5f"
            emphasis_0 "#050d09"
            emphasis_1 "#727d5f"
            emphasis_2 "#000e08"
            emphasis_3 "#0e0a10"
        }
        table_title {
            base "#6fa64c"
            background "#070c0e"
            emphasis_0 "#7d7d37"
            emphasis_1 "#508185"
            emphasis_2 "#6fa64c"
            emphasis_3 "#84748c"
        }
        frame_unselected {
            base "#727d5f"
            background "#070c0e"
            emphasis_0 "#727d5f"
            emphasis_1 "#727d5f"
            emphasis_2 "#727d5f"
            emphasis_3 "#727d5f"
        }
        frame_selected {
            base "#6fa64c"
            background "#070c0e"
            emphasis_0 "#7d7d37"
            emphasis_1 "#508185"
            emphasis_2 "#6fa64c"
            emphasis_3 "#84748c"
        }
        frame_highlight {
            base "#7d7d37"
            background "#070c0e"
            emphasis_0 "#84748c"
            emphasis_1 "#7d7d37"
            emphasis_2 "#7d7d37"
            emphasis_3 "#7d7d37"
        }
        exit_code_success {
            base "#6fa64c"
            background "#070c0e"
            emphasis_0 "#508185"
            emphasis_1 "#727d5f"
            emphasis_2 "#84748c"
            emphasis_3 "#00cb6b"
        }
        exit_code_error {
            base "#608070"
            background "#070c0e"
            emphasis_0 "#7d7d37"
            emphasis_1 "#727d5f"
            emphasis_2 "#84748c"
            emphasis_3 "#00cb6b"
        }
        multiplayer_user_colors {
            player_1 "#84748c"
            player_2 "#00cb6b"
            player_3 "#84748c"
            player_4 "#7d7d37"
            player_5 "#508185"
            player_6 "#e2e500"
            player_7 "#608070"
            player_8 "#608071"
            player_9 "#5b816e"
            player_10 "#00ff87"
        }
    }
}
