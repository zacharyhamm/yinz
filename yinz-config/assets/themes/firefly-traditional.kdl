themes {
    "firefly-traditional" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Firefly%20Traditional
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000000"
        terminal {
            foreground "#f5f5f5"
            background "#000000"
            black "#000000"
            red "#c23720"
            green "#33bc26"
            yellow "#afad24"
            blue "#5a63ff"
            magenta "#d53ad2"
            cyan "#33bbc7"
            white "#cccccc"
            bright_black "#828282"
            bright_red "#ff3b1e"
            bright_green "#2ee720"
            bright_yellow "#ecec16"
            bright_blue "#838dff"
            bright_magenta "#ff5cfe"
            bright_cyan "#29f0f0"
            bright_white "#ebebeb"
        }
        text_unselected {
            base "#f5f5f5"
            background "#000000"
            emphasis_0 "#afad24"
            emphasis_1 "#33bbc7"
            emphasis_2 "#33bc26"
            emphasis_3 "#d53ad2"
        }
        text_selected {
            base "#000000"
            background "#cfeac6"
            emphasis_0 "#6a6816"
            emphasis_1 "#1e6f77"
            emphasis_2 "#207418"
            emphasis_3 "#a82ea6"
        }
        table_cell_unselected {
            base "#f5f5f5"
            background "#000000"
            emphasis_0 "#afad24"
            emphasis_1 "#33bbc7"
            emphasis_2 "#33bc26"
            emphasis_3 "#d53ad2"
        }
        table_cell_selected {
            base "#000000"
            background "#cfeac6"
            emphasis_0 "#6a6816"
            emphasis_1 "#1e6f77"
            emphasis_2 "#207418"
            emphasis_3 "#a82ea6"
        }
        list_unselected {
            base "#f5f5f5"
            background "#000000"
            emphasis_0 "#afad24"
            emphasis_1 "#33bbc7"
            emphasis_2 "#33bc26"
            emphasis_3 "#d53ad2"
        }
        list_selected {
            base "#000000"
            background "#cfeac6"
            emphasis_0 "#6a6816"
            emphasis_1 "#1e6f77"
            emphasis_2 "#207418"
            emphasis_3 "#a82ea6"
        }
        ribbon_selected {
            base "#000000"
            background "#33bc26"
            emphasis_0 "#6d1f12"
            emphasis_1 "#3d3c0d"
            emphasis_2 "#621b60"
            emphasis_3 "#2d317f"
        }
        ribbon_unselected {
            base "#000000"
            background "#f5f5f5"
            emphasis_0 "#c23720"
            emphasis_1 "#f5f5f5"
            emphasis_2 "#555ef2"
            emphasis_3 "#bb33b8"
        }
        table_title {
            base "#33bc26"
            background "#000000"
            emphasis_0 "#afad24"
            emphasis_1 "#33bbc7"
            emphasis_2 "#33bc26"
            emphasis_3 "#d53ad2"
        }
        frame_unselected {
            base "#f5f5f5"
            background "#000000"
            emphasis_0 "#f5f5f5"
            emphasis_1 "#f5f5f5"
            emphasis_2 "#f5f5f5"
            emphasis_3 "#f5f5f5"
        }
        frame_selected {
            base "#33bc26"
            background "#000000"
            emphasis_0 "#afad24"
            emphasis_1 "#33bbc7"
            emphasis_2 "#33bc26"
            emphasis_3 "#d53ad2"
        }
        frame_highlight {
            base "#afad24"
            background "#000000"
            emphasis_0 "#d53ad2"
            emphasis_1 "#afad24"
            emphasis_2 "#afad24"
            emphasis_3 "#afad24"
        }
        exit_code_success {
            base "#33bc26"
            background "#000000"
            emphasis_0 "#33bbc7"
            emphasis_1 "#f5f5f5"
            emphasis_2 "#d53ad2"
            emphasis_3 "#5a63ff"
        }
        exit_code_error {
            base "#c84b36"
            background "#000000"
            emphasis_0 "#afad24"
            emphasis_1 "#f5f5f5"
            emphasis_2 "#d53ad2"
            emphasis_3 "#5a63ff"
        }
        multiplayer_user_colors {
            player_1 "#d53ad2"
            player_2 "#5a63ff"
            player_3 "#ff5cfe"
            player_4 "#afad24"
            player_5 "#33bbc7"
            player_6 "#ecec16"
            player_7 "#c84b36"
            player_8 "#cccccc"
            player_9 "#ff3b1e"
            player_10 "#838dff"
        }
    }
}
