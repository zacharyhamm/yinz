themes {
    "git-hub-dark-high-contrast" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/GitHub%20Dark%20High%20Contrast
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000004"
        terminal {
            foreground "#f0f3f6"
            background "#0a0c10"
            black "#7a828e"
            red "#ff9492"
            green "#26cd4d"
            yellow "#f0b72f"
            blue "#71b7ff"
            magenta "#cb9eff"
            cyan "#39c5cf"
            white "#d9dee3"
            bright_black "#9ea7b3"
            bright_red "#ffb1af"
            bright_green "#4ae168"
            bright_yellow "#f7c843"
            bright_blue "#91cbff"
            bright_magenta "#dbb7ff"
            bright_cyan "#56d4dd"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#f0f3f6"
            background "#0a0c10"
            emphasis_0 "#f0b72f"
            emphasis_1 "#39c5cf"
            emphasis_2 "#26cd4d"
            emphasis_3 "#cb9eff"
        }
        text_selected {
            base "#0a0c10"
            background "#f0f3f6"
            emphasis_0 "#8b6a1b"
            emphasis_1 "#237a80"
            emphasis_2 "#188030"
            emphasis_3 "#7f639f"
        }
        table_cell_unselected {
            base "#f0f3f6"
            background "#0a0c10"
            emphasis_0 "#f0b72f"
            emphasis_1 "#39c5cf"
            emphasis_2 "#26cd4d"
            emphasis_3 "#cb9eff"
        }
        table_cell_selected {
            base "#0a0c10"
            background "#f0f3f6"
            emphasis_0 "#8b6a1b"
            emphasis_1 "#237a80"
            emphasis_2 "#188030"
            emphasis_3 "#7f639f"
        }
        list_unselected {
            base "#f0f3f6"
            background "#0a0c10"
            emphasis_0 "#f0b72f"
            emphasis_1 "#39c5cf"
            emphasis_2 "#26cd4d"
            emphasis_3 "#cb9eff"
        }
        list_selected {
            base "#0a0c10"
            background "#f0f3f6"
            emphasis_0 "#8b6a1b"
            emphasis_1 "#237a80"
            emphasis_2 "#188030"
            emphasis_3 "#7f639f"
        }
        ribbon_selected {
            base "#0a0c10"
            background "#26cd4d"
            emphasis_0 "#633939"
            emphasis_1 "#574211"
            emphasis_2 "#4f3d63"
            emphasis_3 "#2c4763"
        }
        ribbon_unselected {
            base "#0a0c10"
            background "#f0f3f6"
            emphasis_0 "#9f5c5b"
            emphasis_1 "#f0f3f6"
            emphasis_2 "#46729f"
            emphasis_3 "#7f639f"
        }
        table_title {
            base "#26cd4d"
            background "#0a0c10"
            emphasis_0 "#f0b72f"
            emphasis_1 "#39c5cf"
            emphasis_2 "#26cd4d"
            emphasis_3 "#cb9eff"
        }
        frame_unselected {
            base "#f0f3f6"
            background "#0a0c10"
            emphasis_0 "#f0f3f6"
            emphasis_1 "#f0f3f6"
            emphasis_2 "#f0f3f6"
            emphasis_3 "#f0f3f6"
        }
        frame_selected {
            base "#26cd4d"
            background "#0a0c10"
            emphasis_0 "#f0b72f"
            emphasis_1 "#39c5cf"
            emphasis_2 "#26cd4d"
            emphasis_3 "#cb9eff"
        }
        frame_highlight {
            base "#f0b72f"
            background "#0a0c10"
            emphasis_0 "#cb9eff"
            emphasis_1 "#f0b72f"
            emphasis_2 "#f0b72f"
            emphasis_3 "#f0b72f"
        }
        exit_code_success {
            base "#26cd4d"
            background "#0a0c10"
            emphasis_0 "#39c5cf"
            emphasis_1 "#f0f3f6"
            emphasis_2 "#cb9eff"
            emphasis_3 "#71b7ff"
        }
        exit_code_error {
            base "#ff9492"
            background "#0a0c10"
            emphasis_0 "#f0b72f"
            emphasis_1 "#f0f3f6"
            emphasis_2 "#cb9eff"
            emphasis_3 "#71b7ff"
        }
        multiplayer_user_colors {
            player_1 "#cb9eff"
            player_2 "#71b7ff"
            player_3 "#dbb7ff"
            player_4 "#f0b72f"
            player_5 "#39c5cf"
            player_6 "#f7c843"
            player_7 "#ff9492"
            player_8 "#d9dee3"
            player_9 "#ffb1af"
            player_10 "#91cbff"
        }
    }
}
