themes {
    "git-hub-dark-default" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/GitHub%20Dark%20Default
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#01050b"
        terminal {
            foreground "#e6edf3"
            background "#0d1117"
            black "#484f58"
            red "#ff7b72"
            green "#3fb950"
            yellow "#d29922"
            blue "#58a6ff"
            magenta "#bc8cff"
            cyan "#39c5cf"
            white "#b1bac4"
            bright_black "#6e7681"
            bright_red "#ffa198"
            bright_green "#56d364"
            bright_yellow "#e3b341"
            bright_blue "#79c0ff"
            bright_magenta "#d2a8ff"
            bright_cyan "#56d4dd"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#e6edf3"
            background "#0d1117"
            emphasis_0 "#d29922"
            emphasis_1 "#39c5cf"
            emphasis_2 "#3fb950"
            emphasis_3 "#bc8cff"
        }
        text_selected {
            base "#0d1117"
            background "#e6edf3"
            emphasis_0 "#8a6416"
            emphasis_1 "#22757b"
            emphasis_2 "#2a7a35"
            emphasis_3 "#7b5ca7"
        }
        table_cell_unselected {
            base "#e6edf3"
            background "#0d1117"
            emphasis_0 "#d29922"
            emphasis_1 "#39c5cf"
            emphasis_2 "#3fb950"
            emphasis_3 "#bc8cff"
        }
        table_cell_selected {
            base "#0d1117"
            background "#e6edf3"
            emphasis_0 "#8a6416"
            emphasis_1 "#22757b"
            emphasis_2 "#2a7a35"
            emphasis_3 "#7b5ca7"
        }
        list_unselected {
            base "#e6edf3"
            background "#0d1117"
            emphasis_0 "#d29922"
            emphasis_1 "#39c5cf"
            emphasis_2 "#3fb950"
            emphasis_3 "#bc8cff"
        }
        list_selected {
            base "#0d1117"
            background "#e6edf3"
            emphasis_0 "#8a6416"
            emphasis_1 "#22757b"
            emphasis_2 "#2a7a35"
            emphasis_3 "#7b5ca7"
        }
        ribbon_selected {
            base "#0d1117"
            background "#3fb950"
            emphasis_0 "#5a2b28"
            emphasis_1 "#4a360c"
            emphasis_2 "#42315a"
            emphasis_3 "#1f3b5b"
        }
        ribbon_unselected {
            base "#0d1117"
            background "#e6edf3"
            emphasis_0 "#a8514b"
            emphasis_1 "#e6edf3"
            emphasis_2 "#3a6da8"
            emphasis_3 "#7b5ca7"
        }
        table_title {
            base "#3fb950"
            background "#0d1117"
            emphasis_0 "#d29922"
            emphasis_1 "#39c5cf"
            emphasis_2 "#3fb950"
            emphasis_3 "#bc8cff"
        }
        frame_unselected {
            base "#e6edf3"
            background "#0d1117"
            emphasis_0 "#e6edf3"
            emphasis_1 "#e6edf3"
            emphasis_2 "#e6edf3"
            emphasis_3 "#e6edf3"
        }
        frame_selected {
            base "#3fb950"
            background "#0d1117"
            emphasis_0 "#d29922"
            emphasis_1 "#39c5cf"
            emphasis_2 "#3fb950"
            emphasis_3 "#bc8cff"
        }
        frame_highlight {
            base "#d29922"
            background "#0d1117"
            emphasis_0 "#bc8cff"
            emphasis_1 "#d29922"
            emphasis_2 "#d29922"
            emphasis_3 "#d29922"
        }
        exit_code_success {
            base "#3fb950"
            background "#0d1117"
            emphasis_0 "#39c5cf"
            emphasis_1 "#e6edf3"
            emphasis_2 "#bc8cff"
            emphasis_3 "#58a6ff"
        }
        exit_code_error {
            base "#ff7b72"
            background "#0d1117"
            emphasis_0 "#d29922"
            emphasis_1 "#e6edf3"
            emphasis_2 "#bc8cff"
            emphasis_3 "#58a6ff"
        }
        multiplayer_user_colors {
            player_1 "#bc8cff"
            player_2 "#58a6ff"
            player_3 "#d2a8ff"
            player_4 "#d29922"
            player_5 "#39c5cf"
            player_6 "#e3b341"
            player_7 "#ff7b72"
            player_8 "#b1bac4"
            player_9 "#ffa198"
            player_10 "#79c0ff"
        }
    }
}
