themes {
    pencil-light {
        // Terminal palette: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/master/ghostty/Pencil%20Light
        pane_surround "#e5e5e5"
        terminal {
            foreground "#424242"
            background "#f1f1f1"
            black "#212121"
            red "#c30771"
            green "#10a778"
            yellow "#a89c14"
            blue "#008ec4"
            magenta "#523c79"
            cyan "#20a5ba"
            white "#b3b3b3"
            bright_black "#424242"
            bright_red "#fb007a"
            bright_green "#52caa2"
            bright_yellow "#c0b100"
            bright_blue "#20bbfc"
            bright_magenta "#6855de"
            bright_cyan "#4fb8cc"
            bright_white "#f1f1f1"
        }
        text_unselected {
            base 66 66 66
            background 241 241 241
            emphasis_0 178 79 79
            emphasis_1 23 121 136
            emphasis_2 12 125 90
            emphasis_3 0 118 163
        }
        text_selected {
            base 241 241 241
            background 66 66 66
            emphasis_0 "#d0a3a3"
            emphasis_1 "#8ab6bd"
            emphasis_2 "#85b8a8"
            emphasis_3 "#81b6ca"
        }
        ribbon_selected {
            base 44 44 44
            background 16 167 120
            emphasis_0 39 45 54
            emphasis_1 73 32 32
            emphasis_2 39 45 54
            emphasis_3 0 48 67
        }
        ribbon_unselected {
            base 241 241 241
            background 0 95 135
            emphasis_0 182 214 253
            emphasis_1 66 66 66
            emphasis_2 164 215 234
            emphasis_3 182 214 253
        }
        table_title {
            base 12 125 90
            background 241 241 241
            emphasis_0 178 79 79
            emphasis_1 23 121 136
            emphasis_2 12 125 90
            emphasis_3 94 111 131
        }
        table_cell_selected {
            base 66 66 66
            background 224 224 224
            emphasis_0 161 71 71
            emphasis_1 21 109 123
            emphasis_2 11 113 81
            emphasis_3 86 101 119
        }
        table_cell_unselected {
            base 66 66 66
            background 241 241 241
            emphasis_0 178 79 79
            emphasis_1 23 121 136
            emphasis_2 12 125 90
            emphasis_3 94 111 131
        }
        list_selected {
            base 66 66 66
            background 224 224 224
            emphasis_0 161 71 71
            emphasis_1 21 109 123
            emphasis_2 11 113 81
            emphasis_3 86 101 119
        }
        list_unselected {
            base 66 66 66
            background 241 241 241
            emphasis_0 178 79 79
            emphasis_1 23 121 136
            emphasis_2 12 125 90
            emphasis_3 94 111 131
        }
        frame_selected {
            base 12 125 90
            background 0
            emphasis_0 178 79 79
            emphasis_1 23 121 136
            emphasis_2 94 111 131
            emphasis_3 0
        }
        frame_highlight {
            base 178 79 79
            background 0
            emphasis_0 0 118 163
            emphasis_1 178 79 79
            emphasis_2 178 79 79
            emphasis_3 178 79 79
        }
        exit_code_success {
            base 12 125 90
            background 0
            emphasis_0 23 121 136
            emphasis_1 110 110 110
            emphasis_2 94 111 131
            emphasis_3 0 118 163
        }
        exit_code_error {
            base 94 111 131
            background 0
            emphasis_0 120 111 14
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 94 111 131
            player_2 0 118 163
            player_3 66 66 66
            player_4 120 111 14
            player_5 23 121 136
            player_6 66 66 66
            player_7 94 111 131
            player_8 66 66 66
            player_9 66 66 66
            player_10 66 66 66
        }
    }
}
