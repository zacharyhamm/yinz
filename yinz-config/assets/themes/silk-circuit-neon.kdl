themes {
    "silk-circuit-neon" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/SilkCircuit%20Neon
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#06040e"
        terminal {
            foreground "#f8f8f2"
            background "#12101a"
            black "#12101a"
            red "#ff6363"
            green "#50fa7b"
            yellow "#f1fa8c"
            blue "#82aaff"
            magenta "#ff00ff"
            cyan "#80ffea"
            white "#f8f8f2"
            bright_black "#768d8d"
            bright_red "#ff8787"
            bright_green "#86fba8"
            bright_yellow "#ffffa5"
            bright_blue "#82b1ff"
            bright_magenta "#ff69ff"
            bright_cyan "#5fffff"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#f8f8f2"
            background "#12101a"
            emphasis_0 "#f1fa8c"
            emphasis_1 "#80ffea"
            emphasis_2 "#50fa7b"
            emphasis_3 "#ff00ff"
        }
        text_selected {
            base "#12101a"
            background "#f8f8f2"
            emphasis_0 "#717642"
            emphasis_1 "#3e7c72"
            emphasis_2 "#2a8240"
            emphasis_3 "#a057a0"
        }
        table_cell_unselected {
            base "#f8f8f2"
            background "#12101a"
            emphasis_0 "#f1fa8c"
            emphasis_1 "#80ffea"
            emphasis_2 "#50fa7b"
            emphasis_3 "#ff00ff"
        }
        table_cell_selected {
            base "#f8f8f2"
            background "#44475a"
            emphasis_0 "#f1fa8c"
            emphasis_1 "#80ffea"
            emphasis_2 "#50fa7b"
            emphasis_3 "#ff8aff"
        }
        list_unselected {
            base "#f8f8f2"
            background "#12101a"
            emphasis_0 "#f1fa8c"
            emphasis_1 "#80ffea"
            emphasis_2 "#50fa7b"
            emphasis_3 "#ff00ff"
        }
        list_selected {
            base "#f8f8f2"
            background "#44475a"
            emphasis_0 "#f1fa8c"
            emphasis_1 "#80ffea"
            emphasis_2 "#50fa7b"
            emphasis_3 "#ff8aff"
        }
        ribbon_selected {
            base "#12101a"
            background "#50fa7b"
            emphasis_0 "#a44040"
            emphasis_1 "#606438"
            emphasis_2 "#ad00ad"
            emphasis_3 "#496090"
        }
        ribbon_unselected {
            base "#12101a"
            background "#f8f8f2"
            emphasis_0 "#c14b4b"
            emphasis_1 "#f8f8f2"
            emphasis_2 "#5771aa"
            emphasis_3 "#ca00ca"
        }
        table_title {
            base "#50fa7b"
            background "#12101a"
            emphasis_0 "#f1fa8c"
            emphasis_1 "#80ffea"
            emphasis_2 "#50fa7b"
            emphasis_3 "#ff00ff"
        }
        frame_unselected {
            base "#f8f8f2"
            background "#12101a"
            emphasis_0 "#f8f8f2"
            emphasis_1 "#f8f8f2"
            emphasis_2 "#f8f8f2"
            emphasis_3 "#f8f8f2"
        }
        frame_selected {
            base "#50fa7b"
            background "#12101a"
            emphasis_0 "#f1fa8c"
            emphasis_1 "#80ffea"
            emphasis_2 "#50fa7b"
            emphasis_3 "#ff00ff"
        }
        frame_highlight {
            base "#f1fa8c"
            background "#12101a"
            emphasis_0 "#ff00ff"
            emphasis_1 "#f1fa8c"
            emphasis_2 "#f1fa8c"
            emphasis_3 "#f1fa8c"
        }
        exit_code_success {
            base "#50fa7b"
            background "#12101a"
            emphasis_0 "#80ffea"
            emphasis_1 "#f8f8f2"
            emphasis_2 "#ff00ff"
            emphasis_3 "#82aaff"
        }
        exit_code_error {
            base "#ff6363"
            background "#12101a"
            emphasis_0 "#f1fa8c"
            emphasis_1 "#f8f8f2"
            emphasis_2 "#ff00ff"
            emphasis_3 "#82aaff"
        }
        multiplayer_user_colors {
            player_1 "#ff00ff"
            player_2 "#82aaff"
            player_3 "#ff69ff"
            player_4 "#f1fa8c"
            player_5 "#80ffea"
            player_6 "#ffffa5"
            player_7 "#ff6363"
            player_8 "#f8f8f2"
            player_9 "#ff8787"
            player_10 "#82b1ff"
        }
    }
}
