themes {
    "charcoal" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Charcoal
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#010101"
        terminal {
            foreground "#c4c4c4"
            background "#0d0d0d"
            black "#111111"
            red "#888888"
            green "#a8a8a8"
            yellow "#b0b0b0"
            blue "#9a9a9a"
            magenta "#8a8a8a"
            cyan "#a0a0a0"
            white "#c0c0c0"
            bright_black "#474747"
            bright_red "#a0a0a0"
            bright_green "#c4c4c4"
            bright_yellow "#c8c8c8"
            bright_blue "#d0d0d0"
            bright_magenta "#b8b8b8"
            bright_cyan "#cccccc"
            bright_white "#ececec"
        }
        text_unselected {
            base "#c4c4c4"
            background "#0d0d0d"
            emphasis_0 "#b0b0b0"
            emphasis_1 "#a0a0a0"
            emphasis_2 "#a8a8a8"
            emphasis_3 "#8a8a8a"
        }
        text_selected {
            base "#0d0d0d"
            background "#c4c4c4"
            emphasis_0 "#515151"
            emphasis_1 "#515151"
            emphasis_2 "#515151"
            emphasis_3 "#515151"
        }
        table_cell_unselected {
            base "#c4c4c4"
            background "#0d0d0d"
            emphasis_0 "#b0b0b0"
            emphasis_1 "#a0a0a0"
            emphasis_2 "#a8a8a8"
            emphasis_3 "#8a8a8a"
        }
        table_cell_selected {
            base "#e0e0e0"
            background "#2e2e2e"
            emphasis_0 "#b0b0b0"
            emphasis_1 "#a0a0a0"
            emphasis_2 "#a8a8a8"
            emphasis_3 "#959595"
        }
        list_unselected {
            base "#c4c4c4"
            background "#0d0d0d"
            emphasis_0 "#b0b0b0"
            emphasis_1 "#a0a0a0"
            emphasis_2 "#a8a8a8"
            emphasis_3 "#8a8a8a"
        }
        list_selected {
            base "#e0e0e0"
            background "#2e2e2e"
            emphasis_0 "#b0b0b0"
            emphasis_1 "#a0a0a0"
            emphasis_2 "#a8a8a8"
            emphasis_3 "#959595"
        }
        ribbon_selected {
            base "#0d0d0d"
            background "#a8a8a8"
            emphasis_0 "#3d3d3d"
            emphasis_1 "#3d3d3d"
            emphasis_2 "#3d3d3d"
            emphasis_3 "#3d3d3d"
        }
        ribbon_unselected {
            base "#0d0d0d"
            background "#c4c4c4"
            emphasis_0 "#515151"
            emphasis_1 "#c4c4c4"
            emphasis_2 "#515151"
            emphasis_3 "#515151"
        }
        table_title {
            base "#a8a8a8"
            background "#0d0d0d"
            emphasis_0 "#b0b0b0"
            emphasis_1 "#a0a0a0"
            emphasis_2 "#a8a8a8"
            emphasis_3 "#8a8a8a"
        }
        frame_unselected {
            base "#c4c4c4"
            background "#0d0d0d"
            emphasis_0 "#c4c4c4"
            emphasis_1 "#c4c4c4"
            emphasis_2 "#c4c4c4"
            emphasis_3 "#c4c4c4"
        }
        frame_selected {
            base "#a8a8a8"
            background "#0d0d0d"
            emphasis_0 "#b0b0b0"
            emphasis_1 "#a0a0a0"
            emphasis_2 "#a8a8a8"
            emphasis_3 "#8a8a8a"
        }
        frame_highlight {
            base "#b0b0b0"
            background "#0d0d0d"
            emphasis_0 "#8a8a8a"
            emphasis_1 "#b0b0b0"
            emphasis_2 "#b0b0b0"
            emphasis_3 "#b0b0b0"
        }
        exit_code_success {
            base "#a8a8a8"
            background "#0d0d0d"
            emphasis_0 "#a0a0a0"
            emphasis_1 "#c4c4c4"
            emphasis_2 "#8a8a8a"
            emphasis_3 "#9a9a9a"
        }
        exit_code_error {
            base "#888888"
            background "#0d0d0d"
            emphasis_0 "#b0b0b0"
            emphasis_1 "#c4c4c4"
            emphasis_2 "#8a8a8a"
            emphasis_3 "#9a9a9a"
        }
        multiplayer_user_colors {
            player_1 "#8a8a8a"
            player_2 "#9a9a9a"
            player_3 "#b8b8b8"
            player_4 "#b0b0b0"
            player_5 "#a0a0a0"
            player_6 "#c8c8c8"
            player_7 "#888888"
            player_8 "#c0c0c0"
            player_9 "#a0a0a0"
            player_10 "#d0d0d0"
        }
    }
}
