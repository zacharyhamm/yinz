themes {
    "nebula-drift" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Nebula%20Drift
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000014"
        terminal {
            foreground "#e2e0fa"
            background "#0a0420"
            black "#1a0e38"
            red "#ff5c8d"
            green "#66e6a8"
            yellow "#ffcb6b"
            blue "#7c9bff"
            magenta "#c77dff"
            cyan "#57e6f0"
            white "#c8c6e8"
            bright_black "#5c5a88"
            bright_red "#ff5c8d"
            bright_green "#66e6a8"
            bright_yellow "#ff9e64"
            bright_blue "#7c9bff"
            bright_magenta "#c77dff"
            bright_cyan "#57e6f0"
            bright_white "#e2e0fa"
        }
        text_unselected {
            base "#e2e0fa"
            background "#0a0420"
            emphasis_0 "#ffcb6b"
            emphasis_1 "#57e6f0"
            emphasis_2 "#66e6a8"
            emphasis_3 "#c77dff"
        }
        text_selected {
            base "#0a0420"
            background "#e2e0fa"
            emphasis_0 "#7a6133"
            emphasis_1 "#2a6e73"
            emphasis_2 "#327052"
            emphasis_3 "#8050a4"
        }
        table_cell_unselected {
            base "#e2e0fa"
            background "#0a0420"
            emphasis_0 "#ffcb6b"
            emphasis_1 "#57e6f0"
            emphasis_2 "#66e6a8"
            emphasis_3 "#c77dff"
        }
        table_cell_selected {
            base "#878396"
            background "#221645"
            emphasis_0 "#ffcb6b"
            emphasis_1 "#57e6f0"
            emphasis_2 "#66e6a8"
            emphasis_3 "#c77dff"
        }
        list_unselected {
            base "#e2e0fa"
            background "#0a0420"
            emphasis_0 "#ffcb6b"
            emphasis_1 "#57e6f0"
            emphasis_2 "#66e6a8"
            emphasis_3 "#c77dff"
        }
        list_selected {
            base "#878396"
            background "#221645"
            emphasis_0 "#ffcb6b"
            emphasis_1 "#57e6f0"
            emphasis_2 "#66e6a8"
            emphasis_3 "#c77dff"
        }
        ribbon_selected {
            base "#0a0420"
            background "#66e6a8"
            emphasis_0 "#973653"
            emphasis_1 "#6b552d"
            emphasis_2 "#70468f"
            emphasis_3 "#45568e"
        }
        ribbon_unselected {
            base "#0a0420"
            background "#e2e0fa"
            emphasis_0 "#ac3e5f"
            emphasis_1 "#e2e0fa"
            emphasis_2 "#4f62a2"
            emphasis_3 "#8050a4"
        }
        table_title {
            base "#66e6a8"
            background "#0a0420"
            emphasis_0 "#ffcb6b"
            emphasis_1 "#57e6f0"
            emphasis_2 "#66e6a8"
            emphasis_3 "#c77dff"
        }
        frame_unselected {
            base "#e2e0fa"
            background "#0a0420"
            emphasis_0 "#e2e0fa"
            emphasis_1 "#e2e0fa"
            emphasis_2 "#e2e0fa"
            emphasis_3 "#e2e0fa"
        }
        frame_selected {
            base "#66e6a8"
            background "#0a0420"
            emphasis_0 "#ffcb6b"
            emphasis_1 "#57e6f0"
            emphasis_2 "#66e6a8"
            emphasis_3 "#c77dff"
        }
        frame_highlight {
            base "#ffcb6b"
            background "#0a0420"
            emphasis_0 "#c77dff"
            emphasis_1 "#ffcb6b"
            emphasis_2 "#ffcb6b"
            emphasis_3 "#ffcb6b"
        }
        exit_code_success {
            base "#66e6a8"
            background "#0a0420"
            emphasis_0 "#57e6f0"
            emphasis_1 "#e2e0fa"
            emphasis_2 "#c77dff"
            emphasis_3 "#7c9bff"
        }
        exit_code_error {
            base "#ff5c8d"
            background "#0a0420"
            emphasis_0 "#ffcb6b"
            emphasis_1 "#e2e0fa"
            emphasis_2 "#c77dff"
            emphasis_3 "#7c9bff"
        }
        multiplayer_user_colors {
            player_1 "#c77dff"
            player_2 "#7c9bff"
            player_3 "#c77dff"
            player_4 "#ffcb6b"
            player_5 "#57e6f0"
            player_6 "#ff9e64"
            player_7 "#ff5c8d"
            player_8 "#c8c6e8"
            player_9 "#ff5c8d"
            player_10 "#7c9bff"
        }
    }
}
