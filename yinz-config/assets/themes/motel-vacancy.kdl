themes {
    "motel-vacancy" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Motel%20Vacancy
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#040001"
        terminal {
            foreground "#f8edf4"
            background "#10070d"
            black "#bbb1b8"
            red "#f3838e"
            green "#7bd09e"
            yellow "#ebca69"
            blue "#8db2e8"
            magenta "#d7a0e4"
            cyan "#7dd2d7"
            white "#f8edf4"
            bright_black "#cec4ca"
            bright_red "#f59ca5"
            bright_green "#9addb5"
            bright_yellow "#f2db8a"
            bright_blue "#abc7ef"
            bright_magenta "#e5b9eb"
            bright_cyan "#9ee1e2"
            bright_white "#fffaff"
        }
        text_unselected {
            base "#f8edf4"
            background "#10070d"
            emphasis_0 "#ebca69"
            emphasis_1 "#7dd2d7"
            emphasis_2 "#7bd09e"
            emphasis_3 "#d7a0e4"
        }
        text_selected {
            base "#10070d"
            background "#f8edf4"
            emphasis_0 "#7d6c38"
            emphasis_1 "#467578"
            emphasis_2 "#46775a"
            emphasis_3 "#83618b"
        }
        table_cell_unselected {
            base "#f8edf4"
            background "#10070d"
            emphasis_0 "#ebca69"
            emphasis_1 "#7dd2d7"
            emphasis_2 "#7bd09e"
            emphasis_3 "#d7a0e4"
        }
        table_cell_selected {
            base "#fff5fa"
            background "#3a1c2c"
            emphasis_0 "#ebca69"
            emphasis_1 "#7dd2d7"
            emphasis_2 "#7bd09e"
            emphasis_3 "#d7a0e4"
        }
        list_unselected {
            base "#f8edf4"
            background "#10070d"
            emphasis_0 "#ebca69"
            emphasis_1 "#7dd2d7"
            emphasis_2 "#7bd09e"
            emphasis_3 "#d7a0e4"
        }
        list_selected {
            base "#fff5fa"
            background "#3a1c2c"
            emphasis_0 "#ebca69"
            emphasis_1 "#7dd2d7"
            emphasis_2 "#7bd09e"
            emphasis_3 "#d7a0e4"
        }
        ribbon_selected {
            base "#10070d"
            background "#7bd09e"
            emphasis_0 "#733e43"
            emphasis_1 "#594d28"
            emphasis_2 "#5d4562"
            emphasis_3 "#3e4f67"
        }
        ribbon_unselected {
            base "#10070d"
            background "#f8edf4"
            emphasis_0 "#a2575f"
            emphasis_1 "#f8edf4"
            emphasis_2 "#576e90"
            emphasis_3 "#83618b"
        }
        table_title {
            base "#7bd09e"
            background "#10070d"
            emphasis_0 "#ebca69"
            emphasis_1 "#7dd2d7"
            emphasis_2 "#7bd09e"
            emphasis_3 "#d7a0e4"
        }
        frame_unselected {
            base "#f8edf4"
            background "#10070d"
            emphasis_0 "#f8edf4"
            emphasis_1 "#f8edf4"
            emphasis_2 "#f8edf4"
            emphasis_3 "#f8edf4"
        }
        frame_selected {
            base "#7bd09e"
            background "#10070d"
            emphasis_0 "#ebca69"
            emphasis_1 "#7dd2d7"
            emphasis_2 "#7bd09e"
            emphasis_3 "#d7a0e4"
        }
        frame_highlight {
            base "#ebca69"
            background "#10070d"
            emphasis_0 "#d7a0e4"
            emphasis_1 "#ebca69"
            emphasis_2 "#ebca69"
            emphasis_3 "#ebca69"
        }
        exit_code_success {
            base "#7bd09e"
            background "#10070d"
            emphasis_0 "#7dd2d7"
            emphasis_1 "#f8edf4"
            emphasis_2 "#d7a0e4"
            emphasis_3 "#8db2e8"
        }
        exit_code_error {
            base "#f3838e"
            background "#10070d"
            emphasis_0 "#ebca69"
            emphasis_1 "#f8edf4"
            emphasis_2 "#d7a0e4"
            emphasis_3 "#8db2e8"
        }
        multiplayer_user_colors {
            player_1 "#d7a0e4"
            player_2 "#8db2e8"
            player_3 "#e5b9eb"
            player_4 "#ebca69"
            player_5 "#7dd2d7"
            player_6 "#f2db8a"
            player_7 "#f3838e"
            player_8 "#f8edf4"
            player_9 "#f59ca5"
            player_10 "#abc7ef"
        }
    }
}
