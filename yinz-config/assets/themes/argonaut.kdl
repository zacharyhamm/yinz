themes {
    "argonaut" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Argonaut
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#02040d"
        terminal {
            foreground "#fffaf4"
            background "#0e1019"
            black "#232323"
            red "#ff000f"
            green "#8ce10b"
            yellow "#ffb900"
            blue "#008df8"
            magenta "#6d43a6"
            cyan "#00d8eb"
            white "#ffffff"
            bright_black "#444444"
            bright_red "#ff2740"
            bright_green "#abe15b"
            bright_yellow "#ffd242"
            bright_blue "#0092ff"
            bright_magenta "#9a5feb"
            bright_cyan "#67fff0"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#fffaf4"
            background "#0e1019"
            emphasis_0 "#ffb900"
            emphasis_1 "#00d8eb"
            emphasis_2 "#8ce10b"
            emphasis_3 "#8d6cba"
        }
        text_selected {
            base "#0e1019"
            background "#fffaf4"
            emphasis_0 "#966d00"
            emphasis_1 "#00808b"
            emphasis_2 "#508106"
            emphasis_3 "#8169a1"
        }
        table_cell_unselected {
            base "#fffaf4"
            background "#0e1019"
            emphasis_0 "#ffb900"
            emphasis_1 "#00d8eb"
            emphasis_2 "#8ce10b"
            emphasis_3 "#8d6cba"
        }
        table_cell_selected {
            base "#ffffff"
            background "#002a3b"
            emphasis_0 "#ffb900"
            emphasis_1 "#00d8eb"
            emphasis_2 "#8ce10b"
            emphasis_3 "#9d80c3"
        }
        list_unselected {
            base "#fffaf4"
            background "#0e1019"
            emphasis_0 "#ffb900"
            emphasis_1 "#00d8eb"
            emphasis_2 "#8ce10b"
            emphasis_3 "#8d6cba"
        }
        list_selected {
            base "#ffffff"
            background "#002a3b"
            emphasis_0 "#ffb900"
            emphasis_1 "#00d8eb"
            emphasis_2 "#8ce10b"
            emphasis_3 "#9d80c3"
        }
        ribbon_selected {
            base "#0e1019"
            background "#8ce10b"
            emphasis_0 "#b0000a"
            emphasis_1 "#6f5100"
            emphasis_2 "#6941a0"
            emphasis_3 "#00579a"
        }
        ribbon_unselected {
            base "#0e1019"
            background "#fffaf4"
            emphasis_0 "#e9000e"
            emphasis_1 "#fffaf4"
            emphasis_2 "#0076cf"
            emphasis_3 "#6d43a6"
        }
        table_title {
            base "#8ce10b"
            background "#0e1019"
            emphasis_0 "#ffb900"
            emphasis_1 "#00d8eb"
            emphasis_2 "#8ce10b"
            emphasis_3 "#8d6cba"
        }
        frame_unselected {
            base "#fffaf4"
            background "#0e1019"
            emphasis_0 "#fffaf4"
            emphasis_1 "#fffaf4"
            emphasis_2 "#fffaf4"
            emphasis_3 "#fffaf4"
        }
        frame_selected {
            base "#8ce10b"
            background "#0e1019"
            emphasis_0 "#ffb900"
            emphasis_1 "#00d8eb"
            emphasis_2 "#8ce10b"
            emphasis_3 "#8d6cba"
        }
        frame_highlight {
            base "#ffb900"
            background "#0e1019"
            emphasis_0 "#8d6cba"
            emphasis_1 "#ffb900"
            emphasis_2 "#ffb900"
            emphasis_3 "#ffb900"
        }
        exit_code_success {
            base "#8ce10b"
            background "#0e1019"
            emphasis_0 "#00d8eb"
            emphasis_1 "#fffaf4"
            emphasis_2 "#8d6cba"
            emphasis_3 "#008df8"
        }
        exit_code_error {
            base "#ff000f"
            background "#0e1019"
            emphasis_0 "#ffb900"
            emphasis_1 "#fffaf4"
            emphasis_2 "#8d6cba"
            emphasis_3 "#008df8"
        }
        multiplayer_user_colors {
            player_1 "#8d6cba"
            player_2 "#008df8"
            player_3 "#9a5feb"
            player_4 "#ffb900"
            player_5 "#00d8eb"
            player_6 "#ffd242"
            player_7 "#ff000f"
            player_8 "#ffffff"
            player_9 "#ff2740"
            player_10 "#0092ff"
        }
    }
}
