themes {
    "barrel-cactus" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Barrel%20Cactus
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#08442d"
        terminal {
            foreground "#fff0d3"
            background "#145039"
            black "#bed0c3"
            red "#f5a181"
            green "#8bd19b"
            yellow "#eac95f"
            blue "#83bfd8"
            magenta "#dcaac8"
            cyan "#77d3ca"
            white "#fff0d3"
            bright_black "#cedbd1"
            bright_red "#f8ab89"
            bright_green "#a3dcaf"
            bright_yellow "#f3d97f"
            bright_blue "#9fcfe2"
            bright_magenta "#e4b7cf"
            bright_cyan "#96dfd7"
            bright_white "#fff9e9"
        }
        text_unselected {
            base "#fff0d3"
            background "#145039"
            emphasis_0 "#eac95f"
            emphasis_1 "#77d3ca"
            emphasis_2 "#8bd19b"
            emphasis_3 "#dcaac8"
        }
        text_selected {
            base "#145039"
            background "#fff0d3"
            emphasis_0 "#796d49"
            emphasis_1 "#597370"
            emphasis_2 "#5f7363"
            emphasis_3 "#776b72"
        }
        table_cell_unselected {
            base "#fff0d3"
            background "#145039"
            emphasis_0 "#eac95f"
            emphasis_1 "#77d3ca"
            emphasis_2 "#8bd19b"
            emphasis_3 "#dcaac8"
        }
        table_cell_selected {
            base "#fff8e6"
            background "#326b56"
            emphasis_0 "#f1da92"
            emphasis_1 "#b1e6e0"
            emphasis_2 "#bde5c6"
            emphasis_3 "#eed5e4"
        }
        list_unselected {
            base "#fff0d3"
            background "#145039"
            emphasis_0 "#eac95f"
            emphasis_1 "#77d3ca"
            emphasis_2 "#8bd19b"
            emphasis_3 "#dcaac8"
        }
        list_selected {
            base "#fff8e6"
            background "#326b56"
            emphasis_0 "#f1da92"
            emphasis_1 "#b1e6e0"
            emphasis_2 "#bde5c6"
            emphasis_3 "#eed5e4"
        }
        ribbon_selected {
            base "#145039"
            background "#8bd19b"
            emphasis_0 "#6c4739"
            emphasis_1 "#5b4e25"
            emphasis_2 "#5f4956"
            emphasis_3 "#39535e"
        }
        ribbon_unselected {
            base "#145039"
            background "#fff0d3"
            emphasis_0 "#95624e"
            emphasis_1 "#fff0d3"
            emphasis_2 "#4f7382"
            emphasis_3 "#836577"
        }
        table_title {
            base "#8bd19b"
            background "#145039"
            emphasis_0 "#eac95f"
            emphasis_1 "#77d3ca"
            emphasis_2 "#8bd19b"
            emphasis_3 "#dcaac8"
        }
        frame_unselected {
            base "#fff0d3"
            background "#145039"
            emphasis_0 "#fff0d3"
            emphasis_1 "#fff0d3"
            emphasis_2 "#fff0d3"
            emphasis_3 "#fff0d3"
        }
        frame_selected {
            base "#8bd19b"
            background "#145039"
            emphasis_0 "#eac95f"
            emphasis_1 "#77d3ca"
            emphasis_2 "#8bd19b"
            emphasis_3 "#dcaac8"
        }
        frame_highlight {
            base "#eac95f"
            background "#145039"
            emphasis_0 "#dcaac8"
            emphasis_1 "#eac95f"
            emphasis_2 "#eac95f"
            emphasis_3 "#eac95f"
        }
        exit_code_success {
            base "#8bd19b"
            background "#145039"
            emphasis_0 "#77d3ca"
            emphasis_1 "#fff0d3"
            emphasis_2 "#dcaac8"
            emphasis_3 "#83bfd8"
        }
        exit_code_error {
            base "#f5a181"
            background "#145039"
            emphasis_0 "#eac95f"
            emphasis_1 "#fff0d3"
            emphasis_2 "#dcaac8"
            emphasis_3 "#83bfd8"
        }
        multiplayer_user_colors {
            player_1 "#dcaac8"
            player_2 "#83bfd8"
            player_3 "#e4b7cf"
            player_4 "#eac95f"
            player_5 "#77d3ca"
            player_6 "#f3d97f"
            player_7 "#f5a181"
            player_8 "#fff0d3"
            player_9 "#f8ab89"
            player_10 "#9fcfe2"
        }
    }
}
