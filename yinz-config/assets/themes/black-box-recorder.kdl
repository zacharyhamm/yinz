themes {
    "black-box-recorder" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Black%20Box%20Recorder
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000000"
        terminal {
            foreground "#f4f1e8"
            background "#050608"
            black "#b9b7b0"
            red "#ff806d"
            green "#78d19d"
            yellow "#f1ca63"
            blue "#8cb2ed"
            magenta "#d5a0e6"
            cyan "#80d3dc"
            white "#f4f1e8"
            bright_black "#cbc8c0"
            bright_red "#ff9c8b"
            bright_green "#99deb5"
            bright_yellow "#f7db86"
            bright_blue "#aac7f3"
            bright_magenta "#e4b9ed"
            bright_cyan "#a1e1e7"
            bright_white "#fffdf7"
        }
        text_unselected {
            base "#f4f1e8"
            background "#050608"
            emphasis_0 "#f1ca63"
            emphasis_1 "#80d3dc"
            emphasis_2 "#78d19d"
            emphasis_3 "#d5a0e6"
        }
        text_selected {
            base "#050608"
            background "#f4f1e8"
            emphasis_0 "#816c35"
            emphasis_1 "#47757b"
            emphasis_2 "#45785b"
            emphasis_3 "#82628d"
        }
        table_cell_unselected {
            base "#f4f1e8"
            background "#050608"
            emphasis_0 "#f1ca63"
            emphasis_1 "#80d3dc"
            emphasis_2 "#78d19d"
            emphasis_3 "#d5a0e6"
        }
        table_cell_selected {
            base "#fff8e7"
            background "#2b2414"
            emphasis_0 "#f1ca63"
            emphasis_1 "#80d3dc"
            emphasis_2 "#78d19d"
            emphasis_3 "#d5a0e6"
        }
        list_unselected {
            base "#f4f1e8"
            background "#050608"
            emphasis_0 "#f1ca63"
            emphasis_1 "#80d3dc"
            emphasis_2 "#78d19d"
            emphasis_3 "#d5a0e6"
        }
        list_selected {
            base "#fff8e7"
            background "#2b2414"
            emphasis_0 "#f1ca63"
            emphasis_1 "#80d3dc"
            emphasis_2 "#78d19d"
            emphasis_3 "#d5a0e6"
        }
        ribbon_selected {
            base "#050608"
            background "#78d19d"
            emphasis_0 "#793d34"
            emphasis_1 "#5b4c25"
            emphasis_2 "#5d4664"
            emphasis_3 "#3e4f69"
        }
        ribbon_unselected {
            base "#050608"
            background "#f4f1e8"
            emphasis_0 "#aa5549"
            emphasis_1 "#f4f1e8"
            emphasis_2 "#576f94"
            emphasis_3 "#82628d"
        }
        table_title {
            base "#78d19d"
            background "#050608"
            emphasis_0 "#f1ca63"
            emphasis_1 "#80d3dc"
            emphasis_2 "#78d19d"
            emphasis_3 "#d5a0e6"
        }
        frame_unselected {
            base "#f4f1e8"
            background "#050608"
            emphasis_0 "#f4f1e8"
            emphasis_1 "#f4f1e8"
            emphasis_2 "#f4f1e8"
            emphasis_3 "#f4f1e8"
        }
        frame_selected {
            base "#78d19d"
            background "#050608"
            emphasis_0 "#f1ca63"
            emphasis_1 "#80d3dc"
            emphasis_2 "#78d19d"
            emphasis_3 "#d5a0e6"
        }
        frame_highlight {
            base "#f1ca63"
            background "#050608"
            emphasis_0 "#d5a0e6"
            emphasis_1 "#f1ca63"
            emphasis_2 "#f1ca63"
            emphasis_3 "#f1ca63"
        }
        exit_code_success {
            base "#78d19d"
            background "#050608"
            emphasis_0 "#80d3dc"
            emphasis_1 "#f4f1e8"
            emphasis_2 "#d5a0e6"
            emphasis_3 "#8cb2ed"
        }
        exit_code_error {
            base "#ff806d"
            background "#050608"
            emphasis_0 "#f1ca63"
            emphasis_1 "#f4f1e8"
            emphasis_2 "#d5a0e6"
            emphasis_3 "#8cb2ed"
        }
        multiplayer_user_colors {
            player_1 "#d5a0e6"
            player_2 "#8cb2ed"
            player_3 "#e4b9ed"
            player_4 "#f1ca63"
            player_5 "#80d3dc"
            player_6 "#f7db86"
            player_7 "#ff806d"
            player_8 "#f4f1e8"
            player_9 "#ff9c8b"
            player_10 "#aac7f3"
        }
    }
}
