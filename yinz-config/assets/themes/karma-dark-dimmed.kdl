themes {
    "karma-dark-dimmed" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Karma%20Dark%20Dimmed
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#080c13"
        terminal {
            foreground "#e2def0"
            background "#14181f"
            black "#14181f"
            red "#e87691"
            green "#82c891"
            yellow "#ebd870"
            blue "#6cc4d2"
            magenta "#a892d4"
            cyan "#6cc4d2"
            white "#a8a4ae"
            bright_black "#5c5a5f"
            bright_red "#e8869c"
            bright_green "#98cea4"
            bright_yellow "#ebd870"
            bright_blue "#80c8d2"
            bright_magenta "#b6a4d6"
            bright_cyan "#80c8d2"
            bright_white "#e2def0"
        }
        text_unselected {
            base "#e2def0"
            background "#14181f"
            emphasis_0 "#ebd870"
            emphasis_1 "#6cc4d2"
            emphasis_2 "#82c891"
            emphasis_3 "#a892d4"
        }
        text_selected {
            base "#14181f"
            background "#e2def0"
            emphasis_0 "#6d6434"
            emphasis_1 "#3b6b72"
            emphasis_2 "#466c4e"
            emphasis_3 "#6b5d87"
        }
        table_cell_unselected {
            base "#e2def0"
            background "#14181f"
            emphasis_0 "#ebd870"
            emphasis_1 "#6cc4d2"
            emphasis_2 "#82c891"
            emphasis_3 "#a892d4"
        }
        table_cell_selected {
            base "#e2def0"
            background "#2f2d3d"
            emphasis_0 "#ebd870"
            emphasis_1 "#6cc4d2"
            emphasis_2 "#82c891"
            emphasis_3 "#a892d4"
        }
        list_unselected {
            base "#e2def0"
            background "#14181f"
            emphasis_0 "#ebd870"
            emphasis_1 "#6cc4d2"
            emphasis_2 "#82c891"
            emphasis_3 "#a892d4"
        }
        list_selected {
            base "#e2def0"
            background "#2f2d3d"
            emphasis_0 "#ebd870"
            emphasis_1 "#6cc4d2"
            emphasis_2 "#82c891"
            emphasis_3 "#a892d4"
        }
        ribbon_selected {
            base "#14181f"
            background "#82c891"
            emphasis_0 "#6f3845"
            emphasis_1 "#504a26"
            emphasis_2 "#4e4463"
            emphasis_3 "#2c4f55"
        }
        ribbon_unselected {
            base "#14181f"
            background "#e2def0"
            emphasis_0 "#974d5e"
            emphasis_1 "#e2def0"
            emphasis_2 "#3b6b72"
            emphasis_3 "#6b5d87"
        }
        table_title {
            base "#82c891"
            background "#14181f"
            emphasis_0 "#ebd870"
            emphasis_1 "#6cc4d2"
            emphasis_2 "#82c891"
            emphasis_3 "#a892d4"
        }
        frame_unselected {
            base "#e2def0"
            background "#14181f"
            emphasis_0 "#e2def0"
            emphasis_1 "#e2def0"
            emphasis_2 "#e2def0"
            emphasis_3 "#e2def0"
        }
        frame_selected {
            base "#82c891"
            background "#14181f"
            emphasis_0 "#ebd870"
            emphasis_1 "#6cc4d2"
            emphasis_2 "#82c891"
            emphasis_3 "#a892d4"
        }
        frame_highlight {
            base "#ebd870"
            background "#14181f"
            emphasis_0 "#a892d4"
            emphasis_1 "#ebd870"
            emphasis_2 "#ebd870"
            emphasis_3 "#ebd870"
        }
        exit_code_success {
            base "#82c891"
            background "#14181f"
            emphasis_0 "#6cc4d2"
            emphasis_1 "#e2def0"
            emphasis_2 "#a892d4"
            emphasis_3 "#6cc4d2"
        }
        exit_code_error {
            base "#e87691"
            background "#14181f"
            emphasis_0 "#ebd870"
            emphasis_1 "#e2def0"
            emphasis_2 "#a892d4"
            emphasis_3 "#6cc4d2"
        }
        multiplayer_user_colors {
            player_1 "#a892d4"
            player_2 "#6cc4d2"
            player_3 "#b6a4d6"
            player_4 "#ebd870"
            player_5 "#6cc4d2"
            player_6 "#ebd870"
            player_7 "#e87691"
            player_8 "#a8a4ae"
            player_9 "#e8869c"
            player_10 "#80c8d2"
        }
    }
}
