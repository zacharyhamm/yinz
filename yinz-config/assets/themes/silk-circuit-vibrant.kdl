themes {
    "silk-circuit-vibrant" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/SilkCircuit%20Vibrant
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#03000e"
        terminal {
            foreground "#f8f8f2"
            background "#0f0c1a"
            black "#0f0c1a"
            red "#ff3366"
            green "#00ff66"
            yellow "#ffcc00"
            blue "#6699ff"
            magenta "#ff00cc"
            cyan "#00ffcc"
            white "#f8f8f2"
            bright_black "#728989"
            bright_red "#ff6677"
            bright_green "#66ff99"
            bright_yellow "#ffff66"
            bright_blue "#88aaff"
            bright_magenta "#ff66ff"
            bright_cyan "#00ffff"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#f8f8f2"
            background "#0f0c1a"
            emphasis_0 "#ffcc00"
            emphasis_1 "#00ffcc"
            emphasis_2 "#00ff66"
            emphasis_3 "#ff00cc"
        }
        text_selected {
            base "#0f0c1a"
            background "#f8f8f2"
            emphasis_0 "#8b6f00"
            emphasis_1 "#008167"
            emphasis_2 "#008435"
            emphasis_3 "#ba41a2"
        }
        table_cell_unselected {
            base "#f8f8f2"
            background "#0f0c1a"
            emphasis_0 "#ffcc00"
            emphasis_1 "#00ffcc"
            emphasis_2 "#00ff66"
            emphasis_3 "#ff00cc"
        }
        table_cell_selected {
            base "#f8f8f2"
            background "#3a2e5a"
            emphasis_0 "#ffcc00"
            emphasis_1 "#00ffcc"
            emphasis_2 "#00ff66"
            emphasis_3 "#ff59de"
        }
        list_unselected {
            base "#f8f8f2"
            background "#0f0c1a"
            emphasis_0 "#ffcc00"
            emphasis_1 "#00ffcc"
            emphasis_2 "#00ff66"
            emphasis_3 "#ff00cc"
        }
        list_selected {
            base "#f8f8f2"
            background "#3a2e5a"
            emphasis_0 "#ffcc00"
            emphasis_1 "#00ffcc"
            emphasis_2 "#00ff66"
            emphasis_3 "#ff59de"
        }
        ribbon_selected {
            base "#0f0c1a"
            background "#00ff66"
            emphasis_0 "#b9254a"
            emphasis_1 "#775f00"
            emphasis_2 "#b70092"
            emphasis_3 "#4061a1"
        }
        ribbon_unselected {
            base "#0f0c1a"
            background "#f8f8f2"
            emphasis_0 "#d72b56"
            emphasis_1 "#f8f8f2"
            emphasis_2 "#4b70bb"
            emphasis_3 "#d300a9"
        }
        table_title {
            base "#00ff66"
            background "#0f0c1a"
            emphasis_0 "#ffcc00"
            emphasis_1 "#00ffcc"
            emphasis_2 "#00ff66"
            emphasis_3 "#ff00cc"
        }
        frame_unselected {
            base "#f8f8f2"
            background "#0f0c1a"
            emphasis_0 "#f8f8f2"
            emphasis_1 "#f8f8f2"
            emphasis_2 "#f8f8f2"
            emphasis_3 "#f8f8f2"
        }
        frame_selected {
            base "#00ff66"
            background "#0f0c1a"
            emphasis_0 "#ffcc00"
            emphasis_1 "#00ffcc"
            emphasis_2 "#00ff66"
            emphasis_3 "#ff00cc"
        }
        frame_highlight {
            base "#ffcc00"
            background "#0f0c1a"
            emphasis_0 "#ff00cc"
            emphasis_1 "#ffcc00"
            emphasis_2 "#ffcc00"
            emphasis_3 "#ffcc00"
        }
        exit_code_success {
            base "#00ff66"
            background "#0f0c1a"
            emphasis_0 "#00ffcc"
            emphasis_1 "#f8f8f2"
            emphasis_2 "#ff00cc"
            emphasis_3 "#6699ff"
        }
        exit_code_error {
            base "#ff3366"
            background "#0f0c1a"
            emphasis_0 "#ffcc00"
            emphasis_1 "#f8f8f2"
            emphasis_2 "#ff00cc"
            emphasis_3 "#6699ff"
        }
        multiplayer_user_colors {
            player_1 "#ff00cc"
            player_2 "#6699ff"
            player_3 "#ff66ff"
            player_4 "#ffcc00"
            player_5 "#00ffcc"
            player_6 "#ffff66"
            player_7 "#ff3366"
            player_8 "#f8f8f2"
            player_9 "#ff6677"
            player_10 "#88aaff"
        }
    }
}
