themes {
    "toy-chest" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Toy%20Chest
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#182a3f"
        terminal {
            foreground "#31d07b"
            background "#24364b"
            black "#2c3f58"
            red "#be2d26"
            green "#1a9172"
            yellow "#db8e27"
            blue "#325d96"
            magenta "#8a5edc"
            cyan "#35a08f"
            white "#23d183"
            bright_black "#336889"
            bright_red "#dd5944"
            bright_green "#31d07b"
            bright_yellow "#e7d84b"
            bright_blue "#34a6da"
            bright_magenta "#ae6bdc"
            bright_cyan "#42c3ae"
            bright_white "#d5d5d5"
        }
        text_unselected {
            base "#31d07b"
            background "#24364b"
            emphasis_0 "#db8e27"
            emphasis_1 "#4eac9d"
            emphasis_2 "#52ac94"
            emphasis_3 "#ac8de6"
        }
        text_selected {
            base "#24364b"
            background "#31d07b"
            emphasis_0 "#60431c"
            emphasis_1 "#2c4e49"
            emphasis_2 "#2d4e45"
            emphasis_3 "#4e4364"
        }
        table_cell_unselected {
            base "#31d07b"
            background "#24364b"
            emphasis_0 "#db8e27"
            emphasis_1 "#4eac9d"
            emphasis_2 "#52ac94"
            emphasis_3 "#ac8de6"
        }
        table_cell_selected {
            base "#d5d5d5"
            background "#5f217a"
            emphasis_0 "#df9c41"
            emphasis_1 "#67b7ab"
            emphasis_2 "#6bb8a4"
            emphasis_3 "#b79ce9"
        }
        list_unselected {
            base "#31d07b"
            background "#24364b"
            emphasis_0 "#db8e27"
            emphasis_1 "#4eac9d"
            emphasis_2 "#52ac94"
            emphasis_3 "#ac8de6"
        }
        list_selected {
            base "#d5d5d5"
            background "#5f217a"
            emphasis_0 "#df9c41"
            emphasis_1 "#67b7ab"
            emphasis_2 "#6bb8a4"
            emphasis_3 "#b79ce9"
        }
        ribbon_selected {
            base "#111922"
            background "#1a9172"
            emphasis_0 "#300b0a"
            emphasis_1 "#221606"
            emphasis_2 "#1c132d"
            emphasis_3 "#0d1827"
        }
        ribbon_unselected {
            base "#24364b"
            background "#31d07b"
            emphasis_0 "#8a211c"
            emphasis_1 "#31d07b"
            emphasis_2 "#274976"
            emphasis_3 "#543986"
        }
        table_title {
            base "#52ac94"
            background "#24364b"
            emphasis_0 "#db8e27"
            emphasis_1 "#4eac9d"
            emphasis_2 "#52ac94"
            emphasis_3 "#ac8de6"
        }
        frame_unselected {
            base "#31d07b"
            background "#24364b"
            emphasis_0 "#31d07b"
            emphasis_1 "#31d07b"
            emphasis_2 "#31d07b"
            emphasis_3 "#31d07b"
        }
        frame_selected {
            base "#52ac94"
            background "#24364b"
            emphasis_0 "#db8e27"
            emphasis_1 "#4eac9d"
            emphasis_2 "#52ac94"
            emphasis_3 "#ac8de6"
        }
        frame_highlight {
            base "#db8e27"
            background "#24364b"
            emphasis_0 "#ac8de6"
            emphasis_1 "#db8e27"
            emphasis_2 "#db8e27"
            emphasis_3 "#db8e27"
        }
        exit_code_success {
            base "#52ac94"
            background "#24364b"
            emphasis_0 "#4eac9d"
            emphasis_1 "#31d07b"
            emphasis_2 "#ac8de6"
            emphasis_3 "#869fc1"
        }
        exit_code_error {
            base "#da8682"
            background "#24364b"
            emphasis_0 "#db8e27"
            emphasis_1 "#31d07b"
            emphasis_2 "#ac8de6"
            emphasis_3 "#869fc1"
        }
        multiplayer_user_colors {
            player_1 "#ac8de6"
            player_2 "#869fc1"
            player_3 "#bd86e2"
            player_4 "#db8e27"
            player_5 "#4eac9d"
            player_6 "#e7d84b"
            player_7 "#da8682"
            player_8 "#23d183"
            player_9 "#e58171"
            player_10 "#36a7da"
        }
    }
}
