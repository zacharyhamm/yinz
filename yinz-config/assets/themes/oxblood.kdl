themes {
    "oxblood" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Oxblood
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#080001"
        terminal {
            foreground "#e8d2d4"
            background "#140b0d"
            black "#231417"
            red "#ff4d54"
            green "#c9a24a"
            yellow "#e0b24a"
            blue "#d9743f"
            magenta "#e0556b"
            cyan "#e0a36a"
            white "#e8d2d4"
            bright_black "#7a5458"
            bright_red "#ff686e"
            bright_green "#cfad60"
            bright_yellow "#d9743f"
            bright_blue "#e86b72"
            bright_magenta "#c8324b"
            bright_cyan "#e4ae7c"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#e8d2d4"
            background "#140b0d"
            emphasis_0 "#e0b24a"
            emphasis_1 "#e0a36a"
            emphasis_2 "#c9a24a"
            emphasis_3 "#e0556b"
        }
        text_selected {
            base "#140b0d"
            background "#e8d2d4"
            emphasis_0 "#725b26"
            emphasis_1 "#775739"
            emphasis_2 "#715b29"
            emphasis_3 "#964451"
        }
        table_cell_unselected {
            base "#e8d2d4"
            background "#140b0d"
            emphasis_0 "#e0b24a"
            emphasis_1 "#e0a36a"
            emphasis_2 "#c9a24a"
            emphasis_3 "#e0556b"
        }
        table_cell_selected {
            base "#948e90"
            background "#3a2227"
            emphasis_0 "#e0b24a"
            emphasis_1 "#e0a36a"
            emphasis_2 "#c9a24a"
            emphasis_3 "#e3677b"
        }
        list_unselected {
            base "#e8d2d4"
            background "#140b0d"
            emphasis_0 "#e0b24a"
            emphasis_1 "#e0a36a"
            emphasis_2 "#c9a24a"
            emphasis_3 "#e0556b"
        }
        list_selected {
            base "#948e90"
            background "#3a2227"
            emphasis_0 "#e0b24a"
            emphasis_1 "#e0a36a"
            emphasis_2 "#c9a24a"
            emphasis_3 "#e3677b"
        }
        ribbon_selected {
            base "#140b0d"
            background "#c9a24a"
            emphasis_0 "#702225"
            emphasis_1 "#4b3b19"
            emphasis_2 "#682732"
            emphasis_3 "#5d321b"
        }
        ribbon_unselected {
            base "#140b0d"
            background "#e8d2d4"
            emphasis_0 "#aa3338"
            emphasis_1 "#e8d2d4"
            emphasis_2 "#8f4c2a"
            emphasis_3 "#9f3c4c"
        }
        table_title {
            base "#c9a24a"
            background "#140b0d"
            emphasis_0 "#e0b24a"
            emphasis_1 "#e0a36a"
            emphasis_2 "#c9a24a"
            emphasis_3 "#e0556b"
        }
        frame_unselected {
            base "#e8d2d4"
            background "#140b0d"
            emphasis_0 "#e8d2d4"
            emphasis_1 "#e8d2d4"
            emphasis_2 "#e8d2d4"
            emphasis_3 "#e8d2d4"
        }
        frame_selected {
            base "#c9a24a"
            background "#140b0d"
            emphasis_0 "#e0b24a"
            emphasis_1 "#e0a36a"
            emphasis_2 "#c9a24a"
            emphasis_3 "#e0556b"
        }
        frame_highlight {
            base "#e0b24a"
            background "#140b0d"
            emphasis_0 "#e0556b"
            emphasis_1 "#e0b24a"
            emphasis_2 "#e0b24a"
            emphasis_3 "#e0b24a"
        }
        exit_code_success {
            base "#c9a24a"
            background "#140b0d"
            emphasis_0 "#e0a36a"
            emphasis_1 "#e8d2d4"
            emphasis_2 "#e0556b"
            emphasis_3 "#d9743f"
        }
        exit_code_error {
            base "#ff4d54"
            background "#140b0d"
            emphasis_0 "#e0b24a"
            emphasis_1 "#e8d2d4"
            emphasis_2 "#e0556b"
            emphasis_3 "#d9743f"
        }
        multiplayer_user_colors {
            player_1 "#e0556b"
            player_2 "#d9743f"
            player_3 "#cf4d62"
            player_4 "#e0b24a"
            player_5 "#e0a36a"
            player_6 "#d9743f"
            player_7 "#ff4d54"
            player_8 "#e8d2d4"
            player_9 "#ff686e"
            player_10 "#e86b72"
        }
    }
}
