            emphasis_0 "#ee9f99"
            emphasis_1 "#4a4543"
            emphasis_2 "#53bfed"
            emphasis_3 "#c9aac2"
        }
        table_title {
            base "#018342"
            background "#f7f7f7"
            emphasis_0 "#7d7300"
            emphasis_1 "#597680"
            emphasis_2 "#018342"
            emphasis_3 "#946188"
        }
        frame_unselected {
            base "#4a4543"
            background "#f7f7f7"
            emphasis_0 "#4a4543"
            emphasis_1 "#4a4543"
            emphasis_2 "#4a4543"
            emphasis_3 "#4a4543"
        }
        frame_selected {
            base "#018342"
