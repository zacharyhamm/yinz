            emphasis_0 "#7d7300"
            emphasis_1 "#597680"
            emphasis_2 "#018342"
            emphasis_3 "#946188"
        }
        table_cell_selected {
            base "#3d3937"
            background "#a5a2a2"
            emphasis_0 "#3f3a00"
            emphasis_1 "#2d3c41"
            emphasis_2 "#004322"
            emphasis_3 "#4b3145"
        }
        list_unselected {
            base "#4a4543"
            background "#f7f7f7"
            emphasis_0 "#7d7300"
            emphasis_1 "#597680"
            emphasis_2 "#018342"
            emphasis_3 "#946188"
        }
        list_selected {
            base "#3d3937"
            background "#a5a2a2"
            emphasis_0 "#3f3a00"
            emphasis_1 "#2d3c41"
            emphasis_2 "#004322"
            emphasis_3 "#4b3145"
        }
        ribbon_selected {
