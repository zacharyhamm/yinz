themes {
    "3024-day" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/3024%20Day
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#ebebeb"
        terminal {
            foreground "#4a4543"
            background "#f7f7f7"
            black "#090300"
            red "#db2d20"
            green "#01a252"
            yellow "#caba00"
            blue "#01a0e4"
            magenta "#a16a94"
            cyan "#8fbece"
            white "#a5a2a2"
            bright_black "#5c5855"
            bright_red "#dbaec3"
            bright_green "#3a3432"
            bright_yellow "#4a4543"
            bright_blue "#807d7c"
            bright_magenta "#bcbbba"
            bright_cyan "#cdab53"
            bright_white "#f7f7f7"
        }
        text_unselected {
            base "#4a4543"
            background "#f7f7f7"
            emphasis_0 "#7d7300"
            emphasis_1 "#597680"
            emphasis_2 "#018342"
            emphasis_3 "#946188"
        }
        text_selected {
            base "#f7f7f7"
            background "#4a4543"
            emphasis_0 "#b6b49e"
            emphasis_1 "#afb5b7"
            emphasis_2 "#a0b9ad"
            emphasis_3 "#bbb1b8"
        }
        table_cell_unselected {
