themes {
    "trapped-in-amber" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Trapped%20in%20Amber
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#00040b"
        terminal {
            foreground "#f0a020"
            background "#0a1017"
            black "#4a3220"
            red "#e05c1c"
            green "#7a9c4a"
            yellow "#f0a020"
            blue "#4a7ec9"
            magenta "#c95a8c"
            cyan "#7a9ea8"
            white "#ffd9a0"
            bright_black "#5a4a3a"
            bright_red "#ff7832"
            bright_green "#a8c46b"
            bright_yellow "#ffd700"
            bright_blue "#6b9fff"
            bright_magenta "#ff7fa8"
            bright_cyan "#a5c2cc"
            bright_white "#fff5e0"
        }
        text_unselected {
            base "#f0a020"
            background "#0a1017"
            emphasis_0 "#f0a020"
            emphasis_1 "#7a9ea8"
            emphasis_2 "#7a9c4a"
            emphasis_3 "#c95a8c"
        }
        text_selected {
            base "#0a1017"
            background "#f0a020"
            emphasis_0 "#5d3e0c"
            emphasis_1 "#38464b"
            emphasis_2 "#3c482b"
            emphasis_3 "#5b3a49"
        }
        table_cell_unselected {
            base "#f0a020"
            background "#0a1017"
            emphasis_0 "#f0a020"
            emphasis_1 "#7a9ea8"
            emphasis_2 "#7a9c4a"
            emphasis_3 "#c95a8c"
        }
        table_cell_selected {
            base "#ffd9a0"
            background "#4a3416"
            emphasis_0 "#f0a020"
            emphasis_1 "#85a6b0"
            emphasis_2 "#8eab65"
            emphasis_3 "#d889ac"
        }
        list_unselected {
            base "#f0a020"
            background "#0a1017"
            emphasis_0 "#f0a020"
            emphasis_1 "#7a9ea8"
            emphasis_2 "#7a9c4a"
            emphasis_3 "#c95a8c"
        }
        list_selected {
            base "#ffd9a0"
            background "#4a3416"
            emphasis_0 "#f0a020"
            emphasis_1 "#85a6b0"
            emphasis_2 "#8eab65"
            emphasis_3 "#d889ac"
        }
        ribbon_selected {
            base "#0a1017"
            background "#7a9c4a"
            emphasis_0 "#4a1e09"
            emphasis_1 "#3a2708"
            emphasis_2 "#441e2f"
            emphasis_3 "#1a2b45"
        }
        ribbon_unselected {
            base "#0a1017"
            background "#f0a020"
            emphasis_0 "#732f0e"
            emphasis_1 "#f0a020"
            emphasis_2 "#28456e"
            emphasis_3 "#6c304b"
        }
        table_title {
            base "#7a9c4a"
            background "#0a1017"
            emphasis_0 "#f0a020"
            emphasis_1 "#7a9ea8"
            emphasis_2 "#7a9c4a"
            emphasis_3 "#c95a8c"
        }
        frame_unselected {
            base "#f0a020"
            background "#0a1017"
            emphasis_0 "#f0a020"
            emphasis_1 "#f0a020"
            emphasis_2 "#f0a020"
            emphasis_3 "#f0a020"
        }
        frame_selected {
            base "#7a9c4a"
            background "#0a1017"
            emphasis_0 "#f0a020"
            emphasis_1 "#7a9ea8"
            emphasis_2 "#7a9c4a"
            emphasis_3 "#c95a8c"
        }
        frame_highlight {
            base "#f0a020"
            background "#0a1017"
            emphasis_0 "#c95a8c"
            emphasis_1 "#f0a020"
            emphasis_2 "#f0a020"
            emphasis_3 "#f0a020"
        }
        exit_code_success {
            base "#7a9c4a"
            background "#0a1017"
            emphasis_0 "#7a9ea8"
            emphasis_1 "#f0a020"
            emphasis_2 "#c95a8c"
            emphasis_3 "#4a7ec9"
        }
        exit_code_error {
            base "#e05c1c"
            background "#0a1017"
            emphasis_0 "#f0a020"
            emphasis_1 "#f0a020"
            emphasis_2 "#c95a8c"
            emphasis_3 "#4a7ec9"
        }
        multiplayer_user_colors {
            player_1 "#c95a8c"
            player_2 "#4a7ec9"
            player_3 "#ff7fa8"
            player_4 "#f0a020"
            player_5 "#7a9ea8"
            player_6 "#ffd700"
            player_7 "#e05c1c"
            player_8 "#ffd9a0"
            player_9 "#ff7832"
            player_10 "#6b9fff"
        }
    }
}
