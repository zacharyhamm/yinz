themes {
    "cobalt-next-dark" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Cobalt%20Next%20Dark
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#001018"
        terminal {
            foreground "#d7deea"
            background "#0b1c24"
            black "#262f37"
            red "#f94967"
            green "#8cc98f"
            yellow "#ffc64c"
            blue "#409dd4"
            magenta "#cba3c7"
            cyan "#37b5b4"
            white "#d7deea"
            bright_black "#62747f"
            bright_red "#e47e8b"
            bright_green "#baddbb"
            bright_yellow "#ffdc91"
            bright_blue "#7ac0eb"
            bright_magenta "#f3ccef"
            bright_cyan "#84e4e3"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#d7deea"
            background "#0b1c24"
            emphasis_0 "#ffc64c"
            emphasis_1 "#37b5b4"
            emphasis_2 "#8cc98f"
            emphasis_3 "#cba3c7"
        }
        text_selected {
            base "#3a3a3a"
            background "#37b5b4"
            emphasis_0 "#483815"
            emphasis_1 "#144141"
            emphasis_2 "#2c3f2d"
            emphasis_3 "#443743"
        }
        table_cell_unselected {
            base "#d7deea"
            background "#0b1c24"
            emphasis_0 "#ffc64c"
            emphasis_1 "#37b5b4"
            emphasis_2 "#8cc98f"
            emphasis_3 "#cba3c7"
        }
        table_cell_selected {
            base "#3a3a3a"
            background "#37b5b4"
            emphasis_0 "#483815"
            emphasis_1 "#144141"
            emphasis_2 "#2c3f2d"
            emphasis_3 "#443743"
        }
        list_unselected {
            base "#d7deea"
            background "#0b1c24"
            emphasis_0 "#ffc64c"
            emphasis_1 "#37b5b4"
            emphasis_2 "#8cc98f"
            emphasis_3 "#cba3c7"
        }
        list_selected {
            base "#3a3a3a"
            background "#37b5b4"
            emphasis_0 "#483815"
            emphasis_1 "#144141"
            emphasis_2 "#2c3f2d"
            emphasis_3 "#443743"
        }
        ribbon_selected {
            base "#0b1c24"
            background "#8cc98f"
            emphasis_0 "#882838"
            emphasis_1 "#5d481c"
            emphasis_2 "#574655"
            emphasis_3 "#204f6b"
        }
        ribbon_unselected {
            base "#0b1c24"
            background "#d7deea"
            emphasis_0 "#b03449"
            emphasis_1 "#d7deea"
            emphasis_2 "#2a678c"
            emphasis_3 "#725b70"
        }
        table_title {
            base "#8cc98f"
            background "#0b1c24"
            emphasis_0 "#ffc64c"
            emphasis_1 "#37b5b4"
            emphasis_2 "#8cc98f"
            emphasis_3 "#cba3c7"
        }
        frame_unselected {
            base "#d7deea"
            background "#0b1c24"
            emphasis_0 "#d7deea"
            emphasis_1 "#d7deea"
            emphasis_2 "#d7deea"
            emphasis_3 "#d7deea"
        }
        frame_selected {
            base "#8cc98f"
            background "#0b1c24"
            emphasis_0 "#ffc64c"
            emphasis_1 "#37b5b4"
            emphasis_2 "#8cc98f"
            emphasis_3 "#cba3c7"
        }
        frame_highlight {
            base "#ffc64c"
            background "#0b1c24"
            emphasis_0 "#cba3c7"
            emphasis_1 "#ffc64c"
            emphasis_2 "#ffc64c"
            emphasis_3 "#ffc64c"
        }
        exit_code_success {
            base "#8cc98f"
            background "#0b1c24"
            emphasis_0 "#37b5b4"
            emphasis_1 "#d7deea"
            emphasis_2 "#cba3c7"
            emphasis_3 "#409dd4"
        }
        exit_code_error {
            base "#f94967"
            background "#0b1c24"
            emphasis_0 "#ffc64c"
            emphasis_1 "#d7deea"
            emphasis_2 "#cba3c7"
            emphasis_3 "#409dd4"
        }
        multiplayer_user_colors {
            player_1 "#cba3c7"
            player_2 "#409dd4"
            player_3 "#f3ccef"
            player_4 "#ffc64c"
            player_5 "#37b5b4"
            player_6 "#ffdc91"
            player_7 "#f94967"
            player_8 "#d7deea"
            player_9 "#e47e8b"
            player_10 "#7ac0eb"
        }
    }
}
