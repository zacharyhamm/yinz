themes {
    "kurokula" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Kurokula
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#080909"
        terminal {
            foreground "#e0cfc2"
            background "#141515"
            black "#333333"
            red "#c35a52"
            green "#78b3a9"
            yellow "#e1b917"
            blue "#5c91dd"
            magenta "#8b79a6"
            cyan "#867268"
            white "#e0cfc2"
            bright_black "#515151"
            bright_red "#ffc34c"
            bright_green "#afffa5"
            bright_yellow "#fff700"
            bright_blue "#90dbff"
            bright_magenta "#ad93ff"
            bright_cyan "#ffcdb6"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#e0cfc2"
            background "#141515"
            emphasis_0 "#e1b917"
            emphasis_1 "#8e7b71"
            emphasis_2 "#78b3a9"
            emphasis_3 "#8b79a6"
        }
        text_selected {
            base "#141515"
            background "#e0cfc2"
            emphasis_0 "#6a5916"
            emphasis_1 "#5d5a57"
            emphasis_2 "#4b5e5b"
            emphasis_3 "#5d5963"
        }
        table_cell_unselected {
            base "#e0cfc2"
            background "#141515"
            emphasis_0 "#e1b917"
            emphasis_1 "#8e7b71"
            emphasis_2 "#78b3a9"
            emphasis_3 "#8b79a6"
        }
        table_cell_selected {
            base "#ffc34c"
            background "#515151"
            emphasis_0 "#e4c130"
            emphasis_1 "#cac2bd"
            emphasis_2 "#a3cbc5"
            emphasis_3 "#c8c0d5"
        }
        list_unselected {
            base "#e0cfc2"
            background "#141515"
            emphasis_0 "#e1b917"
            emphasis_1 "#8e7b71"
            emphasis_2 "#78b3a9"
            emphasis_3 "#8b79a6"
        }
        list_selected {
            base "#ffc34c"
            background "#515151"
            emphasis_0 "#e4c130"
            emphasis_1 "#cac2bd"
            emphasis_2 "#a3cbc5"
            emphasis_3 "#c8c0d5"
        }
        ribbon_selected {
            base "#141515"
            background "#78b3a9"
            emphasis_0 "#632e2a"
            emphasis_1 "#493c07"
            emphasis_2 "#433a50"
            emphasis_3 "#273e5e"
        }
        ribbon_unselected {
            base "#141515"
            background "#e0cfc2"
            emphasis_0 "#91433d"
            emphasis_1 "#e0cfc2"
            emphasis_2 "#3a5b8b"
            emphasis_3 "#625575"
        }
        table_title {
            base "#78b3a9"
            background "#141515"
            emphasis_0 "#e1b917"
            emphasis_1 "#8e7b71"
            emphasis_2 "#78b3a9"
            emphasis_3 "#8b79a6"
        }
        frame_unselected {
            base "#e0cfc2"
            background "#141515"
            emphasis_0 "#e0cfc2"
            emphasis_1 "#e0cfc2"
            emphasis_2 "#e0cfc2"
            emphasis_3 "#e0cfc2"
        }
        frame_selected {
            base "#78b3a9"
            background "#141515"
            emphasis_0 "#e1b917"
            emphasis_1 "#8e7b71"
            emphasis_2 "#78b3a9"
            emphasis_3 "#8b79a6"
        }
        frame_highlight {
            base "#e1b917"
            background "#141515"
            emphasis_0 "#8b79a6"
            emphasis_1 "#e1b917"
            emphasis_2 "#e1b917"
            emphasis_3 "#e1b917"
        }
        exit_code_success {
            base "#78b3a9"
            background "#141515"
            emphasis_0 "#8e7b71"
            emphasis_1 "#e0cfc2"
            emphasis_2 "#8b79a6"
            emphasis_3 "#5c91dd"
        }
        exit_code_error {
            base "#c56058"
            background "#141515"
            emphasis_0 "#e1b917"
            emphasis_1 "#e0cfc2"
            emphasis_2 "#8b79a6"
            emphasis_3 "#5c91dd"
        }
        multiplayer_user_colors {
            player_1 "#8b79a6"
            player_2 "#5c91dd"
            player_3 "#ad93ff"
            player_4 "#e1b917"
            player_5 "#8e7b71"
            player_6 "#fff700"
            player_7 "#c56058"
            player_8 "#e0cfc2"
            player_9 "#ffc34c"
            player_10 "#90dbff"
        }
    }
}
