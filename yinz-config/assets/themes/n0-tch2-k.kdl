themes {
    "n0-tch2-k" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/N0Tch2K
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#161616"
        terminal {
            foreground "#a0a0a0"
            background "#222222"
            black "#383838"
            red "#a95551"
            green "#666666"
            yellow "#a98051"
            blue "#657d3e"
            magenta "#767676"
            cyan "#c9c9c9"
            white "#d0b8a3"
            bright_black "#545454"
            bright_red "#a97775"
            bright_green "#8c8c8c"
            bright_yellow "#a99175"
            bright_blue "#98bd5e"
            bright_magenta "#a3a3a3"
            bright_cyan "#dcdcdc"
            bright_white "#d8c8bb"
        }
        text_unselected {
            base "#a0a0a0"
            background "#222222"
            emphasis_0 "#aa8152"
            emphasis_1 "#c9c9c9"
            emphasis_2 "#898989"
            emphasis_3 "#898989"
        }
        text_selected {
            base "#222222"
            background "#a0a0a0"
            emphasis_0 "#3c362e"
            emphasis_1 "#373737"
            emphasis_2 "#373737"
            emphasis_3 "#373737"
        }
        table_cell_unselected {
            base "#a0a0a0"
            background "#222222"
            emphasis_0 "#aa8152"
            emphasis_1 "#c9c9c9"
            emphasis_2 "#898989"
            emphasis_3 "#898989"
        }
        table_cell_selected {
            base "#ffffff"
            background "#4d4d4d"
            emphasis_0 "#d0baa0"
            emphasis_1 "#c9c9c9"
            emphasis_2 "#bebebe"
            emphasis_3 "#bebebe"
        }
        list_unselected {
            base "#a0a0a0"
            background "#222222"
            emphasis_0 "#aa8152"
            emphasis_1 "#c9c9c9"
            emphasis_2 "#898989"
            emphasis_3 "#898989"
        }
        list_selected {
            base "#ffffff"
            background "#4d4d4d"
            emphasis_0 "#d0baa0"
            emphasis_1 "#c9c9c9"
            emphasis_2 "#bebebe"
            emphasis_3 "#bebebe"
        }
        ribbon_selected {
            base "#e4e4e4"
            background "#666666"
            emphasis_0 "#f0e1e0"
            emphasis_1 "#ece3d8"
            emphasis_2 "#e4e4e4"
            emphasis_3 "#e1e6d9"
        }
        ribbon_unselected {
            base "#222222"
            background "#a0a0a0"
            emphasis_0 "#562b29"
            emphasis_1 "#a0a0a0"
            emphasis_2 "#303b1d"
            emphasis_3 "#373737"
        }
        table_title {
            base "#898989"
            background "#222222"
            emphasis_0 "#aa8152"
            emphasis_1 "#c9c9c9"
            emphasis_2 "#898989"
            emphasis_3 "#898989"
        }
        frame_unselected {
            base "#a0a0a0"
            background "#222222"
            emphasis_0 "#a0a0a0"
            emphasis_1 "#a0a0a0"
            emphasis_2 "#a0a0a0"
            emphasis_3 "#a0a0a0"
        }
        frame_selected {
            base "#898989"
            background "#222222"
            emphasis_0 "#aa8152"
            emphasis_1 "#c9c9c9"
            emphasis_2 "#898989"
            emphasis_3 "#898989"
        }
        frame_highlight {
            base "#aa8152"
            background "#222222"
            emphasis_0 "#898989"
            emphasis_1 "#aa8152"
            emphasis_2 "#aa8152"
            emphasis_3 "#aa8152"
        }
        exit_code_success {
            base "#898989"
            background "#222222"
            emphasis_0 "#c9c9c9"
            emphasis_1 "#a0a0a0"
            emphasis_2 "#898989"
            emphasis_3 "#7b905a"
        }
        exit_code_error {
            base "#ba7774"
            background "#222222"
            emphasis_0 "#aa8152"
            emphasis_1 "#a0a0a0"
            emphasis_2 "#898989"
            emphasis_3 "#7b905a"
        }
        multiplayer_user_colors {
            player_1 "#898989"
            player_2 "#7b905a"
            player_3 "#a3a3a3"
            player_4 "#aa8152"
            player_5 "#c9c9c9"
            player_6 "#a99175"
            player_7 "#ba7774"
            player_8 "#d0b8a3"
            player_9 "#ad7d7b"
            player_10 "#98bd5e"
        }
    }
}
