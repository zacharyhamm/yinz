themes {
    "noctis-obscuro" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Noctis%20Obscuro
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#00080b"
        terminal {
            foreground "#b2cacd"
            background "#031417"
            black "#324a4d"
            red "#e66533"
            green "#49e9a6"
            yellow "#e4b781"
            blue "#49ace9"
            magenta "#df769b"
            cyan "#49d6e9"
            white "#b2cacd"
            bright_black "#47686c"
            bright_red "#e97749"
            bright_green "#60ebb1"
            bright_yellow "#e69533"
            bright_blue "#60b6eb"
            bright_magenta "#e798b3"
            bright_cyan "#60dbeb"
            bright_white "#c1d4d7"
        }
        text_unselected {
            base "#b2cacd"
            background "#031417"
            emphasis_0 "#e4b781"
            emphasis_1 "#49d6e9"
            emphasis_2 "#49e9a6"
            emphasis_3 "#df769b"
        }
        text_selected {
            base "#031417"
            background "#b2cacd"
            emphasis_0 "#624f38"
            emphasis_1 "#1f5a62"
            emphasis_2 "#1d5d42"
            emphasis_3 "#7a4155"
        }
        table_cell_unselected {
            base "#b2cacd"
            background "#031417"
            emphasis_0 "#e4b781"
            emphasis_1 "#49d6e9"
            emphasis_2 "#49e9a6"
            emphasis_3 "#df769b"
        }
        table_cell_selected {
            base "#b2cacd"
            background "#0d2a2f"
            emphasis_0 "#e4b781"
            emphasis_1 "#49d6e9"
            emphasis_2 "#49e9a6"
            emphasis_3 "#df769b"
        }
        list_unselected {
            base "#b2cacd"
            background "#031417"
            emphasis_0 "#e4b781"
            emphasis_1 "#49d6e9"
            emphasis_2 "#49e9a6"
            emphasis_3 "#df769b"
        }
        list_selected {
            base "#b2cacd"
            background "#0d2a2f"
            emphasis_0 "#e4b781"
            emphasis_1 "#49d6e9"
            emphasis_2 "#49e9a6"
            emphasis_3 "#df769b"
        }
        ribbon_selected {
            base "#031417"
            background "#49e9a6"
            emphasis_0 "#924020"
            emphasis_1 "#6a553c"
            emphasis_2 "#83455b"
            emphasis_3 "#285d7e"
        }
        ribbon_unselected {
            base "#031417"
            background "#b2cacd"
            emphasis_0 "#883c1e"
            emphasis_1 "#b2cacd"
            emphasis_2 "#255776"
            emphasis_3 "#7a4155"
        }
        table_title {
            base "#49e9a6"
            background "#031417"
            emphasis_0 "#e4b781"
            emphasis_1 "#49d6e9"
            emphasis_2 "#49e9a6"
            emphasis_3 "#df769b"
        }
        frame_unselected {
            base "#b2cacd"
            background "#031417"
            emphasis_0 "#b2cacd"
            emphasis_1 "#b2cacd"
            emphasis_2 "#b2cacd"
            emphasis_3 "#b2cacd"
        }
        frame_selected {
            base "#49e9a6"
            background "#031417"
            emphasis_0 "#e4b781"
            emphasis_1 "#49d6e9"
            emphasis_2 "#49e9a6"
            emphasis_3 "#df769b"
        }
        frame_highlight {
            base "#e4b781"
            background "#031417"
            emphasis_0 "#df769b"
            emphasis_1 "#e4b781"
            emphasis_2 "#e4b781"
            emphasis_3 "#e4b781"
        }
        exit_code_success {
            base "#49e9a6"
            background "#031417"
            emphasis_0 "#49d6e9"
            emphasis_1 "#b2cacd"
            emphasis_2 "#df769b"
            emphasis_3 "#49ace9"
        }
        exit_code_error {
            base "#e66533"
            background "#031417"
            emphasis_0 "#e4b781"
            emphasis_1 "#b2cacd"
            emphasis_2 "#df769b"
            emphasis_3 "#49ace9"
        }
        multiplayer_user_colors {
            player_1 "#df769b"
            player_2 "#49ace9"
            player_3 "#e798b3"
            player_4 "#e4b781"
            player_5 "#49d6e9"
            player_6 "#e69533"
            player_7 "#e66533"
            player_8 "#b2cacd"
            player_9 "#e97749"
            player_10 "#60b6eb"
        }
    }
}
