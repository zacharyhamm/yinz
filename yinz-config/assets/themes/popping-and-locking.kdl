themes {
    "popping-and-locking" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Popping%20And%20Locking
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#0c0d15"
        terminal {
            foreground "#ebdbb2"
            background "#181921"
            black "#1d2021"
            red "#cc241d"
            green "#98971a"
            yellow "#d79921"
            blue "#458588"
            magenta "#b16286"
            cyan "#689d6a"
            white "#a89984"
            bright_black "#928374"
            bright_red "#f42c3e"
            bright_green "#b8bb26"
            bright_yellow "#fabd2f"
            bright_blue "#99c6ca"
            bright_magenta "#d3869b"
            bright_cyan "#7ec16e"
            bright_white "#ebdbb2"
        }
        text_unselected {
            base "#ebdbb2"
            background "#181921"
            emphasis_0 "#d79921"
            emphasis_1 "#689d6a"
            emphasis_2 "#98971a"
            emphasis_3 "#b56a8c"
        }
        text_selected {
            base "#6a5f54"
            background "#ebdbb2"
            emphasis_0 "#7e5a13"
            emphasis_1 "#466947"
            emphasis_2 "#656411"
            emphasis_3 "#8c4d6a"
        }
        table_cell_unselected {
            base "#ebdbb2"
            background "#181921"
            emphasis_0 "#d79921"
            emphasis_1 "#689d6a"
            emphasis_2 "#98971a"
            emphasis_3 "#b56a8c"
        }
        table_cell_selected {
            base "#6a5f54"
            background "#ebdbb2"
            emphasis_0 "#7e5a13"
            emphasis_1 "#466947"
            emphasis_2 "#656411"
            emphasis_3 "#8c4d6a"
        }
        list_unselected {
            base "#ebdbb2"
            background "#181921"
            emphasis_0 "#d79921"
            emphasis_1 "#689d6a"
            emphasis_2 "#98971a"
            emphasis_3 "#b56a8c"
        }
        list_selected {
            base "#6a5f54"
            background "#ebdbb2"
            emphasis_0 "#7e5a13"
            emphasis_1 "#466947"
            emphasis_2 "#656411"
            emphasis_3 "#8c4d6a"
        }
        ribbon_selected {
            base "#181921"
            background "#98971a"
            emphasis_0 "#59100d"
            emphasis_1 "#3a2909"
            emphasis_2 "#402330"
            emphasis_3 "#192f31"
        }
        ribbon_unselected {
            base "#181921"
            background "#ebdbb2"
            emphasis_0 "#bd211b"
            emphasis_1 "#ebdbb2"
            emphasis_2 "#37696c"
            emphasis_3 "#8c4d6a"
        }
        table_title {
            base "#98971a"
            background "#181921"
            emphasis_0 "#d79921"
            emphasis_1 "#689d6a"
            emphasis_2 "#98971a"
            emphasis_3 "#b56a8c"
        }
        frame_unselected {
            base "#ebdbb2"
            background "#181921"
            emphasis_0 "#ebdbb2"
            emphasis_1 "#ebdbb2"
            emphasis_2 "#ebdbb2"
            emphasis_3 "#ebdbb2"
        }
        frame_selected {
            base "#98971a"
            background "#181921"
            emphasis_0 "#d79921"
            emphasis_1 "#689d6a"
            emphasis_2 "#98971a"
            emphasis_3 "#b56a8c"
        }
        frame_highlight {
            base "#d79921"
            background "#181921"
            emphasis_0 "#b56a8c"
            emphasis_1 "#d79921"
            emphasis_2 "#d79921"
            emphasis_3 "#d79921"
        }
        exit_code_success {
            base "#98971a"
            background "#181921"
            emphasis_0 "#689d6a"
            emphasis_1 "#ebdbb2"
            emphasis_2 "#b56a8c"
            emphasis_3 "#4e8b8e"
        }
        exit_code_error {
            base "#d85751"
            background "#181921"
            emphasis_0 "#d79921"
            emphasis_1 "#ebdbb2"
            emphasis_2 "#b56a8c"
            emphasis_3 "#4e8b8e"
        }
        multiplayer_user_colors {
            player_1 "#b56a8c"
            player_2 "#4e8b8e"
            player_3 "#d3869b"
            player_4 "#d79921"
            player_5 "#689d6a"
            player_6 "#fabd2f"
            player_7 "#d85751"
            player_8 "#a89984"
            player_9 "#f43344"
            player_10 "#99c6ca"
        }
    }
}
