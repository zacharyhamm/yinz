themes {
    "noctis-bordo" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Noctis%20Bordo
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#261e21"
        terminal {
            foreground "#cbbec2"
            background "#322a2d"
            black "#47393e"
            red "#e66533"
            green "#49e9a6"
            yellow "#e4b781"
            blue "#49ace9"
            magenta "#df769b"
            cyan "#49d6e9"
            white "#b9acb0"
            bright_black "#69545b"
            bright_red "#e97749"
            bright_green "#60ebb1"
            bright_yellow "#e69533"
            bright_blue "#60b6eb"
            bright_magenta "#e798b3"
            bright_cyan "#60dbeb"
            bright_white "#cbbec2"
        }
        text_unselected {
            base "#cbbec2"
            background "#322a2d"
            emphasis_0 "#e4b781"
            emphasis_1 "#49d6e9"
            emphasis_2 "#49e9a6"
            emphasis_3 "#df769b"
        }
        text_selected {
            base "#322a2d"
            background "#cbbec2"
            emphasis_0 "#5f4c36"
            emphasis_1 "#1e575f"
            emphasis_2 "#1c5a40"
            emphasis_3 "#704252"
        }
        table_cell_unselected {
            base "#cbbec2"
            background "#322a2d"
            emphasis_0 "#e4b781"
            emphasis_1 "#49d6e9"
            emphasis_2 "#49e9a6"
            emphasis_3 "#df769b"
        }
        table_cell_selected {
            base "#cbbec2"
            background "#4a3339"
            emphasis_0 "#e4b781"
            emphasis_1 "#49d6e9"
            emphasis_2 "#49e9a6"
            emphasis_3 "#e386a6"
        }
        list_unselected {
            base "#cbbec2"
            background "#322a2d"
            emphasis_0 "#e4b781"
            emphasis_1 "#49d6e9"
            emphasis_2 "#49e9a6"
            emphasis_3 "#df769b"
        }
        list_selected {
            base "#cbbec2"
            background "#4a3339"
            emphasis_0 "#e4b781"
            emphasis_1 "#49d6e9"
            emphasis_2 "#49e9a6"
            emphasis_3 "#e386a6"
        }
        ribbon_selected {
            base "#322a2d"
            background "#49e9a6"
            emphasis_0 "#924020"
            emphasis_1 "#6a553c"
            emphasis_2 "#83455b"
            emphasis_3 "#285d7e"
        }
        ribbon_unselected {
            base "#322a2d"
            background "#cbbec2"
            emphasis_0 "#83391d"
            emphasis_1 "#cbbec2"
            emphasis_2 "#245472"
            emphasis_3 "#763e52"
        }
        table_title {
            base "#49e9a6"
            background "#322a2d"
            emphasis_0 "#e4b781"
            emphasis_1 "#49d6e9"
            emphasis_2 "#49e9a6"
            emphasis_3 "#df769b"
        }
        frame_unselected {
            base "#cbbec2"
            background "#322a2d"
            emphasis_0 "#cbbec2"
            emphasis_1 "#cbbec2"
            emphasis_2 "#cbbec2"
            emphasis_3 "#cbbec2"
        }
        frame_selected {
            base "#49e9a6"
            background "#322a2d"
            emphasis_0 "#e4b781"
            emphasis_1 "#49d6e9"
            emphasis_2 "#49e9a6"
            emphasis_3 "#df769b"
        }
        frame_highlight {
            base "#e4b781"
            background "#322a2d"
            emphasis_0 "#df769b"
            emphasis_1 "#e4b781"
            emphasis_2 "#e4b781"
            emphasis_3 "#e4b781"
        }
        exit_code_success {
            base "#49e9a6"
            background "#322a2d"
            emphasis_0 "#49d6e9"
            emphasis_1 "#cbbec2"
            emphasis_2 "#df769b"
            emphasis_3 "#49ace9"
        }
        exit_code_error {
            base "#e86f40"
            background "#322a2d"
            emphasis_0 "#e4b781"
            emphasis_1 "#cbbec2"
            emphasis_2 "#df769b"
            emphasis_3 "#49ace9"
        }
        multiplayer_user_colors {
            player_1 "#df769b"
            player_2 "#49ace9"
            player_3 "#e798b3"
            player_4 "#e4b781"
            player_5 "#49d6e9"
            player_6 "#e69533"
            player_7 "#e86f40"
            player_8 "#b9acb0"
            player_9 "#e97749"
            player_10 "#60b6eb"
        }
    }
}
