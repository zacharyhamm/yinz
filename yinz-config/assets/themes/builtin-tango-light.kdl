themes {
    "builtin-tango-light" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Builtin%20Tango%20Light
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#f3f3f3"
        terminal {
            foreground "#000000"
            background "#ffffff"
            black "#000000"
            red "#cc0000"
            green "#4e9a06"
            yellow "#c4a000"
            blue "#3465a4"
            magenta "#75507b"
            cyan "#06989a"
            white "#b9bdb5"
            bright_black "#555753"
            bright_red "#ef2929"
            bright_green "#7dd527"
            bright_yellow "#d6c329"
            bright_blue "#729fcf"
            bright_magenta "#ad7fa8"
            bright_cyan "#27d5d5"
            bright_white "#eeeeec"
        }
        text_unselected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#8e7400"
            emphasis_1 "#058486"
            emphasis_2 "#448605"
            emphasis_3 "#75507b"
        }
        text_selected {
            base "#ffffff"
            background "#000000"
            emphasis_0 "#847429"
            emphasis_1 "#2f8081"
            emphasis_2 "#55802d"
            emphasis_3 "#896a8e"
        }
        table_cell_unselected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#8e7400"
            emphasis_1 "#058486"
            emphasis_2 "#448605"
            emphasis_3 "#75507b"
        }
        table_cell_selected {
            base "#000000"
            background "#b5d5ff"
            emphasis_0 "#6d5900"
            emphasis_1 "#046567"
            emphasis_2 "#346704"
            emphasis_3 "#724e78"
        }
        list_unselected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#8e7400"
            emphasis_1 "#058486"
            emphasis_2 "#448605"
            emphasis_3 "#75507b"
        }
        list_selected {
            base "#000000"
            background "#b5d5ff"
            emphasis_0 "#6d5900"
            emphasis_1 "#046567"
            emphasis_2 "#346704"
            emphasis_3 "#724e78"
        }
        ribbon_selected {
            base "#222222"
            background "#4e9a06"
            emphasis_0 "#4d0000"
            emphasis_1 "#292100"
            emphasis_2 "#2b1d2d"
            emphasis_3 "#122238"
        }
        ribbon_unselected {
            base "#ffffff"
            background "#000000"
            emphasis_0 "#d73838"
            emphasis_1 "#000000"
            emphasis_2 "#4b77ae"
            emphasis_3 "#8a6a8f"
        }
        table_title {
            base "#448605"
            background "#ffffff"
            emphasis_0 "#8e7400"
            emphasis_1 "#058486"
            emphasis_2 "#448605"
            emphasis_3 "#75507b"
        }
        frame_unselected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#000000"
            emphasis_1 "#000000"
            emphasis_2 "#000000"
            emphasis_3 "#000000"
        }
        frame_selected {
            base "#448605"
            background "#ffffff"
            emphasis_0 "#8e7400"
            emphasis_1 "#058486"
            emphasis_2 "#448605"
            emphasis_3 "#75507b"
        }
        frame_highlight {
            base "#8e7400"
            background "#ffffff"
            emphasis_0 "#75507b"
            emphasis_1 "#8e7400"
            emphasis_2 "#8e7400"
            emphasis_3 "#8e7400"
        }
        exit_code_success {
            base "#448605"
            background "#ffffff"
            emphasis_0 "#058486"
            emphasis_1 "#000000"
            emphasis_2 "#75507b"
            emphasis_3 "#3465a4"
        }
        exit_code_error {
            base "#cc0000"
            background "#ffffff"
            emphasis_0 "#8e7400"
            emphasis_1 "#000000"
            emphasis_2 "#75507b"
            emphasis_3 "#3465a4"
        }
        multiplayer_user_colors {
            player_1 "#75507b"
            player_2 "#3465a4"
            player_3 "#916a8c"
            player_4 "#8e7400"
            player_5 "#058486"
            player_6 "#837719"
            player_7 "#cc0000"
            player_8 "#757772"
            player_9 "#e52727"
            player_10 "#57799d"
        }
    }
}
