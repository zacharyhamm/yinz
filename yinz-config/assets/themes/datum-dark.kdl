themes {
    "datum-dark" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/datum%20%28dark%29
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#03070c"
        terminal {
            foreground "#dbe0e8"
            background "#0f1318"
            black "#2b2f35"
            red "#fe9864"
            green "#54dcaa"
            yellow "#e8df69"
            blue "#69b9f7"
            magenta "#fa94cd"
            cyan "#6ae5ec"
            white "#dbe0e8"
            bright_black "#8f98a3"
            bright_red "#f8bd5f"
            bright_green "#54dcaa"
            bright_yellow "#fcdcad"
            bright_blue "#b2dafb"
            bright_magenta "#f5b9d9"
            bright_cyan "#a5f5f9"
            bright_white "#eef2f7"
        }
        text_unselected {
            base "#dbe0e8"
            background "#0f1318"
            emphasis_0 "#e8df69"
            emphasis_1 "#6ae5ec"
            emphasis_2 "#54dcaa"
            emphasis_3 "#fa94cd"
        }
        text_selected {
            base "#0f1318"
            background "#dbe0e8"
            emphasis_0 "#6a6530"
            emphasis_1 "#326c6f"
            emphasis_2 "#2a6f56"
            emphasis_3 "#895171"
        }
        table_cell_unselected {
            base "#dbe0e8"
            background "#0f1318"
            emphasis_0 "#e8df69"
            emphasis_1 "#6ae5ec"
            emphasis_2 "#54dcaa"
            emphasis_3 "#fa94cd"
        }
        table_cell_selected {
            base "#dbe0e8"
            background "#2b2f35"
            emphasis_0 "#e8df69"
            emphasis_1 "#6ae5ec"
            emphasis_2 "#54dcaa"
            emphasis_3 "#fa94cd"
        }
        list_unselected {
            base "#dbe0e8"
            background "#0f1318"
            emphasis_0 "#e8df69"
            emphasis_1 "#6ae5ec"
            emphasis_2 "#54dcaa"
            emphasis_3 "#fa94cd"
        }
        list_selected {
            base "#dbe0e8"
            background "#2b2f35"
            emphasis_0 "#e8df69"
            emphasis_1 "#6ae5ec"
            emphasis_2 "#54dcaa"
            emphasis_3 "#fa94cd"
        }
        ribbon_selected {
            base "#0f1318"
            background "#54dcaa"
            emphasis_0 "#76462e"
            emphasis_1 "#575428"
            emphasis_2 "#72435d"
            emphasis_3 "#315673"
        }
        ribbon_unselected {
            base "#0f1318"
            background "#dbe0e8"
            emphasis_0 "#8e5538"
            emphasis_1 "#dbe0e8"
            emphasis_2 "#3a678a"
            emphasis_3 "#895171"
        }
        table_title {
            base "#54dcaa"
            background "#0f1318"
            emphasis_0 "#e8df69"
            emphasis_1 "#6ae5ec"
            emphasis_2 "#54dcaa"
            emphasis_3 "#fa94cd"
        }
        frame_unselected {
            base "#dbe0e8"
            background "#0f1318"
            emphasis_0 "#dbe0e8"
            emphasis_1 "#dbe0e8"
            emphasis_2 "#dbe0e8"
            emphasis_3 "#dbe0e8"
        }
        frame_selected {
            base "#54dcaa"
            background "#0f1318"
            emphasis_0 "#e8df69"
            emphasis_1 "#6ae5ec"
            emphasis_2 "#54dcaa"
            emphasis_3 "#fa94cd"
        }
        frame_highlight {
            base "#e8df69"
            background "#0f1318"
            emphasis_0 "#fa94cd"
            emphasis_1 "#e8df69"
            emphasis_2 "#e8df69"
            emphasis_3 "#e8df69"
        }
        exit_code_success {
            base "#54dcaa"
            background "#0f1318"
            emphasis_0 "#6ae5ec"
            emphasis_1 "#dbe0e8"
            emphasis_2 "#fa94cd"
            emphasis_3 "#69b9f7"
        }
        exit_code_error {
            base "#fe9864"
            background "#0f1318"
            emphasis_0 "#e8df69"
            emphasis_1 "#dbe0e8"
            emphasis_2 "#fa94cd"
            emphasis_3 "#69b9f7"
        }
        multiplayer_user_colors {
            player_1 "#fa94cd"
            player_2 "#69b9f7"
            player_3 "#f5b9d9"
            player_4 "#e8df69"
            player_5 "#6ae5ec"
            player_6 "#fcdcad"
            player_7 "#fe9864"
            player_8 "#dbe0e8"
            player_9 "#f8bd5f"
            player_10 "#b2dafb"
        }
    }
}
