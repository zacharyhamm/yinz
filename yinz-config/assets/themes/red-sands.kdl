themes {
    "red-sands" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Red%20Sands
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#6e1912"
        terminal {
            foreground "#d7c9a7"
            background "#7a251e"
            black "#000000"
            red "#ff3f00"
            green "#00bb00"
            yellow "#e7b000"
            blue "#0072ff"
            magenta "#bb00bb"
            cyan "#00bbbb"
            white "#bbbbbb"
            bright_black "#6e6e6e"
            bright_red "#d41a1a"
            bright_green "#00bb00"
            bright_yellow "#e7b000"
            bright_blue "#0072ae"
            bright_magenta "#ff55ff"
            bright_cyan "#55ffff"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#d7c9a7"
            background "#7a251e"
            emphasis_0 "#e7b000"
            emphasis_1 "#19c2c2"
            emphasis_2 "#33c933"
            emphasis_3 "#e293e2"
        }
        text_selected {
            base "#000000"
            background "#a4a390"
            emphasis_0 "#483700"
            emphasis_1 "#004040"
            emphasis_2 "#004300"
            emphasis_3 "#6a006a"
        }
        table_cell_unselected {
            base "#d7c9a7"
            background "#7a251e"
            emphasis_0 "#e7b000"
            emphasis_1 "#19c2c2"
            emphasis_2 "#33c933"
            emphasis_3 "#e293e2"
        }
        table_cell_selected {
            base "#000000"
            background "#a4a390"
            emphasis_0 "#483700"
            emphasis_1 "#004040"
            emphasis_2 "#004300"
            emphasis_3 "#6a006a"
        }
        list_unselected {
            base "#d7c9a7"
            background "#7a251e"
            emphasis_0 "#e7b000"
            emphasis_1 "#19c2c2"
            emphasis_2 "#33c933"
            emphasis_3 "#e293e2"
        }
        list_selected {
            base "#000000"
            background "#a4a390"
            emphasis_0 "#483700"
            emphasis_1 "#004040"
            emphasis_2 "#004300"
            emphasis_3 "#6a006a"
        }
        ribbon_selected {
            base "#681f1a"
            background "#00bb00"
            emphasis_0 "#6c1b00"
            emphasis_1 "#473600"
            emphasis_2 "#680068"
            emphasis_3 "#003678"
        }
        ribbon_unselected {
            base "#7a251e"
            background "#d7c9a7"
            emphasis_0 "#a22800"
            emphasis_1 "#d7c9a7"
            emphasis_2 "#0051b5"
            emphasis_3 "#9a009a"
        }
        table_title {
            base "#33c933"
            background "#7a251e"
            emphasis_0 "#e7b000"
            emphasis_1 "#19c2c2"
            emphasis_2 "#33c933"
            emphasis_3 "#e293e2"
        }
        frame_unselected {
            base "#d7c9a7"
            background "#7a251e"
            emphasis_0 "#d7c9a7"
            emphasis_1 "#d7c9a7"
            emphasis_2 "#d7c9a7"
            emphasis_3 "#d7c9a7"
        }
        frame_selected {
            base "#33c933"
            background "#7a251e"
            emphasis_0 "#e7b000"
            emphasis_1 "#19c2c2"
            emphasis_2 "#33c933"
            emphasis_3 "#e293e2"
        }
        frame_highlight {
            base "#e7b000"
            background "#7a251e"
            emphasis_0 "#e293e2"
            emphasis_1 "#e7b000"
            emphasis_2 "#e7b000"
            emphasis_3 "#e7b000"
        }
        exit_code_success {
            base "#33c933"
            background "#7a251e"
            emphasis_0 "#19c2c2"
            emphasis_1 "#d7c9a7"
            emphasis_2 "#e293e2"
            emphasis_3 "#73b2ff"
        }
        exit_code_error {
            base "#ff916d"
            background "#7a251e"
            emphasis_0 "#e7b000"
            emphasis_1 "#d7c9a7"
            emphasis_2 "#e293e2"
            emphasis_3 "#73b2ff"
        }
        multiplayer_user_colors {
            player_1 "#e293e2"
            player_2 "#73b2ff"
            player_3 "#ff7bff"
            player_4 "#e7b000"
            player_5 "#19c2c2"
            player_6 "#e7b000"
            player_7 "#ff916d"
            player_8 "#bbbbbb"
            player_9 "#ec9898"
            player_10 "#7cb7d5"
        }
    }
}
