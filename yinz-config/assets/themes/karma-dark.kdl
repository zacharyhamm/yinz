themes {
    "karma-dark" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Karma%20Dark
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000208"
        terminal {
            foreground "#f7f1ff"
            background "#0a0e14"
            black "#0a0e14"
            red "#fc618d"
            green "#7bd88f"
            yellow "#fce566"
            blue "#5ad4e6"
            magenta "#af98e6"
            cyan "#5ad4e6"
            white "#bab6c0"
            bright_black "#69676c"
            bright_red "#ff7ba0"
            bright_green "#9ce3ab"
            bright_yellow "#fce566"
            bright_blue "#7fe0ee"
            bright_magenta "#c3b0f0"
            bright_cyan "#7fe0ee"
            bright_white "#f7f1ff"
        }
        text_unselected {
            base "#f7f1ff"
            background "#0a0e14"
            emphasis_0 "#fce566"
            emphasis_1 "#5ad4e6"
            emphasis_2 "#7bd88f"
            emphasis_3 "#af98e6"
        }
        text_selected {
            base "#0a0e14"
            background "#f7f1ff"
            emphasis_0 "#7b6f32"
            emphasis_1 "#347984"
            emphasis_2 "#467b51"
            emphasis_3 "#77679c"
        }
        table_cell_unselected {
            base "#f7f1ff"
            background "#0a0e14"
            emphasis_0 "#fce566"
            emphasis_1 "#5ad4e6"
            emphasis_2 "#7bd88f"
            emphasis_3 "#af98e6"
        }
        table_cell_selected {
            base "#f7f1ff"
            background "#3a384a"
            emphasis_0 "#fce566"
            emphasis_1 "#5ad4e6"
            emphasis_2 "#7bd88f"
            emphasis_3 "#af98e6"
        }
        list_unselected {
            base "#f7f1ff"
            background "#0a0e14"
            emphasis_0 "#fce566"
            emphasis_1 "#5ad4e6"
            emphasis_2 "#7bd88f"
            emphasis_3 "#af98e6"
        }
        list_selected {
            base "#f7f1ff"
            background "#3a384a"
            emphasis_0 "#fce566"
            emphasis_1 "#5ad4e6"
            emphasis_2 "#7bd88f"
            emphasis_3 "#af98e6"
        }
        ribbon_selected {
            base "#0a0e14"
            background "#7bd88f"
            emphasis_0 "#89354d"
            emphasis_1 "#5a5224"
            emphasis_2 "#564b72"
            emphasis_3 "#255860"
        }
        ribbon_unselected {
            base "#0a0e14"
            background "#f7f1ff"
            emphasis_0 "#ba4868"
            emphasis_1 "#f7f1ff"
            emphasis_2 "#347984"
            emphasis_3 "#77679c"
        }
        table_title {
            base "#7bd88f"
            background "#0a0e14"
            emphasis_0 "#fce566"
            emphasis_1 "#5ad4e6"
            emphasis_2 "#7bd88f"
            emphasis_3 "#af98e6"
        }
        frame_unselected {
            base "#f7f1ff"
            background "#0a0e14"
            emphasis_0 "#f7f1ff"
            emphasis_1 "#f7f1ff"
            emphasis_2 "#f7f1ff"
            emphasis_3 "#f7f1ff"
        }
        frame_selected {
            base "#7bd88f"
            background "#0a0e14"
            emphasis_0 "#fce566"
            emphasis_1 "#5ad4e6"
            emphasis_2 "#7bd88f"
            emphasis_3 "#af98e6"
        }
        frame_highlight {
            base "#fce566"
            background "#0a0e14"
            emphasis_0 "#af98e6"
            emphasis_1 "#fce566"
            emphasis_2 "#fce566"
            emphasis_3 "#fce566"
        }
        exit_code_success {
            base "#7bd88f"
            background "#0a0e14"
            emphasis_0 "#5ad4e6"
            emphasis_1 "#f7f1ff"
            emphasis_2 "#af98e6"
            emphasis_3 "#5ad4e6"
        }
        exit_code_error {
            base "#fc618d"
            background "#0a0e14"
            emphasis_0 "#fce566"
            emphasis_1 "#f7f1ff"
            emphasis_2 "#af98e6"
            emphasis_3 "#5ad4e6"
        }
        multiplayer_user_colors {
            player_1 "#af98e6"
            player_2 "#5ad4e6"
            player_3 "#c3b0f0"
            player_4 "#fce566"
            player_5 "#5ad4e6"
            player_6 "#fce566"
            player_7 "#fc618d"
            player_8 "#bab6c0"
            player_9 "#ff7ba0"
            player_10 "#7fe0ee"
        }
    }
}
