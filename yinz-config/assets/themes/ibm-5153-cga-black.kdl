themes {
    "ibm-5153-cga-black" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/IBM%205153%20CGA%20%28Black%29
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000000"
        terminal {
            foreground "#c4c4c4"
            background "#000000"
            black "#000000"
            red "#c40000"
            green "#00c400"
            yellow "#c47e00"
            blue "#0000c4"
            magenta "#c400c4"
            cyan "#00c4c4"
            white "#c4c4c4"
            bright_black "#4e4e4e"
            bright_red "#dc4e4e"
            bright_green "#4edc4e"
            bright_yellow "#f3f34e"
            bright_blue "#4e4edc"
            bright_magenta "#f34ef3"
            bright_cyan "#4ef3f3"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#c4c4c4"
            background "#000000"
            emphasis_0 "#c47e00"
            emphasis_1 "#00c4c4"
            emphasis_2 "#00c400"
            emphasis_3 "#ca19ca"
        }
        text_selected {
            base "#000000"
            background "#c4c4c4"
            emphasis_0 "#724900"
            emphasis_1 "#005b5b"
            emphasis_2 "#006000"
            emphasis_3 "#930093"
        }
        table_cell_unselected {
            base "#c4c4c4"
            background "#000000"
            emphasis_0 "#c47e00"
            emphasis_1 "#00c4c4"
            emphasis_2 "#00c400"
            emphasis_3 "#ca19ca"
        }
        table_cell_selected {
            base "#000000"
            background "#c4c4c4"
            emphasis_0 "#724900"
            emphasis_1 "#005b5b"
            emphasis_2 "#006000"
            emphasis_3 "#930093"
        }
        list_unselected {
            base "#c4c4c4"
            background "#000000"
            emphasis_0 "#c47e00"
            emphasis_1 "#00c4c4"
            emphasis_2 "#00c400"
            emphasis_3 "#ca19ca"
        }
        list_selected {
            base "#000000"
            background "#c4c4c4"
            emphasis_0 "#724900"
            emphasis_1 "#005b5b"
            emphasis_2 "#006000"
            emphasis_3 "#930093"
        }
        ribbon_selected {
            base "#000000"
            background "#00c400"
            emphasis_0 "#830000"
            emphasis_1 "#573800"
            emphasis_2 "#730073"
            emphasis_3 "#0000c4"
        }
        ribbon_unselected {
            base "#000000"
            background "#c4c4c4"
            emphasis_0 "#a80000"
            emphasis_1 "#c4c4c4"
            emphasis_2 "#0000c4"
            emphasis_3 "#930093"
        }
        table_title {
            base "#00c400"
            background "#000000"
            emphasis_0 "#c47e00"
            emphasis_1 "#00c4c4"
            emphasis_2 "#00c400"
            emphasis_3 "#ca19ca"
        }
        frame_unselected {
            base "#c4c4c4"
            background "#000000"
            emphasis_0 "#c4c4c4"
            emphasis_1 "#c4c4c4"
            emphasis_2 "#c4c4c4"
            emphasis_3 "#c4c4c4"
        }
        frame_selected {
            base "#00c400"
            background "#000000"
            emphasis_0 "#c47e00"
            emphasis_1 "#00c4c4"
            emphasis_2 "#00c400"
            emphasis_3 "#ca19ca"
        }
        frame_highlight {
            base "#c47e00"
            background "#000000"
            emphasis_0 "#ca19ca"
            emphasis_1 "#c47e00"
            emphasis_2 "#c47e00"
            emphasis_3 "#c47e00"
        }
        exit_code_success {
            base "#00c400"
            background "#000000"
            emphasis_0 "#00c4c4"
            emphasis_1 "#c4c4c4"
            emphasis_2 "#ca19ca"
            emphasis_3 "#6767dc"
        }
        exit_code_error {
            base "#d33f3f"
            background "#000000"
            emphasis_0 "#c47e00"
            emphasis_1 "#c4c4c4"
            emphasis_2 "#ca19ca"
            emphasis_3 "#6767dc"
        }
        multiplayer_user_colors {
            player_1 "#ca19ca"
            player_2 "#6767dc"
            player_3 "#f34ef3"
            player_4 "#c47e00"
            player_5 "#00c4c4"
            player_6 "#f3f34e"
            player_7 "#d33f3f"
            player_8 "#c4c4c4"
            player_9 "#dc4e4e"
            player_10 "#6565e1"
        }
    }
}
