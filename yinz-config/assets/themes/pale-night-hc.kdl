themes {
    "pale-night-hc" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Pale%20Night%20Hc
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#323645"
        terminal {
            foreground "#cccccc"
            background "#3e4251"
            black "#000000"
            red "#f07178"
            green "#c3e88d"
            yellow "#ffcb6b"
            blue "#82aaff"
            magenta "#c792ea"
            cyan "#89ddff"
            white "#ffffff"
            bright_black "#737373"
            bright_red "#f6a9ae"
            bright_green "#dbf1ba"
            bright_yellow "#ffdfa6"
            bright_blue "#b4ccff"
            bright_magenta "#ddbdf2"
            bright_cyan "#b8eaff"
            bright_white "#999999"
        }
        text_unselected {
            base "#cccccc"
            background "#3e4251"
            emphasis_0 "#ffcb6b"
            emphasis_1 "#89ddff"
            emphasis_2 "#c3e88d"
            emphasis_3 "#cc9bec"
        }
        text_selected {
            base "#0f1817"
            background "#cccccc"
            emphasis_0 "#1b150b"
            emphasis_1 "#0f171b"
            emphasis_2 "#13170e"
            emphasis_3 "#1b131f"
        }
        table_cell_unselected {
            base "#cccccc"
            background "#3e4251"
            emphasis_0 "#ffcb6b"
            emphasis_1 "#89ddff"
            emphasis_2 "#c3e88d"
            emphasis_3 "#cc9bec"
        }
        table_cell_selected {
            base "#0f1817"
            background "#717cb4"
            emphasis_0 "#1b150b"
            emphasis_1 "#0f171b"
            emphasis_2 "#13170e"
            emphasis_3 "#1b131f"
        }
        list_unselected {
            base "#cccccc"
            background "#3e4251"
            emphasis_0 "#ffcb6b"
            emphasis_1 "#89ddff"
            emphasis_2 "#c3e88d"
            emphasis_3 "#cc9bec"
        }
        list_selected {
            base "#0f1817"
            background "#717cb4"
            emphasis_0 "#1b150b"
            emphasis_1 "#0f171b"
            emphasis_2 "#13170e"
            emphasis_3 "#1b131f"
        }
        ribbon_selected {
            base "#3e4251"
            background "#c3e88d"
            emphasis_0 "#98484c"
            emphasis_1 "#755d31"
            emphasis_2 "#735588"
            emphasis_3 "#496090"
        }
        ribbon_unselected {
            base "#3e4251"
            background "#cccccc"
            emphasis_0 "#894145"
            emphasis_1 "#cccccc"
            emphasis_2 "#425681"
            emphasis_3 "#684c7a"
        }
        table_title {
            base "#c3e88d"
            background "#3e4251"
            emphasis_0 "#ffcb6b"
            emphasis_1 "#89ddff"
            emphasis_2 "#c3e88d"
            emphasis_3 "#cc9bec"
        }
        frame_unselected {
            base "#cccccc"
            background "#3e4251"
            emphasis_0 "#cccccc"
            emphasis_1 "#cccccc"
            emphasis_2 "#cccccc"
            emphasis_3 "#cccccc"
        }
        frame_selected {
            base "#c3e88d"
            background "#3e4251"
            emphasis_0 "#ffcb6b"
            emphasis_1 "#89ddff"
            emphasis_2 "#c3e88d"
            emphasis_3 "#cc9bec"
        }
        frame_highlight {
            base "#ffcb6b"
            background "#3e4251"
            emphasis_0 "#cc9bec"
            emphasis_1 "#ffcb6b"
            emphasis_2 "#ffcb6b"
            emphasis_3 "#ffcb6b"
        }
        exit_code_success {
            base "#c3e88d"
            background "#3e4251"
            emphasis_0 "#89ddff"
            emphasis_1 "#cccccc"
            emphasis_2 "#cc9bec"
            emphasis_3 "#87aeff"
        }
        exit_code_error {
            base "#f49398"
            background "#3e4251"
            emphasis_0 "#ffcb6b"
            emphasis_1 "#cccccc"
            emphasis_2 "#cc9bec"
            emphasis_3 "#87aeff"
        }
        multiplayer_user_colors {
            player_1 "#cc9bec"
            player_2 "#87aeff"
            player_3 "#ddbdf2"
            player_4 "#ffcb6b"
            player_5 "#89ddff"
            player_6 "#ffdfa6"
            player_7 "#f49398"
            player_8 "#ffffff"
            player_9 "#f6a9ae"
            player_10 "#b4ccff"
        }
    }
}
