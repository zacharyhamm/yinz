themes {
    "cursor-dark" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Cursor%20Dark
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#080808"
        terminal {
            foreground "#d4d4d4"
            background "#141414"
            black "#242424"
            red "#fc6b83"
            green "#3fa266"
            yellow "#d2943e"
            blue "#81a1c1"
            magenta "#b48ead"
            cyan "#88c0d0"
            white "#e4e4e4"
            bright_black "#4a4a4a"
            bright_red "#fc6b83"
            bright_green "#70b489"
            bright_yellow "#f1b467"
            bright_blue "#87a6c4"
            bright_magenta "#b48ead"
            bright_cyan "#88c0d0"
            bright_white "#e4e4e4"
        }
        text_unselected {
            base "#d4d4d4"
            background "#141414"
            emphasis_0 "#d2943e"
            emphasis_1 "#88c0d0"
            emphasis_2 "#3fa266"
            emphasis_3 "#b48ead"
        }
        text_selected {
            base "#141414"
            background "#d4d4d4"
            emphasis_0 "#795524"
            emphasis_1 "#446068"
            emphasis_2 "#2a6742"
            emphasis_3 "#6c5568"
        }
        table_cell_unselected {
            base "#d4d4d4"
            background "#141414"
            emphasis_0 "#d2943e"
            emphasis_1 "#88c0d0"
            emphasis_2 "#3fa266"
            emphasis_3 "#b48ead"
        }
        table_cell_selected {
            base "#e4e4e4"
            background "#2c2c2c"
            emphasis_0 "#d2943e"
            emphasis_1 "#88c0d0"
            emphasis_2 "#44a56a"
            emphasis_3 "#b48ead"
        }
        list_unselected {
            base "#d4d4d4"
            background "#141414"
            emphasis_0 "#d2943e"
            emphasis_1 "#88c0d0"
            emphasis_2 "#3fa266"
            emphasis_3 "#b48ead"
        }
        list_selected {
            base "#e4e4e4"
            background "#2c2c2c"
            emphasis_0 "#d2943e"
            emphasis_1 "#88c0d0"
            emphasis_2 "#44a56a"
            emphasis_3 "#b48ead"
        }
        ribbon_selected {
            base "#141414"
            background "#3fa266"
            emphasis_0 "#451d24"
            emphasis_1 "#372710"
            emphasis_2 "#31262f"
            emphasis_3 "#222a33"
        }
        ribbon_unselected {
            base "#141414"
            background "#d4d4d4"
            emphasis_0 "#96404e"
            emphasis_1 "#d4d4d4"
            emphasis_2 "#4b5e71"
            emphasis_3 "#6c5568"
        }
        table_title {
            base "#3fa266"
            background "#141414"
            emphasis_0 "#d2943e"
            emphasis_1 "#88c0d0"
            emphasis_2 "#3fa266"
            emphasis_3 "#b48ead"
        }
        frame_unselected {
            base "#d4d4d4"
            background "#141414"
            emphasis_0 "#d4d4d4"
            emphasis_1 "#d4d4d4"
            emphasis_2 "#d4d4d4"
            emphasis_3 "#d4d4d4"
        }
        frame_selected {
            base "#3fa266"
            background "#141414"
            emphasis_0 "#d2943e"
            emphasis_1 "#88c0d0"
            emphasis_2 "#3fa266"
            emphasis_3 "#b48ead"
        }
        frame_highlight {
            base "#d2943e"
            background "#141414"
            emphasis_0 "#b48ead"
            emphasis_1 "#d2943e"
            emphasis_2 "#d2943e"
            emphasis_3 "#d2943e"
        }
        exit_code_success {
            base "#3fa266"
            background "#141414"
            emphasis_0 "#88c0d0"
            emphasis_1 "#d4d4d4"
            emphasis_2 "#b48ead"
            emphasis_3 "#81a1c1"
        }
        exit_code_error {
            base "#fc6b83"
            background "#141414"
            emphasis_0 "#d2943e"
            emphasis_1 "#d4d4d4"
            emphasis_2 "#b48ead"
            emphasis_3 "#81a1c1"
        }
        multiplayer_user_colors {
            player_1 "#b48ead"
            player_2 "#81a1c1"
            player_3 "#b48ead"
            player_4 "#d2943e"
            player_5 "#88c0d0"
            player_6 "#f1b467"
            player_7 "#fc6b83"
            player_8 "#e4e4e4"
            player_9 "#fc6b83"
            player_10 "#87a6c4"
        }
    }
}
