themes {
    "tomorrow" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Tomorrow
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#f3f3f3"
        terminal {
            foreground "#4d4d4c"
            background "#ffffff"
            black "#000000"
            red "#c82829"
            green "#718c00"
            yellow "#eab700"
            blue "#4271ae"
            magenta "#8959a8"
            cyan "#3e999f"
            white "#bfbfbf"
            bright_black "#000000"
            bright_red "#c82829"
            bright_green "#718c00"
            bright_yellow "#eab700"
            bright_blue "#4271ae"
            bright_magenta "#8959a8"
            bright_cyan "#3e999f"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#4d4d4c"
            background "#ffffff"
            emphasis_0 "#927200"
            emphasis_1 "#348186"
            emphasis_2 "#678000"
            emphasis_3 "#8959a8"
        }
        text_selected {
            base "#ffffff"
            background "#4d4d4c"
            emphasis_0 "#c7bd99"
            emphasis_1 "#a9c2c3"
            emphasis_2 "#bac29a"
            emphasis_3 "#c8b7d3"
        }
        table_cell_unselected {
            base "#4d4d4c"
            background "#ffffff"
            emphasis_0 "#927200"
            emphasis_1 "#348186"
            emphasis_2 "#678000"
            emphasis_3 "#8959a8"
        }
        table_cell_selected {
            base "#4d4d4c"
            background "#d6d6d6"
            emphasis_0 "#745a00"
            emphasis_1 "#29666a"
            emphasis_2 "#516400"
            emphasis_3 "#764c90"
        }
        list_unselected {
            base "#4d4d4c"
            background "#ffffff"
            emphasis_0 "#927200"
            emphasis_1 "#348186"
            emphasis_2 "#678000"
            emphasis_3 "#8959a8"
        }
        list_selected {
            base "#4d4d4c"
            background "#d6d6d6"
            emphasis_0 "#745a00"
            emphasis_1 "#29666a"
            emphasis_2 "#516400"
            emphasis_3 "#764c90"
        }
        ribbon_selected {
            base "#1a1a1a"
            background "#718c00"
            emphasis_0 "#360b0b"
            emphasis_1 "#201900"
            emphasis_2 "#211629"
            emphasis_3 "#101b29"
        }
        ribbon_unselected {
            base "#ffffff"
            background "#4d4d4c"
            emphasis_0 "#ebafaf"
            emphasis_1 "#4d4d4c"
            emphasis_2 "#aabfda"
            emphasis_3 "#cbb6d9"
        }
        table_title {
            base "#678000"
            background "#ffffff"
            emphasis_0 "#927200"
            emphasis_1 "#348186"
            emphasis_2 "#678000"
            emphasis_3 "#8959a8"
        }
        frame_unselected {
            base "#4d4d4c"
            background "#ffffff"
            emphasis_0 "#4d4d4c"
            emphasis_1 "#4d4d4c"
            emphasis_2 "#4d4d4c"
            emphasis_3 "#4d4d4c"
        }
        frame_selected {
            base "#678000"
            background "#ffffff"
            emphasis_0 "#927200"
            emphasis_1 "#348186"
            emphasis_2 "#678000"
            emphasis_3 "#8959a8"
        }
        frame_highlight {
            base "#927200"
            background "#ffffff"
            emphasis_0 "#8959a8"
            emphasis_1 "#927200"
            emphasis_2 "#927200"
            emphasis_3 "#927200"
        }
        exit_code_success {
            base "#678000"
            background "#ffffff"
            emphasis_0 "#348186"
            emphasis_1 "#4d4d4c"
            emphasis_2 "#8959a8"
            emphasis_3 "#4271ae"
        }
        exit_code_error {
            base "#c82829"
            background "#ffffff"
            emphasis_0 "#927200"
            emphasis_1 "#4d4d4c"
            emphasis_2 "#8959a8"
            emphasis_3 "#4271ae"
        }
        multiplayer_user_colors {
            player_1 "#8959a8"
            player_2 "#4271ae"
            player_3 "#8959a8"
            player_4 "#927200"
            player_5 "#348186"
            player_6 "#927200"
            player_7 "#c82829"
            player_8 "#767676"
            player_9 "#c82829"
            player_10 "#4271ae"
        }
    }
}
