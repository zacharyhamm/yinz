themes {
    "i-term2-dark-background" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/iTerm2%20Dark%20Background
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000000"
        terminal {
            foreground "#c7c7c7"
            background "#000000"
            black "#000000"
            red "#c91b00"
            green "#00c200"
            yellow "#c7c400"
            blue "#0225c7"
            magenta "#ca30c7"
            cyan "#00c5c7"
            white "#c7c7c7"
            bright_black "#686868"
            bright_red "#ff6e67"
            bright_green "#5ffa68"
            bright_yellow "#fffc67"
            bright_blue "#6871ff"
            bright_magenta "#ff77ff"
            bright_cyan "#60fdff"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#c7c7c7"
            background "#000000"
            emphasis_0 "#c7c400"
            emphasis_1 "#00c5c7"
            emphasis_2 "#00c200"
            emphasis_3 "#ca30c7"
        }
        text_selected {
            base "#000000"
            background "#c1deff"
            emphasis_0 "#656300"
            emphasis_1 "#006c6d"
            emphasis_2 "#007100"
            emphasis_3 "#a327a1"
        }
        table_cell_unselected {
            base "#c7c7c7"
            background "#000000"
            emphasis_0 "#c7c400"
            emphasis_1 "#00c5c7"
            emphasis_2 "#00c200"
            emphasis_3 "#ca30c7"
        }
        table_cell_selected {
            base "#000000"
            background "#c1deff"
            emphasis_0 "#656300"
            emphasis_1 "#006c6d"
            emphasis_2 "#007100"
            emphasis_3 "#a327a1"
        }
        list_unselected {
            base "#c7c7c7"
            background "#000000"
            emphasis_0 "#c7c400"
            emphasis_1 "#00c5c7"
            emphasis_2 "#00c200"
            emphasis_3 "#ca30c7"
        }
        list_selected {
            base "#000000"
            background "#c1deff"
            emphasis_0 "#656300"
            emphasis_1 "#006c6d"
            emphasis_2 "#007100"
            emphasis_3 "#a327a1"
        }
        ribbon_selected {
            base "#000000"
            background "#00c200"
            emphasis_0 "#7b1100"
            emphasis_1 "#403f00"
            emphasis_2 "#691967"
            emphasis_3 "#0222b9"
        }
        ribbon_unselected {
            base "#000000"
            background "#c7c7c7"
            emphasis_0 "#a71600"
            emphasis_1 "#c7c7c7"
            emphasis_2 "#0225c7"
            emphasis_3 "#8e228c"
        }
        table_title {
            base "#00c200"
            background "#000000"
            emphasis_0 "#c7c400"
            emphasis_1 "#00c5c7"
            emphasis_2 "#00c200"
            emphasis_3 "#ca30c7"
        }
        frame_unselected {
            base "#c7c7c7"
            background "#000000"
            emphasis_0 "#c7c7c7"
            emphasis_1 "#c7c7c7"
            emphasis_2 "#c7c7c7"
            emphasis_3 "#c7c7c7"
        }
        frame_selected {
            base "#00c200"
            background "#000000"
            emphasis_0 "#c7c400"
            emphasis_1 "#00c5c7"
            emphasis_2 "#00c200"
            emphasis_3 "#ca30c7"
        }
        frame_highlight {
            base "#c7c400"
            background "#000000"
            emphasis_0 "#ca30c7"
            emphasis_1 "#c7c400"
            emphasis_2 "#c7c400"
            emphasis_3 "#c7c400"
        }
        exit_code_success {
            base "#00c200"
            background "#000000"
            emphasis_0 "#00c5c7"
            emphasis_1 "#c7c7c7"
            emphasis_2 "#ca30c7"
            emphasis_3 "#546cd9"
        }
        exit_code_error {
            base "#d24029"
            background "#000000"
            emphasis_0 "#c7c400"
            emphasis_1 "#c7c7c7"
            emphasis_2 "#ca30c7"
            emphasis_3 "#546cd9"
        }
        multiplayer_user_colors {
            player_1 "#ca30c7"
            player_2 "#546cd9"
            player_3 "#ff77ff"
            player_4 "#c7c400"
            player_5 "#00c5c7"
            player_6 "#fffc67"
            player_7 "#d24029"
            player_8 "#c7c7c7"
            player_9 "#ff6e67"
            player_10 "#6871ff"
        }
    }
}
