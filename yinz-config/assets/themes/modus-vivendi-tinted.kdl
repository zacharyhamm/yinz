themes {
    "modus-vivendi-tinted" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Modus%20Vivendi%20Tinted
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#010210"
        terminal {
            foreground "#ffffff"
            background "#0d0e1c"
            black "#0d0e1c"
            red "#ff5f59"
            green "#44bc44"
            yellow "#d0bc00"
            blue "#2fafff"
            magenta "#feacd0"
            cyan "#00d3d0"
            white "#a6a6a6"
            bright_black "#595959"
            bright_red "#ff6b55"
            bright_green "#00c06f"
            bright_yellow "#fec43f"
            bright_blue "#79a8ff"
            bright_magenta "#b6a0ff"
            bright_cyan "#6ae4b9"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#ffffff"
            background "#0d0e1c"
            emphasis_0 "#d0bc00"
            emphasis_1 "#00d3d0"
            emphasis_2 "#44bc44"
            emphasis_3 "#feacd0"
        }
        text_selected {
            base "#0d0e1c"
            background "#ffffff"
            emphasis_0 "#7f7833"
            emphasis_1 "#368180"
            emphasis_2 "#5d7e5d"
            emphasis_3 "#8f6c7c"
        }
        table_cell_unselected {
            base "#ffffff"
            background "#0d0e1c"
            emphasis_0 "#d0bc00"
            emphasis_1 "#00d3d0"
            emphasis_2 "#44bc44"
            emphasis_3 "#feacd0"
        }
        table_cell_selected {
            base "#ffffff"
            background "#555a66"
            emphasis_0 "#e1d45a"
            emphasis_1 "#60e4e2"
            emphasis_2 "#a5dfa5"
            emphasis_3 "#febfdb"
        }
        list_unselected {
            base "#ffffff"
            background "#0d0e1c"
            emphasis_0 "#d0bc00"
            emphasis_1 "#00d3d0"
            emphasis_2 "#44bc44"
            emphasis_3 "#feacd0"
        }
        list_selected {
            base "#ffffff"
            background "#555a66"
            emphasis_0 "#e1d45a"
            emphasis_1 "#60e4e2"
            emphasis_2 "#a5dfa5"
            emphasis_3 "#febfdb"
        }
        ribbon_selected {
            base "#0d0e1c"
            background "#44bc44"
            emphasis_0 "#672624"
            emphasis_1 "#433c00"
            emphasis_2 "#4d343f"
            emphasis_3 "#113f5c"
        }
        ribbon_unselected {
            base "#0d0e1c"
            background "#ffffff"
            emphasis_0 "#cb4c47"
            emphasis_1 "#ffffff"
            emphasis_2 "#217cb5"
            emphasis_3 "#99687e"
        }
        table_title {
            base "#44bc44"
            background "#0d0e1c"
            emphasis_0 "#d0bc00"
            emphasis_1 "#00d3d0"
            emphasis_2 "#44bc44"
            emphasis_3 "#feacd0"
        }
        frame_unselected {
            base "#ffffff"
            background "#0d0e1c"
            emphasis_0 "#ffffff"
            emphasis_1 "#ffffff"
            emphasis_2 "#ffffff"
            emphasis_3 "#ffffff"
        }
        frame_selected {
            base "#44bc44"
            background "#0d0e1c"
            emphasis_0 "#d0bc00"
            emphasis_1 "#00d3d0"
            emphasis_2 "#44bc44"
            emphasis_3 "#feacd0"
        }
        frame_highlight {
            base "#d0bc00"
            background "#0d0e1c"
            emphasis_0 "#feacd0"
            emphasis_1 "#d0bc00"
            emphasis_2 "#d0bc00"
            emphasis_3 "#d0bc00"
        }
        exit_code_success {
            base "#44bc44"
            background "#0d0e1c"
            emphasis_0 "#00d3d0"
            emphasis_1 "#ffffff"
            emphasis_2 "#feacd0"
            emphasis_3 "#2fafff"
        }
        exit_code_error {
            base "#ff5f59"
            background "#0d0e1c"
            emphasis_0 "#d0bc00"
            emphasis_1 "#ffffff"
            emphasis_2 "#feacd0"
            emphasis_3 "#2fafff"
        }
        multiplayer_user_colors {
            player_1 "#feacd0"
            player_2 "#2fafff"
            player_3 "#b6a0ff"
            player_4 "#d0bc00"
            player_5 "#00d3d0"
            player_6 "#fec43f"
            player_7 "#ff5f59"
            player_8 "#a6a6a6"
            player_9 "#ff6b55"
            player_10 "#79a8ff"
        }
    }
}
