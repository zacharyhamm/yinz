themes {
    "crayon-pony-fish" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Crayon%20Pony%20Fish
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#090000"
        terminal {
            foreground "#68525a"
            background "#150707"
            black "#2b1b1d"
            red "#91002b"
            green "#579524"
            yellow "#ab311b"
            blue "#8c87b0"
            magenta "#692f50"
            cyan "#e8a866"
            white "#68525a"
            bright_black "#4a383b"
            bright_red "#c5255d"
            bright_green "#8dff57"
            bright_yellow "#c8381d"
            bright_blue "#cfc9ff"
            bright_magenta "#fc6cba"
            bright_cyan "#ffceaf"
            bright_white "#b0949d"
        }
        text_unselected {
            base "#86757b"
            background "#150707"
            emphasis_0 "#bd5d4b"
            emphasis_1 "#e8a866"
            emphasis_2 "#579524"
            emphasis_3 "#966d84"
        }
        text_selected {
            base "#150707"
            background "#86757b"
            emphasis_0 "#120a09"
            emphasis_1 "#0f0b07"
            emphasis_2 "#080e04"
            emphasis_3 "#0e0b0d"
        }
        table_cell_unselected {
            base "#86757b"
            background "#150707"
            emphasis_0 "#bd5d4b"
            emphasis_1 "#e8a866"
            emphasis_2 "#579524"
            emphasis_3 "#966d84"
        }
        table_cell_selected {
            base "#938288"
            background "#2b1b1d"
            emphasis_0 "#c46f60"
            emphasis_1 "#e8a866"
            emphasis_2 "#589626"
            emphasis_3 "#a07c91"
        }
        list_unselected {
            base "#86757b"
            background "#150707"
            emphasis_0 "#bd5d4b"
            emphasis_1 "#e8a866"
            emphasis_2 "#579524"
            emphasis_3 "#966d84"
        }
        list_selected {
            base "#938288"
            background "#2b1b1d"
            emphasis_0 "#c46f60"
            emphasis_1 "#e8a866"
            emphasis_2 "#589626"
            emphasis_3 "#a07c91"
        }
        ribbon_selected {
            base "#150707"
            background "#579524"
            emphasis_0 "#460015"
            emphasis_1 "#3b1109"
            emphasis_2 "#311625"
            emphasis_3 "#1e1d26"
        }
        ribbon_unselected {
            base "#150707"
            background "#86757b"
            emphasis_0 "#23000a"
            emphasis_1 "#86757b"
            emphasis_2 "#0c0c0f"
            emphasis_3 "#14090f"
        }
        table_title {
            base "#579524"
            background "#150707"
            emphasis_0 "#bd5d4b"
            emphasis_1 "#e8a866"
            emphasis_2 "#579524"
            emphasis_3 "#966d84"
        }
        frame_unselected {
            base "#86757b"
            background "#150707"
            emphasis_0 "#86757b"
            emphasis_1 "#86757b"
            emphasis_2 "#86757b"
            emphasis_3 "#86757b"
        }
        frame_selected {
            base "#579524"
            background "#150707"
            emphasis_0 "#bd5d4b"
            emphasis_1 "#e8a866"
            emphasis_2 "#579524"
            emphasis_3 "#966d84"
        }
        frame_highlight {
            base "#bd5d4b"
            background "#150707"
            emphasis_0 "#966d84"
            emphasis_1 "#bd5d4b"
            emphasis_2 "#bd5d4b"
            emphasis_3 "#bd5d4b"
        }
        exit_code_success {
            base "#579524"
            background "#150707"
            emphasis_0 "#e8a866"
            emphasis_1 "#86757b"
            emphasis_2 "#966d84"
            emphasis_3 "#8c87b0"
        }
        exit_code_error {
            base "#b85b77"
            background "#150707"
            emphasis_0 "#bd5d4b"
            emphasis_1 "#86757b"
            emphasis_2 "#966d84"
            emphasis_3 "#8c87b0"
        }
        multiplayer_user_colors {
            player_1 "#966d84"
            player_2 "#8c87b0"
            player_3 "#fc6cba"
            player_4 "#bd5d4b"
            player_5 "#e8a866"
            player_6 "#ce4f37"
            player_7 "#b85b77"
            player_8 "#86757b"
            player_9 "#ce4877"
            player_10 "#cfc9ff"
        }
    }
}
