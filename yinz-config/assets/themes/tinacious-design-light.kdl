themes {
    "tinacious-design-light" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Tinacious%20Design%20Light
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#ececf3"
        terminal {
            foreground "#1d1d26"
            background "#f8f8ff"
            black "#1d1d26"
            red "#ff3399"
            green "#00d364"
            yellow "#e5b24d"
            blue "#00cbff"
            magenta "#cc66ff"
            cyan "#00ceca"
            white "#b1b1d6"
            bright_black "#636667"
            bright_red "#ff2f92"
            bright_green "#00d364"
            bright_yellow "#d9ae53"
            bright_blue "#00cbff"
            bright_magenta "#d783ff"
            bright_cyan "#00c8c7"
            bright_white "#d5d6f3"
        }
        text_unselected {
            base "#1d1d26"
            background "#f8f8ff"
            emphasis_0 "#8d6e2f"
            emphasis_1 "#00807e"
            emphasis_2 "#00843f"
            emphasis_3 "#9e4fc6"
        }
        text_selected {
            base "#252525"
            background "#ff3399"
            emphasis_0 "#2d230f"
            emphasis_1 "#002a29"
            emphasis_2 "#002c15"
            emphasis_3 "#341a41"
        }
        table_cell_unselected {
            base "#1d1d26"
            background "#f8f8ff"
            emphasis_0 "#8d6e2f"
            emphasis_1 "#00807e"
            emphasis_2 "#00843f"
            emphasis_3 "#9e4fc6"
        }
        table_cell_selected {
            base "#252525"
            background "#ff3399"
            emphasis_0 "#2d230f"
            emphasis_1 "#002a29"
            emphasis_2 "#002c15"
            emphasis_3 "#341a41"
        }
        list_unselected {
            base "#1d1d26"
            background "#f8f8ff"
            emphasis_0 "#8d6e2f"
            emphasis_1 "#00807e"
            emphasis_2 "#00843f"
            emphasis_3 "#9e4fc6"
        }
        list_selected {
            base "#252525"
            background "#ff3399"
            emphasis_0 "#2d230f"
            emphasis_1 "#002a29"
            emphasis_2 "#002c15"
            emphasis_3 "#341a41"
        }
        ribbon_selected {
            base "#48484a"
            background "#00d364"
            emphasis_0 "#881b52"
            emphasis_1 "#5a461e"
            emphasis_2 "#65327e"
            emphasis_3 "#005064"
        }
        ribbon_unselected {
            base "#f8f8ff"
            background "#1d1d26"
            emphasis_0 "#ff3399"
            emphasis_1 "#1d1d26"
            emphasis_2 "#00cbff"
            emphasis_3 "#cc66ff"
        }
        table_title {
            base "#00843f"
            background "#f8f8ff"
            emphasis_0 "#8d6e2f"
            emphasis_1 "#00807e"
            emphasis_2 "#00843f"
            emphasis_3 "#9e4fc6"
        }
        frame_unselected {
            base "#1d1d26"
            background "#f8f8ff"
            emphasis_0 "#1d1d26"
            emphasis_1 "#1d1d26"
            emphasis_2 "#1d1d26"
            emphasis_3 "#1d1d26"
        }
        frame_selected {
            base "#00843f"
            background "#f8f8ff"
            emphasis_0 "#8d6e2f"
            emphasis_1 "#00807e"
            emphasis_2 "#00843f"
            emphasis_3 "#9e4fc6"
        }
        frame_highlight {
            base "#8d6e2f"
            background "#f8f8ff"
            emphasis_0 "#9e4fc6"
            emphasis_1 "#8d6e2f"
            emphasis_2 "#8d6e2f"
            emphasis_3 "#8d6e2f"
        }
        exit_code_success {
            base "#00843f"
            background "#f8f8ff"
            emphasis_0 "#00807e"
            emphasis_1 "#1d1d26"
            emphasis_2 "#9e4fc6"
            emphasis_3 "#007c9c"
        }
        exit_code_error {
            base "#d32a7f"
            background "#f8f8ff"
            emphasis_0 "#8d6e2f"
            emphasis_1 "#1d1d26"
            emphasis_2 "#9e4fc6"
            emphasis_3 "#007c9c"
        }
        multiplayer_user_colors {
            player_1 "#9e4fc6"
            player_2 "#007c9c"
            player_3 "#955bb1"
            player_4 "#8d6e2f"
            player_5 "#00807e"
            player_6 "#8a6f35"
            player_7 "#d32a7f"
            player_8 "#707088"
            player_9 "#d5277a"
            player_10 "#007c9c"
        }
    }
}
