themes {
    "tomorrow-night-blue" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Tomorrow%20Night%20Blue
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#001845"
        terminal {
            foreground "#ffffff"
            background "#002451"
            black "#000000"
            red "#ff9da4"
            green "#d1f1a9"
            yellow "#ffeead"
            blue "#bbdaff"
            magenta "#ebbbff"
            cyan "#99ffff"
            white "#ffffff"
            bright_black "#4c4c4c"
            bright_red "#ff9da4"
            bright_green "#d1f1a9"
            bright_yellow "#ffeead"
            bright_blue "#bbdaff"
            bright_magenta "#ebbbff"
            bright_cyan "#99ffff"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#ffffff"
            background "#002451"
            emphasis_0 "#ffeead"
            emphasis_1 "#99ffff"
            emphasis_2 "#d1f1a9"
            emphasis_3 "#ebbbff"
        }
        text_selected {
            base "#002451"
            background "#ffffff"
            emphasis_0 "#7e7655"
            emphasis_1 "#4c7f7f"
            emphasis_2 "#6b7c57"
            emphasis_3 "#886d94"
        }
        table_cell_unselected {
            base "#ffffff"
            background "#002451"
            emphasis_0 "#ffeead"
            emphasis_1 "#99ffff"
            emphasis_2 "#d1f1a9"
            emphasis_3 "#ebbbff"
        }
        table_cell_selected {
            base "#ffffff"
            background "#003f8e"
            emphasis_0 "#ffeead"
            emphasis_1 "#99ffff"
            emphasis_2 "#d1f1a9"
            emphasis_3 "#ebbbff"
        }
        list_unselected {
            base "#ffffff"
            background "#002451"
            emphasis_0 "#ffeead"
            emphasis_1 "#99ffff"
            emphasis_2 "#d1f1a9"
            emphasis_3 "#ebbbff"
        }
        list_selected {
            base "#ffffff"
            background "#003f8e"
            emphasis_0 "#ffeead"
            emphasis_1 "#99ffff"
            emphasis_2 "#d1f1a9"
            emphasis_3 "#ebbbff"
        }
        ribbon_selected {
            base "#002451"
            background "#d1f1a9"
            emphasis_0 "#8f585c"
            emphasis_1 "#6e674b"
            emphasis_2 "#775f81"
            emphasis_3 "#5a697b"
        }
        ribbon_unselected {
            base "#002451"
            background "#ffffff"
            emphasis_0 "#a46569"
            emphasis_1 "#ffffff"
            emphasis_2 "#67788c"
            emphasis_3 "#886d94"
        }
        table_title {
            base "#d1f1a9"
            background "#002451"
            emphasis_0 "#ffeead"
            emphasis_1 "#99ffff"
            emphasis_2 "#d1f1a9"
            emphasis_3 "#ebbbff"
        }
        frame_unselected {
            base "#ffffff"
            background "#002451"
            emphasis_0 "#ffffff"
            emphasis_1 "#ffffff"
            emphasis_2 "#ffffff"
            emphasis_3 "#ffffff"
        }
        frame_selected {
            base "#d1f1a9"
            background "#002451"
            emphasis_0 "#ffeead"
            emphasis_1 "#99ffff"
            emphasis_2 "#d1f1a9"
            emphasis_3 "#ebbbff"
        }
        frame_highlight {
            base "#ffeead"
            background "#002451"
            emphasis_0 "#ebbbff"
            emphasis_1 "#ffeead"
            emphasis_2 "#ffeead"
            emphasis_3 "#ffeead"
        }
        exit_code_success {
            base "#d1f1a9"
            background "#002451"
            emphasis_0 "#99ffff"
            emphasis_1 "#ffffff"
            emphasis_2 "#ebbbff"
            emphasis_3 "#bbdaff"
        }
        exit_code_error {
            base "#ff9da4"
            background "#002451"
            emphasis_0 "#ffeead"
            emphasis_1 "#ffffff"
            emphasis_2 "#ebbbff"
            emphasis_3 "#bbdaff"
        }
        multiplayer_user_colors {
            player_1 "#ebbbff"
            player_2 "#bbdaff"
            player_3 "#ebbbff"
            player_4 "#ffeead"
            player_5 "#99ffff"
            player_6 "#ffeead"
            player_7 "#ff9da4"
            player_8 "#ffffff"
            player_9 "#ff9da4"
            player_10 "#bbdaff"
        }
    }
}
