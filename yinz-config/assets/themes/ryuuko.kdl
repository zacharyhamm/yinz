themes {
    "ryuuko" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Ryuuko
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#202d35"
        terminal {
            foreground "#ececec"
            background "#2c3941"
            black "#2c3941"
            red "#865f5b"
            green "#66907d"
            yellow "#b1a990"
            blue "#6a8e95"
            magenta "#b18a73"
            cyan "#88b2ac"
            white "#ececec"
            bright_black "#5d7079"
            bright_red "#865f5b"
            bright_green "#66907d"
            bright_yellow "#b1a990"
            bright_blue "#6a8e95"
            bright_magenta "#b18a73"
            bright_cyan "#88b2ac"
            bright_white "#ececec"
        }
        text_unselected {
            base "#ececec"
            background "#2c3941"
            emphasis_0 "#b1a990"
            emphasis_1 "#88b2ac"
            emphasis_2 "#85a798"
            emphasis_3 "#bb9985"
        }
        text_selected {
            base "#2c3941"
            background "#ececec"
            emphasis_0 "#706b5b"
            emphasis_1 "#56706d"
            emphasis_2 "#527263"
            emphasis_3 "#826554"
        }
        table_cell_unselected {
            base "#ececec"
            background "#2c3941"
            emphasis_0 "#b1a990"
            emphasis_1 "#88b2ac"
            emphasis_2 "#85a798"
            emphasis_3 "#bb9985"
        }
        table_cell_selected {
            base "#819090"
            background "#002831"
            emphasis_0 "#b1a990"
            emphasis_1 "#88b2ac"
            emphasis_2 "#6a9380"
            emphasis_3 "#b18a73"
        }
        list_unselected {
            base "#ececec"
            background "#2c3941"
            emphasis_0 "#b1a990"
            emphasis_1 "#88b2ac"
            emphasis_2 "#85a798"
            emphasis_3 "#bb9985"
        }
        list_selected {
            base "#819090"
            background "#002831"
            emphasis_0 "#b1a990"
            emphasis_1 "#88b2ac"
            emphasis_2 "#6a9380"
            emphasis_3 "#b18a73"
        }
        ribbon_selected {
            base "#1a2126"
            background "#66907d"
            emphasis_0 "#2a1d1c"
            emphasis_1 "#22201c"
            emphasis_2 "#271e19"
            emphasis_3 "#192224"
        }
        ribbon_unselected {
            base "#2c3941"
            background "#ececec"
            emphasis_0 "#865f5b"
            emphasis_1 "#ececec"
            emphasis_2 "#536f75"
            emphasis_3 "#826554"
        }
        table_title {
            base "#85a798"
            background "#2c3941"
            emphasis_0 "#b1a990"
            emphasis_1 "#88b2ac"
            emphasis_2 "#85a798"
            emphasis_3 "#bb9985"
        }
        frame_unselected {
            base "#ececec"
            background "#2c3941"
            emphasis_0 "#ececec"
            emphasis_1 "#ececec"
            emphasis_2 "#ececec"
            emphasis_3 "#ececec"
        }
        frame_selected {
            base "#85a798"
            background "#2c3941"
            emphasis_0 "#b1a990"
            emphasis_1 "#88b2ac"
            emphasis_2 "#85a798"
            emphasis_3 "#bb9985"
        }
        frame_highlight {
            base "#b1a990"
            background "#2c3941"
            emphasis_0 "#bb9985"
            emphasis_1 "#b1a990"
            emphasis_2 "#b1a990"
            emphasis_3 "#b1a990"
        }
        exit_code_success {
            base "#85a798"
            background "#2c3941"
            emphasis_0 "#88b2ac"
            emphasis_1 "#ececec"
            emphasis_2 "#bb9985"
            emphasis_3 "#88a5aa"
        }
        exit_code_error {
            base "#b39a97"
            background "#2c3941"
            emphasis_0 "#b1a990"
            emphasis_1 "#ececec"
            emphasis_2 "#bb9985"
            emphasis_3 "#88a5aa"
        }
        multiplayer_user_colors {
            player_1 "#bb9985"
            player_2 "#88a5aa"
            player_3 "#bb9985"
            player_4 "#b1a990"
            player_5 "#88b2ac"
            player_6 "#b1a990"
            player_7 "#b39a97"
            player_8 "#ececec"
            player_9 "#b39a97"
            player_10 "#88a5aa"
        }
    }
}
