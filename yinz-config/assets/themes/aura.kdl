themes {
    "aura" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Aura
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#09080f"
        terminal {
            foreground "#edecee"
            background "#15141b"
            black "#110f18"
            red "#ff6767"
            green "#61ffca"
            yellow "#ffca85"
            blue "#a277ff"
            magenta "#a277ff"
            cyan "#61ffca"
            white "#edecee"
            bright_black "#4d4d4d"
            bright_red "#ffca85"
            bright_green "#a277ff"
            bright_yellow "#ffca85"
            bright_blue "#a277ff"
            bright_magenta "#a277ff"
            bright_cyan "#61ffca"
            bright_white "#edecee"
        }
        text_unselected {
            base "#edecee"
            background "#15141b"
            emphasis_0 "#ffca85"
            emphasis_1 "#61ffca"
            emphasis_2 "#61ffca"
            emphasis_3 "#a277ff"
        }
        text_selected {
            base "#2a2a2a"
            background "#a277ff"
            emphasis_0 "#33281b"
            emphasis_1 "#122f25"
            emphasis_2 "#122f25"
            emphasis_3 "#30234c"
        }
        table_cell_unselected {
            base "#edecee"
            background "#15141b"
            emphasis_0 "#ffca85"
            emphasis_1 "#61ffca"
            emphasis_2 "#61ffca"
            emphasis_3 "#a277ff"
        }
        table_cell_selected {
            base "#2a2a2a"
            background "#a277ff"
            emphasis_0 "#33281b"
            emphasis_1 "#122f25"
            emphasis_2 "#122f25"
            emphasis_3 "#30234c"
        }
        list_unselected {
            base "#edecee"
            background "#15141b"
            emphasis_0 "#ffca85"
            emphasis_1 "#61ffca"
            emphasis_2 "#61ffca"
            emphasis_3 "#a277ff"
        }
        list_selected {
            base "#2a2a2a"
            background "#a277ff"
            emphasis_0 "#33281b"
            emphasis_1 "#122f25"
            emphasis_2 "#122f25"
            emphasis_3 "#30234c"
        }
        ribbon_selected {
            base "#15141b"
            background "#61ffca"
            emphasis_0 "#ac4545"
            emphasis_1 "#7c6241"
            emphasis_2 "#7354b5"
            emphasis_3 "#7354b5"
        }
        ribbon_unselected {
            base "#15141b"
            background "#edecee"
            emphasis_0 "#b34848"
            emphasis_1 "#edecee"
            emphasis_2 "#7858bd"
            emphasis_3 "#7858bd"
        }
        table_title {
            base "#61ffca"
            background "#15141b"
            emphasis_0 "#ffca85"
            emphasis_1 "#61ffca"
            emphasis_2 "#61ffca"
            emphasis_3 "#a277ff"
        }
        frame_unselected {
            base "#edecee"
            background "#15141b"
            emphasis_0 "#edecee"
            emphasis_1 "#edecee"
            emphasis_2 "#edecee"
            emphasis_3 "#edecee"
        }
        frame_selected {
            base "#61ffca"
            background "#15141b"
            emphasis_0 "#ffca85"
            emphasis_1 "#61ffca"
            emphasis_2 "#61ffca"
            emphasis_3 "#a277ff"
        }
        frame_highlight {
            base "#ffca85"
            background "#15141b"
            emphasis_0 "#a277ff"
            emphasis_1 "#ffca85"
            emphasis_2 "#ffca85"
            emphasis_3 "#ffca85"
        }
        exit_code_success {
            base "#61ffca"
            background "#15141b"
            emphasis_0 "#61ffca"
            emphasis_1 "#edecee"
            emphasis_2 "#a277ff"
            emphasis_3 "#a277ff"
        }
        exit_code_error {
            base "#ff6767"
            background "#15141b"
            emphasis_0 "#ffca85"
            emphasis_1 "#edecee"
            emphasis_2 "#a277ff"
            emphasis_3 "#a277ff"
        }
        multiplayer_user_colors {
            player_1 "#a277ff"
            player_2 "#a277ff"
            player_3 "#a277ff"
            player_4 "#ffca85"
            player_5 "#61ffca"
            player_6 "#ffca85"
            player_7 "#ff6767"
            player_8 "#edecee"
            player_9 "#ffca85"
            player_10 "#a277ff"
        }
    }
}
