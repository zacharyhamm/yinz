themes {
    "scarlet-protocol" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Scarlet%20Protocol
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#100931"
        terminal {
            foreground "#e41951"
            background "#1c153d"
            black "#101116"
            red "#ff0051"
            green "#00dc84"
            yellow "#faf945"
            blue "#0271b6"
            magenta "#ca30c7"
            cyan "#00c5c7"
            white "#c7c7c7"
            bright_black "#686868"
            bright_red "#ff6e67"
            bright_green "#5ffa68"
            bright_yellow "#fffc67"
            bright_blue "#6871ff"
            bright_magenta "#bd35ec"
            bright_cyan "#60fdff"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#e94472"
            background "#1c153d"
            emphasis_0 "#faf945"
            emphasis_1 "#00c5c7"
            emphasis_2 "#00dc84"
            emphasis_3 "#d049ce"
        }
        text_selected {
            base "#000000"
            background "#c1deff"
            emphasis_0 "#63631b"
            emphasis_1 "#006c6d"
            emphasis_2 "#006f43"
            emphasis_3 "#a327a1"
        }
        table_cell_unselected {
            base "#e94472"
            background "#1c153d"
            emphasis_0 "#faf945"
            emphasis_1 "#00c5c7"
            emphasis_2 "#00dc84"
            emphasis_3 "#d049ce"
        }
        table_cell_selected {
            base "#000000"
            background "#c1deff"
            emphasis_0 "#63631b"
            emphasis_1 "#006c6d"
            emphasis_2 "#006f43"
            emphasis_3 "#a327a1"
        }
        list_unselected {
            base "#e94472"
            background "#1c153d"
            emphasis_0 "#faf945"
            emphasis_1 "#00c5c7"
            emphasis_2 "#00dc84"
            emphasis_3 "#d049ce"
        }
        list_selected {
            base "#000000"
            background "#c1deff"
            emphasis_0 "#63631b"
            emphasis_1 "#006c6d"
            emphasis_2 "#006f43"
            emphasis_3 "#a327a1"
        }
        ribbon_selected {
            base "#1c153d"
            background "#00dc84"
            emphasis_0 "#a10033"
            emphasis_1 "#515116"
            emphasis_2 "#862084"
            emphasis_3 "#015285"
        }
        ribbon_unselected {
            base "#1c153d"
            background "#e94472"
            emphasis_0 "#400014"
            emphasis_1 "#e94472"
            emphasis_2 "#011e30"
            emphasis_3 "#310c30"
        }
        table_title {
            base "#00dc84"
            background "#1c153d"
            emphasis_0 "#faf945"
            emphasis_1 "#00c5c7"
            emphasis_2 "#00dc84"
            emphasis_3 "#d049ce"
        }
        frame_unselected {
            base "#e94472"
            background "#1c153d"
            emphasis_0 "#e94472"
            emphasis_1 "#e94472"
            emphasis_2 "#e94472"
            emphasis_3 "#e94472"
        }
        frame_selected {
            base "#00dc84"
            background "#1c153d"
            emphasis_0 "#faf945"
            emphasis_1 "#00c5c7"
            emphasis_2 "#00dc84"
            emphasis_3 "#d049ce"
        }
        frame_highlight {
            base "#faf945"
            background "#1c153d"
            emphasis_0 "#d049ce"
            emphasis_1 "#faf945"
            emphasis_2 "#faf945"
            emphasis_3 "#faf945"
        }
        exit_code_success {
            base "#00dc84"
            background "#1c153d"
            emphasis_0 "#00c5c7"
            emphasis_1 "#e94472"
            emphasis_2 "#d049ce"
            emphasis_3 "#2e8ac3"
        }
        exit_code_error {
            base "#ff145f"
            background "#1c153d"
            emphasis_0 "#faf945"
            emphasis_1 "#e94472"
            emphasis_2 "#d049ce"
            emphasis_3 "#2e8ac3"
        }
        multiplayer_user_colors {
            player_1 "#d049ce"
            player_2 "#2e8ac3"
            player_3 "#c44aee"
            player_4 "#faf945"
            player_5 "#00c5c7"
            player_6 "#fffc67"
            player_7 "#ff145f"
            player_8 "#c7c7c7"
            player_9 "#ff6e67"
            player_10 "#6a73ff"
        }
    }
}
