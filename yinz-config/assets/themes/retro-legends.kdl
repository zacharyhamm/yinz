themes {
    "retro-legends" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Retro%20Legends
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#010101"
        terminal {
            foreground "#45eb45"
            background "#0d0d0d"
            black "#262626"
            red "#de5454"
            green "#45eb45"
            yellow "#f7bf2b"
            blue "#4066f2"
            magenta "#bf4cf2"
            cyan "#40d9e6"
            white "#bfe6bf"
            bright_black "#4c594c"
            bright_red "#ff6666"
            bright_green "#59ff59"
            bright_yellow "#ffd933"
            bright_blue "#4c80ff"
            bright_magenta "#e666ff"
            bright_cyan "#59e6ff"
            bright_white "#f2fff2"
        }
        text_unselected {
            base "#45eb45"
            background "#0d0d0d"
            emphasis_0 "#f7bf2b"
            emphasis_1 "#40d9e6"
            emphasis_2 "#45eb45"
            emphasis_3 "#bf4cf2"
        }
        text_selected {
            base "#0d0d0d"
            background "#45eb45"
            emphasis_0 "#685525"
            emphasis_1 "#2f5e63"
            emphasis_2 "#286328"
            emphasis_3 "#625268"
        }
        table_cell_unselected {
            base "#45eb45"
            background "#0d0d0d"
            emphasis_0 "#f7bf2b"
            emphasis_1 "#40d9e6"
            emphasis_2 "#45eb45"
            emphasis_3 "#bf4cf2"
        }
        table_cell_selected {
            base "#f2fff2"
            background "#336633"
            emphasis_0 "#f9cd58"
            emphasis_1 "#72e3ed"
            emphasis_2 "#61ee61"
            emphasis_3 "#ebc6fb"
        }
        list_unselected {
            base "#45eb45"
            background "#0d0d0d"
            emphasis_0 "#f7bf2b"
            emphasis_1 "#40d9e6"
            emphasis_2 "#45eb45"
            emphasis_3 "#bf4cf2"
        }
        list_selected {
            base "#f2fff2"
            background "#336633"
            emphasis_0 "#f9cd58"
            emphasis_1 "#72e3ed"
            emphasis_2 "#61ee61"
            emphasis_3 "#ebc6fb"
        }
        ribbon_selected {
            base "#f2fff2"
            background "#336633"
            emphasis_0 "#f9cd58"
            emphasis_1 "#72e3ed"
            emphasis_2 "#61ee61"
            emphasis_3 "#ebc6fb"
        }
        ribbon_unselected {
            base "#0d0d0d"
            background "#45eb45"
            emphasis_0 "#953838"
            emphasis_1 "#45eb45"
            emphasis_2 "#314eba"
            emphasis_3 "#8133a3"
        }
        table_title {
            base "#45eb45"
            background "#0d0d0d"
            emphasis_0 "#f7bf2b"
            emphasis_1 "#40d9e6"
            emphasis_2 "#45eb45"
            emphasis_3 "#bf4cf2"
        }
        frame_unselected {
            base "#45eb45"
            background "#0d0d0d"
            emphasis_0 "#45eb45"
            emphasis_1 "#45eb45"
            emphasis_2 "#45eb45"
            emphasis_3 "#45eb45"
        }
        frame_selected {
            base "#45eb45"
            background "#0d0d0d"
            emphasis_0 "#f7bf2b"
            emphasis_1 "#40d9e6"
            emphasis_2 "#45eb45"
            emphasis_3 "#bf4cf2"
        }
        frame_highlight {
            base "#f7bf2b"
            background "#0d0d0d"
            emphasis_0 "#bf4cf2"
            emphasis_1 "#f7bf2b"
            emphasis_2 "#f7bf2b"
            emphasis_3 "#f7bf2b"
        }
        exit_code_success {
            base "#45eb45"
            background "#0d0d0d"
            emphasis_0 "#40d9e6"
            emphasis_1 "#45eb45"
            emphasis_2 "#bf4cf2"
            emphasis_3 "#4b6ff3"
        }
        exit_code_error {
            base "#de5454"
            background "#0d0d0d"
            emphasis_0 "#f7bf2b"
            emphasis_1 "#45eb45"
            emphasis_2 "#bf4cf2"
            emphasis_3 "#4b6ff3"
        }
        multiplayer_user_colors {
            player_1 "#bf4cf2"
            player_2 "#4b6ff3"
            player_3 "#e666ff"
            player_4 "#f7bf2b"
            player_5 "#40d9e6"
            player_6 "#ffd933"
            player_7 "#de5454"
            player_8 "#bfe6bf"
            player_9 "#ff6666"
            player_10 "#4c80ff"
        }
    }
}
