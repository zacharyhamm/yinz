themes {
    "x-praha" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/X%20Praha
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#0e0e0e"
        terminal {
            foreground "#ffffff"
            background "#1a1a1a"
            black "#1a1a1a"
            red "#ff5555"
            green "#b8e6a0"
            yellow "#ffe4a3"
            blue "#bd93f9"
            magenta "#ff9aa2"
            cyan "#8be9fd"
            white "#ffffff"
            bright_black "#6272a4"
            bright_red "#ff6e6e"
            bright_green "#b8e6a0"
            bright_yellow "#ffe4a3"
            bright_blue "#d6acff"
            bright_magenta "#ff9aa2"
            bright_cyan "#a4ffff"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#ffffff"
            background "#1a1a1a"
            emphasis_0 "#ffe4a3"
            emphasis_1 "#8be9fd"
            emphasis_2 "#b8e6a0"
            emphasis_3 "#ff9aa2"
        }
        text_selected {
            base "#1a1a1a"
            background "#ffffff"
            emphasis_0 "#837554"
            emphasis_1 "#4b7e89"
            emphasis_2 "#647d57"
            emphasis_3 "#a66469"
        }
        table_cell_unselected {
            base "#ffffff"
            background "#1a1a1a"
            emphasis_0 "#ffe4a3"
            emphasis_1 "#8be9fd"
            emphasis_2 "#b8e6a0"
            emphasis_3 "#ff9aa2"
        }
        table_cell_selected {
            base "#1a1a1a"
            background "#ffffff"
            emphasis_0 "#837554"
            emphasis_1 "#4b7e89"
            emphasis_2 "#647d57"
            emphasis_3 "#a66469"
        }
        list_unselected {
            base "#ffffff"
            background "#1a1a1a"
            emphasis_0 "#ffe4a3"
            emphasis_1 "#8be9fd"
            emphasis_2 "#b8e6a0"
            emphasis_3 "#ff9aa2"
        }
        list_selected {
            base "#1a1a1a"
            background "#ffffff"
            emphasis_0 "#837554"
            emphasis_1 "#4b7e89"
            emphasis_2 "#647d57"
            emphasis_3 "#a66469"
        }
        ribbon_selected {
            base "#1a1a1a"
            background "#b8e6a0"
            emphasis_0 "#a83838"
            emphasis_1 "#695e43"
            emphasis_2 "#855054"
            emphasis_3 "#6c548f"
        }
        ribbon_unselected {
            base "#1a1a1a"
            background "#ffffff"
            emphasis_0 "#d04545"
            emphasis_1 "#ffffff"
            emphasis_2 "#8668b1"
            emphasis_3 "#a66469"
        }
        table_title {
            base "#b8e6a0"
            background "#1a1a1a"
            emphasis_0 "#ffe4a3"
            emphasis_1 "#8be9fd"
            emphasis_2 "#b8e6a0"
            emphasis_3 "#ff9aa2"
        }
        frame_unselected {
            base "#ffffff"
            background "#1a1a1a"
            emphasis_0 "#ffffff"
            emphasis_1 "#ffffff"
            emphasis_2 "#ffffff"
            emphasis_3 "#ffffff"
        }
        frame_selected {
            base "#b8e6a0"
            background "#1a1a1a"
            emphasis_0 "#ffe4a3"
            emphasis_1 "#8be9fd"
            emphasis_2 "#b8e6a0"
            emphasis_3 "#ff9aa2"
        }
        frame_highlight {
            base "#ffe4a3"
            background "#1a1a1a"
            emphasis_0 "#ff9aa2"
            emphasis_1 "#ffe4a3"
            emphasis_2 "#ffe4a3"
            emphasis_3 "#ffe4a3"
        }
        exit_code_success {
            base "#b8e6a0"
            background "#1a1a1a"
            emphasis_0 "#8be9fd"
            emphasis_1 "#ffffff"
            emphasis_2 "#ff9aa2"
            emphasis_3 "#bd93f9"
        }
        exit_code_error {
            base "#ff5555"
            background "#1a1a1a"
            emphasis_0 "#ffe4a3"
            emphasis_1 "#ffffff"
            emphasis_2 "#ff9aa2"
            emphasis_3 "#bd93f9"
        }
        multiplayer_user_colors {
            player_1 "#ff9aa2"
            player_2 "#bd93f9"
            player_3 "#ff9aa2"
            player_4 "#ffe4a3"
            player_5 "#8be9fd"
            player_6 "#ffe4a3"
            player_7 "#ff5555"
            player_8 "#ffffff"
            player_9 "#ff6e6e"
            player_10 "#d6acff"
        }
    }
}
