themes {
    "noctis-hibernus" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Noctis%20Hibernus
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#e8eaea"
        terminal {
            foreground "#005661"
            background "#f4f6f6"
            black "#003b42"
            red "#e34e1c"
            green "#00b368"
            yellow "#f49725"
            blue "#0094f0"
            magenta "#ff5792"
            cyan "#00bdd6"
            white "#8ca6a6"
            bright_black "#004d57"
            bright_red "#ff4000"
            bright_green "#00d17a"
            bright_yellow "#ff8c00"
            bright_blue "#0fa3ff"
            bright_magenta "#ff6b9f"
            bright_cyan "#00cbe6"
            bright_white "#bbc3c4"
        }
        text_unselected {
            base "#005661"
            background "#f4f6f6"
            emphasis_0 "#a06318"
            emphasis_1 "#007c8c"
            emphasis_2 "#00824b"
            emphasis_3 "#c1426f"
        }
        text_selected {
            base "#f4f6f6"
            background "#005661"
            emphasis_0 "#d1bba0"
            emphasis_1 "#9bc6cb"
            emphasis_2 "#9bc8b5"
            emphasis_3 "#deb3c2"
        }
        table_cell_unselected {
            base "#005661"
            background "#f4f6f6"
            emphasis_0 "#a06318"
            emphasis_1 "#007c8c"
            emphasis_2 "#00824b"
            emphasis_3 "#c1426f"
        }
        table_cell_selected {
            base "#005661"
            background "#d9e0e0"
            emphasis_0 "#8c5615"
            emphasis_1 "#006d7b"
            emphasis_2 "#007242"
            emphasis_3 "#a93a61"
        }
        list_unselected {
            base "#005661"
            background "#f4f6f6"
            emphasis_0 "#a06318"
            emphasis_1 "#007c8c"
            emphasis_2 "#00824b"
            emphasis_3 "#c1426f"
        }
        list_selected {
            base "#005661"
            background "#d9e0e0"
            emphasis_0 "#8c5615"
            emphasis_1 "#006d7b"
            emphasis_2 "#007242"
            emphasis_3 "#a93a61"
        }
        ribbon_selected {
            base "#343434"
            background "#00b368"
            emphasis_0 "#5e200c"
            emphasis_1 "#4b2e0b"
            emphasis_2 "#5b1f34"
            emphasis_3 "#003759"
        }
        ribbon_unselected {
            base "#f4f6f6"
            background "#005661"
            emphasis_0 "#f2ae97"
            emphasis_1 "#005661"
            emphasis_2 "#79c7f7"
            emphasis_3 "#ffa3c3"
        }
        table_title {
            base "#00824b"
            background "#f4f6f6"
            emphasis_0 "#a06318"
            emphasis_1 "#007c8c"
            emphasis_2 "#00824b"
            emphasis_3 "#c1426f"
        }
        frame_unselected {
            base "#005661"
            background "#f4f6f6"
            emphasis_0 "#005661"
            emphasis_1 "#005661"
            emphasis_2 "#005661"
            emphasis_3 "#005661"
        }
        frame_selected {
            base "#00824b"
            background "#f4f6f6"
            emphasis_0 "#a06318"
            emphasis_1 "#007c8c"
            emphasis_2 "#00824b"
            emphasis_3 "#c1426f"
        }
        frame_highlight {
            base "#a06318"
            background "#f4f6f6"
            emphasis_0 "#c1426f"
            emphasis_1 "#a06318"
            emphasis_2 "#a06318"
            emphasis_3 "#a06318"
        }
        exit_code_success {
            base "#00824b"
            background "#f4f6f6"
            emphasis_0 "#007c8c"
            emphasis_1 "#005661"
            emphasis_2 "#c1426f"
            emphasis_3 "#0075be"
        }
        exit_code_error {
            base "#c74519"
            background "#f4f6f6"
            emphasis_0 "#a06318"
            emphasis_1 "#005661"
            emphasis_2 "#c1426f"
            emphasis_3 "#0075be"
        }
        multiplayer_user_colors {
            player_1 "#c1426f"
            player_2 "#0075be"
            player_3 "#b64c71"
            player_4 "#a06318"
            player_5 "#007c8c"
            player_6 "#aa5d00"
            player_7 "#c74519"
            player_8 "#627474"
            player_9 "#d33500"
            player_10 "#0b76b8"
        }
    }
}
