themes {
    "karasu-snow" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Karasu%20Snow
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#eeeeee"
        terminal {
            foreground "#292524"
            background "#fafafa"
            black "#0a0a0a"
            red "#b84755"
            green "#3f7e4a"
            yellow "#8a6a1f"
            blue "#2e5e9b"
            magenta "#6c4bb8"
            cyan "#2d7e7a"
            white "#b5b5b5"
            bright_black "#404040"
            bright_red "#d93c3c"
            bright_green "#2f9150"
            bright_yellow "#9a7a1d"
            bright_blue "#2b72c7"
            bright_magenta "#7b59d6"
            bright_cyan "#1f968f"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#292524"
            background "#fafafa"
            emphasis_0 "#8a6a1f"
            emphasis_1 "#2d7e7a"
            emphasis_2 "#3f7e4a"
            emphasis_3 "#6c4bb8"
        }
        text_selected {
            base "#fafafa"
            background "#292524"
            emphasis_0 "#a08a57"
            emphasis_1 "#609694"
            emphasis_2 "#6b9673"
            emphasis_3 "#977fcd"
        }
        table_cell_unselected {
            base "#292524"
            background "#fafafa"
            emphasis_0 "#8a6a1f"
            emphasis_1 "#2d7e7a"
            emphasis_2 "#3f7e4a"
            emphasis_3 "#6c4bb8"
        }
        table_cell_selected {
            base "#292524"
            background "#e5e5e5"
            emphasis_0 "#80621d"
            emphasis_1 "#28716e"
            emphasis_2 "#397243"
            emphasis_3 "#6c4bb8"
        }
        list_unselected {
            base "#292524"
            background "#fafafa"
            emphasis_0 "#8a6a1f"
            emphasis_1 "#2d7e7a"
            emphasis_2 "#3f7e4a"
            emphasis_3 "#6c4bb8"
        }
        list_selected {
            base "#292524"
            background "#e5e5e5"
            emphasis_0 "#80621d"
            emphasis_1 "#28716e"
            emphasis_2 "#397243"
            emphasis_3 "#6c4bb8"
        }
        ribbon_selected {
            base "#fafafa"
            background "#3f7e4a"
            emphasis_0 "#fbf4f5"
            emphasis_1 "#f8f6f1"
            emphasis_2 "#f7f5fb"
            emphasis_3 "#f3f6f9"
        }
        ribbon_unselected {
            base "#fafafa"
            background "#292524"
            emphasis_0 "#c9737e"
            emphasis_1 "#292524"
            emphasis_2 "#6d8fb9"
            emphasis_3 "#977fcd"
        }
        table_title {
            base "#3f7e4a"
            background "#fafafa"
            emphasis_0 "#8a6a1f"
            emphasis_1 "#2d7e7a"
            emphasis_2 "#3f7e4a"
            emphasis_3 "#6c4bb8"
        }
        frame_unselected {
            base "#292524"
            background "#fafafa"
            emphasis_0 "#292524"
            emphasis_1 "#292524"
            emphasis_2 "#292524"
            emphasis_3 "#292524"
        }
        frame_selected {
            base "#3f7e4a"
            background "#fafafa"
            emphasis_0 "#8a6a1f"
            emphasis_1 "#2d7e7a"
            emphasis_2 "#3f7e4a"
            emphasis_3 "#6c4bb8"
        }
        frame_highlight {
            base "#8a6a1f"
            background "#fafafa"
            emphasis_0 "#6c4bb8"
            emphasis_1 "#8a6a1f"
            emphasis_2 "#8a6a1f"
            emphasis_3 "#8a6a1f"
        }
        exit_code_success {
            base "#3f7e4a"
            background "#fafafa"
            emphasis_0 "#2d7e7a"
            emphasis_1 "#292524"
            emphasis_2 "#6c4bb8"
            emphasis_3 "#2e5e9b"
        }
        exit_code_error {
            base "#b84755"
            background "#fafafa"
            emphasis_0 "#8a6a1f"
            emphasis_1 "#292524"
            emphasis_2 "#6c4bb8"
            emphasis_3 "#2e5e9b"
        }
        multiplayer_user_colors {
            player_1 "#6c4bb8"
            player_2 "#2e5e9b"
            player_3 "#7b59d6"
            player_4 "#8a6a1f"
            player_5 "#2d7e7a"
            player_6 "#8d701b"
            player_7 "#b84755"
            player_8 "#737373"
            player_9 "#d33a3a"
            player_10 "#2b72c7"
        }
    }
}
