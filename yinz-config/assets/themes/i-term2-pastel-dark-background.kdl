themes {
    "i-term2-pastel-dark-background" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/iTerm2%20Pastel%20Dark%20Background
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000000"
        terminal {
            foreground "#c7c7c7"
            background "#000000"
            black "#626262"
            red "#ff8373"
            green "#b4fb73"
            yellow "#fffdc3"
            blue "#a5d5fe"
            magenta "#ff90fe"
            cyan "#d1d1fe"
            white "#f1f1f1"
            bright_black "#8f8f8f"
            bright_red "#ffc4be"
            bright_green "#d6fcba"
            bright_yellow "#fffed5"
            bright_blue "#c2e3ff"
            bright_magenta "#ffb2fe"
            bright_cyan "#e6e6fe"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#c7c7c7"
            background "#000000"
            emphasis_0 "#fffdc3"
            emphasis_1 "#d1d1fe"
            emphasis_2 "#b4fb73"
            emphasis_3 "#ff90fe"
        }
        text_selected {
            base "#000000"
            background "#c7c7c7"
            emphasis_0 "#555441"
            emphasis_1 "#525264"
            emphasis_2 "#415b29"
            emphasis_3 "#6b476b"
        }
        table_cell_unselected {
            base "#c7c7c7"
            background "#000000"
            emphasis_0 "#fffdc3"
            emphasis_1 "#d1d1fe"
            emphasis_2 "#b4fb73"
            emphasis_3 "#ff90fe"
        }
        table_cell_selected {
            base "#f4f4f4"
            background "#454d96"
            emphasis_0 "#fffdc3"
            emphasis_1 "#d1d1fe"
            emphasis_2 "#b4fb73"
            emphasis_3 "#ffaafe"
        }
        list_unselected {
            base "#c7c7c7"
            background "#000000"
            emphasis_0 "#fffdc3"
            emphasis_1 "#d1d1fe"
            emphasis_2 "#b4fb73"
            emphasis_3 "#ff90fe"
        }
        list_selected {
            base "#f4f4f4"
            background "#454d96"
            emphasis_0 "#fffdc3"
            emphasis_1 "#d1d1fe"
            emphasis_2 "#b4fb73"
            emphasis_3 "#ffaafe"
        }
        ribbon_selected {
            base "#000000"
            background "#b4fb73"
            emphasis_0 "#9f5248"
            emphasis_1 "#6a6951"
            emphasis_2 "#90518f"
            emphasis_3 "#526a7f"
        }
        ribbon_unselected {
            base "#000000"
            background "#c7c7c7"
            emphasis_0 "#80423a"
            emphasis_1 "#c7c7c7"
            emphasis_2 "#425566"
            emphasis_3 "#734173"
        }
        table_title {
            base "#b4fb73"
            background "#000000"
            emphasis_0 "#fffdc3"
            emphasis_1 "#d1d1fe"
            emphasis_2 "#b4fb73"
            emphasis_3 "#ff90fe"
        }
        frame_unselected {
            base "#c7c7c7"
            background "#000000"
            emphasis_0 "#c7c7c7"
            emphasis_1 "#c7c7c7"
            emphasis_2 "#c7c7c7"
            emphasis_3 "#c7c7c7"
        }
        frame_selected {
            base "#b4fb73"
            background "#000000"
            emphasis_0 "#fffdc3"
            emphasis_1 "#d1d1fe"
            emphasis_2 "#b4fb73"
            emphasis_3 "#ff90fe"
        }
        frame_highlight {
            base "#fffdc3"
            background "#000000"
            emphasis_0 "#ff90fe"
            emphasis_1 "#fffdc3"
            emphasis_2 "#fffdc3"
            emphasis_3 "#fffdc3"
        }
        exit_code_success {
            base "#b4fb73"
            background "#000000"
            emphasis_0 "#d1d1fe"
            emphasis_1 "#c7c7c7"
            emphasis_2 "#ff90fe"
            emphasis_3 "#a5d5fe"
        }
        exit_code_error {
            base "#ff8373"
            background "#000000"
            emphasis_0 "#fffdc3"
            emphasis_1 "#c7c7c7"
            emphasis_2 "#ff90fe"
            emphasis_3 "#a5d5fe"
        }
        multiplayer_user_colors {
            player_1 "#ff90fe"
            player_2 "#a5d5fe"
            player_3 "#ffb2fe"
            player_4 "#fffdc3"
            player_5 "#d1d1fe"
            player_6 "#fffed5"
            player_7 "#ff8373"
            player_8 "#f1f1f1"
            player_9 "#ffc4be"
            player_10 "#c2e3ff"
        }
    }
}
