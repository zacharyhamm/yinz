themes {
    "sundried" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Sundried
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#0e0c0c"
        terminal {
            foreground "#c9c9c9"
            background "#1a1818"
            black "#302b2a"
            red "#a7463d"
            green "#587744"
            yellow "#9d602a"
            blue "#485b98"
            magenta "#864651"
            cyan "#9c814f"
            white "#c9c9c9"
            bright_black "#4d4e48"
            bright_red "#aa000c"
            bright_green "#128c21"
            bright_yellow "#fc6a21"
            bright_blue "#7999f7"
            bright_magenta "#fd8aa1"
            bright_cyan "#fad484"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#c9c9c9"
            background "#1a1818"
            emphasis_0 "#aa7647"
            emphasis_1 "#9c814f"
            emphasis_2 "#6e895c"
            emphasis_3 "#a4747c"
        }
        text_selected {
            base "#1a1818"
            background "#c9c9c9"
            emphasis_0 "#695038"
            emphasis_1 "#61533a"
            emphasis_2 "#4c5943"
            emphasis_3 "#664e52"
        }
        table_cell_unselected {
            base "#c9c9c9"
            background "#1a1818"
            emphasis_0 "#aa7647"
            emphasis_1 "#9c814f"
            emphasis_2 "#6e895c"
            emphasis_3 "#a4747c"
        }
        table_cell_selected {
            base "#c9c9c9"
            background "#302b2a"
            emphasis_0 "#b78a62"
            emphasis_1 "#a89064"
            emphasis_2 "#839a74"
            emphasis_3 "#b1888f"
        }
        list_unselected {
            base "#c9c9c9"
            background "#1a1818"
            emphasis_0 "#aa7647"
            emphasis_1 "#9c814f"
            emphasis_2 "#6e895c"
            emphasis_3 "#a4747c"
        }
        list_selected {
            base "#c9c9c9"
            background "#302b2a"
            emphasis_0 "#b78a62"
            emphasis_1 "#a89064"
            emphasis_2 "#839a74"
            emphasis_3 "#b1888f"
        }
        ribbon_selected {
            base "#f2f1f1"
            background "#587744"
            emphasis_0 "#f8f0ef"
            emphasis_1 "#f6f1ec"
            emphasis_2 "#f6f0f1"
            emphasis_3 "#f0f1f7"
        }
        ribbon_unselected {
            base "#1a1818"
            background "#c9c9c9"
            emphasis_0 "#8d3b34"
            emphasis_1 "#c9c9c9"
            emphasis_2 "#41528a"
            emphasis_3 "#7f424d"
        }
        table_title {
            base "#6e895c"
            background "#1a1818"
            emphasis_0 "#aa7647"
            emphasis_1 "#9c814f"
            emphasis_2 "#6e895c"
            emphasis_3 "#a4747c"
        }
        frame_unselected {
            base "#c9c9c9"
            background "#1a1818"
            emphasis_0 "#c9c9c9"
            emphasis_1 "#c9c9c9"
            emphasis_2 "#c9c9c9"
            emphasis_3 "#c9c9c9"
        }
        frame_selected {
            base "#6e895c"
            background "#1a1818"
            emphasis_0 "#aa7647"
            emphasis_1 "#9c814f"
            emphasis_2 "#6e895c"
            emphasis_3 "#a4747c"
        }
        frame_highlight {
            base "#aa7647"
            background "#1a1818"
            emphasis_0 "#a4747c"
            emphasis_1 "#aa7647"
            emphasis_2 "#aa7647"
            emphasis_3 "#aa7647"
        }
        exit_code_success {
            base "#6e895c"
            background "#1a1818"
            emphasis_0 "#9c814f"
            emphasis_1 "#c9c9c9"
            emphasis_2 "#a4747c"
            emphasis_3 "#7180af"
        }
        exit_code_error {
            base "#b96b64"
            background "#1a1818"
            emphasis_0 "#aa7647"
            emphasis_1 "#c9c9c9"
            emphasis_2 "#a4747c"
            emphasis_3 "#7180af"
        }
        multiplayer_user_colors {
            player_1 "#a4747c"
            player_2 "#7180af"
            player_3 "#fd8aa1"
            player_4 "#aa7647"
            player_5 "#9c814f"
            player_6 "#fc6a21"
            player_7 "#b96b64"
            player_8 "#c9c9c9"
            player_9 "#ca6067"
            player_10 "#7999f7"
        }
    }
}
