themes {
    "xcode-light" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Xcode%20Light
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#f3f3f3"
        terminal {
            foreground "#262626"
            background "#ffffff"
            black "#b4d8fd"
            red "#d12f1b"
            green "#3e8087"
            yellow "#78492a"
            blue "#0f68a0"
            magenta "#ad3da4"
            cyan "#804fb8"
            white "#262626"
            bright_black "#8a99a6"
            bright_red "#d12f1b"
            bright_green "#23575c"
            bright_yellow "#78492a"
            bright_blue "#0b4f79"
            bright_magenta "#ad3da4"
            bright_cyan "#4b21b0"
            bright_white "#262626"
        }
        text_unselected {
            base "#262626"
            background "#ffffff"
            emphasis_0 "#78492a"
            emphasis_1 "#804fb8"
            emphasis_2 "#3e8087"
            emphasis_3 "#ad3da4"
        }
        text_selected {
            base "#ffffff"
            background "#262626"
            emphasis_0 "#a58671"
            emphasis_1 "#9e7fc0"
            emphasis_2 "#6f9397"
            emphasis_3 "#b777b2"
        }
        table_cell_unselected {
            base "#262626"
            background "#ffffff"
            emphasis_0 "#78492a"
            emphasis_1 "#804fb8"
            emphasis_2 "#3e8087"
            emphasis_3 "#ad3da4"
        }
        table_cell_selected {
            base "#262626"
            background "#b4d8fd"
            emphasis_0 "#78492a"
            emphasis_1 "#7246a4"
            emphasis_2 "#306369"
            emphasis_3 "#94348c"
        }
        list_unselected {
            base "#262626"
            background "#ffffff"
            emphasis_0 "#78492a"
            emphasis_1 "#804fb8"
            emphasis_2 "#3e8087"
            emphasis_3 "#ad3da4"
        }
        list_selected {
            base "#262626"
            background "#b4d8fd"
            emphasis_0 "#78492a"
            emphasis_1 "#7246a4"
            emphasis_2 "#306369"
            emphasis_3 "#94348c"
        }
        ribbon_selected {
            base "#ffffff"
            background "#3e8087"
            emphasis_0 "#0d0302"
            emphasis_1 "#070402"
            emphasis_2 "#090309"
            emphasis_3 "#010609"
        }
        ribbon_unselected {
            base "#ffffff"
            background "#262626"
            emphasis_0 "#de695a"
            emphasis_1 "#262626"
            emphasis_2 "#5393bb"
            emphasis_3 "#c26fbc"
        }
        table_title {
            base "#3e8087"
            background "#ffffff"
            emphasis_0 "#78492a"
            emphasis_1 "#804fb8"
            emphasis_2 "#3e8087"
            emphasis_3 "#ad3da4"
        }
        frame_unselected {
            base "#262626"
            background "#ffffff"
            emphasis_0 "#262626"
            emphasis_1 "#262626"
            emphasis_2 "#262626"
            emphasis_3 "#262626"
        }
        frame_selected {
            base "#3e8087"
            background "#ffffff"
            emphasis_0 "#78492a"
            emphasis_1 "#804fb8"
            emphasis_2 "#3e8087"
            emphasis_3 "#ad3da4"
        }
        frame_highlight {
            base "#78492a"
            background "#ffffff"
            emphasis_0 "#ad3da4"
            emphasis_1 "#78492a"
            emphasis_2 "#78492a"
            emphasis_3 "#78492a"
        }
        exit_code_success {
            base "#3e8087"
            background "#ffffff"
            emphasis_0 "#804fb8"
            emphasis_1 "#262626"
            emphasis_2 "#ad3da4"
            emphasis_3 "#0f68a0"
        }
        exit_code_error {
            base "#d12f1b"
            background "#ffffff"
            emphasis_0 "#78492a"
            emphasis_1 "#262626"
            emphasis_2 "#ad3da4"
            emphasis_3 "#0f68a0"
        }
        multiplayer_user_colors {
            player_1 "#ad3da4"
            player_2 "#0f68a0"
            player_3 "#ad3da4"
            player_4 "#78492a"
            player_5 "#804fb8"
            player_6 "#78492a"
            player_7 "#d12f1b"
            player_8 "#262626"
            player_9 "#d12f1b"
            player_10 "#0b4f79"
        }
    }
}
