themes {
    "one-half-light" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/One%20Half%20Light
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#eeeeee"
        terminal {
            foreground "#383a42"
            background "#fafafa"
            black "#383a42"
            red "#e45649"
            green "#50a14f"
            yellow "#c18401"
            blue "#0184bc"
            magenta "#a626a4"
            cyan "#0997b3"
            white "#bababa"
            bright_black "#4f525e"
            bright_red "#e06c75"
            bright_green "#98c379"
            bright_yellow "#d8b36e"
            bright_blue "#61afef"
            bright_magenta "#c678dd"
            bright_cyan "#56b6c2"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#383a42"
            background "#fafafa"
            emphasis_0 "#9b6a01"
            emphasis_1 "#087e96"
            emphasis_2 "#408140"
            emphasis_3 "#a626a4"
        }
        text_selected {
            base "#fafafa"
            background "#383a42"
            emphasis_0 "#b6a277"
            emphasis_1 "#7babb5"
            emphasis_2 "#90ab90"
            emphasis_3 "#ca90c9"
        }
        table_cell_unselected {
            base "#383a42"
            background "#fafafa"
            emphasis_0 "#9b6a01"
            emphasis_1 "#087e96"
            emphasis_2 "#408140"
            emphasis_3 "#a626a4"
        }
        table_cell_selected {
            base "#383a42"
            background "#bfceff"
            emphasis_0 "#775101"
            emphasis_1 "#066173"
            emphasis_2 "#316331"
            emphasis_3 "#972395"
        }
        list_unselected {
            base "#383a42"
            background "#fafafa"
            emphasis_0 "#9b6a01"
            emphasis_1 "#087e96"
            emphasis_2 "#408140"
            emphasis_3 "#a626a4"
        }
        list_selected {
            base "#383a42"
            background "#bfceff"
            emphasis_0 "#775101"
            emphasis_1 "#066173"
            emphasis_2 "#316331"
            emphasis_3 "#972395"
        }
        ribbon_selected {
            base "#292929"
            background "#50a14f"
            emphasis_0 "#481b17"
            emphasis_1 "#382600"
            emphasis_2 "#481147"
            emphasis_3 "#002d40"
        }
        ribbon_unselected {
            base "#fafafa"
            background "#383a42"
            emphasis_0 "#ec887f"
            emphasis_1 "#383a42"
            emphasis_2 "#58aed3"
            emphasis_3 "#d08ccf"
        }
        table_title {
            base "#408140"
            background "#fafafa"
            emphasis_0 "#9b6a01"
            emphasis_1 "#087e96"
            emphasis_2 "#408140"
            emphasis_3 "#a626a4"
        }
        frame_unselected {
            base "#383a42"
            background "#fafafa"
            emphasis_0 "#383a42"
            emphasis_1 "#383a42"
            emphasis_2 "#383a42"
            emphasis_3 "#383a42"
        }
        frame_selected {
            base "#408140"
            background "#fafafa"
            emphasis_0 "#9b6a01"
            emphasis_1 "#087e96"
            emphasis_2 "#408140"
            emphasis_3 "#a626a4"
        }
        frame_highlight {
            base "#9b6a01"
            background "#fafafa"
            emphasis_0 "#a626a4"
            emphasis_1 "#9b6a01"
            emphasis_2 "#9b6a01"
            emphasis_3 "#9b6a01"
        }
        exit_code_success {
            base "#408140"
            background "#fafafa"
            emphasis_0 "#087e96"
            emphasis_1 "#383a42"
            emphasis_2 "#a626a4"
            emphasis_3 "#017baf"
        }
        exit_code_error {
            base "#c54a3f"
            background "#fafafa"
            emphasis_0 "#9b6a01"
            emphasis_1 "#383a42"
            emphasis_2 "#a626a4"
            emphasis_3 "#017baf"
        }
        multiplayer_user_colors {
            player_1 "#a626a4"
            player_2 "#017baf"
            player_3 "#985caa"
            player_4 "#9b6a01"
            player_5 "#087e96"
            player_6 "#887045"
            player_7 "#c54a3f"
            player_8 "#737373"
            player_9 "#b4575e"
            player_10 "#4378a4"
        }
    }
}
