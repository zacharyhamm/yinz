themes {
    "rose-pine-moon" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Rose%20Pine%20Moon
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#17152a"
        terminal {
            foreground "#e0def4"
            background "#232136"
            black "#393552"
            red "#eb6f92"
            green "#3e8fb0"
            yellow "#f6c177"
            blue "#9ccfd8"
            magenta "#c4a7e7"
            cyan "#ea9a97"
            white "#e0def4"
            bright_black "#6e6a86"
            bright_red "#eb6f92"
            bright_green "#3e8fb0"
            bright_yellow "#f6c177"
            bright_blue "#9ccfd8"
            bright_magenta "#c4a7e7"
            bright_cyan "#ea9a97"
            bright_white "#e0def4"
        }
        text_unselected {
            base "#e0def4"
            background "#232136"
            emphasis_0 "#f6c177"
            emphasis_1 "#ea9a97"
            emphasis_2 "#4493b2"
            emphasis_3 "#c4a7e7"
        }
        text_selected {
            base "#232136"
            background "#e0def4"
            emphasis_0 "#7a5f3b"
            emphasis_1 "#845856"
            emphasis_2 "#4b6874"
            emphasis_3 "#6d5d81"
        }
        table_cell_unselected {
            base "#e0def4"
            background "#232136"
            emphasis_0 "#f6c177"
            emphasis_1 "#ea9a97"
            emphasis_2 "#4493b2"
            emphasis_3 "#c4a7e7"
        }
        table_cell_selected {
            base "#e0def4"
            background "#44415a"
            emphasis_0 "#f6c177"
            emphasis_1 "#ea9c99"
            emphasis_2 "#84b8cd"
            emphasis_3 "#c4a7e7"
        }
        list_unselected {
            base "#e0def4"
            background "#232136"
            emphasis_0 "#f6c177"
            emphasis_1 "#ea9a97"
            emphasis_2 "#4493b2"
            emphasis_3 "#c4a7e7"
        }
        list_selected {
            base "#e0def4"
            background "#44415a"
            emphasis_0 "#f6c177"
            emphasis_1 "#ea9c99"
            emphasis_2 "#84b8cd"
            emphasis_3 "#c4a7e7"
        }
        ribbon_selected {
            base "#1f1d30"
            background "#3e8fb0"
            emphasis_0 "#31171e"
            emphasis_1 "#261e12"
            emphasis_2 "#231d29"
            emphasis_3 "#182022"
        }
        ribbon_unselected {
            base "#232136"
            background "#e0def4"
            emphasis_0 "#9b4960"
            emphasis_1 "#e0def4"
            emphasis_2 "#4e686c"
            emphasis_3 "#6d5d81"
        }
        table_title {
            base "#4493b2"
            background "#232136"
            emphasis_0 "#f6c177"
            emphasis_1 "#ea9a97"
            emphasis_2 "#4493b2"
            emphasis_3 "#c4a7e7"
        }
        frame_unselected {
            base "#e0def4"
            background "#232136"
            emphasis_0 "#e0def4"
            emphasis_1 "#e0def4"
            emphasis_2 "#e0def4"
            emphasis_3 "#e0def4"
        }
        frame_selected {
            base "#4493b2"
            background "#232136"
            emphasis_0 "#f6c177"
            emphasis_1 "#ea9a97"
            emphasis_2 "#4493b2"
            emphasis_3 "#c4a7e7"
        }
        frame_highlight {
            base "#f6c177"
            background "#232136"
            emphasis_0 "#c4a7e7"
            emphasis_1 "#f6c177"
            emphasis_2 "#f6c177"
            emphasis_3 "#f6c177"
        }
        exit_code_success {
            base "#4493b2"
            background "#232136"
            emphasis_0 "#ea9a97"
            emphasis_1 "#e0def4"
            emphasis_2 "#c4a7e7"
            emphasis_3 "#9ccfd8"
        }
        exit_code_error {
            base "#eb6f92"
            background "#232136"
            emphasis_0 "#f6c177"
            emphasis_1 "#e0def4"
            emphasis_2 "#c4a7e7"
            emphasis_3 "#9ccfd8"
        }
        multiplayer_user_colors {
            player_1 "#c4a7e7"
            player_2 "#9ccfd8"
            player_3 "#c4a7e7"
            player_4 "#f6c177"
            player_5 "#ea9a97"
            player_6 "#f6c177"
            player_7 "#eb6f92"
            player_8 "#e0def4"
            player_9 "#eb6f92"
            player_10 "#9ccfd8"
        }
    }
}
