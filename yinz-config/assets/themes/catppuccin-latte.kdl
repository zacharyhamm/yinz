            emphasis_1 67 26 3
            emphasis_2 57 29 49
            emphasis_3 10 35 85
        }
        ribbon_unselected {
            base 220 224 232
            background 92 95 119
            emphasis_0 248 207 237
            emphasis_1 76 79 105
            emphasis_2 203 220 253
            emphasis_3 248 207 237
        }
        table_title {
            base 45 113 30
            background 0
            emphasis_0 170 67 7
            emphasis_1 3 106 147
            emphasis_2 45 113 30
            emphasis_3 147 74 127
        }
        table_cell_selected {
            base 64 66 88
            background 172 176 190
            emphasis_0 117 46 5
            emphasis_1 2 73 101
            emphasis_2 31 77 21
            emphasis_3 100 50 87
        }
        table_cell_unselected {
            base 76 79 105
            background 220 224 232
            emphasis_0 170 67 7
            emphasis_1 3 106 147
            emphasis_2 45 113 30
            emphasis_3 147 74 127
        }
        list_selected {
            base 64 66 88
            background 172 176 190
            emphasis_0 117 46 5
            emphasis_1 2 73 101
            emphasis_2 31 77 21
            emphasis_3 100 50 87
        }
        list_unselected {
            base 76 79 105
            background 220 224 232
            emphasis_0 170 67 7
            emphasis_1 3 106 147
            emphasis_2 45 113 30
            emphasis_3 147 74 127
        }
        frame_selected {
            base 45 113 30
            background 0
            emphasis_0 170 67 7
            emphasis_1 3 106 147
            emphasis_2 147 74 127
            emphasis_3 0
        }
        frame_highlight {
            base 170 67 7
            background 0
            emphasis_0 198 14 54
            emphasis_1 127 53 224
            emphasis_2 170 67 7
            emphasis_3 170 67 7
        }
        exit_code_success {
            base 45 113 30
            background 0
            emphasis_0 3 106 147
            emphasis_1 97 99 103
            emphasis_2 147 74 127
            emphasis_3 27 90 217
        }
        exit_code_error {
            base 198 14 54
            background 0
            emphasis_0 138 88 18
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 147 74 127
            player_2 27 90 217
            player_3 76 76 76
            player_4 138 88 18
            player_5 3 106 147
            player_6 76 76 76
            player_7 198 14 54
            player_8 76 76 76
