themes {
    catppuccin-latte {
        // Terminal palette: https://github.com/catppuccin/kitty/blob/main/themes/latte.conf
        pane_surround "#e3e5e9"
        terminal {
            foreground "#4c4f69"
            background "#eff1f5"
            black "#5c5f77"
            red "#d20f39"
            green "#40a02b"
            yellow "#df8e1d"
            blue "#1e66f5"
            magenta "#ea76cb"
            cyan "#179299"
            white "#acb0be"
            bright_black "#6c6f85"
            bright_red "#d20f39"
            bright_green "#40a02b"
            bright_yellow "#df8e1d"
            bright_blue "#1e66f5"
            bright_magenta "#ea76cb"
            bright_cyan "#179299"
            bright_white "#bcc0cc"
        }
        text_unselected {
            base 76 79 105
            background 220 224 232
            emphasis_0 170 67 7
            emphasis_1 3 106 147
            emphasis_2 45 113 30
            emphasis_3 198 14 54
        }
        text_selected {
            base 220 224 232
            background 76 79 105
            emphasis_0 "#d5bfb3"
            emphasis_1 "#b1c7cf"
            emphasis_2 "#b9c7b6"
            emphasis_3 "#cebeca"
        }
