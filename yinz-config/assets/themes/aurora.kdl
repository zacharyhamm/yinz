themes {
    "aurora" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Aurora
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#171a22"
        terminal {
            foreground "#ffca28"
            background "#23262e"
            black "#23262e"
            red "#f0266f"
            green "#8fd46d"
            yellow "#ffe66d"
            blue "#102ee4"
            magenta "#ee5d43"
            cyan "#03d6b8"
            white "#c74ded"
            bright_black "#4f545e"
            bright_red "#f92672"
            bright_green "#8fd46d"
            bright_yellow "#ffe66d"
            bright_blue "#03d6b8"
            bright_magenta "#ee5d43"
            bright_cyan "#03d6b8"
            bright_white "#c74ded"
        }
        text_unselected {
            base "#ffca28"
            background "#23262e"
            emphasis_0 "#ffe66d"
            emphasis_1 "#03d6b8"
            emphasis_2 "#8fd46d"
            emphasis_3 "#ee5d43"
        }
        text_selected {
            base "#23262e"
            background "#ffca28"
            emphasis_0 "#645a2b"
            emphasis_1 "#016658"
            emphasis_2 "#426232"
            emphasis_3 "#924233"
        }
        table_cell_unselected {
            base "#ffca28"
            background "#23262e"
            emphasis_0 "#ffe66d"
            emphasis_1 "#03d6b8"
            emphasis_2 "#8fd46d"
            emphasis_3 "#ee5d43"
        }
        table_cell_selected {
            base "#00e8c6"
            background "#292e38"
            emphasis_0 "#ffe66d"
            emphasis_1 "#03d6b8"
            emphasis_2 "#8fd46d"
            emphasis_3 "#f06c54"
        }
        list_unselected {
            base "#ffca28"
            background "#23262e"
            emphasis_0 "#ffe66d"
            emphasis_1 "#03d6b8"
            emphasis_2 "#8fd46d"
            emphasis_3 "#ee5d43"
        }
        list_selected {
            base "#00e8c6"
            background "#292e38"
            emphasis_0 "#ffe66d"
            emphasis_1 "#03d6b8"
            emphasis_2 "#8fd46d"
            emphasis_3 "#f06c54"
        }
        ribbon_selected {
            base "#23262e"
            background "#8fd46d"
            emphasis_0 "#9a1847"
            emphasis_1 "#595026"
            emphasis_2 "#893627"
            emphasis_3 "#102ee4"
        }
        ribbon_unselected {
            base "#23262e"
            background "#ffca28"
            emphasis_0 "#ad1b50"
            emphasis_1 "#ffca28"
            emphasis_2 "#102ee4"
            emphasis_3 "#993c2b"
        }
        table_title {
            base "#8fd46d"
            background "#23262e"
            emphasis_0 "#ffe66d"
            emphasis_1 "#03d6b8"
            emphasis_2 "#8fd46d"
            emphasis_3 "#ee5d43"
        }
        frame_unselected {
            base "#ffca28"
            background "#23262e"
            emphasis_0 "#ffca28"
            emphasis_1 "#ffca28"
            emphasis_2 "#ffca28"
            emphasis_3 "#ffca28"
        }
        frame_selected {
            base "#8fd46d"
            background "#23262e"
            emphasis_0 "#ffe66d"
            emphasis_1 "#03d6b8"
            emphasis_2 "#8fd46d"
            emphasis_3 "#ee5d43"
        }
        frame_highlight {
            base "#ffe66d"
            background "#23262e"
            emphasis_0 "#ee5d43"
            emphasis_1 "#ffe66d"
            emphasis_2 "#ffe66d"
            emphasis_3 "#ffe66d"
        }
        exit_code_success {
            base "#8fd46d"
            background "#23262e"
            emphasis_0 "#03d6b8"
            emphasis_1 "#ffca28"
            emphasis_2 "#ee5d43"
            emphasis_3 "#7284ef"
        }
        exit_code_error {
            base "#f34e8a"
            background "#23262e"
            emphasis_0 "#ffe66d"
            emphasis_1 "#ffca28"
            emphasis_2 "#ee5d43"
            emphasis_3 "#7284ef"
        }
        multiplayer_user_colors {
            player_1 "#ee5d43"
            player_2 "#7284ef"
            player_3 "#ee5d43"
            player_4 "#ffe66d"
            player_5 "#03d6b8"
            player_6 "#ffe66d"
            player_7 "#f34e8a"
            player_8 "#cb5bee"
            player_9 "#fa4586"
            player_10 "#03d6b8"
        }
    }
}
