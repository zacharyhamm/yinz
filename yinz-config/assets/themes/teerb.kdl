themes {
    "teerb" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Teerb
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#1a1a1a"
        terminal {
            foreground "#d0d0d0"
            background "#262626"
            black "#1c1c1c"
            red "#d68686"
            green "#aed686"
            yellow "#d7af87"
            blue "#86aed6"
            magenta "#d6aed6"
            cyan "#8adbb4"
            white "#d0d0d0"
            bright_black "#4f4f4f"
            bright_red "#d68686"
            bright_green "#aed686"
            bright_yellow "#e4c9af"
            bright_blue "#86aed6"
            bright_magenta "#d6aed6"
            bright_cyan "#b1e7dd"
            bright_white "#efefef"
        }
        text_unselected {
            base "#d0d0d0"
            background "#262626"
            emphasis_0 "#d7af87"
            emphasis_1 "#8adbb4"
            emphasis_2 "#aed686"
            emphasis_3 "#d6aed6"
        }
        text_selected {
            base "#262626"
            background "#d0d0d0"
            emphasis_0 "#675645"
            emphasis_1 "#3d6150"
            emphasis_2 "#4d5f3b"
            emphasis_3 "#665466"
        }
        table_cell_unselected {
            base "#d0d0d0"
            background "#262626"
            emphasis_0 "#d7af87"
            emphasis_1 "#8adbb4"
            emphasis_2 "#aed686"
            emphasis_3 "#d6aed6"
        }
        table_cell_selected {
            base "#ffffff"
            background "#4d4d4d"
            emphasis_0 "#dbb792"
            emphasis_1 "#8adbb4"
            emphasis_2 "#aed686"
            emphasis_3 "#d8b1d8"
        }
        list_unselected {
            base "#d0d0d0"
            background "#262626"
            emphasis_0 "#d7af87"
            emphasis_1 "#8adbb4"
            emphasis_2 "#aed686"
            emphasis_3 "#d6aed6"
        }
        list_selected {
            base "#ffffff"
            background "#4d4d4d"
            emphasis_0 "#dbb792"
            emphasis_1 "#8adbb4"
            emphasis_2 "#aed686"
            emphasis_3 "#d8b1d8"
        }
        ribbon_selected {
            base "#262626"
            background "#aed686"
            emphasis_0 "#754a4a"
            emphasis_1 "#655240"
            emphasis_2 "#614f61"
            emphasis_3 "#43576b"
        }
        ribbon_unselected {
            base "#262626"
            background "#d0d0d0"
            emphasis_0 "#7b4d4d"
            emphasis_1 "#d0d0d0"
            emphasis_2 "#465b70"
            emphasis_3 "#665366"
        }
        table_title {
            base "#aed686"
            background "#262626"
            emphasis_0 "#d7af87"
            emphasis_1 "#8adbb4"
            emphasis_2 "#aed686"
            emphasis_3 "#d6aed6"
        }
        frame_unselected {
            base "#d0d0d0"
            background "#262626"
            emphasis_0 "#d0d0d0"
            emphasis_1 "#d0d0d0"
            emphasis_2 "#d0d0d0"
            emphasis_3 "#d0d0d0"
        }
        frame_selected {
            base "#aed686"
            background "#262626"
            emphasis_0 "#d7af87"
            emphasis_1 "#8adbb4"
            emphasis_2 "#aed686"
            emphasis_3 "#d6aed6"
        }
        frame_highlight {
            base "#d7af87"
            background "#262626"
            emphasis_0 "#d6aed6"
            emphasis_1 "#d7af87"
            emphasis_2 "#d7af87"
            emphasis_3 "#d7af87"
        }
        exit_code_success {
            base "#aed686"
            background "#262626"
            emphasis_0 "#8adbb4"
            emphasis_1 "#d0d0d0"
            emphasis_2 "#d6aed6"
            emphasis_3 "#86aed6"
        }
        exit_code_error {
            base "#d68686"
            background "#262626"
            emphasis_0 "#d7af87"
            emphasis_1 "#d0d0d0"
            emphasis_2 "#d6aed6"
            emphasis_3 "#86aed6"
        }
        multiplayer_user_colors {
            player_1 "#d6aed6"
            player_2 "#86aed6"
            player_3 "#d6aed6"
            player_4 "#d7af87"
            player_5 "#8adbb4"
            player_6 "#e4c9af"
            player_7 "#d68686"
            player_8 "#d0d0d0"
            player_9 "#d68686"
            player_10 "#86aed6"
        }
    }
}
