themes {
    "gruvbox-material" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Gruvbox%20Material
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#111415"
        terminal {
            foreground "#d4be98"
            background "#1d2021"
            black "#141617"
            red "#ea6926"
            green "#c1d041"
            yellow "#eecf75"
            blue "#6da3ec"
            magenta "#fd9bc1"
            cyan "#fe9d6e"
            white "#ffffff"
            bright_black "#4c4c4c"
            bright_red "#d3573b"
            bright_green "#c1d041"
            bright_yellow "#eecf75"
            bright_blue "#2c86ff"
            bright_magenta "#fd9bc1"
            bright_cyan "#92a5df"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#d4be98"
            background "#1d2021"
            emphasis_0 "#eecf75"
            emphasis_1 "#fe9d6e"
            emphasis_2 "#c1d041"
            emphasis_3 "#fd9bc1"
        }
        text_selected {
            base "#1d2021"
            background "#d4be98"
            emphasis_0 "#5a4e2c"
            emphasis_1 "#6f4430"
            emphasis_2 "#4d531a"
            emphasis_3 "#6d4353"
        }
        table_cell_unselected {
            base "#d4be98"
            background "#1d2021"
            emphasis_0 "#eecf75"
            emphasis_1 "#fe9d6e"
            emphasis_2 "#c1d041"
            emphasis_3 "#fd9bc1"
        }
        table_cell_selected {
            base "#7cfb70"
            background "#2b2c3f"
            emphasis_0 "#eecf75"
            emphasis_1 "#fe9d6e"
            emphasis_2 "#c1d041"
            emphasis_3 "#fd9bc1"
        }
        list_unselected {
            base "#d4be98"
            background "#1d2021"
            emphasis_0 "#eecf75"
            emphasis_1 "#fe9d6e"
            emphasis_2 "#c1d041"
            emphasis_3 "#fd9bc1"
        }
        list_selected {
            base "#7cfb70"
            background "#2b2c3f"
            emphasis_0 "#eecf75"
            emphasis_1 "#fe9d6e"
            emphasis_2 "#c1d041"
            emphasis_3 "#fd9bc1"
        }
        ribbon_selected {
            base "#1d2021"
            background "#c1d041"
            emphasis_0 "#893d16"
            emphasis_1 "#5e522e"
            emphasis_2 "#724657"
            emphasis_3 "#38547a"
        }
        ribbon_unselected {
            base "#1d2021"
            background "#d4be98"
            emphasis_0 "#823a15"
            emphasis_1 "#d4be98"
            emphasis_2 "#355074"
            emphasis_3 "#6d4353"
        }
        table_title {
            base "#c1d041"
            background "#1d2021"
            emphasis_0 "#eecf75"
            emphasis_1 "#fe9d6e"
            emphasis_2 "#c1d041"
            emphasis_3 "#fd9bc1"
        }
        frame_unselected {
            base "#d4be98"
            background "#1d2021"
            emphasis_0 "#d4be98"
            emphasis_1 "#d4be98"
            emphasis_2 "#d4be98"
            emphasis_3 "#d4be98"
        }
        frame_selected {
            base "#c1d041"
            background "#1d2021"
            emphasis_0 "#eecf75"
            emphasis_1 "#fe9d6e"
            emphasis_2 "#c1d041"
            emphasis_3 "#fd9bc1"
        }
        frame_highlight {
            base "#eecf75"
            background "#1d2021"
            emphasis_0 "#fd9bc1"
            emphasis_1 "#eecf75"
            emphasis_2 "#eecf75"
            emphasis_3 "#eecf75"
        }
        exit_code_success {
            base "#c1d041"
            background "#1d2021"
            emphasis_0 "#fe9d6e"
            emphasis_1 "#d4be98"
            emphasis_2 "#fd9bc1"
            emphasis_3 "#6da3ec"
        }
        exit_code_error {
            base "#ea6926"
            background "#1d2021"
            emphasis_0 "#eecf75"
            emphasis_1 "#d4be98"
            emphasis_2 "#fd9bc1"
            emphasis_3 "#6da3ec"
        }
        multiplayer_user_colors {
            player_1 "#fd9bc1"
            player_2 "#6da3ec"
            player_3 "#fd9bc1"
            player_4 "#eecf75"
            player_5 "#fe9d6e"
            player_6 "#eecf75"
            player_7 "#ea6926"
            player_8 "#ffffff"
            player_9 "#d6644a"
            player_10 "#2c86ff"
        }
    }
}
