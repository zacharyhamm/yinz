        }
        frame_highlight {
            base 255 173 102
            background 0
            emphasis_0 223 191 255
            emphasis_1 255 173 102
            emphasis_2 255 173 102
            emphasis_3 255 173 102
        }
        exit_code_success {
            base 213 255 128
            background 0
            emphasis_0 68 75 85
            emphasis_1 26 31 41
            emphasis_2 223 191 255
            emphasis_3 115 208 255
        }
        exit_code_error {
            base 242 135 121
