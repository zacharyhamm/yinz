themes {
    "oceanic-material" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Oceanic%20Material
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#101a1f"
        terminal {
            foreground "#c2c8d7"
            background "#1c262b"
            black "#000000"
            red "#ee2b2a"
            green "#40a33f"
            yellow "#ffea2e"
            blue "#1e80f0"
            magenta "#8800a0"
            cyan "#16afca"
            white "#a4a4a4"
            bright_black "#777777"
            bright_red "#dc5c60"
            bright_green "#70be71"
            bright_yellow "#fff163"
            bright_blue "#54a4f3"
            bright_magenta "#aa4dbc"
            bright_cyan "#42c7da"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#c2c8d7"
            background "#1c262b"
            emphasis_0 "#ffea2e"
            emphasis_1 "#16afca"
            emphasis_2 "#40a33f"
            emphasis_3 "#bb6dc9"
        }
        text_selected {
            base "#44464a"
            background "#6dc2b8"
            emphasis_0 "#4d470e"
            emphasis_1 "#0a4d59"
            emphasis_2 "#1f501f"
            emphasis_3 "#7a0090"
        }
        table_cell_unselected {
            base "#c2c8d7"
            background "#1c262b"
            emphasis_0 "#ffea2e"
            emphasis_1 "#16afca"
            emphasis_2 "#40a33f"
            emphasis_3 "#bb6dc9"
        }
        table_cell_selected {
            base "#44464a"
            background "#6dc2b8"
            emphasis_0 "#4d470e"
            emphasis_1 "#0a4d59"
            emphasis_2 "#1f501f"
            emphasis_3 "#7a0090"
        }
        list_unselected {
            base "#c2c8d7"
            background "#1c262b"
            emphasis_0 "#ffea2e"
            emphasis_1 "#16afca"
            emphasis_2 "#40a33f"
            emphasis_3 "#bb6dc9"
        }
        list_selected {
            base "#44464a"
            background "#6dc2b8"
            emphasis_0 "#4d470e"
            emphasis_1 "#0a4d59"
            emphasis_2 "#1f501f"
            emphasis_3 "#7a0090"
        }
        ribbon_selected {
            base "#1c262b"
            background "#40a33f"
            emphasis_0 "#530f0f"
            emphasis_1 "#2d2908"
            emphasis_2 "#4b0058"
            emphasis_3 "#0a294d"
        }
        ribbon_unselected {
            base "#1c262b"
            background "#c2c8d7"
            emphasis_0 "#a41e1d"
            emphasis_1 "#c2c8d7"
            emphasis_2 "#14549d"
            emphasis_3 "#8800a0"
        }
        table_title {
            base "#40a33f"
            background "#1c262b"
            emphasis_0 "#ffea2e"
            emphasis_1 "#16afca"
            emphasis_2 "#40a33f"
            emphasis_3 "#bb6dc9"
        }
        frame_unselected {
            base "#c2c8d7"
            background "#1c262b"
            emphasis_0 "#c2c8d7"
            emphasis_1 "#c2c8d7"
            emphasis_2 "#c2c8d7"
            emphasis_3 "#c2c8d7"
        }
        frame_selected {
            base "#40a33f"
            background "#1c262b"
            emphasis_0 "#ffea2e"
            emphasis_1 "#16afca"
            emphasis_2 "#40a33f"
            emphasis_3 "#bb6dc9"
        }
        frame_highlight {
            base "#ffea2e"
            background "#1c262b"
            emphasis_0 "#bb6dc9"
            emphasis_1 "#ffea2e"
            emphasis_2 "#ffea2e"
            emphasis_3 "#ffea2e"
        }
        exit_code_success {
            base "#40a33f"
            background "#1c262b"
            emphasis_0 "#16afca"
            emphasis_1 "#c2c8d7"
            emphasis_2 "#bb6dc9"
            emphasis_3 "#338cf1"
        }
        exit_code_error {
            base "#f15453"
            background "#1c262b"
            emphasis_0 "#ffea2e"
            emphasis_1 "#c2c8d7"
            emphasis_2 "#bb6dc9"
            emphasis_3 "#338cf1"
        }
        multiplayer_user_colors {
            player_1 "#bb6dc9"
            player_2 "#338cf1"
            player_3 "#ba6ec8"
            player_4 "#ffea2e"
            player_5 "#16afca"
            player_6 "#fff163"
            player_7 "#f15453"
            player_8 "#a4a4a4"
            player_9 "#de6468"
            player_10 "#54a4f3"
        }
    }
}
