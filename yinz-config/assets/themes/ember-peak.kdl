themes {
    "ember-peak" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Ember%20Peak
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000003"
        terminal {
            foreground "#f8fafc"
            background "#0a0a0f"
            black "#b7b5b2"
            red "#ff806f"
            green "#65d493"
            yellow "#ffd166"
            blue "#86b5ff"
            magenta "#e29aff"
            cyan "#b8e7ef"
            white "#f8fafc"
            bright_black "#cbc8c3"
            bright_red "#ff9b8f"
            bright_green "#84e0a8"
            bright_yellow "#ffe18a"
            bright_blue "#a8c9ff"
            bright_magenta "#ecb2ff"
            bright_cyan "#c5eef4"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#f8fafc"
            background "#0a0a0f"
            emphasis_0 "#ffd166"
            emphasis_1 "#b8e7ef"
            emphasis_2 "#65d493"
            emphasis_3 "#e29aff"
        }
        text_selected {
            base "#0a0a0f"
            background "#f8fafc"
            emphasis_0 "#897037"
            emphasis_1 "#5f777b"
            emphasis_2 "#3d8059"
            emphasis_3 "#9062a2"
        }
        table_cell_unselected {
            base "#f8fafc"
            background "#0a0a0f"
            emphasis_0 "#ffd166"
            emphasis_1 "#b8e7ef"
            emphasis_2 "#65d493"
            emphasis_3 "#e29aff"
        }
        table_cell_selected {
            base "#fff1df"
            background "#2b1f16"
            emphasis_0 "#ffd166"
            emphasis_1 "#b8e7ef"
            emphasis_2 "#65d493"
            emphasis_3 "#e29aff"
        }
        list_unselected {
            base "#f8fafc"
            background "#0a0a0f"
            emphasis_0 "#ffd166"
            emphasis_1 "#b8e7ef"
            emphasis_2 "#65d493"
            emphasis_3 "#e29aff"
        }
        list_selected {
            base "#fff1df"
            background "#2b1f16"
            emphasis_0 "#ffd166"
            emphasis_1 "#b8e7ef"
            emphasis_2 "#65d493"
            emphasis_3 "#e29aff"
        }
        ribbon_selected {
            base "#0a0a0f"
            background "#65d493"
            emphasis_0 "#783c34"
            emphasis_1 "#5d4c25"
            emphasis_2 "#61426e"
            emphasis_3 "#3a4f6f"
        }
        ribbon_unselected {
            base "#0a0a0f"
            background "#f8fafc"
            emphasis_0 "#b2594d"
            emphasis_1 "#f8fafc"
            emphasis_2 "#5674a4"
            emphasis_3 "#9062a2"
        }
        table_title {
            base "#65d493"
            background "#0a0a0f"
            emphasis_0 "#ffd166"
            emphasis_1 "#b8e7ef"
            emphasis_2 "#65d493"
            emphasis_3 "#e29aff"
        }
        frame_unselected {
            base "#f8fafc"
            background "#0a0a0f"
            emphasis_0 "#f8fafc"
            emphasis_1 "#f8fafc"
            emphasis_2 "#f8fafc"
            emphasis_3 "#f8fafc"
        }
        frame_selected {
            base "#65d493"
            background "#0a0a0f"
            emphasis_0 "#ffd166"
            emphasis_1 "#b8e7ef"
            emphasis_2 "#65d493"
            emphasis_3 "#e29aff"
        }
        frame_highlight {
            base "#ffd166"
            background "#0a0a0f"
            emphasis_0 "#e29aff"
            emphasis_1 "#ffd166"
            emphasis_2 "#ffd166"
            emphasis_3 "#ffd166"
        }
        exit_code_success {
            base "#65d493"
            background "#0a0a0f"
            emphasis_0 "#b8e7ef"
            emphasis_1 "#f8fafc"
            emphasis_2 "#e29aff"
            emphasis_3 "#86b5ff"
        }
        exit_code_error {
            base "#ff806f"
            background "#0a0a0f"
            emphasis_0 "#ffd166"
            emphasis_1 "#f8fafc"
            emphasis_2 "#e29aff"
            emphasis_3 "#86b5ff"
        }
        multiplayer_user_colors {
            player_1 "#e29aff"
            player_2 "#86b5ff"
            player_3 "#ecb2ff"
            player_4 "#ffd166"
            player_5 "#b8e7ef"
            player_6 "#ffe18a"
            player_7 "#ff806f"
            player_8 "#f8fafc"
            player_9 "#ff9b8f"
            player_10 "#a8c9ff"
        }
    }
}
