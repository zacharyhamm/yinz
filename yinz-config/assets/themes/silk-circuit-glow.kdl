themes {
    "silk-circuit-glow" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/SilkCircuit%20Glow
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#00000a"
        terminal {
            foreground "#ffffff"
            background "#0a0816"
            black "#000000"
            red "#ff2244"
            green "#00ff00"
            yellow "#ffff00"
            blue "#0099ff"
            magenta "#ff00ff"
            cyan "#00ffff"
            white "#ffffff"
            bright_black "#818181"
            bright_red "#ff6666"
            bright_green "#66ff66"
            bright_yellow "#ffff66"
            bright_blue "#66ccff"
            bright_magenta "#ff66ff"
            bright_cyan "#66ffff"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#ffffff"
            background "#0a0816"
            emphasis_0 "#ffff00"
            emphasis_1 "#00ffff"
            emphasis_2 "#00ff00"
            emphasis_3 "#ff00ff"
        }
        text_selected {
            base "#0a0816"
            background "#ffffff"
            emphasis_0 "#7a7a00"
            emphasis_1 "#008484"
            emphasis_2 "#008a00"
            emphasis_3 "#d100d1"
        }
        table_cell_unselected {
            base "#ffffff"
            background "#0a0816"
            emphasis_0 "#ffff00"
            emphasis_1 "#00ffff"
            emphasis_2 "#00ff00"
            emphasis_3 "#ff00ff"
        }
        table_cell_selected {
            base "#ffffff"
            background "#4b0654"
            emphasis_0 "#ffff00"
            emphasis_1 "#00ffff"
            emphasis_2 "#00ff00"
            emphasis_3 "#ff00ff"
        }
        list_unselected {
            base "#ffffff"
            background "#0a0816"
            emphasis_0 "#ffff00"
            emphasis_1 "#00ffff"
            emphasis_2 "#00ff00"
            emphasis_3 "#ff00ff"
        }
        list_selected {
            base "#ffffff"
            background "#4b0654"
            emphasis_0 "#ffff00"
            emphasis_1 "#00ffff"
            emphasis_2 "#00ff00"
            emphasis_3 "#ff00ff"
        }
        ribbon_selected {
            base "#0a0816"
            background "#00ff00"
            emphasis_0 "#be1933"
            emphasis_1 "#646400"
            emphasis_2 "#ad00ad"
            emphasis_3 "#0064a7"
        }
        ribbon_unselected {
            base "#0a0816"
            background "#ffffff"
            emphasis_0 "#e71f3e"
            emphasis_1 "#ffffff"
            emphasis_2 "#007acc"
            emphasis_3 "#d100d1"
        }
        table_title {
            base "#00ff00"
            background "#0a0816"
            emphasis_0 "#ffff00"
            emphasis_1 "#00ffff"
            emphasis_2 "#00ff00"
            emphasis_3 "#ff00ff"
        }
        frame_unselected {
            base "#ffffff"
            background "#0a0816"
            emphasis_0 "#ffffff"
            emphasis_1 "#ffffff"
            emphasis_2 "#ffffff"
            emphasis_3 "#ffffff"
        }
        frame_selected {
            base "#00ff00"
            background "#0a0816"
            emphasis_0 "#ffff00"
            emphasis_1 "#00ffff"
            emphasis_2 "#00ff00"
            emphasis_3 "#ff00ff"
        }
        frame_highlight {
            base "#ffff00"
            background "#0a0816"
            emphasis_0 "#ff00ff"
            emphasis_1 "#ffff00"
            emphasis_2 "#ffff00"
            emphasis_3 "#ffff00"
        }
        exit_code_success {
            base "#00ff00"
            background "#0a0816"
            emphasis_0 "#00ffff"
            emphasis_1 "#ffffff"
            emphasis_2 "#ff00ff"
            emphasis_3 "#0099ff"
        }
        exit_code_error {
            base "#ff2244"
            background "#0a0816"
            emphasis_0 "#ffff00"
            emphasis_1 "#ffffff"
            emphasis_2 "#ff00ff"
            emphasis_3 "#0099ff"
        }
        multiplayer_user_colors {
            player_1 "#ff00ff"
            player_2 "#0099ff"
            player_3 "#ff66ff"
            player_4 "#ffff00"
            player_5 "#00ffff"
            player_6 "#ffff66"
            player_7 "#ff2244"
            player_8 "#ffffff"
            player_9 "#ff6666"
            player_10 "#66ccff"
        }
    }
}
