            background "#200101"
            emphasis_0 "#c75454"
            emphasis_1 "#c75454"
            emphasis_2 "#c75454"
            emphasis_3 "#c75454"
        }
        exit_code_success {
            base "#c75454"
            background "#200101"
            emphasis_0 "#c75454"
            emphasis_1 "#c85454"
            emphasis_2 "#c75454"
            emphasis_3 "#c75454"
        }
        exit_code_error {
