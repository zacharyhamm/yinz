themes {
    "terminal-basic" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Terminal%20Basic
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#f3f3f3"
        terminal {
            foreground "#000000"
            background "#ffffff"
            black "#000000"
            red "#990000"
            green "#00a600"
            yellow "#999900"
            blue "#0000b2"
            magenta "#b200b2"
            cyan "#00a6b2"
            white "#bfbfbf"
            bright_black "#666666"
            bright_red "#e50000"
            bright_green "#00d900"
            bright_yellow "#bfbf00"
            bright_blue "#0000ff"
            bright_magenta "#e500e5"
            bright_cyan "#00d8d8"
            bright_white "#e5e5e5"
        }
        text_unselected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#7a7a00"
            emphasis_1 "#00838d"
            emphasis_2 "#008a00"
            emphasis_3 "#b200b2"
        }
        text_selected {
            base "#ffffff"
            background "#000000"
            emphasis_0 "#787833"
            emphasis_1 "#357f84"
            emphasis_2 "#378437"
            emphasis_3 "#b448b4"
        }
        table_cell_unselected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#7a7a00"
            emphasis_1 "#00838d"
            emphasis_2 "#008a00"
            emphasis_3 "#b200b2"
        }
        table_cell_selected {
            base "#000000"
            background "#a4c9ff"
            emphasis_0 "#565600"
            emphasis_1 "#005d64"
            emphasis_2 "#006200"
            emphasis_3 "#960096"
        }
        list_unselected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#7a7a00"
            emphasis_1 "#00838d"
            emphasis_2 "#008a00"
            emphasis_3 "#b200b2"
        }
        list_selected {
            base "#000000"
            background "#a4c9ff"
            emphasis_0 "#565600"
            emphasis_1 "#005d64"
            emphasis_2 "#006200"
            emphasis_3 "#960096"
        }
        ribbon_selected {
            base "#282828"
            background "#00a600"
            emphasis_0 "#590000"
            emphasis_1 "#2a2a00"
            emphasis_2 "#4e004e"
            emphasis_3 "#000095"
        }
        ribbon_unselected {
            base "#ffffff"
            background "#000000"
            emphasis_0 "#bb5454"
            emphasis_1 "#000000"
            emphasis_2 "#6969d2"
            emphasis_3 "#c133c1"
        }
        table_title {
            base "#008a00"
            background "#ffffff"
            emphasis_0 "#7a7a00"
            emphasis_1 "#00838d"
            emphasis_2 "#008a00"
            emphasis_3 "#b200b2"
        }
        frame_unselected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#000000"
            emphasis_1 "#000000"
            emphasis_2 "#000000"
            emphasis_3 "#000000"
        }
        frame_selected {
            base "#008a00"
            background "#ffffff"
            emphasis_0 "#7a7a00"
            emphasis_1 "#00838d"
            emphasis_2 "#008a00"
            emphasis_3 "#b200b2"
        }
        frame_highlight {
            base "#7a7a00"
            background "#ffffff"
            emphasis_0 "#b200b2"
            emphasis_1 "#7a7a00"
            emphasis_2 "#7a7a00"
            emphasis_3 "#7a7a00"
        }
        exit_code_success {
            base "#008a00"
            background "#ffffff"
            emphasis_0 "#00838d"
            emphasis_1 "#000000"
            emphasis_2 "#b200b2"
            emphasis_3 "#0000b2"
        }
        exit_code_error {
            base "#990000"
            background "#ffffff"
            emphasis_0 "#7a7a00"
            emphasis_1 "#000000"
            emphasis_2 "#b200b2"
            emphasis_3 "#0000b2"
        }
        multiplayer_user_colors {
            player_1 "#b200b2"
            player_2 "#0000b2"
            player_3 "#d100d1"
            player_4 "#7a7a00"
            player_5 "#00838d"
            player_6 "#7a7a00"
            player_7 "#990000"
            player_8 "#767676"
            player_9 "#e50000"
            player_10 "#0000ff"
        }
    }
}
