themes {
    "clear-light" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Clear%20Light
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#f3f3f3"
        terminal {
            foreground "#3a4851"
            background "#ffffff"
            black "#2d3840"
            red "#b45648"
            green "#6caa71"
            yellow "#c4ac62"
            blue "#5685a8"
            magenta "#ad64be"
            cyan "#69c6c9"
            white "#c1c8cc"
            bright_black "#506573"
            bright_red "#df6c5a"
            bright_green "#79be7e"
            bright_yellow "#e5c872"
            bright_blue "#49a2e1"
            bright_magenta "#d389e5"
            bright_cyan "#77e1e5"
            bright_white "#d8e1e7"
        }
        text_unselected {
            base "#3a4851"
            background "#ffffff"
            emphasis_0 "#867543"
            emphasis_1 "#448082"
            emphasis_2 "#528156"
            emphasis_3 "#9f5caf"
        }
        text_selected {
            base "#ffffff"
            background "#3a4851"
            emphasis_0 "#bab39c"
            emphasis_1 "#9eb9ba"
            emphasis_2 "#a3b9a5"
            emphasis_3 "#c8aacf"
        }
        table_cell_unselected {
            base "#3a4851"
            background "#ffffff"
            emphasis_0 "#867543"
            emphasis_1 "#448082"
            emphasis_2 "#528156"
            emphasis_3 "#9f5caf"
        }
        table_cell_selected {
            base "#6a6a6a"
            background "#e5ecf1"
            emphasis_0 "#78693c"
            emphasis_1 "#3d7375"
            emphasis_2 "#4a744d"
            emphasis_3 "#8f539d"
        }
        list_unselected {
            base "#3a4851"
            background "#ffffff"
            emphasis_0 "#867543"
            emphasis_1 "#448082"
            emphasis_2 "#528156"
            emphasis_3 "#9f5caf"
        }
        list_selected {
            base "#6a6a6a"
            background "#e5ecf1"
            emphasis_0 "#78693c"
            emphasis_1 "#3d7375"
            emphasis_2 "#4a744d"
            emphasis_3 "#8f539d"
        }
        ribbon_selected {
            base "#343434"
            background "#6caa71"
            emphasis_0 "#532821"
            emphasis_1 "#3a331d"
            emphasis_2 "#47294d"
            emphasis_3 "#233645"
        }
        ribbon_unselected {
            base "#ffffff"
            background "#3a4851"
            emphasis_0 "#d8a8a0"
            emphasis_1 "#3a4851"
            emphasis_2 "#9bb7cb"
            emphasis_3 "#cfa5d9"
        }
        table_title {
            base "#528156"
            background "#ffffff"
            emphasis_0 "#867543"
            emphasis_1 "#448082"
            emphasis_2 "#528156"
            emphasis_3 "#9f5caf"
        }
        frame_unselected {
            base "#3a4851"
            background "#ffffff"
            emphasis_0 "#3a4851"
            emphasis_1 "#3a4851"
            emphasis_2 "#3a4851"
            emphasis_3 "#3a4851"
        }
        frame_selected {
            base "#528156"
            background "#ffffff"
            emphasis_0 "#867543"
            emphasis_1 "#448082"
            emphasis_2 "#528156"
            emphasis_3 "#9f5caf"
        }
        frame_highlight {
            base "#867543"
            background "#ffffff"
            emphasis_0 "#9f5caf"
            emphasis_1 "#867543"
            emphasis_2 "#867543"
            emphasis_3 "#867543"
        }
        exit_code_success {
            base "#528156"
            background "#ffffff"
            emphasis_0 "#448082"
            emphasis_1 "#3a4851"
            emphasis_2 "#9f5caf"
            emphasis_3 "#507b9b"
        }
        exit_code_error {
            base "#b45648"
            background "#ffffff"
            emphasis_0 "#867543"
            emphasis_1 "#3a4851"
            emphasis_2 "#9f5caf"
            emphasis_3 "#507b9b"
        }
        multiplayer_user_colors {
            player_1 "#9f5caf"
            player_2 "#507b9b"
            player_3 "#9863a5"
            player_4 "#867543"
            player_5 "#448082"
            player_6 "#867543"
            player_7 "#b45648"
            player_8 "#73777a"
            player_9 "#ba5a4b"
            player_10 "#387cac"
        }
    }
}
