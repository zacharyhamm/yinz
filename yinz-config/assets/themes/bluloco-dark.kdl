themes {
    "bluloco-dark" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Bluloco%20Dark
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#1c2028"
        terminal {
            foreground "#b9c0cb"
            background "#282c34"
            black "#41444d"
            red "#fc2f52"
            green "#25a45c"
            yellow "#ff936a"
            blue "#3476ff"
            magenta "#7a82da"
            cyan "#4483aa"
            white "#cdd4e0"
            bright_black "#8f9aae"
            bright_red "#ff6480"
            bright_green "#3fc56b"
            bright_yellow "#f9c859"
            bright_blue "#10b1fe"
            bright_magenta "#ff78f8"
            bright_cyan "#5fb9bc"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#b9c0cb"
            background "#282c34"
            emphasis_0 "#ff936a"
            emphasis_1 "#6599b9"
            emphasis_2 "#2ca761"
            emphasis_3 "#848cdd"
        }
        text_selected {
            base "#272b33"
            background "#b9c0ca"
            emphasis_0 "#72422f"
            emphasis_1 "#2b526b"
            emphasis_2 "#145a33"
            emphasis_3 "#464a7d"
        }
        table_cell_unselected {
            base "#b9c0cb"
            background "#282c34"
            emphasis_0 "#ff936a"
            emphasis_1 "#6599b9"
            emphasis_2 "#2ca761"
            emphasis_3 "#848cdd"
        }
        table_cell_selected {
            base "#272b33"
            background "#b9c0ca"
            emphasis_0 "#72422f"
            emphasis_1 "#2b526b"
            emphasis_2 "#145a33"
            emphasis_3 "#464a7d"
        }
        list_unselected {
            base "#b9c0cb"
            background "#282c34"
            emphasis_0 "#ff936a"
            emphasis_1 "#6599b9"
            emphasis_2 "#2ca761"
            emphasis_3 "#848cdd"
        }
        list_selected {
            base "#272b33"
            background "#b9c0ca"
            emphasis_0 "#72422f"
            emphasis_1 "#2b526b"
            emphasis_2 "#145a33"
            emphasis_3 "#464a7d"
        }
        ribbon_selected {
            base "#262931"
            background "#25a45c"
            emphasis_0 "#530f1b"
            emphasis_1 "#3d2319"
            emphasis_2 "#252742"
            emphasis_3 "#112755"
        }
        ribbon_unselected {
            base "#282c34"
            background "#b9c0cb"
            emphasis_0 "#981c32"
            emphasis_1 "#b9c0cb"
            emphasis_2 "#204a9f"
            emphasis_3 "#464a7d"
        }
        table_title {
            base "#2ca761"
            background "#282c34"
            emphasis_0 "#ff936a"
            emphasis_1 "#6599b9"
            emphasis_2 "#2ca761"
            emphasis_3 "#848cdd"
        }
        frame_unselected {
            base "#b9c0cb"
            background "#282c34"
            emphasis_0 "#b9c0cb"
            emphasis_1 "#b9c0cb"
            emphasis_2 "#b9c0cb"
            emphasis_3 "#b9c0cb"
        }
        frame_selected {
            base "#2ca761"
            background "#282c34"
            emphasis_0 "#ff936a"
            emphasis_1 "#6599b9"
            emphasis_2 "#2ca761"
            emphasis_3 "#848cdd"
        }
        frame_highlight {
            base "#ff936a"
            background "#282c34"
            emphasis_0 "#848cdd"
            emphasis_1 "#ff936a"
            emphasis_2 "#ff936a"
            emphasis_3 "#ff936a"
        }
        exit_code_success {
            base "#2ca761"
            background "#282c34"
            emphasis_0 "#6599b9"
            emphasis_1 "#b9c0cb"
            emphasis_2 "#848cdd"
            emphasis_3 "#598fff"
        }
        exit_code_error {
            base "#fd5673"
            background "#282c34"
            emphasis_0 "#ff936a"
            emphasis_1 "#b9c0cb"
            emphasis_2 "#848cdd"
            emphasis_3 "#598fff"
        }
        multiplayer_user_colors {
            player_1 "#848cdd"
            player_2 "#598fff"
            player_3 "#ff78f8"
            player_4 "#ff936a"
            player_5 "#6599b9"
            player_6 "#f9c859"
            player_7 "#fd5673"
            player_8 "#cdd4e0"
            player_9 "#ff6480"
            player_10 "#10b1fe"
        }
    }
}
