            background "#050014"
            emphasis_0 "#816d9e"
            emphasis_1 "#83744f"
            emphasis_2 "#83744f"
            emphasis_3 "#83744f"
        }
        exit_code_success {
            base "#398273"
            background "#050014"
            emphasis_0 "#5d7b83"
            emphasis_1 "#787482"
            emphasis_2 "#816d9e"
            emphasis_3 "#75719b"
        }
        exit_code_error {
            base "#a7626c"
            background "#050014"
            emphasis_0 "#83744f"
            emphasis_1 "#787482"
            emphasis_2 "#816d9e"
