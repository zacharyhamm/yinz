        }
        multiplayer_user_colors {
            player_1 "#816d9e"
            player_2 "#75719b"
            player_3 "#a776e0"
            player_4 "#83744f"
            player_5 "#5d7b83"
            player_6 "#e0c386"
            player_7 "#a7626c"
            player_8 "#787482"
