themes {
    "hot-dog-stand-mustard" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Hot%20Dog%20Stand%20%28Mustard%29
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#f3f348"
        terminal {
            foreground "#000000"
            background "#ffff54"
            black "#000000"
            red "#ea3323"
            green "#ea3323"
            yellow "#ea3323"
            blue "#000000"
            magenta "#ea3323"
            cyan "#000000"
