            bright_green "#ea3323"
            bright_yellow "#ea3323"
            bright_blue "#000000"
            bright_magenta "#ea3323"
            bright_cyan "#000000"
            bright_white "#c6c6c6"
        }
        text_unselected {
            base "#000000"
            background "#ffff54"
            emphasis_0 "#d82f20"
            emphasis_1 "#000000"
            emphasis_2 "#d82f20"
            emphasis_3 "#d82f20"
        }
        text_selected {
            base "#101010"
            background "#ea3323"
            emphasis_0 "#230805"
            emphasis_1 "#000000"
            emphasis_2 "#230805"
            emphasis_3 "#230805"
        }
