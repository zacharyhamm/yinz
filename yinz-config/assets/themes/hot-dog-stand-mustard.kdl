            emphasis_2 "#230805"
            emphasis_3 "#230805"
        }
        ribbon_selected {
            base "#111106"
            background "#ea3323"
            emphasis_0 "#230805"
            emphasis_1 "#230805"
            emphasis_2 "#230805"
            emphasis_3 "#000000"
        }
        ribbon_unselected {
            base "#ffff54"
