themes {
    "twilight" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Twilight
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#080808"
        terminal {
            foreground "#ffffd4"
            background "#141414"
            black "#141414"
            red "#c06d44"
            green "#afb97a"
            yellow "#c2a86c"
            blue "#44474a"
            magenta "#b4be7c"
            cyan "#778385"
            white "#ffffd4"
            bright_black "#404040"
            bright_red "#de7c4c"
            bright_green "#ccd88c"
            bright_yellow "#e2c47e"
            bright_blue "#5a5e62"
            bright_magenta "#d0dc8e"
            bright_cyan "#8a989b"
            bright_white "#ffffd4"
        }
        text_unselected {
            base "#ffffd4"
            background "#141414"
            emphasis_0 "#c2a86c"
            emphasis_1 "#778385"
            emphasis_2 "#afb97a"
            emphasis_3 "#b4be7c"
        }
        text_selected {
            base "#141414"
            background "#ffffd4"
            emphasis_0 "#85734a"
            emphasis_1 "#6f7677"
            emphasis_2 "#72784f"
            emphasis_3 "#72784e"
        }
        table_cell_unselected {
            base "#ffffd4"
            background "#141414"
            emphasis_0 "#c2a86c"
            emphasis_1 "#778385"
            emphasis_2 "#afb97a"
            emphasis_3 "#b4be7c"
        }
        table_cell_selected {
            base "#ffffd4"
            background "#313131"
            emphasis_0 "#c2a86c"
            emphasis_1 "#909a9b"
            emphasis_2 "#afb97a"
            emphasis_3 "#b4be7c"
        }
        list_unselected {
            base "#ffffd4"
            background "#141414"
            emphasis_0 "#c2a86c"
            emphasis_1 "#778385"
            emphasis_2 "#afb97a"
            emphasis_3 "#b4be7c"
        }
        list_selected {
            base "#ffffd4"
            background "#313131"
            emphasis_0 "#c2a86c"
            emphasis_1 "#909a9b"
            emphasis_2 "#afb97a"
            emphasis_3 "#b4be7c"
        }
        ribbon_selected {
            base "#141414"
            background "#afb97a"
            emphasis_0 "#673b25"
            emphasis_1 "#50452c"
            emphasis_2 "#44482f"
            emphasis_3 "#434649"
        }
        ribbon_unselected {
            base "#141414"
            background "#ffffd4"
            emphasis_0 "#ac613d"
            emphasis_1 "#ffffd4"
            emphasis_2 "#44474a"
            emphasis_3 "#72784e"
        }
        table_title {
            base "#afb97a"
            background "#141414"
            emphasis_0 "#c2a86c"
            emphasis_1 "#778385"
            emphasis_2 "#afb97a"
            emphasis_3 "#b4be7c"
        }
        frame_unselected {
            base "#ffffd4"
            background "#141414"
            emphasis_0 "#ffffd4"
            emphasis_1 "#ffffd4"
            emphasis_2 "#ffffd4"
            emphasis_3 "#ffffd4"
        }
        frame_selected {
            base "#afb97a"
            background "#141414"
            emphasis_0 "#c2a86c"
            emphasis_1 "#778385"
            emphasis_2 "#afb97a"
            emphasis_3 "#b4be7c"
        }
        frame_highlight {
            base "#c2a86c"
            background "#141414"
            emphasis_0 "#b4be7c"
            emphasis_1 "#c2a86c"
            emphasis_2 "#c2a86c"
            emphasis_3 "#c2a86c"
        }
        exit_code_success {
            base "#afb97a"
            background "#141414"
            emphasis_0 "#778385"
            emphasis_1 "#ffffd4"
            emphasis_2 "#b4be7c"
            emphasis_3 "#7c7e80"
        }
        exit_code_error {
            base "#c06d44"
            background "#141414"
            emphasis_0 "#c2a86c"
            emphasis_1 "#ffffd4"
            emphasis_2 "#b4be7c"
            emphasis_3 "#7c7e80"
        }
        multiplayer_user_colors {
            player_1 "#b4be7c"
            player_2 "#7c7e80"
            player_3 "#d0dc8e"
            player_4 "#c2a86c"
            player_5 "#778385"
            player_6 "#e2c47e"
            player_7 "#c06d44"
            player_8 "#ffffd4"
            player_9 "#de7c4c"
            player_10 "#7b7e81"
        }
    }
}
