themes {
    dayfox {
        // Terminal palette: https://github.com/EdenEast/nightfox.nvim/blob/main/extra/dayfox/kitty.conf
        pane_surround "#eae6e2"
        terminal {
            foreground "#3d2b5a"
            background "#f6f2ee"
            black "#352c24"
            red "#a5222f"
            green "#396847"
            yellow "#ac5402"
            blue "#2848a9"
            magenta "#6e33ce"
            cyan "#287980"
            white "#f2e9e1"
            bright_black "#534c45"
            bright_red "#b3434e"
            bright_green "#577f63"
            bright_yellow "#b86e28"
            bright_blue "#4863b6"
            bright_magenta "#8452d5"
            bright_cyan "#488d93"
            bright_white "#f4ece6"
        }
        text_unselected {
            base 100 63 97
            background 211 199 187
            emphasis_0 115 73 75
            emphasis_1 31 93 99
            emphasis_2 51 93 64
            emphasis_3 104 48 195
        }
        text_selected {
            base 221 213 220
            background 57 104 71
            emphasis_0 227 212 213
            emphasis_1 199 220 222
            emphasis_2 207 218 210
            emphasis_3 223 210 244
        }
        ribbon_selected {
            base 223 214 205
            background 57 104 71
            emphasis_0 236 209 212
            emphasis_1 227 212 213
            emphasis_2 223 210 244
            emphasis_3 208 215 236
        }
        ribbon_unselected {
            base 211 199 187
            background 61 43 90
            emphasis_0 207 137 144
            emphasis_1 69 44 67
            emphasis_2 137 155 208
            emphasis_3 173 140 227
        }
        table_title {
            base 51 93 64
            background 0
            emphasis_0 115 73 75
            emphasis_1 31 93 99
            emphasis_2 51 93 64
            emphasis_3 104 48 195
        }
        table_cell_selected {
            base 221 213 220
            background 57 104 71
            emphasis_0 227 212 213
            emphasis_1 199 220 222
            emphasis_2 207 218 210
            emphasis_3 223 210 244
        }
        table_cell_unselected {
            base 100 63 97
            background 211 199 187
            emphasis_0 115 73 75
            emphasis_1 31 93 99
            emphasis_2 51 93 64
            emphasis_3 104 48 195
        }
        list_selected {
            base 221 213 220
            background 57 104 71
            emphasis_0 227 212 213
            emphasis_1 199 220 222
            emphasis_2 207 218 210
            emphasis_3 223 210 244
        }
        list_unselected {
            base 100 63 97
            background 211 199 187
            emphasis_0 115 73 75
            emphasis_1 31 93 99
            emphasis_2 51 93 64
            emphasis_3 104 48 195
        }
        frame_selected {
            base 51 93 64
            background 0
            emphasis_0 115 73 75
            emphasis_1 31 93 99
            emphasis_2 104 48 195
            emphasis_3 0
        }
        frame_highlight {
            base 115 73 75
            background 0
            emphasis_0 104 48 195
            emphasis_1 115 73 75
            emphasis_2 115 73 75
            emphasis_3 115 73 75
        }
        exit_code_success {
            base 51 93 64
            background 0
            emphasis_0 31 93 99
            emphasis_1 89 84 79
            emphasis_2 104 48 195
            emphasis_3 40 72 169
        }
        exit_code_error {
            base 162 33 46
            background 0
            emphasis_0 135 66 2
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 104 48 195
            player_2 40 72 169
            player_3 63 63 63
            player_4 135 66 2
            player_5 31 93 99
            player_6 63 63 63
            player_7 162 33 46
            player_8 63 63 63
            player_9 63 63 63
            player_10 63 63 63
        }
    }
}
