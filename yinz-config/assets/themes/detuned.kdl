themes {
    "detuned" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Detuned
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000000"
        terminal {
            foreground "#c7c7c7"
            background "#000000"
            black "#171717"
            red "#fe4386"
            green "#a6e32d"
            yellow "#e6da73"
            blue "#0094d9"
            magenta "#9b37ff"
            cyan "#50b7d9"
            white "#c7c7c7"
            bright_black "#686868"
            bright_red "#fa80ac"
            bright_green "#bde371"
            bright_yellow "#fff27f"
            bright_blue "#00beff"
            bright_magenta "#be9eff"
            bright_cyan "#5ed7ff"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#c7c7c7"
            background "#000000"
            emphasis_0 "#e6da73"
            emphasis_1 "#50b7d9"
            emphasis_2 "#a6e32d"
            emphasis_3 "#9d3bff"
        }
        text_selected {
            base "#000000"
            background "#c1deff"
            emphasis_0 "#676133"
            emphasis_1 "#2d677b"
            emphasis_2 "#4d6915"
            emphasis_3 "#832fd8"
        }
        table_cell_unselected {
            base "#c7c7c7"
            background "#000000"
            emphasis_0 "#e6da73"
            emphasis_1 "#50b7d9"
            emphasis_2 "#a6e32d"
            emphasis_3 "#9d3bff"
        }
        table_cell_selected {
            base "#000000"
            background "#c1deff"
            emphasis_0 "#676133"
            emphasis_1 "#2d677b"
            emphasis_2 "#4d6915"
            emphasis_3 "#832fd8"
        }
        list_unselected {
            base "#c7c7c7"
            background "#000000"
            emphasis_0 "#e6da73"
            emphasis_1 "#50b7d9"
            emphasis_2 "#a6e32d"
            emphasis_3 "#9d3bff"
        }
        list_selected {
            base "#000000"
            background "#c1deff"
            emphasis_0 "#676133"
            emphasis_1 "#2d677b"
            emphasis_2 "#4d6915"
            emphasis_3 "#832fd8"
        }
        ribbon_selected {
            base "#000000"
            background "#a6e32d"
            emphasis_0 "#a22b56"
            emphasis_1 "#5f5a2f"
            emphasis_2 "#7a2bc9"
            emphasis_3 "#005f8c"
        }
        ribbon_unselected {
            base "#000000"
            background "#c7c7c7"
            emphasis_0 "#982850"
            emphasis_1 "#c7c7c7"
            emphasis_2 "#005983"
            emphasis_3 "#7229bc"
        }
        table_title {
            base "#a6e32d"
            background "#000000"
            emphasis_0 "#e6da73"
            emphasis_1 "#50b7d9"
            emphasis_2 "#a6e32d"
            emphasis_3 "#9d3bff"
        }
        frame_unselected {
            base "#c7c7c7"
            background "#000000"
            emphasis_0 "#c7c7c7"
            emphasis_1 "#c7c7c7"
            emphasis_2 "#c7c7c7"
            emphasis_3 "#c7c7c7"
        }
        frame_selected {
            base "#a6e32d"
            background "#000000"
            emphasis_0 "#e6da73"
            emphasis_1 "#50b7d9"
            emphasis_2 "#a6e32d"
            emphasis_3 "#9d3bff"
        }
        frame_highlight {
            base "#e6da73"
            background "#000000"
            emphasis_0 "#9d3bff"
            emphasis_1 "#e6da73"
            emphasis_2 "#e6da73"
            emphasis_3 "#e6da73"
        }
        exit_code_success {
            base "#a6e32d"
            background "#000000"
            emphasis_0 "#50b7d9"
            emphasis_1 "#c7c7c7"
            emphasis_2 "#9d3bff"
            emphasis_3 "#0094d9"
        }
        exit_code_error {
            base "#fe4386"
            background "#000000"
            emphasis_0 "#e6da73"
            emphasis_1 "#c7c7c7"
            emphasis_2 "#9d3bff"
            emphasis_3 "#0094d9"
        }
        multiplayer_user_colors {
            player_1 "#9d3bff"
            player_2 "#0094d9"
            player_3 "#be9eff"
            player_4 "#e6da73"
            player_5 "#50b7d9"
            player_6 "#fff27f"
            player_7 "#fe4386"
            player_8 "#c7c7c7"
            player_9 "#fa80ac"
            player_10 "#00beff"
        }
    }
}
