themes {
    gruvbox-light {
        // Terminal palette: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/master/ghostty/Gruvbox%20Light
        pane_surround "#efe5bb"
        terminal {
            foreground "#3c3836"
            background "#fbf1c7"
            black "#fbf1c7"
            red "#cc241d"
            green "#98971a"
            yellow "#d79921"
            blue "#458588"
            magenta "#b16286"
            cyan "#689d6a"
            white "#7c6f64"
            bright_black "#928374"
            bright_red "#9d0006"
            bright_green "#79740e"
            bright_yellow "#b57614"
            bright_blue "#076678"
            bright_magenta "#8f3f71"
            bright_cyan "#427b58"
            bright_white "#3c3836"
        }
        text_unselected {
            base 60 56 54
            background 235 219 178
            emphasis_0 152 0 5
            emphasis_1 70 105 71
            emphasis_2 103 99 12
            emphasis_3 140 77 106
        }
        text_selected {
            base 235 219 178
            background 60 56 54
            emphasis_0 "#d39193"
            emphasis_1 "#96a696"
            emphasis_2 "#a5a47b"
            emphasis_3 "#b69aa7"
        }
        ribbon_selected {
            base 250 246 235
            background 121 116 14
            emphasis_0 252 245 240
            emphasis_1 251 245 245
            emphasis_2 250 245 247
            emphasis_3 243 247 247
        }
        ribbon_unselected {
            base 235 219 178
            background 80 73 69
            emphasis_0 234 172 131
            emphasis_1 60 56 54
            emphasis_2 159 192 193
            emphasis_3 215 174 193
        }
        table_title {
            base 103 99 12
            background 0
            emphasis_0 152 0 5
            emphasis_1 70 105 71
            emphasis_2 103 99 12
            emphasis_3 140 77 106
        }
        table_cell_selected {
            base 60 56 54
            background 213 196 161
            emphasis_0 152 0 5
            emphasis_1 59 89 60
            emphasis_2 88 85 10
            emphasis_3 119 66 90
        }
        table_cell_unselected {
            base 60 56 54
            background 235 219 178
            emphasis_0 152 0 5
            emphasis_1 70 105 71
            emphasis_2 103 99 12
            emphasis_3 140 77 106
        }
        list_selected {
            base 60 56 54
            background 213 196 161
            emphasis_0 152 0 5
            emphasis_1 59 89 60
            emphasis_2 88 85 10
            emphasis_3 119 66 90
        }
        list_unselected {
            base 60 56 54
            background 235 219 178
            emphasis_0 152 0 5
            emphasis_1 70 105 71
            emphasis_2 103 99 12
            emphasis_3 140 77 106
        }
        frame_selected {
            base 103 99 12
            background 0
            emphasis_0 152 0 5
            emphasis_1 70 105 71
            emphasis_2 140 77 106
            emphasis_3 0
        }
        frame_highlight {
            base 152 0 5
            background 0
            emphasis_0 140 77 106
            emphasis_1 152 0 5
            emphasis_2 152 0 5
            emphasis_3 152 0 5
        }
        exit_code_success {
            base 103 99 12
            background 0
            emphasis_0 70 105 71
            emphasis_1 103 96 78
            emphasis_2 140 77 106
            emphasis_3 55 105 108
        }
        exit_code_error {
            base 161 70 11
            background 0
            emphasis_0 126 90 19
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 140 77 106
            player_2 55 105 108
            player_3 101 97 80
            player_4 126 90 19
            player_5 70 105 71
            player_6 101 97 80
            player_7 161 70 11
            player_8 101 97 80
            player_9 101 97 80
            player_10 101 97 80
        }
    }
}
