themes {
    "nachtschicht" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Nachtschicht
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#0b0d11"
        terminal {
            foreground "#e8eaed"
            background "#17191d"
            black "#0e1012"
            red "#e5484d"
            green "#33d17a"
            yellow "#e3b341"
            blue "#4d7cfe"
            magenta "#c86ad8"
            cyan "#3fc8b0"
            white "#c9cfd6"
            bright_black "#9da4af"
            bright_red "#ef8f92"
            bright_green "#76e0a5"
            bright_yellow "#edcf88"
            bright_blue "#9eb8fe"
            bright_magenta "#e0abe9"
            bright_cyan "#7edaca"
            bright_white "#e8eaed"
        }
        text_unselected {
            base "#e8eaed"
            background "#17191d"
            emphasis_0 "#e3b341"
            emphasis_1 "#3fc8b0"
            emphasis_2 "#33d17a"
            emphasis_3 "#c86ad8"
        }
        text_selected {
            base "#17191d"
            background "#e8eaed"
            emphasis_0 "#816625"
            emphasis_1 "#257668"
            emphasis_2 "#1d7846"
            emphasis_3 "#8a5792"
        }
        table_cell_unselected {
            base "#e8eaed"
            background "#17191d"
            emphasis_0 "#e3b341"
            emphasis_1 "#3fc8b0"
            emphasis_2 "#33d17a"
            emphasis_3 "#c86ad8"
        }
        table_cell_selected {
            base "#e8eaed"
            background "#36393c"
            emphasis_0 "#e3b341"
            emphasis_1 "#3fc8b0"
            emphasis_2 "#33d17a"
            emphasis_3 "#d285df"
        }
        list_unselected {
            base "#e8eaed"
            background "#17191d"
            emphasis_0 "#e3b341"
            emphasis_1 "#3fc8b0"
            emphasis_2 "#33d17a"
            emphasis_3 "#c86ad8"
        }
        list_selected {
            base "#e8eaed"
            background "#36393c"
            emphasis_0 "#e3b341"
            emphasis_1 "#3fc8b0"
            emphasis_2 "#33d17a"
            emphasis_3 "#d285df"
        }
        ribbon_selected {
            base "#17191d"
            background "#33d17a"
            emphasis_0 "#83292c"
            emphasis_1 "#594619"
            emphasis_2 "#67366f"
            emphasis_3 "#2b458d"
        }
        ribbon_unselected {
            base "#17191d"
            background "#e8eaed"
            emphasis_0 "#bd3b3f"
            emphasis_1 "#e8eaed"
            emphasis_2 "#3e63cb"
            emphasis_3 "#934e9f"
        }
        table_title {
            base "#33d17a"
            background "#17191d"
            emphasis_0 "#e3b341"
            emphasis_1 "#3fc8b0"
            emphasis_2 "#33d17a"
            emphasis_3 "#c86ad8"
        }
        frame_unselected {
            base "#e8eaed"
            background "#17191d"
            emphasis_0 "#e8eaed"
            emphasis_1 "#e8eaed"
            emphasis_2 "#e8eaed"
            emphasis_3 "#e8eaed"
        }
        frame_selected {
            base "#33d17a"
            background "#17191d"
            emphasis_0 "#e3b341"
            emphasis_1 "#3fc8b0"
            emphasis_2 "#33d17a"
            emphasis_3 "#c86ad8"
        }
        frame_highlight {
            base "#e3b341"
            background "#17191d"
            emphasis_0 "#c86ad8"
            emphasis_1 "#e3b341"
            emphasis_2 "#e3b341"
            emphasis_3 "#e3b341"
        }
        exit_code_success {
            base "#33d17a"
            background "#17191d"
            emphasis_0 "#3fc8b0"
            emphasis_1 "#e8eaed"
            emphasis_2 "#c86ad8"
            emphasis_3 "#4d7cfe"
        }
        exit_code_error {
            base "#e5494e"
            background "#17191d"
            emphasis_0 "#e3b341"
            emphasis_1 "#e8eaed"
            emphasis_2 "#c86ad8"
            emphasis_3 "#4d7cfe"
        }
        multiplayer_user_colors {
            player_1 "#c86ad8"
            player_2 "#4d7cfe"
            player_3 "#e0abe9"
            player_4 "#e3b341"
            player_5 "#3fc8b0"
            player_6 "#edcf88"
            player_7 "#e5494e"
            player_8 "#c9cfd6"
            player_9 "#ef8f92"
            player_10 "#9eb8fe"
        }
    }
}
