themes {
    "painted-desert" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Painted%20Desert
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#4d253c"
        terminal {
            foreground "#fff0df"
            background "#593148"
            black "#d7c7c8"
            red "#ffa08e"
            green "#99d6a8"
            yellow "#f2d071"
            blue "#9ccbed"
            magenta "#e7acd7"
            cyan "#92ded8"
            white "#fff0df"
            bright_black "#e4d6d7"
            bright_red "#ffb5a4"
            bright_green "#b0e0ba"
            bright_yellow "#ffe091"
            bright_blue "#b7daf2"
            bright_magenta "#f0c2e0"
            bright_cyan "#b1e9e4"
            bright_white "#fffaf2"
        }
        text_unselected {
            base "#fff0df"
            background "#593148"
            emphasis_0 "#f2d071"
            emphasis_1 "#92ded8"
            emphasis_2 "#99d6a8"
            emphasis_3 "#e7acd7"
        }
        text_selected {
            base "#593148"
            background "#fff0df"
            emphasis_0 "#7f6d3b"
            emphasis_1 "#4e7673"
            emphasis_2 "#58755f"
            emphasis_3 "#7f6879"
        }
        table_cell_unselected {
            base "#fff0df"
            background "#593148"
            emphasis_0 "#f2d071"
            emphasis_1 "#92ded8"
            emphasis_2 "#99d6a8"
            emphasis_3 "#e7acd7"
        }
        table_cell_selected {
            base "#fff7ec"
            background "#774b63"
            emphasis_0 "#f2d071"
            emphasis_1 "#92ded8"
            emphasis_2 "#a5dbb2"
            emphasis_3 "#edc2e2"
        }
        list_unselected {
            base "#fff0df"
            background "#593148"
            emphasis_0 "#f2d071"
            emphasis_1 "#92ded8"
            emphasis_2 "#99d6a8"
            emphasis_3 "#e7acd7"
        }
        list_selected {
            base "#fff7ec"
            background "#774b63"
            emphasis_0 "#f2d071"
            emphasis_1 "#92ded8"
            emphasis_2 "#a5dbb2"
            emphasis_3 "#edc2e2"
        }
        ribbon_selected {
            base "#593148"
            background "#99d6a8"
            emphasis_0 "#754941"
            emphasis_1 "#61532d"
            emphasis_2 "#664c5f"
            emphasis_3 "#425664"
        }
        ribbon_unselected {
            base "#593148"
            background "#fff0df"
            emphasis_0 "#996055"
            emphasis_1 "#fff0df"
            emphasis_2 "#577285"
            emphasis_3 "#86647d"
        }
        table_title {
            base "#99d6a8"
            background "#593148"
            emphasis_0 "#f2d071"
            emphasis_1 "#92ded8"
            emphasis_2 "#99d6a8"
            emphasis_3 "#e7acd7"
        }
        frame_unselected {
            base "#fff0df"
            background "#593148"
            emphasis_0 "#fff0df"
            emphasis_1 "#fff0df"
            emphasis_2 "#fff0df"
            emphasis_3 "#fff0df"
        }
        frame_selected {
            base "#99d6a8"
            background "#593148"
            emphasis_0 "#f2d071"
            emphasis_1 "#92ded8"
            emphasis_2 "#99d6a8"
            emphasis_3 "#e7acd7"
        }
        frame_highlight {
            base "#f2d071"
            background "#593148"
            emphasis_0 "#e7acd7"
            emphasis_1 "#f2d071"
            emphasis_2 "#f2d071"
            emphasis_3 "#f2d071"
        }
        exit_code_success {
            base "#99d6a8"
            background "#593148"
            emphasis_0 "#92ded8"
            emphasis_1 "#fff0df"
            emphasis_2 "#e7acd7"
            emphasis_3 "#9ccbed"
        }
        exit_code_error {
            base "#ffa08e"
            background "#593148"
            emphasis_0 "#f2d071"
            emphasis_1 "#fff0df"
            emphasis_2 "#e7acd7"
            emphasis_3 "#9ccbed"
        }
        multiplayer_user_colors {
            player_1 "#e7acd7"
            player_2 "#9ccbed"
            player_3 "#f0c2e0"
            player_4 "#f2d071"
            player_5 "#92ded8"
            player_6 "#ffe091"
            player_7 "#ffa08e"
            player_8 "#fff0df"
            player_9 "#ffb5a4"
            player_10 "#b7daf2"
        }
    }
}
