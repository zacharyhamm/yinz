themes {
    "tailwind-dark" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Tailwind%20Dark
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#1a1a1a"
        terminal {
            foreground "#e5e5e5"
            background "#262626"
            black "#404040"
            red "#f87171"
            green "#4ade80"
            yellow "#facc15"
            blue "#38bdf8"
            magenta "#e879f9"
            cyan "#2dd4bf"
            white "#e5e5e5"
            bright_black "#a3a3a3"
            bright_red "#fca5a5"
            bright_green "#86efac"
            bright_yellow "#fde047"
            bright_blue "#7dd3fc"
            bright_magenta "#f0abfc"
            bright_cyan "#5eead4"
            bright_white "#f5f5f5"
        }
        text_unselected {
            base "#e5e5e5"
            background "#262626"
            emphasis_0 "#facc15"
            emphasis_1 "#2dd4bf"
            emphasis_2 "#4ade80"
            emphasis_3 "#e879f9"
        }
        text_selected {
            base "#262626"
            background "#e5e5e5"
            emphasis_0 "#7b640a"
            emphasis_1 "#2b7168"
            emphasis_2 "#2d7447"
            emphasis_3 "#7c5b81"
        }
        table_cell_unselected {
            base "#e5e5e5"
            background "#262626"
            emphasis_0 "#facc15"
            emphasis_1 "#2dd4bf"
            emphasis_2 "#4ade80"
            emphasis_3 "#e879f9"
        }
        table_cell_selected {
            base "#e5e5e5"
            background "#475569"
            emphasis_0 "#facc15"
            emphasis_1 "#54dccb"
            emphasis_2 "#58e18a"
            emphasis_3 "#f2b2fc"
        }
        list_unselected {
            base "#e5e5e5"
            background "#262626"
            emphasis_0 "#facc15"
            emphasis_1 "#2dd4bf"
            emphasis_2 "#4ade80"
            emphasis_3 "#e879f9"
        }
        list_selected {
            base "#e5e5e5"
            background "#475569"
            emphasis_0 "#facc15"
            emphasis_1 "#54dccb"
            emphasis_2 "#58e18a"
            emphasis_3 "#f2b2fc"
        }
        ribbon_selected {
            base "#262626"
            background "#4ade80"
            emphasis_0 "#833c3c"
            emphasis_1 "#625008"
            emphasis_2 "#733c7b"
            emphasis_3 "#1a5773"
        }
        ribbon_unselected {
            base "#262626"
            background "#e5e5e5"
            emphasis_0 "#a44b4b"
            emphasis_1 "#e5e5e5"
            emphasis_2 "#216e91"
            emphasis_3 "#914b9b"
        }
        table_title {
            base "#4ade80"
            background "#262626"
            emphasis_0 "#facc15"
            emphasis_1 "#2dd4bf"
            emphasis_2 "#4ade80"
            emphasis_3 "#e879f9"
        }
        frame_unselected {
            base "#e5e5e5"
            background "#262626"
            emphasis_0 "#e5e5e5"
            emphasis_1 "#e5e5e5"
            emphasis_2 "#e5e5e5"
            emphasis_3 "#e5e5e5"
        }
        frame_selected {
            base "#4ade80"
            background "#262626"
            emphasis_0 "#facc15"
            emphasis_1 "#2dd4bf"
            emphasis_2 "#4ade80"
            emphasis_3 "#e879f9"
        }
        frame_highlight {
            base "#facc15"
            background "#262626"
            emphasis_0 "#e879f9"
            emphasis_1 "#facc15"
            emphasis_2 "#facc15"
            emphasis_3 "#facc15"
        }
        exit_code_success {
            base "#4ade80"
            background "#262626"
            emphasis_0 "#2dd4bf"
            emphasis_1 "#e5e5e5"
            emphasis_2 "#e879f9"
            emphasis_3 "#38bdf8"
        }
        exit_code_error {
            base "#f87171"
            background "#262626"
            emphasis_0 "#facc15"
            emphasis_1 "#e5e5e5"
            emphasis_2 "#e879f9"
            emphasis_3 "#38bdf8"
        }
        multiplayer_user_colors {
            player_1 "#e879f9"
            player_2 "#38bdf8"
            player_3 "#f0abfc"
            player_4 "#facc15"
            player_5 "#2dd4bf"
            player_6 "#fde047"
            player_7 "#f87171"
            player_8 "#e5e5e5"
            player_9 "#fca5a5"
            player_10 "#7dd3fc"
        }
    }
}
