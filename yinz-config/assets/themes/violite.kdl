themes {
    "violite" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Violite
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#18102a"
        terminal {
            foreground "#eef4f6"
            background "#241c36"
            black "#241c36"
            red "#ec7979"
            green "#79ecb3"
            yellow "#ece279"
            blue "#a979ec"
            magenta "#ec79ec"
            cyan "#79ecec"
            white "#eef4f6"
            bright_black "#56447a"
            bright_red "#ef8f8f"
            bright_green "#9fefbf"
            bright_yellow "#efe78f"
            bright_blue "#b78fef"
            bright_magenta "#ef8fcf"
            bright_cyan "#9fefef"
            bright_white "#f8fafc"
        }
        text_unselected {
            base "#eef4f6"
            background "#241c36"
            emphasis_0 "#ece279"
            emphasis_1 "#79ecec"
            emphasis_2 "#79ecb3"
            emphasis_3 "#ec79ec"
        }
        text_selected {
            base "#241c36"
            background "#eef4f6"
            emphasis_0 "#76713d"
            emphasis_1 "#3e7878"
            emphasis_2 "#3f7a5d"
            emphasis_3 "#995699"
        }
        table_cell_unselected {
            base "#eef4f6"
            background "#241c36"
            emphasis_0 "#ece279"
            emphasis_1 "#79ecec"
            emphasis_2 "#79ecb3"
            emphasis_3 "#ec79ec"
        }
        table_cell_selected {
            base "#eef4f6"
            background "#49376d"
            emphasis_0 "#ece279"
            emphasis_1 "#79ecec"
            emphasis_2 "#79ecb3"
            emphasis_3 "#ee86ee"
        }
        list_unselected {
            base "#eef4f6"
            background "#241c36"
            emphasis_0 "#ece279"
            emphasis_1 "#79ecec"
            emphasis_2 "#79ecb3"
            emphasis_3 "#ec79ec"
        }
        list_selected {
            base "#eef4f6"
            background "#49376d"
            emphasis_0 "#ece279"
            emphasis_1 "#79ecec"
            emphasis_2 "#79ecb3"
            emphasis_3 "#ee86ee"
        }
        ribbon_selected {
            base "#241c36"
            background "#79ecb3"
            emphasis_0 "#8e4949"
            emphasis_1 "#625e32"
            emphasis_2 "#864586"
            emphasis_3 "#6d4e99"
        }
        ribbon_unselected {
            base "#241c36"
            background "#eef4f6"
            emphasis_0 "#a95757"
            emphasis_1 "#eef4f6"
            emphasis_2 "#825db5"
            emphasis_3 "#9f529f"
        }
        table_title {
            base "#79ecb3"
            background "#241c36"
            emphasis_0 "#ece279"
            emphasis_1 "#79ecec"
            emphasis_2 "#79ecb3"
            emphasis_3 "#ec79ec"
        }
        frame_unselected {
            base "#eef4f6"
            background "#241c36"
            emphasis_0 "#eef4f6"
            emphasis_1 "#eef4f6"
            emphasis_2 "#eef4f6"
            emphasis_3 "#eef4f6"
        }
        frame_selected {
            base "#79ecb3"
            background "#241c36"
            emphasis_0 "#ece279"
            emphasis_1 "#79ecec"
            emphasis_2 "#79ecb3"
            emphasis_3 "#ec79ec"
        }
        frame_highlight {
            base "#ece279"
            background "#241c36"
            emphasis_0 "#ec79ec"
            emphasis_1 "#ece279"
            emphasis_2 "#ece279"
            emphasis_3 "#ece279"
        }
        exit_code_success {
            base "#79ecb3"
            background "#241c36"
            emphasis_0 "#79ecec"
            emphasis_1 "#eef4f6"
            emphasis_2 "#ec79ec"
            emphasis_3 "#a979ec"
        }
        exit_code_error {
            base "#ec7979"
            background "#241c36"
            emphasis_0 "#ece279"
            emphasis_1 "#eef4f6"
            emphasis_2 "#ec79ec"
            emphasis_3 "#a979ec"
        }
        multiplayer_user_colors {
            player_1 "#ec79ec"
            player_2 "#a979ec"
            player_3 "#ef8fcf"
            player_4 "#ece279"
            player_5 "#79ecec"
            player_6 "#efe78f"
            player_7 "#ec7979"
            player_8 "#eef4f6"
            player_9 "#ef8f8f"
            player_10 "#b78fef"
        }
    }
}
