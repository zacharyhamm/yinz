themes {
    "velvet-court" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Velvet%20Court
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#130210"
        terminal {
            foreground "#f2dcea"
            background "#1f0e1c"
            black "#2f1629"
            red "#ee5c82"
            green "#9ad08a"
            yellow "#f0c44e"
            blue "#b392e8"
            magenta "#d087e0"
            cyan "#6fd0c8"
            white "#e2c8d8"
            bright_black "#836075"
            bright_red "#ee5c82"
            bright_green "#9ad08a"
            bright_yellow "#e8964f"
            bright_blue "#b392e8"
            bright_magenta "#d087e0"
            bright_cyan "#6fd0c8"
            bright_white "#f2dcea"
        }
        text_unselected {
            base "#f2dcea"
            background "#1f0e1c"
            emphasis_0 "#f0c44e"
            emphasis_1 "#6fd0c8"
            emphasis_2 "#9ad08a"
            emphasis_3 "#d087e0"
        }
        text_selected {
            base "#1f0e1c"
            background "#f2dcea"
            emphasis_0 "#786227"
            emphasis_1 "#3a6d69"
            emphasis_2 "#506c48"
            emphasis_3 "#82548c"
        }
        table_cell_unselected {
            base "#f2dcea"
            background "#1f0e1c"
            emphasis_0 "#f0c44e"
            emphasis_1 "#6fd0c8"
            emphasis_2 "#9ad08a"
            emphasis_3 "#d087e0"
        }
        table_cell_selected {
            base "#998e97"
            background "#3e2138"
            emphasis_0 "#f0c44e"
            emphasis_1 "#6fd0c8"
            emphasis_2 "#9ad08a"
            emphasis_3 "#d087e0"
        }
        list_unselected {
            base "#f2dcea"
            background "#1f0e1c"
            emphasis_0 "#f0c44e"
            emphasis_1 "#6fd0c8"
            emphasis_2 "#9ad08a"
            emphasis_3 "#d087e0"
        }
        list_selected {
            base "#998e97"
            background "#3e2138"
            emphasis_0 "#f0c44e"
            emphasis_1 "#6fd0c8"
            emphasis_2 "#9ad08a"
            emphasis_3 "#d087e0"
        }
        ribbon_selected {
            base "#1f0e1c"
            background "#9ad08a"
            emphasis_0 "#863449"
            emphasis_1 "#604e1f"
            emphasis_2 "#67436f"
            emphasis_3 "#584873"
        }
        ribbon_unselected {
            base "#1f0e1c"
            background "#f2dcea"
            emphasis_0 "#a9415c"
            emphasis_1 "#f2dcea"
            emphasis_2 "#705b91"
            emphasis_3 "#82548c"
        }
        table_title {
            base "#9ad08a"
            background "#1f0e1c"
            emphasis_0 "#f0c44e"
            emphasis_1 "#6fd0c8"
            emphasis_2 "#9ad08a"
            emphasis_3 "#d087e0"
        }
        frame_unselected {
            base "#f2dcea"
            background "#1f0e1c"
            emphasis_0 "#f2dcea"
            emphasis_1 "#f2dcea"
            emphasis_2 "#f2dcea"
            emphasis_3 "#f2dcea"
        }
        frame_selected {
            base "#9ad08a"
            background "#1f0e1c"
            emphasis_0 "#f0c44e"
            emphasis_1 "#6fd0c8"
            emphasis_2 "#9ad08a"
            emphasis_3 "#d087e0"
        }
        frame_highlight {
            base "#f0c44e"
            background "#1f0e1c"
            emphasis_0 "#d087e0"
            emphasis_1 "#f0c44e"
            emphasis_2 "#f0c44e"
            emphasis_3 "#f0c44e"
        }
        exit_code_success {
            base "#9ad08a"
            background "#1f0e1c"
            emphasis_0 "#6fd0c8"
            emphasis_1 "#f2dcea"
            emphasis_2 "#d087e0"
            emphasis_3 "#b392e8"
        }
        exit_code_error {
            base "#ee5c82"
            background "#1f0e1c"
            emphasis_0 "#f0c44e"
            emphasis_1 "#f2dcea"
            emphasis_2 "#d087e0"
            emphasis_3 "#b392e8"
        }
        multiplayer_user_colors {
            player_1 "#d087e0"
            player_2 "#b392e8"
            player_3 "#d087e0"
            player_4 "#f0c44e"
            player_5 "#6fd0c8"
            player_6 "#e8964f"
            player_7 "#ee5c82"
            player_8 "#e2c8d8"
            player_9 "#ee5c82"
            player_10 "#b392e8"
        }
    }
}
