themes {
    "rebecca" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Rebecca
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#1d1e38"
        terminal {
            foreground "#e8e6ed"
            background "#292a44"
            black "#12131e"
            red "#dd7755"
            green "#04dbb5"
            yellow "#f2e7b7"
            blue "#7aa5ff"
            magenta "#bf9cf9"
            cyan "#56d3c2"
            white "#e4e3e9"
            bright_black "#666699"
            bright_red "#ff92cd"
            bright_green "#01eac0"
            bright_yellow "#fffca8"
            bright_blue "#69c0fa"
            bright_magenta "#c17ff8"
            bright_cyan "#8bfde1"
            bright_white "#f4f2f9"
        }
        text_unselected {
            base "#e8e6ed"
            background "#292a44"
            emphasis_0 "#f2e7b7"
            emphasis_1 "#56d3c2"
            emphasis_2 "#04dbb5"
            emphasis_3 "#bf9cf9"
        }
        text_selected {
            base "#292a44"
            background "#e8e6ed"
            emphasis_0 "#6d6853"
            emphasis_1 "#2f7269"
            emphasis_2 "#027661"
            emphasis_3 "#706088"
        }
        table_cell_unselected {
            base "#e8e6ed"
            background "#292a44"
            emphasis_0 "#f2e7b7"
            emphasis_1 "#56d3c2"
            emphasis_2 "#04dbb5"
            emphasis_3 "#bf9cf9"
        }
        table_cell_selected {
            base "#f4f2f9"
            background "#663399"
            emphasis_0 "#f2e7b7"
            emphasis_1 "#56d3c2"
            emphasis_2 "#04dbb5"
            emphasis_3 "#cdb1fa"
        }
        list_unselected {
            base "#e8e6ed"
            background "#292a44"
            emphasis_0 "#f2e7b7"
            emphasis_1 "#56d3c2"
            emphasis_2 "#04dbb5"
            emphasis_3 "#bf9cf9"
        }
        list_selected {
            base "#f4f2f9"
            background "#663399"
            emphasis_0 "#f2e7b7"
            emphasis_1 "#56d3c2"
            emphasis_2 "#04dbb5"
            emphasis_3 "#cdb1fa"
        }
        ribbon_selected {
            base "#292a44"
            background "#04dbb5"
            emphasis_0 "#79412f"
            emphasis_1 "#54503f"
            emphasis_2 "#584873"
            emphasis_3 "#3b507b"
        }
        ribbon_unselected {
            base "#292a44"
            background "#e8e6ed"
            emphasis_0 "#9d543c"
            emphasis_1 "#e8e6ed"
            emphasis_2 "#4c679f"
            emphasis_3 "#735e96"
        }
        table_title {
            base "#04dbb5"
            background "#292a44"
            emphasis_0 "#f2e7b7"
            emphasis_1 "#56d3c2"
            emphasis_2 "#04dbb5"
            emphasis_3 "#bf9cf9"
        }
        frame_unselected {
            base "#e8e6ed"
            background "#292a44"
            emphasis_0 "#e8e6ed"
            emphasis_1 "#e8e6ed"
            emphasis_2 "#e8e6ed"
            emphasis_3 "#e8e6ed"
        }
        frame_selected {
            base "#04dbb5"
            background "#292a44"
            emphasis_0 "#f2e7b7"
            emphasis_1 "#56d3c2"
            emphasis_2 "#04dbb5"
            emphasis_3 "#bf9cf9"
        }
        frame_highlight {
            base "#f2e7b7"
            background "#292a44"
            emphasis_0 "#bf9cf9"
            emphasis_1 "#f2e7b7"
            emphasis_2 "#f2e7b7"
            emphasis_3 "#f2e7b7"
        }
        exit_code_success {
            base "#04dbb5"
            background "#292a44"
            emphasis_0 "#56d3c2"
            emphasis_1 "#e8e6ed"
            emphasis_2 "#bf9cf9"
            emphasis_3 "#7aa5ff"
        }
        exit_code_error {
            base "#dd7755"
            background "#292a44"
            emphasis_0 "#f2e7b7"
            emphasis_1 "#e8e6ed"
            emphasis_2 "#bf9cf9"
            emphasis_3 "#7aa5ff"
        }
        multiplayer_user_colors {
            player_1 "#bf9cf9"
            player_2 "#7aa5ff"
            player_3 "#c17ff8"
            player_4 "#f2e7b7"
            player_5 "#56d3c2"
            player_6 "#fffca8"
            player_7 "#dd7755"
            player_8 "#e4e3e9"
            player_9 "#ff92cd"
            player_10 "#69c0fa"
        }
    }
}
