themes {
    "poimandres-storm" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Poimandres%20Storm
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#191f2b"
        terminal {
            foreground "#a6accd"
            background "#252b37"
            black "#252b37"
            red "#d0679d"
            green "#5de4c7"
            yellow "#fffac2"
            blue "#89ddff"
            magenta "#f087bd"
            cyan "#89ddff"
            white "#ffffff"
            bright_black "#a6accd"
            bright_red "#d0679d"
            bright_green "#5de4c7"
            bright_yellow "#fffac2"
            bright_blue "#add7ff"
            bright_magenta "#f087bd"
            bright_cyan "#add7ff"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#a6accd"
            background "#252b37"
            emphasis_0 "#fffac2"
            emphasis_1 "#89ddff"
            emphasis_2 "#5de4c7"
            emphasis_3 "#f087bd"
        }
        text_selected {
            base "#424242"
            background "#a6accd"
            emphasis_0 "#434233"
            emphasis_1 "#2b4550"
            emphasis_2 "#1e4940"
            emphasis_3 "#5e354a"
        }
        table_cell_unselected {
            base "#a6accd"
            background "#252b37"
            emphasis_0 "#fffac2"
            emphasis_1 "#89ddff"
            emphasis_2 "#5de4c7"
            emphasis_3 "#f087bd"
        }
        table_cell_selected {
            base "#424242"
            background "#a6accd"
            emphasis_0 "#434233"
            emphasis_1 "#2b4550"
            emphasis_2 "#1e4940"
            emphasis_3 "#5e354a"
        }
        list_unselected {
            base "#a6accd"
            background "#252b37"
            emphasis_0 "#fffac2"
            emphasis_1 "#89ddff"
            emphasis_2 "#5de4c7"
            emphasis_3 "#f087bd"
        }
        list_selected {
            base "#424242"
            background "#a6accd"
            emphasis_0 "#434233"
            emphasis_1 "#2b4550"
            emphasis_2 "#1e4940"
            emphasis_3 "#5e354a"
        }
        ribbon_selected {
            base "#252b37"
            background "#5de4c7"
            emphasis_0 "#854264"
            emphasis_1 "#5b5945"
            emphasis_2 "#7e4763"
            emphasis_3 "#395d6b"
        }
        ribbon_unselected {
            base "#252b37"
            background "#a6accd"
            emphasis_0 "#64314b"
            emphasis_1 "#a6accd"
            emphasis_2 "#2b4550"
            emphasis_3 "#5e354a"
        }
        table_title {
            base "#5de4c7"
            background "#252b37"
            emphasis_0 "#fffac2"
            emphasis_1 "#89ddff"
            emphasis_2 "#5de4c7"
            emphasis_3 "#f087bd"
        }
        frame_unselected {
            base "#a6accd"
            background "#252b37"
            emphasis_0 "#a6accd"
            emphasis_1 "#a6accd"
            emphasis_2 "#a6accd"
            emphasis_3 "#a6accd"
        }
        frame_selected {
            base "#5de4c7"
            background "#252b37"
            emphasis_0 "#fffac2"
            emphasis_1 "#89ddff"
            emphasis_2 "#5de4c7"
            emphasis_3 "#f087bd"
        }
        frame_highlight {
            base "#fffac2"
            background "#252b37"
            emphasis_0 "#f087bd"
            emphasis_1 "#fffac2"
            emphasis_2 "#fffac2"
            emphasis_3 "#fffac2"
        }
        exit_code_success {
            base "#5de4c7"
            background "#252b37"
            emphasis_0 "#89ddff"
            emphasis_1 "#a6accd"
            emphasis_2 "#f087bd"
            emphasis_3 "#89ddff"
        }
        exit_code_error {
            base "#d371a3"
            background "#252b37"
            emphasis_0 "#fffac2"
            emphasis_1 "#a6accd"
            emphasis_2 "#f087bd"
            emphasis_3 "#89ddff"
        }
        multiplayer_user_colors {
            player_1 "#f087bd"
            player_2 "#89ddff"
            player_3 "#f087bd"
            player_4 "#fffac2"
            player_5 "#89ddff"
            player_6 "#fffac2"
            player_7 "#d371a3"
            player_8 "#ffffff"
            player_9 "#d371a3"
            player_10 "#add7ff"
        }
    }
}
