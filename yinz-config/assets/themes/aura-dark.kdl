themes {
    "aura-dark" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Aura%20Dark
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#09080f"
        terminal {
            foreground "#cdccce"
            background "#15141b"
            black "#15141b"
            red "#ff6767"
            green "#61ffca"
            yellow "#ffca85"
            blue "#a277ff"
            magenta "#61ffca"
            cyan "#a277ff"
            white "#cdccce"
            bright_black "#464646"
            bright_red "#ffca85"
            bright_green "#a277ff"
            bright_yellow "#ffca85"
            bright_blue "#a277ff"
            bright_magenta "#61ffca"
            bright_cyan "#61ffca"
            bright_white "#edecee"
        }
        text_unselected {
            base "#cdccce"
            background "#15141b"
            emphasis_0 "#ffca85"
            emphasis_1 "#a277ff"
            emphasis_2 "#61ffca"
            emphasis_3 "#61ffca"
        }
        text_selected {
            base "#15141b"
            background "#cdccce"
            emphasis_0 "#695337"
            emphasis_1 "#62489a"
            emphasis_2 "#25614d"
            emphasis_3 "#25614d"
        }
        table_cell_unselected {
            base "#cdccce"
            background "#15141b"
            emphasis_0 "#ffca85"
            emphasis_1 "#a277ff"
            emphasis_2 "#61ffca"
            emphasis_3 "#61ffca"
        }
        table_cell_selected {
            base "#15141b"
            background "#cdccce"
            emphasis_0 "#695337"
            emphasis_1 "#62489a"
            emphasis_2 "#25614d"
            emphasis_3 "#25614d"
        }
        list_unselected {
            base "#cdccce"
            background "#15141b"
            emphasis_0 "#ffca85"
            emphasis_1 "#a277ff"
            emphasis_2 "#61ffca"
            emphasis_3 "#61ffca"
        }
        list_selected {
            base "#15141b"
            background "#cdccce"
            emphasis_0 "#695337"
            emphasis_1 "#62489a"
            emphasis_2 "#25614d"
            emphasis_3 "#25614d"
        }
        ribbon_selected {
            base "#15141b"
            background "#61ffca"
            emphasis_0 "#ac4545"
            emphasis_1 "#7c6241"
            emphasis_2 "#2b725a"
            emphasis_3 "#7354b5"
        }
        ribbon_unselected {
            base "#15141b"
            background "#cdccce"
            emphasis_0 "#923b3b"
            emphasis_1 "#cdccce"
            emphasis_2 "#62489a"
            emphasis_3 "#25614d"
        }
        table_title {
            base "#61ffca"
            background "#15141b"
            emphasis_0 "#ffca85"
            emphasis_1 "#a277ff"
            emphasis_2 "#61ffca"
            emphasis_3 "#61ffca"
        }
        frame_unselected {
            base "#cdccce"
            background "#15141b"
            emphasis_0 "#cdccce"
            emphasis_1 "#cdccce"
            emphasis_2 "#cdccce"
            emphasis_3 "#cdccce"
        }
        frame_selected {
            base "#61ffca"
            background "#15141b"
            emphasis_0 "#ffca85"
            emphasis_1 "#a277ff"
            emphasis_2 "#61ffca"
            emphasis_3 "#61ffca"
        }
        frame_highlight {
            base "#ffca85"
            background "#15141b"
            emphasis_0 "#61ffca"
            emphasis_1 "#ffca85"
            emphasis_2 "#ffca85"
            emphasis_3 "#ffca85"
        }
        exit_code_success {
            base "#61ffca"
            background "#15141b"
            emphasis_0 "#a277ff"
            emphasis_1 "#cdccce"
            emphasis_2 "#61ffca"
            emphasis_3 "#a277ff"
        }
        exit_code_error {
            base "#ff6767"
            background "#15141b"
            emphasis_0 "#ffca85"
            emphasis_1 "#cdccce"
            emphasis_2 "#61ffca"
            emphasis_3 "#a277ff"
        }
        multiplayer_user_colors {
            player_1 "#61ffca"
            player_2 "#a277ff"
            player_3 "#61ffca"
            player_4 "#ffca85"
            player_5 "#a277ff"
            player_6 "#ffca85"
            player_7 "#ff6767"
            player_8 "#cdccce"
            player_9 "#ffca85"
            player_10 "#a277ff"
        }
    }
}
