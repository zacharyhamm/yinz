themes {
    "keys-ocean-sunset" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Keys%20Ocean%20Sunset
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#00040c"
        terminal {
            foreground "#b8c8dc"
            background "#0a1018"
            black "#101927"
            red "#e85a52"
            green "#4a9a72"
            yellow "#e89a2e"
            blue "#5288b8"
            magenta "#bc5090"
            cyan "#5ec8c8"
            white "#a5b5d5"
            bright_black "#344658"
            bright_red "#fc9077"
            bright_green "#62c48e"
            bright_yellow "#ffcb9a"
            bright_blue "#5a8fd4"
            bright_magenta "#fdbfde"
            bright_cyan "#7ed4e0"
            bright_white "#fff5be"
        }
        text_unselected {
            base "#b8c8dc"
            background "#0a1018"
            emphasis_0 "#e89a2e"
            emphasis_1 "#5ec8c8"
            emphasis_2 "#4a9a72"
            emphasis_3 "#bf5794"
        }
        text_selected {
            base "#0a1018"
            background "#b8c8dc"
            emphasis_0 "#724b17"
            emphasis_1 "#2a5a5a"
            emphasis_2 "#2c5c44"
            emphasis_3 "#784161"
        }
        table_cell_unselected {
            base "#b8c8dc"
            background "#0a1018"
            emphasis_0 "#e89a2e"
            emphasis_1 "#5ec8c8"
            emphasis_2 "#4a9a72"
            emphasis_3 "#bf5794"
        }
        table_cell_selected {
            base "#fff5be"
            background "#1a2430"
            emphasis_0 "#e89a2e"
            emphasis_1 "#5ec8c8"
            emphasis_2 "#4a9a72"
            emphasis_3 "#c76ba1"
        }
        list_unselected {
            base "#b8c8dc"
            background "#0a1018"
            emphasis_0 "#e89a2e"
            emphasis_1 "#5ec8c8"
            emphasis_2 "#4a9a72"
            emphasis_3 "#bf5794"
        }
        list_selected {
            base "#fff5be"
            background "#1a2430"
            emphasis_0 "#e89a2e"
            emphasis_1 "#5ec8c8"
            emphasis_2 "#4a9a72"
            emphasis_3 "#c76ba1"
        }
        ribbon_selected {
            base "#0a1018"
            background "#4a9a72"
            emphasis_0 "#3f1816"
            emphasis_1 "#32210a"
            emphasis_2 "#3b192d"
            emphasis_3 "#172634"
        }
        ribbon_unselected {
            base "#0a1018"
            background "#b8c8dc"
            emphasis_0 "#8d3732"
            emphasis_1 "#b8c8dc"
            emphasis_2 "#345675"
            emphasis_3 "#843865"
        }
        table_title {
            base "#4a9a72"
            background "#0a1018"
            emphasis_0 "#e89a2e"
            emphasis_1 "#5ec8c8"
            emphasis_2 "#4a9a72"
            emphasis_3 "#bf5794"
        }
        frame_unselected {
            base "#b8c8dc"
            background "#0a1018"
            emphasis_0 "#b8c8dc"
            emphasis_1 "#b8c8dc"
            emphasis_2 "#b8c8dc"
            emphasis_3 "#b8c8dc"
        }
        frame_selected {
            base "#4a9a72"
            background "#0a1018"
            emphasis_0 "#e89a2e"
            emphasis_1 "#5ec8c8"
            emphasis_2 "#4a9a72"
            emphasis_3 "#bf5794"
        }
        frame_highlight {
            base "#e89a2e"
            background "#0a1018"
            emphasis_0 "#bf5794"
            emphasis_1 "#e89a2e"
            emphasis_2 "#e89a2e"
            emphasis_3 "#e89a2e"
        }
        exit_code_success {
            base "#4a9a72"
            background "#0a1018"
            emphasis_0 "#5ec8c8"
            emphasis_1 "#b8c8dc"
            emphasis_2 "#bf5794"
            emphasis_3 "#5288b8"
        }
        exit_code_error {
            base "#e85a52"
            background "#0a1018"
            emphasis_0 "#e89a2e"
            emphasis_1 "#b8c8dc"
            emphasis_2 "#bf5794"
            emphasis_3 "#5288b8"
        }
        multiplayer_user_colors {
            player_1 "#bf5794"
            player_2 "#5288b8"
            player_3 "#fdbfde"
            player_4 "#e89a2e"
            player_5 "#5ec8c8"
            player_6 "#ffcb9a"
            player_7 "#e85a52"
            player_8 "#a5b5d5"
            player_9 "#fc9077"
            player_10 "#5a8fd4"
        }
    }
}
