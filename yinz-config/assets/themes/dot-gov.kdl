themes {
    "dot-gov" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Dot%20Gov
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#1a2029"
        terminal {
            foreground "#ebebeb"
            background "#262c35"
            black "#191919"
            red "#bf091d"
            green "#3d9751"
            yellow "#f6bb34"
            blue "#17b2e0"
            magenta "#7830b0"
            cyan "#8bd2ed"
            white "#ffffff"
            bright_black "#595959"
            bright_red "#bf091d"
            bright_green "#3d9751"
            bright_yellow "#f6bb34"
            bright_blue "#17b2e0"
            bright_magenta "#7830b0"
            bright_cyan "#8bd2ed"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#ebebeb"
            background "#262c35"
            emphasis_0 "#f6bb34"
            emphasis_1 "#8bd2ed"
            emphasis_2 "#53a365"
            emphasis_3 "#ac80ce"
        }
        text_selected {
            base "#262c35"
            background "#ebebeb"
            emphasis_0 "#85651c"
            emphasis_1 "#4a707e"
            emphasis_2 "#4e7256"
            emphasis_3 "#776286"
        }
        table_cell_unselected {
            base "#ebebeb"
            background "#262c35"
            emphasis_0 "#f6bb34"
            emphasis_1 "#8bd2ed"
            emphasis_2 "#53a365"
            emphasis_3 "#ac80ce"
        }
        table_cell_selected {
            base "#ffffff"
            background "#1a4080"
            emphasis_0 "#f6bb34"
            emphasis_1 "#8bd2ed"
            emphasis_2 "#80bb8d"
            emphasis_3 "#c2a1db"
        }
        list_unselected {
            base "#ebebeb"
            background "#262c35"
            emphasis_0 "#f6bb34"
            emphasis_1 "#8bd2ed"
            emphasis_2 "#53a365"
            emphasis_3 "#ac80ce"
        }
        list_selected {
            base "#ffffff"
            background "#1a4080"
            emphasis_0 "#f6bb34"
            emphasis_1 "#8bd2ed"
            emphasis_2 "#80bb8d"
            emphasis_3 "#c2a1db"
        }
        ribbon_selected {
            base "#1b1f26"
            background "#3d9751"
            emphasis_0 "#45030a"
            emphasis_1 "#271d08"
            emphasis_2 "#2c1241"
            emphasis_3 "#04222b"
        }
        ribbon_unselected {
            base "#262c35"
            background "#ebebeb"
            emphasis_0 "#bf091d"
            emphasis_1 "#ebebeb"
            emphasis_2 "#0f7391"
            emphasis_3 "#7830b0"
        }
        table_title {
            base "#53a365"
            background "#262c35"
            emphasis_0 "#f6bb34"
            emphasis_1 "#8bd2ed"
            emphasis_2 "#53a365"
            emphasis_3 "#ac80ce"
        }
        frame_unselected {
            base "#ebebeb"
            background "#262c35"
            emphasis_0 "#ebebeb"
            emphasis_1 "#ebebeb"
            emphasis_2 "#ebebeb"
            emphasis_3 "#ebebeb"
        }
        frame_selected {
            base "#53a365"
            background "#262c35"
            emphasis_0 "#f6bb34"
            emphasis_1 "#8bd2ed"
            emphasis_2 "#53a365"
            emphasis_3 "#ac80ce"
        }
        frame_highlight {
            base "#f6bb34"
            background "#262c35"
            emphasis_0 "#ac80ce"
            emphasis_1 "#f6bb34"
            emphasis_2 "#f6bb34"
            emphasis_3 "#f6bb34"
        }
        exit_code_success {
            base "#53a365"
            background "#262c35"
            emphasis_0 "#8bd2ed"
            emphasis_1 "#ebebeb"
            emphasis_2 "#ac80ce"
            emphasis_3 "#17b2e0"
        }
        exit_code_error {
            base "#db737e"
            background "#262c35"
            emphasis_0 "#f6bb34"
            emphasis_1 "#ebebeb"
            emphasis_2 "#ac80ce"
            emphasis_3 "#17b2e0"
        }
        multiplayer_user_colors {
            player_1 "#ac80ce"
            player_2 "#17b2e0"
            player_3 "#ac80ce"
            player_4 "#f6bb34"
            player_5 "#8bd2ed"
            player_6 "#f6bb34"
            player_7 "#db737e"
            player_8 "#ffffff"
            player_9 "#db737e"
            player_10 "#17b2e0"
        }
    }
}
