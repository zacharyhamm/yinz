themes {
    "adventure-time" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Adventure%20Time
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#131139"
        terminal {
            foreground "#f8dcc0"
            background "#1f1d45"
            black "#050404"
            red "#bd0013"
            green "#4ab118"
            yellow "#e7741e"
            blue "#0f4ac6"
            magenta "#665993"
            cyan "#70a598"
            white "#f8dcc0"
            bright_black "#4e7cbf"
            bright_red "#fc5f5a"
            bright_green "#9eff6e"
            bright_yellow "#efc11a"
            bright_blue "#1997c6"
            bright_magenta "#9b5953"
            bright_cyan "#c8faf4"
            bright_white "#f6f5fb"
        }
        text_unselected {
            base "#f8dcc0"
            background "#1f1d45"
            emphasis_0 "#e7741e"
            emphasis_1 "#70a598"
            emphasis_2 "#4ab118"
            emphasis_3 "#8c83ae"
        }
        text_selected {
            base "#1f1d45"
            background "#f8dcc0"
            emphasis_0 "#6a625c"
            emphasis_1 "#606464"
            emphasis_2 "#5e665a"
            emphasis_3 "#646366"
        }
        table_cell_unselected {
            base "#f8dcc0"
            background "#1f1d45"
            emphasis_0 "#e7741e"
            emphasis_1 "#70a598"
            emphasis_2 "#4ab118"
            emphasis_3 "#8c83ae"
        }
        table_cell_selected {
            base "#f8e8dc"
            background "#706b4e"
            emphasis_0 "#fbe8d9"
            emphasis_1 "#e3edeb"
            emphasis_2 "#def1d4"
            emphasis_3 "#ebeaf1"
        }
        list_unselected {
            base "#f8dcc0"
            background "#1f1d45"
            emphasis_0 "#e7741e"
            emphasis_1 "#70a598"
            emphasis_2 "#4ab118"
            emphasis_3 "#8c83ae"
        }
        list_selected {
            base "#f8e8dc"
            background "#706b4e"
            emphasis_0 "#fbe8d9"
            emphasis_1 "#e3edeb"
            emphasis_2 "#def1d4"
            emphasis_3 "#ebeaf1"
        }
        ribbon_selected {
            base "#1f1d45"
            background "#4ab118"
            emphasis_0 "#6f000b"
            emphasis_1 "#52290b"
            emphasis_2 "#362f4e"
            emphasis_3 "#092e7a"
        }
        ribbon_unselected {
            base "#1f1d45"
            background "#f8dcc0"
            emphasis_0 "#bd0013"
            emphasis_1 "#f8dcc0"
            emphasis_2 "#0f4ac6"
            emphasis_3 "#665993"
        }
        table_title {
            base "#4ab118"
            background "#1f1d45"
            emphasis_0 "#e7741e"
            emphasis_1 "#70a598"
            emphasis_2 "#4ab118"
            emphasis_3 "#8c83ae"
        }
        frame_unselected {
            base "#f8dcc0"
            background "#1f1d45"
            emphasis_0 "#f8dcc0"
            emphasis_1 "#f8dcc0"
            emphasis_2 "#f8dcc0"
            emphasis_3 "#f8dcc0"
        }
        frame_selected {
            base "#4ab118"
            background "#1f1d45"
            emphasis_0 "#e7741e"
            emphasis_1 "#70a598"
            emphasis_2 "#4ab118"
            emphasis_3 "#8c83ae"
        }
        frame_highlight {
            base "#e7741e"
            background "#1f1d45"
            emphasis_0 "#8c83ae"
            emphasis_1 "#e7741e"
            emphasis_2 "#e7741e"
            emphasis_3 "#e7741e"
        }
        exit_code_success {
            base "#4ab118"
            background "#1f1d45"
            emphasis_0 "#70a598"
            emphasis_1 "#f8dcc0"
            emphasis_2 "#8c83ae"
            emphasis_3 "#6087d9"
        }
        exit_code_error {
            base "#d76470"
            background "#1f1d45"
            emphasis_0 "#e7741e"
            emphasis_1 "#f8dcc0"
            emphasis_2 "#8c83ae"
            emphasis_3 "#6087d9"
        }
        multiplayer_user_colors {
            player_1 "#8c83ae"
            player_2 "#6087d9"
            player_3 "#b07c77"
            player_4 "#e7741e"
            player_5 "#70a598"
            player_6 "#efc11a"
            player_7 "#d76470"
            player_8 "#f8dcc0"
            player_9 "#fc5f5a"
            player_10 "#1997c6"
        }
    }
}
