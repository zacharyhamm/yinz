themes {
    "primary" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Primary
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#f3f3f3"
        terminal {
            foreground "#000000"
            background "#ffffff"
            black "#000000"
            red "#db4437"
            green "#0f9d58"
            yellow "#f4b400"
            blue "#4285f4"
            magenta "#db4437"
            cyan "#4285f4"
            white "#bfbfbf"
            bright_black "#000000"
            bright_red "#db4437"
            bright_green "#0f9d58"
            bright_yellow "#f4b400"
            bright_blue "#4285f4"
            bright_magenta "#4285f4"
            bright_cyan "#0f9d58"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#987000"
            emphasis_1 "#3a74d5"
            emphasis_2 "#0d884c"
            emphasis_3 "#d54235"
        }
        text_selected {
            base "#eeeeee"
            background "#656565"
            emphasis_0 "#fbe198"
            emphasis_1 "#d5e4fd"
            emphasis_2 "#cbeadb"
            emphasis_3 "#f8dcd9"
        }
        table_cell_unselected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#987000"
            emphasis_1 "#3a74d5"
            emphasis_2 "#0d884c"
            emphasis_3 "#d54235"
        }
        table_cell_selected {
            base "#eeeeee"
            background "#656565"
            emphasis_0 "#fbe198"
            emphasis_1 "#d5e4fd"
            emphasis_2 "#cbeadb"
            emphasis_3 "#f8dcd9"
        }
        list_unselected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#987000"
            emphasis_1 "#3a74d5"
            emphasis_2 "#0d884c"
            emphasis_3 "#d54235"
        }
        list_selected {
            base "#eeeeee"
            background "#656565"
            emphasis_0 "#fbe198"
            emphasis_1 "#d5e4fd"
            emphasis_2 "#cbeadb"
            emphasis_3 "#f8dcd9"
        }
        ribbon_selected {
            base "#222222"
            background "#0f9d58"
            emphasis_0 "#401410"
            emphasis_1 "#2d2100"
            emphasis_2 "#401410"
            emphasis_3 "#11223f"
        }
        ribbon_unselected {
            base "#ffffff"
            background "#000000"
            emphasis_0 "#db4437"
            emphasis_1 "#000000"
            emphasis_2 "#4285f4"
            emphasis_3 "#db4437"
        }
        table_title {
            base "#0d884c"
            background "#ffffff"
            emphasis_0 "#987000"
            emphasis_1 "#3a74d5"
            emphasis_2 "#0d884c"
            emphasis_3 "#d54235"
        }
        frame_unselected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#000000"
            emphasis_1 "#000000"
            emphasis_2 "#000000"
            emphasis_3 "#000000"
        }
        frame_selected {
            base "#0d884c"
            background "#ffffff"
            emphasis_0 "#987000"
            emphasis_1 "#3a74d5"
            emphasis_2 "#0d884c"
            emphasis_3 "#d54235"
        }
        frame_highlight {
            base "#987000"
            background "#ffffff"
            emphasis_0 "#d54235"
            emphasis_1 "#987000"
            emphasis_2 "#987000"
            emphasis_3 "#987000"
        }
        exit_code_success {
            base "#0d884c"
            background "#ffffff"
            emphasis_0 "#3a74d5"
            emphasis_1 "#000000"
            emphasis_2 "#d54235"
            emphasis_3 "#3a74d5"
        }
        exit_code_error {
            base "#d54235"
            background "#ffffff"
            emphasis_0 "#987000"
            emphasis_1 "#000000"
            emphasis_2 "#d54235"
            emphasis_3 "#3a74d5"
        }
        multiplayer_user_colors {
            player_1 "#d54235"
            player_2 "#3a74d5"
            player_3 "#3a74d5"
            player_4 "#987000"
            player_5 "#3a74d5"
            player_6 "#987000"
            player_7 "#d54235"
            player_8 "#767676"
            player_9 "#d54235"
            player_10 "#3a74d5"
        }
    }
}
