themes {
    "poimandres-white" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Poimandres%20White
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#f2f2f3"
        terminal {
            foreground "#969cbd"
            background "#fefeff"
            black "#fefeff"
            red "#ff2090"
            green "#01dab2"
            yellow "#e5ba4e"
            blue "#8abacd"
            magenta "#eb8394"
            cyan "#8abacd"
            white "#000000"
            bright_black "#969cbd"
            bright_red "#ff2090"
            bright_green "#01dab2"
            bright_yellow "#e5ba4e"
            bright_blue "#0ebfff"
            bright_magenta "#eb8394"
            bright_cyan "#0ebfff"
            bright_white "#000000"
        }
        text_unselected {
            base "#70758e"
            background "#fefeff"
            emphasis_0 "#8d7330"
            emphasis_1 "#5b7b87"
            emphasis_2 "#01856d"
            emphasis_3 "#ab606c"
        }
        text_selected {
            base "#fefeff"
            background "#70758e"
            emphasis_0 "#060402"
            emphasis_1 "#030405"
            emphasis_2 "#000504"
            emphasis_3 "#060404"
        }
        table_cell_unselected {
            base "#70758e"
            background "#fefeff"
            emphasis_0 "#8d7330"
            emphasis_1 "#5b7b87"
            emphasis_2 "#01856d"
            emphasis_3 "#ab606c"
        }
        table_cell_selected {
            base "#33353e"
            background "#969cbd"
            emphasis_0 "#403416"
            emphasis_1 "#29373d"
            emphasis_2 "#003d32"
            emphasis_3 "#4e2c31"
        }
        list_unselected {
            base "#70758e"
            background "#fefeff"
            emphasis_0 "#8d7330"
            emphasis_1 "#5b7b87"
            emphasis_2 "#01856d"
            emphasis_3 "#ab606c"
        }
        list_selected {
            base "#33353e"
            background "#969cbd"
            emphasis_0 "#403416"
            emphasis_1 "#29373d"
            emphasis_2 "#003d32"
            emphasis_3 "#4e2c31"
        }
        ribbon_selected {
            base "#4f4f4f"
            background "#01dab2"
            emphasis_0 "#991356"
            emphasis_1 "#5f4d20"
            emphasis_2 "#734049"
            emphasis_3 "#3d525b"
        }
        ribbon_unselected {
            base "#fefeff"
            background "#70758e"
            emphasis_0 "#0c0207"
            emphasis_1 "#70758e"
            emphasis_2 "#030405"
            emphasis_3 "#060404"
        }
        table_title {
            base "#01856d"
            background "#fefeff"
            emphasis_0 "#8d7330"
            emphasis_1 "#5b7b87"
            emphasis_2 "#01856d"
            emphasis_3 "#ab606c"
        }
        frame_unselected {
            base "#70758e"
            background "#fefeff"
            emphasis_0 "#70758e"
            emphasis_1 "#70758e"
            emphasis_2 "#70758e"
            emphasis_3 "#70758e"
        }
        frame_selected {
            base "#01856d"
            background "#fefeff"
            emphasis_0 "#8d7330"
            emphasis_1 "#5b7b87"
            emphasis_2 "#01856d"
            emphasis_3 "#ab606c"
        }
        frame_highlight {
            base "#8d7330"
            background "#fefeff"
            emphasis_0 "#ab606c"
            emphasis_1 "#8d7330"
            emphasis_2 "#8d7330"
            emphasis_3 "#8d7330"
        }
        exit_code_success {
            base "#01856d"
            background "#fefeff"
            emphasis_0 "#5b7b87"
            emphasis_1 "#70758e"
            emphasis_2 "#ab606c"
            emphasis_3 "#5b7b87"
        }
        exit_code_error {
            base "#df1c7e"
            background "#fefeff"
            emphasis_0 "#8d7330"
            emphasis_1 "#70758e"
            emphasis_2 "#ab606c"
            emphasis_3 "#5b7b87"
        }
        multiplayer_user_colors {
            player_1 "#ab606c"
            player_2 "#5b7b87"
            player_3 "#ab606c"
            player_4 "#8d7330"
            player_5 "#5b7b87"
            player_6 "#8d7330"
            player_7 "#df1c7e"
            player_8 "#000000"
            player_9 "#df1c7e"
            player_10 "#097faa"
        }
    }
}
