themes {
    "clear-dark" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Clear%20Dark
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#151b28"
        terminal {
            foreground "#e6e6e6"
            background "#212734"
            black "#35424c"
            red "#b45648"
            green "#6caa71"
            yellow "#c4ac62"
            blue "#6d96b4"
            magenta "#bd7bcd"
            cyan "#7ccbcd"
            white "#dee5eb"
            bright_black "#465c6d"
            bright_red "#df6c5a"
            bright_green "#79be7e"
            bright_yellow "#e5c872"
            bright_blue "#67b5ed"
            bright_magenta "#d389e5"
            bright_cyan "#84dde0"
            bright_white "#e5eff5"
        }
        text_unselected {
            base "#e6e6e6"
            background "#212734"
            emphasis_0 "#c4ac62"
            emphasis_1 "#7ccbcd"
            emphasis_2 "#6caa71"
            emphasis_3 "#bd7bcd"
        }
        text_selected {
            base "#212734"
            background "#e6e6e6"
            emphasis_0 "#726744"
            emphasis_1 "#436e6f"
            emphasis_2 "#556d57"
            emphasis_3 "#765f7b"
        }
        table_cell_unselected {
            base "#e6e6e6"
            background "#212734"
            emphasis_0 "#c4ac62"
            emphasis_1 "#7ccbcd"
            emphasis_2 "#6caa71"
            emphasis_3 "#bd7bcd"
        }
        table_cell_selected {
            base "#b7bac0"
            background "#334e5e"
            emphasis_0 "#cdb97a"
            emphasis_1 "#7ccbcd"
            emphasis_2 "#9ac59e"
            emphasis_3 "#d5acdf"
        }
        list_unselected {
            base "#e6e6e6"
            background "#212734"
            emphasis_0 "#c4ac62"
            emphasis_1 "#7ccbcd"
            emphasis_2 "#6caa71"
            emphasis_3 "#bd7bcd"
        }
        list_selected {
            base "#b7bac0"
            background "#334e5e"
            emphasis_0 "#cdb97a"
            emphasis_1 "#7ccbcd"
            emphasis_2 "#9ac59e"
            emphasis_3 "#d5acdf"
        }
        ribbon_selected {
            base "#212734"
            background "#6caa71"
            emphasis_0 "#532821"
            emphasis_1 "#3a331d"
            emphasis_2 "#432b48"
            emphasis_3 "#273641"
        }
        ribbon_unselected {
            base "#212734"
            background "#e6e6e6"
            emphasis_0 "#a34e41"
            emphasis_1 "#e6e6e6"
            emphasis_2 "#4e6b80"
            emphasis_3 "#855690"
        }
        table_title {
            base "#6caa71"
            background "#212734"
            emphasis_0 "#c4ac62"
            emphasis_1 "#7ccbcd"
            emphasis_2 "#6caa71"
            emphasis_3 "#bd7bcd"
        }
        frame_unselected {
            base "#e6e6e6"
            background "#212734"
            emphasis_0 "#e6e6e6"
            emphasis_1 "#e6e6e6"
            emphasis_2 "#e6e6e6"
            emphasis_3 "#e6e6e6"
        }
        frame_selected {
            base "#6caa71"
            background "#212734"
            emphasis_0 "#c4ac62"
            emphasis_1 "#7ccbcd"
            emphasis_2 "#6caa71"
            emphasis_3 "#bd7bcd"
        }
        frame_highlight {
            base "#c4ac62"
            background "#212734"
            emphasis_0 "#bd7bcd"
            emphasis_1 "#c4ac62"
            emphasis_2 "#c4ac62"
            emphasis_3 "#c4ac62"
        }
        exit_code_success {
            base "#6caa71"
            background "#212734"
            emphasis_0 "#7ccbcd"
            emphasis_1 "#e6e6e6"
            emphasis_2 "#bd7bcd"
            emphasis_3 "#6d96b4"
        }
        exit_code_error {
            base "#c47a6f"
            background "#212734"
            emphasis_0 "#c4ac62"
            emphasis_1 "#e6e6e6"
            emphasis_2 "#bd7bcd"
            emphasis_3 "#6d96b4"
        }
        multiplayer_user_colors {
            player_1 "#bd7bcd"
            player_2 "#6d96b4"
            player_3 "#d389e5"
            player_4 "#c4ac62"
            player_5 "#7ccbcd"
            player_6 "#e5c872"
            player_7 "#c47a6f"
            player_8 "#dee5eb"
            player_9 "#df6c5a"
            player_10 "#67b5ed"
        }
    }
}
