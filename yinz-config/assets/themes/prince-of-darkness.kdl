themes {
    "prince-of-darkness" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Prince%20of%20Darkness
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000008"
        terminal {
            foreground "#dcd3ff"
            background "#0a0714"
            black "#2d1b4e"
            red "#6a2bbd"
            green "#c43dff"
            yellow "#3ec7ff"
            blue "#7a63ff"
            magenta "#ff4edb"
            cyan "#5cc8ff"
            white "#c5a7ff"
            bright_black "#676175"
            bright_red "#a139e6"
            bright_green "#ff6bd6"
            bright_yellow "#7ae6ff"
            bright_blue "#9bb4ff"
            bright_magenta "#e384ff"
            bright_cyan "#7ae6ff"
            bright_white "#f2e6ff"
        }
        text_unselected {
            base "#dcd3ff"
            background "#0a0714"
            emphasis_0 "#3ec7ff"
            emphasis_1 "#5cc8ff"
            emphasis_2 "#c43dff"
            emphasis_3 "#ff4edb"
        }
        text_selected {
            base "#0a0714"
            background "#dcd3ff"
            emphasis_0 "#206683"
            emphasis_1 "#2e6480"
            emphasis_2 "#82449d"
            emphasis_3 "#9e3288"
        }
        table_cell_unselected {
            base "#dcd3ff"
            background "#0a0714"
            emphasis_0 "#3ec7ff"
            emphasis_1 "#5cc8ff"
            emphasis_2 "#c43dff"
            emphasis_3 "#ff4edb"
        }
        table_cell_selected {
            base "#f2e6ff"
            background "#43206b"
            emphasis_0 "#3ec7ff"
            emphasis_1 "#5cc8ff"
            emphasis_2 "#d36fff"
            emphasis_3 "#ff51dc"
        }
        list_unselected {
            base "#dcd3ff"
            background "#0a0714"
            emphasis_0 "#3ec7ff"
            emphasis_1 "#5cc8ff"
            emphasis_2 "#c43dff"
            emphasis_3 "#ff4edb"
        }
        list_selected {
            base "#f2e6ff"
            background "#43206b"
            emphasis_0 "#3ec7ff"
            emphasis_1 "#5cc8ff"
            emphasis_2 "#d36fff"
            emphasis_3 "#ff51dc"
        }
        ribbon_selected {
            base "#0a0714"
            background "#c43dff"
            emphasis_0 "#230e3f"
            emphasis_1 "#091c24"
            emphasis_2 "#2e0e28"
            emphasis_3 "#1a1537"
        }
        ribbon_unselected {
            base "#0a0714"
            background "#dcd3ff"
            emphasis_0 "#6a2bbd"
            emphasis_1 "#dcd3ff"
            emphasis_2 "#5d4cc3"
            emphasis_3 "#9f3189"
        }
        table_title {
            base "#c43dff"
            background "#0a0714"
            emphasis_0 "#3ec7ff"
            emphasis_1 "#5cc8ff"
            emphasis_2 "#c43dff"
            emphasis_3 "#ff4edb"
        }
        frame_unselected {
            base "#dcd3ff"
            background "#0a0714"
            emphasis_0 "#dcd3ff"
            emphasis_1 "#dcd3ff"
            emphasis_2 "#dcd3ff"
            emphasis_3 "#dcd3ff"
        }
        frame_selected {
            base "#c43dff"
            background "#0a0714"
            emphasis_0 "#3ec7ff"
            emphasis_1 "#5cc8ff"
            emphasis_2 "#c43dff"
            emphasis_3 "#ff4edb"
        }
        frame_highlight {
            base "#3ec7ff"
            background "#0a0714"
            emphasis_0 "#ff4edb"
            emphasis_1 "#3ec7ff"
            emphasis_2 "#3ec7ff"
            emphasis_3 "#3ec7ff"
        }
        exit_code_success {
            base "#c43dff"
            background "#0a0714"
            emphasis_0 "#5cc8ff"
            emphasis_1 "#dcd3ff"
            emphasis_2 "#ff4edb"
            emphasis_3 "#7a63ff"
        }
        exit_code_error {
            base "#9061ce"
            background "#0a0714"
            emphasis_0 "#3ec7ff"
            emphasis_1 "#dcd3ff"
            emphasis_2 "#ff4edb"
            emphasis_3 "#7a63ff"
        }
        multiplayer_user_colors {
            player_1 "#ff4edb"
            player_2 "#7a63ff"
            player_3 "#e384ff"
            player_4 "#3ec7ff"
            player_5 "#5cc8ff"
            player_6 "#7ae6ff"
            player_7 "#9061ce"
            player_8 "#c5a7ff"
            player_9 "#a848e8"
            player_10 "#9bb4ff"
        }
    }
}
