themes {
    "idle-toes" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Idle%20Toes
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#262626"
        terminal {
            foreground "#ffffff"
            background "#323232"
            black "#323232"
            red "#d25252"
            green "#7fe173"
            yellow "#ffc66d"
            blue "#4099ff"
            magenta "#f680ff"
            cyan "#bed6ff"
            white "#eeeeec"
            bright_black "#606060"
            bright_red "#f07070"
            bright_green "#9dff91"
            bright_yellow "#ffe48b"
            bright_blue "#5eb7f7"
            bright_magenta "#ff9dff"
            bright_cyan "#dcf4ff"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#ffffff"
            background "#323232"
            emphasis_0 "#ffc66d"
            emphasis_1 "#bed6ff"
            emphasis_2 "#7fe173"
            emphasis_3 "#f680ff"
        }
        text_selected {
            base "#323232"
            background "#ffffff"
            emphasis_0 "#8f7142"
            emphasis_1 "#6a778e"
            emphasis_2 "#52814d"
            emphasis_3 "#8c6b8f"
        }
        table_cell_unselected {
            base "#ffffff"
            background "#323232"
            emphasis_0 "#ffc66d"
            emphasis_1 "#bed6ff"
            emphasis_2 "#7fe173"
            emphasis_3 "#f680ff"
        }
        table_cell_selected {
            base "#d3d3d3"
            background "#5b5b5b"
            emphasis_0 "#ffca76"
            emphasis_1 "#bed6ff"
            emphasis_2 "#93e689"
            emphasis_3 "#fabfff"
        }
        list_unselected {
            base "#ffffff"
            background "#323232"
            emphasis_0 "#ffc66d"
            emphasis_1 "#bed6ff"
            emphasis_2 "#7fe173"
            emphasis_3 "#f680ff"
        }
        list_selected {
            base "#d3d3d3"
            background "#5b5b5b"
            emphasis_0 "#ffca76"
            emphasis_1 "#bed6ff"
            emphasis_2 "#93e689"
            emphasis_3 "#fabfff"
        }
        ribbon_selected {
            base "#323232"
            background "#7fe173"
            emphasis_0 "#923939"
            emphasis_1 "#6a522d"
            emphasis_2 "#7a3f7e"
            emphasis_3 "#245791"
        }
        ribbon_unselected {
            base "#323232"
            background "#ffffff"
            emphasis_0 "#c84e4e"
            emphasis_1 "#ffffff"
            emphasis_2 "#3278c8"
            emphasis_3 "#a857ae"
        }
        table_title {
            base "#7fe173"
            background "#323232"
            emphasis_0 "#ffc66d"
            emphasis_1 "#bed6ff"
            emphasis_2 "#7fe173"
            emphasis_3 "#f680ff"
        }
        frame_unselected {
            base "#ffffff"
            background "#323232"
            emphasis_0 "#ffffff"
            emphasis_1 "#ffffff"
            emphasis_2 "#ffffff"
            emphasis_3 "#ffffff"
        }
        frame_selected {
            base "#7fe173"
            background "#323232"
            emphasis_0 "#ffc66d"
            emphasis_1 "#bed6ff"
            emphasis_2 "#7fe173"
            emphasis_3 "#f680ff"
        }
        frame_highlight {
            base "#ffc66d"
            background "#323232"
            emphasis_0 "#f680ff"
            emphasis_1 "#ffc66d"
            emphasis_2 "#ffc66d"
            emphasis_3 "#ffc66d"
        }
        exit_code_success {
            base "#7fe173"
            background "#323232"
            emphasis_0 "#bed6ff"
            emphasis_1 "#ffffff"
            emphasis_2 "#f680ff"
            emphasis_3 "#439bff"
        }
        exit_code_error {
            base "#de7f7f"
            background "#323232"
            emphasis_0 "#ffc66d"
            emphasis_1 "#ffffff"
            emphasis_2 "#f680ff"
            emphasis_3 "#439bff"
        }
        multiplayer_user_colors {
            player_1 "#f680ff"
            player_2 "#439bff"
            player_3 "#ff9dff"
            player_4 "#ffc66d"
            player_5 "#bed6ff"
            player_6 "#ffe48b"
            player_7 "#de7f7f"
            player_8 "#eeeeec"
            player_9 "#f07373"
            player_10 "#5eb7f7"
        }
    }
}
