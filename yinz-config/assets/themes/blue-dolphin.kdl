themes {
    "blue-dolphin" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Blue%20Dolphin
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#005d78"
        terminal {
            foreground "#c5f2ff"
            background "#006984"
            black "#292d3e"
            red "#ff8288"
            green "#b4e88d"
            yellow "#f4d69f"
            blue "#82aaff"
            magenta "#e9c1ff"
            cyan "#89ebff"
            white "#d0d0d0"
            bright_black "#9094a4"
            bright_red "#ff8b92"
            bright_green "#ddffa7"
            bright_yellow "#ffe585"
            bright_blue "#9cc4ff"
            bright_magenta "#ddb0f6"
            bright_cyan "#a3f7ff"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#c5f2ff"
            background "#006984"
            emphasis_0 "#f4d8a3"
            emphasis_1 "#89ebff"
            emphasis_2 "#b8e992"
            emphasis_3 "#eed0ff"
        }
        text_selected {
            base "#373738"
            background "#c5f2ff"
            emphasis_0 "#3d3628"
            emphasis_1 "#223b40"
            emphasis_2 "#2e3b24"
            emphasis_3 "#3e3344"
        }
        table_cell_unselected {
            base "#c5f2ff"
            background "#006984"
            emphasis_0 "#f4d8a3"
            emphasis_1 "#89ebff"
            emphasis_2 "#b8e992"
            emphasis_3 "#eed0ff"
        }
        table_cell_selected {
            base "#373738"
            background "#2baeca"
            emphasis_0 "#3d3628"
            emphasis_1 "#223b40"
            emphasis_2 "#2e3b24"
            emphasis_3 "#3e3344"
        }
        list_unselected {
            base "#c5f2ff"
            background "#006984"
            emphasis_0 "#f4d8a3"
            emphasis_1 "#89ebff"
            emphasis_2 "#b8e992"
            emphasis_3 "#eed0ff"
        }
        list_selected {
            base "#373738"
            background "#2baeca"
            emphasis_0 "#3d3628"
            emphasis_1 "#223b40"
            emphasis_2 "#2e3b24"
            emphasis_3 "#3e3344"
        }
        ribbon_selected {
            base "#006882"
            background "#b4e88d"
            emphasis_0 "#914a4d"
            emphasis_1 "#6a5d45"
            emphasis_2 "#6a5874"
            emphasis_3 "#485f8e"
        }
        ribbon_unselected {
            base "#006984"
            background "#c5f2ff"
            emphasis_0 "#a15256"
            emphasis_1 "#c5f2ff"
            emphasis_2 "#51699e"
            emphasis_3 "#776282"
        }
        table_title {
            base "#b8e992"
            background "#006984"
            emphasis_0 "#f4d8a3"
            emphasis_1 "#89ebff"
            emphasis_2 "#b8e992"
            emphasis_3 "#eed0ff"
        }
        frame_unselected {
            base "#c5f2ff"
            background "#006984"
            emphasis_0 "#c5f2ff"
            emphasis_1 "#c5f2ff"
            emphasis_2 "#c5f2ff"
            emphasis_3 "#c5f2ff"
        }
        frame_selected {
            base "#b8e992"
            background "#006984"
            emphasis_0 "#f4d8a3"
            emphasis_1 "#89ebff"
            emphasis_2 "#b8e992"
            emphasis_3 "#eed0ff"
        }
        frame_highlight {
            base "#f4d8a3"
            background "#006984"
            emphasis_0 "#eed0ff"
            emphasis_1 "#f4d8a3"
            emphasis_2 "#f4d8a3"
            emphasis_3 "#f4d8a3"
        }
        exit_code_success {
            base "#b8e992"
            background "#006984"
            emphasis_0 "#89ebff"
            emphasis_1 "#c5f2ff"
            emphasis_2 "#eed0ff"
            emphasis_3 "#cbdbff"
        }
        exit_code_error {
            base "#ffcfd1"
            background "#006984"
            emphasis_0 "#f4d8a3"
            emphasis_1 "#c5f2ff"
            emphasis_2 "#eed0ff"
            emphasis_3 "#cbdbff"
        }
        multiplayer_user_colors {
            player_1 "#eed0ff"
            player_2 "#cbdbff"
            player_3 "#ecd2fa"
            player_4 "#f4d8a3"
            player_5 "#89ebff"
            player_6 "#ffe585"
            player_7 "#ffcfd1"
            player_8 "#dbdbdb"
            player_9 "#ffcfd2"
            player_10 "#c5ddff"
        }
    }
}
