themes {
    "green-phosphor-crt" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Green%20Phosphor%20CRT
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000300"
        terminal {
            foreground "#33ff33"
            background "#0b0f0b"
            black "#002200"
            red "#00aa00"
            green "#33ff33"
            yellow "#66ff66"
            blue "#00cc44"
            magenta "#00ff88"
            cyan "#66ffaa"
            white "#b6ffb6"
            bright_black "#0a5a0a"
            bright_red "#19cc19"
            bright_green "#66ff66"
            bright_yellow "#99ff99"
            bright_blue "#33ff77"
            bright_magenta "#66ffaa"
            bright_cyan "#99ffcc"
            bright_white "#e6ffe6"
        }
        text_unselected {
            base "#33ff33"
            background "#0b0f0b"
            emphasis_0 "#66ff66"
            emphasis_1 "#66ffaa"
            emphasis_2 "#33ff33"
            emphasis_3 "#00ff88"
        }
        text_selected {
            base "#0b0f0b"
            background "#33ff33"
            emphasis_0 "#2c6f2c"
            emphasis_1 "#2c6e49"
            emphasis_2 "#177117"
            emphasis_3 "#00713c"
        }
        table_cell_unselected {
            base "#33ff33"
            background "#0b0f0b"
            emphasis_0 "#66ff66"
            emphasis_1 "#66ffaa"
            emphasis_2 "#33ff33"
            emphasis_3 "#00ff88"
        }
        table_cell_selected {
            base "#979997"
            background "#0a3a0a"
            emphasis_0 "#66ff66"
            emphasis_1 "#66ffaa"
            emphasis_2 "#33ff33"
            emphasis_3 "#00ff88"
        }
        list_unselected {
            base "#33ff33"
            background "#0b0f0b"
            emphasis_0 "#66ff66"
            emphasis_1 "#66ffaa"
            emphasis_2 "#33ff33"
            emphasis_3 "#00ff88"
        }
        list_selected {
            base "#979997"
            background "#0a3a0a"
            emphasis_0 "#66ff66"
            emphasis_1 "#66ffaa"
            emphasis_2 "#33ff33"
            emphasis_3 "#00ff88"
        }
        ribbon_selected {
            base "#979997"
            background "#0a3a0a"
            emphasis_0 "#66ff66"
            emphasis_1 "#66ffaa"
            emphasis_2 "#33ff33"
            emphasis_3 "#00ff88"
        }
        ribbon_unselected {
            base "#0b0f0b"
            background "#33ff33"
            emphasis_0 "#007200"
            emphasis_1 "#33ff33"
            emphasis_2 "#007226"
            emphasis_3 "#00713c"
        }
        table_title {
            base "#33ff33"
            background "#0b0f0b"
            emphasis_0 "#66ff66"
            emphasis_1 "#66ffaa"
            emphasis_2 "#33ff33"
            emphasis_3 "#00ff88"
        }
        frame_unselected {
            base "#33ff33"
            background "#0b0f0b"
            emphasis_0 "#33ff33"
            emphasis_1 "#33ff33"
            emphasis_2 "#33ff33"
            emphasis_3 "#33ff33"
        }
        frame_selected {
            base "#33ff33"
            background "#0b0f0b"
            emphasis_0 "#66ff66"
            emphasis_1 "#66ffaa"
            emphasis_2 "#33ff33"
            emphasis_3 "#00ff88"
        }
        frame_highlight {
            base "#66ff66"
            background "#0b0f0b"
            emphasis_0 "#00ff88"
            emphasis_1 "#66ff66"
            emphasis_2 "#66ff66"
            emphasis_3 "#66ff66"
        }
        exit_code_success {
            base "#33ff33"
            background "#0b0f0b"
            emphasis_0 "#66ffaa"
            emphasis_1 "#33ff33"
            emphasis_2 "#00ff88"
            emphasis_3 "#00cc44"
        }
        exit_code_error {
            base "#00aa00"
            background "#0b0f0b"
            emphasis_0 "#66ff66"
            emphasis_1 "#33ff33"
            emphasis_2 "#00ff88"
            emphasis_3 "#00cc44"
        }
        multiplayer_user_colors {
            player_1 "#00ff88"
            player_2 "#00cc44"
            player_3 "#66ffaa"
            player_4 "#66ff66"
            player_5 "#66ffaa"
            player_6 "#99ff99"
            player_7 "#00aa00"
            player_8 "#b6ffb6"
            player_9 "#19cc19"
            player_10 "#33ff77"
        }
    }
}
