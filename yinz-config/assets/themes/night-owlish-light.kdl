themes {
    "night-owlish-light" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Night%20Owlish%20Light
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#f3f3f3"
        terminal {
            foreground "#403f53"
            background "#ffffff"
            black "#011627"
            red "#d3423e"
            green "#2aa298"
            yellow "#daaa01"
            blue "#4876d6"
            magenta "#403f53"
            cyan "#08916a"
            white "#7a8181"
            bright_black "#7a8181"
            bright_red "#f76e6e"
            bright_green "#49d0c5"
            bright_yellow "#dac26b"
            bright_blue "#5ca7e4"
            bright_magenta "#697098"
            bright_cyan "#00c990"
            bright_white "#989fb1"
        }
        text_unselected {
            base "#403f53"
            background "#ffffff"
            emphasis_0 "#927201"
            emphasis_1 "#078763"
            emphasis_2 "#22847c"
            emphasis_3 "#403f53"
        }
        text_selected {
            base "#ffffff"
            background "#403f53"
            emphasis_0 "#bdac71"
            emphasis_1 "#78b9a6"
            emphasis_2 "#84b6b2"
            emphasis_3 "#adacb5"
        }
        table_cell_unselected {
            base "#403f53"
            background "#ffffff"
            emphasis_0 "#927201"
            emphasis_1 "#078763"
            emphasis_2 "#22847c"
            emphasis_3 "#403f53"
        }
        table_cell_selected {
            base "#403f53"
            background "#f2f2f2"
            emphasis_0 "#896b01"
            emphasis_1 "#077e5c"
            emphasis_2 "#207b74"
            emphasis_3 "#403f53"
        }
        list_unselected {
            base "#403f53"
            background "#ffffff"
            emphasis_0 "#927201"
            emphasis_1 "#078763"
            emphasis_2 "#22847c"
            emphasis_3 "#403f53"
        }
        list_selected {
            base "#403f53"
            background "#f2f2f2"
            emphasis_0 "#896b01"
            emphasis_1 "#077e5c"
            emphasis_2 "#207b74"
            emphasis_3 "#403f53"
        }
        ribbon_selected {
            base "#2b2b2b"
            background "#2aa298"
            emphasis_0 "#4f1917"
            emphasis_1 "#362a00"
            emphasis_2 "#2b2a38"
            emphasis_3 "#1a2a4c"
        }
        ribbon_unselected {
            base "#ffffff"
            background "#403f53"
            emphasis_0 "#e79795"
            emphasis_1 "#403f53"
            emphasis_2 "#91ade6"
            emphasis_3 "#adacb5"
        }
        table_title {
            base "#22847c"
            background "#ffffff"
            emphasis_0 "#927201"
            emphasis_1 "#078763"
            emphasis_2 "#22847c"
            emphasis_3 "#403f53"
        }
        frame_unselected {
            base "#403f53"
            background "#ffffff"
            emphasis_0 "#403f53"
            emphasis_1 "#403f53"
            emphasis_2 "#403f53"
            emphasis_3 "#403f53"
        }
        frame_selected {
            base "#22847c"
            background "#ffffff"
            emphasis_0 "#927201"
            emphasis_1 "#078763"
            emphasis_2 "#22847c"
            emphasis_3 "#403f53"
        }
        frame_highlight {
            base "#927201"
            background "#ffffff"
            emphasis_0 "#403f53"
            emphasis_1 "#927201"
            emphasis_2 "#927201"
            emphasis_3 "#927201"
        }
        exit_code_success {
            base "#22847c"
            background "#ffffff"
            emphasis_0 "#078763"
            emphasis_1 "#403f53"
            emphasis_2 "#403f53"
            emphasis_3 "#4673d1"
        }
        exit_code_error {
            base "#d3423e"
            background "#ffffff"
            emphasis_0 "#927201"
            emphasis_1 "#403f53"
            emphasis_2 "#403f53"
            emphasis_3 "#4673d1"
        }
        multiplayer_user_colors {
            player_1 "#403f53"
            player_2 "#4673d1"
            player_3 "#697098"
            player_4 "#927201"
            player_5 "#078763"
            player_6 "#857641"
            player_7 "#d3423e"
            player_8 "#717878"
            player_9 "#bf5555"
            player_10 "#447ba8"
        }
    }
}
