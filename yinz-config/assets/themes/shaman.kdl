themes {
    "shaman" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Shaman
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000409"
        terminal {
            foreground "#405555"
            background "#001015"
            black "#012026"
            red "#b2302d"
            green "#00a941"
            yellow "#5e8baa"
            blue "#449a86"
            magenta "#00599d"
            cyan "#5d7e19"
            white "#405555"
            bright_black "#384451"
            bright_red "#ff4242"
            bright_green "#2aea5e"
            bright_yellow "#8ed4fd"
            bright_blue "#61d5ba"
            bright_magenta "#1298ff"
            bright_cyan "#98d028"
            bright_white "#58fbd6"
        }
        text_unselected {
            base "#6e7e7e"
            background "#001015"
            emphasis_0 "#5e8baa"
            emphasis_1 "#658525"
            emphasis_2 "#00a941"
            emphasis_3 "#3c80b4"
        }
        text_selected {
            base "#001015"
            background "#6e7e7e"
            emphasis_0 "#0d0f10"
            emphasis_1 "#0e0f0c"
            emphasis_2 "#0a110d"
            emphasis_3 "#0d1011"
        }
        table_cell_unselected {
            base "#6e7e7e"
            background "#001015"
            emphasis_0 "#5e8baa"
            emphasis_1 "#658525"
            emphasis_2 "#00a941"
            emphasis_3 "#3c80b4"
        }
        table_cell_selected {
            base "#5afad6"
            background "#415555"
            emphasis_0 "#b1c7d6"
            emphasis_1 "#bbc99e"
            emphasis_2 "#81d5a1"
            emphasis_3 "#aac8de"
        }
        list_unselected {
            base "#6e7e7e"
            background "#001015"
            emphasis_0 "#5e8baa"
            emphasis_1 "#658525"
            emphasis_2 "#00a941"
            emphasis_3 "#3c80b4"
        }
        list_selected {
            base "#5afad6"
            background "#415555"
            emphasis_0 "#b1c7d6"
            emphasis_1 "#bbc99e"
            emphasis_2 "#81d5a1"
            emphasis_3 "#aac8de"
        }
        ribbon_selected {
            base "#001015"
            background "#00a941"
            emphasis_0 "#531615"
            emphasis_1 "#1f2d37"
            emphasis_2 "#002d50"
            emphasis_3 "#15302a"
        }
        ribbon_unselected {
            base "#001015"
            background "#6e7e7e"
            emphasis_0 "#1f0808"
            emphasis_1 "#6e7e7e"
            emphasis_2 "#07110f"
            emphasis_3 "#00111e"
        }
        table_title {
            base "#00a941"
            background "#001015"
            emphasis_0 "#5e8baa"
            emphasis_1 "#658525"
            emphasis_2 "#00a941"
            emphasis_3 "#3c80b4"
        }
        frame_unselected {
            base "#6e7e7e"
            background "#001015"
            emphasis_0 "#6e7e7e"
            emphasis_1 "#6e7e7e"
            emphasis_2 "#6e7e7e"
            emphasis_3 "#6e7e7e"
        }
        frame_selected {
            base "#00a941"
            background "#001015"
            emphasis_0 "#5e8baa"
            emphasis_1 "#658525"
            emphasis_2 "#00a941"
            emphasis_3 "#3c80b4"
        }
        frame_highlight {
            base "#5e8baa"
            background "#001015"
            emphasis_0 "#3c80b4"
            emphasis_1 "#5e8baa"
            emphasis_2 "#5e8baa"
            emphasis_3 "#5e8baa"
        }
        exit_code_success {
            base "#00a941"
            background "#001015"
            emphasis_0 "#658525"
            emphasis_1 "#6e7e7e"
            emphasis_2 "#3c80b4"
            emphasis_3 "#449a86"
        }
        exit_code_error {
            base "#c25a58"
            background "#001015"
            emphasis_0 "#5e8baa"
            emphasis_1 "#6e7e7e"
            emphasis_2 "#3c80b4"
            emphasis_3 "#449a86"
        }
        multiplayer_user_colors {
            player_1 "#3c80b4"
            player_2 "#449a86"
            player_3 "#1298ff"
            player_4 "#5e8baa"
            player_5 "#658525"
            player_6 "#8ed4fd"
            player_7 "#c25a58"
            player_8 "#6e7e7e"
            player_9 "#ff4242"
            player_10 "#61d5ba"
        }
    }
}
