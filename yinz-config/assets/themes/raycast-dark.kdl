themes {
    "raycast-dark" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Raycast%20Dark
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#0e0e0e"
        terminal {
            foreground "#ffffff"
            background "#1a1a1a"
            black "#000000"
            red "#ff5360"
            green "#59d499"
            yellow "#ffc531"
            blue "#56c2ff"
            magenta "#cf2f98"
            cyan "#52eee5"
            white "#ffffff"
            bright_black "#4c4c4c"
            bright_red "#ff6363"
            bright_green "#59d499"
            bright_yellow "#ffc531"
            bright_blue "#56c2ff"
            bright_magenta "#cf2f98"
            bright_cyan "#52eee5"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#ffffff"
            background "#1a1a1a"
            emphasis_0 "#ffc531"
            emphasis_1 "#52eee5"
            emphasis_2 "#59d499"
            emphasis_3 "#d64ca6"
        }
        text_selected {
            base "#1a1a1a"
            background "#ffffff"
            emphasis_0 "#93721c"
            emphasis_1 "#2d837e"
            emphasis_2 "#37845f"
            emphasis_3 "#ac5b91"
        }
        table_cell_unselected {
            base "#ffffff"
            background "#1a1a1a"
            emphasis_0 "#ffc531"
            emphasis_1 "#52eee5"
            emphasis_2 "#59d499"
            emphasis_3 "#d64ca6"
        }
        table_cell_selected {
            base "#9b9b9b"
            background "#333333"
            emphasis_0 "#ffc531"
            emphasis_1 "#52eee5"
            emphasis_2 "#59d499"
            emphasis_3 "#e077bc"
        }
        list_unselected {
            base "#ffffff"
            background "#1a1a1a"
            emphasis_0 "#ffc531"
            emphasis_1 "#52eee5"
            emphasis_2 "#59d499"
            emphasis_3 "#d64ca6"
        }
        list_selected {
            base "#9b9b9b"
            background "#333333"
            emphasis_0 "#ffc531"
            emphasis_1 "#52eee5"
            emphasis_2 "#59d499"
            emphasis_3 "#e077bc"
        }
        ribbon_selected {
            base "#1a1a1a"
            background "#59d499"
            emphasis_0 "#8a2d34"
            emphasis_1 "#604a12"
            emphasis_2 "#8b2066"
            emphasis_3 "#24526c"
        }
        ribbon_unselected {
            base "#1a1a1a"
            background "#ffffff"
            emphasis_0 "#d1444f"
            emphasis_1 "#ffffff"
            emphasis_2 "#377da4"
            emphasis_3 "#cf2f98"
        }
        table_title {
            base "#59d499"
            background "#1a1a1a"
            emphasis_0 "#ffc531"
            emphasis_1 "#52eee5"
            emphasis_2 "#59d499"
            emphasis_3 "#d64ca6"
        }
        frame_unselected {
            base "#ffffff"
            background "#1a1a1a"
            emphasis_0 "#ffffff"
            emphasis_1 "#ffffff"
            emphasis_2 "#ffffff"
            emphasis_3 "#ffffff"
        }
        frame_selected {
            base "#59d499"
            background "#1a1a1a"
            emphasis_0 "#ffc531"
            emphasis_1 "#52eee5"
            emphasis_2 "#59d499"
            emphasis_3 "#d64ca6"
        }
        frame_highlight {
            base "#ffc531"
            background "#1a1a1a"
            emphasis_0 "#d64ca6"
            emphasis_1 "#ffc531"
            emphasis_2 "#ffc531"
            emphasis_3 "#ffc531"
        }
        exit_code_success {
            base "#59d499"
            background "#1a1a1a"
            emphasis_0 "#52eee5"
            emphasis_1 "#ffffff"
            emphasis_2 "#d64ca6"
            emphasis_3 "#56c2ff"
        }
        exit_code_error {
            base "#ff5360"
            background "#1a1a1a"
            emphasis_0 "#ffc531"
            emphasis_1 "#ffffff"
            emphasis_2 "#d64ca6"
            emphasis_3 "#56c2ff"
        }
        multiplayer_user_colors {
            player_1 "#d64ca6"
            player_2 "#56c2ff"
            player_3 "#d64ca6"
            player_4 "#ffc531"
            player_5 "#52eee5"
            player_6 "#ffc531"
            player_7 "#ff5360"
            player_8 "#ffffff"
            player_9 "#ff6363"
            player_10 "#56c2ff"
        }
    }
}
