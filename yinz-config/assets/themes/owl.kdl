themes {
    "owl" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/owl
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#231f20"
        terminal {
            foreground "#dedede"
            background "#2f2b2c"
            black "#302c2c"
            red "#5a5a5a"
            green "#989898"
            yellow "#cacaca"
            blue "#656565"
            magenta "#b1b1b1"
            cyan "#7f7f7f"
            white "#dedede"
            bright_black "#5d595b"
            bright_red "#da5b2c"
            bright_green "#989898"
            bright_yellow "#cacaca"
            bright_blue "#656565"
            bright_magenta "#b1b1b1"
            bright_cyan "#7f7f7f"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#dedede"
            background "#2f2b2c"
            emphasis_0 "#cacaca"
            emphasis_1 "#939393"
            emphasis_2 "#989898"
            emphasis_3 "#b1b1b1"
        }
        text_selected {
            base "#2f2b2c"
            background "#dedede"
            emphasis_0 "#626262"
            emphasis_1 "#626262"
            emphasis_2 "#626262"
            emphasis_3 "#626262"
        }
        table_cell_unselected {
            base "#dedede"
            background "#2f2b2c"
            emphasis_0 "#cacaca"
            emphasis_1 "#939393"
            emphasis_2 "#989898"
            emphasis_3 "#b1b1b1"
        }
        table_cell_selected {
            base "#2f2b2c"
            background "#dedede"
            emphasis_0 "#626262"
            emphasis_1 "#626262"
            emphasis_2 "#626262"
            emphasis_3 "#626262"
        }
        list_unselected {
            base "#dedede"
            background "#2f2b2c"
            emphasis_0 "#cacaca"
            emphasis_1 "#939393"
            emphasis_2 "#989898"
            emphasis_3 "#b1b1b1"
        }
        list_selected {
            base "#2f2b2c"
            background "#dedede"
            emphasis_0 "#626262"
            emphasis_1 "#626262"
            emphasis_2 "#626262"
            emphasis_3 "#626262"
        }
        ribbon_selected {
            base "#2f2b2c"
            background "#989898"
            emphasis_0 "#313131"
            emphasis_1 "#313131"
            emphasis_2 "#313131"
            emphasis_3 "#313131"
        }
        ribbon_unselected {
            base "#2f2b2c"
            background "#dedede"
            emphasis_0 "#5a5a5a"
            emphasis_1 "#dedede"
            emphasis_2 "#626262"
            emphasis_3 "#626262"
        }
        table_title {
            base "#989898"
            background "#2f2b2c"
            emphasis_0 "#cacaca"
            emphasis_1 "#939393"
            emphasis_2 "#989898"
            emphasis_3 "#b1b1b1"
        }
        frame_unselected {
            base "#dedede"
            background "#2f2b2c"
            emphasis_0 "#dedede"
            emphasis_1 "#dedede"
            emphasis_2 "#dedede"
            emphasis_3 "#dedede"
        }
        frame_selected {
            base "#989898"
            background "#2f2b2c"
            emphasis_0 "#cacaca"
            emphasis_1 "#939393"
            emphasis_2 "#989898"
            emphasis_3 "#b1b1b1"
        }
        frame_highlight {
            base "#cacaca"
            background "#2f2b2c"
            emphasis_0 "#b1b1b1"
            emphasis_1 "#cacaca"
            emphasis_2 "#cacaca"
            emphasis_3 "#cacaca"
        }
        exit_code_success {
            base "#989898"
            background "#2f2b2c"
            emphasis_0 "#939393"
            emphasis_1 "#dedede"
            emphasis_2 "#b1b1b1"
            emphasis_3 "#939393"
        }
        exit_code_error {
            base "#939393"
            background "#2f2b2c"
            emphasis_0 "#cacaca"
            emphasis_1 "#dedede"
            emphasis_2 "#b1b1b1"
            emphasis_3 "#939393"
        }
        multiplayer_user_colors {
            player_1 "#b1b1b1"
            player_2 "#939393"
            player_3 "#b1b1b1"
            player_4 "#cacaca"
            player_5 "#939393"
            player_6 "#cacaca"
            player_7 "#939393"
            player_8 "#dedede"
            player_9 "#e0744c"
            player_10 "#939393"
        }
    }
}
