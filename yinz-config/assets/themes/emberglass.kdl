themes {
    "emberglass" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Emberglass
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000205"
        terminal {
            foreground "#e6e7eb"
            background "#0b0e11"
            black "#2a2f36"
            red "#f97316"
            green "#22c55e"
            yellow "#eab308"
            blue "#38bdf8"
            magenta "#a855f7"
            cyan "#14b8a6"
            white "#cbd5e1"
            bright_black "#64748b"
            bright_red "#fb923c"
            bright_green "#86efac"
            bright_yellow "#facc15"
            bright_blue "#7dd3fc"
            bright_magenta "#c084fc"
            bright_cyan "#67e8f9"
            bright_white "#f1f5f9"
        }
        text_unselected {
            base "#e6e7eb"
            background "#0b0e11"
            emphasis_0 "#eab308"
            emphasis_1 "#14b8a6"
            emphasis_2 "#22c55e"
            emphasis_3 "#a855f7"
        }
        text_selected {
            base "#0b0e11"
            background "#e6e7eb"
            emphasis_0 "#7b651f"
            emphasis_1 "#41706b"
            emphasis_2 "#3e7251"
            emphasis_3 "#726182"
        }
        table_cell_unselected {
            base "#e6e7eb"
            background "#0b0e11"
            emphasis_0 "#eab308"
            emphasis_1 "#14b8a6"
            emphasis_2 "#22c55e"
            emphasis_3 "#a855f7"
        }
        table_cell_selected {
            base "#e8e7e3"
            background "#4b5563"
            emphasis_0 "#eec33b"
            emphasis_1 "#7dd8ce"
            emphasis_2 "#78dc9d"
            emphasis_3 "#dcbbfc"
        }
        list_unselected {
            base "#e6e7eb"
            background "#0b0e11"
            emphasis_0 "#eab308"
            emphasis_1 "#14b8a6"
            emphasis_2 "#22c55e"
            emphasis_3 "#a855f7"
        }
        list_selected {
            base "#e8e7e3"
            background "#4b5563"
            emphasis_0 "#eec33b"
            emphasis_1 "#7dd8ce"
            emphasis_2 "#78dc9d"
            emphasis_3 "#dcbbfc"
        }
        ribbon_selected {
            base "#0b0e11"
            background "#22c55e"
            emphasis_0 "#693109"
            emphasis_1 "#513e03"
            emphasis_2 "#562b7e"
            emphasis_3 "#14455a"
        }
        ribbon_unselected {
            base "#0b0e11"
            background "#e6e7eb"
            emphasis_0 "#a84e0f"
            emphasis_1 "#e6e7eb"
            emphasis_2 "#216f92"
            emphasis_3 "#8945c9"
        }
        table_title {
            base "#22c55e"
            background "#0b0e11"
            emphasis_0 "#eab308"
            emphasis_1 "#14b8a6"
            emphasis_2 "#22c55e"
            emphasis_3 "#a855f7"
        }
        frame_unselected {
            base "#e6e7eb"
            background "#0b0e11"
            emphasis_0 "#e6e7eb"
            emphasis_1 "#e6e7eb"
            emphasis_2 "#e6e7eb"
            emphasis_3 "#e6e7eb"
        }
        frame_selected {
            base "#22c55e"
            background "#0b0e11"
            emphasis_0 "#eab308"
            emphasis_1 "#14b8a6"
            emphasis_2 "#22c55e"
            emphasis_3 "#a855f7"
        }
        frame_highlight {
            base "#eab308"
            background "#0b0e11"
            emphasis_0 "#a855f7"
            emphasis_1 "#eab308"
            emphasis_2 "#eab308"
            emphasis_3 "#eab308"
        }
        exit_code_success {
            base "#22c55e"
            background "#0b0e11"
            emphasis_0 "#14b8a6"
            emphasis_1 "#e6e7eb"
            emphasis_2 "#a855f7"
            emphasis_3 "#38bdf8"
        }
        exit_code_error {
            base "#f97316"
            background "#0b0e11"
            emphasis_0 "#eab308"
            emphasis_1 "#e6e7eb"
            emphasis_2 "#a855f7"
            emphasis_3 "#38bdf8"
        }
        multiplayer_user_colors {
            player_1 "#a855f7"
            player_2 "#38bdf8"
            player_3 "#c084fc"
            player_4 "#eab308"
            player_5 "#14b8a6"
            player_6 "#facc15"
            player_7 "#f97316"
            player_8 "#cbd5e1"
            player_9 "#fb923c"
            player_10 "#7dd3fc"
        }
    }
}
