themes {
    "django-reborn-again" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Django%20Reborn%20Again
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#001308"
        terminal {
            foreground "#dadedc"
            background "#051f14"
            black "#000000"
            red "#fd6209"
            green "#41a83e"
            yellow "#ffe862"
            blue "#245032"
            magenta "#f8f8f8"
            cyan "#9df39f"
            white "#ffffff"
            bright_black "#4c4c4c"
            bright_red "#ff943b"
            bright_green "#73da70"
            bright_yellow "#ffff94"
            bright_blue "#568264"
            bright_magenta "#ffffff"
            bright_cyan "#cfffd1"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#dadedc"
            background "#051f14"
            emphasis_0 "#ffe862"
            emphasis_1 "#9df39f"
            emphasis_2 "#41a83e"
            emphasis_3 "#f8f8f8"
        }
        text_selected {
            base "#051f14"
            background "#dadedc"
            emphasis_0 "#6c622a"
            emphasis_1 "#446a45"
            emphasis_2 "#306e2e"
            emphasis_3 "#616161"
        }
        table_cell_unselected {
            base "#dadedc"
            background "#051f14"
            emphasis_0 "#ffe862"
            emphasis_1 "#9df39f"
            emphasis_2 "#41a83e"
            emphasis_3 "#f8f8f8"
        }
        table_cell_selected {
            base "#dadedc"
            background "#203727"
            emphasis_0 "#ffe862"
            emphasis_1 "#9df39f"
            emphasis_2 "#4bad49"
            emphasis_3 "#f8f8f8"
        }
        list_unselected {
            base "#dadedc"
            background "#051f14"
            emphasis_0 "#ffe862"
            emphasis_1 "#9df39f"
            emphasis_2 "#41a83e"
            emphasis_3 "#f8f8f8"
        }
        list_selected {
            base "#dadedc"
            background "#203727"
            emphasis_0 "#ffe862"
            emphasis_1 "#9df39f"
            emphasis_2 "#4bad49"
            emphasis_3 "#f8f8f8"
        }
        ribbon_selected {
            base "#051f14"
            background "#41a83e"
            emphasis_0 "#4f1f03"
            emphasis_1 "#322d13"
            emphasis_2 "#2d2d2d"
            emphasis_3 "#173320"
        }
        ribbon_unselected {
            base "#051f14"
            background "#dadedc"
            emphasis_0 "#a84106"
            emphasis_1 "#dadedc"
            emphasis_2 "#245032"
            emphasis_3 "#616161"
        }
        table_title {
            base "#41a83e"
            background "#051f14"
            emphasis_0 "#ffe862"
            emphasis_1 "#9df39f"
            emphasis_2 "#41a83e"
            emphasis_3 "#f8f8f8"
        }
        frame_unselected {
            base "#dadedc"
            background "#051f14"
            emphasis_0 "#dadedc"
            emphasis_1 "#dadedc"
            emphasis_2 "#dadedc"
            emphasis_3 "#dadedc"
        }
        frame_selected {
            base "#41a83e"
            background "#051f14"
            emphasis_0 "#ffe862"
            emphasis_1 "#9df39f"
            emphasis_2 "#41a83e"
            emphasis_3 "#f8f8f8"
        }
        frame_highlight {
            base "#ffe862"
            background "#051f14"
            emphasis_0 "#f8f8f8"
            emphasis_1 "#ffe862"
            emphasis_2 "#ffe862"
            emphasis_3 "#ffe862"
        }
        exit_code_success {
            base "#41a83e"
            background "#051f14"
            emphasis_0 "#9df39f"
            emphasis_1 "#dadedc"
            emphasis_2 "#f8f8f8"
            emphasis_3 "#6b8975"
        }
        exit_code_error {
            base "#fd6209"
            background "#051f14"
            emphasis_0 "#ffe862"
            emphasis_1 "#dadedc"
            emphasis_2 "#f8f8f8"
            emphasis_3 "#6b8975"
        }
        multiplayer_user_colors {
            player_1 "#f8f8f8"
            player_2 "#6b8975"
            player_3 "#ffffff"
            player_4 "#ffe862"
            player_5 "#9df39f"
            player_6 "#ffff94"
            player_7 "#fd6209"
            player_8 "#ffffff"
            player_9 "#ff943b"
            player_10 "#638b70"
        }
    }
}
