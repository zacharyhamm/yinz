themes {
    "liquid-carbon" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Liquid%20Carbon
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#242424"
        terminal {
            foreground "#afc2c2"
            background "#303030"
            black "#000000"
            red "#ff3030"
            green "#559a70"
            yellow "#ccac00"
            blue "#0099cc"
            magenta "#cc69c8"
            cyan "#7ac4cc"
            white "#bccccc"
            bright_black "#595959"
            bright_red "#ff3030"
            bright_green "#559a70"
            bright_yellow "#ccac00"
            bright_blue "#0099cc"
            bright_magenta "#cc69c8"
            bright_cyan "#7ac4cc"
            bright_white "#bccccc"
        }
        text_unselected {
            base "#afc2c2"
            background "#303030"
            emphasis_0 "#ccac00"
            emphasis_1 "#7ac4cc"
            emphasis_2 "#66a47e"
            emphasis_3 "#d177cd"
        }
        text_selected {
            base "#000000"
            background "#7dbeff"
            emphasis_0 "#564900"
            emphasis_1 "#314f52"
            emphasis_2 "#2d513b"
            emphasis_3 "#6a3768"
        }
        table_cell_unselected {
            base "#afc2c2"
            background "#303030"
            emphasis_0 "#ccac00"
            emphasis_1 "#7ac4cc"
            emphasis_2 "#66a47e"
            emphasis_3 "#d177cd"
        }
        table_cell_selected {
            base "#000000"
            background "#7dbeff"
            emphasis_0 "#564900"
            emphasis_1 "#314f52"
            emphasis_2 "#2d513b"
            emphasis_3 "#6a3768"
        }
        list_unselected {
            base "#afc2c2"
            background "#303030"
            emphasis_0 "#ccac00"
            emphasis_1 "#7ac4cc"
            emphasis_2 "#66a47e"
            emphasis_3 "#d177cd"
        }
        list_selected {
            base "#000000"
            background "#7dbeff"
            emphasis_0 "#564900"
            emphasis_1 "#314f52"
            emphasis_2 "#2d513b"
            emphasis_3 "#6a3768"
        }
        ribbon_selected {
            base "#252525"
            background "#559a70"
            emphasis_0 "#4d0e0e"
            emphasis_1 "#2c2500"
            emphasis_2 "#371c36"
            emphasis_3 "#002937"
        }
        ribbon_unselected {
            base "#303030"
            background "#afc2c2"
            emphasis_0 "#971c1c"
            emphasis_1 "#afc2c2"
            emphasis_2 "#005470"
            emphasis_3 "#6f396d"
        }
        table_title {
            base "#66a47e"
            background "#303030"
            emphasis_0 "#ccac00"
            emphasis_1 "#7ac4cc"
            emphasis_2 "#66a47e"
            emphasis_3 "#d177cd"
        }
        frame_unselected {
            base "#afc2c2"
            background "#303030"
            emphasis_0 "#afc2c2"
            emphasis_1 "#afc2c2"
            emphasis_2 "#afc2c2"
            emphasis_3 "#afc2c2"
        }
        frame_selected {
            base "#66a47e"
            background "#303030"
            emphasis_0 "#ccac00"
            emphasis_1 "#7ac4cc"
            emphasis_2 "#66a47e"
            emphasis_3 "#d177cd"
        }
        frame_highlight {
            base "#ccac00"
            background "#303030"
            emphasis_0 "#d177cd"
            emphasis_1 "#ccac00"
            emphasis_2 "#ccac00"
            emphasis_3 "#ccac00"
        }
        exit_code_success {
            base "#66a47e"
            background "#303030"
            emphasis_0 "#7ac4cc"
            emphasis_1 "#afc2c2"
            emphasis_2 "#d177cd"
            emphasis_3 "#18a3d1"
        }
        exit_code_error {
            base "#ff6262"
            background "#303030"
            emphasis_0 "#ccac00"
            emphasis_1 "#afc2c2"
            emphasis_2 "#d177cd"
            emphasis_3 "#18a3d1"
        }
        multiplayer_user_colors {
            player_1 "#d177cd"
            player_2 "#18a3d1"
            player_3 "#d177cd"
            player_4 "#ccac00"
            player_5 "#7ac4cc"
            player_6 "#ccac00"
            player_7 "#ff6262"
            player_8 "#bccccc"
            player_9 "#ff6262"
            player_10 "#18a3d1"
        }
    }
}
