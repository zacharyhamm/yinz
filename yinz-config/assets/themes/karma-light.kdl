themes {
    "karma-light" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Karma%20Light
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#f3f3f3"
        terminal {
            foreground "#0a0e14"
            background "#ffffff"
            black "#0a0e14"
            red "#fc618d"
            green "#2d972f"
            yellow "#eeae11"
            blue "#5688c7"
            magenta "#6f42c1"
            cyan "#5688c7"
            white "#525053"
            bright_black "#999999"
            bright_red "#fc618d"
            bright_green "#2d972f"
            bright_yellow "#ffaa33"
            bright_blue "#5688c7"
            bright_magenta "#a86efd"
            bright_cyan "#5688c7"
            bright_white "#0a0e14"
        }
        text_unselected {
            base "#0a0e14"
            background "#ffffff"
            emphasis_0 "#986f0b"
            emphasis_1 "#4c78b0"
            emphasis_2 "#29882a"
            emphasis_3 "#6f42c1"
        }
        text_selected {
            base "#ffffff"
            background "#0a0e14"
            emphasis_0 "#95762b"
            emphasis_1 "#5c7da6"
            emphasis_2 "#438944"
            emphasis_3 "#8b67cd"
        }
        table_cell_unselected {
            base "#0a0e14"
            background "#ffffff"
            emphasis_0 "#986f0b"
            emphasis_1 "#4c78b0"
            emphasis_2 "#29882a"
            emphasis_3 "#6f42c1"
        }
        table_cell_selected {
            base "#0a0e14"
            background "#e5e3ea"
            emphasis_0 "#846009"
            emphasis_1 "#426898"
            emphasis_2 "#237524"
            emphasis_3 "#6f42c1"
        }
        list_unselected {
            base "#0a0e14"
            background "#ffffff"
            emphasis_0 "#986f0b"
            emphasis_1 "#4c78b0"
            emphasis_2 "#29882a"
            emphasis_3 "#6f42c1"
        }
        list_selected {
            base "#0a0e14"
            background "#e5e3ea"
            emphasis_0 "#846009"
            emphasis_1 "#426898"
            emphasis_2 "#237524"
            emphasis_3 "#6f42c1"
        }
        ribbon_selected {
            base "#1c1c1c"
            background "#2d972f"
            emphasis_0 "#30131b"
            emphasis_1 "#251b03"
            emphasis_2 "#22143c"
            emphasis_3 "#131d2b"
        }
        ribbon_unselected {
            base "#ffffff"
            background "#0a0e14"
            emphasis_0 "#fc618d"
            emphasis_1 "#0a0e14"
            emphasis_2 "#5688c7"
            emphasis_3 "#8b67cd"
        }
        table_title {
            base "#29882a"
            background "#ffffff"
            emphasis_0 "#986f0b"
            emphasis_1 "#4c78b0"
            emphasis_2 "#29882a"
            emphasis_3 "#6f42c1"
        }
        frame_unselected {
            base "#0a0e14"
            background "#ffffff"
            emphasis_0 "#0a0e14"
            emphasis_1 "#0a0e14"
            emphasis_2 "#0a0e14"
            emphasis_3 "#0a0e14"
        }
        frame_selected {
            base "#29882a"
            background "#ffffff"
            emphasis_0 "#986f0b"
            emphasis_1 "#4c78b0"
            emphasis_2 "#29882a"
            emphasis_3 "#6f42c1"
        }
        frame_highlight {
            base "#986f0b"
            background "#ffffff"
            emphasis_0 "#6f42c1"
            emphasis_1 "#986f0b"
            emphasis_2 "#986f0b"
            emphasis_3 "#986f0b"
        }
        exit_code_success {
            base "#29882a"
            background "#ffffff"
            emphasis_0 "#4c78b0"
            emphasis_1 "#0a0e14"
            emphasis_2 "#6f42c1"
            emphasis_3 "#4c78b0"
        }
        exit_code_error {
            base "#c64c6f"
            background "#ffffff"
            emphasis_0 "#986f0b"
            emphasis_1 "#0a0e14"
            emphasis_2 "#6f42c1"
            emphasis_3 "#4c78b0"
        }
        multiplayer_user_colors {
            player_1 "#6f42c1"
            player_2 "#4c78b0"
            player_3 "#8d5cd4"
            player_4 "#986f0b"
            player_5 "#4c78b0"
            player_6 "#a16b20"
            player_7 "#c64c6f"
            player_8 "#525053"
            player_9 "#c64c6f"
            player_10 "#4c78b0"
        }
    }
}
