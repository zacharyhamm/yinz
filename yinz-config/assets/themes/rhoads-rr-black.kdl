themes {
    "rhoads-rr-black" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Rhoads%20RR%20Black
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000000"
        terminal {
            foreground "#f4ecd7"
            background "#0a0907"
            black "#1c1a16"
            red "#c81e1e"
            green "#2e7d32"
            yellow "#d4af37"
            blue "#3b82f6"
            magenta "#a855f7"
            cyan "#06b6d4"
            white "#e5e1cc"
            bright_black "#5a5750"
            bright_red "#ef6b6b"
            bright_green "#8fdc82"
            bright_yellow "#f5df8a"
            bright_blue "#73a7f2"
            bright_magenta "#c49af2"
            bright_cyan "#77d9e5"
            bright_white "#fffaf0"
        }
        text_unselected {
            base "#f4ecd7"
            background "#0a0907"
            emphasis_0 "#d4af37"
            emphasis_1 "#06b6d4"
            emphasis_2 "#3e8742"
            emphasis_3 "#a855f7"
        }
        text_selected {
            base "#0a0907"
            background "#f4ecd7"
            emphasis_0 "#7e6926"
            emphasis_1 "#257583"
            emphasis_2 "#5a715b"
            emphasis_3 "#7a6094"
        }
        table_cell_unselected {
            base "#f4ecd7"
            background "#0a0907"
            emphasis_0 "#d4af37"
            emphasis_1 "#06b6d4"
            emphasis_2 "#3e8742"
            emphasis_3 "#a855f7"
        }
        table_cell_selected {
            base "#e6d7a5"
            background "#5a4512"
            emphasis_0 "#d6b340"
            emphasis_1 "#3ec6de"
            emphasis_2 "#99c09b"
            emphasis_3 "#d0a4fb"
        }
        list_unselected {
            base "#f4ecd7"
            background "#0a0907"
            emphasis_0 "#d4af37"
            emphasis_1 "#06b6d4"
            emphasis_2 "#3e8742"
            emphasis_3 "#a855f7"
        }
        list_selected {
            base "#e6d7a5"
            background "#5a4512"
            emphasis_0 "#d6b340"
            emphasis_1 "#3ec6de"
            emphasis_2 "#99c09b"
            emphasis_3 "#d0a4fb"
        }
        ribbon_selected {
            base "#f1f1f0"
            background "#2e7d32"
            emphasis_0 "#fbeded"
            emphasis_1 "#f7f0da"
            emphasis_2 "#f6edfe"
            emphasis_3 "#e9f1fe"
        }
        ribbon_unselected {
            base "#0a0907"
            background "#f4ecd7"
            emphasis_0 "#c81e1e"
            emphasis_1 "#f4ecd7"
            emphasis_2 "#2f69c6"
            emphasis_3 "#8d47cf"
        }
        table_title {
            base "#3e8742"
            background "#0a0907"
            emphasis_0 "#d4af37"
            emphasis_1 "#06b6d4"
            emphasis_2 "#3e8742"
            emphasis_3 "#a855f7"
        }
        frame_unselected {
            base "#f4ecd7"
            background "#0a0907"
            emphasis_0 "#f4ecd7"
            emphasis_1 "#f4ecd7"
            emphasis_2 "#f4ecd7"
            emphasis_3 "#f4ecd7"
        }
        frame_selected {
            base "#3e8742"
            background "#0a0907"
            emphasis_0 "#d4af37"
            emphasis_1 "#06b6d4"
            emphasis_2 "#3e8742"
            emphasis_3 "#a855f7"
        }
        frame_highlight {
            base "#d4af37"
            background "#0a0907"
            emphasis_0 "#a855f7"
            emphasis_1 "#d4af37"
            emphasis_2 "#d4af37"
            emphasis_3 "#d4af37"
        }
        exit_code_success {
            base "#3e8742"
            background "#0a0907"
            emphasis_0 "#06b6d4"
            emphasis_1 "#f4ecd7"
            emphasis_2 "#a855f7"
            emphasis_3 "#3b82f6"
        }
        exit_code_error {
            base "#d24848"
            background "#0a0907"
            emphasis_0 "#d4af37"
            emphasis_1 "#f4ecd7"
            emphasis_2 "#a855f7"
            emphasis_3 "#3b82f6"
        }
        multiplayer_user_colors {
            player_1 "#a855f7"
            player_2 "#3b82f6"
            player_3 "#c49af2"
            player_4 "#d4af37"
            player_5 "#06b6d4"
            player_6 "#f5df8a"
            player_7 "#d24848"
            player_8 "#e5e1cc"
            player_9 "#ef6b6b"
            player_10 "#73a7f2"
        }
    }
}
