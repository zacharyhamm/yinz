themes {
    "blue-matrix" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Blue%20Matrix
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#04050a"
        terminal {
            foreground "#00a2ff"
            background "#101116"
            black "#101116"
            red "#ff5680"
            green "#00ff9c"
            yellow "#fffc58"
            blue "#00b0ff"
            magenta "#d57bff"
            cyan "#76c1ff"
            white "#c7c7c7"
            bright_black "#686868"
            bright_red "#ff6e67"
            bright_green "#5ffa68"
            bright_yellow "#fffc67"
            bright_blue "#6871ff"
            bright_magenta "#d682ec"
            bright_cyan "#60fdff"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#00a2ff"
            background "#101116"
            emphasis_0 "#fffc58"
            emphasis_1 "#76c1ff"
            emphasis_2 "#00ff9c"
            emphasis_3 "#d57bff"
        }
        text_selected {
            base "#000000"
            background "#c1deff"
            emphasis_0 "#646323"
            emphasis_1 "#3d6484"
            emphasis_2 "#006f44"
            emphasis_3 "#804a99"
        }
        table_cell_unselected {
            base "#00a2ff"
            background "#101116"
            emphasis_0 "#fffc58"
            emphasis_1 "#76c1ff"
            emphasis_2 "#00ff9c"
            emphasis_3 "#d57bff"
        }
        table_cell_selected {
            base "#000000"
            background "#c1deff"
            emphasis_0 "#646323"
            emphasis_1 "#3d6484"
            emphasis_2 "#006f44"
            emphasis_3 "#804a99"
        }
        list_unselected {
            base "#00a2ff"
            background "#101116"
            emphasis_0 "#fffc58"
            emphasis_1 "#76c1ff"
            emphasis_2 "#00ff9c"
            emphasis_3 "#d57bff"
        }
        list_selected {
            base "#000000"
            background "#c1deff"
            emphasis_0 "#646323"
            emphasis_1 "#3d6484"
            emphasis_2 "#006f44"
            emphasis_3 "#804a99"
        }
        ribbon_selected {
            base "#101116"
            background "#00ff9c"
            emphasis_0 "#ac3a56"
            emphasis_1 "#676624"
            emphasis_2 "#834c9d"
            emphasis_3 "#006998"
        }
        ribbon_unselected {
            base "#101116"
            background "#00a2ff"
            emphasis_0 "#5c1f2e"
            emphasis_1 "#00a2ff"
            emphasis_2 "#003851"
            emphasis_3 "#452853"
        }
        table_title {
            base "#00ff9c"
            background "#101116"
            emphasis_0 "#fffc58"
            emphasis_1 "#76c1ff"
            emphasis_2 "#00ff9c"
            emphasis_3 "#d57bff"
        }
        frame_unselected {
            base "#00a2ff"
            background "#101116"
            emphasis_0 "#00a2ff"
            emphasis_1 "#00a2ff"
            emphasis_2 "#00a2ff"
            emphasis_3 "#00a2ff"
        }
        frame_selected {
            base "#00ff9c"
            background "#101116"
            emphasis_0 "#fffc58"
            emphasis_1 "#76c1ff"
            emphasis_2 "#00ff9c"
            emphasis_3 "#d57bff"
        }
        frame_highlight {
            base "#fffc58"
            background "#101116"
            emphasis_0 "#d57bff"
            emphasis_1 "#fffc58"
            emphasis_2 "#fffc58"
            emphasis_3 "#fffc58"
        }
        exit_code_success {
            base "#00ff9c"
            background "#101116"
            emphasis_0 "#76c1ff"
            emphasis_1 "#00a2ff"
            emphasis_2 "#d57bff"
            emphasis_3 "#00b0ff"
        }
        exit_code_error {
            base "#ff5680"
            background "#101116"
            emphasis_0 "#fffc58"
            emphasis_1 "#00a2ff"
            emphasis_2 "#d57bff"
            emphasis_3 "#00b0ff"
        }
        multiplayer_user_colors {
            player_1 "#d57bff"
            player_2 "#00b0ff"
            player_3 "#d682ec"
            player_4 "#fffc58"
            player_5 "#76c1ff"
            player_6 "#fffc67"
            player_7 "#ff5680"
            player_8 "#c7c7c7"
            player_9 "#ff6e67"
            player_10 "#6871ff"
        }
    }
}
