themes {
    "elementary" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Elementary
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#0c0c0c"
        terminal {
            foreground "#efefef"
            background "#181818"
            black "#242424"
            red "#d71c15"
            green "#5aa513"
            yellow "#fdb40c"
            blue "#134899"
            magenta "#e40038"
            cyan "#2595e1"
            white "#efefef"
            bright_black "#4b4b4b"
            bright_red "#fc1c18"
            bright_green "#6bc219"
            bright_yellow "#fec80e"
            bright_blue "#0955ff"
            bright_magenta "#fb0050"
            bright_cyan "#3ea8fc"
            bright_white "#8c00ec"
        }
        text_unselected {
            base "#efefef"
            background "#181818"
            emphasis_0 "#fdb40c"
            emphasis_1 "#2595e1"
            emphasis_2 "#5aa513"
            emphasis_3 "#ea3c67"
        }
        text_selected {
            base "#000000"
            background "#b5d5ff"
            emphasis_0 "#775506"
            emphasis_1 "#185f90"
            emphasis_2 "#38660c"
            emphasis_3 "#b8002d"
        }
        table_cell_unselected {
            base "#efefef"
            background "#181818"
            emphasis_0 "#fdb40c"
            emphasis_1 "#2595e1"
            emphasis_2 "#5aa513"
            emphasis_3 "#ea3c67"
        }
        table_cell_selected {
            base "#000000"
            background "#b5d5ff"
            emphasis_0 "#775506"
            emphasis_1 "#185f90"
            emphasis_2 "#38660c"
            emphasis_3 "#b8002d"
        }
        list_unselected {
            base "#efefef"
            background "#181818"
            emphasis_0 "#fdb40c"
            emphasis_1 "#2595e1"
            emphasis_2 "#5aa513"
            emphasis_3 "#ea3c67"
        }
        list_selected {
            base "#000000"
            background "#b5d5ff"
            emphasis_0 "#775506"
            emphasis_1 "#185f90"
            emphasis_2 "#38660c"
            emphasis_3 "#b8002d"
        }
        ribbon_selected {
            base "#181818"
            background "#5aa513"
            emphasis_0 "#5c0c09"
            emphasis_1 "#3a2903"
            emphasis_2 "#600017"
            emphasis_3 "#0b2b5c"
        }
        ribbon_unselected {
            base "#181818"
            background "#efefef"
            emphasis_0 "#d61c15"
            emphasis_1 "#efefef"
            emphasis_2 "#134899"
            emphasis_3 "#da0036"
        }
        table_title {
            base "#5aa513"
            background "#181818"
            emphasis_0 "#fdb40c"
            emphasis_1 "#2595e1"
            emphasis_2 "#5aa513"
            emphasis_3 "#ea3c67"
        }
        frame_unselected {
            base "#efefef"
            background "#181818"
            emphasis_0 "#efefef"
            emphasis_1 "#efefef"
            emphasis_2 "#efefef"
            emphasis_3 "#efefef"
        }
        frame_selected {
            base "#5aa513"
            background "#181818"
            emphasis_0 "#fdb40c"
            emphasis_1 "#2595e1"
            emphasis_2 "#5aa513"
            emphasis_3 "#ea3c67"
        }
        frame_highlight {
            base "#fdb40c"
            background "#181818"
            emphasis_0 "#ea3c67"
            emphasis_1 "#fdb40c"
            emphasis_2 "#fdb40c"
            emphasis_3 "#fdb40c"
        }
        exit_code_success {
            base "#5aa513"
            background "#181818"
            emphasis_0 "#2595e1"
            emphasis_1 "#efefef"
            emphasis_2 "#ea3c67"
            emphasis_3 "#5e82b9"
        }
        exit_code_error {
            base "#e04e48"
            background "#181818"
            emphasis_0 "#fdb40c"
            emphasis_1 "#efefef"
            emphasis_2 "#ea3c67"
            emphasis_3 "#5e82b9"
        }
        multiplayer_user_colors {
            player_1 "#ea3c67"
            player_2 "#5e82b9"
            player_3 "#fb105b"
            player_4 "#fdb40c"
            player_5 "#2595e1"
            player_6 "#fec80e"
            player_7 "#e04e48"
            player_8 "#efefef"
            player_9 "#fc1d19"
            player_10 "#3c78ff"
        }
    }
}
