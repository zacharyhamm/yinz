themes {
    "crt-amber" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/CRT%20Amber
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#0e0400"
        terminal {
            foreground "#fff3c4"
            background "#1a1005"
            black "#4c422f"
            red "#ef4444"
            green "#84cc16"
            yellow "#fde68a"
            blue "#c084fc"
            magenta "#f97316"
            cyan "#f59e0b"
            white "#d8a657"
            bright_black "#544435"
            bright_red "#f26969"
            bright_green "#9dd645"
            bright_yellow "#fdeb9f"
            bright_blue "#cd9dfd"
            bright_magenta "#fa8f45"
            bright_cyan "#f7b13c"
            bright_white "#fff3c4"
        }
        text_unselected {
            base "#fff3c4"
            background "#1a1005"
            emphasis_0 "#fde68a"
            emphasis_1 "#f59e0b"
            emphasis_2 "#84cc16"
            emphasis_3 "#f97316"
        }
        text_selected {
            base "#1a1005"
            background "#fff3c4"
            emphasis_0 "#7a6f43"
            emphasis_1 "#9a6307"
            emphasis_2 "#507b0d"
            emphasis_3 "#b45310"
        }
        table_cell_unselected {
            base "#fff3c4"
            background "#1a1005"
            emphasis_0 "#fde68a"
            emphasis_1 "#f59e0b"
            emphasis_2 "#84cc16"
            emphasis_3 "#f97316"
        }
        table_cell_selected {
            base "#1a1005"
            background "#fff3c4"
            emphasis_0 "#7a6f43"
            emphasis_1 "#9a6307"
            emphasis_2 "#507b0d"
            emphasis_3 "#b45310"
        }
        list_unselected {
            base "#fff3c4"
            background "#1a1005"
            emphasis_0 "#fde68a"
            emphasis_1 "#f59e0b"
            emphasis_2 "#84cc16"
            emphasis_3 "#f97316"
        }
        list_selected {
            base "#1a1005"
            background "#fff3c4"
            emphasis_0 "#7a6f43"
            emphasis_1 "#9a6307"
            emphasis_2 "#507b0d"
            emphasis_3 "#b45310"
        }
        ribbon_selected {
            base "#1a1005"
            background "#84cc16"
            emphasis_0 "#872626"
            emphasis_1 "#50492c"
            emphasis_2 "#78370b"
            emphasis_3 "#593d75"
        }
        ribbon_unselected {
            base "#1a1005"
            background "#fff3c4"
            emphasis_0 "#ca3a3a"
            emphasis_1 "#fff3c4"
            emphasis_2 "#865cb0"
            emphasis_3 "#b45310"
        }
        table_title {
            base "#84cc16"
            background "#1a1005"
            emphasis_0 "#fde68a"
            emphasis_1 "#f59e0b"
            emphasis_2 "#84cc16"
            emphasis_3 "#f97316"
        }
        frame_unselected {
            base "#fff3c4"
            background "#1a1005"
            emphasis_0 "#fff3c4"
            emphasis_1 "#fff3c4"
            emphasis_2 "#fff3c4"
            emphasis_3 "#fff3c4"
        }
        frame_selected {
            base "#84cc16"
            background "#1a1005"
            emphasis_0 "#fde68a"
            emphasis_1 "#f59e0b"
            emphasis_2 "#84cc16"
            emphasis_3 "#f97316"
        }
        frame_highlight {
            base "#fde68a"
            background "#1a1005"
            emphasis_0 "#f97316"
            emphasis_1 "#fde68a"
            emphasis_2 "#fde68a"
            emphasis_3 "#fde68a"
        }
        exit_code_success {
            base "#84cc16"
            background "#1a1005"
            emphasis_0 "#f59e0b"
            emphasis_1 "#fff3c4"
            emphasis_2 "#f97316"
            emphasis_3 "#c084fc"
        }
        exit_code_error {
            base "#ef4444"
            background "#1a1005"
            emphasis_0 "#fde68a"
            emphasis_1 "#fff3c4"
            emphasis_2 "#f97316"
            emphasis_3 "#c084fc"
        }
        multiplayer_user_colors {
            player_1 "#f97316"
            player_2 "#c084fc"
            player_3 "#fa8f45"
            player_4 "#fde68a"
            player_5 "#f59e0b"
            player_6 "#fdeb9f"
            player_7 "#ef4444"
            player_8 "#d8a657"
            player_9 "#f26969"
            player_10 "#cd9dfd"
        }
    }
}
