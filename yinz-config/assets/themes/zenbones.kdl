themes {
    "zenbones" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Zenbones
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#e4e1e0"
        terminal {
            foreground "#2c363c"
            background "#f0edec"
            black "#f0edec"
            red "#a8334c"
            green "#4f6c31"
            yellow "#944927"
            blue "#286486"
            magenta "#88507d"
            cyan "#3b8992"
            white "#2c363c"
            bright_black "#b5a7a0"
            bright_red "#94253e"
            bright_green "#3f5a22"
            bright_yellow "#803d1c"
            bright_blue "#1d5573"
            bright_magenta "#7b3b70"
            bright_cyan "#2b747c"
            bright_white "#4f5e68"
        }
        text_unselected {
            base "#2c363c"
            background "#f0edec"
            emphasis_0 "#944927"
            emphasis_1 "#32757d"
            emphasis_2 "#4f6c31"
            emphasis_3 "#88507d"
        }
        text_selected {
            base "#f0edec"
            background "#2c363c"
            emphasis_0 "#bf937e"
            emphasis_1 "#80a3a7"
            emphasis_2 "#91a280"
            emphasis_3 "#b393ad"
        }
        table_cell_unselected {
            base "#2c363c"
            background "#f0edec"
            emphasis_0 "#944927"
            emphasis_1 "#32757d"
            emphasis_2 "#4f6c31"
            emphasis_3 "#88507d"
        }
        table_cell_selected {
            base "#2c363c"
            background "#cbd9e3"
            emphasis_0 "#934927"
            emphasis_1 "#2c666d"
            emphasis_2 "#4a662e"
            emphasis_3 "#814c77"
        }
        list_unselected {
            base "#2c363c"
            background "#f0edec"
            emphasis_0 "#944927"
            emphasis_1 "#32757d"
            emphasis_2 "#4f6c31"
            emphasis_3 "#88507d"
        }
        list_selected {
            base "#2c363c"
            background "#cbd9e3"
            emphasis_0 "#934927"
            emphasis_1 "#2c666d"
            emphasis_2 "#4a662e"
            emphasis_3 "#814c77"
        }
        ribbon_selected {
            base "#f0edec"
            background "#4f6c31"
            emphasis_0 "#f0dbdf"
            emphasis_1 "#ebddd7"
            emphasis_2 "#e8dde6"
            emphasis_3 "#d7e2e8"
        }
        ribbon_unselected {
            base "#f0edec"
            background "#2c363c"
            emphasis_0 "#cd8a99"
            emphasis_1 "#2c363c"
            emphasis_2 "#7ea2b6"
            emphasis_3 "#b592ae"
        }
        table_title {
            base "#4f6c31"
            background "#f0edec"
            emphasis_0 "#944927"
            emphasis_1 "#32757d"
            emphasis_2 "#4f6c31"
            emphasis_3 "#88507d"
        }
        frame_unselected {
            base "#2c363c"
            background "#f0edec"
            emphasis_0 "#2c363c"
            emphasis_1 "#2c363c"
            emphasis_2 "#2c363c"
            emphasis_3 "#2c363c"
        }
        frame_selected {
            base "#4f6c31"
            background "#f0edec"
            emphasis_0 "#944927"
            emphasis_1 "#32757d"
            emphasis_2 "#4f6c31"
            emphasis_3 "#88507d"
        }
        frame_highlight {
            base "#944927"
            background "#f0edec"
            emphasis_0 "#88507d"
            emphasis_1 "#944927"
            emphasis_2 "#944927"
            emphasis_3 "#944927"
        }
        exit_code_success {
            base "#4f6c31"
            background "#f0edec"
            emphasis_0 "#32757d"
            emphasis_1 "#2c363c"
            emphasis_2 "#88507d"
            emphasis_3 "#286486"
        }
        exit_code_error {
            base "#a8334c"
            background "#f0edec"
            emphasis_0 "#944927"
            emphasis_1 "#2c363c"
            emphasis_2 "#88507d"
            emphasis_3 "#286486"
        }
        multiplayer_user_colors {
            player_1 "#88507d"
            player_2 "#286486"
            player_3 "#7b3b70"
            player_4 "#944927"
            player_5 "#32757d"
            player_6 "#803d1c"
            player_7 "#a8334c"
            player_8 "#2c363c"
            player_9 "#94253e"
            player_10 "#1d5573"
        }
    }
}
