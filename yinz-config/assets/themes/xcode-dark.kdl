themes {
    "xcode-dark" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Xcode%20Dark
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#1d1e24"
        terminal {
            foreground "#dfdfe0"
            background "#292a30"
            black "#414453"
            red "#ff8170"
            green "#78c2b3"
            yellow "#d9c97c"
            blue "#4eb0cc"
            magenta "#ff7ab2"
            cyan "#b281eb"
            white "#dfdfe0"
            bright_black "#7f8c98"
            bright_red "#ff8170"
            bright_green "#acf2e4"
            bright_yellow "#ffa14f"
            bright_blue "#6bdfff"
            bright_magenta "#ff7ab2"
            bright_cyan "#dabaff"
            bright_white "#dfdfe0"
        }
        text_unselected {
            base "#dfdfe0"
            background "#292a30"
            emphasis_0 "#d9c97c"
            emphasis_1 "#b281eb"
            emphasis_2 "#78c2b3"
            emphasis_3 "#ff7ab2"
        }
        text_selected {
            base "#292a30"
            background "#dfdfe0"
            emphasis_0 "#6b633d"
            emphasis_1 "#6e5a86"
            emphasis_2 "#416a62"
            emphasis_3 "#8f4f6a"
        }
        table_cell_unselected {
            base "#dfdfe0"
            background "#292a30"
            emphasis_0 "#d9c97c"
            emphasis_1 "#b281eb"
            emphasis_2 "#78c2b3"
            emphasis_3 "#ff7ab2"
        }
        table_cell_selected {
            base "#dfdfe0"
            background "#414453"
            emphasis_0 "#d9c97c"
            emphasis_1 "#c6a2f0"
            emphasis_2 "#78c2b3"
            emphasis_3 "#ff8dbd"
        }
        list_unselected {
            base "#dfdfe0"
            background "#292a30"
            emphasis_0 "#d9c97c"
            emphasis_1 "#b281eb"
            emphasis_2 "#78c2b3"
            emphasis_3 "#ff7ab2"
        }
        list_selected {
            base "#dfdfe0"
            background "#414453"
            emphasis_0 "#d9c97c"
            emphasis_1 "#c6a2f0"
            emphasis_2 "#78c2b3"
            emphasis_3 "#ff8dbd"
        }
        ribbon_selected {
            base "#292a30"
            background "#78c2b3"
            emphasis_0 "#6d3730"
            emphasis_1 "#4d472c"
            emphasis_2 "#6d344c"
            emphasis_3 "#224c58"
        }
        ribbon_unselected {
            base "#292a30"
            background "#dfdfe0"
            emphasis_0 "#994d43"
            emphasis_1 "#dfdfe0"
            emphasis_2 "#2f6a7b"
            emphasis_3 "#98496a"
        }
        table_title {
            base "#78c2b3"
            background "#292a30"
            emphasis_0 "#d9c97c"
            emphasis_1 "#b281eb"
            emphasis_2 "#78c2b3"
            emphasis_3 "#ff7ab2"
        }
        frame_unselected {
            base "#dfdfe0"
            background "#292a30"
            emphasis_0 "#dfdfe0"
            emphasis_1 "#dfdfe0"
            emphasis_2 "#dfdfe0"
            emphasis_3 "#dfdfe0"
        }
        frame_selected {
            base "#78c2b3"
            background "#292a30"
            emphasis_0 "#d9c97c"
            emphasis_1 "#b281eb"
            emphasis_2 "#78c2b3"
            emphasis_3 "#ff7ab2"
        }
        frame_highlight {
            base "#d9c97c"
            background "#292a30"
            emphasis_0 "#ff7ab2"
            emphasis_1 "#d9c97c"
            emphasis_2 "#d9c97c"
            emphasis_3 "#d9c97c"
        }
        exit_code_success {
            base "#78c2b3"
            background "#292a30"
            emphasis_0 "#b281eb"
            emphasis_1 "#dfdfe0"
            emphasis_2 "#ff7ab2"
            emphasis_3 "#4eb0cc"
        }
        exit_code_error {
            base "#ff8170"
            background "#292a30"
            emphasis_0 "#d9c97c"
            emphasis_1 "#dfdfe0"
            emphasis_2 "#ff7ab2"
            emphasis_3 "#4eb0cc"
        }
        multiplayer_user_colors {
            player_1 "#ff7ab2"
            player_2 "#4eb0cc"
            player_3 "#ff7ab2"
            player_4 "#d9c97c"
            player_5 "#b281eb"
            player_6 "#ffa14f"
            player_7 "#ff8170"
            player_8 "#dfdfe0"
            player_9 "#ff8170"
            player_10 "#6bdfff"
        }
    }
}
