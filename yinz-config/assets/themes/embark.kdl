themes {
    "embark" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Embark
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#121025"
        terminal {
            foreground "#eeffff"
            background "#1e1c31"
            black "#1e1c31"
            red "#f0719b"
            green "#a1efd3"
            yellow "#ffe9aa"
            blue "#57c7ff"
            magenta "#c792ea"
            cyan "#87dfeb"
            white "#f8f8f2"
            bright_black "#585273"
            bright_red "#f02e6e"
            bright_green "#2ce592"
            bright_yellow "#ffb378"
            bright_blue "#1da0e2"
            bright_magenta "#a742ea"
            bright_cyan "#63f2f1"
            bright_white "#a6b3cc"
        }
        text_unselected {
            base "#eeffff"
            background "#1e1c31"
            emphasis_0 "#ffe9aa"
            emphasis_1 "#87dfeb"
            emphasis_2 "#a1efd3"
            emphasis_3 "#c792ea"
        }
        text_selected {
            base "#1e1c31"
            background "#fbfcfc"
            emphasis_0 "#7f7455"
            emphasis_1 "#4b7c83"
            emphasis_2 "#547d6e"
            emphasis_3 "#8b66a3"
        }
        table_cell_unselected {
            base "#eeffff"
            background "#1e1c31"
            emphasis_0 "#ffe9aa"
            emphasis_1 "#87dfeb"
            emphasis_2 "#a1efd3"
            emphasis_3 "#c792ea"
        }
        table_cell_selected {
            base "#1e1c31"
            background "#fbfcfc"
            emphasis_0 "#7f7455"
            emphasis_1 "#4b7c83"
            emphasis_2 "#547d6e"
            emphasis_3 "#8b66a3"
        }
        list_unselected {
            base "#eeffff"
            background "#1e1c31"
            emphasis_0 "#ffe9aa"
            emphasis_1 "#87dfeb"
            emphasis_2 "#a1efd3"
            emphasis_3 "#c792ea"
        }
        list_selected {
            base "#1e1c31"
            background "#fbfcfc"
            emphasis_0 "#7f7455"
            emphasis_1 "#4b7c83"
            emphasis_2 "#547d6e"
            emphasis_3 "#8b66a3"
        }
        ribbon_selected {
            base "#1e1c31"
            background "#a1efd3"
            emphasis_0 "#9a4964"
            emphasis_1 "#6b6247"
            emphasis_2 "#76568b"
            emphasis_3 "#2e6987"
        }
        ribbon_unselected {
            base "#1e1c31"
            background "#eeffff"
            emphasis_0 "#b55575"
            emphasis_1 "#eeffff"
            emphasis_2 "#367b9e"
            emphasis_3 "#8b66a3"
        }
        table_title {
            base "#a1efd3"
            background "#1e1c31"
            emphasis_0 "#ffe9aa"
            emphasis_1 "#87dfeb"
            emphasis_2 "#a1efd3"
            emphasis_3 "#c792ea"
        }
        frame_unselected {
            base "#eeffff"
            background "#1e1c31"
            emphasis_0 "#eeffff"
            emphasis_1 "#eeffff"
            emphasis_2 "#eeffff"
            emphasis_3 "#eeffff"
        }
        frame_selected {
            base "#a1efd3"
            background "#1e1c31"
            emphasis_0 "#ffe9aa"
            emphasis_1 "#87dfeb"
            emphasis_2 "#a1efd3"
            emphasis_3 "#c792ea"
        }
        frame_highlight {
            base "#ffe9aa"
            background "#1e1c31"
            emphasis_0 "#c792ea"
            emphasis_1 "#ffe9aa"
            emphasis_2 "#ffe9aa"
            emphasis_3 "#ffe9aa"
        }
        exit_code_success {
            base "#a1efd3"
            background "#1e1c31"
            emphasis_0 "#87dfeb"
            emphasis_1 "#eeffff"
            emphasis_2 "#c792ea"
            emphasis_3 "#57c7ff"
        }
        exit_code_error {
            base "#f0719b"
            background "#1e1c31"
            emphasis_0 "#ffe9aa"
            emphasis_1 "#eeffff"
            emphasis_2 "#c792ea"
            emphasis_3 "#57c7ff"
        }
        multiplayer_user_colors {
            player_1 "#c792ea"
            player_2 "#57c7ff"
            player_3 "#b35ded"
            player_4 "#ffe9aa"
            player_5 "#87dfeb"
            player_6 "#ffb378"
            player_7 "#f0719b"
            player_8 "#f8f8f2"
            player_9 "#f13e79"
            player_10 "#1da0e2"
        }
    }
}
