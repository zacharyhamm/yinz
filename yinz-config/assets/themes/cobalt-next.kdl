themes {
    "cobalt-next" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Cobalt%20Next
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#0a2029"
        terminal {
            foreground "#d7deea"
            background "#162c35"
            black "#000000"
            red "#ff527b"
            green "#8cc98f"
            yellow "#ffc64c"
            blue "#409dd4"
            magenta "#cba3c7"
            cyan "#37b5b4"
            white "#d7deea"
            bright_black "#62747f"
            bright_red "#e47e8b"
            bright_green "#baddbb"
            bright_yellow "#ffdc91"
            bright_blue "#7ac0eb"
            bright_magenta "#f3ccef"
            bright_cyan "#84e4e3"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#d7deea"
            background "#162c35"
            emphasis_0 "#ffc64c"
            emphasis_1 "#37b5b4"
            emphasis_2 "#8cc98f"
            emphasis_3 "#cba3c7"
        }
        text_selected {
            base "#162c35"
            background "#d7deea"
            emphasis_0 "#795e25"
            emphasis_1 "#4a6767"
            emphasis_2 "#546754"
            emphasis_3 "#695f68"
        }
        table_cell_unselected {
            base "#d7deea"
            background "#162c35"
            emphasis_0 "#ffc64c"
            emphasis_1 "#37b5b4"
            emphasis_2 "#8cc98f"
            emphasis_3 "#cba3c7"
        }
        table_cell_selected {
            base "#ffffff"
            background "#4c5b67"
            emphasis_0 "#ffc74e"
            emphasis_1 "#9ddbda"
            emphasis_2 "#b0dab2"
            emphasis_3 "#e0c9de"
        }
        list_unselected {
            base "#d7deea"
            background "#162c35"
            emphasis_0 "#ffc64c"
            emphasis_1 "#37b5b4"
            emphasis_2 "#8cc98f"
            emphasis_3 "#cba3c7"
        }
        list_selected {
            base "#ffffff"
            background "#4c5b67"
            emphasis_0 "#ffc74e"
            emphasis_1 "#9ddbda"
            emphasis_2 "#b0dab2"
            emphasis_3 "#e0c9de"
        }
        ribbon_selected {
            base "#162c35"
            background "#8cc98f"
            emphasis_0 "#842a40"
            emphasis_1 "#5d481c"
            emphasis_2 "#574655"
            emphasis_3 "#204f6b"
        }
        ribbon_unselected {
            base "#162c35"
            background "#d7deea"
            emphasis_0 "#ac3753"
            emphasis_1 "#d7deea"
            emphasis_2 "#2a678c"
            emphasis_3 "#725b70"
        }
        table_title {
            base "#8cc98f"
            background "#162c35"
            emphasis_0 "#ffc64c"
            emphasis_1 "#37b5b4"
            emphasis_2 "#8cc98f"
            emphasis_3 "#cba3c7"
        }
        frame_unselected {
            base "#d7deea"
            background "#162c35"
            emphasis_0 "#d7deea"
            emphasis_1 "#d7deea"
            emphasis_2 "#d7deea"
            emphasis_3 "#d7deea"
        }
        frame_selected {
            base "#8cc98f"
            background "#162c35"
            emphasis_0 "#ffc64c"
            emphasis_1 "#37b5b4"
            emphasis_2 "#8cc98f"
            emphasis_3 "#cba3c7"
        }
        frame_highlight {
            base "#ffc64c"
            background "#162c35"
            emphasis_0 "#cba3c7"
            emphasis_1 "#ffc64c"
            emphasis_2 "#ffc64c"
            emphasis_3 "#ffc64c"
        }
        exit_code_success {
            base "#8cc98f"
            background "#162c35"
            emphasis_0 "#37b5b4"
            emphasis_1 "#d7deea"
            emphasis_2 "#cba3c7"
            emphasis_3 "#409dd4"
        }
        exit_code_error {
            base "#ff527b"
            background "#162c35"
            emphasis_0 "#ffc64c"
            emphasis_1 "#d7deea"
            emphasis_2 "#cba3c7"
            emphasis_3 "#409dd4"
        }
        multiplayer_user_colors {
            player_1 "#cba3c7"
            player_2 "#409dd4"
            player_3 "#f3ccef"
            player_4 "#ffc64c"
            player_5 "#37b5b4"
            player_6 "#ffdc91"
            player_7 "#ff527b"
            player_8 "#d7deea"
            player_9 "#e47e8b"
            player_10 "#7ac0eb"
        }
    }
}
