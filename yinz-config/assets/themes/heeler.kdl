themes {
    "heeler" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Heeler
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#15133a"
        terminal {
            foreground "#fdfdfd"
            background "#211f46"
            black "#000000"
            red "#e44c2e"
            green "#bdd100"
            yellow "#f4ce65"
            blue "#5ba5f2"
            magenta "#ff95c2"
            cyan "#ff9763"
            white "#ffffff"
            bright_black "#4c4c4c"
            bright_red "#e44c2e"
            bright_green "#bdd100"
            bright_yellow "#f4ce65"
            bright_blue "#0088ff"
            bright_magenta "#ff95c2"
            bright_cyan "#8da6e4"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#fdfdfd"
            background "#211f46"
            emphasis_0 "#f4ce65"
            emphasis_1 "#ff9763"
            emphasis_2 "#bdd100"
            emphasis_3 "#ff95c2"
        }
        text_selected {
            base "#211f46"
            background "#fdfdfd"
            emphasis_0 "#887338"
            emphasis_1 "#a86341"
            emphasis_2 "#707c00"
            emphasis_3 "#a5607e"
        }
        table_cell_unselected {
            base "#fdfdfd"
            background "#211f46"
            emphasis_0 "#f4ce65"
            emphasis_1 "#ff9763"
            emphasis_2 "#bdd100"
            emphasis_3 "#ff95c2"
        }
        table_cell_selected {
            base "#2eff58"
            background "#2b2c41"
            emphasis_0 "#f4ce65"
            emphasis_1 "#ff9763"
            emphasis_2 "#bdd100"
            emphasis_3 "#ff95c2"
        }
        list_unselected {
            base "#fdfdfd"
            background "#211f46"
            emphasis_0 "#f4ce65"
            emphasis_1 "#ff9763"
            emphasis_2 "#bdd100"
            emphasis_3 "#ff95c2"
        }
        list_selected {
            base "#2eff58"
            background "#2b2c41"
            emphasis_0 "#f4ce65"
            emphasis_1 "#ff9763"
            emphasis_2 "#bdd100"
            emphasis_3 "#ff95c2"
        }
        ribbon_selected {
            base "#211f46"
            background "#bdd100"
            emphasis_0 "#94311e"
            emphasis_1 "#605128"
            emphasis_2 "#754459"
            emphasis_3 "#2f557d"
        }
        ribbon_unselected {
            base "#211f46"
            background "#fdfdfd"
            emphasis_0 "#d0452a"
            emphasis_1 "#fdfdfd"
            emphasis_2 "#4278b1"
            emphasis_3 "#a5607e"
        }
        table_title {
            base "#bdd100"
            background "#211f46"
            emphasis_0 "#f4ce65"
            emphasis_1 "#ff9763"
            emphasis_2 "#bdd100"
            emphasis_3 "#ff95c2"
        }
        frame_unselected {
            base "#fdfdfd"
            background "#211f46"
            emphasis_0 "#fdfdfd"
            emphasis_1 "#fdfdfd"
            emphasis_2 "#fdfdfd"
            emphasis_3 "#fdfdfd"
        }
        frame_selected {
            base "#bdd100"
            background "#211f46"
            emphasis_0 "#f4ce65"
            emphasis_1 "#ff9763"
            emphasis_2 "#bdd100"
            emphasis_3 "#ff95c2"
        }
        frame_highlight {
            base "#f4ce65"
            background "#211f46"
            emphasis_0 "#ff95c2"
            emphasis_1 "#f4ce65"
            emphasis_2 "#f4ce65"
            emphasis_3 "#f4ce65"
        }
        exit_code_success {
            base "#bdd100"
            background "#211f46"
            emphasis_0 "#ff9763"
            emphasis_1 "#fdfdfd"
            emphasis_2 "#ff95c2"
            emphasis_3 "#5ba5f2"
        }
        exit_code_error {
            base "#e75e42"
            background "#211f46"
            emphasis_0 "#f4ce65"
            emphasis_1 "#fdfdfd"
            emphasis_2 "#ff95c2"
            emphasis_3 "#5ba5f2"
        }
        multiplayer_user_colors {
            player_1 "#ff95c2"
            player_2 "#5ba5f2"
            player_3 "#ff95c2"
            player_4 "#f4ce65"
            player_5 "#ff9763"
            player_6 "#f4ce65"
            player_7 "#e75e42"
            player_8 "#ffffff"
            player_9 "#e75e42"
            player_10 "#048aff"
        }
    }
}
