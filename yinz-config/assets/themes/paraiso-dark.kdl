themes {
    "paraiso-dark" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Paraiso%20Dark
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#231222"
        terminal {
            foreground "#a39e9b"
            background "#2f1e2e"
            black "#2f1e2e"
            red "#ef6155"
            green "#48b685"
            yellow "#fec418"
            blue "#06b6ef"
            magenta "#815ba4"
            cyan "#5bc4bf"
            white "#a39e9b"
            bright_black "#776e71"
            bright_red "#ef6155"
            bright_green "#48b685"
            bright_yellow "#fec418"
            bright_blue "#06b6ef"
            bright_magenta "#815ba4"
            bright_cyan "#5bc4bf"
            bright_white "#e7e9db"
        }
        text_unselected {
            base "#a39e9b"
            background "#2f1e2e"
            emphasis_0 "#fec418"
            emphasis_1 "#5bc4bf"
            emphasis_2 "#48b685"
            emphasis_3 "#9c7eb7"
        }
        text_selected {
            base "#2f1e2e"
            background "#a39e9b"
            emphasis_0 "#443406"
            emphasis_1 "#1c3c3a"
            emphasis_2 "#203c30"
            emphasis_3 "#3a343f"
        }
        table_cell_unselected {
            base "#a39e9b"
            background "#2f1e2e"
            emphasis_0 "#fec418"
            emphasis_1 "#5bc4bf"
            emphasis_2 "#48b685"
            emphasis_3 "#9c7eb7"
        }
        table_cell_selected {
            base "#b6b2af"
            background "#4f424c"
            emphasis_0 "#fec418"
            emphasis_1 "#5bc4bf"
            emphasis_2 "#6ac49c"
            emphasis_3 "#bfacd1"
        }
        list_unselected {
            base "#a39e9b"
            background "#2f1e2e"
            emphasis_0 "#fec418"
            emphasis_1 "#5bc4bf"
            emphasis_2 "#48b685"
            emphasis_3 "#9c7eb7"
        }
        list_selected {
            base "#b6b2af"
            background "#4f424c"
            emphasis_0 "#fec418"
            emphasis_1 "#5bc4bf"
            emphasis_2 "#6ac49c"
            emphasis_3 "#bfacd1"
        }
        ribbon_selected {
            base "#2f1e2e"
            background "#48b685"
            emphasis_0 "#612823"
            emphasis_1 "#483707"
            emphasis_2 "#463159"
            emphasis_3 "#023f52"
        }
        ribbon_unselected {
            base "#2f1e2e"
            background "#a39e9b"
            emphasis_0 "#5c2521"
            emphasis_1 "#a39e9b"
            emphasis_2 "#023b4e"
            emphasis_3 "#422e54"
        }
        table_title {
            base "#48b685"
            background "#2f1e2e"
            emphasis_0 "#fec418"
            emphasis_1 "#5bc4bf"
            emphasis_2 "#48b685"
            emphasis_3 "#9c7eb7"
        }
        frame_unselected {
            base "#a39e9b"
            background "#2f1e2e"
            emphasis_0 "#a39e9b"
            emphasis_1 "#a39e9b"
            emphasis_2 "#a39e9b"
            emphasis_3 "#a39e9b"
        }
        frame_selected {
            base "#48b685"
            background "#2f1e2e"
            emphasis_0 "#fec418"
            emphasis_1 "#5bc4bf"
            emphasis_2 "#48b685"
            emphasis_3 "#9c7eb7"
        }
        frame_highlight {
            base "#fec418"
            background "#2f1e2e"
            emphasis_0 "#9c7eb7"
            emphasis_1 "#fec418"
            emphasis_2 "#fec418"
            emphasis_3 "#fec418"
        }
        exit_code_success {
            base "#48b685"
            background "#2f1e2e"
            emphasis_0 "#5bc4bf"
            emphasis_1 "#a39e9b"
            emphasis_2 "#9c7eb7"
            emphasis_3 "#06b6ef"
        }
        exit_code_error {
            base "#ef6155"
            background "#2f1e2e"
            emphasis_0 "#fec418"
            emphasis_1 "#a39e9b"
            emphasis_2 "#9c7eb7"
            emphasis_3 "#06b6ef"
        }
        multiplayer_user_colors {
            player_1 "#9c7eb7"
            player_2 "#06b6ef"
            player_3 "#9c7eb7"
            player_4 "#fec418"
            player_5 "#5bc4bf"
            player_6 "#fec418"
            player_7 "#ef6155"
            player_8 "#a39e9b"
            player_9 "#ef6155"
            player_10 "#06b6ef"
        }
    }
}
