themes {
    "konsolas" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Konsolas
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000000"
        terminal {
            foreground "#c8c1c1"
            background "#060606"
            black "#000000"
            red "#aa1717"
            green "#18b218"
            yellow "#ebae1f"
            blue "#2323a5"
            magenta "#ad1edc"
            cyan "#42b0c8"
            white "#c8c1c1"
            bright_black "#7b716e"
            bright_red "#ff4141"
            bright_green "#5fff5f"
            bright_yellow "#ffff55"
            bright_blue "#4b4bff"
            bright_magenta "#ff54ff"
            bright_cyan "#69ffff"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#c8c1c1"
            background "#060606"
            emphasis_0 "#ebae1f"
            emphasis_1 "#42b0c8"
            emphasis_2 "#18b218"
            emphasis_3 "#b739e0"
        }
        text_selected {
            base "#060606"
            background "#c8c1c1"
            emphasis_0 "#674c0e"
            emphasis_1 "#215763"
            emphasis_2 "#0d5e0d"
            emphasis_3 "#723885"
        }
        table_cell_unselected {
            base "#c8c1c1"
            background "#060606"
            emphasis_0 "#ebae1f"
            emphasis_1 "#42b0c8"
            emphasis_2 "#18b218"
            emphasis_3 "#b739e0"
        }
        table_cell_selected {
            base "#c8c1c1"
            background "#252525"
            emphasis_0 "#ebae1f"
            emphasis_1 "#42b0c8"
            emphasis_2 "#18b218"
            emphasis_3 "#c560e6"
        }
        list_unselected {
            base "#c8c1c1"
            background "#060606"
            emphasis_0 "#ebae1f"
            emphasis_1 "#42b0c8"
            emphasis_2 "#18b218"
            emphasis_3 "#b739e0"
        }
        list_selected {
            base "#c8c1c1"
            background "#252525"
            emphasis_0 "#ebae1f"
            emphasis_1 "#42b0c8"
            emphasis_2 "#18b218"
            emphasis_3 "#c560e6"
        }
        ribbon_selected {
            base "#060606"
            background "#18b218"
            emphasis_0 "#670e0e"
            emphasis_1 "#402f08"
            emphasis_2 "#530e6a"
            emphasis_3 "#1e1e90"
        }
        ribbon_unselected {
            base "#060606"
            background "#c8c1c1"
            emphasis_0 "#a01616"
            emphasis_1 "#c8c1c1"
            emphasis_2 "#2323a5"
            emphasis_3 "#8217a6"
        }
        table_title {
            base "#18b218"
            background "#060606"
            emphasis_0 "#ebae1f"
            emphasis_1 "#42b0c8"
            emphasis_2 "#18b218"
            emphasis_3 "#b739e0"
        }
        frame_unselected {
            base "#c8c1c1"
            background "#060606"
            emphasis_0 "#c8c1c1"
            emphasis_1 "#c8c1c1"
            emphasis_2 "#c8c1c1"
            emphasis_3 "#c8c1c1"
        }
        frame_selected {
            base "#18b218"
            background "#060606"
            emphasis_0 "#ebae1f"
            emphasis_1 "#42b0c8"
            emphasis_2 "#18b218"
            emphasis_3 "#b739e0"
        }
        frame_highlight {
            base "#ebae1f"
            background "#060606"
            emphasis_0 "#b739e0"
            emphasis_1 "#ebae1f"
            emphasis_2 "#ebae1f"
            emphasis_3 "#ebae1f"
        }
        exit_code_success {
            base "#18b218"
            background "#060606"
            emphasis_0 "#42b0c8"
            emphasis_1 "#c8c1c1"
            emphasis_2 "#b739e0"
            emphasis_3 "#6e6ec4"
        }
        exit_code_error {
            base "#c15555"
            background "#060606"
            emphasis_0 "#ebae1f"
            emphasis_1 "#c8c1c1"
            emphasis_2 "#b739e0"
            emphasis_3 "#6e6ec4"
        }
        multiplayer_user_colors {
            player_1 "#b739e0"
            player_2 "#6e6ec4"
            player_3 "#ff54ff"
            player_4 "#ebae1f"
            player_5 "#42b0c8"
            player_6 "#ffff55"
            player_7 "#c15555"
            player_8 "#c8c1c1"
            player_9 "#ff4141"
            player_10 "#6262ff"
        }
    }
}
