themes {
    "spring" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Spring
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#f3f3f3"
        terminal {
            foreground "#4d4d4c"
            background "#ffffff"
            black "#000000"
            red "#ff4d83"
            green "#1f8c3b"
            yellow "#1fc95b"
            blue "#1dd3ee"
            magenta "#8959a8"
            cyan "#3e999f"
            white "#bfbfbf"
            bright_black "#000000"
            bright_red "#ff0021"
            bright_green "#1fc231"
            bright_yellow "#d5b807"
            bright_blue "#15a9fd"
            bright_magenta "#8959a8"
            bright_cyan "#3e999f"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#4d4d4c"
            background "#ffffff"
            emphasis_0 "#15883e"
            emphasis_1 "#348186"
            emphasis_2 "#1e8839"
            emphasis_3 "#8959a8"
        }
        text_selected {
            base "#ffffff"
            background "#4d4d4c"
            emphasis_0 "#a3c6af"
            emphasis_1 "#a9c2c3"
            emphasis_2 "#a4c5ad"
            emphasis_3 "#c8b7d3"
        }
        table_cell_unselected {
            base "#4d4d4c"
            background "#ffffff"
            emphasis_0 "#15883e"
            emphasis_1 "#348186"
            emphasis_2 "#1e8839"
            emphasis_3 "#8959a8"
        }
        table_cell_selected {
            base "#4d4d4c"
            background "#d6d6d6"
            emphasis_0 "#116b31"
            emphasis_1 "#29666a"
            emphasis_2 "#186b2d"
            emphasis_3 "#764c90"
        }
        list_unselected {
            base "#4d4d4c"
            background "#ffffff"
            emphasis_0 "#15883e"
            emphasis_1 "#348186"
            emphasis_2 "#1e8839"
            emphasis_3 "#8959a8"
        }
        list_selected {
            base "#4d4d4c"
            background "#d6d6d6"
            emphasis_0 "#116b31"
            emphasis_1 "#29666a"
            emphasis_2 "#186b2d"
            emphasis_3 "#764c90"
        }
        ribbon_selected {
            base "#0d0d0d"
            background "#1f8c3b"
            emphasis_0 "#19080d"
            emphasis_1 "#021007"
            emphasis_2 "#110b15"
            emphasis_3 "#020f11"
        }
        ribbon_unselected {
            base "#ffffff"
            background "#4d4d4c"
            emphasis_0 "#ffa3bf"
            emphasis_1 "#4d4d4c"
            emphasis_2 "#1dd3ee"
            emphasis_3 "#cbb6d9"
        }
        table_title {
            base "#1e8839"
            background "#ffffff"
            emphasis_0 "#15883e"
            emphasis_1 "#348186"
            emphasis_2 "#1e8839"
            emphasis_3 "#8959a8"
        }
        frame_unselected {
            base "#4d4d4c"
            background "#ffffff"
            emphasis_0 "#4d4d4c"
            emphasis_1 "#4d4d4c"
            emphasis_2 "#4d4d4c"
            emphasis_3 "#4d4d4c"
        }
        frame_selected {
            base "#1e8839"
            background "#ffffff"
            emphasis_0 "#15883e"
            emphasis_1 "#348186"
            emphasis_2 "#1e8839"
            emphasis_3 "#8959a8"
        }
        frame_highlight {
            base "#15883e"
            background "#ffffff"
            emphasis_0 "#8959a8"
            emphasis_1 "#15883e"
            emphasis_2 "#15883e"
            emphasis_3 "#15883e"
        }
        exit_code_success {
            base "#1e8839"
            background "#ffffff"
            emphasis_0 "#348186"
            emphasis_1 "#4d4d4c"
            emphasis_2 "#8959a8"
            emphasis_3 "#128293"
        }
        exit_code_error {
            base "#d13f6b"
            background "#ffffff"
            emphasis_0 "#15883e"
            emphasis_1 "#4d4d4c"
            emphasis_2 "#8959a8"
            emphasis_3 "#128293"
        }
        multiplayer_user_colors {
            player_1 "#8959a8"
            player_2 "#128293"
            player_3 "#8959a8"
            player_4 "#15883e"
            player_5 "#348186"
            player_6 "#897605"
            player_7 "#d13f6b"
            player_8 "#767676"
            player_9 "#ee001f"
            player_10 "#0f7cba"
        }
    }
}
