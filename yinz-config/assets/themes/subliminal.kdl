themes {
    "subliminal" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Subliminal
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#1c2029"
        terminal {
            foreground "#d4d4d4"
            background "#282c35"
            black "#7f7f7f"
            red "#e15a60"
            green "#a9cfa4"
            yellow "#ffe2a9"
            blue "#6699cc"
            magenta "#f1a5ab"
            cyan "#5fb3b3"
            white "#d4d4d4"
            bright_black "#7f7f7f"
            bright_red "#e15a60"
            bright_green "#a9cfa4"
            bright_yellow "#ffe2a9"
            bright_blue "#6699cc"
            bright_magenta "#f1a5ab"
            bright_cyan "#5fb3b3"
            bright_white "#d4d4d4"
        }
        text_unselected {
            base "#d4d4d4"
            background "#282c35"
            emphasis_0 "#ffe2a9"
            emphasis_1 "#5fb3b3"
            emphasis_2 "#a9cfa4"
            emphasis_3 "#f1a5ab"
        }
        text_selected {
            base "#282c35"
            background "#d4d4d4"
            emphasis_0 "#665a44"
            emphasis_1 "#446161"
            emphasis_2 "#4e604c"
            emphasis_3 "#755356"
        }
        table_cell_unselected {
            base "#d4d4d4"
            background "#282c35"
            emphasis_0 "#ffe2a9"
            emphasis_1 "#5fb3b3"
            emphasis_2 "#a9cfa4"
            emphasis_3 "#f1a5ab"
        }
        table_cell_selected {
            base "#ffffff"
            background "#484e5b"
            emphasis_0 "#ffe2a9"
            emphasis_1 "#8dc9c9"
            emphasis_2 "#a9cfa4"
            emphasis_3 "#f2adb2"
        }
        list_unselected {
            base "#d4d4d4"
            background "#282c35"
            emphasis_0 "#ffe2a9"
            emphasis_1 "#5fb3b3"
            emphasis_2 "#a9cfa4"
            emphasis_3 "#f1a5ab"
        }
        list_selected {
            base "#ffffff"
            background "#484e5b"
            emphasis_0 "#ffe2a9"
            emphasis_1 "#8dc9c9"
            emphasis_2 "#a9cfa4"
            emphasis_3 "#f2adb2"
        }
        ribbon_selected {
            base "#282c35"
            background "#a9cfa4"
            emphasis_0 "#8a373b"
            emphasis_1 "#5b513c"
            emphasis_2 "#6b494c"
            emphasis_3 "#385470"
        }
        ribbon_unselected {
            base "#282c35"
            background "#d4d4d4"
            emphasis_0 "#9a3e42"
            emphasis_1 "#d4d4d4"
            emphasis_2 "#3f5e7e"
            emphasis_3 "#785255"
        }
        table_title {
            base "#a9cfa4"
            background "#282c35"
            emphasis_0 "#ffe2a9"
            emphasis_1 "#5fb3b3"
            emphasis_2 "#a9cfa4"
            emphasis_3 "#f1a5ab"
        }
        frame_unselected {
            base "#d4d4d4"
            background "#282c35"
            emphasis_0 "#d4d4d4"
            emphasis_1 "#d4d4d4"
            emphasis_2 "#d4d4d4"
            emphasis_3 "#d4d4d4"
        }
        frame_selected {
            base "#a9cfa4"
            background "#282c35"
            emphasis_0 "#ffe2a9"
            emphasis_1 "#5fb3b3"
            emphasis_2 "#a9cfa4"
            emphasis_3 "#f1a5ab"
        }
        frame_highlight {
            base "#ffe2a9"
            background "#282c35"
            emphasis_0 "#f1a5ab"
            emphasis_1 "#ffe2a9"
            emphasis_2 "#ffe2a9"
            emphasis_3 "#ffe2a9"
        }
        exit_code_success {
            base "#a9cfa4"
            background "#282c35"
            emphasis_0 "#5fb3b3"
            emphasis_1 "#d4d4d4"
            emphasis_2 "#f1a5ab"
            emphasis_3 "#6699cc"
        }
        exit_code_error {
            base "#e56d73"
            background "#282c35"
            emphasis_0 "#ffe2a9"
            emphasis_1 "#d4d4d4"
            emphasis_2 "#f1a5ab"
            emphasis_3 "#6699cc"
        }
        multiplayer_user_colors {
            player_1 "#f1a5ab"
            player_2 "#6699cc"
            player_3 "#f1a5ab"
            player_4 "#ffe2a9"
            player_5 "#5fb3b3"
            player_6 "#ffe2a9"
            player_7 "#e56d73"
            player_8 "#d4d4d4"
            player_9 "#e56d73"
            player_10 "#6699cc"
        }
    }
}
