themes {
    "kibble" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Kibble
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#020400"
        terminal {
            foreground "#f7f7f7"
            background "#0e100a"
            black "#4d4d4d"
            red "#c70031"
            green "#29cf13"
            yellow "#d8e30e"
            blue "#3449d1"
            magenta "#8400ff"
            cyan "#0798ab"
            white "#e2d1e3"
            bright_black "#5a5a5a"
            bright_red "#f01578"
            bright_green "#6ce05c"
            bright_yellow "#f3f79e"
            bright_blue "#97a4f7"
            bright_magenta "#c495f0"
            bright_cyan "#68f2e0"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#f7f7f7"
            background "#0e100a"
            emphasis_0 "#d8e30e"
            emphasis_1 "#0798ab"
            emphasis_2 "#29cf13"
            emphasis_3 "#a646ff"
        }
        text_selected {
            base "#000000"
            background "#9ba787"
            emphasis_0 "#393c04"
            emphasis_1 "#034048"
            emphasis_2 "#0d4306"
            emphasis_3 "#51009d"
        }
        table_cell_unselected {
            base "#f7f7f7"
            background "#0e100a"
            emphasis_0 "#d8e30e"
            emphasis_1 "#0798ab"
            emphasis_2 "#29cf13"
            emphasis_3 "#a646ff"
        }
        table_cell_selected {
            base "#000000"
            background "#9ba787"
            emphasis_0 "#393c04"
            emphasis_1 "#034048"
            emphasis_2 "#0d4306"
            emphasis_3 "#51009d"
        }
        list_unselected {
            base "#f7f7f7"
            background "#0e100a"
            emphasis_0 "#d8e30e"
            emphasis_1 "#0798ab"
            emphasis_2 "#29cf13"
            emphasis_3 "#a646ff"
        }
        list_selected {
            base "#000000"
            background "#9ba787"
            emphasis_0 "#393c04"
            emphasis_1 "#034048"
            emphasis_2 "#0d4306"
            emphasis_3 "#51009d"
        }
        ribbon_selected {
            base "#0e100a"
            background "#29cf13"
            emphasis_0 "#900024"
            emphasis_1 "#454905"
            emphasis_2 "#6100bb"
            emphasis_3 "#2939a4"
        }
        ribbon_unselected {
            base "#0e100a"
            background "#f7f7f7"
            emphasis_0 "#c70031"
            emphasis_1 "#f7f7f7"
            emphasis_2 "#3449d1"
            emphasis_3 "#8400ff"
        }
        table_title {
            base "#29cf13"
            background "#0e100a"
            emphasis_0 "#d8e30e"
            emphasis_1 "#0798ab"
            emphasis_2 "#29cf13"
            emphasis_3 "#a646ff"
        }
        frame_unselected {
            base "#f7f7f7"
            background "#0e100a"
            emphasis_0 "#f7f7f7"
            emphasis_1 "#f7f7f7"
            emphasis_2 "#f7f7f7"
            emphasis_3 "#f7f7f7"
        }
        frame_selected {
            base "#29cf13"
            background "#0e100a"
            emphasis_0 "#d8e30e"
            emphasis_1 "#0798ab"
            emphasis_2 "#29cf13"
            emphasis_3 "#a646ff"
        }
        frame_highlight {
            base "#d8e30e"
            background "#0e100a"
            emphasis_0 "#a646ff"
            emphasis_1 "#d8e30e"
            emphasis_2 "#d8e30e"
            emphasis_3 "#d8e30e"
        }
        exit_code_success {
            base "#29cf13"
            background "#0e100a"
            emphasis_0 "#0798ab"
            emphasis_1 "#f7f7f7"
            emphasis_2 "#a646ff"
            emphasis_3 "#6172db"
        }
        exit_code_error {
            base "#d6466a"
            background "#0e100a"
            emphasis_0 "#d8e30e"
            emphasis_1 "#f7f7f7"
            emphasis_2 "#a646ff"
            emphasis_3 "#6172db"
        }
        multiplayer_user_colors {
            player_1 "#a646ff"
            player_2 "#6172db"
            player_3 "#c495f0"
            player_4 "#d8e30e"
            player_5 "#0798ab"
            player_6 "#f3f79e"
            player_7 "#d6466a"
            player_8 "#e2d1e3"
            player_9 "#f01578"
            player_10 "#97a4f7"
        }
    }
}
