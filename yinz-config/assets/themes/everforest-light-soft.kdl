themes {
    "everforest-light-soft" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Everforest%20Light%20Soft
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#d9d3b9"
        terminal {
            foreground "#5c6a72"
            background "#e5dfc5"
            black "#7a8478"
            red "#e67e80"
            green "#8da666"
            yellow "#c1a266"
            blue "#72aea6"
            magenta "#c98ca9"
            cyan "#76b385"
            white "#a5a292"
            bright_black "#99a393"
            bright_red "#f85552"
            bright_green "#8da101"
            bright_yellow "#d29300"
            bright_blue "#3a94c5"
            bright_magenta "#df69ba"
            bright_cyan "#35a77c"
            bright_white "#fffbef"
        }
        text_unselected {
            base "#57656c"
            background "#e5dfc5"
            emphasis_0 "#72603c"
            emphasis_1 "#476b50"
            emphasis_2 "#586840"
            emphasis_3 "#7d5769"
        }
        text_selected {
            base "#e5dfc5"
            background "#57656c"
            emphasis_0 "#e3dfd7"
            emphasis_1 "#d9e1db"
            emphasis_2 "#dde0d8"
            emphasis_3 "#e5dde1"
        }
        table_cell_unselected {
            base "#57656c"
            background "#e5dfc5"
            emphasis_0 "#72603c"
            emphasis_1 "#476b50"
            emphasis_2 "#586840"
            emphasis_3 "#7d5769"
        }
        table_cell_selected {
            base "#59666e"
            background "#e1e4bd"
            emphasis_0 "#74613d"
            emphasis_1 "#476c50"
            emphasis_2 "#5a6941"
            emphasis_3 "#80596b"
        }
        list_unselected {
            base "#57656c"
            background "#e5dfc5"
            emphasis_0 "#72603c"
            emphasis_1 "#476b50"
            emphasis_2 "#586840"
            emphasis_3 "#7d5769"
        }
        list_selected {
            base "#59666e"
            background "#e1e4bd"
            emphasis_0 "#74613d"
            emphasis_1 "#476c50"
            emphasis_2 "#5a6941"
            emphasis_3 "#80596b"
        }
        ribbon_selected {
            base "#37352f"
            background "#8da666"
            emphasis_0 "#4f2b2c"
            emphasis_1 "#3e3421"
            emphasis_2 "#442f39"
            emphasis_3 "#263937"
        }
        ribbon_unselected {
            base "#e5dfc5"
            background "#57656c"
            emphasis_0 "#f7d8d8"
            emphasis_1 "#57656c"
            emphasis_2 "#cee3e0"
            emphasis_3 "#eddae3"
        }
        table_title {
            base "#586840"
            background "#e5dfc5"
            emphasis_0 "#72603c"
            emphasis_1 "#476b50"
            emphasis_2 "#586840"
            emphasis_3 "#7d5769"
        }
        frame_unselected {
            base "#57656c"
            background "#e5dfc5"
            emphasis_0 "#57656c"
            emphasis_1 "#57656c"
            emphasis_2 "#57656c"
            emphasis_3 "#57656c"
        }
        frame_selected {
            base "#586840"
            background "#e5dfc5"
            emphasis_0 "#72603c"
            emphasis_1 "#476b50"
            emphasis_2 "#586840"
            emphasis_3 "#7d5769"
        }
        frame_highlight {
            base "#72603c"
            background "#e5dfc5"
            emphasis_0 "#7d5769"
            emphasis_1 "#72603c"
            emphasis_2 "#72603c"
            emphasis_3 "#72603c"
        }
        exit_code_success {
            base "#586840"
            background "#e5dfc5"
            emphasis_0 "#476b50"
            emphasis_1 "#57656c"
            emphasis_2 "#7d5769"
            emphasis_3 "#456964"
        }
        exit_code_error {
            base "#915051"
            background "#e5dfc5"
            emphasis_0 "#72603c"
            emphasis_1 "#57656c"
            emphasis_2 "#7d5769"
            emphasis_3 "#456964"
        }
        multiplayer_user_colors {
            player_1 "#7d5769"
            player_2 "#456964"
            player_3 "#96467d"
            player_4 "#72603c"
            player_5 "#476b50"
            player_6 "#825b00"
            player_7 "#915051"
            player_8 "#656359"
            player_9 "#ad3b39"
            player_10 "#29688b"
        }
    }
}
