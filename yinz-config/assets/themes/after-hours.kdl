themes {
    "after-hours" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/After%20Hours
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#030000"
        terminal {
            foreground "#e6e1d9"
            background "#0f0b0a"
            black "#2a1f1a"
            red "#ff6b6b"
            green "#4ade80"
            yellow "#f59e0b"
            blue "#60a5fa"
            magenta "#c084fc"
            cyan "#2dd4bf"
            white "#cbb89f"
            bright_black "#6b5b4f"
            bright_red "#ff8b8b"
            bright_green "#86efac"
            bright_yellow "#fbbf24"
            bright_blue "#93c5fd"
            bright_magenta "#d8b4fe"
            bright_cyan "#5eead4"
            bright_white "#fdfaf6"
        }
        text_unselected {
            base "#e6e1d9"
            background "#0f0b0a"
            emphasis_0 "#f59e0b"
            emphasis_1 "#2dd4bf"
            emphasis_2 "#4ade80"
            emphasis_3 "#c084fc"
        }
        text_selected {
            base "#0f0b0a"
            background "#e6e1d9"
            emphasis_0 "#8c5a06"
            emphasis_1 "#187065"
            emphasis_2 "#267242"
            emphasis_3 "#79539f"
        }
        table_cell_unselected {
            base "#e6e1d9"
            background "#0f0b0a"
            emphasis_0 "#f59e0b"
            emphasis_1 "#2dd4bf"
            emphasis_2 "#4ade80"
            emphasis_3 "#c084fc"
        }
        table_cell_selected {
            base "#e6e1d9"
            background "#3d2f27"
            emphasis_0 "#f59e0b"
            emphasis_1 "#2dd4bf"
            emphasis_2 "#4ade80"
            emphasis_3 "#c084fc"
        }
        list_unselected {
            base "#e6e1d9"
            background "#0f0b0a"
            emphasis_0 "#f59e0b"
            emphasis_1 "#2dd4bf"
            emphasis_2 "#4ade80"
            emphasis_3 "#c084fc"
        }
        list_selected {
            base "#e6e1d9"
            background "#3d2f27"
            emphasis_0 "#f59e0b"
            emphasis_1 "#2dd4bf"
            emphasis_2 "#4ade80"
            emphasis_3 "#c084fc"
        }
        ribbon_selected {
            base "#0f0b0a"
            background "#4ade80"
            emphasis_0 "#873939"
            emphasis_1 "#714905"
            emphasis_2 "#634481"
            emphasis_3 "#31537e"
        }
        ribbon_unselected {
            base "#0f0b0a"
            background "#e6e1d9"
            emphasis_0 "#a64646"
            emphasis_1 "#e6e1d9"
            emphasis_2 "#3b669b"
            emphasis_3 "#79539f"
        }
        table_title {
            base "#4ade80"
            background "#0f0b0a"
            emphasis_0 "#f59e0b"
            emphasis_1 "#2dd4bf"
            emphasis_2 "#4ade80"
            emphasis_3 "#c084fc"
        }
        frame_unselected {
            base "#e6e1d9"
            background "#0f0b0a"
            emphasis_0 "#e6e1d9"
            emphasis_1 "#e6e1d9"
            emphasis_2 "#e6e1d9"
            emphasis_3 "#e6e1d9"
        }
        frame_selected {
            base "#4ade80"
            background "#0f0b0a"
            emphasis_0 "#f59e0b"
            emphasis_1 "#2dd4bf"
            emphasis_2 "#4ade80"
            emphasis_3 "#c084fc"
        }
        frame_highlight {
            base "#f59e0b"
            background "#0f0b0a"
            emphasis_0 "#c084fc"
            emphasis_1 "#f59e0b"
            emphasis_2 "#f59e0b"
            emphasis_3 "#f59e0b"
        }
        exit_code_success {
            base "#4ade80"
            background "#0f0b0a"
            emphasis_0 "#2dd4bf"
            emphasis_1 "#e6e1d9"
            emphasis_2 "#c084fc"
            emphasis_3 "#60a5fa"
        }
        exit_code_error {
            base "#ff6b6b"
            background "#0f0b0a"
            emphasis_0 "#f59e0b"
            emphasis_1 "#e6e1d9"
            emphasis_2 "#c084fc"
            emphasis_3 "#60a5fa"
        }
        multiplayer_user_colors {
            player_1 "#c084fc"
            player_2 "#60a5fa"
            player_3 "#d8b4fe"
            player_4 "#f59e0b"
            player_5 "#2dd4bf"
            player_6 "#fbbf24"
            player_7 "#ff6b6b"
            player_8 "#cbb89f"
            player_9 "#ff8b8b"
            player_10 "#93c5fd"
        }
    }
}
