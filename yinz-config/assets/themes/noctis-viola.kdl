themes {
    "noctis-viola" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Noctis%20Viola
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#241831"
        terminal {
            foreground "#ccbfd9"
            background "#30243d"
            black "#362f3d"
            red "#e66533"
            green "#49e9a6"
            yellow "#e4b781"
            blue "#49ace9"
            magenta "#df769b"
            cyan "#49d6e9"
            white "#bfafcf"
            bright_black "#594e65"
            bright_red "#e97749"
            bright_green "#60ebb1"
            bright_yellow "#e69533"
            bright_blue "#60b6eb"
            bright_magenta "#e798b3"
            bright_cyan "#60dbeb"
            bright_white "#ccbfd9"
        }
        text_unselected {
            base "#ccbfd9"
            background "#30243d"
            emphasis_0 "#e4b781"
            emphasis_1 "#49d6e9"
            emphasis_2 "#49e9a6"
            emphasis_3 "#df769b"
        }
        text_selected {
            base "#30243d"
            background "#ccbfd9"
            emphasis_0 "#614e37"
            emphasis_1 "#1e5961"
            emphasis_2 "#1d5c42"
            emphasis_3 "#724354"
        }
        table_cell_unselected {
            base "#ccbfd9"
            background "#30243d"
            emphasis_0 "#e4b781"
            emphasis_1 "#49d6e9"
            emphasis_2 "#49e9a6"
            emphasis_3 "#df769b"
        }
        table_cell_selected {
            base "#ccbfd9"
            background "#3e3352"
            emphasis_0 "#e4b781"
            emphasis_1 "#49d6e9"
            emphasis_2 "#49e9a6"
            emphasis_3 "#e285a6"
        }
        list_unselected {
            base "#ccbfd9"
            background "#30243d"
            emphasis_0 "#e4b781"
            emphasis_1 "#49d6e9"
            emphasis_2 "#49e9a6"
            emphasis_3 "#df769b"
        }
        list_selected {
            base "#ccbfd9"
            background "#3e3352"
            emphasis_0 "#e4b781"
            emphasis_1 "#49d6e9"
            emphasis_2 "#49e9a6"
            emphasis_3 "#e285a6"
        }
        ribbon_selected {
            base "#30243d"
            background "#49e9a6"
            emphasis_0 "#924020"
            emphasis_1 "#6a553c"
            emphasis_2 "#83455b"
            emphasis_3 "#285d7e"
        }
        ribbon_unselected {
            base "#30243d"
            background "#ccbfd9"
            emphasis_0 "#863b1e"
            emphasis_1 "#ccbfd9"
            emphasis_2 "#255675"
            emphasis_3 "#783f53"
        }
        table_title {
            base "#49e9a6"
            background "#30243d"
            emphasis_0 "#e4b781"
            emphasis_1 "#49d6e9"
            emphasis_2 "#49e9a6"
            emphasis_3 "#df769b"
        }
        frame_unselected {
            base "#ccbfd9"
            background "#30243d"
            emphasis_0 "#ccbfd9"
            emphasis_1 "#ccbfd9"
            emphasis_2 "#ccbfd9"
            emphasis_3 "#ccbfd9"
        }
        frame_selected {
            base "#49e9a6"
            background "#30243d"
            emphasis_0 "#e4b781"
            emphasis_1 "#49d6e9"
            emphasis_2 "#49e9a6"
            emphasis_3 "#df769b"
        }
        frame_highlight {
            base "#e4b781"
            background "#30243d"
            emphasis_0 "#df769b"
            emphasis_1 "#e4b781"
            emphasis_2 "#e4b781"
            emphasis_3 "#e4b781"
        }
        exit_code_success {
            base "#49e9a6"
            background "#30243d"
            emphasis_0 "#49d6e9"
            emphasis_1 "#ccbfd9"
            emphasis_2 "#df769b"
            emphasis_3 "#49ace9"
        }
        exit_code_error {
            base "#e76a39"
            background "#30243d"
            emphasis_0 "#e4b781"
            emphasis_1 "#ccbfd9"
            emphasis_2 "#df769b"
            emphasis_3 "#49ace9"
        }
        multiplayer_user_colors {
            player_1 "#df769b"
            player_2 "#49ace9"
            player_3 "#e798b3"
            player_4 "#e4b781"
            player_5 "#49d6e9"
            player_6 "#e69533"
            player_7 "#e76a39"
            player_8 "#bfafcf"
            player_9 "#e97749"
            player_10 "#60b6eb"
        }
    }
}
