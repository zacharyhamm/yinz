themes {
    "prickly-pear" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Prickly%20Pear
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#4a042c"
        terminal {
            foreground "#fff0df"
            background "#561038"
            black "#cbb8c2"
            red "#ff8d99"
            green "#78d58e"
            yellow "#f5c54e"
            blue "#9ac4ef"
            magenta "#e49bd2"
            cyan "#7cdbd5"
            white "#fff0df"
            bright_black "#dbcbd2"
            bright_red "#ffa8b0"
            bright_green "#98dfa6"
            bright_yellow "#f9d778"
            bright_blue "#b4d5f4"
            bright_magenta "#edb8df"
            bright_cyan "#9ce7e2"
            bright_white "#fffaf2"
        }
        text_unselected {
            base "#fff0df"
            background "#561038"
            emphasis_0 "#f5c54e"
            emphasis_1 "#7cdbd5"
            emphasis_2 "#78d58e"
            emphasis_3 "#e49bd2"
        }
        text_selected {
            base "#561038"
            background "#fff0df"
            emphasis_0 "#866b2b"
            emphasis_1 "#447774"
            emphasis_2 "#457a51"
            emphasis_3 "#8c6182"
        }
        table_cell_unselected {
            base "#fff0df"
            background "#561038"
            emphasis_0 "#f5c54e"
            emphasis_1 "#7cdbd5"
            emphasis_2 "#78d58e"
            emphasis_3 "#e49bd2"
        }
        table_cell_selected {
            base "#fff7ed"
            background "#7b2853"
            emphasis_0 "#f5c54e"
            emphasis_1 "#7cdbd5"
            emphasis_2 "#78d58e"
            emphasis_3 "#e59fd4"
        }
        list_unselected {
            base "#fff0df"
            background "#561038"
            emphasis_0 "#f5c54e"
            emphasis_1 "#7cdbd5"
            emphasis_2 "#78d58e"
            emphasis_3 "#e49bd2"
        }
        list_selected {
            base "#fff7ed"
            background "#7b2853"
            emphasis_0 "#f5c54e"
            emphasis_1 "#7cdbd5"
            emphasis_2 "#78d58e"
            emphasis_3 "#e59fd4"
        }
        ribbon_selected {
            base "#561038"
            background "#78d58e"
            emphasis_0 "#754146"
            emphasis_1 "#604d1f"
            emphasis_2 "#66455e"
            emphasis_3 "#405163"
        }
        ribbon_unselected {
            base "#561038"
            background "#fff0df"
            emphasis_0 "#a25a61"
            emphasis_1 "#fff0df"
            emphasis_2 "#59718a"
            emphasis_3 "#8d6082"
        }
        table_title {
            base "#78d58e"
            background "#561038"
            emphasis_0 "#f5c54e"
            emphasis_1 "#7cdbd5"
            emphasis_2 "#78d58e"
            emphasis_3 "#e49bd2"
        }
        frame_unselected {
            base "#fff0df"
            background "#561038"
            emphasis_0 "#fff0df"
            emphasis_1 "#fff0df"
            emphasis_2 "#fff0df"
            emphasis_3 "#fff0df"
        }
        frame_selected {
            base "#78d58e"
            background "#561038"
            emphasis_0 "#f5c54e"
            emphasis_1 "#7cdbd5"
            emphasis_2 "#78d58e"
            emphasis_3 "#e49bd2"
        }
        frame_highlight {
            base "#f5c54e"
            background "#561038"
            emphasis_0 "#e49bd2"
            emphasis_1 "#f5c54e"
            emphasis_2 "#f5c54e"
            emphasis_3 "#f5c54e"
        }
        exit_code_success {
            base "#78d58e"
            background "#561038"
            emphasis_0 "#7cdbd5"
            emphasis_1 "#fff0df"
            emphasis_2 "#e49bd2"
            emphasis_3 "#9ac4ef"
        }
        exit_code_error {
            base "#ff8d99"
            background "#561038"
            emphasis_0 "#f5c54e"
            emphasis_1 "#fff0df"
            emphasis_2 "#e49bd2"
            emphasis_3 "#9ac4ef"
        }
        multiplayer_user_colors {
            player_1 "#e49bd2"
            player_2 "#9ac4ef"
            player_3 "#edb8df"
            player_4 "#f5c54e"
            player_5 "#7cdbd5"
            player_6 "#f9d778"
            player_7 "#ff8d99"
            player_8 "#fff0df"
            player_9 "#ffa8b0"
            player_10 "#b4d5f4"
        }
    }
}
