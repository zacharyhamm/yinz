themes {
    iceberg-light {
        // Terminal palette: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/master/ghostty/Iceberg%20Light
        pane_surround "#dcdde0"
        terminal {
            foreground "#33374c"
            background "#e8e9ec"
            black "#dcdfe7"
            red "#cc517a"
            green "#668e3d"
            yellow "#c57339"
            blue "#2d539e"
            magenta "#7759b4"
            cyan "#3f83a6"
            white "#33374c"
            bright_black "#8389a3"
            bright_red "#cc3768"
            bright_green "#598030"
            bright_yellow "#b6662d"
            bright_blue "#22478e"
            bright_magenta "#6845ad"
            bright_cyan "#327698"
            bright_white "#262a3f"
        }
        text_unselected {
            base 51 55 76
            background 220 223 231
            emphasis_0 144 84 41
            emphasis_1 51 105 133
            emphasis_2 45 83 158
            emphasis_3 112 83 169
        }
        text_selected {
            base 220 223 231
            background 51 55 76
            emphasis_0 "#c0997d"
            emphasis_1 "#82a6b8"
            emphasis_2 "#8ca1ca"
            emphasis_3 "#aa98d0"
        }
        ribbon_selected {
            base 220 223 231
            background 45 83 158
            emphasis_0 236 190 205
            emphasis_1 231 196 170
            emphasis_2 208 197 229
            emphasis_3 191 208 174
        }
        ribbon_unselected {
            base 220 223 231
            background 51 55 76
            emphasis_0 220 136 164
            emphasis_1 51 55 76
            emphasis_2 140 170 109
            emphasis_3 171 152 209
        }
        table_title {
            base 45 83 158
            background 0
            emphasis_0 144 84 41
            emphasis_1 51 105 133
            emphasis_2 45 83 158
            emphasis_3 112 83 169
        }
        table_cell_selected {
            base 51 55 76
            background 232 233 236
            emphasis_0 152 89 44
            emphasis_1 54 111 141
            emphasis_2 45 83 158
            emphasis_3 118 88 179
        }
        table_cell_unselected {
            base 51 55 76
            background 220 223 231
            emphasis_0 144 84 41
            emphasis_1 51 105 133
            emphasis_2 45 83 158
            emphasis_3 112 83 169
        }
        list_selected {
            base 51 55 76
            background 232 233 236
            emphasis_0 152 89 44
            emphasis_1 54 111 141
            emphasis_2 45 83 158
            emphasis_3 118 88 179
        }
        list_unselected {
            base 51 55 76
            background 220 223 231
            emphasis_0 144 84 41
            emphasis_1 51 105 133
            emphasis_2 45 83 158
            emphasis_3 112 83 169
        }
        frame_selected {
            base 45 83 158
            background 0
            emphasis_0 144 84 41
            emphasis_1 51 105 133
            emphasis_2 112 83 169
            emphasis_3 0
        }
        frame_highlight {
            base 144 84 41
            background 0
            emphasis_0 112 83 169
            emphasis_1 144 84 41
            emphasis_2 144 84 41
            emphasis_3 144 84 41
        }
        exit_code_success {
            base 45 83 158
            background 0
            emphasis_0 51 105 133
            emphasis_1 97 99 102
            emphasis_2 112 83 169
            emphasis_3 77 107 46
        }
        exit_code_error {
            base 163 65 98
            background 0
            emphasis_0 144 84 42
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 112 83 169
            player_2 77 107 46
            player_3 97 99 102
            player_4 144 84 42
            player_5 51 105 133
            player_6 97 99 102
            player_7 163 65 98
            player_8 97 99 102
            player_9 97 99 102
            player_10 97 99 102
        }
    }
}
