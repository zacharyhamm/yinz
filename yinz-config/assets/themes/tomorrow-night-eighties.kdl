themes {
    "tomorrow-night-eighties" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Tomorrow%20Night%20Eighties
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#212121"
        terminal {
            foreground "#cccccc"
            background "#2d2d2d"
            black "#000000"
            red "#f2777a"
            green "#99cc99"
            yellow "#ffcc66"
            blue "#6699cc"
            magenta "#cc99cc"
            cyan "#66cccc"
            white "#ffffff"
            bright_black "#595959"
            bright_red "#f2777a"
            bright_green "#99cc99"
            bright_yellow "#ffcc66"
            bright_blue "#6699cc"
            bright_magenta "#cc99cc"
            bright_cyan "#66cccc"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#cccccc"
            background "#2d2d2d"
            emphasis_0 "#ffcc66"
            emphasis_1 "#66cccc"
            emphasis_2 "#99cc99"
            emphasis_3 "#cc99cc"
        }
        text_selected {
            base "#2d2d2d"
            background "#cccccc"
            emphasis_0 "#69542a"
            emphasis_1 "#355d5d"
            emphasis_2 "#475c47"
            emphasis_3 "#625262"
        }
        table_cell_unselected {
            base "#cccccc"
            background "#2d2d2d"
            emphasis_0 "#ffcc66"
            emphasis_1 "#66cccc"
            emphasis_2 "#99cc99"
            emphasis_3 "#cc99cc"
        }
        table_cell_selected {
            base "#cccccc"
            background "#515151"
            emphasis_0 "#ffcc66"
            emphasis_1 "#77d2d2"
            emphasis_2 "#a0cfa0"
            emphasis_3 "#dcb8dc"
        }
        list_unselected {
            base "#cccccc"
            background "#2d2d2d"
            emphasis_0 "#ffcc66"
            emphasis_1 "#66cccc"
            emphasis_2 "#99cc99"
            emphasis_3 "#cc99cc"
        }
        list_selected {
            base "#cccccc"
            background "#515151"
            emphasis_0 "#ffcc66"
            emphasis_1 "#77d2d2"
            emphasis_2 "#a0cfa0"
            emphasis_3 "#dcb8dc"
        }
        ribbon_selected {
            base "#2d2d2d"
            background "#99cc99"
            emphasis_0 "#7a3c3e"
            emphasis_1 "#5e4b26"
            emphasis_2 "#5e475e"
            emphasis_3 "#36506b"
        }
        ribbon_unselected {
            base "#2d2d2d"
            background "#cccccc"
            emphasis_0 "#874244"
            emphasis_1 "#cccccc"
            emphasis_2 "#3c5977"
            emphasis_3 "#684e68"
        }
        table_title {
            base "#99cc99"
            background "#2d2d2d"
            emphasis_0 "#ffcc66"
            emphasis_1 "#66cccc"
            emphasis_2 "#99cc99"
            emphasis_3 "#cc99cc"
        }
        frame_unselected {
            base "#cccccc"
            background "#2d2d2d"
            emphasis_0 "#cccccc"
            emphasis_1 "#cccccc"
            emphasis_2 "#cccccc"
            emphasis_3 "#cccccc"
        }
        frame_selected {
            base "#99cc99"
            background "#2d2d2d"
            emphasis_0 "#ffcc66"
            emphasis_1 "#66cccc"
            emphasis_2 "#99cc99"
            emphasis_3 "#cc99cc"
        }
        frame_highlight {
            base "#ffcc66"
            background "#2d2d2d"
            emphasis_0 "#cc99cc"
            emphasis_1 "#ffcc66"
            emphasis_2 "#ffcc66"
            emphasis_3 "#ffcc66"
        }
        exit_code_success {
            base "#99cc99"
            background "#2d2d2d"
            emphasis_0 "#66cccc"
            emphasis_1 "#cccccc"
            emphasis_2 "#cc99cc"
            emphasis_3 "#6699cc"
        }
        exit_code_error {
            base "#f2777a"
            background "#2d2d2d"
            emphasis_0 "#ffcc66"
            emphasis_1 "#cccccc"
            emphasis_2 "#cc99cc"
            emphasis_3 "#6699cc"
        }
        multiplayer_user_colors {
            player_1 "#cc99cc"
            player_2 "#6699cc"
            player_3 "#cc99cc"
            player_4 "#ffcc66"
            player_5 "#66cccc"
            player_6 "#ffcc66"
            player_7 "#f2777a"
            player_8 "#ffffff"
            player_9 "#f2777a"
            player_10 "#6699cc"
        }
    }
}
