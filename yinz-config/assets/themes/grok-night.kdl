themes {
    "grok-night" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Grok%20Night
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#080808"
        terminal {
            foreground "#e1e1e1"
            background "#141414"
            black "#0a0a0a"
            red "#f7768e"
            green "#9ece6a"
            yellow "#e0af68"
            blue "#7aa2f7"
            magenta "#bb9af7"
            cyan "#7dcfff"
            white "#c8c8c8"
            bright_black "#6c6c6c"
            bright_red "#f7768e"
            bright_green "#9ece6a"
            bright_yellow "#e0af68"
            bright_blue "#7aa2f7"
            bright_magenta "#bb9af7"
            bright_cyan "#7dcfff"
            bright_white "#e1e1e1"
        }
        text_unselected {
            base "#e1e1e1"
            background "#141414"
            emphasis_0 "#e0af68"
            emphasis_1 "#7dcfff"
            emphasis_2 "#9ece6a"
            emphasis_3 "#bb9af7"
        }
        text_selected {
            base "#141414"
            background "#e1e1e1"
            emphasis_0 "#7a5f39"
            emphasis_1 "#3f6981"
            emphasis_2 "#526b37"
            emphasis_3 "#6e5b91"
        }
        table_cell_unselected {
            base "#e1e1e1"
            background "#141414"
            emphasis_0 "#e0af68"
            emphasis_1 "#7dcfff"
            emphasis_2 "#9ece6a"
            emphasis_3 "#bb9af7"
        }
        table_cell_selected {
            base "#e1e1e1"
            background "#242424"
            emphasis_0 "#e0af68"
            emphasis_1 "#7dcfff"
            emphasis_2 "#9ece6a"
            emphasis_3 "#bb9af7"
        }
        list_unselected {
            base "#e1e1e1"
            background "#141414"
            emphasis_0 "#e0af68"
            emphasis_1 "#7dcfff"
            emphasis_2 "#9ece6a"
            emphasis_3 "#bb9af7"
        }
        list_selected {
            base "#e1e1e1"
            background "#242424"
            emphasis_0 "#e0af68"
            emphasis_1 "#7dcfff"
            emphasis_2 "#9ece6a"
            emphasis_3 "#bb9af7"
        }
        ribbon_selected {
            base "#141414"
            background "#9ece6a"
            emphasis_0 "#7a3a46"
            emphasis_1 "#614b2d"
            emphasis_2 "#574772"
            emphasis_3 "#3b4e77"
        }
        ribbon_unselected {
            base "#141414"
            background "#e1e1e1"
            emphasis_0 "#9c4b5a"
            emphasis_1 "#e1e1e1"
            emphasis_2 "#4b6397"
            emphasis_3 "#6e5b91"
        }
        table_title {
            base "#9ece6a"
            background "#141414"
            emphasis_0 "#e0af68"
            emphasis_1 "#7dcfff"
            emphasis_2 "#9ece6a"
            emphasis_3 "#bb9af7"
        }
        frame_unselected {
            base "#e1e1e1"
            background "#141414"
            emphasis_0 "#e1e1e1"
            emphasis_1 "#e1e1e1"
            emphasis_2 "#e1e1e1"
            emphasis_3 "#e1e1e1"
        }
        frame_selected {
            base "#9ece6a"
            background "#141414"
            emphasis_0 "#e0af68"
            emphasis_1 "#7dcfff"
            emphasis_2 "#9ece6a"
            emphasis_3 "#bb9af7"
        }
        frame_highlight {
            base "#e0af68"
            background "#141414"
            emphasis_0 "#bb9af7"
            emphasis_1 "#e0af68"
            emphasis_2 "#e0af68"
            emphasis_3 "#e0af68"
        }
        exit_code_success {
            base "#9ece6a"
            background "#141414"
            emphasis_0 "#7dcfff"
            emphasis_1 "#e1e1e1"
            emphasis_2 "#bb9af7"
            emphasis_3 "#7aa2f7"
        }
        exit_code_error {
            base "#f7768e"
            background "#141414"
            emphasis_0 "#e0af68"
            emphasis_1 "#e1e1e1"
            emphasis_2 "#bb9af7"
            emphasis_3 "#7aa2f7"
        }
        multiplayer_user_colors {
            player_1 "#bb9af7"
            player_2 "#7aa2f7"
            player_3 "#bb9af7"
            player_4 "#e0af68"
            player_5 "#7dcfff"
            player_6 "#e0af68"
            player_7 "#f7768e"
            player_8 "#c8c8c8"
            player_9 "#f7768e"
            player_10 "#7aa2f7"
        }
    }
}
