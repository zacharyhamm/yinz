themes {
    "vercel" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Vercel
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#040404"
        terminal {
            foreground "#fafafa"
            background "#101010"
            black "#000000"
            red "#fc0036"
            green "#29a948"
            yellow "#ffae00"
            blue "#006aff"
            magenta "#f32882"
            cyan "#00ac96"
            white "#feffff"
            bright_black "#a8a8a8"
            bright_red "#ff8080"
            bright_green "#4be15d"
            bright_yellow "#ffae00"
            bright_blue "#49aeff"
            bright_magenta "#f97ea8"
            bright_cyan "#00e4c4"
            bright_white "#fefefe"
        }
        text_unselected {
            base "#fafafa"
            background "#101010"
            emphasis_0 "#ffae00"
            emphasis_1 "#00ac96"
            emphasis_2 "#29a948"
            emphasis_3 "#f32882"
        }
        text_selected {
            base "#fafafa"
            background "#005be7"
            emphasis_0 "#ffe19f"
            emphasis_1 "#c4ece7"
            emphasis_2 "#cdebd4"
            emphasis_3 "#fddbea"
        }
        table_cell_unselected {
            base "#fafafa"
            background "#101010"
            emphasis_0 "#ffae00"
            emphasis_1 "#00ac96"
            emphasis_2 "#29a948"
            emphasis_3 "#f32882"
        }
        table_cell_selected {
            base "#fafafa"
            background "#005be7"
            emphasis_0 "#ffe19f"
            emphasis_1 "#c4ece7"
            emphasis_2 "#cdebd4"
            emphasis_3 "#fddbea"
        }
        list_unselected {
            base "#fafafa"
            background "#101010"
            emphasis_0 "#ffae00"
            emphasis_1 "#00ac96"
            emphasis_2 "#29a948"
            emphasis_3 "#f32882"
        }
        list_selected {
            base "#fafafa"
            background "#005be7"
            emphasis_0 "#ffe19f"
            emphasis_1 "#c4ece7"
            emphasis_2 "#cdebd4"
            emphasis_3 "#fddbea"
        }
        ribbon_selected {
            base "#101010"
            background "#29a948"
            emphasis_0 "#610015"
            emphasis_1 "#3c2900"
            emphasis_2 "#580e2f"
            emphasis_3 "#002a66"
        }
        ribbon_unselected {
            base "#101010"
            background "#fafafa"
            emphasis_0 "#e70032"
            emphasis_1 "#fafafa"
            emphasis_2 "#0069fd"
            emphasis_3 "#d92474"
        }
        table_title {
            base "#29a948"
            background "#101010"
            emphasis_0 "#ffae00"
            emphasis_1 "#00ac96"
            emphasis_2 "#29a948"
            emphasis_3 "#f32882"
        }
        frame_unselected {
            base "#fafafa"
            background "#101010"
            emphasis_0 "#fafafa"
            emphasis_1 "#fafafa"
            emphasis_2 "#fafafa"
            emphasis_3 "#fafafa"
        }
        frame_selected {
            base "#29a948"
            background "#101010"
            emphasis_0 "#ffae00"
            emphasis_1 "#00ac96"
            emphasis_2 "#29a948"
            emphasis_3 "#f32882"
        }
        frame_highlight {
            base "#ffae00"
            background "#101010"
            emphasis_0 "#f32882"
            emphasis_1 "#ffae00"
            emphasis_2 "#ffae00"
            emphasis_3 "#ffae00"
        }
        exit_code_success {
            base "#29a948"
            background "#101010"
            emphasis_0 "#00ac96"
            emphasis_1 "#fafafa"
            emphasis_2 "#f32882"
            emphasis_3 "#1275ff"
        }
        exit_code_error {
            base "#fc0036"
            background "#101010"
            emphasis_0 "#ffae00"
            emphasis_1 "#fafafa"
            emphasis_2 "#f32882"
            emphasis_3 "#1275ff"
        }
        multiplayer_user_colors {
            player_1 "#f32882"
            player_2 "#1275ff"
            player_3 "#f97ea8"
            player_4 "#ffae00"
            player_5 "#00ac96"
            player_6 "#ffae00"
            player_7 "#fc0036"
            player_8 "#feffff"
            player_9 "#ff8080"
            player_10 "#49aeff"
        }
    }
}
