themes {
    "frostline" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Frostline
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#ebeff3"
        terminal {
            foreground "#102a43"
            background "#f7fbff"
            black "#29394a"
            red "#812121"
            green "#0b5934"
            yellow "#654a00"
            blue "#164891"
            magenta "#5c3189"
            cyan "#00596a"
            white "#3b4a59"
            bright_black "#536273"
            bright_red "#8d2727"
            bright_green "#0e603a"
            bright_yellow "#6c5000"
            bright_blue "#194f9d"
            bright_magenta "#653991"
            bright_cyan "#006173"
            bright_white "#455565"
        }
        text_unselected {
            base "#102a43"
            background "#f7fbff"
            emphasis_0 "#654a00"
            emphasis_1 "#00596a"
            emphasis_2 "#0b5934"
            emphasis_3 "#5c3189"
        }
        text_selected {
            base "#f7fbff"
            background "#102a43"
            emphasis_0 "#9f8e60"
            emphasis_1 "#6198a3"
            emphasis_2 "#699982"
            emphasis_3 "#9e84b9"
        }
        table_cell_unselected {
            base "#102a43"
            background "#f7fbff"
            emphasis_0 "#654a00"
            emphasis_1 "#00596a"
            emphasis_2 "#0b5934"
            emphasis_3 "#5c3189"
        }
        table_cell_selected {
            base "#102a43"
            background "#e2edf7"
            emphasis_0 "#654a00"
            emphasis_1 "#00596a"
            emphasis_2 "#0b5934"
            emphasis_3 "#5c3189"
        }
        list_unselected {
            base "#102a43"
            background "#f7fbff"
            emphasis_0 "#654a00"
            emphasis_1 "#00596a"
            emphasis_2 "#0b5934"
            emphasis_3 "#5c3189"
        }
        list_selected {
            base "#102a43"
            background "#e2edf7"
            emphasis_0 "#654a00"
            emphasis_1 "#00596a"
            emphasis_2 "#0b5934"
            emphasis_3 "#5c3189"
        }
        ribbon_selected {
            base "#f7fbff"
            background "#0b5934"
            emphasis_0 "#d6b7b7"
            emphasis_1 "#c7bda2"
            emphasis_2 "#c7b8d6"
            emphasis_3 "#aebfd9"
        }
        ribbon_unselected {
            base "#f7fbff"
            background "#102a43"
            emphasis_0 "#b78181"
            emphasis_1 "#102a43"
            emphasis_2 "#7391bd"
            emphasis_3 "#9e84b9"
        }
        table_title {
            base "#0b5934"
            background "#f7fbff"
            emphasis_0 "#654a00"
            emphasis_1 "#00596a"
            emphasis_2 "#0b5934"
            emphasis_3 "#5c3189"
        }
        frame_unselected {
            base "#102a43"
            background "#f7fbff"
            emphasis_0 "#102a43"
            emphasis_1 "#102a43"
            emphasis_2 "#102a43"
            emphasis_3 "#102a43"
        }
        frame_selected {
            base "#0b5934"
            background "#f7fbff"
            emphasis_0 "#654a00"
            emphasis_1 "#00596a"
            emphasis_2 "#0b5934"
            emphasis_3 "#5c3189"
        }
        frame_highlight {
            base "#654a00"
            background "#f7fbff"
            emphasis_0 "#5c3189"
            emphasis_1 "#654a00"
            emphasis_2 "#654a00"
            emphasis_3 "#654a00"
        }
        exit_code_success {
            base "#0b5934"
            background "#f7fbff"
            emphasis_0 "#00596a"
            emphasis_1 "#102a43"
            emphasis_2 "#5c3189"
            emphasis_3 "#164891"
        }
        exit_code_error {
            base "#812121"
            background "#f7fbff"
            emphasis_0 "#654a00"
            emphasis_1 "#102a43"
            emphasis_2 "#5c3189"
            emphasis_3 "#164891"
        }
        multiplayer_user_colors {
            player_1 "#5c3189"
            player_2 "#164891"
            player_3 "#653991"
            player_4 "#654a00"
            player_5 "#00596a"
            player_6 "#6c5000"
            player_7 "#812121"
            player_8 "#3b4a59"
            player_9 "#8d2727"
            player_10 "#194f9d"
        }
    }
}
