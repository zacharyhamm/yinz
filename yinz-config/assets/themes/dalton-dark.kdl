themes {
    "dalton-dark" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Dalton%20Dark
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#0f0f0f"
        terminal {
            foreground "#c8c9cc"
            background "#1b1b1b"
            black "#282828"
            red "#d85050"
            green "#5b914e"
            yellow "#c4c40c"
            blue "#7aa2f7"
            magenta "#a050d0"
            cyan "#56717f"
            white "#b8b8b8"
            bright_black "#494949"
            bright_red "#f07068"
            bright_green "#88b97d"
            bright_yellow "#eded02"
            bright_blue "#97b1f1"
            bright_magenta "#c070f0"
            bright_cyan "#6691a7"
            bright_white "#d8d8d8"
        }
        text_unselected {
            base "#c8c9cc"
            background "#1b1b1b"
            emphasis_0 "#c4c40c"
            emphasis_1 "#6f8692"
            emphasis_2 "#5b914e"
            emphasis_3 "#ab64d5"
        }
        text_selected {
            base "#1b1b1b"
            background "#c8c9cc"
            emphasis_0 "#585805"
            emphasis_1 "#435863"
            emphasis_2 "#3b5d32"
            emphasis_3 "#753a98"
        }
        table_cell_unselected {
            base "#c8c9cc"
            background "#1b1b1b"
            emphasis_0 "#c4c40c"
            emphasis_1 "#6f8692"
            emphasis_2 "#5b914e"
            emphasis_3 "#ab64d5"
        }
        table_cell_selected {
            base "#1b1b1b"
            background "#c8c9cc"
            emphasis_0 "#585805"
            emphasis_1 "#435863"
            emphasis_2 "#3b5d32"
            emphasis_3 "#753a98"
        }
        list_unselected {
            base "#c8c9cc"
            background "#1b1b1b"
            emphasis_0 "#c4c40c"
            emphasis_1 "#6f8692"
            emphasis_2 "#5b914e"
            emphasis_3 "#ab64d5"
        }
        list_selected {
            base "#1b1b1b"
            background "#c8c9cc"
            emphasis_0 "#585805"
            emphasis_1 "#435863"
            emphasis_2 "#3b5d32"
            emphasis_3 "#753a98"
        }
        ribbon_selected {
            base "#1b1b1b"
            background "#5b914e"
            emphasis_0 "#331313"
            emphasis_1 "#1e1e02"
            emphasis_2 "#281434"
            emphasis_3 "#151c2b"
        }
        ribbon_unselected {
            base "#1b1b1b"
            background "#c8c9cc"
            emphasis_0 "#923636"
            emphasis_1 "#c8c9cc"
            emphasis_2 "#405481"
            emphasis_3 "#753a98"
        }
        table_title {
            base "#5b914e"
            background "#1b1b1b"
            emphasis_0 "#c4c40c"
            emphasis_1 "#6f8692"
            emphasis_2 "#5b914e"
            emphasis_3 "#ab64d5"
        }
        frame_unselected {
            base "#c8c9cc"
            background "#1b1b1b"
            emphasis_0 "#c8c9cc"
            emphasis_1 "#c8c9cc"
            emphasis_2 "#c8c9cc"
            emphasis_3 "#c8c9cc"
        }
        frame_selected {
            base "#5b914e"
            background "#1b1b1b"
            emphasis_0 "#c4c40c"
            emphasis_1 "#6f8692"
            emphasis_2 "#5b914e"
            emphasis_3 "#ab64d5"
        }
        frame_highlight {
            base "#c4c40c"
            background "#1b1b1b"
            emphasis_0 "#ab64d5"
            emphasis_1 "#c4c40c"
            emphasis_2 "#c4c40c"
            emphasis_3 "#c4c40c"
        }
        exit_code_success {
            base "#5b914e"
            background "#1b1b1b"
            emphasis_0 "#6f8692"
            emphasis_1 "#c8c9cc"
            emphasis_2 "#ab64d5"
            emphasis_3 "#7aa2f7"
        }
        exit_code_error {
            base "#da5858"
            background "#1b1b1b"
            emphasis_0 "#c4c40c"
            emphasis_1 "#c8c9cc"
            emphasis_2 "#ab64d5"
            emphasis_3 "#7aa2f7"
        }
        multiplayer_user_colors {
            player_1 "#ab64d5"
            player_2 "#7aa2f7"
            player_3 "#c070f0"
            player_4 "#c4c40c"
            player_5 "#6f8692"
            player_6 "#eded02"
            player_7 "#da5858"
            player_8 "#b8b8b8"
            player_9 "#f07068"
            player_10 "#97b1f1"
        }
    }
}
