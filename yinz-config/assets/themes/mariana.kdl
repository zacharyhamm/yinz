themes {
    "mariana" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Mariana
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#28313a"
        terminal {
            foreground "#d8dee9"
            background "#343d46"
            black "#000000"
            red "#ec5f66"
            green "#99c794"
            yellow "#f9ae58"
            blue "#6699cc"
            magenta "#c695c6"
            cyan "#5fb4b4"
            white "#f7f7f7"
            bright_black "#666666"
            bright_red "#f97b58"
            bright_green "#acd1a8"
            bright_yellow "#fac761"
            bright_blue "#85add6"
            bright_magenta "#d8b6d8"
            bright_cyan "#82c4c4"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#d8dee9"
            background "#343d46"
            emphasis_0 "#f9ae58"
            emphasis_1 "#5fb4b4"
            emphasis_2 "#99c794"
            emphasis_3 "#c696c6"
        }
        text_selected {
            base "#343d46"
            background "#d8dee9"
            emphasis_0 "#775d40"
            emphasis_1 "#506666"
            emphasis_2 "#576655"
            emphasis_3 "#6b5e6b"
        }
        table_cell_unselected {
            base "#d8dee9"
            background "#343d46"
            emphasis_0 "#f9ae58"
            emphasis_1 "#5fb4b4"
            emphasis_2 "#99c794"
            emphasis_3 "#c696c6"
        }
        table_cell_selected {
            base "#d8dee9"
            background "#4e5a65"
            emphasis_0 "#fbc586"
            emphasis_1 "#a9d7d7"
            emphasis_2 "#b7d7b3"
            emphasis_3 "#e1c7e1"
        }
        list_unselected {
            base "#d8dee9"
            background "#343d46"
            emphasis_0 "#f9ae58"
            emphasis_1 "#5fb4b4"
            emphasis_2 "#99c794"
            emphasis_3 "#c696c6"
        }
        list_selected {
            base "#d8dee9"
            background "#4e5a65"
            emphasis_0 "#fbc586"
            emphasis_1 "#a9d7d7"
            emphasis_2 "#b7d7b3"
            emphasis_3 "#e1c7e1"
        }
        ribbon_selected {
            base "#343d46"
            background "#99c794"
            emphasis_0 "#7f3337"
            emphasis_1 "#634523"
            emphasis_2 "#5b445b"
            emphasis_3 "#344d67"
        }
        ribbon_unselected {
            base "#343d46"
            background "#d8dee9"
            emphasis_0 "#a44247"
            emphasis_1 "#d8dee9"
            emphasis_2 "#436586"
            emphasis_3 "#755875"
        }
        table_title {
            base "#99c794"
            background "#343d46"
            emphasis_0 "#f9ae58"
            emphasis_1 "#5fb4b4"
            emphasis_2 "#99c794"
            emphasis_3 "#c696c6"
        }
        frame_unselected {
            base "#d8dee9"
            background "#343d46"
            emphasis_0 "#d8dee9"
            emphasis_1 "#d8dee9"
            emphasis_2 "#d8dee9"
            emphasis_3 "#d8dee9"
        }
        frame_selected {
            base "#99c794"
            background "#343d46"
            emphasis_0 "#f9ae58"
            emphasis_1 "#5fb4b4"
            emphasis_2 "#99c794"
            emphasis_3 "#c696c6"
        }
        frame_highlight {
            base "#f9ae58"
            background "#343d46"
            emphasis_0 "#c696c6"
            emphasis_1 "#f9ae58"
            emphasis_2 "#f9ae58"
            emphasis_3 "#f9ae58"
        }
        exit_code_success {
            base "#99c794"
            background "#343d46"
            emphasis_0 "#5fb4b4"
            emphasis_1 "#d8dee9"
            emphasis_2 "#c696c6"
            emphasis_3 "#7faad4"
        }
        exit_code_error {
            base "#f1878c"
            background "#343d46"
            emphasis_0 "#f9ae58"
            emphasis_1 "#d8dee9"
            emphasis_2 "#c696c6"
            emphasis_3 "#7faad4"
        }
        multiplayer_user_colors {
            player_1 "#c696c6"
            player_2 "#7faad4"
            player_3 "#d8b6d8"
            player_4 "#f9ae58"
            player_5 "#5fb4b4"
            player_6 "#fac761"
            player_7 "#f1878c"
            player_8 "#f7f7f7"
            player_9 "#f98564"
            player_10 "#85add6"
        }
    }
}
