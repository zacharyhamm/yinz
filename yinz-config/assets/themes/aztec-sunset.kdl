themes {
    "aztec-sunset" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Aztec%20Sunset
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#0f000c"
        terminal {
            foreground "#ffe6c7"
            background "#1b0c18"
            black "#a9a19f"
            red "#f47c62"
            green "#67c894"
            yellow "#e9bd59"
            blue "#72c6c2"
            magenta "#e778a8"
            cyan "#65d5d0"
            white "#ffe6c7"
            bright_black "#c0b4b0"
            bright_red "#ff986d"
            bright_green "#86d7a8"
            bright_yellow "#ffd071"
            bright_blue "#8bd8d2"
            bright_magenta "#f194bd"
            bright_cyan "#89e2dc"
            bright_white "#fff4df"
        }
        text_unselected {
            base "#ffe6c7"
            background "#1b0c18"
            emphasis_0 "#e9bd59"
            emphasis_1 "#65d5d0"
            emphasis_2 "#67c894"
            emphasis_3 "#e778a8"
        }
        text_selected {
            base "#1b0c18"
            background "#ffe6c7"
            emphasis_0 "#7e6630"
            emphasis_1 "#377371"
            emphasis_2 "#3e7457"
            emphasis_3 "#895d70"
        }
        table_cell_unselected {
            base "#ffe6c7"
            background "#1b0c18"
            emphasis_0 "#e9bd59"
            emphasis_1 "#65d5d0"
            emphasis_2 "#67c894"
            emphasis_3 "#e778a8"
        }
        table_cell_selected {
            base "#fff0d8"
            background "#743829"
            emphasis_0 "#e9bd59"
            emphasis_1 "#65d5d0"
            emphasis_2 "#6cca97"
            emphasis_3 "#eea2c3"
        }
        list_unselected {
            base "#ffe6c7"
            background "#1b0c18"
            emphasis_0 "#e9bd59"
            emphasis_1 "#65d5d0"
            emphasis_2 "#67c894"
            emphasis_3 "#e778a8"
        }
        list_selected {
            base "#fff0d8"
            background "#743829"
            emphasis_0 "#e9bd59"
            emphasis_1 "#65d5d0"
            emphasis_2 "#6cca97"
            emphasis_3 "#eea2c3"
        }
        ribbon_selected {
            base "#1b0c18"
            background "#67c894"
            emphasis_0 "#6f382d"
            emphasis_1 "#554520"
            emphasis_2 "#6a374d"
            emphasis_3 "#2c4d4b"
        }
        ribbon_unselected {
            base "#1b0c18"
            background "#ffe6c7"
            emphasis_0 "#a25241"
            emphasis_1 "#ffe6c7"
            emphasis_2 "#41716f"
            emphasis_3 "#9d5172"
        }
        table_title {
            base "#67c894"
            background "#1b0c18"
            emphasis_0 "#e9bd59"
            emphasis_1 "#65d5d0"
            emphasis_2 "#67c894"
            emphasis_3 "#e778a8"
        }
        frame_unselected {
            base "#ffe6c7"
            background "#1b0c18"
            emphasis_0 "#ffe6c7"
            emphasis_1 "#ffe6c7"
            emphasis_2 "#ffe6c7"
            emphasis_3 "#ffe6c7"
        }
        frame_selected {
            base "#67c894"
            background "#1b0c18"
            emphasis_0 "#e9bd59"
            emphasis_1 "#65d5d0"
            emphasis_2 "#67c894"
            emphasis_3 "#e778a8"
        }
        frame_highlight {
            base "#e9bd59"
            background "#1b0c18"
            emphasis_0 "#e778a8"
            emphasis_1 "#e9bd59"
            emphasis_2 "#e9bd59"
            emphasis_3 "#e9bd59"
        }
        exit_code_success {
            base "#67c894"
            background "#1b0c18"
            emphasis_0 "#65d5d0"
            emphasis_1 "#ffe6c7"
            emphasis_2 "#e778a8"
            emphasis_3 "#72c6c2"
        }
        exit_code_error {
            base "#f47c62"
            background "#1b0c18"
            emphasis_0 "#e9bd59"
            emphasis_1 "#ffe6c7"
            emphasis_2 "#e778a8"
            emphasis_3 "#72c6c2"
        }
        multiplayer_user_colors {
            player_1 "#e778a8"
            player_2 "#72c6c2"
            player_3 "#f194bd"
            player_4 "#e9bd59"
            player_5 "#65d5d0"
            player_6 "#ffd071"
            player_7 "#f47c62"
            player_8 "#ffe6c7"
            player_9 "#ff986d"
            player_10 "#8bd8d2"
        }
    }
}
