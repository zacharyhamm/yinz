themes {
    "peppermint" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Peppermint
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000000"
        terminal {
            foreground "#c8c8c8"
            background "#000000"
            black "#353535"
            red "#e74669"
            green "#89d287"
            yellow "#dab853"
            blue "#449fd0"
            magenta "#da62dc"
            cyan "#65aaaf"
            white "#b4b4b4"
            bright_black "#535353"
            bright_red "#e4859b"
            bright_green "#a3cca2"
            bright_yellow "#e1e487"
            bright_blue "#6fbce2"
            bright_magenta "#e586e7"
            bright_cyan "#96dcdb"
            bright_white "#dfdfdf"
        }
        text_unselected {
            base "#c8c8c8"
            background "#000000"
            emphasis_0 "#dab853"
            emphasis_1 "#65aaaf"
            emphasis_2 "#89d287"
            emphasis_3 "#da62dc"
        }
        text_selected {
            base "#000000"
            background "#e6e6e6"
            emphasis_0 "#78652e"
            emphasis_1 "#416e71"
            emphasis_2 "#497048"
            emphasis_3 "#9a459b"
        }
        table_cell_unselected {
            base "#c8c8c8"
            background "#000000"
            emphasis_0 "#dab853"
            emphasis_1 "#65aaaf"
            emphasis_2 "#89d287"
            emphasis_3 "#da62dc"
        }
        table_cell_selected {
            base "#000000"
            background "#e6e6e6"
            emphasis_0 "#78652e"
            emphasis_1 "#416e71"
            emphasis_2 "#497048"
            emphasis_3 "#9a459b"
        }
        list_unselected {
            base "#c8c8c8"
            background "#000000"
            emphasis_0 "#dab853"
            emphasis_1 "#65aaaf"
            emphasis_2 "#89d287"
            emphasis_3 "#da62dc"
        }
        list_selected {
            base "#000000"
            background "#e6e6e6"
            emphasis_0 "#78652e"
            emphasis_1 "#416e71"
            emphasis_2 "#497048"
            emphasis_3 "#9a459b"
        }
        ribbon_selected {
            base "#000000"
            background "#89d287"
            emphasis_0 "#8e2b41"
            emphasis_1 "#5c4e23"
            emphasis_2 "#773578"
            emphasis_3 "#24546e"
        }
        ribbon_unselected {
            base "#000000"
            background "#c8c8c8"
            emphasis_0 "#962e44"
            emphasis_1 "#c8c8c8"
            emphasis_2 "#265975"
            emphasis_3 "#7e387f"
        }
        table_title {
            base "#89d287"
            background "#000000"
            emphasis_0 "#dab853"
            emphasis_1 "#65aaaf"
            emphasis_2 "#89d287"
            emphasis_3 "#da62dc"
        }
        frame_unselected {
            base "#c8c8c8"
            background "#000000"
            emphasis_0 "#c8c8c8"
            emphasis_1 "#c8c8c8"
            emphasis_2 "#c8c8c8"
            emphasis_3 "#c8c8c8"
        }
        frame_selected {
            base "#89d287"
            background "#000000"
            emphasis_0 "#dab853"
            emphasis_1 "#65aaaf"
            emphasis_2 "#89d287"
            emphasis_3 "#da62dc"
        }
        frame_highlight {
            base "#dab853"
            background "#000000"
            emphasis_0 "#da62dc"
            emphasis_1 "#dab853"
            emphasis_2 "#dab853"
            emphasis_3 "#dab853"
        }
        exit_code_success {
            base "#89d287"
            background "#000000"
            emphasis_0 "#65aaaf"
            emphasis_1 "#c8c8c8"
            emphasis_2 "#da62dc"
            emphasis_3 "#449fd0"
        }
        exit_code_error {
            base "#e74669"
            background "#000000"
            emphasis_0 "#dab853"
            emphasis_1 "#c8c8c8"
            emphasis_2 "#da62dc"
            emphasis_3 "#449fd0"
        }
        multiplayer_user_colors {
            player_1 "#da62dc"
            player_2 "#449fd0"
            player_3 "#e586e7"
            player_4 "#dab853"
            player_5 "#65aaaf"
            player_6 "#e1e487"
            player_7 "#e74669"
            player_8 "#b4b4b4"
            player_9 "#e4859b"
            player_10 "#6fbce2"
        }
    }
}
