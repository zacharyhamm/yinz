themes {
    "novel" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Novel
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#d3cfb7"
        terminal {
            foreground "#3b2322"
            background "#dfdbc3"
            black "#000000"
            red "#cc0000"
            green "#009600"
            yellow "#d06b00"
            blue "#0000cc"
            magenta "#cc00cc"
            cyan "#0087cc"
            white "#a6a6a6"
            bright_black "#808080"
            bright_red "#cc0000"
            bright_green "#009600"
            bright_yellow "#d06b00"
            bright_blue "#0000cc"
            bright_magenta "#cc00cc"
            bright_cyan "#0087cc"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#3b2322"
            background "#dfdbc3"
            emphasis_0 "#954d00"
            emphasis_1 "#006599"
            emphasis_2 "#007000"
            emphasis_3 "#ab00ab"
        }
        text_selected {
            base "#dfdbc3"
            background "#3b2322"
            emphasis_0 "#a48c73"
            emphasis_1 "#7495a7"
            emphasis_2 "#749974"
            emphasis_3 "#b47eb4"
        }
        table_cell_unselected {
            base "#3b2322"
            background "#dfdbc3"
            emphasis_0 "#954d00"
            emphasis_1 "#006599"
            emphasis_2 "#007000"
            emphasis_3 "#ab00ab"
        }
        table_cell_selected {
            base "#000000"
            background "#a4a390"
            emphasis_0 "#5a2e00"
            emphasis_1 "#003d5d"
            emphasis_2 "#004300"
            emphasis_3 "#6a006a"
        }
        list_unselected {
            base "#3b2322"
            background "#dfdbc3"
            emphasis_0 "#954d00"
            emphasis_1 "#006599"
            emphasis_2 "#007000"
            emphasis_3 "#ab00ab"
        }
        list_selected {
            base "#000000"
            background "#a4a390"
            emphasis_0 "#5a2e00"
            emphasis_1 "#003d5d"
            emphasis_2 "#004300"
            emphasis_3 "#6a006a"
        }
        ribbon_selected {
            base "#181815"
            background "#009600"
            emphasis_0 "#3b0000"
            emphasis_1 "#271400"
            emphasis_2 "#330033"
            emphasis_3 "#000065"
        }
        ribbon_unselected {
            base "#dfdbc3"
            background "#3b2322"
            emphasis_0 "#e26c6c"
            emphasis_1 "#3b2322"
            emphasis_2 "#8686e7"
            emphasis_3 "#de58de"
        }
        table_title {
            base "#007000"
            background "#dfdbc3"
            emphasis_0 "#954d00"
            emphasis_1 "#006599"
            emphasis_2 "#007000"
            emphasis_3 "#ab00ab"
        }
        frame_unselected {
            base "#3b2322"
            background "#dfdbc3"
            emphasis_0 "#3b2322"
            emphasis_1 "#3b2322"
            emphasis_2 "#3b2322"
            emphasis_3 "#3b2322"
        }
        frame_selected {
            base "#007000"
            background "#dfdbc3"
            emphasis_0 "#954d00"
            emphasis_1 "#006599"
            emphasis_2 "#007000"
            emphasis_3 "#ab00ab"
        }
        frame_highlight {
            base "#954d00"
            background "#dfdbc3"
            emphasis_0 "#ab00ab"
            emphasis_1 "#954d00"
            emphasis_2 "#954d00"
            emphasis_3 "#954d00"
        }
        exit_code_success {
            base "#007000"
            background "#dfdbc3"
            emphasis_0 "#006599"
            emphasis_1 "#3b2322"
            emphasis_2 "#ab00ab"
            emphasis_3 "#0000cc"
        }
        exit_code_error {
            base "#c30000"
            background "#dfdbc3"
            emphasis_0 "#954d00"
            emphasis_1 "#3b2322"
            emphasis_2 "#ab00ab"
            emphasis_3 "#0000cc"
        }
        multiplayer_user_colors {
            player_1 "#ab00ab"
            player_2 "#0000cc"
            player_3 "#ab00ab"
            player_4 "#954d00"
            player_5 "#006599"
            player_6 "#954d00"
            player_7 "#c30000"
            player_8 "#606060"
            player_9 "#c30000"
            player_10 "#0000cc"
        }
    }
}
