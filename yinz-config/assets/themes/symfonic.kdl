themes {
    "symfonic" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Symfonic
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000000"
        terminal {
            foreground "#ffffff"
            background "#000000"
            black "#000000"
            red "#dc322f"
            green "#56db3a"
            yellow "#ff8400"
            blue "#0084d4"
            magenta "#b729d9"
            cyan "#ccccff"
            white "#ffffff"
            bright_black "#414347"
            bright_red "#dc322f"
            bright_green "#56db3a"
            bright_yellow "#ff8400"
            bright_blue "#0084d4"
            bright_magenta "#b729d9"
            bright_cyan "#ccccff"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#ffffff"
            background "#000000"
            emphasis_0 "#ff8400"
            emphasis_1 "#ccccff"
            emphasis_2 "#56db3a"
            emphasis_3 "#ba31da"
        }
        text_selected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#b75f00"
            emphasis_1 "#747491"
            emphasis_2 "#358724"
            emphasis_3 "#a25ab3"
        }
        table_cell_unselected {
            base "#ffffff"
            background "#000000"
            emphasis_0 "#ff8400"
            emphasis_1 "#ccccff"
            emphasis_2 "#56db3a"
            emphasis_3 "#ba31da"
        }
        table_cell_selected {
            base "#ffffff"
            background "#073642"
            emphasis_0 "#ff8400"
            emphasis_1 "#ccccff"
            emphasis_2 "#56db3a"
            emphasis_3 "#d073e6"
        }
        list_unselected {
            base "#ffffff"
            background "#000000"
            emphasis_0 "#ff8400"
            emphasis_1 "#ccccff"
            emphasis_2 "#56db3a"
            emphasis_3 "#ba31da"
        }
        list_selected {
            base "#ffffff"
            background "#073642"
            emphasis_0 "#ff8400"
            emphasis_1 "#ccccff"
            emphasis_2 "#56db3a"
            emphasis_3 "#d073e6"
        }
        ribbon_selected {
            base "#000000"
            background "#56db3a"
            emphasis_0 "#972220"
            emphasis_1 "#7a3f00"
            emphasis_2 "#811d99"
            emphasis_3 "#005284"
        }
        ribbon_unselected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#dc322f"
            emphasis_1 "#ffffff"
            emphasis_2 "#007bc6"
            emphasis_3 "#b729d9"
        }
        table_title {
            base "#56db3a"
            background "#000000"
            emphasis_0 "#ff8400"
            emphasis_1 "#ccccff"
            emphasis_2 "#56db3a"
            emphasis_3 "#ba31da"
        }
        frame_unselected {
            base "#ffffff"
            background "#000000"
            emphasis_0 "#ffffff"
            emphasis_1 "#ffffff"
            emphasis_2 "#ffffff"
            emphasis_3 "#ffffff"
        }
        frame_selected {
            base "#56db3a"
            background "#000000"
            emphasis_0 "#ff8400"
            emphasis_1 "#ccccff"
            emphasis_2 "#56db3a"
            emphasis_3 "#ba31da"
        }
        frame_highlight {
            base "#ff8400"
            background "#000000"
            emphasis_0 "#ba31da"
            emphasis_1 "#ff8400"
            emphasis_2 "#ff8400"
            emphasis_3 "#ff8400"
        }
        exit_code_success {
            base "#56db3a"
            background "#000000"
            emphasis_0 "#ccccff"
            emphasis_1 "#ffffff"
            emphasis_2 "#ba31da"
            emphasis_3 "#0084d4"
        }
        exit_code_error {
            base "#dc322f"
            background "#000000"
            emphasis_0 "#ff8400"
            emphasis_1 "#ffffff"
            emphasis_2 "#ba31da"
            emphasis_3 "#0084d4"
        }
        multiplayer_user_colors {
            player_1 "#ba31da"
            player_2 "#0084d4"
            player_3 "#ba31da"
            player_4 "#ff8400"
            player_5 "#ccccff"
            player_6 "#ff8400"
            player_7 "#dc322f"
            player_8 "#ffffff"
            player_9 "#dc322f"
            player_10 "#0084d4"
        }
    }
}
