themes {
    "alien-blood" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Alien%20Blood
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#030a04"
        terminal {
            foreground "#637d75"
            background "#0f1610"
            black "#112616"
            red "#7f2b27"
            green "#2f7e25"
            yellow "#717f24"
            blue "#2f6a7f"
            magenta "#47587f"
            cyan "#327f77"
            white "#647d75"
            bright_black "#3c4812"
            bright_red "#e08009"
            bright_green "#18e000"
            bright_yellow "#bde000"
            bright_blue "#00aae0"
            bright_magenta "#0058e0"
            bright_cyan "#00e0c4"
            bright_white "#73fa91"
        }
        text_unselected {
            base "#6a837b"
            background "#0f1610"
            emphasis_0 "#77852d"
            emphasis_1 "#438a82"
            emphasis_2 "#478d3e"
            emphasis_3 "#717e9c"
        }
        text_selected {
            base "#0f1610"
            background "#6a837b"
            emphasis_0 "#14150d"
            emphasis_1 "#0f1514"
            emphasis_2 "#0f150e"
            emphasis_3 "#131417"
        }
        table_cell_unselected {
            base "#6a837b"
            background "#0f1610"
            emphasis_0 "#77852d"
            emphasis_1 "#438a82"
            emphasis_2 "#478d3e"
            emphasis_3 "#717e9c"
        }
        table_cell_selected {
            base "#73fa91"
            background "#1d4125"
            emphasis_0 "#9ea86a"
            emphasis_1 "#7aaca6"
            emphasis_2 "#7daf77"
            emphasis_3 "#99a3b8"
        }
        list_unselected {
            base "#6a837b"
            background "#0f1610"
            emphasis_0 "#77852d"
            emphasis_1 "#438a82"
            emphasis_2 "#478d3e"
            emphasis_3 "#717e9c"
        }
        list_selected {
            base "#73fa91"
            background "#1d4125"
            emphasis_0 "#9ea86a"
            emphasis_1 "#7aaca6"
            emphasis_2 "#7daf77"
            emphasis_3 "#99a3b8"
        }
        ribbon_selected {
            base "#f2f2f2"
            background "#2f7e25"
            emphasis_0 "#f6f0f0"
            emphasis_1 "#f1f2e9"
            emphasis_2 "#f1f2f5"
            emphasis_3 "#edf2f4"
        }
        ribbon_unselected {
            base "#0f1610"
            background "#6a837b"
            emphasis_0 "#250d0b"
            emphasis_1 "#6a837b"
            emphasis_2 "#0a161a"
            emphasis_3 "#10141d"
        }
        table_title {
            base "#478d3e"
            background "#0f1610"
            emphasis_0 "#77852d"
            emphasis_1 "#438a82"
            emphasis_2 "#478d3e"
            emphasis_3 "#717e9c"
        }
        frame_unselected {
            base "#6a837b"
            background "#0f1610"
            emphasis_0 "#6a837b"
            emphasis_1 "#6a837b"
            emphasis_2 "#6a837b"
            emphasis_3 "#6a837b"
        }
        frame_selected {
            base "#478d3e"
            background "#0f1610"
            emphasis_0 "#77852d"
            emphasis_1 "#438a82"
            emphasis_2 "#478d3e"
            emphasis_3 "#717e9c"
        }
        frame_highlight {
            base "#77852d"
            background "#0f1610"
            emphasis_0 "#717e9c"
            emphasis_1 "#77852d"
            emphasis_2 "#77852d"
            emphasis_3 "#77852d"
        }
        exit_code_success {
            base "#478d3e"
            background "#0f1610"
            emphasis_0 "#438a82"
            emphasis_1 "#6a837b"
            emphasis_2 "#717e9c"
            emphasis_3 "#558596"
        }
        exit_code_error {
            base "#a86f6c"
            background "#0f1610"
            emphasis_0 "#77852d"
            emphasis_1 "#6a837b"
            emphasis_2 "#717e9c"
            emphasis_3 "#558596"
        }
        multiplayer_user_colors {
            player_1 "#717e9c"
            player_2 "#558596"
            player_3 "#367be7"
            player_4 "#77852d"
            player_5 "#438a82"
            player_6 "#bde000"
            player_7 "#a86f6c"
            player_8 "#6b837b"
            player_9 "#e08009"
            player_10 "#00aae0"
        }
    }
}
