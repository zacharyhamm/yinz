themes {
    "x-paris" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/X%20Paris
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#0e0024"
        terminal {
            foreground "#f7f1ff"
            background "#1a0a30"
            black "#1a0a30"
            red "#fc618d"
            green "#7bd88f"
            yellow "#fce566"
            blue "#a3f3ff"
            magenta "#c4bdff"
            cyan "#a3f3ff"
            white "#4d3d63"
            bright_black "#c4bdff"
            bright_red "#fc618d"
            bright_green "#7bd88f"
            bright_yellow "#fce566"
            bright_blue "#a3f3ff"
            bright_magenta "#c4bdff"
            bright_cyan "#a3f3ff"
            bright_white "#f7f1ff"
        }
        text_unselected {
            base "#f7f1ff"
            background "#1a0a30"
            emphasis_0 "#fce566"
            emphasis_1 "#a3f3ff"
            emphasis_2 "#7bd88f"
            emphasis_3 "#c4bdff"
        }
        text_selected {
            base "#1a0a30"
            background "#f7f1ff"
            emphasis_0 "#7b6f32"
            emphasis_1 "#4f767c"
            emphasis_2 "#467b51"
            emphasis_3 "#6f6b91"
        }
        table_cell_unselected {
            base "#f7f1ff"
            background "#1a0a30"
            emphasis_0 "#fce566"
            emphasis_1 "#a3f3ff"
            emphasis_2 "#7bd88f"
            emphasis_3 "#c4bdff"
        }
        table_cell_selected {
            base "#1a0a30"
            background "#f7f1ff"
            emphasis_0 "#7b6f32"
            emphasis_1 "#4f767c"
            emphasis_2 "#467b51"
            emphasis_3 "#6f6b91"
        }
        list_unselected {
            base "#f7f1ff"
            background "#1a0a30"
            emphasis_0 "#fce566"
            emphasis_1 "#a3f3ff"
            emphasis_2 "#7bd88f"
            emphasis_3 "#c4bdff"
        }
        list_selected {
            base "#1a0a30"
            background "#f7f1ff"
            emphasis_0 "#7b6f32"
            emphasis_1 "#4f767c"
            emphasis_2 "#467b51"
            emphasis_3 "#6f6b91"
        }
        ribbon_selected {
            base "#1a0a30"
            background "#7bd88f"
            emphasis_0 "#89354d"
            emphasis_1 "#5a5224"
            emphasis_2 "#514f6a"
            emphasis_3 "#3a565a"
        }
        ribbon_unselected {
            base "#1a0a30"
            background "#f7f1ff"
            emphasis_0 "#ba4868"
            emphasis_1 "#f7f1ff"
            emphasis_2 "#4f767c"
            emphasis_3 "#6f6b91"
        }
        table_title {
            base "#7bd88f"
            background "#1a0a30"
            emphasis_0 "#fce566"
            emphasis_1 "#a3f3ff"
            emphasis_2 "#7bd88f"
            emphasis_3 "#c4bdff"
        }
        frame_unselected {
            base "#f7f1ff"
            background "#1a0a30"
            emphasis_0 "#f7f1ff"
            emphasis_1 "#f7f1ff"
            emphasis_2 "#f7f1ff"
            emphasis_3 "#f7f1ff"
        }
        frame_selected {
            base "#7bd88f"
            background "#1a0a30"
            emphasis_0 "#fce566"
            emphasis_1 "#a3f3ff"
            emphasis_2 "#7bd88f"
            emphasis_3 "#c4bdff"
        }
        frame_highlight {
            base "#fce566"
            background "#1a0a30"
            emphasis_0 "#c4bdff"
            emphasis_1 "#fce566"
            emphasis_2 "#fce566"
            emphasis_3 "#fce566"
        }
        exit_code_success {
            base "#7bd88f"
            background "#1a0a30"
            emphasis_0 "#a3f3ff"
            emphasis_1 "#f7f1ff"
            emphasis_2 "#c4bdff"
            emphasis_3 "#a3f3ff"
        }
        exit_code_error {
            base "#fc618d"
            background "#1a0a30"
            emphasis_0 "#fce566"
            emphasis_1 "#f7f1ff"
            emphasis_2 "#c4bdff"
            emphasis_3 "#a3f3ff"
        }
        multiplayer_user_colors {
            player_1 "#c4bdff"
            player_2 "#a3f3ff"
            player_3 "#c4bdff"
            player_4 "#fce566"
            player_5 "#a3f3ff"
            player_6 "#fce566"
            player_7 "#fc618d"
            player_8 "#847993"
            player_9 "#fc618d"
            player_10 "#a3f3ff"
        }
    }
}
