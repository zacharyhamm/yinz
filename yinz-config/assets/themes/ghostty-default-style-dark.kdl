themes {
    "ghostty-default-style-dark" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Ghostty%20Default%20Style%20Dark
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#1c2028"
        terminal {
            foreground "#ffffff"
            background "#282c34"
            black "#1d1f21"
            red "#cc6566"
            green "#b6bd68"
            yellow "#f0c674"
            blue "#82a2be"
            magenta "#b294bb"
            cyan "#8abeb7"
            white "#c4c8c6"
            bright_black "#666666"
            bright_red "#d54e53"
            bright_green "#b9ca4b"
            bright_yellow "#e7c547"
            bright_blue "#7aa6da"
            bright_magenta "#c397d8"
            bright_cyan "#70c0b1"
            bright_white "#eaeaea"
        }
        text_unselected {
            base "#ffffff"
            background "#282c34"
            emphasis_0 "#f0c674"
            emphasis_1 "#8abeb7"
            emphasis_2 "#b6bd68"
            emphasis_3 "#b294bb"
        }
        text_selected {
            base "#282c34"
            background "#ffffff"
            emphasis_0 "#8b7343"
            emphasis_1 "#5b7d79"
            emphasis_2 "#767a43"
            emphasis_3 "#856f8c"
        }
        table_cell_unselected {
            base "#ffffff"
            background "#282c34"
            emphasis_0 "#f0c674"
            emphasis_1 "#8abeb7"
            emphasis_2 "#b6bd68"
            emphasis_3 "#b294bb"
        }
        table_cell_selected {
            base "#282c34"
            background "#ffffff"
            emphasis_0 "#8b7343"
            emphasis_1 "#5b7d79"
            emphasis_2 "#767a43"
            emphasis_3 "#856f8c"
        }
        list_unselected {
            base "#ffffff"
            background "#282c34"
            emphasis_0 "#f0c674"
            emphasis_1 "#8abeb7"
            emphasis_2 "#b6bd68"
            emphasis_3 "#b294bb"
        }
        list_selected {
            base "#282c34"
            background "#ffffff"
            emphasis_0 "#8b7343"
            emphasis_1 "#5b7d79"
            emphasis_2 "#767a43"
            emphasis_3 "#856f8c"
        }
        ribbon_selected {
            base "#282c34"
            background "#b6bd68"
            emphasis_0 "#713838"
            emphasis_1 "#554629"
            emphasis_2 "#524457"
            emphasis_3 "#3c4a57"
        }
        ribbon_unselected {
            base "#282c34"
            background "#ffffff"
            emphasis_0 "#b75b5c"
            emphasis_1 "#ffffff"
            emphasis_2 "#61798e"
            emphasis_3 "#856f8c"
        }
        table_title {
            base "#b6bd68"
            background "#282c34"
            emphasis_0 "#f0c674"
            emphasis_1 "#8abeb7"
            emphasis_2 "#b6bd68"
            emphasis_3 "#b294bb"
        }
        frame_unselected {
            base "#ffffff"
            background "#282c34"
            emphasis_0 "#ffffff"
            emphasis_1 "#ffffff"
            emphasis_2 "#ffffff"
            emphasis_3 "#ffffff"
        }
        frame_selected {
            base "#b6bd68"
            background "#282c34"
            emphasis_0 "#f0c674"
            emphasis_1 "#8abeb7"
            emphasis_2 "#b6bd68"
            emphasis_3 "#b294bb"
        }
        frame_highlight {
            base "#f0c674"
            background "#282c34"
            emphasis_0 "#b294bb"
            emphasis_1 "#f0c674"
            emphasis_2 "#f0c674"
            emphasis_3 "#f0c674"
        }
        exit_code_success {
            base "#b6bd68"
            background "#282c34"
            emphasis_0 "#8abeb7"
            emphasis_1 "#ffffff"
            emphasis_2 "#b294bb"
            emphasis_3 "#82a2be"
        }
        exit_code_error {
            base "#d3797a"
            background "#282c34"
            emphasis_0 "#f0c674"
            emphasis_1 "#ffffff"
            emphasis_2 "#b294bb"
            emphasis_3 "#82a2be"
        }
        multiplayer_user_colors {
            player_1 "#b294bb"
            player_2 "#82a2be"
            player_3 "#c397d8"
            player_4 "#f0c674"
            player_5 "#8abeb7"
            player_6 "#e7c547"
            player_7 "#d3797a"
            player_8 "#c4c8c6"
            player_9 "#de7276"
            player_10 "#7aa6da"
        }
    }
}
