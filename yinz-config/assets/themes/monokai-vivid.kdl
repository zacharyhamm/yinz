themes {
    "monokai-vivid" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Monokai%20Vivid
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#060606"
        terminal {
            foreground "#f9f9f9"
            background "#121212"
            black "#121212"
            red "#fa2934"
            green "#98e123"
            yellow "#fff30a"
            blue "#0443ff"
            magenta "#f800f8"
            cyan "#01b6ed"
            white "#ffffff"
            bright_black "#838383"
            bright_red "#f6669d"
            bright_green "#b1e05f"
            bright_yellow "#fff26d"
            bright_blue "#0443ff"
            bright_magenta "#f200f6"
            bright_cyan "#51ceff"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#f9f9f9"
            background "#121212"
            emphasis_0 "#fff30a"
            emphasis_1 "#01b6ed"
            emphasis_2 "#98e123"
            emphasis_3 "#f800f8"
        }
        text_selected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#7f7905"
            emphasis_1 "#0180a7"
            emphasis_2 "#588214"
            emphasis_3 "#d100d1"
        }
        table_cell_unselected {
            base "#f9f9f9"
            background "#121212"
            emphasis_0 "#fff30a"
            emphasis_1 "#01b6ed"
            emphasis_2 "#98e123"
            emphasis_3 "#f800f8"
        }
        table_cell_selected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#7f7905"
            emphasis_1 "#0180a7"
            emphasis_2 "#588214"
            emphasis_3 "#d100d1"
        }
        list_unselected {
            base "#f9f9f9"
            background "#121212"
            emphasis_0 "#fff30a"
            emphasis_1 "#01b6ed"
            emphasis_2 "#98e123"
            emphasis_3 "#f800f8"
        }
        list_selected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#7f7905"
            emphasis_1 "#0180a7"
            emphasis_2 "#588214"
            emphasis_3 "#d100d1"
        }
        ribbon_selected {
            base "#121212"
            background "#98e123"
            emphasis_0 "#aa1c23"
            emphasis_1 "#5d5904"
            emphasis_2 "#9c009c"
            emphasis_3 "#043eed"
        }
        ribbon_unselected {
            base "#121212"
            background "#f9f9f9"
            emphasis_0 "#df242e"
            emphasis_1 "#f9f9f9"
            emphasis_2 "#0443ff"
            emphasis_3 "#cb00cb"
        }
        table_title {
            base "#98e123"
            background "#121212"
            emphasis_0 "#fff30a"
            emphasis_1 "#01b6ed"
            emphasis_2 "#98e123"
            emphasis_3 "#f800f8"
        }
        frame_unselected {
            base "#f9f9f9"
            background "#121212"
            emphasis_0 "#f9f9f9"
            emphasis_1 "#f9f9f9"
            emphasis_2 "#f9f9f9"
            emphasis_3 "#f9f9f9"
        }
        frame_selected {
            base "#98e123"
            background "#121212"
            emphasis_0 "#fff30a"
            emphasis_1 "#01b6ed"
            emphasis_2 "#98e123"
            emphasis_3 "#f800f8"
        }
        frame_highlight {
            base "#fff30a"
            background "#121212"
            emphasis_0 "#f800f8"
            emphasis_1 "#fff30a"
            emphasis_2 "#fff30a"
            emphasis_3 "#fff30a"
        }
        exit_code_success {
            base "#98e123"
            background "#121212"
            emphasis_0 "#01b6ed"
            emphasis_1 "#f9f9f9"
            emphasis_2 "#f800f8"
            emphasis_3 "#4372ff"
        }
        exit_code_error {
            base "#fa2934"
            background "#121212"
            emphasis_0 "#fff30a"
            emphasis_1 "#f9f9f9"
            emphasis_2 "#f800f8"
            emphasis_3 "#4372ff"
        }
        multiplayer_user_colors {
            player_1 "#f800f8"
            player_2 "#4372ff"
            player_3 "#f200f6"
            player_4 "#fff30a"
            player_5 "#01b6ed"
            player_6 "#fff26d"
            player_7 "#fa2934"
            player_8 "#ffffff"
            player_9 "#f6669d"
            player_10 "#4372ff"
        }
    }
}
