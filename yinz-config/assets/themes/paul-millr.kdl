themes {
    "paul-millr" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Paul%20Millr
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000000"
        terminal {
            foreground "#f2f2f2"
            background "#000000"
            black "#2a2a2a"
            red "#ff0000"
            green "#79ff0f"
            yellow "#e7bf00"
            blue "#396bd7"
            magenta "#b449be"
            cyan "#66ccff"
            white "#bbbbbb"
            bright_black "#666666"
            bright_red "#ff0080"
            bright_green "#66ff66"
            bright_yellow "#f3d64e"
            bright_blue "#709aed"
            bright_magenta "#db67e6"
            bright_cyan "#7adff2"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#f2f2f2"
            background "#000000"
            emphasis_0 "#e7bf00"
            emphasis_1 "#66ccff"
            emphasis_2 "#79ff0f"
            emphasis_3 "#b449be"
        }
        text_selected {
            base "#000000"
            background "#f2f2f2"
            emphasis_0 "#836d00"
            emphasis_1 "#3a7592"
            emphasis_2 "#3b7d07"
            emphasis_3 "#88618b"
        }
        table_cell_unselected {
            base "#f2f2f2"
            background "#000000"
            emphasis_0 "#e7bf00"
            emphasis_1 "#66ccff"
            emphasis_2 "#79ff0f"
            emphasis_3 "#b449be"
        }
        table_cell_selected {
            base "#ffffff"
            background "#414141"
            emphasis_0 "#e7bf00"
            emphasis_1 "#66ccff"
            emphasis_2 "#79ff0f"
            emphasis_3 "#d498da"
        }
        list_unselected {
            base "#f2f2f2"
            background "#000000"
            emphasis_0 "#e7bf00"
            emphasis_1 "#66ccff"
            emphasis_2 "#79ff0f"
            emphasis_3 "#b449be"
        }
        list_selected {
            base "#ffffff"
            background "#414141"
            emphasis_0 "#e7bf00"
            emphasis_1 "#66ccff"
            emphasis_2 "#79ff0f"
            emphasis_3 "#d498da"
        }
        ribbon_selected {
            base "#000000"
            background "#79ff0f"
            emphasis_0 "#cc0000"
            emphasis_1 "#776200"
            emphasis_2 "#993ea2"
            emphasis_3 "#3360c0"
        }
        ribbon_unselected {
            base "#000000"
            background "#f2f2f2"
            emphasis_0 "#df0000"
            emphasis_1 "#f2f2f2"
            emphasis_2 "#3869d4"
            emphasis_3 "#a944b2"
        }
        table_title {
            base "#79ff0f"
            background "#000000"
            emphasis_0 "#e7bf00"
            emphasis_1 "#66ccff"
            emphasis_2 "#79ff0f"
            emphasis_3 "#b449be"
        }
        frame_unselected {
            base "#f2f2f2"
            background "#000000"
            emphasis_0 "#f2f2f2"
            emphasis_1 "#f2f2f2"
            emphasis_2 "#f2f2f2"
            emphasis_3 "#f2f2f2"
        }
        frame_selected {
            base "#79ff0f"
            background "#000000"
            emphasis_0 "#e7bf00"
            emphasis_1 "#66ccff"
            emphasis_2 "#79ff0f"
            emphasis_3 "#b449be"
        }
        frame_highlight {
            base "#e7bf00"
            background "#000000"
            emphasis_0 "#b449be"
            emphasis_1 "#e7bf00"
            emphasis_2 "#e7bf00"
            emphasis_3 "#e7bf00"
        }
        exit_code_success {
            base "#79ff0f"
            background "#000000"
            emphasis_0 "#66ccff"
            emphasis_1 "#f2f2f2"
            emphasis_2 "#b449be"
            emphasis_3 "#3f70d8"
        }
        exit_code_error {
            base "#ff0000"
            background "#000000"
            emphasis_0 "#e7bf00"
            emphasis_1 "#f2f2f2"
            emphasis_2 "#b449be"
            emphasis_3 "#3f70d8"
        }
        multiplayer_user_colors {
            player_1 "#b449be"
            player_2 "#3f70d8"
            player_3 "#db67e6"
            player_4 "#e7bf00"
            player_5 "#66ccff"
            player_6 "#f3d64e"
            player_7 "#ff0000"
            player_8 "#bbbbbb"
            player_9 "#ff0080"
            player_10 "#709aed"
        }
    }
}
