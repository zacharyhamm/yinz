themes {
    "piatto-light" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Piatto%20Light
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#f3f3f3"
        terminal {
            foreground "#414141"
            background "#ffffff"
            black "#414141"
            red "#b23771"
            green "#66781e"
            yellow "#cd6f34"
            blue "#3c5ea8"
            magenta "#a454b2"
            cyan "#66781e"
            white "#bfbfbf"
            bright_black "#3f3f3f"
            bright_red "#db3365"
            bright_green "#829429"
            bright_yellow "#cd6f34"
            bright_blue "#3c5ea8"
            bright_magenta "#a454b2"
            bright_cyan "#829429"
            bright_white "#f2f2f2"
        }
        text_unselected {
            base "#414141"
            background "#ffffff"
            emphasis_0 "#b3612d"
            emphasis_1 "#66781e"
            emphasis_2 "#66781e"
            emphasis_3 "#a454b2"
        }
        text_selected {
            base "#e6ebf5"
            background "#706b4e"
            emphasis_0 "#f7e8df"
            emphasis_1 "#eaece0"
            emphasis_2 "#eaece0"
            emphasis_3 "#f3e8f4"
        }
        table_cell_unselected {
            base "#414141"
            background "#ffffff"
            emphasis_0 "#b3612d"
            emphasis_1 "#66781e"
            emphasis_2 "#66781e"
            emphasis_3 "#a454b2"
        }
        table_cell_selected {
            base "#e6ebf5"
            background "#706b4e"
            emphasis_0 "#f7e8df"
            emphasis_1 "#eaece0"
            emphasis_2 "#eaece0"
            emphasis_3 "#f3e8f4"
        }
        list_unselected {
            base "#414141"
            background "#ffffff"
            emphasis_0 "#b3612d"
            emphasis_1 "#66781e"
            emphasis_2 "#66781e"
            emphasis_3 "#a454b2"
        }
        list_selected {
            base "#e6ebf5"
            background "#706b4e"
            emphasis_0 "#f7e8df"
            emphasis_1 "#eaece0"
            emphasis_2 "#eaece0"
            emphasis_3 "#f3e8f4"
        }
        ribbon_selected {
            base "#ffffff"
            background "#66781e"
            emphasis_0 "#faf3f7"
            emphasis_1 "#fbf4ef"
            emphasis_2 "#f9f3fa"
            emphasis_3 "#f3f5fa"
        }
        ribbon_unselected {
            base "#ffffff"
            background "#414141"
            emphasis_0 "#d89bb8"
            emphasis_1 "#414141"
            emphasis_2 "#9cadd3"
            emphasis_3 "#cb9dd3"
        }
        table_title {
            base "#66781e"
            background "#ffffff"
            emphasis_0 "#b3612d"
            emphasis_1 "#66781e"
            emphasis_2 "#66781e"
            emphasis_3 "#a454b2"
        }
        frame_unselected {
            base "#414141"
            background "#ffffff"
            emphasis_0 "#414141"
            emphasis_1 "#414141"
            emphasis_2 "#414141"
            emphasis_3 "#414141"
        }
        frame_selected {
            base "#66781e"
            background "#ffffff"
            emphasis_0 "#b3612d"
            emphasis_1 "#66781e"
            emphasis_2 "#66781e"
            emphasis_3 "#a454b2"
        }
        frame_highlight {
            base "#b3612d"
            background "#ffffff"
            emphasis_0 "#a454b2"
            emphasis_1 "#b3612d"
            emphasis_2 "#b3612d"
            emphasis_3 "#b3612d"
        }
        exit_code_success {
            base "#66781e"
            background "#ffffff"
            emphasis_0 "#66781e"
            emphasis_1 "#414141"
            emphasis_2 "#a454b2"
            emphasis_3 "#3c5ea8"
        }
        exit_code_error {
            base "#b23771"
            background "#ffffff"
            emphasis_0 "#b3612d"
            emphasis_1 "#414141"
            emphasis_2 "#a454b2"
            emphasis_3 "#3c5ea8"
        }
        multiplayer_user_colors {
            player_1 "#a454b2"
            player_2 "#3c5ea8"
            player_3 "#a454b2"
            player_4 "#b3612d"
            player_5 "#66781e"
            player_6 "#b3612d"
            player_7 "#b23771"
            player_8 "#767676"
            player_9 "#da3365"
            player_10 "#3c5ea8"
        }
    }
}
