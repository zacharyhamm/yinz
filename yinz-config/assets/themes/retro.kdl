themes {
    "retro" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Retro
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000000"
        terminal {
            foreground "#13a10e"
            background "#000000"
            black "#13a10e"
            red "#13a10e"
            green "#13a10e"
            yellow "#13a10e"
            blue "#13a10e"
            magenta "#13a10e"
            cyan "#13a10e"
            white "#13a10e"
            bright_black "#16ba10"
            bright_red "#16ba10"
            bright_green "#16ba10"
            bright_yellow "#16ba10"
            bright_blue "#16ba10"
            bright_magenta "#16ba10"
            bright_cyan "#16ba10"
            bright_white "#16ba10"
        }
        text_unselected {
            base "#13a10e"
            background "#000000"
            emphasis_0 "#13a10e"
            emphasis_1 "#13a10e"
            emphasis_2 "#13a10e"
            emphasis_3 "#13a10e"
        }
        text_selected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#108a0c"
            emphasis_1 "#108a0c"
            emphasis_2 "#108a0c"
            emphasis_3 "#108a0c"
        }
        table_cell_unselected {
            base "#13a10e"
            background "#000000"
            emphasis_0 "#13a10e"
            emphasis_1 "#13a10e"
            emphasis_2 "#13a10e"
            emphasis_3 "#13a10e"
        }
        table_cell_selected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#108a0c"
            emphasis_1 "#108a0c"
            emphasis_2 "#108a0c"
            emphasis_3 "#108a0c"
        }
        list_unselected {
            base "#13a10e"
            background "#000000"
            emphasis_0 "#13a10e"
            emphasis_1 "#13a10e"
            emphasis_2 "#13a10e"
            emphasis_3 "#13a10e"
        }
        list_selected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#108a0c"
            emphasis_1 "#108a0c"
            emphasis_2 "#108a0c"
            emphasis_3 "#108a0c"
        }
        ribbon_selected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#108a0c"
            emphasis_1 "#108a0c"
            emphasis_2 "#108a0c"
            emphasis_3 "#108a0c"
        }
        ribbon_unselected {
            base "#000000"
            background "#13a10e"
            emphasis_0 "#052b04"
            emphasis_1 "#13a10e"
            emphasis_2 "#052b04"
            emphasis_3 "#052b04"
        }
        table_title {
            base "#13a10e"
            background "#000000"
            emphasis_0 "#13a10e"
            emphasis_1 "#13a10e"
            emphasis_2 "#13a10e"
            emphasis_3 "#13a10e"
        }
        frame_unselected {
            base "#13a10e"
            background "#000000"
            emphasis_0 "#13a10e"
            emphasis_1 "#13a10e"
            emphasis_2 "#13a10e"
            emphasis_3 "#13a10e"
        }
        frame_selected {
            base "#13a10e"
            background "#000000"
            emphasis_0 "#13a10e"
            emphasis_1 "#13a10e"
            emphasis_2 "#13a10e"
            emphasis_3 "#13a10e"
        }
        frame_highlight {
            base "#13a10e"
            background "#000000"
            emphasis_0 "#13a10e"
            emphasis_1 "#13a10e"
            emphasis_2 "#13a10e"
            emphasis_3 "#13a10e"
        }
        exit_code_success {
            base "#13a10e"
            background "#000000"
            emphasis_0 "#13a10e"
            emphasis_1 "#13a10e"
            emphasis_2 "#13a10e"
            emphasis_3 "#13a10e"
        }
        exit_code_error {
            base "#13a10e"
            background "#000000"
            emphasis_0 "#13a10e"
            emphasis_1 "#13a10e"
            emphasis_2 "#13a10e"
            emphasis_3 "#13a10e"
        }
        multiplayer_user_colors {
            player_1 "#13a10e"
            player_2 "#13a10e"
            player_3 "#16ba10"
            player_4 "#13a10e"
            player_5 "#13a10e"
            player_6 "#16ba10"
            player_7 "#13a10e"
            player_8 "#13a10e"
            player_9 "#16ba10"
            player_10 "#16ba10"
        }
    }
}
