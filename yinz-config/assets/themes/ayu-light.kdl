themes {
    ayu-light {
        // Terminal palette: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/master/ghostty/Ayu%20Light
        pane_surround "#ecedee"
        terminal {
            foreground "#5c6166"
            background "#f8f9fa"
            black "#000000"
            red "#ea6c6d"
            green "#6cbf43"
            yellow "#eca944"
            blue "#3199e1"
            magenta "#9e75c7"
            cyan "#46ba94"
            white "#bababa"
            bright_black "#686868"
            bright_red "#f07171"
            bright_green "#86b300"
            bright_yellow "#f2ae49"
            bright_blue "#399ee6"
            bright_magenta "#a37acc"
            bright_cyan "#4cbf99"
            bright_white "#d1d1d1"
        }
        text_unselected {
            base 92 97 102
            background 231 234 237
            emphasis_0 157 88 39
            emphasis_1 56 108 160
            emphasis_2 86 115 0
            emphasis_3 123 92 154
        }
        text_selected {
            base 252 252 252
            background 3 91 214
            emphasis_0 253 215 188
            emphasis_1 207 225 242
            emphasis_2 214 229 168
            emphasis_3 229 218 241
        }
        ribbon_selected {
            base 58 59 59
            background 134 179 0
