            emphasis_1 87 49 22
            emphasis_2 69 52 86
            emphasis_3 22 62 90
        }
        ribbon_unselected {
            base 231 234 237
            background 92 97 102
            emphasis_0 250 209 209
            emphasis_1 96 96 96
            emphasis_2 191 223 247
            emphasis_3 227 214 239
        }
        table_title {
            base 86 115 0
            background 0
            emphasis_0 157 88 39
            emphasis_1 56 108 160
            emphasis_2 86 115 0
            emphasis_3 123 92 154
        }
        table_cell_selected {
            base 252 252 252
            background 3 91 214
            emphasis_0 253 215 188
            emphasis_1 207 225 242
            emphasis_2 214 229 168
            emphasis_3 229 218 241
        }
        table_cell_unselected {
            base 92 97 102
            background 231 234 237
            emphasis_0 157 88 39
            emphasis_1 56 108 160
            emphasis_2 86 115 0
            emphasis_3 123 92 154
        }
        list_selected {
            base 252 252 252
            background 3 91 214
            emphasis_0 253 215 188
            emphasis_1 207 225 242
            emphasis_2 214 229 168
            emphasis_3 229 218 241
        }
        list_unselected {
            base 92 97 102
            background 231 234 237
            emphasis_0 157 88 39
            emphasis_1 56 108 160
            emphasis_2 86 115 0
            emphasis_3 123 92 154
        }
        frame_selected {
            base 86 115 0
            background 0
            emphasis_0 157 88 39
            emphasis_1 56 108 160
            emphasis_2 123 92 154
            emphasis_3 0
        }
        frame_highlight {
            base 157 88 39
            background 0
            emphasis_0 123 92 154
            emphasis_1 157 88 39
            emphasis_2 157 88 39
            emphasis_3 157 88 39
        }
        exit_code_success {
            base 86 115 0
            background 0
            emphasis_0 56 108 160
            emphasis_1 104 106 107
            emphasis_2 123 92 154
            emphasis_3 40 110 161
        }
        exit_code_error {
            base 167 78 78
            background 0
            emphasis_0 143 95 29
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 123 92 154
            player_2 40 110 161
            player_3 92 92 92
            player_4 143 95 29
            player_5 56 108 160
            player_6 92 92 92
            player_7 167 78 78
            player_8 92 92 92
