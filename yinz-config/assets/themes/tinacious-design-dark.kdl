themes {
    "tinacious-design-dark" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Tinacious%20Design%20Dark
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#11111a"
        terminal {
            foreground "#cbcbf0"
            background "#1d1d26"
            black "#1d1d26"
            red "#ff3399"
            green "#00d364"
            yellow "#ffcc66"
            blue "#00cbff"
            magenta "#cc66ff"
            cyan "#00ceca"
            white "#cbcbf0"
            bright_black "#636667"
            bright_red "#ff2f92"
            bright_green "#00d364"
            bright_yellow "#ffd479"
            bright_blue "#00cbff"
            bright_magenta "#d783ff"
            bright_cyan "#00d5d4"
            bright_white "#d5d6f3"
        }
        text_unselected {
            base "#cbcbf0"
            background "#1d1d26"
            emphasis_0 "#ffcc66"
            emphasis_1 "#00ceca"
            emphasis_2 "#00d364"
            emphasis_3 "#cc66ff"
        }
        text_selected {
            base "#252525"
            background "#ff3399"
            emphasis_0 "#2d2412"
            emphasis_1 "#002a29"
            emphasis_2 "#002c15"
            emphasis_3 "#341a41"
        }
        table_cell_unselected {
            base "#cbcbf0"
            background "#1d1d26"
            emphasis_0 "#ffcc66"
            emphasis_1 "#00ceca"
            emphasis_2 "#00d364"
            emphasis_3 "#cc66ff"
        }
        table_cell_selected {
            base "#252525"
            background "#ff3399"
            emphasis_0 "#2d2412"
            emphasis_1 "#002a29"
            emphasis_2 "#002c15"
            emphasis_3 "#341a41"
        }
        list_unselected {
            base "#cbcbf0"
            background "#1d1d26"
            emphasis_0 "#ffcc66"
            emphasis_1 "#00ceca"
            emphasis_2 "#00d364"
            emphasis_3 "#cc66ff"
        }
        list_selected {
            base "#252525"
            background "#ff3399"
            emphasis_0 "#2d2412"
            emphasis_1 "#002a29"
            emphasis_2 "#002c15"
            emphasis_3 "#341a41"
        }
        ribbon_selected {
            base "#1d1d26"
            background "#00d364"
            emphasis_0 "#881b52"
            emphasis_1 "#584623"
            emphasis_2 "#65327e"
            emphasis_3 "#005064"
        }
        ribbon_unselected {
            base "#1d1d26"
            background "#cbcbf0"
            emphasis_0 "#a32162"
            emphasis_1 "#cbcbf0"
            emphasis_2 "#006079"
            emphasis_3 "#7a3d99"
        }
        table_title {
            base "#00d364"
            background "#1d1d26"
            emphasis_0 "#ffcc66"
            emphasis_1 "#00ceca"
            emphasis_2 "#00d364"
            emphasis_3 "#cc66ff"
        }
        frame_unselected {
            base "#cbcbf0"
            background "#1d1d26"
            emphasis_0 "#cbcbf0"
            emphasis_1 "#cbcbf0"
            emphasis_2 "#cbcbf0"
            emphasis_3 "#cbcbf0"
        }
        frame_selected {
            base "#00d364"
            background "#1d1d26"
            emphasis_0 "#ffcc66"
            emphasis_1 "#00ceca"
            emphasis_2 "#00d364"
            emphasis_3 "#cc66ff"
        }
        frame_highlight {
            base "#ffcc66"
            background "#1d1d26"
            emphasis_0 "#cc66ff"
            emphasis_1 "#ffcc66"
            emphasis_2 "#ffcc66"
            emphasis_3 "#ffcc66"
        }
        exit_code_success {
            base "#00d364"
            background "#1d1d26"
            emphasis_0 "#00ceca"
            emphasis_1 "#cbcbf0"
            emphasis_2 "#cc66ff"
            emphasis_3 "#00cbff"
        }
        exit_code_error {
            base "#ff3399"
            background "#1d1d26"
            emphasis_0 "#ffcc66"
            emphasis_1 "#cbcbf0"
            emphasis_2 "#cc66ff"
            emphasis_3 "#00cbff"
        }
        multiplayer_user_colors {
            player_1 "#cc66ff"
            player_2 "#00cbff"
            player_3 "#d783ff"
            player_4 "#ffcc66"
            player_5 "#00ceca"
            player_6 "#ffd479"
            player_7 "#ff3399"
            player_8 "#cbcbf0"
            player_9 "#ff2f92"
            player_10 "#00cbff"
        }
    }
}
