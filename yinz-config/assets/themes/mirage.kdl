themes {
    "mirage" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Mirage
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#0f1b2c"
        terminal {
            foreground "#a6b2c0"
            background "#1b2738"
            black "#011627"
            red "#ff9999"
            green "#85cc95"
            yellow "#ffd700"
            blue "#7fb5ff"
            magenta "#ddb3ff"
            cyan "#21c7a8"
            white "#ffffff"
            bright_black "#575656"
            bright_red "#ff9999"
            bright_green "#85cc95"
            bright_yellow "#ffd700"
            bright_blue "#7fb5ff"
            bright_magenta "#ddb3ff"
            bright_cyan "#85cc95"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#a6b2c0"
            background "#1b2738"
            emphasis_0 "#ffd700"
            emphasis_1 "#21c7a8"
            emphasis_2 "#85cc95"
            emphasis_3 "#ddb3ff"
        }
        text_selected {
            base "#1b2738"
            background "#a6b2c0"
            emphasis_0 "#504300"
            emphasis_1 "#0d4d41"
            emphasis_2 "#314a36"
            emphasis_3 "#4d3e59"
        }
        table_cell_unselected {
            base "#a6b2c0"
            background "#1b2738"
            emphasis_0 "#ffd700"
            emphasis_1 "#21c7a8"
            emphasis_2 "#85cc95"
            emphasis_3 "#ddb3ff"
        }
        table_cell_selected {
            base "#d3dbe5"
            background "#273951"
            emphasis_0 "#ffd700"
            emphasis_1 "#21c7a8"
            emphasis_2 "#85cc95"
            emphasis_3 "#ddb3ff"
        }
        list_unselected {
            base "#a6b2c0"
            background "#1b2738"
            emphasis_0 "#ffd700"
            emphasis_1 "#21c7a8"
            emphasis_2 "#85cc95"
            emphasis_3 "#ddb3ff"
        }
        list_selected {
            base "#d3dbe5"
            background "#273951"
            emphasis_0 "#ffd700"
            emphasis_1 "#21c7a8"
            emphasis_2 "#85cc95"
            emphasis_3 "#ddb3ff"
        }
        ribbon_selected {
            base "#1b2738"
            background "#85cc95"
            emphasis_0 "#6b4040"
            emphasis_1 "#594b00"
            emphasis_2 "#564563"
            emphasis_3 "#364d6d"
        }
        ribbon_unselected {
            base "#1b2738"
            background "#a6b2c0"
            emphasis_0 "#603a3a"
            emphasis_1 "#a6b2c0"
            emphasis_2 "#304561"
            emphasis_3 "#4d3e59"
        }
        table_title {
            base "#85cc95"
            background "#1b2738"
            emphasis_0 "#ffd700"
            emphasis_1 "#21c7a8"
            emphasis_2 "#85cc95"
            emphasis_3 "#ddb3ff"
        }
        frame_unselected {
            base "#a6b2c0"
            background "#1b2738"
            emphasis_0 "#a6b2c0"
            emphasis_1 "#a6b2c0"
            emphasis_2 "#a6b2c0"
            emphasis_3 "#a6b2c0"
        }
        frame_selected {
            base "#85cc95"
            background "#1b2738"
            emphasis_0 "#ffd700"
            emphasis_1 "#21c7a8"
            emphasis_2 "#85cc95"
            emphasis_3 "#ddb3ff"
        }
        frame_highlight {
            base "#ffd700"
            background "#1b2738"
            emphasis_0 "#ddb3ff"
            emphasis_1 "#ffd700"
            emphasis_2 "#ffd700"
            emphasis_3 "#ffd700"
        }
        exit_code_success {
            base "#85cc95"
            background "#1b2738"
            emphasis_0 "#21c7a8"
            emphasis_1 "#a6b2c0"
            emphasis_2 "#ddb3ff"
            emphasis_3 "#7fb5ff"
        }
        exit_code_error {
            base "#ff9999"
            background "#1b2738"
            emphasis_0 "#ffd700"
            emphasis_1 "#a6b2c0"
            emphasis_2 "#ddb3ff"
            emphasis_3 "#7fb5ff"
        }
        multiplayer_user_colors {
            player_1 "#ddb3ff"
            player_2 "#7fb5ff"
            player_3 "#ddb3ff"
            player_4 "#ffd700"
            player_5 "#21c7a8"
            player_6 "#ffd700"
            player_7 "#ff9999"
            player_8 "#ffffff"
            player_9 "#ff9999"
            player_10 "#7fb5ff"
        }
    }
}
