// Swamp Club palette: ~/swamp-club/assets/theme.css and HUD components.
// Activate in config.kdl with: theme "swamp" or theme "swamp-hud".
themes {
    swamp {
        // Terminal palette: Yinz-specific palette, matched to the UI colors below.
        pane_surround "#000000"
        terminal {
            foreground "#d1d5db"
            background "#0a0a0a"
            black "#0a0a0a"
            red "#f87171"
            green "#39dd14"
            yellow "#fb923c"
            blue "#60a5fa"
            magenta "#d946ef"
            cyan "#00cccc"
            white "#d1d5db"
            bright_black "#6b7280"
            bright_red "#fca5a5"
            bright_green "#39ff14"
            bright_yellow "#fbbf24"
            bright_blue "#93c5fd"
            bright_magenta "#ff00ff"
            bright_cyan "#00ffff"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#d1d5db"
            background "#0a0a0a"
            emphasis_0 "#fb923c"
            emphasis_1 "#00ffff"
            emphasis_2 "#39ff14"
            emphasis_3 "#ff00ff"
        }
        text_selected {
            base "#0a0a0a"
            background "#d1d5db"
            emphasis_0 "#874e20"
            emphasis_1 "#006767"
            emphasis_2 "#186b08"
            emphasis_3 "#a500a5"
        }
        ribbon_unselected {
            base "#0a0a0a"
            background "#d1d5db"
            emphasis_0 "#0a0a0a"
            emphasis_1 "#00ffff"
            emphasis_2 "#0a0a0a"
            emphasis_3 "#0a0a0a"
        }
        ribbon_selected {
            base "#0a0a0a"
            background "#39ff14"
            emphasis_0 "#0a0a0a"
            emphasis_1 "#0a0a0a"
            emphasis_2 "#0a0a0a"
            emphasis_3 "#0a0a0a"
        }
        table_title {
            base "#39ff14"
            background "#0a0a0a"
            emphasis_0 "#fb923c"
            emphasis_1 "#00ffff"
            emphasis_2 "#39ff14"
            emphasis_3 "#ff00ff"
        }
        table_cell_unselected {
            base "#d1d5db"
            background "#0a0a0a"
            emphasis_0 "#fb923c"
            emphasis_1 "#00ffff"
            emphasis_2 "#39ff14"
            emphasis_3 "#ff00ff"
        }
        table_cell_selected {
            base "#ffffff"
            background "#1a1a1a"
            emphasis_0 "#fb923c"
            emphasis_1 "#00ffff"
            emphasis_2 "#39ff14"
            emphasis_3 "#ff00ff"
        }
        list_unselected {
            base "#d1d5db"
            background "#0a0a0a"
            emphasis_0 "#fb923c"
            emphasis_1 "#00ffff"
            emphasis_2 "#39ff14"
            emphasis_3 "#ff00ff"
        }
        list_selected {
            base "#ffffff"
            background "#1a1a1a"
            emphasis_0 "#fb923c"
            emphasis_1 "#00ffff"
            emphasis_2 "#39ff14"
            emphasis_3 "#ff00ff"
        }
        frame_unselected {
            base "#9ca3af"
            background "#0a0a0a"
            emphasis_0 "#fb923c"
            emphasis_1 "#00ffff"
            emphasis_2 "#39ff14"
            emphasis_3 "#ff00ff"
        }
        frame_selected {
            base "#39ff14"
            background "#0a0a0a"
            emphasis_0 "#fb923c"
            emphasis_1 "#00ffff"
            emphasis_2 "#39ff14"
            emphasis_3 "#ff00ff"
        }
        frame_highlight {
            base "#00ffff"
            background "#0a0a0a"
            emphasis_0 "#fb923c"
            emphasis_1 "#00ffff"
            emphasis_2 "#39ff14"
            emphasis_3 "#ff00ff"
        }
        exit_code_success {
            base "#39ff14"
            background "#0a0a0a"
            emphasis_0 "#fb923c"
            emphasis_1 "#00ffff"
            emphasis_2 "#39ff14"
            emphasis_3 "#ff00ff"
        }
        exit_code_error {
            base "#f87171"
            background "#0a0a0a"
            emphasis_0 "#fbbf24"
            emphasis_1 "#00ffff"
            emphasis_2 "#39ff14"
            emphasis_3 "#ff00ff"
        }
        multiplayer_user_colors {
            player_1 "#ff00ff"
            player_2 "#60a5fa"
            player_3 "#a78bfa"
            player_4 "#fbbf24"
            player_5 "#00ffff"
            player_6 "#fb923c"
            player_7 "#f87171"
            player_8 "#d1d5db"
            player_9 "#f472b6"
            player_10 "#39ff14"
        }
    }
    swamp-hud {
        // Terminal palette: Yinz-specific palette, matched to the UI colors below.
        pane_surround "#000000"
        terminal {
            foreground "#d1d5db"
            background "#0a0a0a"
            black "#0a0a0a"
            red "#f87171"
            green "#39dd14"
            yellow "#fb923c"
            blue "#60a5fa"
            magenta "#d946ef"
            cyan "#00cccc"
            white "#d1d5db"
            bright_black "#6b7280"
            bright_red "#fca5a5"
            bright_green "#39ff14"
            bright_yellow "#fbbf24"
            bright_blue "#93c5fd"
            bright_magenta "#ff00ff"
            bright_cyan "#00ffff"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#d1d5db"
            background "#0a0a0a"
            emphasis_0 "#4ade80"
            emphasis_1 "#4ade80"
            emphasis_2 "#22d3ee"
            emphasis_3 "#4ade80"
        }
        text_selected {
            base "#0a0a0a"
            background "#d1d5db"
            emphasis_0 "#23693d"
            emphasis_1 "#23693d"
            emphasis_2 "#106572"
            emphasis_3 "#23693d"
        }
        ribbon_unselected {
            base "#0a0a0a"
            background "#22d3ee"
            emphasis_0 "#0a0a0a"
            emphasis_1 "#4ade80"
            emphasis_2 "#0a0a0a"
            emphasis_3 "#0a0a0a"
        }
        ribbon_selected {
            base "#0a0a0a"
            background "#e879f9"
            emphasis_0 "#0a0a0a"
            emphasis_1 "#0a0a0a"
            emphasis_2 "#0a0a0a"
            emphasis_3 "#0a0a0a"
        }
        table_title {
            base "#22d3ee"
            background "#0a0a0a"
            emphasis_0 "#4ade80"
            emphasis_1 "#4ade80"
            emphasis_2 "#22d3ee"
            emphasis_3 "#4ade80"
        }
        table_cell_unselected {
            base "#d1d5db"
            background "#0a0a0a"
            emphasis_0 "#4ade80"
            emphasis_1 "#4ade80"
            emphasis_2 "#22d3ee"
            emphasis_3 "#4ade80"
        }
        table_cell_selected {
            base "#f9fafb"
            background "#1a1a1a"
            emphasis_0 "#4ade80"
            emphasis_1 "#4ade80"
            emphasis_2 "#22d3ee"
            emphasis_3 "#4ade80"
        }
        list_unselected {
            base "#d1d5db"
            background "#0a0a0a"
            emphasis_0 "#4ade80"
            emphasis_1 "#4ade80"
            emphasis_2 "#22d3ee"
            emphasis_3 "#4ade80"
        }
        list_selected {
            base "#f9fafb"
            background "#1a1a1a"
            emphasis_0 "#4ade80"
            emphasis_1 "#4ade80"
            emphasis_2 "#22d3ee"
            emphasis_3 "#4ade80"
        }
        frame_unselected {
            base "#22d3ee"
            background "#0a0a0a"
            emphasis_0 "#4ade80"
            emphasis_1 "#4ade80"
            emphasis_2 "#22d3ee"
            emphasis_3 "#4ade80"
        }
        frame_selected {
            base "#e879f9"
            background "#0a0a0a"
            emphasis_0 "#4ade80"
            emphasis_1 "#4ade80"
            emphasis_2 "#22d3ee"
            emphasis_3 "#4ade80"
        }
        frame_highlight {
            base "#e879f9"
            background "#0a0a0a"
            emphasis_0 "#4ade80"
            emphasis_1 "#4ade80"
            emphasis_2 "#22d3ee"
            emphasis_3 "#4ade80"
        }
        exit_code_success {
            base "#4ade80"
            background "#0a0a0a"
            emphasis_0 "#4ade80"
            emphasis_1 "#4ade80"
            emphasis_2 "#22d3ee"
            emphasis_3 "#4ade80"
        }
        exit_code_error {
            base "#f87171"
            background "#0a0a0a"
            emphasis_0 "#fbbf24"
            emphasis_1 "#4ade80"
            emphasis_2 "#22d3ee"
            emphasis_3 "#4ade80"
        }
        multiplayer_user_colors {
            player_1 "#e879f9"
            player_2 "#60a5fa"
            player_3 "#a78bfa"
            player_4 "#fbbf24"
            player_5 "#4ade80"
            player_6 "#fb923c"
            player_7 "#f87171"
            player_8 "#d1d5db"
            player_9 "#f472b6"
            player_10 "#22d3ee"
        }
    }
}
