            background "#0a0a0a"
            emphasis_0 "#22d3ee"
            emphasis_1 "#22d3ee"
            emphasis_2 "#4ade80"
            emphasis_3 "#22d3ee"
        }
        table_cell_selected {
            base "#ffffff"
            background "#1a1a1a"
            emphasis_0 "#22d3ee"
            emphasis_1 "#22d3ee"
            emphasis_2 "#4ade80"
            emphasis_3 "#22d3ee"
        }
        list_unselected {
            base "#d1d5db"
            background "#0a0a0a"
            emphasis_0 "#22d3ee"
            emphasis_1 "#22d3ee"
            emphasis_2 "#4ade80"
            emphasis_3 "#22d3ee"
        }
        list_selected {
            base "#ffffff"
            background "#1a1a1a"
            emphasis_0 "#22d3ee"
            emphasis_1 "#22d3ee"
            emphasis_2 "#4ade80"
            emphasis_3 "#22d3ee"
        }
        frame_unselected {
            base "#4ade80"
            background "#0a0a0a"
            emphasis_0 "#22d3ee"
            emphasis_1 "#22d3ee"
            emphasis_2 "#4ade80"
            emphasis_3 "#22d3ee"
        }
        frame_selected {
            base "#e879f9"
            background "#0a0a0a"
            emphasis_0 "#22d3ee"
            emphasis_1 "#22d3ee"
            emphasis_2 "#4ade80"
            emphasis_3 "#22d3ee"
        }
        frame_highlight {
