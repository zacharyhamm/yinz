themes {
    "night-lion-v2" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Night%20Lion%20V2
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#0b0b0b"
        terminal {
            foreground "#bbbbbb"
            background "#171717"
            black "#4c4c4c"
            red "#bb0000"
            green "#04f623"
            yellow "#f3f167"
            blue "#64d0f0"
            magenta "#ce6fdb"
            cyan "#00dadf"
            white "#bbbbbb"
            bright_black "#555555"
            bright_red "#ff5555"
            bright_green "#7df71d"
            bright_yellow "#ffff55"
            bright_blue "#62cbe8"
            bright_magenta "#ff9bf5"
            bright_cyan "#00ccd8"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#bbbbbb"
            background "#171717"
            emphasis_0 "#f3f167"
            emphasis_1 "#00dadf"
            emphasis_2 "#04f623"
            emphasis_3 "#ce6fdb"
        }
        text_selected {
            base "#000000"
            background "#b5d5ff"
            emphasis_0 "#5d5d28"
            emphasis_1 "#006567"
            emphasis_2 "#026a0f"
            emphasis_3 "#7f4487"
        }
        table_cell_unselected {
            base "#bbbbbb"
            background "#171717"
            emphasis_0 "#f3f167"
            emphasis_1 "#00dadf"
            emphasis_2 "#04f623"
            emphasis_3 "#ce6fdb"
        }
        table_cell_selected {
            base "#000000"
            background "#b5d5ff"
            emphasis_0 "#5d5d28"
            emphasis_1 "#006567"
            emphasis_2 "#026a0f"
            emphasis_3 "#7f4487"
        }
        list_unselected {
            base "#bbbbbb"
            background "#171717"
            emphasis_0 "#f3f167"
            emphasis_1 "#00dadf"
            emphasis_2 "#04f623"
            emphasis_3 "#ce6fdb"
        }
        list_selected {
            base "#000000"
            background "#b5d5ff"
            emphasis_0 "#5d5d28"
            emphasis_1 "#006567"
            emphasis_2 "#026a0f"
            emphasis_3 "#7f4487"
        }
        ribbon_selected {
            base "#171717"
            background "#04f623"
            emphasis_0 "#bb0000"
            emphasis_1 "#5f5f28"
            emphasis_2 "#804589"
            emphasis_3 "#2f6372"
        }
        ribbon_unselected {
            base "#171717"
            background "#bbbbbb"
            emphasis_0 "#9c0000"
            emphasis_1 "#bbbbbb"
            emphasis_2 "#27515d"
            emphasis_3 "#693970"
        }
        table_title {
            base "#04f623"
            background "#171717"
            emphasis_0 "#f3f167"
            emphasis_1 "#00dadf"
            emphasis_2 "#04f623"
            emphasis_3 "#ce6fdb"
        }
        frame_unselected {
            base "#bbbbbb"
            background "#171717"
            emphasis_0 "#bbbbbb"
            emphasis_1 "#bbbbbb"
            emphasis_2 "#bbbbbb"
            emphasis_3 "#bbbbbb"
        }
        frame_selected {
            base "#04f623"
            background "#171717"
            emphasis_0 "#f3f167"
            emphasis_1 "#00dadf"
            emphasis_2 "#04f623"
            emphasis_3 "#ce6fdb"
        }
        frame_highlight {
            base "#f3f167"
            background "#171717"
            emphasis_0 "#ce6fdb"
            emphasis_1 "#f3f167"
            emphasis_2 "#f3f167"
            emphasis_3 "#f3f167"
        }
        exit_code_success {
            base "#04f623"
            background "#171717"
            emphasis_0 "#00dadf"
            emphasis_1 "#bbbbbb"
            emphasis_2 "#ce6fdb"
            emphasis_3 "#64d0f0"
        }
        exit_code_error {
            base "#d25858"
            background "#171717"
            emphasis_0 "#f3f167"
            emphasis_1 "#bbbbbb"
            emphasis_2 "#ce6fdb"
            emphasis_3 "#64d0f0"
        }
        multiplayer_user_colors {
            player_1 "#ce6fdb"
            player_2 "#64d0f0"
            player_3 "#ff9bf5"
            player_4 "#f3f167"
            player_5 "#00dadf"
            player_6 "#ffff55"
            player_7 "#d25858"
            player_8 "#bbbbbb"
            player_9 "#ff5555"
            player_10 "#62cbe8"
        }
    }
}
