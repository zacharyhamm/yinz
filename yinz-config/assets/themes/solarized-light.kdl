themes {
    solarized-light {
        // Terminal palette: https://github.com/altercation/solarized/blob/master/xresources/solarized
        pane_surround "#f1ead7"
        terminal {
            foreground "#657b83"
            background "#fdf6e3"
            black "#eee8d5"
            red "#dc322f"
            green "#859900"
            yellow "#b58900"
            blue "#268bd2"
            magenta "#d33682"
            cyan "#2aa198"
            white "#073642"
            bright_black "#fdf6e3"
            bright_red "#cb4b16"
            bright_green "#93a1a1"
            bright_yellow "#839496"
            bright_blue "#657b83"
            bright_magenta "#6c71c4"
            bright_cyan "#586e75"
            bright_white "#002b36"
        }
        text_unselected {
            base 95 116 124
            background 253 246 227
            emphasis_0 196 72 21
            emphasis_1 33 126 119
            emphasis_2 104 120 0
            emphasis_3 202 52 124
        }
        text_selected {
            base 253 246 227
            background 95 116 124
            emphasis_0 "#fbf4f1"
            emphasis_1 "#f1f6f6"
            emphasis_2 "#f5f6ef"
            emphasis_3 "#fbf3f7"
        }
        ribbon_selected {
            base 6 46 56
            background 133 153 0
            emphasis_0 81 18 17
            emphasis_1 74 27 8
            emphasis_2 76 19 47
            emphasis_3 12 44 66
        }
        ribbon_unselected {
            base 253 246 227
            background 95 116 124
            emphasis_0 253 243 243
            emphasis_1 115 112 103
            emphasis_2 239 246 252
            emphasis_3 252 243 248
        }
        table_title {
            base 104 120 0
            background 0
            emphasis_0 196 72 21
            emphasis_1 33 126 119
            emphasis_2 104 120 0
            emphasis_3 202 52 124
        }
        table_cell_selected {
            base 107 105 96
            background 238 234 217
            emphasis_0 183 68 20
            emphasis_1 31 117 111
            emphasis_2 98 112 0
            emphasis_3 189 48 117
        }
        table_cell_unselected {
            base 95 116 124
            background 253 246 227
            emphasis_0 196 72 21
            emphasis_1 33 126 119
            emphasis_2 104 120 0
            emphasis_3 202 52 124
        }
        list_selected {
            base 107 105 96
            background 238 234 217
            emphasis_0 183 68 20
            emphasis_1 31 117 111
            emphasis_2 98 112 0
            emphasis_3 189 48 117
        }
        list_unselected {
            base 95 116 124
            background 253 246 227
            emphasis_0 196 72 21
            emphasis_1 33 126 119
            emphasis_2 104 120 0
            emphasis_3 202 52 124
        }
        frame_unselected {
            base 95 116 124
            background 0
            emphasis_0 196 72 21
            emphasis_1 33 126 119
            emphasis_2 202 52 124
            emphasis_3 0
        }
        frame_selected {
            base 104 120 0
            background 0
            emphasis_0 196 72 21
            emphasis_1 33 126 119
            emphasis_2 202 52 124
            emphasis_3 0
        }
        frame_highlight {
            base 196 72 21
            background 0
            emphasis_0 202 52 124
            emphasis_1 196 72 21
            emphasis_2 196 72 21
            emphasis_3 196 72 21
        }
        exit_code_success {
            base 104 120 0
            background 0
            emphasis_0 33 126 119
            emphasis_1 7 54 66
            emphasis_2 202 52 124
            emphasis_3 32 118 179
        }
        exit_code_error {
            base 213 48 46
            background 0
            emphasis_0 143 108 0
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 202 52 124
            player_2 32 118 179
            player_3 116 113 104
            player_4 143 108 0
            player_5 33 126 119
            player_6 116 113 104
            player_7 213 48 46
            player_8 116 113 104
            player_9 116 113 104
            player_10 116 113 104
        }
    }
}
