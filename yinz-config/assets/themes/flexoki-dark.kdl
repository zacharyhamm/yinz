themes {
    flexoki-dark {
        // Terminal palette: https://github.com/kepano/flexoki/blob/main/kitty/flexoki_dark.conf
        pane_surround "#040303"
        terminal {
            foreground "#cecdc3"
            background "#100f0f"
            black "#100f0f"
            red "#af3029"
            green "#66800b"
            yellow "#ad8301"
            blue "#205ea6"
            magenta "#a02f6f"
            cyan "#24837b"
            white "#878580"
            bright_black "#6f6e69"
            bright_red "#d14d41"
            bright_green "#879a39"
            bright_yellow "#d0a215"
            bright_blue "#4385be"
            bright_magenta "#ce5d97"
            bright_cyan "#3aa99f"
            bright_white "#cecdc3"
        }
        text_unselected {
            base 206 205 195
            background 40 39 38
            emphasis_0 218 112 44
            emphasis_1 58 169 159
            emphasis_2 135 154 57
            emphasis_3 139 126 200
        }
        text_selected {
            base 40 39 38
            background 206 205 195
            emphasis_0 "#87451b"
            emphasis_1 "#21605a"
            emphasis_2 "#515c22"
            emphasis_3 "#595181"
        }
        ribbon_selected {
            base 40 39 38
            background 208 162 21
            emphasis_0 16 15 15
            emphasis_1 175 48 41
            emphasis_2 94 64 157
            emphasis_3 32 94 166
        }
        ribbon_unselected {
            base 40 39 38
            background 183 181 172
            emphasis_0 64 62 60
            emphasis_1 202 119 114
            emphasis_2 94 64 157
            emphasis_3 32 94 166
        }
        table_title {
            base 208 162 21
            background 0
            emphasis_0 218 112 44
            emphasis_1 58 169 159
            emphasis_2 135 154 57
            emphasis_3 139 126 200
        }
        table_cell_selected {
            base 206 205 195
            background 52 51 49
            emphasis_0 218 112 44
            emphasis_1 58 169 159
            emphasis_2 135 154 57
            emphasis_3 139 126 200
        }
        table_cell_unselected {
            base 206 205 195
            background 40 39 38
            emphasis_0 218 112 44
            emphasis_1 58 169 159
            emphasis_2 135 154 57
            emphasis_3 139 126 200
        }
        list_selected {
            base 206 205 195
            background 52 51 49
            emphasis_0 218 112 44
            emphasis_1 58 169 159
            emphasis_2 135 154 57
            emphasis_3 139 126 200
        }
        list_unselected {
            base 206 205 195
            background 40 39 38
            emphasis_0 218 112 44
            emphasis_1 58 169 159
            emphasis_2 135 154 57
            emphasis_3 139 126 200
        }
        frame_unselected {
            base 142 142 140
            background 0
            emphasis_0 218 112 44
            emphasis_1 58 169 159
            emphasis_2 139 126 200
            emphasis_3 0
        }
        frame_selected {
            base 208 162 21
            background 0
            emphasis_0 218 112 44
            emphasis_1 58 169 159
            emphasis_2 139 126 200
            emphasis_3 0
        }
        frame_highlight {
            base 218 113 45
            background 0
            emphasis_0 145 132 203
            emphasis_1 218 113 45
            emphasis_2 218 112 44
            emphasis_3 218 112 44
        }
        exit_code_success {
            base 135 154 57
            background 0
            emphasis_0 58 169 159
            emphasis_1 40 39 38
            emphasis_2 139 126 200
            emphasis_3 67 133 190
        }
        exit_code_error {
            base 209 77 65
            background 0
            emphasis_0 208 162 21
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 145 132 203
            player_2 88 147 197
            player_3 142 142 142
            player_4 208 162 21
            player_5 58 169 159
            player_6 142 142 142
            player_7 218 110 100
            player_8 142 142 142
            player_9 142 142 142
            player_10 142 142 142
        }
    }
}
