themes {
    "tailwind-light" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Tailwind%20Light
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#eeeeee"
        terminal {
            foreground "#0a0a0a"
            background "#fafafa"
            black "#262626"
            red "#b91c1c"
            green "#15803d"
            yellow "#a16207"
            blue "#0369a1"
            magenta "#a21caf"
            cyan "#0f766e"
            white "#bababa"
            bright_black "#737373"
            bright_red "#dc2626"
            bright_green "#16a34a"
            bright_yellow "#ca8a04"
            bright_blue "#0284c7"
            bright_magenta "#c026d3"
            bright_cyan "#0d9488"
            bright_white "#e5e5e5"
        }
        text_unselected {
            base "#0a0a0a"
            background "#fafafa"
            emphasis_0 "#a16207"
            emphasis_1 "#0f766e"
            emphasis_2 "#15803d"
            emphasis_3 "#a21caf"
        }
        text_selected {
            base "#fafafa"
            background "#0a0a0a"
            emphasis_0 "#a26f24"
            emphasis_1 "#2e867f"
            emphasis_2 "#318952"
            emphasis_3 "#b64cc0"
        }
        table_cell_unselected {
            base "#0a0a0a"
            background "#fafafa"
            emphasis_0 "#a16207"
            emphasis_1 "#0f766e"
            emphasis_2 "#15803d"
            emphasis_3 "#a21caf"
        }
        table_cell_selected {
            base "#0a0a0a"
            background "#e2e8f0"
            emphasis_0 "#955b06"
            emphasis_1 "#0f746c"
            emphasis_2 "#147839"
            emphasis_3 "#a21caf"
        }
        list_unselected {
            base "#0a0a0a"
            background "#fafafa"
            emphasis_0 "#a16207"
            emphasis_1 "#0f766e"
            emphasis_2 "#15803d"
            emphasis_3 "#a21caf"
        }
        list_selected {
            base "#0a0a0a"
            background "#e2e8f0"
            emphasis_0 "#955b06"
            emphasis_1 "#0f746c"
            emphasis_2 "#147839"
            emphasis_3 "#a21caf"
        }
        ribbon_selected {
            base "#fafafa"
            background "#15803d"
            emphasis_0 "#fbf1f1"
            emphasis_1 "#f7f2eb"
            emphasis_2 "#f9f0fa"
            emphasis_3 "#ecf4f8"
        }
        ribbon_unselected {
            base "#fafafa"
            background "#0a0a0a"
            emphasis_0 "#c95151"
            emphasis_1 "#0a0a0a"
            emphasis_2 "#2a80af"
            emphasis_3 "#b64cc0"
        }
        table_title {
            base "#15803d"
            background "#fafafa"
            emphasis_0 "#a16207"
            emphasis_1 "#0f766e"
            emphasis_2 "#15803d"
            emphasis_3 "#a21caf"
        }
        frame_unselected {
            base "#0a0a0a"
            background "#fafafa"
            emphasis_0 "#0a0a0a"
            emphasis_1 "#0a0a0a"
            emphasis_2 "#0a0a0a"
            emphasis_3 "#0a0a0a"
        }
        frame_selected {
            base "#15803d"
            background "#fafafa"
            emphasis_0 "#a16207"
            emphasis_1 "#0f766e"
            emphasis_2 "#15803d"
            emphasis_3 "#a21caf"
        }
        frame_highlight {
            base "#a16207"
            background "#fafafa"
            emphasis_0 "#a21caf"
            emphasis_1 "#a16207"
            emphasis_2 "#a16207"
            emphasis_3 "#a16207"
        }
        exit_code_success {
            base "#15803d"
            background "#fafafa"
            emphasis_0 "#0f766e"
            emphasis_1 "#0a0a0a"
            emphasis_2 "#a21caf"
            emphasis_3 "#0369a1"
        }
        exit_code_error {
            base "#b91c1c"
            background "#fafafa"
            emphasis_0 "#a16207"
            emphasis_1 "#0a0a0a"
            emphasis_2 "#a21caf"
            emphasis_3 "#0369a1"
        }
        multiplayer_user_colors {
            player_1 "#a21caf"
            player_2 "#0369a1"
            player_3 "#c026d3"
            player_4 "#a16207"
            player_5 "#0f766e"
            player_6 "#9b6a03"
            player_7 "#b91c1c"
            player_8 "#737373"
            player_9 "#dc2626"
            player_10 "#027ab7"
        }
    }
}
