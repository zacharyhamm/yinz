themes {
    "sauber" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Sauber
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#e0f3d9"
        terminal {
            foreground "#1345f6"
            background "#ecffe5"
            black "#14191e"
            red "#b43c2a"
            green "#00c200"
            yellow "#c7c400"
            blue "#2744c7"
            magenta "#c040be"
            cyan "#00c5c7"
            white "#bababa"
            bright_black "#686868"
            bright_red "#dd7975"
            bright_green "#3fcd76"
            bright_yellow "#c6bb00"
            bright_blue "#a7abf2"
            bright_magenta "#e17ee1"
            bright_cyan "#048b8f"
            bright_white "#a4801c"
        }
        text_unselected {
            base "#1345f6"
            background "#ecffe5"
            emphasis_0 "#787600"
            emphasis_1 "#008082"
            emphasis_2 "#008600"
            emphasis_3 "#b93eb7"
        }
        text_selected {
            base "#ecffe5"
            background "#1345f6"
            emphasis_0 "#d8d8c1"
            emphasis_1 "#c3dbdb"
            emphasis_2 "#c4ddc4"
            emphasis_3 "#e7d0e6"
        }
        table_cell_unselected {
            base "#1345f6"
            background "#ecffe5"
            emphasis_0 "#787600"
            emphasis_1 "#008082"
            emphasis_2 "#008600"
            emphasis_3 "#b93eb7"
        }
        table_cell_selected {
            base "#000000"
            background "#b3d7ff"
            emphasis_0 "#5f5e00"
            emphasis_1 "#006667"
            emphasis_2 "#006b00"
            emphasis_3 "#943193"
        }
        list_unselected {
            base "#1345f6"
            background "#ecffe5"
            emphasis_0 "#787600"
            emphasis_1 "#008082"
            emphasis_2 "#008600"
            emphasis_3 "#b93eb7"
        }
        list_selected {
            base "#000000"
            background "#b3d7ff"
            emphasis_0 "#5f5e00"
            emphasis_1 "#006667"
            emphasis_2 "#006b00"
            emphasis_3 "#943193"
        }
        ribbon_selected {
            base "#393e38"
            background "#00c200"
            emphasis_0 "#6d241a"
            emphasis_1 "#403f00"
            emphasis_2 "#632162"
            emphasis_3 "#1d3293"
        }
        ribbon_unselected {
            base "#ecffe5"
            background "#1345f6"
            emphasis_0 "#edd0cb"
            emphasis_1 "#1345f6"
            emphasis_2 "#cfd5f2"
            emphasis_3 "#eeccee"
        }
        table_title {
            base "#008600"
            background "#ecffe5"
            emphasis_0 "#787600"
            emphasis_1 "#008082"
            emphasis_2 "#008600"
            emphasis_3 "#b93eb7"
        }
        frame_unselected {
            base "#1345f6"
            background "#ecffe5"
            emphasis_0 "#1345f6"
            emphasis_1 "#1345f6"
            emphasis_2 "#1345f6"
            emphasis_3 "#1345f6"
        }
        frame_selected {
            base "#008600"
            background "#ecffe5"
            emphasis_0 "#787600"
            emphasis_1 "#008082"
            emphasis_2 "#008600"
            emphasis_3 "#b93eb7"
        }
        frame_highlight {
            base "#787600"
            background "#ecffe5"
            emphasis_0 "#b93eb7"
            emphasis_1 "#787600"
            emphasis_2 "#787600"
            emphasis_3 "#787600"
        }
        exit_code_success {
            base "#008600"
            background "#ecffe5"
            emphasis_0 "#008082"
            emphasis_1 "#1345f6"
            emphasis_2 "#b93eb7"
            emphasis_3 "#2744c7"
        }
        exit_code_error {
            base "#b43c2a"
            background "#ecffe5"
            emphasis_0 "#787600"
            emphasis_1 "#1345f6"
            emphasis_2 "#b93eb7"
            emphasis_3 "#2744c7"
        }
        multiplayer_user_colors {
            player_1 "#b93eb7"
            player_2 "#2744c7"
            player_3 "#a059a0"
            player_4 "#787600"
            player_5 "#008082"
            player_6 "#7c7500"
            player_7 "#b43c2a"
            player_8 "#737373"
            player_9 "#aa5d5a"
            player_10 "#6d6f9e"
        }
    }
}
