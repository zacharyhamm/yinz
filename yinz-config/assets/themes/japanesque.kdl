themes {
    "japanesque" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Japanesque
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#121212"
        terminal {
            foreground "#f7f6ec"
            background "#1e1e1e"
            black "#343935"
            red "#cf3f61"
            green "#7bb75b"
            yellow "#e9b32a"
            blue "#4c9ad4"
            magenta "#a57fc4"
            cyan "#389aad"
            white "#fafaf6"
            bright_black "#595b59"
            bright_red "#d18fa6"
            bright_green "#767f2c"
            bright_yellow "#78592f"
            bright_blue "#135979"
            bright_magenta "#604291"
            bright_cyan "#76bbca"
            bright_white "#b2b5ae"
        }
        text_unselected {
            base "#f7f6ec"
            background "#1e1e1e"
            emphasis_0 "#e9b32a"
            emphasis_1 "#389aad"
            emphasis_2 "#7bb75b"
            emphasis_3 "#a57fc4"
        }
        text_selected {
            base "#1e1e1e"
            background "#f7f6ec"
            emphasis_0 "#886d2c"
            emphasis_1 "#5a757b"
            emphasis_2 "#617755"
            emphasis_3 "#776c80"
        }
        table_cell_unselected {
            base "#f7f6ec"
            background "#1e1e1e"
            emphasis_0 "#e9b32a"
            emphasis_1 "#389aad"
            emphasis_2 "#7bb75b"
            emphasis_3 "#a57fc4"
        }
        table_cell_selected {
            base "#f7f6ec"
            background "#175877"
            emphasis_0 "#edbf4c"
            emphasis_1 "#9dcdd7"
            emphasis_2 "#aad095"
            emphasis_3 "#d1bee1"
        }
        list_unselected {
            base "#f7f6ec"
            background "#1e1e1e"
            emphasis_0 "#e9b32a"
            emphasis_1 "#389aad"
            emphasis_2 "#7bb75b"
            emphasis_3 "#a57fc4"
        }
        list_selected {
            base "#f7f6ec"
            background "#175877"
            emphasis_0 "#edbf4c"
            emphasis_1 "#9dcdd7"
            emphasis_2 "#aad095"
            emphasis_3 "#d1bee1"
        }
        ribbon_selected {
            base "#1e1e1e"
            background "#7bb75b"
            emphasis_0 "#6e2234"
            emphasis_1 "#4d3b0e"
            emphasis_2 "#473755"
            emphasis_3 "#204058"
        }
        ribbon_unselected {
            base "#1e1e1e"
            background "#f7f6ec"
            emphasis_0 "#c83d5e"
            emphasis_1 "#f7f6ec"
            emphasis_2 "#3a76a2"
            emphasis_3 "#82649a"
        }
        table_title {
            base "#7bb75b"
            background "#1e1e1e"
            emphasis_0 "#e9b32a"
            emphasis_1 "#389aad"
            emphasis_2 "#7bb75b"
            emphasis_3 "#a57fc4"
        }
        frame_unselected {
            base "#f7f6ec"
            background "#1e1e1e"
            emphasis_0 "#f7f6ec"
            emphasis_1 "#f7f6ec"
            emphasis_2 "#f7f6ec"
            emphasis_3 "#f7f6ec"
        }
        frame_selected {
            base "#7bb75b"
            background "#1e1e1e"
            emphasis_0 "#e9b32a"
            emphasis_1 "#389aad"
            emphasis_2 "#7bb75b"
            emphasis_3 "#a57fc4"
        }
        frame_highlight {
            base "#e9b32a"
            background "#1e1e1e"
            emphasis_0 "#a57fc4"
            emphasis_1 "#e9b32a"
            emphasis_2 "#e9b32a"
            emphasis_3 "#e9b32a"
        }
        exit_code_success {
            base "#7bb75b"
            background "#1e1e1e"
            emphasis_0 "#389aad"
            emphasis_1 "#f7f6ec"
            emphasis_2 "#a57fc4"
            emphasis_3 "#4c9ad4"
        }
        exit_code_error {
            base "#d75d7a"
            background "#1e1e1e"
            emphasis_0 "#e9b32a"
            emphasis_1 "#f7f6ec"
            emphasis_2 "#a57fc4"
            emphasis_3 "#4c9ad4"
        }
        multiplayer_user_colors {
            player_1 "#a57fc4"
            player_2 "#4c9ad4"
            player_3 "#917cb3"
            player_4 "#e9b32a"
            player_5 "#389aad"
            player_6 "#998162"
            player_7 "#d75d7a"
            player_8 "#fafaf6"
            player_9 "#d18fa6"
            player_10 "#5b8ca2"
        }
    }
}
