themes {
    "noctis-minimus" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Noctis%20Minimus
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#0f1d26"
        terminal {
            foreground "#c5cdd3"
            background "#1b2932"
            black "#182a35"
            red "#c08872"
            green "#72c09f"
            yellow "#c8a984"
            blue "#6196b8"
            magenta "#c28097"
            cyan "#72b7c0"
            white "#c5cdd3"
            bright_black "#425866"
            bright_red "#ca8468"
            bright_green "#84c8ab"
            bright_yellow "#d1aa7b"
            bright_blue "#68a4ca"
            bright_magenta "#c88da2"
            bright_cyan "#84c0c8"
            bright_white "#c5d1d3"
        }
        text_unselected {
            base "#c5cdd3"
            background "#1b2932"
            emphasis_0 "#c8a984"
            emphasis_1 "#72b7c0"
            emphasis_2 "#72c09f"
            emphasis_3 "#c28097"
        }
        text_selected {
            base "#1b2932"
            background "#c5cdd3"
            emphasis_0 "#645442"
            emphasis_1 "#395c60"
            emphasis_2 "#385e4e"
            emphasis_3 "#6c4e59"
        }
        table_cell_unselected {
            base "#c5cdd3"
            background "#1b2932"
            emphasis_0 "#c8a984"
            emphasis_1 "#72b7c0"
            emphasis_2 "#72c09f"
            emphasis_3 "#c28097"
        }
        table_cell_selected {
            base "#c5cdd3"
            background "#263c4a"
            emphasis_0 "#c8a984"
            emphasis_1 "#72b7c0"
            emphasis_2 "#72c09f"
            emphasis_3 "#cb93a6"
        }
        list_unselected {
            base "#c5cdd3"
            background "#1b2932"
            emphasis_0 "#c8a984"
            emphasis_1 "#72b7c0"
            emphasis_2 "#72c09f"
            emphasis_3 "#c28097"
        }
        list_selected {
            base "#c5cdd3"
            background "#263c4a"
            emphasis_0 "#c8a984"
            emphasis_1 "#72b7c0"
            emphasis_2 "#72c09f"
            emphasis_3 "#cb93a6"
        }
        ribbon_selected {
            base "#1b2932"
            background "#72c09f"
            emphasis_0 "#583e34"
            emphasis_1 "#4e4234"
            emphasis_2 "#5a3b46"
            emphasis_3 "#2e4757"
        }
        ribbon_unselected {
            base "#1b2932"
            background "#c5cdd3"
            emphasis_0 "#704f43"
            emphasis_1 "#c5cdd3"
            emphasis_2 "#3a5a6e"
            emphasis_3 "#724b59"
        }
        table_title {
            base "#72c09f"
            background "#1b2932"
            emphasis_0 "#c8a984"
            emphasis_1 "#72b7c0"
            emphasis_2 "#72c09f"
            emphasis_3 "#c28097"
        }
        frame_unselected {
            base "#c5cdd3"
            background "#1b2932"
            emphasis_0 "#c5cdd3"
            emphasis_1 "#c5cdd3"
            emphasis_2 "#c5cdd3"
            emphasis_3 "#c5cdd3"
        }
        frame_selected {
            base "#72c09f"
            background "#1b2932"
            emphasis_0 "#c8a984"
            emphasis_1 "#72b7c0"
            emphasis_2 "#72c09f"
            emphasis_3 "#c28097"
        }
        frame_highlight {
            base "#c8a984"
            background "#1b2932"
            emphasis_0 "#c28097"
            emphasis_1 "#c8a984"
            emphasis_2 "#c8a984"
            emphasis_3 "#c8a984"
        }
        exit_code_success {
            base "#72c09f"
            background "#1b2932"
            emphasis_0 "#72b7c0"
            emphasis_1 "#c5cdd3"
            emphasis_2 "#c28097"
            emphasis_3 "#6196b8"
        }
        exit_code_error {
            base "#c08872"
            background "#1b2932"
            emphasis_0 "#c8a984"
            emphasis_1 "#c5cdd3"
            emphasis_2 "#c28097"
            emphasis_3 "#6196b8"
        }
        multiplayer_user_colors {
            player_1 "#c28097"
            player_2 "#6196b8"
            player_3 "#c88da2"
            player_4 "#c8a984"
            player_5 "#72b7c0"
            player_6 "#d1aa7b"
            player_7 "#c08872"
            player_8 "#c5cdd3"
            player_9 "#ca8468"
            player_10 "#68a4ca"
        }
    }
}
