themes {
    "london-columbia-road" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/London%20Columbia%20Road
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#ece9e0"
        terminal {
            foreground "#1f3a2f"
            background "#f8f5ec"
            black "#2a2520"
            red "#c14a4a"
            green "#5a8a3a"
            yellow "#d4a82c"
            blue "#3a7a8a"
            magenta "#c45f8a"
            cyan "#5fa89a"
            white "#1f3a2f"
            bright_black "#756a55"
            bright_red "#d96a6a"
            bright_green "#6ea050"
            bright_yellow "#d8af33"
            bright_blue "#5598ab"
            bright_magenta "#d97aa3"
            bright_cyan "#7ac0b0"
            bright_white "#142217"
        }
        text_unselected {
            base "#1f3a2f"
            background "#f8f5ec"
            emphasis_0 "#896d1c"
            emphasis_1 "#457a70"
            emphasis_2 "#507b34"
            emphasis_3 "#ac5379"
        }
        text_selected {
            base "#f8f5ec"
            background "#1f3a2f"
            emphasis_0 "#ad9b6d"
            emphasis_1 "#84a39d"
            emphasis_2 "#8ba47a"
            emphasis_3 "#c28fa4"
        }
        table_cell_unselected {
            base "#1f3a2f"
            background "#f8f5ec"
            emphasis_0 "#896d1c"
            emphasis_1 "#457a70"
            emphasis_2 "#507b34"
            emphasis_3 "#ac5379"
        }
        table_cell_selected {
            base "#1f3a2f"
            background "#ece5d0"
            emphasis_0 "#7e631a"
            emphasis_1 "#3f6f66"
            emphasis_2 "#4a7130"
            emphasis_3 "#9d4c6e"
        }
        list_unselected {
            base "#1f3a2f"
            background "#f8f5ec"
            emphasis_0 "#896d1c"
            emphasis_1 "#457a70"
            emphasis_2 "#507b34"
            emphasis_3 "#ac5379"
        }
        list_selected {
            base "#1f3a2f"
            background "#ece5d0"
            emphasis_0 "#7e631a"
            emphasis_1 "#3f6f66"
            emphasis_2 "#4a7130"
            emphasis_3 "#9d4c6e"
        }
        ribbon_selected {
            base "#141413"
            background "#5a8a3a"
            emphasis_0 "#230d0d"
            emphasis_1 "#181305"
            emphasis_2 "#1f0f16"
            emphasis_3 "#0a1518"
        }
        ribbon_unselected {
            base "#f8f5ec"
            background "#1f3a2f"
            emphasis_0 "#d68787"
            emphasis_1 "#1f3a2f"
            emphasis_2 "#78a4af"
            emphasis_3 "#d286a6"
        }
        table_title {
            base "#507b34"
            background "#f8f5ec"
            emphasis_0 "#896d1c"
            emphasis_1 "#457a70"
            emphasis_2 "#507b34"
            emphasis_3 "#ac5379"
        }
        frame_unselected {
            base "#1f3a2f"
            background "#f8f5ec"
            emphasis_0 "#1f3a2f"
            emphasis_1 "#1f3a2f"
            emphasis_2 "#1f3a2f"
            emphasis_3 "#1f3a2f"
        }
        frame_selected {
            base "#507b34"
            background "#f8f5ec"
            emphasis_0 "#896d1c"
            emphasis_1 "#457a70"
            emphasis_2 "#507b34"
            emphasis_3 "#ac5379"
        }
        frame_highlight {
            base "#896d1c"
            background "#f8f5ec"
            emphasis_0 "#ac5379"
            emphasis_1 "#896d1c"
            emphasis_2 "#896d1c"
            emphasis_3 "#896d1c"
        }
        exit_code_success {
            base "#507b34"
            background "#f8f5ec"
            emphasis_0 "#457a70"
            emphasis_1 "#1f3a2f"
            emphasis_2 "#ac5379"
            emphasis_3 "#3a7989"
        }
        exit_code_error {
            base "#bf4949"
            background "#f8f5ec"
            emphasis_0 "#896d1c"
            emphasis_1 "#1f3a2f"
            emphasis_2 "#ac5379"
            emphasis_3 "#3a7989"
        }
        multiplayer_user_colors {
            player_1 "#ac5379"
            player_2 "#3a7989"
            player_3 "#a15a79"
            player_4 "#896d1c"
            player_5 "#457a70"
            player_6 "#876d20"
            player_7 "#bf4949"
            player_8 "#1f3a2f"
            player_9 "#ae5555"
            player_10 "#437887"
        }
    }
}
