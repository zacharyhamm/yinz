themes {
    "sugarplum" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Sugarplum
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#05053b"
        terminal {
            foreground "#db7ddd"
            background "#111147"
            black "#111147"
            red "#5ca8dc"
            green "#53b397"
            yellow "#249a84"
            blue "#db7ddd"
            magenta "#d0beee"
            cyan "#f9f3f9"
            white "#a175d4"
            bright_black "#44447a"
            bright_red "#5cb5dc"
            bright_green "#52deb5"
            bright_yellow "#01f5c7"
            bright_blue "#fa5dfd"
            bright_magenta "#c6a5fd"
            bright_cyan "#ffffff"
            bright_white "#b577fd"
        }
        text_unselected {
            base "#db7ddd"
            background "#111147"
            emphasis_0 "#249a84"
            emphasis_1 "#f9f3f9"
            emphasis_2 "#53b397"
            emphasis_3 "#d0beee"
        }
        text_selected {
            base "#3b3640"
            background "#5ca8dc"
            emphasis_0 "#0f3f36"
            emphasis_1 "#393739"
            emphasis_2 "#1d3e35"
            emphasis_3 "#3b3643"
        }
        table_cell_unselected {
            base "#db7ddd"
            background "#111147"
            emphasis_0 "#249a84"
            emphasis_1 "#f9f3f9"
            emphasis_2 "#53b397"
            emphasis_3 "#d0beee"
        }
        table_cell_selected {
            base "#3b3640"
            background "#5ca8dc"
            emphasis_0 "#0f3f36"
            emphasis_1 "#393739"
            emphasis_2 "#1d3e35"
            emphasis_3 "#3b3643"
        }
        list_unselected {
            base "#db7ddd"
            background "#111147"
            emphasis_0 "#249a84"
            emphasis_1 "#f9f3f9"
            emphasis_2 "#53b397"
            emphasis_3 "#d0beee"
        }
        list_selected {
            base "#3b3640"
            background "#5ca8dc"
            emphasis_0 "#0f3f36"
            emphasis_1 "#393739"
            emphasis_2 "#1d3e35"
            emphasis_3 "#3b3643"
        }
        ribbon_selected {
            base "#111147"
            background "#53b397"
            emphasis_0 "#213c4f"
            emphasis_1 "#0f4138"
            emphasis_2 "#3c3745"
            emphasis_3 "#4f2d50"
        }
        ribbon_unselected {
            base "#111147"
            background "#db7ddd"
            emphasis_0 "#203a4c"
            emphasis_1 "#db7ddd"
            emphasis_2 "#4c2c4d"
            emphasis_3 "#3a3542"
        }
        table_title {
            base "#53b397"
            background "#111147"
            emphasis_0 "#249a84"
            emphasis_1 "#f9f3f9"
            emphasis_2 "#53b397"
            emphasis_3 "#d0beee"
        }
        frame_unselected {
            base "#db7ddd"
            background "#111147"
            emphasis_0 "#db7ddd"
            emphasis_1 "#db7ddd"
            emphasis_2 "#db7ddd"
            emphasis_3 "#db7ddd"
        }
        frame_selected {
            base "#53b397"
            background "#111147"
            emphasis_0 "#249a84"
            emphasis_1 "#f9f3f9"
            emphasis_2 "#53b397"
            emphasis_3 "#d0beee"
        }
        frame_highlight {
            base "#249a84"
            background "#111147"
            emphasis_0 "#d0beee"
            emphasis_1 "#249a84"
            emphasis_2 "#249a84"
            emphasis_3 "#249a84"
        }
        exit_code_success {
            base "#53b397"
            background "#111147"
            emphasis_0 "#f9f3f9"
            emphasis_1 "#db7ddd"
            emphasis_2 "#d0beee"
            emphasis_3 "#db7ddd"
        }
        exit_code_error {
            base "#5ca8dc"
            background "#111147"
            emphasis_0 "#249a84"
            emphasis_1 "#db7ddd"
            emphasis_2 "#d0beee"
            emphasis_3 "#db7ddd"
        }
        multiplayer_user_colors {
            player_1 "#d0beee"
            player_2 "#db7ddd"
            player_3 "#c6a5fd"
            player_4 "#249a84"
            player_5 "#f9f3f9"
            player_6 "#01f5c7"
            player_7 "#5ca8dc"
            player_8 "#a175d4"
            player_9 "#5cb5dc"
            player_10 "#fa5dfd"
        }
    }
}
