themes {
    "tango-adapted" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Tango%20Adapted
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#f3f3f3"
        terminal {
            foreground "#000000"
            background "#ffffff"
            black "#000000"
            red "#ff0000"
            green "#59d600"
            yellow "#e3be00"
            blue "#00a2ff"
            magenta "#c17ecc"
            cyan "#00d0d6"
            white "#c0c5bb"
            bright_black "#8f928b"
            bright_red "#ff0013"
            bright_green "#6dd900"
            bright_yellow "#ccbe00"
            bright_blue "#88c9ff"
            bright_magenta "#e9a7e1"
            bright_cyan "#00d8d9"
            bright_white "#f6f6f4"
        }
        text_unselected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#8c7500"
            emphasis_1 "#008488"
            emphasis_2 "#388700"
            emphasis_3 "#9863a1"
        }
        text_selected {
            base "#ffffff"
            background "#000000"
            emphasis_0 "#847421"
            emphasis_1 "#268184"
            emphasis_2 "#4b8223"
            emphasis_3 "#8d6893"
        }
        table_cell_unselected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#8c7500"
            emphasis_1 "#008488"
            emphasis_2 "#388700"
            emphasis_3 "#9863a1"
        }
        table_cell_selected {
            base "#000000"
            background "#c1deff"
            emphasis_0 "#725f00"
            emphasis_1 "#006b6e"
            emphasis_2 "#2e6e00"
            emphasis_3 "#7c5183"
        }
        list_unselected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#8c7500"
            emphasis_1 "#008488"
            emphasis_2 "#388700"
            emphasis_3 "#9863a1"
        }
        list_selected {
            base "#000000"
            background "#c1deff"
            emphasis_0 "#725f00"
            emphasis_1 "#006b6e"
            emphasis_2 "#2e6e00"
            emphasis_3 "#7c5183"
        }
        ribbon_selected {
            base "#4c4c4c"
            background "#59d600"
            emphasis_0 "#9e0000"
            emphasis_1 "#5a4b00"
            emphasis_2 "#624068"
            emphasis_3 "#00507e"
        }
        ribbon_unselected {
            base "#ffffff"
            background "#000000"
            emphasis_0 "#ff0000"
            emphasis_1 "#000000"
            emphasis_2 "#00a2ff"
            emphasis_3 "#c17ecc"
        }
        table_title {
            base "#388700"
            background "#ffffff"
            emphasis_0 "#8c7500"
            emphasis_1 "#008488"
            emphasis_2 "#388700"
            emphasis_3 "#9863a1"
        }
        frame_unselected {
            base "#000000"
            background "#ffffff"
            emphasis_0 "#000000"
            emphasis_1 "#000000"
            emphasis_2 "#000000"
            emphasis_3 "#000000"
        }
        frame_selected {
            base "#388700"
            background "#ffffff"
            emphasis_0 "#8c7500"
            emphasis_1 "#008488"
            emphasis_2 "#388700"
            emphasis_3 "#9863a1"
        }
        frame_highlight {
            base "#8c7500"
            background "#ffffff"
            emphasis_0 "#9863a1"
            emphasis_1 "#8c7500"
            emphasis_2 "#8c7500"
            emphasis_3 "#8c7500"
        }
        exit_code_success {
            base "#388700"
            background "#ffffff"
            emphasis_0 "#008488"
            emphasis_1 "#000000"
            emphasis_2 "#9863a1"
            emphasis_3 "#007bc2"
        }
        exit_code_error {
            base "#ee0000"
            background "#ffffff"
            emphasis_0 "#8c7500"
            emphasis_1 "#000000"
            emphasis_2 "#9863a1"
            emphasis_3 "#007bc2"
        }
        multiplayer_user_colors {
            player_1 "#9863a1"
            player_2 "#007bc2"
            player_3 "#93698e"
            player_4 "#8c7500"
            player_5 "#008488"
            player_6 "#817800"
            player_7 "#ee0000"
            player_8 "#747771"
            player_9 "#ee0012"
            player_10 "#537a9b"
        }
    }
}
