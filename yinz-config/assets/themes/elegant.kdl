themes {
    "elegant" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Elegant
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#1d1f25"
        terminal {
            foreground "#ced2d6"
            background "#292b31"
            black "#0a1222"
            red "#ff0257"
            green "#85cc95"
            yellow "#ffcb8b"
            blue "#8dabe1"
            magenta "#c792eb"
            cyan "#78ccf0"
            white "#ffffff"
            bright_black "#575656"
            bright_red "#ff0057"
            bright_green "#85cc95"
            bright_yellow "#ffcb8b"
            bright_blue "#8dabe1"
            bright_magenta "#c792eb"
            bright_cyan "#3facef"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#ced2d6"
            background "#292b31"
            emphasis_0 "#ffcb8b"
            emphasis_1 "#78ccf0"
            emphasis_2 "#85cc95"
            emphasis_3 "#c792eb"
        }
        text_selected {
            base "#144385"
            background "#d5d5d5"
            emphasis_0 "#6f583d"
            emphasis_1 "#3a6274"
            emphasis_2 "#416449"
            emphasis_3 "#6e5182"
        }
        table_cell_unselected {
            base "#ced2d6"
            background "#292b31"
            emphasis_0 "#ffcb8b"
            emphasis_1 "#78ccf0"
            emphasis_2 "#85cc95"
            emphasis_3 "#c792eb"
        }
        table_cell_selected {
            base "#144385"
            background "#d5d5d5"
            emphasis_0 "#6f583d"
            emphasis_1 "#3a6274"
            emphasis_2 "#416449"
            emphasis_3 "#6e5182"
        }
        list_unselected {
            base "#ced2d6"
            background "#292b31"
            emphasis_0 "#ffcb8b"
            emphasis_1 "#78ccf0"
            emphasis_2 "#85cc95"
            emphasis_3 "#c792eb"
        }
        list_selected {
            base "#144385"
            background "#d5d5d5"
            emphasis_0 "#6f583d"
            emphasis_1 "#3a6274"
            emphasis_2 "#416449"
            emphasis_3 "#6e5182"
        }
        ribbon_selected {
            base "#292b31"
            background "#85cc95"
            emphasis_0 "#9b0135"
            emphasis_1 "#5c4932"
            emphasis_2 "#5b426b"
            emphasis_3 "#3f4c65"
        }
        ribbon_unselected {
            base "#292b31"
            background "#ced2d6"
            emphasis_0 "#b6013e"
            emphasis_1 "#ced2d6"
            emphasis_2 "#4b5b78"
            emphasis_3 "#6c4f7f"
        }
        table_title {
            base "#85cc95"
            background "#292b31"
            emphasis_0 "#ffcb8b"
            emphasis_1 "#78ccf0"
            emphasis_2 "#85cc95"
            emphasis_3 "#c792eb"
        }
        frame_unselected {
            base "#ced2d6"
            background "#292b31"
            emphasis_0 "#ced2d6"
            emphasis_1 "#ced2d6"
            emphasis_2 "#ced2d6"
            emphasis_3 "#ced2d6"
        }
        frame_selected {
            base "#85cc95"
            background "#292b31"
            emphasis_0 "#ffcb8b"
            emphasis_1 "#78ccf0"
            emphasis_2 "#85cc95"
            emphasis_3 "#c792eb"
        }
        frame_highlight {
            base "#ffcb8b"
            background "#292b31"
            emphasis_0 "#c792eb"
            emphasis_1 "#ffcb8b"
            emphasis_2 "#ffcb8b"
            emphasis_3 "#ffcb8b"
        }
        exit_code_success {
            base "#85cc95"
            background "#292b31"
            emphasis_0 "#78ccf0"
            emphasis_1 "#ced2d6"
            emphasis_2 "#c792eb"
            emphasis_3 "#8dabe1"
        }
        exit_code_error {
            base "#ff4e8a"
            background "#292b31"
            emphasis_0 "#ffcb8b"
            emphasis_1 "#ced2d6"
            emphasis_2 "#c792eb"
            emphasis_3 "#8dabe1"
        }
        multiplayer_user_colors {
            player_1 "#c792eb"
            player_2 "#8dabe1"
            player_3 "#c792eb"
            player_4 "#ffcb8b"
            player_5 "#78ccf0"
            player_6 "#ffcb8b"
            player_7 "#ff4e8a"
            player_8 "#ffffff"
            player_9 "#ff4d8a"
            player_10 "#8dabe1"
        }
    }
}
