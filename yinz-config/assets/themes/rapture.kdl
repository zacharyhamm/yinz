themes {
    "rapture" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Rapture
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#05121e"
        terminal {
            foreground "#c0c9e5"
            background "#111e2a"
            black "#000000"
            red "#fc644d"
            green "#7afde1"
            yellow "#fff09b"
            blue "#6c9bf5"
            magenta "#ff4fa1"
            cyan "#64e0ff"
            white "#c0c9e5"
            bright_black "#304b66"
            bright_red "#fc644d"
            bright_green "#7afde1"
            bright_yellow "#fff09b"
            bright_blue "#6c9bf5"
            bright_magenta "#ff4fa1"
            bright_cyan "#64e0ff"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#c0c9e5"
            background "#111e2a"
            emphasis_0 "#fff09b"
            emphasis_1 "#64e0ff"
            emphasis_2 "#7afde1"
            emphasis_3 "#ff4fa1"
        }
        text_selected {
            base "#111e2a"
            background "#c0c9e5"
            emphasis_0 "#5a5537"
            emphasis_1 "#295b68"
            emphasis_2 "#2d5d53"
            emphasis_3 "#77465d"
        }
        table_cell_unselected {
            base "#c0c9e5"
            background "#111e2a"
            emphasis_0 "#fff09b"
            emphasis_1 "#64e0ff"
            emphasis_2 "#7afde1"
            emphasis_3 "#ff4fa1"
        }
        table_cell_selected {
            base "#ffffff"
            background "#304b66"
            emphasis_0 "#fff09b"
            emphasis_1 "#64e0ff"
            emphasis_2 "#7afde1"
            emphasis_3 "#ff97c7"
        }
        list_unselected {
            base "#c0c9e5"
            background "#111e2a"
            emphasis_0 "#fff09b"
            emphasis_1 "#64e0ff"
            emphasis_2 "#7afde1"
            emphasis_3 "#ff4fa1"
        }
        list_selected {
            base "#ffffff"
            background "#304b66"
            emphasis_0 "#fff09b"
            emphasis_1 "#64e0ff"
            emphasis_2 "#7afde1"
            emphasis_3 "#ff97c7"
        }
        ribbon_selected {
            base "#111e2a"
            background "#7afde1"
            emphasis_0 "#af4535"
            emphasis_1 "#6f6843"
            emphasis_2 "#b43872"
            emphasis_3 "#4867a3"
        }
        ribbon_unselected {
            base "#111e2a"
            background "#c0c9e5"
            emphasis_0 "#90392c"
            emphasis_1 "#c0c9e5"
            emphasis_2 "#3b5486"
            emphasis_3 "#942e5d"
        }
        table_title {
            base "#7afde1"
            background "#111e2a"
            emphasis_0 "#fff09b"
            emphasis_1 "#64e0ff"
            emphasis_2 "#7afde1"
            emphasis_3 "#ff4fa1"
        }
        frame_unselected {
            base "#c0c9e5"
            background "#111e2a"
            emphasis_0 "#c0c9e5"
            emphasis_1 "#c0c9e5"
            emphasis_2 "#c0c9e5"
            emphasis_3 "#c0c9e5"
        }
        frame_selected {
            base "#7afde1"
            background "#111e2a"
            emphasis_0 "#fff09b"
            emphasis_1 "#64e0ff"
            emphasis_2 "#7afde1"
            emphasis_3 "#ff4fa1"
        }
        frame_highlight {
            base "#fff09b"
            background "#111e2a"
            emphasis_0 "#ff4fa1"
            emphasis_1 "#fff09b"
            emphasis_2 "#fff09b"
            emphasis_3 "#fff09b"
        }
        exit_code_success {
            base "#7afde1"
            background "#111e2a"
            emphasis_0 "#64e0ff"
            emphasis_1 "#c0c9e5"
            emphasis_2 "#ff4fa1"
            emphasis_3 "#6c9bf5"
        }
        exit_code_error {
            base "#fc644d"
            background "#111e2a"
            emphasis_0 "#fff09b"
            emphasis_1 "#c0c9e5"
            emphasis_2 "#ff4fa1"
            emphasis_3 "#6c9bf5"
        }
        multiplayer_user_colors {
            player_1 "#ff4fa1"
            player_2 "#6c9bf5"
            player_3 "#ff4fa1"
            player_4 "#fff09b"
            player_5 "#64e0ff"
            player_6 "#fff09b"
            player_7 "#fc644d"
            player_8 "#c0c9e5"
            player_9 "#fc644d"
            player_10 "#6c9bf5"
        }
    }
}
