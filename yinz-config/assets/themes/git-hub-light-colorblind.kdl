themes {
    "git-hub-light-colorblind" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/GitHub%20Light%20Colorblind
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#f3f3f3"
        terminal {
            foreground "#24292f"
            background "#ffffff"
            black "#24292f"
            red "#b35900"
            green "#0550ae"
            yellow "#4d2d00"
            blue "#0969da"
            magenta "#8250df"
            cyan "#1b7c83"
            white "#6e7781"
            bright_black "#57606a"
            bright_red "#8a4600"
            bright_green "#0969da"
            bright_yellow "#633c01"
            bright_blue "#218bff"
            bright_magenta "#a475f9"
            bright_cyan "#3192aa"
            bright_white "#8c959f"
        }
        text_unselected {
            base "#24292f"
            background "#ffffff"
            emphasis_0 "#4d2d00"
            emphasis_1 "#1b7c83"
            emphasis_2 "#0550ae"
            emphasis_3 "#8250df"
        }
        text_selected {
            base "#ffffff"
            background "#24292f"
            emphasis_0 "#9e8d74"
            emphasis_1 "#4f9a9f"
            emphasis_2 "#6392cc"
            emphasis_3 "#a07be7"
        }
        table_cell_unselected {
            base "#24292f"
            background "#ffffff"
            emphasis_0 "#4d2d00"
            emphasis_1 "#1b7c83"
            emphasis_2 "#0550ae"
            emphasis_3 "#8250df"
        }
        table_cell_selected {
            base "#ffffff"
            background "#24292f"
            emphasis_0 "#9e8d74"
            emphasis_1 "#4f9a9f"
            emphasis_2 "#6392cc"
            emphasis_3 "#a07be7"
        }
        list_unselected {
            base "#24292f"
            background "#ffffff"
            emphasis_0 "#4d2d00"
            emphasis_1 "#1b7c83"
            emphasis_2 "#0550ae"
            emphasis_3 "#8250df"
        }
        list_selected {
            base "#ffffff"
            background "#24292f"
            emphasis_0 "#9e8d74"
            emphasis_1 "#4f9a9f"
            emphasis_2 "#6392cc"
            emphasis_3 "#a07be7"
        }
        ribbon_selected {
            base "#ffffff"
            background "#0550ae"
            emphasis_0 "#e3c2a1"
            emphasis_1 "#d0c7bb"
            emphasis_2 "#d1bff3"
            emphasis_3 "#a9cbf2"
        }
        ribbon_unselected {
            base "#ffffff"
            background "#24292f"
            emphasis_0 "#c57f3b"
            emphasis_1 "#24292f"
            emphasis_2 "#4b91e4"
            emphasis_3 "#a07be7"
        }
        table_title {
            base "#0550ae"
            background "#ffffff"
            emphasis_0 "#4d2d00"
            emphasis_1 "#1b7c83"
            emphasis_2 "#0550ae"
            emphasis_3 "#8250df"
        }
        frame_unselected {
            base "#24292f"
            background "#ffffff"
            emphasis_0 "#24292f"
            emphasis_1 "#24292f"
            emphasis_2 "#24292f"
            emphasis_3 "#24292f"
        }
        frame_selected {
            base "#0550ae"
            background "#ffffff"
            emphasis_0 "#4d2d00"
            emphasis_1 "#1b7c83"
            emphasis_2 "#0550ae"
            emphasis_3 "#8250df"
        }
        frame_highlight {
            base "#4d2d00"
            background "#ffffff"
            emphasis_0 "#8250df"
            emphasis_1 "#4d2d00"
            emphasis_2 "#4d2d00"
            emphasis_3 "#4d2d00"
        }
        exit_code_success {
            base "#0550ae"
            background "#ffffff"
            emphasis_0 "#1b7c83"
            emphasis_1 "#24292f"
            emphasis_2 "#8250df"
            emphasis_3 "#0969da"
        }
        exit_code_error {
            base "#b35900"
            background "#ffffff"
            emphasis_0 "#4d2d00"
            emphasis_1 "#24292f"
            emphasis_2 "#8250df"
            emphasis_3 "#0969da"
        }
        multiplayer_user_colors {
            player_1 "#8250df"
            player_2 "#0969da"
            player_3 "#8861cf"
            player_4 "#4d2d00"
            player_5 "#1b7c83"
            player_6 "#633c01"
            player_7 "#b35900"
            player_8 "#6e7781"
            player_9 "#8a4600"
            player_10 "#1c76d9"
        }
    }
}
