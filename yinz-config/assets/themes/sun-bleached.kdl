themes {
    "sun-bleached" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Sun%20Bleached
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#e4d3b7"
        terminal {
            foreground "#4a382f"
            background "#f0dfc3"
            black "#4a4038"
            red "#9e4935"
            green "#4b694d"
            yellow "#725a1c"
            blue "#3a6378"
            magenta "#76546e"
            cyan "#33656a"
            white "#594b40"
            bright_black "#65574d"
            bright_red "#904b37"
            bright_green "#506950"
            bright_yellow "#725c23"
            bright_blue "#426678"
            bright_magenta "#775a70"
            bright_cyan "#3a666a"
            bright_white "#302925"
        }
        text_unselected {
            base "#4a382f"
            background "#f0dfc3"
            emphasis_0 "#725a1c"
            emphasis_1 "#33656a"
            emphasis_2 "#4b694d"
            emphasis_3 "#76546e"
        }
        text_selected {
            base "#f0dfc3"
            background "#4a382f"
            emphasis_0 "#b1a586"
            emphasis_1 "#91aaac"
            emphasis_2 "#9ba99c"
            emphasis_3 "#b2a1ad"
        }
        table_cell_unselected {
            base "#4a382f"
            background "#f0dfc3"
            emphasis_0 "#725a1c"
            emphasis_1 "#33656a"
            emphasis_2 "#4b694d"
            emphasis_3 "#76546e"
        }
        table_cell_selected {
            base "#2e2825"
            background "#dfcbaa"
            emphasis_0 "#6b551a"
            emphasis_1 "#305f64"
            emphasis_2 "#435e45"
            emphasis_3 "#6e4e66"
        }
        list_unselected {
            base "#4a382f"
            background "#f0dfc3"
            emphasis_0 "#725a1c"
            emphasis_1 "#33656a"
            emphasis_2 "#4b694d"
            emphasis_3 "#76546e"
        }
        list_selected {
            base "#2e2825"
            background "#dfcbaa"
            emphasis_0 "#6b551a"
            emphasis_1 "#305f64"
            emphasis_2 "#435e45"
            emphasis_3 "#6e4e66"
        }
        ribbon_selected {
            base "#f0dfc3"
            background "#4b694d"
            emphasis_0 "#ebdad6"
            emphasis_1 "#e2ddd0"
            emphasis_2 "#e2dbe0"
            emphasis_3 "#d6dfe3"
        }
        ribbon_unselected {
            base "#f0dfc3"
            background "#4a382f"
            emphasis_0 "#ca9b90"
            emphasis_1 "#4a382f"
            emphasis_2 "#92a9b4"
            emphasis_3 "#b3a0ae"
        }
        table_title {
            base "#4b694d"
            background "#f0dfc3"
            emphasis_0 "#725a1c"
            emphasis_1 "#33656a"
            emphasis_2 "#4b694d"
            emphasis_3 "#76546e"
        }
        frame_unselected {
            base "#4a382f"
            background "#f0dfc3"
            emphasis_0 "#4a382f"
            emphasis_1 "#4a382f"
            emphasis_2 "#4a382f"
            emphasis_3 "#4a382f"
        }
        frame_selected {
            base "#4b694d"
            background "#f0dfc3"
            emphasis_0 "#725a1c"
            emphasis_1 "#33656a"
            emphasis_2 "#4b694d"
            emphasis_3 "#76546e"
        }
        frame_highlight {
            base "#725a1c"
            background "#f0dfc3"
            emphasis_0 "#76546e"
            emphasis_1 "#725a1c"
            emphasis_2 "#725a1c"
            emphasis_3 "#725a1c"
        }
        exit_code_success {
            base "#4b694d"
            background "#f0dfc3"
            emphasis_0 "#33656a"
            emphasis_1 "#4a382f"
            emphasis_2 "#76546e"
            emphasis_3 "#3a6378"
        }
        exit_code_error {
            base "#9e4935"
            background "#f0dfc3"
            emphasis_0 "#725a1c"
            emphasis_1 "#4a382f"
            emphasis_2 "#76546e"
            emphasis_3 "#3a6378"
        }
        multiplayer_user_colors {
            player_1 "#76546e"
            player_2 "#3a6378"
            player_3 "#775a70"
            player_4 "#725a1c"
            player_5 "#33656a"
            player_6 "#725c23"
            player_7 "#9e4935"
            player_8 "#594b40"
            player_9 "#904b37"
            player_10 "#426678"
        }
    }
}
