themes {
    "rhoads-legacy" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Rhoads%20Legacy
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000008"
        terminal {
            foreground "#c4b5fd"
            background "#0a0614"
            black "#18111f"
            red "#7c3aed"
            green "#d946ef"
            yellow "#f4d03f"
            blue "#6366f1"
            magenta "#a78bfa"
            cyan "#c4b5fd"
            white "#f8f6ed"
            bright_black "#4b3f72"
            bright_red "#d946ef"
            bright_green "#f472b6"
            bright_yellow "#fde68a"
            bright_blue "#7c9cff"
            bright_magenta "#e9d5ff"
            bright_cyan "#cbd5e1"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#c4b5fd"
            background "#0a0614"
            emphasis_0 "#f4d03f"
            emphasis_1 "#c4b5fd"
            emphasis_2 "#d946ef"
            emphasis_3 "#a78bfa"
        }
        text_selected {
            base "#0a0614"
            background "#c4b5fd"
            emphasis_0 "#5b4d17"
            emphasis_1 "#504a67"
            emphasis_2 "#6b3b72"
            emphasis_3 "#524675"
        }
        table_cell_unselected {
            base "#c4b5fd"
            background "#0a0614"
            emphasis_0 "#f4d03f"
            emphasis_1 "#c4b5fd"
            emphasis_2 "#d946ef"
            emphasis_3 "#a78bfa"
        }
        table_cell_selected {
            base "#fff7d6"
            background "#4c1d95"
            emphasis_0 "#f4d03f"
            emphasis_1 "#c4b5fd"
            emphasis_2 "#e57ff4"
            emphasis_3 "#b097fb"
        }
        list_unselected {
            base "#c4b5fd"
            background "#0a0614"
            emphasis_0 "#f4d03f"
            emphasis_1 "#c4b5fd"
            emphasis_2 "#d946ef"
            emphasis_3 "#a78bfa"
        }
        list_selected {
            base "#fff7d6"
            background "#4c1d95"
            emphasis_0 "#f4d03f"
            emphasis_1 "#c4b5fd"
            emphasis_2 "#e57ff4"
            emphasis_3 "#b097fb"
        }
        ribbon_selected {
            base "#0a0614"
            background "#d946ef"
            emphasis_0 "#2c1555"
            emphasis_1 "#29230b"
            emphasis_2 "#262039"
            emphasis_3 "#1e1f49"
        }
        ribbon_unselected {
            base "#0a0614"
            background "#c4b5fd"
            emphasis_0 "#5f2cb5"
            emphasis_1 "#c4b5fd"
            emphasis_2 "#41439e"
            emphasis_3 "#53457d"
        }
        table_title {
            base "#d946ef"
            background "#0a0614"
            emphasis_0 "#f4d03f"
            emphasis_1 "#c4b5fd"
            emphasis_2 "#d946ef"
            emphasis_3 "#a78bfa"
        }
        frame_unselected {
            base "#c4b5fd"
            background "#0a0614"
            emphasis_0 "#c4b5fd"
            emphasis_1 "#c4b5fd"
            emphasis_2 "#c4b5fd"
            emphasis_3 "#c4b5fd"
        }
        frame_selected {
            base "#d946ef"
            background "#0a0614"
            emphasis_0 "#f4d03f"
            emphasis_1 "#c4b5fd"
            emphasis_2 "#d946ef"
            emphasis_3 "#a78bfa"
        }
        frame_highlight {
            base "#f4d03f"
            background "#0a0614"
            emphasis_0 "#a78bfa"
            emphasis_1 "#f4d03f"
            emphasis_2 "#f4d03f"
            emphasis_3 "#f4d03f"
        }
        exit_code_success {
            base "#d946ef"
            background "#0a0614"
            emphasis_0 "#c4b5fd"
            emphasis_1 "#c4b5fd"
            emphasis_2 "#a78bfa"
            emphasis_3 "#6467f1"
        }
        exit_code_error {
            base "#8e56f0"
            background "#0a0614"
            emphasis_0 "#f4d03f"
            emphasis_1 "#c4b5fd"
            emphasis_2 "#a78bfa"
            emphasis_3 "#6467f1"
        }
        multiplayer_user_colors {
            player_1 "#a78bfa"
            player_2 "#6467f1"
            player_3 "#e9d5ff"
            player_4 "#f4d03f"
            player_5 "#c4b5fd"
            player_6 "#fde68a"
            player_7 "#8e56f0"
            player_8 "#f8f6ed"
            player_9 "#d946ef"
            player_10 "#7c9cff"
        }
    }
}
