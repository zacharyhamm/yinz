themes {
    "chalkboard" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Chalkboard
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#1d1a23"
        terminal {
            foreground "#d9e6f2"
            background "#29262f"
            black "#000000"
            red "#c37372"
            green "#72c373"
            yellow "#c2c372"
            blue "#7372c3"
            magenta "#c372c2"
            cyan "#72c2c3"
            white "#d9d9d9"
            bright_black "#585858"
            bright_red "#dbaaaa"
            bright_green "#aadbaa"
            bright_yellow "#dadbaa"
            bright_blue "#aaaadb"
            bright_magenta "#dbaada"
            bright_cyan "#aadadb"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#d9e6f2"
            background "#29262f"
            emphasis_0 "#c2c372"
            emphasis_1 "#72c2c3"
            emphasis_2 "#72c373"
            emphasis_3 "#c372c2"
        }
        text_selected {
            base "#29262f"
            background "#d9e6f2"
            emphasis_0 "#68693d"
            emphasis_1 "#406e6e"
            emphasis_2 "#427143"
            emphasis_3 "#865586"
        }
        table_cell_unselected {
            base "#d9e6f2"
            background "#29262f"
            emphasis_0 "#c2c372"
            emphasis_1 "#72c2c3"
            emphasis_2 "#72c373"
            emphasis_3 "#c372c2"
        }
        table_cell_selected {
            base "#ffffff"
            background "#073642"
            emphasis_0 "#c2c372"
            emphasis_1 "#72c2c3"
            emphasis_2 "#72c373"
            emphasis_3 "#c87fc8"
        }
        list_unselected {
            base "#d9e6f2"
            background "#29262f"
            emphasis_0 "#c2c372"
            emphasis_1 "#72c2c3"
            emphasis_2 "#72c373"
            emphasis_3 "#c372c2"
        }
        list_selected {
            base "#ffffff"
            background "#073642"
            emphasis_0 "#c2c372"
            emphasis_1 "#72c2c3"
            emphasis_2 "#72c373"
            emphasis_3 "#c87fc8"
        }
        ribbon_selected {
            base "#29262f"
            background "#72c373"
            emphasis_0 "#613939"
            emphasis_1 "#464629"
            emphasis_2 "#5d375d"
            emphasis_3 "#403f6d"
        }
        ribbon_unselected {
            base "#29262f"
            background "#d9e6f2"
            emphasis_0 "#915655"
            emphasis_1 "#d9e6f2"
            emphasis_2 "#605fa3"
            emphasis_3 "#8b518a"
        }
        table_title {
            base "#72c373"
            background "#29262f"
            emphasis_0 "#c2c372"
            emphasis_1 "#72c2c3"
            emphasis_2 "#72c373"
            emphasis_3 "#c372c2"
        }
        frame_unselected {
            base "#d9e6f2"
            background "#29262f"
            emphasis_0 "#d9e6f2"
            emphasis_1 "#d9e6f2"
            emphasis_2 "#d9e6f2"
            emphasis_3 "#d9e6f2"
        }
        frame_selected {
            base "#72c373"
            background "#29262f"
            emphasis_0 "#c2c372"
            emphasis_1 "#72c2c3"
            emphasis_2 "#72c373"
            emphasis_3 "#c372c2"
        }
        frame_highlight {
            base "#c2c372"
            background "#29262f"
            emphasis_0 "#c372c2"
            emphasis_1 "#c2c372"
            emphasis_2 "#c2c372"
            emphasis_3 "#c2c372"
        }
        exit_code_success {
            base "#72c373"
            background "#29262f"
            emphasis_0 "#72c2c3"
            emphasis_1 "#d9e6f2"
            emphasis_2 "#c372c2"
            emphasis_3 "#8887cc"
        }
        exit_code_error {
            base "#c67978"
            background "#29262f"
            emphasis_0 "#c2c372"
            emphasis_1 "#d9e6f2"
            emphasis_2 "#c372c2"
            emphasis_3 "#8887cc"
        }
        multiplayer_user_colors {
            player_1 "#c372c2"
            player_2 "#8887cc"
            player_3 "#dbaada"
            player_4 "#c2c372"
            player_5 "#72c2c3"
            player_6 "#dadbaa"
            player_7 "#c67978"
            player_8 "#d9d9d9"
            player_9 "#dbaaaa"
            player_10 "#aaaadb"
        }
    }
}
