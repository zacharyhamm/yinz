themes {
  everforest-light {
        // Terminal palette: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/master/ghostty/Everforest%20Light%20Med
        pane_surround "#e3dfc8"
        terminal {
            foreground "#5c6a72"
            background "#efebd4"
            black "#7a8478"
            red "#e67e80"
            green "#9ab373"
            yellow "#c1a266"
            blue "#7fbbb3"
            magenta "#d699b6"
            cyan "#83c092"
            white "#b2af9f"
            bright_black "#a6b0a0"
            bright_red "#f85552"
            bright_green "#8da101"
            bright_yellow "#dfa000"
            bright_blue "#3a94c5"
            bright_magenta "#df69ba"
            bright_cyan "#35a77c"
            bright_white "#fffbef"
        }
        text_unselected {
            base 92 106 114
            background 242 239 223
            emphasis_0 149 92 58
            emphasis_1 38 119 89
            emphasis_2 98 112 1
            emphasis_3 160 75 133
        }
        text_selected {
            base 242 239 223
            background 92 106 114
            emphasis_0 "#efe5df"
            emphasis_1 "#dceae5"
            emphasis_2 "#e6e9d4"
            emphasis_3 "#f2e3ed"
        }
        ribbon_selected {
            base 48 48 45
            background 141 161 1
            emphasis_0 44 49 53
            emphasis_1 68 42 27
            emphasis_2 74 35 62
            emphasis_3 20 51 68
        }
        ribbon_unselected {
            base 242 239 223
            background 100 111 99
            emphasis_0 237 238 239
            emphasis_1 107 106 96
            emphasis_2 227 240 247
            emphasis_3 250 233 245
        }
        table_title {
            base 98 112 1
            background 0
            emphasis_0 149 92 58
            emphasis_1 38 119 89
            emphasis_2 98 112 1
            emphasis_3 160 75 133
        }
        table_cell_selected {
            base 87 101 108
            background 229 223 197
            emphasis_0 139 86 55
            emphasis_1 35 111 83
            emphasis_2 92 105 1
            emphasis_3 150 70 125
        }
        table_cell_unselected {
            base 92 106 114
            background 242 239 223
            emphasis_0 149 92 58
            emphasis_1 38 119 89
            emphasis_2 98 112 1
            emphasis_3 160 75 133
        }
        list_selected {
            base 92 106 114
            background 255 249 232
            emphasis_0 162 100 64
            emphasis_1 41 129 96
            emphasis_2 107 122 1
            emphasis_3 174 82 145
        }
        list_unselected {
            base 92 106 114
            background 242 239 223
            emphasis_0 149 92 58
            emphasis_1 38 119 89
            emphasis_2 98 112 1
            emphasis_3 160 75 133
        }
        frame_selected {
            base 98 112 1
            background 0
            emphasis_0 149 92 58
            emphasis_1 38 119 89
            emphasis_2 160 75 133
            emphasis_3 0
        }
        frame_highlight {
            base 149 92 58
            background 0
            emphasis_0 160 75 133
            emphasis_1 149 92 58
            emphasis_2 149 92 58
            emphasis_3 149 92 58
        }
        exit_code_success {
            base 98 112 1
            background 0
            emphasis_0 38 119 89
            emphasis_1 92 106 114
            emphasis_2 160 75 133
            emphasis_3 44 112 149
        }
        exit_code_error {
            base 186 64 61
            background 0
            emphasis_0 138 99 0
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 160 75 133
            player_2 44 112 149
            player_3 100 108 98
            player_4 138 99 0
            player_5 38 119 89
            player_6 100 108 98
            player_7 186 64 61
            player_8 100 108 98
