themes {
    "vaughn" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Vaughn
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#191743"
        terminal {
            foreground "#dcdccc"
            background "#25234f"
            black "#25234f"
            red "#705050"
            green "#60b48a"
            yellow "#dfaf8f"
            blue "#5555ff"
            magenta "#f08cc3"
            cyan "#8cd0d3"
            white "#709080"
            bright_black "#709080"
            bright_red "#dca3a3"
            bright_green "#60b48a"
            bright_yellow "#f0dfaf"
            bright_blue "#5555ff"
            bright_magenta "#ec93d3"
            bright_cyan "#93e0e3"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#dcdccc"
            background "#25234f"
            emphasis_0 "#dfaf8f"
            emphasis_1 "#8cd0d3"
            emphasis_2 "#60b48a"
            emphasis_3 "#f08cc3"
        }
        text_selected {
            base "#000000"
            background "#b5d5ff"
            emphasis_0 "#6e5647"
            emphasis_1 "#416062"
            emphasis_2 "#35644d"
            emphasis_3 "#7f4a67"
        }
        table_cell_unselected {
            base "#dcdccc"
            background "#25234f"
            emphasis_0 "#dfaf8f"
            emphasis_1 "#8cd0d3"
            emphasis_2 "#60b48a"
            emphasis_3 "#f08cc3"
        }
        table_cell_selected {
            base "#000000"
            background "#b5d5ff"
            emphasis_0 "#6e5647"
            emphasis_1 "#416062"
            emphasis_2 "#35644d"
            emphasis_3 "#7f4a67"
        }
        list_unselected {
            base "#dcdccc"
            background "#25234f"
            emphasis_0 "#dfaf8f"
            emphasis_1 "#8cd0d3"
            emphasis_2 "#60b48a"
            emphasis_3 "#f08cc3"
        }
        list_selected {
            base "#000000"
            background "#b5d5ff"
            emphasis_0 "#6e5647"
            emphasis_1 "#416062"
            emphasis_2 "#35644d"
            emphasis_3 "#7f4a67"
        }
        ribbon_selected {
            base "#25234f"
            background "#60b48a"
            emphasis_0 "#4b3535"
            emphasis_1 "#46372d"
            emphasis_2 "#523043"
            emphasis_3 "#2d2d88"
        }
        ribbon_unselected {
            base "#25234f"
            background "#dcdccc"
            emphasis_0 "#705050"
            emphasis_1 "#dcdccc"
            emphasis_2 "#4a4adf"
            emphasis_3 "#864e6d"
        }
        table_title {
            base "#60b48a"
            background "#25234f"
            emphasis_0 "#dfaf8f"
            emphasis_1 "#8cd0d3"
            emphasis_2 "#60b48a"
            emphasis_3 "#f08cc3"
        }
        frame_unselected {
            base "#dcdccc"
            background "#25234f"
            emphasis_0 "#dcdccc"
            emphasis_1 "#dcdccc"
            emphasis_2 "#dcdccc"
            emphasis_3 "#dcdccc"
        }
        frame_selected {
            base "#60b48a"
            background "#25234f"
            emphasis_0 "#dfaf8f"
            emphasis_1 "#8cd0d3"
            emphasis_2 "#60b48a"
            emphasis_3 "#f08cc3"
        }
        frame_highlight {
            base "#dfaf8f"
            background "#25234f"
            emphasis_0 "#f08cc3"
            emphasis_1 "#dfaf8f"
            emphasis_2 "#dfaf8f"
            emphasis_3 "#dfaf8f"
        }
        exit_code_success {
            base "#60b48a"
            background "#25234f"
            emphasis_0 "#8cd0d3"
            emphasis_1 "#dcdccc"
            emphasis_2 "#f08cc3"
            emphasis_3 "#8080ff"
        }
        exit_code_error {
            base "#9f8a8a"
            background "#25234f"
            emphasis_0 "#dfaf8f"
            emphasis_1 "#dcdccc"
            emphasis_2 "#f08cc3"
            emphasis_3 "#8080ff"
        }
        multiplayer_user_colors {
            player_1 "#f08cc3"
            player_2 "#8080ff"
            player_3 "#ec93d3"
            player_4 "#dfaf8f"
            player_5 "#8cd0d3"
            player_6 "#f0dfaf"
            player_7 "#9f8a8a"
            player_8 "#779686"
            player_9 "#dca3a3"
            player_10 "#8080ff"
        }
    }
}
