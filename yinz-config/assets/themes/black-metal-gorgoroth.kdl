themes {
    "black-metal-gorgoroth" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Black%20Metal%20%28Gorgoroth%29
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#000000"
        terminal {
            foreground "#c1c1c1"
            background "#000000"
            black "#000000"
            red "#5f8787"
            green "#9b8d7f"
            yellow "#8c7f70"
            blue "#888888"
            magenta "#999999"
            cyan "#aaaaaa"
            white "#c1c1c1"
            bright_black "#404040"
            bright_red "#5f8787"
            bright_green "#9b8d7f"
            bright_yellow "#8c7f70"
            bright_blue "#888888"
            bright_magenta "#999999"
            bright_cyan "#aaaaaa"
            bright_white "#c1c1c1"
        }
        text_unselected {
            base "#c1c1c1"
            background "#000000"
            emphasis_0 "#8c7f70"
            emphasis_1 "#aaaaaa"
            emphasis_2 "#9b8d7f"
            emphasis_3 "#999999"
        }
        text_selected {
            base "#000000"
            background "#c1c1c1"
            emphasis_0 "#564e45"
            emphasis_1 "#4f4f4f"
            emphasis_2 "#564e46"
            emphasis_3 "#4f4f4f"
        }
        table_cell_unselected {
            base "#c1c1c1"
            background "#000000"
            emphasis_0 "#8c7f70"
            emphasis_1 "#aaaaaa"
            emphasis_2 "#9b8d7f"
            emphasis_3 "#999999"
        }
        table_cell_selected {
            base "#000000"
            background "#c1c1c1"
            emphasis_0 "#564e45"
            emphasis_1 "#4f4f4f"
            emphasis_2 "#564e46"
            emphasis_3 "#4f4f4f"
        }
        list_unselected {
            base "#c1c1c1"
            background "#000000"
            emphasis_0 "#8c7f70"
            emphasis_1 "#aaaaaa"
            emphasis_2 "#9b8d7f"
            emphasis_3 "#999999"
        }
        list_selected {
            base "#000000"
            background "#c1c1c1"
            emphasis_0 "#564e45"
            emphasis_1 "#4f4f4f"
            emphasis_2 "#564e46"
            emphasis_3 "#4f4f4f"
        }
        ribbon_selected {
            base "#000000"
            background "#9b8d7f"
            emphasis_0 "#1f2b2b"
            emphasis_1 "#2c2824"
            emphasis_2 "#292929"
            emphasis_3 "#292929"
        }
        ribbon_unselected {
            base "#000000"
            background "#c1c1c1"
            emphasis_0 "#3b5454"
            emphasis_1 "#c1c1c1"
            emphasis_2 "#4f4f4f"
            emphasis_3 "#4f4f4f"
        }
        table_title {
            base "#9b8d7f"
            background "#000000"
            emphasis_0 "#8c7f70"
            emphasis_1 "#aaaaaa"
            emphasis_2 "#9b8d7f"
            emphasis_3 "#999999"
        }
        frame_unselected {
            base "#c1c1c1"
            background "#000000"
            emphasis_0 "#c1c1c1"
            emphasis_1 "#c1c1c1"
            emphasis_2 "#c1c1c1"
            emphasis_3 "#c1c1c1"
        }
        frame_selected {
            base "#9b8d7f"
            background "#000000"
            emphasis_0 "#8c7f70"
            emphasis_1 "#aaaaaa"
            emphasis_2 "#9b8d7f"
            emphasis_3 "#999999"
        }
        frame_highlight {
            base "#8c7f70"
            background "#000000"
            emphasis_0 "#999999"
            emphasis_1 "#8c7f70"
            emphasis_2 "#8c7f70"
            emphasis_3 "#8c7f70"
        }
        exit_code_success {
            base "#9b8d7f"
            background "#000000"
            emphasis_0 "#aaaaaa"
            emphasis_1 "#c1c1c1"
            emphasis_2 "#999999"
            emphasis_3 "#888888"
        }
        exit_code_error {
            base "#5f8787"
            background "#000000"
            emphasis_0 "#8c7f70"
            emphasis_1 "#c1c1c1"
            emphasis_2 "#999999"
            emphasis_3 "#888888"
        }
        multiplayer_user_colors {
            player_1 "#999999"
            player_2 "#888888"
            player_3 "#999999"
            player_4 "#8c7f70"
            player_5 "#aaaaaa"
            player_6 "#8c7f70"
            player_7 "#5f8787"
            player_8 "#c1c1c1"
            player_9 "#5f8787"
            player_10 "#888888"
        }
    }
}
