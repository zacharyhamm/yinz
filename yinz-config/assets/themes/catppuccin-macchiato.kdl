themes {
    catppuccin-macchiato {
        // Terminal palette: https://github.com/catppuccin/kitty/blob/main/themes/macchiato.conf
        pane_surround "#181b2e"
        terminal {
            foreground "#cad3f5"
            background "#24273a"
            black "#494d64"
            red "#ed8796"
            green "#a6da95"
            yellow "#eed49f"
            blue "#8aadf4"
            magenta "#f5bde6"
            cyan "#8bd5ca"
            white "#b8c0e0"
            bright_black "#5b6078"
            bright_red "#ed8796"
            bright_green "#a6da95"
            bright_yellow "#eed49f"
            bright_blue "#8aadf4"
            bright_magenta "#f5bde6"
            bright_cyan "#8bd5ca"
            bright_white "#a5adcb"
        }
        text_unselected {
            base 202 211 245
            background 30 32 48
            emphasis_0 245 169 127
            emphasis_1 145 215 227
            emphasis_2 166 218 149
            emphasis_3 245 189 230
        }
        text_selected {
            base 30 32 48
            background 202 211 245
            emphasis_0 "#78533e"
            emphasis_1 "#416166"
            emphasis_2 "#4b6243"
            emphasis_3 "#6e5467"
        }
