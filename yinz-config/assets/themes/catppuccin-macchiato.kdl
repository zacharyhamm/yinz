        }
        exit_code_success {
            base 166 218 149
            background 0
            emphasis_0 145 215 227
            emphasis_1 30 32 48
            emphasis_2 245 189 230
            emphasis_3 138 173 244
        }
        exit_code_error {
            base 237 135 150
