themes {
    "flatland" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Flatland
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#111315"
        terminal {
            foreground "#b8dbef"
            background "#1d1f21"
            black "#1d1d19"
            red "#f18339"
            green "#9fd364"
            yellow "#f4ef6d"
            blue "#5096be"
            magenta "#695abc"
            cyan "#d63865"
            white "#ffffff"
            bright_black "#50504c"
            bright_red "#d22a24"
            bright_green "#a7d42c"
            bright_yellow "#ff8949"
            bright_blue "#61b9d0"
            bright_magenta "#695abc"
            bright_cyan "#d63865"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#b8dbef"
            background "#1d1f21"
            emphasis_0 "#f4ef6d"
            emphasis_1 "#dd587e"
            emphasis_2 "#9fd364"
            emphasis_3 "#887cca"
        }
        text_selected {
            base "#1d1f21"
            background "#b8dbef"
            emphasis_0 "#615f2b"
            emphasis_1 "#90445a"
            emphasis_2 "#4b642f"
            emphasis_3 "#5e5785"
        }
        table_cell_unselected {
            base "#b8dbef"
            background "#1d1f21"
            emphasis_0 "#f4ef6d"
            emphasis_1 "#dd587e"
            emphasis_2 "#9fd364"
            emphasis_3 "#887cca"
        }
        table_cell_selected {
            base "#ffffff"
            background "#2b2a24"
            emphasis_0 "#f4ef6d"
            emphasis_1 "#e06a8c"
            emphasis_2 "#9fd364"
            emphasis_3 "#9287ce"
        }
        list_unselected {
            base "#b8dbef"
            background "#1d1f21"
            emphasis_0 "#f4ef6d"
            emphasis_1 "#dd587e"
            emphasis_2 "#9fd364"
            emphasis_3 "#887cca"
        }
        list_selected {
            base "#ffffff"
            background "#2b2a24"
            emphasis_0 "#f4ef6d"
            emphasis_1 "#e06a8c"
            emphasis_2 "#9fd364"
            emphasis_3 "#9287ce"
        }
        ribbon_selected {
            base "#1d1f21"
            background "#9fd364"
            emphasis_0 "#7a421d"
            emphasis_1 "#555326"
            emphasis_2 "#524693"
            emphasis_3 "#2d556c"
        }
        ribbon_unselected {
            base "#1d1f21"
            background "#b8dbef"
            emphasis_0 "#8c4c21"
            emphasis_1 "#b8dbef"
            emphasis_2 "#34627c"
            emphasis_3 "#5e50a8"
        }
        table_title {
            base "#9fd364"
            background "#1d1f21"
            emphasis_0 "#f4ef6d"
            emphasis_1 "#dd587e"
            emphasis_2 "#9fd364"
            emphasis_3 "#887cca"
        }
        frame_unselected {
            base "#b8dbef"
            background "#1d1f21"
            emphasis_0 "#b8dbef"
            emphasis_1 "#b8dbef"
            emphasis_2 "#b8dbef"
            emphasis_3 "#b8dbef"
        }
        frame_selected {
            base "#9fd364"
            background "#1d1f21"
            emphasis_0 "#f4ef6d"
            emphasis_1 "#dd587e"
            emphasis_2 "#9fd364"
            emphasis_3 "#887cca"
        }
        frame_highlight {
            base "#f4ef6d"
            background "#1d1f21"
            emphasis_0 "#887cca"
            emphasis_1 "#f4ef6d"
            emphasis_2 "#f4ef6d"
            emphasis_3 "#f4ef6d"
        }
        exit_code_success {
            base "#9fd364"
            background "#1d1f21"
            emphasis_0 "#dd587e"
            emphasis_1 "#b8dbef"
            emphasis_2 "#887cca"
            emphasis_3 "#5096be"
        }
        exit_code_error {
            base "#f18339"
            background "#1d1f21"
            emphasis_0 "#f4ef6d"
            emphasis_1 "#b8dbef"
            emphasis_2 "#887cca"
            emphasis_3 "#5096be"
        }
        multiplayer_user_colors {
            player_1 "#887cca"
            player_2 "#5096be"
            player_3 "#887cca"
            player_4 "#f4ef6d"
            player_5 "#dd587e"
            player_6 "#ff8949"
            player_7 "#f18339"
            player_8 "#ffffff"
            player_9 "#dd5c58"
            player_10 "#61b9d0"
        }
    }
}
