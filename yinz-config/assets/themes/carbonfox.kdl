themes {
    "carbonfox" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Carbonfox
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#0a0a0a"
        terminal {
            foreground "#f2f4f8"
            background "#161616"
            black "#282828"
            red "#ee5396"
            green "#25be6a"
            yellow "#08bdba"
            blue "#78a9ff"
            magenta "#be95ff"
            cyan "#33b1ff"
            white "#dfdfe0"
            bright_black "#484848"
            bright_red "#f16da6"
            bright_green "#46c880"
            bright_yellow "#2dc7c4"
            bright_blue "#8cb6ff"
            bright_magenta "#c8a5ff"
            bright_cyan "#52bdff"
            bright_white "#e4e4e5"
        }
        text_unselected {
            base "#f2f4f8"
            background "#161616"
            emphasis_0 "#08bdba"
            emphasis_1 "#33b1ff"
            emphasis_2 "#25be6a"
            emphasis_3 "#be95ff"
        }
        text_selected {
            base "#161616"
            background "#f2f4f8"
            emphasis_0 "#057d7b"
            emphasis_1 "#2275a9"
            emphasis_2 "#198047"
            emphasis_3 "#7d62a8"
        }
        table_cell_unselected {
            base "#f2f4f8"
            background "#161616"
            emphasis_0 "#08bdba"
            emphasis_1 "#33b1ff"
            emphasis_2 "#25be6a"
            emphasis_3 "#be95ff"
        }
        table_cell_selected {
            base "#f2f4f8"
            background "#2a2a2a"
            emphasis_0 "#08bdba"
            emphasis_1 "#33b1ff"
            emphasis_2 "#25be6a"
            emphasis_3 "#be95ff"
        }
        list_unselected {
            base "#f2f4f8"
            background "#161616"
            emphasis_0 "#08bdba"
            emphasis_1 "#33b1ff"
            emphasis_2 "#25be6a"
            emphasis_3 "#be95ff"
        }
        list_selected {
            base "#f2f4f8"
            background "#2a2a2a"
            emphasis_0 "#08bdba"
            emphasis_1 "#33b1ff"
            emphasis_2 "#25be6a"
            emphasis_3 "#be95ff"
        }
        ribbon_selected {
            base "#161616"
            background "#25be6a"
            emphasis_0 "#682441"
            emphasis_1 "#034443"
            emphasis_2 "#44355b"
            emphasis_3 "#2b3c5b"
        }
        ribbon_unselected {
            base "#161616"
            background "#f2f4f8"
            emphasis_0 "#bd4277"
            emphasis_1 "#f2f4f8"
            emphasis_2 "#5070a9"
            emphasis_3 "#7d62a8"
        }
        table_title {
            base "#25be6a"
            background "#161616"
            emphasis_0 "#08bdba"
            emphasis_1 "#33b1ff"
            emphasis_2 "#25be6a"
            emphasis_3 "#be95ff"
        }
        frame_unselected {
            base "#f2f4f8"
            background "#161616"
            emphasis_0 "#f2f4f8"
            emphasis_1 "#f2f4f8"
            emphasis_2 "#f2f4f8"
            emphasis_3 "#f2f4f8"
        }
        frame_selected {
            base "#25be6a"
            background "#161616"
            emphasis_0 "#08bdba"
            emphasis_1 "#33b1ff"
            emphasis_2 "#25be6a"
            emphasis_3 "#be95ff"
        }
        frame_highlight {
            base "#08bdba"
            background "#161616"
            emphasis_0 "#be95ff"
            emphasis_1 "#08bdba"
            emphasis_2 "#08bdba"
            emphasis_3 "#08bdba"
        }
        exit_code_success {
            base "#25be6a"
            background "#161616"
            emphasis_0 "#33b1ff"
            emphasis_1 "#f2f4f8"
            emphasis_2 "#be95ff"
            emphasis_3 "#78a9ff"
        }
        exit_code_error {
            base "#ee5396"
            background "#161616"
            emphasis_0 "#08bdba"
            emphasis_1 "#f2f4f8"
            emphasis_2 "#be95ff"
            emphasis_3 "#78a9ff"
        }
        multiplayer_user_colors {
            player_1 "#be95ff"
            player_2 "#78a9ff"
            player_3 "#c8a5ff"
            player_4 "#08bdba"
            player_5 "#33b1ff"
            player_6 "#2dc7c4"
            player_7 "#ee5396"
            player_8 "#dfdfe0"
            player_9 "#f16da6"
            player_10 "#8cb6ff"
        }
    }
}
