themes {
    "gruvbox-material-dark" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Gruvbox%20Material%20Dark
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#1c1c1c"
        terminal {
            foreground "#d4be98"
            background "#282828"
            black "#282828"
            red "#ea6962"
            green "#a9b665"
            yellow "#d8a657"
            blue "#7daea3"
            magenta "#d3869b"
            cyan "#89b482"
            white "#d4be98"
            bright_black "#7c6f64"
            bright_red "#ea6962"
            bright_green "#a9b665"
            bright_yellow "#d8a657"
            bright_blue "#7daea3"
            bright_magenta "#d3869b"
            bright_cyan "#89b482"
            bright_white "#ddc7a1"
        }
        text_unselected {
            base "#d4be98"
            background "#282828"
            emphasis_0 "#d8a657"
            emphasis_1 "#89b482"
            emphasis_2 "#a9b665"
            emphasis_3 "#d3869b"
        }
        text_selected {
            base "#282828"
            background "#d4be98"
            emphasis_0 "#614b27"
            emphasis_1 "#40543d"
            emphasis_2 "#4c522e"
            emphasis_3 "#6c444f"
        }
        table_cell_unselected {
            base "#d4be98"
            background "#282828"
            emphasis_0 "#d8a657"
            emphasis_1 "#89b482"
            emphasis_2 "#a9b665"
            emphasis_3 "#d3869b"
        }
        table_cell_selected {
            base "#282828"
            background "#d4be98"
            emphasis_0 "#614b27"
            emphasis_1 "#40543d"
            emphasis_2 "#4c522e"
            emphasis_3 "#6c444f"
        }
        list_unselected {
            base "#d4be98"
            background "#282828"
            emphasis_0 "#d8a657"
            emphasis_1 "#89b482"
            emphasis_2 "#a9b665"
            emphasis_3 "#d3869b"
        }
        list_selected {
            base "#282828"
            background "#d4be98"
            emphasis_0 "#614b27"
            emphasis_1 "#40543d"
            emphasis_2 "#4c522e"
            emphasis_3 "#6c444f"
        }
        ribbon_selected {
            base "#282828"
            background "#a9b665"
            emphasis_0 "#6c312d"
            emphasis_1 "#534021"
            emphasis_2 "#5a3942"
            emphasis_3 "#334742"
        }
        ribbon_unselected {
            base "#282828"
            background "#d4be98"
            emphasis_0 "#803a36"
            emphasis_1 "#d4be98"
            emphasis_2 "#3c544f"
            emphasis_3 "#6c444f"
        }
        table_title {
            base "#a9b665"
            background "#282828"
            emphasis_0 "#d8a657"
            emphasis_1 "#89b482"
            emphasis_2 "#a9b665"
            emphasis_3 "#d3869b"
        }
        frame_unselected {
            base "#d4be98"
            background "#282828"
            emphasis_0 "#d4be98"
            emphasis_1 "#d4be98"
            emphasis_2 "#d4be98"
            emphasis_3 "#d4be98"
        }
        frame_selected {
            base "#a9b665"
            background "#282828"
            emphasis_0 "#d8a657"
            emphasis_1 "#89b482"
            emphasis_2 "#a9b665"
            emphasis_3 "#d3869b"
        }
        frame_highlight {
            base "#d8a657"
            background "#282828"
            emphasis_0 "#d3869b"
            emphasis_1 "#d8a657"
            emphasis_2 "#d8a657"
            emphasis_3 "#d8a657"
        }
        exit_code_success {
            base "#a9b665"
            background "#282828"
            emphasis_0 "#89b482"
            emphasis_1 "#d4be98"
            emphasis_2 "#d3869b"
            emphasis_3 "#7daea3"
        }
        exit_code_error {
            base "#ea6962"
            background "#282828"
            emphasis_0 "#d8a657"
            emphasis_1 "#d4be98"
            emphasis_2 "#d3869b"
            emphasis_3 "#7daea3"
        }
        multiplayer_user_colors {
            player_1 "#d3869b"
            player_2 "#7daea3"
            player_3 "#d3869b"
            player_4 "#d8a657"
            player_5 "#89b482"
            player_6 "#d8a657"
            player_7 "#ea6962"
            player_8 "#d4be98"
            player_9 "#ea6962"
            player_10 "#7daea3"
        }
    }
}
