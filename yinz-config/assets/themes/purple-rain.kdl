themes {
    "purple-rain" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Purple%20Rain
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#15003e"
        terminal {
            foreground "#fffbf6"
            background "#21084a"
            black "#000000"
            red "#ff260e"
            green "#9be205"
            yellow "#ffc400"
            blue "#00a2fa"
            magenta "#815bb5"
            cyan "#00deef"
            white "#ffffff"
            bright_black "#565656"
            bright_red "#ff4250"
            bright_green "#b8e36e"
            bright_yellow "#ffd852"
            bright_blue "#00a6ff"
            bright_magenta "#ac7bf0"
            bright_cyan "#74fdf3"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#fffbf6"
            background "#21084a"
            emphasis_0 "#ffc400"
            emphasis_1 "#00deef"
            emphasis_2 "#9be205"
            emphasis_3 "#9372bf"
        }
        text_selected {
            base "#ffffff"
            background "#287691"
            emphasis_0 "#fff0bd"
            emphasis_1 "#cdf9fc"
            emphasis_2 "#e6f8bf"
            emphasis_3 "#f3eff8"
        }
        table_cell_unselected {
            base "#fffbf6"
            background "#21084a"
            emphasis_0 "#ffc400"
            emphasis_1 "#00deef"
            emphasis_2 "#9be205"
            emphasis_3 "#9372bf"
        }
        table_cell_selected {
            base "#ffffff"
            background "#287691"
            emphasis_0 "#fff0bd"
            emphasis_1 "#cdf9fc"
            emphasis_2 "#e6f8bf"
            emphasis_3 "#f3eff8"
        }
        list_unselected {
            base "#fffbf6"
            background "#21084a"
            emphasis_0 "#ffc400"
            emphasis_1 "#00deef"
            emphasis_2 "#9be205"
            emphasis_3 "#9372bf"
        }
        list_selected {
            base "#ffffff"
            background "#287691"
            emphasis_0 "#fff0bd"
            emphasis_1 "#cdf9fc"
            emphasis_2 "#e6f8bf"
            emphasis_3 "#f3eff8"
        }
        ribbon_selected {
            base "#21084a"
            background "#9be205"
            emphasis_0 "#ad1a09"
            emphasis_1 "#6d5400"
            emphasis_2 "#674991"
            emphasis_3 "#005c8e"
        }
        ribbon_unselected {
            base "#21084a"
            background "#fffbf6"
            emphasis_0 "#e3220c"
            emphasis_1 "#fffbf6"
            emphasis_2 "#007abc"
            emphasis_3 "#815bb5"
        }
        table_title {
            base "#9be205"
            background "#21084a"
            emphasis_0 "#ffc400"
            emphasis_1 "#00deef"
            emphasis_2 "#9be205"
            emphasis_3 "#9372bf"
        }
        frame_unselected {
            base "#fffbf6"
            background "#21084a"
            emphasis_0 "#fffbf6"
            emphasis_1 "#fffbf6"
            emphasis_2 "#fffbf6"
            emphasis_3 "#fffbf6"
        }
        frame_selected {
            base "#9be205"
            background "#21084a"
            emphasis_0 "#ffc400"
            emphasis_1 "#00deef"
            emphasis_2 "#9be205"
            emphasis_3 "#9372bf"
        }
        frame_highlight {
            base "#ffc400"
            background "#21084a"
            emphasis_0 "#9372bf"
            emphasis_1 "#ffc400"
            emphasis_2 "#ffc400"
            emphasis_3 "#ffc400"
        }
        exit_code_success {
            base "#9be205"
            background "#21084a"
            emphasis_0 "#00deef"
            emphasis_1 "#fffbf6"
            emphasis_2 "#9372bf"
            emphasis_3 "#00a2fa"
        }
        exit_code_error {
            base "#ff260e"
            background "#21084a"
            emphasis_0 "#ffc400"
            emphasis_1 "#fffbf6"
            emphasis_2 "#9372bf"
            emphasis_3 "#00a2fa"
        }
        multiplayer_user_colors {
            player_1 "#9372bf"
            player_2 "#00a2fa"
            player_3 "#ac7bf0"
            player_4 "#ffc400"
            player_5 "#00deef"
            player_6 "#ffd852"
            player_7 "#ff260e"
            player_8 "#ffffff"
            player_9 "#ff4250"
            player_10 "#00a6ff"
        }
    }
}
