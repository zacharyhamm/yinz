themes {
    "thayer-bright" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Thayer%20Bright
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#0f1112"
        terminal {
            foreground "#f8f8f8"
            background "#1b1d1e"
            black "#1b1d1e"
            red "#f92672"
            green "#4df840"
            yellow "#f4fd22"
            blue "#2757d6"
            magenta "#8c54fe"
            cyan "#38c8b5"
            white "#ccccc6"
            bright_black "#505354"
            bright_red "#ff5995"
            bright_green "#b6e354"
            bright_yellow "#feed6c"
            bright_blue "#3f78ff"
            bright_magenta "#9e6ffe"
            bright_cyan "#23cfd5"
            bright_white "#f8f8f2"
        }
        text_unselected {
            base "#f8f8f8"
            background "#1b1d1e"
            emphasis_0 "#f4fd22"
            emphasis_1 "#38c8b5"
            emphasis_2 "#4df840"
            emphasis_3 "#9765fe"
        }
        text_selected {
            base "#1b1d1e"
            background "#f8f8f8"
            emphasis_0 "#737710"
            emphasis_1 "#357e75"
            emphasis_2 "#298322"
            emphasis_3 "#796a99"
        }
        table_cell_unselected {
            base "#f8f8f8"
            background "#1b1d1e"
            emphasis_0 "#f4fd22"
            emphasis_1 "#38c8b5"
            emphasis_2 "#4df840"
            emphasis_3 "#9765fe"
        }
        table_cell_selected {
            base "#ffffff"
            background "#4d4d4d"
            emphasis_0 "#f4fd22"
            emphasis_1 "#57d1c1"
            emphasis_2 "#4df840"
            emphasis_3 "#cab1ff"
        }
        list_unselected {
            base "#f8f8f8"
            background "#1b1d1e"
            emphasis_0 "#f4fd22"
            emphasis_1 "#38c8b5"
            emphasis_2 "#4df840"
            emphasis_3 "#9765fe"
        }
        list_selected {
            base "#ffffff"
            background "#4d4d4d"
            emphasis_0 "#f4fd22"
            emphasis_1 "#57d1c1"
            emphasis_2 "#4df840"
            emphasis_3 "#cab1ff"
        }
        ribbon_selected {
            base "#1b1d1e"
            background "#4df840"
            emphasis_0 "#b61c53"
            emphasis_1 "#60630d"
            emphasis_2 "#6e42c8"
            emphasis_3 "#2654cf"
        }
        ribbon_unselected {
            base "#1b1d1e"
            background "#f8f8f8"
            emphasis_0 "#da2164"
            emphasis_1 "#f8f8f8"
            emphasis_2 "#2757d6"
            emphasis_3 "#844ff0"
        }
        table_title {
            base "#4df840"
            background "#1b1d1e"
            emphasis_0 "#f4fd22"
            emphasis_1 "#38c8b5"
            emphasis_2 "#4df840"
            emphasis_3 "#9765fe"
        }
        frame_unselected {
            base "#f8f8f8"
            background "#1b1d1e"
            emphasis_0 "#f8f8f8"
            emphasis_1 "#f8f8f8"
            emphasis_2 "#f8f8f8"
            emphasis_3 "#f8f8f8"
        }
        frame_selected {
            base "#4df840"
            background "#1b1d1e"
            emphasis_0 "#f4fd22"
            emphasis_1 "#38c8b5"
            emphasis_2 "#4df840"
            emphasis_3 "#9765fe"
        }
        frame_highlight {
            base "#f4fd22"
            background "#1b1d1e"
            emphasis_0 "#9765fe"
            emphasis_1 "#f4fd22"
            emphasis_2 "#f4fd22"
            emphasis_3 "#f4fd22"
        }
        exit_code_success {
            base "#4df840"
            background "#1b1d1e"
            emphasis_0 "#38c8b5"
            emphasis_1 "#f8f8f8"
            emphasis_2 "#9765fe"
            emphasis_3 "#5c80e0"
        }
        exit_code_error {
            base "#f92974"
            background "#1b1d1e"
            emphasis_0 "#f4fd22"
            emphasis_1 "#f8f8f8"
            emphasis_2 "#9765fe"
            emphasis_3 "#5c80e0"
        }
        multiplayer_user_colors {
            player_1 "#9765fe"
            player_2 "#5c80e0"
            player_3 "#9e6ffe"
            player_4 "#f4fd22"
            player_5 "#38c8b5"
            player_6 "#feed6c"
            player_7 "#f92974"
            player_8 "#ccccc6"
            player_9 "#ff5995"
            player_10 "#467dff"
        }
    }
}
