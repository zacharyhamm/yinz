themes {
    "lovelace" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Lovelace
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#11131c"
        terminal {
            foreground "#fdfdfd"
            background "#1d1f28"
            black "#282a36"
            red "#f37f97"
            green "#5adecd"
            yellow "#f2a272"
            blue "#8897f4"
            magenta "#c574dd"
            cyan "#79e6f3"
            white "#fdfdfd"
            bright_black "#4e5165"
            bright_red "#ff4971"
            bright_green "#18e3c8"
            bright_yellow "#ff8037"
            bright_blue "#556fff"
            bright_magenta "#b043d1"
            bright_cyan "#3fdcee"
            bright_white "#bebec1"
        }
        text_unselected {
            base "#fdfdfd"
            background "#1d1f28"
            emphasis_0 "#f2a272"
            emphasis_1 "#79e6f3"
            emphasis_2 "#5adecd"
            emphasis_3 "#c574dd"
        }
        text_selected {
            base "#000000"
            background "#c1deff"
            emphasis_0 "#81563d"
            emphasis_1 "#37686e"
            emphasis_2 "#2b6a62"
            emphasis_3 "#804c90"
        }
        table_cell_unselected {
            base "#fdfdfd"
            background "#1d1f28"
            emphasis_0 "#f2a272"
            emphasis_1 "#79e6f3"
            emphasis_2 "#5adecd"
            emphasis_3 "#c574dd"
        }
        table_cell_selected {
            base "#000000"
            background "#c1deff"
            emphasis_0 "#81563d"
            emphasis_1 "#37686e"
            emphasis_2 "#2b6a62"
            emphasis_3 "#804c90"
        }
        list_unselected {
            base "#fdfdfd"
            background "#1d1f28"
            emphasis_0 "#f2a272"
            emphasis_1 "#79e6f3"
            emphasis_2 "#5adecd"
            emphasis_3 "#c574dd"
        }
        list_selected {
            base "#000000"
            background "#c1deff"
            emphasis_0 "#81563d"
            emphasis_1 "#37686e"
            emphasis_2 "#2b6a62"
            emphasis_3 "#804c90"
        }
        ribbon_selected {
            base "#1d1f28"
            background "#5adecd"
            emphasis_0 "#80434f"
            emphasis_1 "#724c36"
            emphasis_2 "#724380"
            emphasis_3 "#4a5284"
        }
        ribbon_unselected {
            base "#1d1f28"
            background "#fdfdfd"
            emphasis_0 "#af5c6d"
            emphasis_1 "#fdfdfd"
            emphasis_2 "#6570b5"
            emphasis_3 "#9c5caf"
        }
        table_title {
            base "#5adecd"
            background "#1d1f28"
            emphasis_0 "#f2a272"
            emphasis_1 "#79e6f3"
            emphasis_2 "#5adecd"
            emphasis_3 "#c574dd"
        }
        frame_unselected {
            base "#fdfdfd"
            background "#1d1f28"
            emphasis_0 "#fdfdfd"
            emphasis_1 "#fdfdfd"
            emphasis_2 "#fdfdfd"
            emphasis_3 "#fdfdfd"
        }
        frame_selected {
            base "#5adecd"
            background "#1d1f28"
            emphasis_0 "#f2a272"
            emphasis_1 "#79e6f3"
            emphasis_2 "#5adecd"
            emphasis_3 "#c574dd"
        }
        frame_highlight {
            base "#f2a272"
            background "#1d1f28"
            emphasis_0 "#c574dd"
            emphasis_1 "#f2a272"
            emphasis_2 "#f2a272"
            emphasis_3 "#f2a272"
        }
        exit_code_success {
            base "#5adecd"
            background "#1d1f28"
            emphasis_0 "#79e6f3"
            emphasis_1 "#fdfdfd"
            emphasis_2 "#c574dd"
            emphasis_3 "#8897f4"
        }
        exit_code_error {
            base "#f37f97"
            background "#1d1f28"
            emphasis_0 "#f2a272"
            emphasis_1 "#fdfdfd"
            emphasis_2 "#c574dd"
            emphasis_3 "#8897f4"
        }
        multiplayer_user_colors {
            player_1 "#c574dd"
            player_2 "#8897f4"
            player_3 "#bc5fd8"
            player_4 "#f2a272"
            player_5 "#79e6f3"
            player_6 "#ff8037"
            player_7 "#f37f97"
            player_8 "#fdfdfd"
            player_9 "#ff4971"
            player_10 "#637bff"
        }
    }
}
