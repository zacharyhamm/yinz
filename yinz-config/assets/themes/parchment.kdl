themes {
    "parchment" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Parchment
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#f1ebdb"
        terminal {
            foreground "#1a1a1a"
            background "#fdf7e7"
            black "#292929"
            red "#851c1c"
            green "#0d6030"
            yellow "#685000"
            blue "#164a9b"
            magenta "#663194"
            cyan "#004a58"
            white "#3c3a36"
            bright_black "#55514b"
            bright_red "#922323"
            bright_green "#084d2a"
            bright_yellow "#594500"
            bright_blue "#123a78"
            bright_magenta "#523073"
            bright_cyan "#004957"
            bright_white "#47433e"
        }
        text_unselected {
            base "#1a1a1a"
            background "#fdf7e7"
            emphasis_0 "#685000"
            emphasis_1 "#004a58"
            emphasis_2 "#0d6030"
            emphasis_3 "#663194"
        }
        text_selected {
            base "#fdf7e7"
            background "#1a1a1a"
            emphasis_0 "#928147"
            emphasis_1 "#5a8a93"
            emphasis_2 "#528e6b"
            emphasis_3 "#9773b6"
        }
        table_cell_unselected {
            base "#1a1a1a"
            background "#fdf7e7"
            emphasis_0 "#685000"
            emphasis_1 "#004a58"
            emphasis_2 "#0d6030"
            emphasis_3 "#663194"
        }
        table_cell_selected {
            base "#1a1a1a"
            background "#e5dcc3"
            emphasis_0 "#685000"
            emphasis_1 "#004a58"
            emphasis_2 "#0d6030"
            emphasis_3 "#663194"
        }
        list_unselected {
            base "#1a1a1a"
            background "#fdf7e7"
            emphasis_0 "#685000"
            emphasis_1 "#004a58"
            emphasis_2 "#0d6030"
            emphasis_3 "#663194"
        }
        list_selected {
            base "#1a1a1a"
            background "#e5dcc3"
            emphasis_0 "#685000"
            emphasis_1 "#004a58"
            emphasis_2 "#0d6030"
            emphasis_3 "#663194"
        }
        ribbon_selected {
            base "#fdf7e7"
            background "#0d6030"
            emphasis_0 "#ddc0c0"
            emphasis_1 "#cec7ad"
            emphasis_2 "#d1c1df"
            emphasis_3 "#b8c8e0"
        }
        ribbon_unselected {
            base "#fdf7e7"
            background "#1a1a1a"
            emphasis_0 "#b27070"
            emphasis_1 "#1a1a1a"
            emphasis_2 "#5f83ba"
            emphasis_3 "#9773b6"
        }
        table_title {
            base "#0d6030"
            background "#fdf7e7"
            emphasis_0 "#685000"
            emphasis_1 "#004a58"
            emphasis_2 "#0d6030"
            emphasis_3 "#663194"
        }
        frame_unselected {
            base "#1a1a1a"
            background "#fdf7e7"
            emphasis_0 "#1a1a1a"
            emphasis_1 "#1a1a1a"
            emphasis_2 "#1a1a1a"
            emphasis_3 "#1a1a1a"
        }
        frame_selected {
            base "#0d6030"
            background "#fdf7e7"
            emphasis_0 "#685000"
            emphasis_1 "#004a58"
            emphasis_2 "#0d6030"
            emphasis_3 "#663194"
        }
        frame_highlight {
            base "#685000"
            background "#fdf7e7"
            emphasis_0 "#663194"
            emphasis_1 "#685000"
            emphasis_2 "#685000"
            emphasis_3 "#685000"
        }
        exit_code_success {
            base "#0d6030"
            background "#fdf7e7"
            emphasis_0 "#004a58"
            emphasis_1 "#1a1a1a"
            emphasis_2 "#663194"
            emphasis_3 "#164a9b"
        }
        exit_code_error {
            base "#851c1c"
            background "#fdf7e7"
            emphasis_0 "#685000"
            emphasis_1 "#1a1a1a"
            emphasis_2 "#663194"
            emphasis_3 "#164a9b"
        }
        multiplayer_user_colors {
            player_1 "#663194"
            player_2 "#164a9b"
            player_3 "#523073"
            player_4 "#685000"
            player_5 "#004a58"
            player_6 "#594500"
            player_7 "#851c1c"
            player_8 "#3c3a36"
            player_9 "#922323"
            player_10 "#123a78"
        }
    }
}
