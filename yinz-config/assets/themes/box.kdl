themes {
    "box" {
        // Source: https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/ghostty/Box
        // UI colors are derived for readability; terminal colors match the source.
        pane_surround "#08111f"
        terminal {
            foreground "#9fef00"
            background "#141d2b"
            black "#000000"
            red "#cc0403"
            green "#19cb00"
            yellow "#cecb00"
            blue "#0d73cc"
            magenta "#cb1ed1"
            cyan "#0dcdcd"
            white "#dddddd"
            bright_black "#767676"
            bright_red "#f2201f"
            bright_green "#23fd00"
            bright_yellow "#fffd00"
            bright_blue "#1a8fff"
            bright_magenta "#fd28ff"
            bright_cyan "#14ffff"
            bright_white "#ffffff"
        }
        text_unselected {
            base "#9fef00"
            background "#141d2b"
            emphasis_0 "#cecb00"
            emphasis_1 "#0dcdcd"
            emphasis_2 "#19cb00"
            emphasis_3 "#d443d9"
        }
        text_selected {
            base "#141d2b"
            background "#a4b1cd"
            emphasis_0 "#474600"
            emphasis_1 "#054c4c"
            emphasis_2 "#0a5000"
            emphasis_3 "#77127b"
        }
        table_cell_unselected {
            base "#9fef00"
            background "#141d2b"
            emphasis_0 "#cecb00"
            emphasis_1 "#0dcdcd"
            emphasis_2 "#19cb00"
            emphasis_3 "#d443d9"
        }
        table_cell_selected {
            base "#141d2b"
            background "#a4b1cd"
            emphasis_0 "#474600"
            emphasis_1 "#054c4c"
            emphasis_2 "#0a5000"
            emphasis_3 "#77127b"
        }
        list_unselected {
            base "#9fef00"
            background "#141d2b"
            emphasis_0 "#cecb00"
            emphasis_1 "#0dcdcd"
            emphasis_2 "#19cb00"
            emphasis_3 "#d443d9"
        }
        list_selected {
            base "#141d2b"
            background "#a4b1cd"
            emphasis_0 "#474600"
            emphasis_1 "#054c4c"
            emphasis_2 "#0a5000"
            emphasis_3 "#77127b"
        }
        ribbon_selected {
            base "#141d2b"
            background "#19cb00"
            emphasis_0 "#8c0302"
            emphasis_1 "#464500"
            emphasis_2 "#761179"
            emphasis_3 "#084479"
        }
        ribbon_unselected {
            base "#141d2b"
            background "#9fef00"
            emphasis_0 "#c10403"
            emphasis_1 "#9fef00"
            emphasis_2 "#0b60aa"
            emphasis_3 "#a418a9"
        }
        table_title {
            base "#19cb00"
            background "#141d2b"
            emphasis_0 "#cecb00"
            emphasis_1 "#0dcdcd"
            emphasis_2 "#19cb00"
            emphasis_3 "#d443d9"
        }
        frame_unselected {
            base "#9fef00"
            background "#141d2b"
            emphasis_0 "#9fef00"
            emphasis_1 "#9fef00"
            emphasis_2 "#9fef00"
            emphasis_3 "#9fef00"
        }
        frame_selected {
            base "#19cb00"
            background "#141d2b"
            emphasis_0 "#cecb00"
            emphasis_1 "#0dcdcd"
            emphasis_2 "#19cb00"
            emphasis_3 "#d443d9"
        }
        frame_highlight {
            base "#cecb00"
            background "#141d2b"
            emphasis_0 "#d443d9"
            emphasis_1 "#cecb00"
            emphasis_2 "#cecb00"
            emphasis_3 "#cecb00"
        }
        exit_code_success {
            base "#19cb00"
            background "#141d2b"
            emphasis_0 "#0dcdcd"
            emphasis_1 "#9fef00"
            emphasis_2 "#d443d9"
            emphasis_3 "#3188d4"
        }
        exit_code_error {
            base "#dd5857"
            background "#141d2b"
            emphasis_0 "#cecb00"
            emphasis_1 "#9fef00"
            emphasis_2 "#d443d9"
            emphasis_3 "#3188d4"
        }
        multiplayer_user_colors {
            player_1 "#d443d9"
            player_2 "#3188d4"
            player_3 "#fd28ff"
            player_4 "#cecb00"
            player_5 "#0dcdcd"
            player_6 "#fffd00"
            player_7 "#dd5857"
            player_8 "#dddddd"
            player_9 "#f43e3d"
            player_10 "#1a8fff"
        }
    }
}
