+  }
+  if (Array.isArray(data)) return data.some(requiresModelContext);
+  if (data && typeof data === "object") {
+    return Object.entries(data).some(([key, value]) =>
+      // Assertion tasks accept a bare CEL predicate rather than ${{ }}.
+      (key === "expr" && typeof value === "string" &&
+        /\b(model|file)\b/.test(value)) || requiresModelContext(value)
+    );
+  }
+  return false;
+}
