+      await Deno.utime(path, oldTime, oldTime);
+      assertEquals(
+        (await repo.findByNameGlobal("renamed-other"))?.definition.id,
+        replacement.id,
+      );
+      await writer.delete(testType, first.id);
+      assertEquals(await repo.findByNameGlobal("first"), null);
+    } finally {
+      Deno.readTextFile = read;
+    }
+  });
+});
