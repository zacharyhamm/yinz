+      reads++;
+      return read(...args);
+    };
+    try {
+      assertEquals(await repo.findByNameGlobal("missing"), null);
+      assertEquals(reads, 0);
+      assertEquals(
+        (await repo.findByNameGlobal("first"))?.definition.id,
+        first.id,
+      );
+      assertEquals(reads, 1, "the requested definition is always read again");
+      first.setGlobalArgument("value", "changed");
+      await writer.save(testType, first);
+      assertEquals(
+        (await repo.findByNameGlobal("first"))?.definition.globalArguments
+          .value,
+        "changed",
+      );
+      const fresh = createTestDefinition("new-name");
+      await writer.save(testType, fresh);
+      assertEquals(
+        (await repo.findByNameGlobal("new-name"))?.definition.id,
+        fresh.id,
+      );
+      // An externally renamed field in a legacy file must invalidate the hint.
