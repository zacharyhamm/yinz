+
+Deno.test("DataQueryService: metadata rejection does not read retained bodies, matches stay fresh", () => {
+  const { catalog, dir } = setupTest();
+  const repo = new FileSystemUnifiedDataRepository(dir, undefined, catalog);
+  const service = new DataQueryService(catalog, repo);
+  let reads = 0;
+  let value = 1;
+  repo.getContentSync = (_type, _id, name) => {
+    reads++;
+    assertEquals(name, "current");
+    return new TextEncoder().encode(JSON.stringify({ value }));
+  };
+  try {
+    for (let i = 0; i < 50; i++) {
+      catalog.upsert(
+        makeRow({ data_name: `old-${i}`, id: `old-${i}`, spec_name: "report" }),
+      );
+    }
+    catalog.upsert(
+      makeRow({ data_name: "current", id: "current", spec_name: "question" }),
+    );
+    const predicate = 'specName == "question" && attributes.value > 0';
+    assertEquals(service.querySync(predicate, { select: "content.value" }), [
+      1,
+    ]);
+    assertEquals(reads, 1);
+    value = 2;
+    assertEquals(service.querySync(predicate, { select: "attributes.value" }), [
+      2,
+    ]);
+    assertEquals(reads, 2);
+    assertEquals(
+      service.querySync('specName == "absent"', { loadAttributes: true }),
+      [],
+    );
+    assertEquals(reads, 2);
+    const projected = service.querySync("true", {
+      select: 'specName == "question" ? attributes.value : 0',
+    });
+    assertEquals(projected.length, 51);
+    assertEquals(projected.filter((v) => v === 2), [2]);
+    assertEquals(reads, 3);
+    repo.getContentSync = () => {
+      throw new Error("read failed");
+    };
+    assertThrows(() => service.querySync(predicate), Error, "read failed");
+  } finally {
+    catalog.close();
+    Deno.removeSync(dir, { recursive: true });
+  }
+});
